    capHandoffOk: 'Listo, ya avisamos al equipo. Te contactan por email o WhatsApp pronto. 🙌',
    ctaFree: 'Diagnóstico gratis',
    ctaFreeMsg: 'Quiero un diagnóstico gratis de mi visibilidad en IA.',
    // Selector de canal (pantalla de bienvenida)
    optChatTitle: 'Chat con Marcy',
    optChatSub: 'Te guío y respondo en tiempo real.',
    optDirectTitle: 'Mensaje directo',
    optDirectSub: 'Habla con nosotros por tu canal favorito.',
    optFormTitle: 'Formulario de contacto',
    optFormSub: 'Cuéntanos sobre tu proyecto y te responderemos.',
    optDiagSub: 'Revisamos tu web, SEO y presencia online.',
    // Tarjetas de acción que Marcy inserta en el chat (canales directos / enlace)
    channelsTitle: 'Escríbenos por tu canal favorito',
    directCall: 'Llamar',
    pgPrecios: 'Ver precios',
    pgServicios: 'Ver servicios',
    pgHouston: 'Marcyan en Houston',
    pgMiami: 'Marcyan en Miami',
    pgFormulario: 'Abrir el formulario completo',
    pgDiagnostico: 'Hacer el diagnóstico gratis',
    pgHerramientas: 'Ver herramientas gratis',
    pgCalcLlamadas: 'Calcular llamadas perdidas',
    pgCalcCitas: 'Calcular citas perdidas',
  },
  en: {
    open: 'Open the help chat',
    close: 'Close the chat',
    back: 'Back to start',
    title: 'Marcy',
    status: 'AI assistant · replies instantly',
    greeting: 'Hi! 👋 I’m Marcy, Marcyan’s assistant. Tell me about your business or what you want to achieve online and I’ll point you in the right direction. And if you’d like, we’ll put together a free sample of your site.',
    welcomeTitle: 'Hi, I’m Marcy',
    welcomeSub: 'How would you like to reach us?',
    welcomeHint: 'Pick the option that suits you best.',
    fabNudge: 'Ask me anything',
    placeholder: 'Type your message…',
    send: 'Send message',
    typing: 'Typing…',
    error: 'I couldn’t reply right now. Tell us about your project at /formulario.',
    privacy: 'Informational assistant. Your messages are handled privately.',
    leaveData: 'Leave my details',
    fullForm: 'full form',
