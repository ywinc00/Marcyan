    border: 1px solid var(--border); color: var(--accent-teal);
  }
  .mrc-opt-arrow :global(svg) { width: 16px; height: 16px; }

  /* "Mensaje directo": no es botón; lleva pills de canal */
  .mrc-opt--channels { cursor: default; }
  /* Nota/numero copiable en escritorio (cuando el pill SMS no sirve) */
  .mrc-direct-desktop {
    display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2);
    margin-top: var(--space-2); font-size: var(--text-xs); color: var(--fg-secondary);
    line-height: var(--leading-normal);
  }
  .mrc-direct-desktop[hidden] { display: none; }
  .mrc-direct-num {
    display: inline-flex; align-items: center; gap: var(--space-2);
