    capTitleContact: '¿Cómo te contactamos?',
    capTitleProject: 'Últimos datos para tu propuesta a medida',
    capSub: 'Confirma tu nombre y tu mejor email o teléfono. Sin compromiso.',
    capSubProject: 'Confírmalos y alguien del equipo de Marcyan te arma la propuesta gratis.',
    capName: 'Nombre',
    capEmail: 'Email',
    capPhone: 'Teléfono',
    capSend: 'Enviar',
    capSending: 'Enviando…',
    capDismiss: 'Ahora no',
    capConsentPre: 'Al enviar aceptas nuestra',
    capConsentLink: 'política de privacidad',
    capOk: '¡Gracias! Lo recibimos (referencia %ID%). El equipo te contacta en menos de 24 horas. 🚀',
    capErr: 'No pudimos enviar tus datos. Intenta de nuevo o escríbenos en /formulario.',
    capRequired: 'Déjanos al menos un email o un teléfono.',
    capEmailInvalid: 'Revisa tu email: parece que falta algo.',
    capPhoneInvalid: 'Revisa tu teléfono: necesitamos al menos 7 dígitos.',
    retry: 'Reintentar',
    directDesktopNote: 'Desde tu computadora, escríbenos por WhatsApp o copia nuestro número.',
    copy: 'Copiar',
    copied: 'Copiado',
