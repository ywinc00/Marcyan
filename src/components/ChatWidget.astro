  .mrc-chat .mrc-ac-title { font-size: var(--text-xs); color: var(--fg-secondary); }
  .mrc-chat .mrc-ac-row { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .mrc-chat .mrc-actioncard .mrc-pill {
    flex: 1 1 auto; justify-content: center;
    display: inline-flex; align-items: center; gap: var(--space-2);
    padding: 8px var(--space-3); border-radius: var(--radius-md);
    background: var(--bg-card); border: 1px solid var(--accent-teal-line); color: var(--fg-primary);
    font-family: var(--font-body); font-size: var(--text-sm); font-weight: 500; text-decoration: none;
  }
  .mrc-chat .mrc-actioncard .mrc-pill:hover { background: var(--accent-teal-dim); border-color: var(--accent-teal); }
  .mrc-chat .mrc-actioncard .mrc-pill:focus-visible { outline: 2px solid var(--accent-teal); outline-offset: 2px; }
  .mrc-chat .mrc-pagelink {
    display: inline-flex; align-items: center; justify-content: center; gap: var(--space-2);
    padding: 9px var(--space-4); border-radius: var(--radius-md);
    background: var(--accent-teal); color: var(--fg-inverse); text-decoration: none;
    font-family: var(--font-display); font-size: var(--text-sm); font-weight: 600;
  }
  .mrc-chat .mrc-pagelink:hover { filter: brightness(1.06); }
  .mrc-chat .mrc-pagelink:focus-visible { outline: 2px solid var(--accent-teal); outline-offset: 2px; }
</style>

<script>
  import { stripMarkdown, invitesContact, extractContact, contactFlags, mergeContact } from '../lib/chat-format.mjs';
  import { track } from '../lib/track.js';

  const root = document.getElementById('mrc-chat');
  const cfgEl = root && root.querySelector('[data-mrc-config]');
  if (root && cfgEl) {
    const cfg = JSON.parse(cfgEl.textContent || '{}');
    const T = cfg.strings || {};
    const LINKS = Array.isArray(cfg.links) ? cfg.links : [];
    const lang = cfg.lang === 'en' ? 'en' : 'es';
    const REFERRED_BY = cfg.referredBy || 'chatbot';
    const NAP_PHONE = typeof cfg.phone === 'string' ? cfg.phone : '';
    const CH = cfg.channels || {};   // { wa, sms, tel } — canales directos
    const PAGES = cfg.pages || {};   // { precios, servicios, houston, miami, formulario }

    // Validación de formato de contacto (Chat-F01 / Lead-F1).
    const EMAIL_RX = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    const isValidEmail = (v) => EMAIL_RX.test(v);
    const isValidPhone = (v) => (String(v).match(/\d/g) || []).length >= 7;

    // ¿Dispositivo táctil? El pill sms:/iMessage solo sirve en táctil; en
    // escritorio falla en silencio → lo ocultamos y mostramos el número copiable.
    const isCoarse = (() => {
      try {
        if (window.matchMedia && window.matchMedia('(pointer:coarse)').matches) return true;
      } catch (_) {}
      return /Mobi|Android|iPhone|iPad|iPod/i.test(navigator.userAgent || '');
    })();

    // Timeout de red (Lead-F6): aborta fetch colgados. DEBE cubrir el presupuesto COMPLETO
    // del server en un turno con herramienta interna (topes por fase v8, con thinking
    // adaptativo: llamada1 14s + revisión de sitio 9s + llamada2 16s = 39s peor caso), o el
    // cliente abortaría con error+Retry mientras el server sigue y factura las 2 llamadas
    // (y el cupo de 1 revisión/sesión ya se consumió).
    // Invariante: sum(topes fase) 39s < NET_TIMEOUT 42s < maxDuration server 60s. El turno
    // típico responde en 3-8s; esto solo importa en la cola de latencia.
    const NET_TIMEOUT = 42000;
    function fetchWithTimeout(url, opts) {
      const ctrl = new AbortController();
      const id = setTimeout(() => ctrl.abort(), NET_TIMEOUT);
      return fetch(url, Object.assign({}, opts, { signal: ctrl.signal }))
        .finally(() => clearTimeout(id));
    }

    const fab = root.querySelector('[data-mrc-fab]');
    const panel = document.getElementById('mrc-chat-panel');
    const closeBtn = root.querySelector('[data-mrc-close]');
    const log = root.querySelector('[data-mrc-log]');
    const form = root.querySelector('[data-mrc-form]');
    const input = root.querySelector('[data-mrc-input]');
    const sendBtn = root.querySelector('[data-mrc-send]');
    const chipRow = root.querySelector('[data-mrc-chips]');
    const welcomeEl = root.querySelector('[data-mrc-welcome]');
    const leaveBtn = root.querySelector('[data-mrc-leave]');
    const nudge = root.querySelector('[data-mrc-nudge]');

    const sid = (crypto && crypto.randomUUID)
      ? crypto.randomUUID()
      : String(Date.now()) + Math.random().toString(36).slice(2);

    let history = [];      // solo pares user/assistant completados (alternancia válida)
    let lastUserText = '';
    let busy = false;
    let opened = false;
    let savedScrollY = 0;
    let bodyFrozen = false;
    // Bloqueo de scroll del body SOLO cuando el panel es pantalla completa (móvil).
    // Patrón iOS-safe: position:fixed + top:-scrollY (overflow:hidden no basta en Safari).
    // Idempotente (guard bodyFrozen): evita pisar savedScrollY en dobles llamadas.
    const isMobileFull = () => { try { return window.matchMedia('(max-width: 767.98px)').matches; } catch (_) { return false; } };
    function freezeBody() {
      if (bodyFrozen) return;
      bodyFrozen = true;
      savedScrollY = window.scrollY || window.pageYOffset || 0;
      const b = document.body.style;
      b.position = 'fixed'; b.top = `-${savedScrollY}px`; b.left = '0'; b.right = '0'; b.width = '100%';
    }
    function unfreezeBody() {
      if (!bodyFrozen) return;
      bodyFrozen = false;
      const b = document.body.style;
      b.position = ''; b.top = ''; b.left = ''; b.right = ''; b.width = '';
      // Salto instantáneo (sin animar por el scroll-behavior:smooth global).
      const html = document.documentElement, prevSB = html.style.scrollBehavior;
      html.style.scrollBehavior = 'auto';
      window.scrollTo(0, savedScrollY);
      html.style.scrollBehavior = prevSB;
    }
    let started = false;   // ya pasó de bienvenida a conversación
    let captured = false;  // ya envió sus datos

    // Memoria de contacto (SOLO cliente): lo que el visitante mencionó en el chat.
    // Se usa para PRE-RELLENAR la captura y quitar fricción. Sus valores NUNCA se
    // envían a /api/chat ni al modelo (solo van a /api/contact al enviar la captura);
    // al modelo solo le llega la línea de banderas booleanas (contactFlags).
    const known = { name: '', email: '', phone: '' };

    // ¿El usuario pidió reducir movimiento? → sin animación de tecleo (pinta al instante).
    let reduceMotion = false;
    try { reduceMotion = !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches); } catch (_) {}

    // Typewriter activo (para poder "vaciarlo" al instante si el usuario actúa).
    let activeTyper = null;
    function flushTyper() { if (activeTyper) { const f = activeTyper; activeTyper = null; f(); } }

    // Cambia de estado bienvenida → conversación; inyecta el saludo de Marcy
    // como primera burbuja (display-only, NO entra al historial del modelo).
    function setStage(s) { if (root) root.setAttribute('data-stage', s); }
    function ensureChat() {
      // Siempre pasa a la conversación (también al RE-entrar tras usar "Volver"),
      // pero el saludo se inyecta UNA sola vez (no se duplica).
      const first = !started;
      setStage('chat');
      if (first) {
        started = true;
        appendBubble('ai', T.greeting || '');
        // El elemento activado (tema/CTA de bienvenida) se oculta al cambiar de
        // estado → mover el foco a un elemento estable DENTRO del diálogo para no
        // perder el focus-trap/ESC mientras /api/chat responde (el input está
        // deshabilitado por setBusy; el finally lo re-enfoca al terminar).
        if (opened && closeBtn) closeBtn.focus();
      }
    }

    // Vuelve al selector de canal (pantalla de bienvenida). La conversación y el
    // historial se conservan; al reentrar por "Chat con Marcy" se ven de nuevo.
    function backToWelcome() {
      flushTyper();
      setStage('welcome');
      requestAnimationFrame(() => {
        const firstOpt = panel.querySelector('[data-mrc-welcome] button, [data-mrc-welcome] a[href]');
        (firstOpt || closeBtn || panel).focus();
      });
    }

    // ── Linkify SEGURO: solo tokens conocidos → nodos DOM ──
    function linkify(text) {
      const frag = document.createDocumentFragment();
      if (!LINKS.length) { frag.appendChild(document.createTextNode(text)); return frag; }
      const escaped = LINKS.map((l) => l.token.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'));
      const rx = new RegExp('(' + escaped.join('|') + ')', 'g');
      let last = 0; let m;
      while ((m = rx.exec(text)) !== null) {
        if (m.index > last) frag.appendChild(document.createTextNode(text.slice(last, m.index)));
        const obj = LINKS.find((l) => l.token === m[0]);
        const a = document.createElement('a');
        a.href = obj.href; a.textContent = m[0]; a.className = 'mrc-link';
        frag.appendChild(a);
        last = m.index + m[0].length;
      }
      if (last < text.length) frag.appendChild(document.createTextNode(text.slice(last)));
      return frag;
    }

    // Deja el INICIO (parte de arriba) de una burbuja a la vista, en lugar de
    // saltar al fondo. Así, si la respuesta es larga, el visitante no tiene que
    // subir para leerla desde el principio. Se hace UNA sola vez al insertar.
    function anchorTop(el) {
      if (!el || !log) return;
      const pad = 12;
      log.scrollTop = Math.max(0, el.offsetTop - pad);
    }

    // Animación de "tecleo" sobre el fragmento YA FILTRADO (linkify(stripMarkdown)).
    // Nunca usa innerHTML ni re-parsea texto del modelo: revela caracteres dentro
    // de nodos de texto y añade los enlaces (tokens seguros) enteros. Se puede
    // vaciar al instante (flush) si el usuario envía otro mensaje / abre captura.
    function typeInto(bubble, frag) {
      const tokens = [];
      Array.prototype.forEach.call(frag.childNodes, (n) => {
        if (n.nodeType === 3) tokens.push({ t: 'text', v: n.nodeValue || '' });
        else tokens.push({ t: 'node', v: n });
      });
      let ti = 0, ci = 0, live = null, timer = null, done = false;
      const STEP = 14, PER = 2; // ms por tick, chars por tick

      const ensureLive = () => { if (!live) { live = document.createTextNode(''); bubble.appendChild(live); } return live; };
      function flush() {
        if (done) return; done = true;
        if (timer) { clearTimeout(timer); timer = null; }
        // Anexa TODO lo que falte: completa el nodo de texto en curso y añade los
        // tokens restantes (incluidos enlaces, que van enteros).
        for (let j = ti; j < tokens.length; j++) {
          const tk = tokens[j];
          if (j === ti && tk.t === 'text') ensureLive().nodeValue = tk.v;
          else bubble.appendChild(tk.t === 'text' ? document.createTextNode(tk.v) : tk.v);
        }
        live = null;
        bubble.style.minHeight = ''; // libera la reserva de altura
        if (activeTyper === flush) activeTyper = null;
      }
      function tick() {
        if (done) return;
        if (ti >= tokens.length) { flush(); return; }
        const tk = tokens[ti];
        if (tk.t === 'node') { bubble.appendChild(tk.v); ti++; ci = 0; live = null; timer = setTimeout(tick, STEP); return; }
        ci = Math.min(tk.v.length, ci + PER);
        ensureLive().nodeValue = tk.v.slice(0, ci);
        if (ci >= tk.v.length) { ti++; ci = 0; live = null; }
        timer = setTimeout(tick, STEP);
      }
      activeTyper = flush;
      tick();
    }

    function appendBubble(role, text, opts) {
      const wantsAnchor = !!(opts && opts.animate) && role === 'ai'; // respuestas de Marcy
      const animate = wantsAnchor && !reduceMotion;
      const b = document.createElement('div');
      b.className = 'mrc-bub mrc-' + role;
      if (role === 'ai') {
        const frag = linkify(stripMarkdown(text)); // fragmento YA filtrado y seguro (sin innerHTML)
        if (animate) {
          // Reserva la altura final ANTES de animar: una burbuja vacía al fondo no
          // se puede "subir" (falta contenido debajo para generar scroll y el navegador
          // recorta el scrollTop). Medimos con un clon, fijamos min-height, vaciamos,
          // y recién entonces anclamos arriba y tecleamos.
          b.appendChild(frag.cloneNode(true));
          log.appendChild(b);
          b.style.minHeight = b.offsetHeight + 'px';
          while (b.firstChild) b.removeChild(b.firstChild);
          anchorTop(b);        // el inicio del mensaje queda arriba; el texto se escribe hacia abajo
          typeInto(b, frag);
          return;
        }
        b.appendChild(frag);
        log.appendChild(b);
        // Reduced-motion: pinta al instante PERO igual ancla arriba (mismo beneficio
        // de lectura sin subir). El saludo/errores (sin animate) van al fondo.
        if (wantsAnchor) anchorTop(b);
        else log.scrollTop = log.scrollHeight;
        return;
      }
      b.textContent = text;
      log.appendChild(b);
      log.scrollTop = log.scrollHeight;
    }
    function showTyping() {
      const ty = document.createElement('div');
      ty.className = 'mrc-typing'; ty.setAttribute('data-mrc-typing', '');
      ty.setAttribute('aria-label', T.typing || 'Typing');
      ty.appendChild(document.createElement('span'));
      ty.appendChild(document.createElement('span'));
      ty.appendChild(document.createElement('span'));
      log.appendChild(ty); log.scrollTop = log.scrollHeight;
    }
    function hideTyping() { const ty = log.querySelector('[data-mrc-typing]'); if (ty) ty.remove(); }
    function setBusy(v) {
      busy = v;
      if (input) input.disabled = v;
      // Al liberar, el botón sigue deshabilitado si el input quedó vacío (Chat-F07).
      if (sendBtn) sendBtn.disabled = v || !(input && input.value.trim());
    }

    async function send(textRaw) {
      const text = (textRaw || '').trim();
      if (!text || busy) return;
      try { track('chat_message_sent'); } catch {}
      flushTyper();          // completa cualquier respuesta que aún se esté "escribiendo"
      lastUserText = text;

      // Memoria de contacto (solo cliente): recuerda datos que el visitante escriba
      // para pre-rellenar la captura. NO se envían al modelo (solo banderas si/no).
      // mergeContact no pisa un nombre ya guardado ni degrada un teléfono completo.
      Object.assign(known, mergeContact(known, extractContact(text)));

      setBusy(true);
      ensureChat();
      if (root) root.setAttribute('data-started', '');  // colapsa las chips de respuesta rápida
      appendBubble('user', text);
      if (input) input.value = '';
      autoGrow();
      showTyping();

      const recent = history.slice(-18);
      // Antepone banderas NO-PII (solo si ya tenemos algún dato) para que Marcy pida
      // únicamente lo que falta. El valor real NUNCA viaja; `history` guarda el texto crudo.
      const hasKnown = !!(known.name || known.email || known.phone);
      const wireContent = hasKnown ? (contactFlags(known) + '\n' + text) : text;
      const reqMessages = recent.concat([{ role: 'user', content: wireContent }]);
      try {
        const res = await fetchWithTimeout('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ messages: reqMessages, sessionId: sid, lang }),
        });
        let data = null; try { data = await res.json(); } catch (_) {}
        hideTyping();
        if (data && data.reply) {
          appendBubble('ai', data.reply, { animate: true });
          // `history` = SOLO texto crudo (sin banderas, sin PII) → alternancia válida y transcript limpio.
          history = recent.concat([{ role: 'user', content: text }, { role: 'assistant', content: data.reply }]);
          const act = data.action;
          if (act && act.type === 'capture') {
            // Prellenado robusto: si el extractor del cliente no agarró el nombre
            // (fraseo raro tipo "con Yulier"), usa el que el modelo ya conoce de la
            // conversación. Solo el nombre; email/tel siguen viniendo del cliente.
            if (act.name && !known.name) known.name = act.name;
            openCapture(act.destino === 'proyecto' ? 'proyecto' : 'contacto', act.extras || {});
          } else if (act && act.type === 'channels') {
            renderActionCard('channels');
          } else if (act && act.type === 'link') {
            renderActionCard('link', act.page);
          } else if (!captured && invitesContact(data.reply)) {
            // El bot invitó a dejar datos pero no disparó la herramienta → abrimos
            // la captura igual, para que el formulario prometido SÍ aparezca.
            openCapture('contacto');
          }
        } else {
          appendError((data && data.error) || T.error, text);
        }
      } catch (_) {
        // Incluye AbortError (timeout) y fallos de red: NO perder el mensaje.
        hideTyping();
        appendError(T.error, text);
      } finally {
        setBusy(false);
        // No robar el foco si Marcy acaba de abrir la captura: deja el cursor en el
        // campo que falta (mejor con el pre-rellenado). Si no, re-enfoca el input.
        if (opened && input && !log.querySelector('[data-mrc-capture]')) input.focus();
      }
    }

    // Burbuja de error de red con botón 'Reintentar' (A4 / Chat-F02). Restaura
    // el texto del usuario en el input para que no se pierda.
    function appendError(msg, failedText) {
      const b = document.createElement('div');
      b.className = 'mrc-bub mrc-sys';
      const tx = document.createElement('span');
      tx.textContent = msg || T.error;
      b.appendChild(tx);
      if (failedText) {
        // Restaura el input con el mensaje fallido (y reajusta su alto).
        if (input && !input.value.trim()) { input.value = failedText; autoGrow(); if (sendBtn) sendBtn.disabled = !input.value.trim(); }
        const retry = document.createElement('button');
        retry.type = 'button'; retry.className = 'mrc-retry'; retry.textContent = T.retry || 'Retry';
        retry.addEventListener('click', () => {
          b.remove();
          if (input && input.value.trim() === failedText.trim()) input.value = '';
          autoGrow();
          send(failedText);
        });
        b.appendChild(retry);
      }
      log.appendChild(b);
      log.scrollTop = log.scrollHeight;
    }

    function autoGrow() {
      if (!input) return;
      input.style.height = 'auto';
      input.style.height = Math.min(input.scrollHeight, 120) + 'px';
    }

    // ── Tarjeta de acción que Marcy inserta en el chat (canales directos / enlace) ──
    // Se dispara cuando el modelo llama mostrar_canales_directos o enlazar_pagina.
    // Todos los textos y hrefs son NUESTROS (config del servidor), nunca texto del
    // modelo → sin innerHTML de datos ajenos, seguro contra XSS. No toca PII.
    function renderActionCard(kind, page) {
      flushTyper();     // completa la respuesta que se esté "escribiendo" antes de anexar
      ensureChat();
      const card = document.createElement('div');
      card.className = 'mrc-actioncard';
      if (kind === 'channels') {
        const title = document.createElement('p');
        title.className = 'mrc-ac-title';
        title.textContent = T.channelsTitle || '';
        card.appendChild(title);
        const row = document.createElement('div');
        row.className = 'mrc-ac-row';
        if (CH.wa) {
          const a = document.createElement('a');
          a.className = 'mrc-pill'; a.href = CH.wa; a.target = '_blank'; a.rel = 'noopener noreferrer';
          a.textContent = 'WhatsApp'; row.appendChild(a);
        }
        // iMessage/SMS solo sirve en táctil; en escritorio se omite (falla en silencio).
        if (isCoarse && CH.sms) {
          const a = document.createElement('a');
          a.className = 'mrc-pill'; a.href = CH.sms; a.textContent = 'iMessage'; row.appendChild(a);
        }
        if (CH.tel) {
          const a = document.createElement('a');
          a.className = 'mrc-pill'; a.href = CH.tel;
          a.textContent = (T.directCall || 'Call') + (NAP_PHONE ? ' ' + NAP_PHONE : '');
          row.appendChild(a);
        }
        card.appendChild(row);
      } else { // 'link'
        const p = PAGES[page];
        if (!p || !p.href) return;   // página fuera del allowlist → no pintar nada
        const a = document.createElement('a');
        a.className = 'mrc-pagelink'; a.href = p.href; a.textContent = p.label || p.href;
        card.appendChild(a);
      }
      log.appendChild(card);
      log.scrollTop = log.scrollHeight;
    }

    // ── Captura inline (HTML estático; valores vía .value; PII solo → /api/contact|/api/handoff) ──
    function openCapture(kind, extras) {
      flushTyper();     // que no quede una respuesta a medio "escribir" al abrir la captura
      ensureChat();
      if (captured) return;
      if (log.querySelector('[data-mrc-capture]')) { // ya hay una abierta → enfocar
        const n = log.querySelector('#mrc-c-name'); if (n) n.focus();
        return;
      }
      const title = kind === 'handoff' ? (T.capTitleHuman || T.capTitleContact)
        : kind === 'proyecto' ? (T.capTitleProject || T.capTitleContact) : T.capTitleContact;
      const card = document.createElement('div');
      card.className = 'mrc-capture';
      card.setAttribute('data-mrc-capture', '');
      // HTML estático (todas las cadenas son nuestras, no del modelo/usuario).
      card.innerHTML =
        '<div class="mrc-cap-title"></div>' +
        '<p class="mrc-cap-sub"></p>' +
        '<input id="mrc-c-name" type="text" autocomplete="name" maxlength="120" />' +
        '<div class="mrc-cap-row">' +
          '<input id="mrc-c-email" type="email" autocomplete="email" inputmode="email" maxlength="200" />' +
          '<input id="mrc-c-phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="50" />' +
        '</div>' +
        '<input id="mrc-c-hp" class="mrc-cap-hp" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />' +
        '<p class="mrc-cap-consent"></p>' +
        '<div class="mrc-cap-actions">' +
          '<button type="button" class="mrc-cap-send" data-mrc-capsend></button>' +
          '<button type="button" class="mrc-cap-dismiss" data-mrc-capdismiss></button>' +
        '</div>' +
        '<p class="mrc-cap-result" data-mrc-capresult hidden></p>';
      // Rellenar textos por separado (textContent / placeholder → seguro).
      card.querySelector('.mrc-cap-title').textContent = title;
      card.querySelector('.mrc-cap-sub').textContent = kind === 'handoff' ? (T.capSubHuman || T.capSub)
        : kind === 'proyecto' ? (T.capSubProject || T.capSub) : T.capSub;
      const nameInput = card.querySelector('#mrc-c-name');
      const emailInput = card.querySelector('#mrc-c-email');
      const phoneInput = card.querySelector('#mrc-c-phone');
      nameInput.placeholder = T.capName;
      emailInput.placeholder = T.capEmail;
      phoneInput.placeholder = T.capPhone;
      // Labels accesibles (Chat-F04): los inputs no tienen <label> visible.
      if (T.capName) nameInput.setAttribute('aria-label', T.capName);
      if (T.capEmail) emailInput.setAttribute('aria-label', T.capEmail);
      if (T.capPhone) phoneInput.setAttribute('aria-label', T.capPhone);
      card.querySelector('[data-mrc-capsend]').textContent = T.capSend;
      card.querySelector('[data-mrc-capdismiss]').textContent = T.capDismiss;
      const consent = card.querySelector('.mrc-cap-consent');
      consent.appendChild(document.createTextNode((T.capConsentPre || '') + ' '));
      const cl = document.createElement('a'); cl.href = '/privacidad'; cl.textContent = T.capConsentLink || 'privacidad';
      consent.appendChild(cl); consent.appendChild(document.createTextNode('.'));

      // Red de seguridad del prellenado: reescanea TODA la conversación (turnos del
      // usuario + último texto) por si la extracción turno a turno se perdió algún
      // dato que el visitante ya dio. 100% cliente; nada de esto viaja al modelo.
      try {
        const texts = history.filter((m) => m.role === 'user').map((m) => m.content);
        if (lastUserText) texts.push(lastUserText);
        for (const tx of texts) Object.assign(known, mergeContact(known, extractContact(tx)));
      } catch (_) {}

      // Pre-rellena desde la memoria de conversación (solo cliente; nunca tocó el
      // modelo). Solo valores bien formados; el servidor revalida en /api/contact.
      if (known.name) nameInput.value = known.name;
      if (known.email && isValidEmail(known.email)) emailInput.value = known.email;
      if (known.phone && isValidPhone(known.phone)) phoneInput.value = known.phone;

      log.appendChild(card);
      log.scrollTop = log.scrollHeight;

      const need = (lastUserText || '').slice(0, 1000);
      card.querySelector('[data-mrc-capdismiss]').addEventListener('click', () => card.remove());
      card.querySelector('[data-mrc-capsend]').addEventListener('click', () => submitCapture(card, kind, need, extras || {}));
      // Enfoca el primer campo VACÍO (si ya prellenamos algo, el cursor cae donde falta).
      const firstEmpty = [nameInput, emailInput, phoneInput].find((el) => el && !el.value);
      (firstEmpty || nameInput).focus();
    }

    // Serializa los últimos turnos del historial como transcript legible, aplicando
    // stripMarkdown a cada línea. Solo pares user/assistant (sin PII; la PII vive en
    // los campos del formulario, no en el chat). Recorta a ~6-8 turnos por seguridad.
    function buildTranscript() {
      const turns = history.slice(-8);
      if (!turns.length) return '';
      const youES = 'Usuario'; const meES = 'Marcy';
      const youEN = 'You'; const meEN = 'Marcy';
      const you = lang === 'en' ? youEN : youES;
      const me = lang === 'en' ? meEN : meES;
      const lines = turns.map((m) => {
        const who = m.role === 'assistant' ? me : you;
        return who + ': ' + stripMarkdown(m.content || '');
      });
      return lines.join('\n');
    }

    async function submitCapture(card, kind, need, extras) {
      const get = (id) => { const el = card.querySelector(id); return el ? el.value.trim() : ''; };
      const emailEl = card.querySelector('#mrc-c-email');
      const phoneEl = card.querySelector('#mrc-c-phone');
      const email = get('#mrc-c-email');
      const phone = get('#mrc-c-phone');
      const result = card.querySelector('[data-mrc-capresult]');
      const sendB = card.querySelector('[data-mrc-capsend]');
      const showErr = (txt) => { if (result) { result.hidden = false; result.className = 'mrc-cap-result err'; result.textContent = txt; } };

      // Limpia estado de validación previo.
      if (emailEl) emailEl.removeAttribute('aria-invalid');
      if (phoneEl) phoneEl.removeAttribute('aria-invalid');

      // 1) Presencia: al menos uno.
      if (!email && !phone) { showErr(T.capRequired); return; }
      // 2) Formato (Chat-F01 / Lead-F1): si hay email, regex; si hay teléfono, >=7 dígitos.
      if (email && !isValidEmail(email)) {
        if (emailEl) { emailEl.setAttribute('aria-invalid', 'true'); emailEl.focus(); }
        showErr(T.capEmailInvalid || T.capRequired); return;
      }
      if (phone && !isValidPhone(phone)) {
        if (phoneEl) { phoneEl.setAttribute('aria-invalid', 'true'); phoneEl.focus(); }
        showErr(T.capPhoneInvalid || T.capRequired); return;
      }

      const onSuccess = (okText) => {
        captured = true;
        if (root) root.setAttribute('data-captured', '');  // colapsa las chips
        card.querySelectorAll('input, .mrc-cap-send, .mrc-cap-dismiss').forEach((el) => { el.disabled = true; });
        card.querySelectorAll('input, .mrc-cap-row, .mrc-cap-actions, .mrc-cap-consent').forEach((el) => { el.style.display = 'none'; });
        if (result) { result.hidden = false; result.className = 'mrc-cap-result ok'; result.textContent = okText; }
      };
      const onFail = () => {
        if (sendB) { sendB.disabled = false; sendB.textContent = T.capSend; }
        showErr(T.capErr);
      };

      // Handoff: pedir hablar con una persona → /api/handoff (no crea lead; avisa al fundador).
      if (kind === 'handoff') {
        if (sendB) { sendB.disabled = true; sendB.textContent = T.capSending; }
        if (result) result.hidden = true;
        try {
          const res = await fetchWithTimeout('/api/handoff', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name: get('#mrc-c-name'), contact: email || phone, message: need, lang, website_hp: get('#mrc-c-hp') }),
          });
          let data = null; try { data = await res.json(); } catch (_) {}
          if (res.ok && data && data.ok) { try { track('chat_handoff_submitted'); } catch {} onSuccess(T.capHandoffOk || T.capOk); }
          else { throw new Error('bad response'); }
        } catch (_) { onFail(); }  // incl. AbortError (timeout)
        return;
      }

      // Notas comunes (nota/disponibilidad del modelo + transcript) y enrutamiento por destino.
      // Los campos del modelo (extras) NO son PII sensible (info del negocio, disponibilidad);
      // el email/teléfono viven SOLO en los inputs de la cajita. La PII no viaja por el modelo.
      const ex = extras || {};
      const objective = ((ex.objetivo || need) || '').slice(0, 280);
      const transcript = buildTranscript();
      const convoLabel = lang === 'en' ? '--- Conversation ---' : '--- Conversación ---';
      const availLabel = lang === 'en' ? 'Availability/note: ' : 'Disponibilidad/nota: ';
      let endpoint, body;

      if (kind === 'proyecto') {
        // Cliente encaminado/cerró → BRIEF de proyecto (/api/brief, crea MRC-XXX). El
        // asistente lo arma RAZONANDO sobre la conversación y rellena el formulario
        // completo; un miembro de Marcyan manda la propuesta.
        let notes = lang === 'en' ? 'Brief assembled by the Marcy assistant.' : 'Brief armado por el asistente Marcy.';
        if (ex.detalles) notes += '\n' + (lang === 'en' ? 'Details: ' : 'Detalles: ') + ex.detalles;
        if (ex.nota) notes += '\n' + availLabel + ex.nota;
        if (transcript) notes += '\n\n' + convoLabel + '\n' + transcript;
        endpoint = '/api/brief';
        body = {
          source: 'chat',
          business_name: ex.negocio || '',
          owner_name: get('#mrc-c-name'),
          industry: ex.rubro || '',
          business_description: ex.descripcion || '',
          city_state: ex.ciudad || '',
          current_website: ex.web_actual || '',
          website_type: ex.tipo_sitio || '',
          target_audience: ex.audiencia || '',
          main_objective: objective,
          budget_range: ex.presupuesto || '',
          timeline: ex.plazo || '',
          language: ex.idioma || '',
          email, phone,
          additional_notes: notes,
          referred_by: REFERRED_BY,
          website_hp: get('#mrc-c-hp'),
        };
      } else {
        // No se cerró / lo pidió / sin tiempo → LEAD ligero (/api/contact, crea LEAD-XXX).
        let notes = lang === 'en' ? 'Asked to be contacted via the site assistant.' : 'Pidió que lo contacten vía el asistente del sitio.';
        if (ex.nota) notes += '\n' + availLabel + ex.nota;
        if (objective) notes += (lang === 'en' ? ' Goal: ' : ' Objetivo: ') + objective;
        if (transcript) notes += '\n\n' + convoLabel + '\n' + transcript;
        endpoint = '/api/contact';
        body = {
          source: 'chat',
          owner_name: get('#mrc-c-name'),
          email, phone,
          main_objective: objective,
          additional_notes: notes,
          referred_by: REFERRED_BY,
          website_hp: get('#mrc-c-hp'),
        };
      }

      if (sendB) { sendB.disabled = true; sendB.textContent = T.capSending; }
      if (result) result.hidden = true;
      try {
        const res = await fetchWithTimeout(endpoint, {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
        });
        let data = null; try { data = await res.json(); } catch (_) {}
        if (res.ok && data && data.ok) {
          try { track('generate_lead', { source: 'chat', kind: endpoint.indexOf('brief') >= 0 ? 'brief' : 'lead' }); } catch {}
          onSuccess((T.capOk || 'OK').replace('%ID%', data.refId || data.projectId || '—'));
        } else { throw new Error('bad response'); }
      } catch (_) { onFail(); }  // incl. AbortError (timeout)
    }

    // ── Teclado móvil: ajusta el panel al área visible (VisualViewport) ──
    // Sin esto, al abrir el teclado el área visible se encoge pero el panel
    // fijo no, y se pierde el header/los mensajes. Exponemos --mrc-kb (alto del
    // teclado), --mrc-vvh (alto visible real) y --mrc-vvtop (desplazamiento del
    // viewport visual) que el CSS de pantalla completa usa.
    const vv = window.visualViewport;
    function syncViewport() {
      if (!vv || !root || !opened) return;
      const kb = Math.max(0, Math.round(window.innerHeight - vv.height - vv.offsetTop));
      root.style.setProperty('--mrc-kb', kb + 'px');
      root.style.setProperty('--mrc-vvh', Math.round(vv.height) + 'px');
      root.style.setProperty('--mrc-vvtop', Math.round(vv.offsetTop) + 'px');
      // Fijar al fondo SOLO cuando el teclado móvil está abierto (kb>0), para que
      // el input quede por encima del teclado. En escritorio (kb=0) NO fijamos:
      // pisaría el anclaje-arriba de la respuesta de Marcy (que el visitante lea
      // desde el principio sin tener que subir).
      if (opened && log && kb > 0) log.scrollTop = log.scrollHeight;
    }
    if (vv) {
      vv.addEventListener('resize', syncViewport);
      vv.addEventListener('scroll', syncViewport);
    }
    // Rotación/resize entre móvil y desktop con el panel abierto: congela/descongela
    // el body según el breakpoint para no dejar el fondo bloqueado al pasar a ≥768px.
    try {
      const mqFull = window.matchMedia('(max-width: 767.98px)');
      const onBpChange = () => {
        if (!opened) return;
        if (isMobileFull()) freezeBody(); else unfreezeBody();
        syncViewport();
      };
      if (mqFull.addEventListener) mqFull.addEventListener('change', onBpChange);
      else if (mqFull.addListener) mqFull.addListener(onBpChange);
    } catch (_) {}

    // El asset grande del avatar (héroe) está diferido (data-src) para no
    // descargarlo en el render inicial del sitio. Se activa al abrir el chat.
    let deferredLoaded = false;
    function loadDeferredAssets() {
      if (deferredLoaded) return;
      deferredLoaded = true;
      root.querySelectorAll('[data-mrc-defer]').forEach((img) => {
        const pic = img.closest('picture');
        if (pic) pic.querySelectorAll('source[data-srcset]').forEach((s) => { s.srcset = s.getAttribute('data-srcset'); });
        const ds = img.getAttribute('data-src');
        if (ds) img.src = ds;
        img.removeAttribute('data-mrc-defer');
      });
    }

    // ── Abrir / cerrar panel ──
    function openPanel() {
      try { track('chat_opened'); } catch {}
      loadDeferredAssets();
      // Congela el documento de fondo para que el teclado no arrastre la página
      // por detrás del panel a pantalla completa (solo móvil).
      if (isMobileFull()) freezeBody();
      panel.hidden = false;
      root.setAttribute('data-open', '');
      fab.setAttribute('aria-expanded', 'true');
      opened = true;
      if (nudge) nudge.hidden = true;
      syncViewport();
      // Re-sincroniza tras la animación del teclado/viewport (evita franjas de fondo).
      requestAnimationFrame(() => requestAnimationFrame(syncViewport));
      requestAnimationFrame(() => {
        // En bienvenida NO enfocamos el input (en móvil abriría el teclado);
        // enfocamos la primera tarjeta de canal. En conversación, el input.
        if (root.getAttribute('data-stage') === 'chat' && input) { input.focus(); return; }
        const first = panel.querySelector('[data-mrc-welcome] button, [data-mrc-welcome] a[href]');
        (first || closeBtn || panel).focus();
      });
    }
    function closePanel() {
      flushTyper();
      panel.hidden = true;
      root.removeAttribute('data-open');
      fab.setAttribute('aria-expanded', 'false');
      opened = false;
      if (input) input.blur();         // cierra el teclado
      root.style.setProperty('--mrc-kb', '0px');
      root.style.setProperty('--mrc-vvtop', '0px');
      unfreezeBody();   // restaura el scroll del documento si lo congelamos al abrir
      fab.focus();
    }
    function toggle() { (opened ? closePanel : openPanel)(); }

    // ── Eventos ──
    fab.addEventListener('click', toggle);
    // Nudge clicable (Chat-F06): abre el panel.
    if (nudge) nudge.addEventListener('click', () => { nudge.hidden = true; if (!opened) openPanel(); });
    if (closeBtn) closeBtn.addEventListener('click', closePanel);
    const humanBtn = root.querySelector('[data-mrc-human]');
    if (humanBtn) humanBtn.addEventListener('click', () => openCapture('handoff'));
    const backBtn = root.querySelector('[data-mrc-back]');
    if (backBtn) backBtn.addEventListener('click', backToWelcome);
    if (form) form.addEventListener('submit', (e) => { e.preventDefault(); send(input && input.value); });
    if (sendBtn) sendBtn.addEventListener('click', () => send(input && input.value));
    if (input) {
      // Estado inicial del botón enviar: deshabilitado si el input está vacío (Chat-F07).
      if (sendBtn) sendBtn.disabled = !input.value.trim();
      input.addEventListener('input', () => {
        autoGrow();
        if (sendBtn && !busy) sendBtn.disabled = !input.value.trim();
      });
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); send(input.value); }
      });
    }
    // Chips de respuesta rápida (conversación): SIEMBRAN un mensaje de usuario.
    function seedFrom(container) {
      if (!container) return;
      container.addEventListener('click', (e) => {
        const btn = e.target && e.target.closest ? e.target.closest('[data-msg]') : null;
        if (btn) send(btn.getAttribute('data-msg'));
      });
    }
    seedFrom(chipRow);
    // Selector de canal (bienvenida): cada tarjeta enruta a su acción. Los enlaces
    // de canal (WhatsApp/iMessage) son <a href> nativos → no necesitan JS aquí.
    if (welcomeEl) welcomeEl.addEventListener('click', (e) => {
      const el = e.target && e.target.closest ? e.target.closest('[data-act], [data-msg]') : null;
      if (!el) return;
      const act = el.getAttribute('data-act');
      if (act === 'chat') { try { track('chat_channel_selected', { channel: 'chat' }); } catch {} ensureChat(); if (input) input.focus(); return; }
      if (act === 'form') { try { track('chat_channel_selected', { channel: 'form' }); } catch {} openCapture('contacto'); return; }
      const msg = el.getAttribute('data-msg');
      if (msg) { try { track('chat_channel_selected', { channel: 'diagnostic' }); } catch {} send(msg); }
    });
    if (leaveBtn) leaveBtn.addEventListener('click', () => { if (!opened) openPanel(); openCapture('contacto'); });

    // ── Puente herramientas → Marcy (evento global `mrc:ask`) ──────
    // El diagnóstico y las calculadoras disparan `mrc:ask` con un texto construido
    // 100% en el CLIENTE y SIN PII (puntaje + señales del catálogo, o los números
    // que el propio visitante puso en la calculadora). El widget abre el panel,
    // entra a la conversación y lo envía por el flujo normal de send(): mismo
    // saneo, mismos límites y misma validación del servidor que un mensaje tecleado.
    window.addEventListener('mrc:ask', (e) => {
      const text = e && e.detail && typeof e.detail.text === 'string' ? e.detail.text.trim() : '';
      if (!text || busy) return;
      if (!opened) openPanel();
      ensureChat();
      requestAnimationFrame(() => send(text.slice(0, 1500)));
    });

    // Mensaje directo en escritorio (Chat-F05): el pill sms:/iMessage solo
    // funciona en táctil; en escritorio falla en silencio. En escritorio lo
    // ocultamos y mostramos el número del NAP como texto copiable junto a
    // WhatsApp (que degrada bien). WhatsApp se deja intacto.
    if (!isCoarse) {
      const smsPill = root.querySelector('[data-mrc-sms]');
      if (smsPill) smsPill.hidden = true;
      const slot = root.querySelector('[data-mrc-direct-desktop]');
      if (slot && NAP_PHONE) {
        slot.hidden = false;
        const note = document.createElement('span');
        note.className = 'mrc-direct-note';
        note.textContent = T.directDesktopNote || '';
        const num = document.createElement('span');
        num.className = 'mrc-direct-num';
        const numTx = document.createElement('span');
        numTx.textContent = NAP_PHONE;
        const copyBtn = document.createElement('button');
        copyBtn.type = 'button'; copyBtn.className = 'mrc-copy-btn'; copyBtn.textContent = T.copy || 'Copy';
        copyBtn.addEventListener('click', () => {
          const done = () => {
            const prev = T.copy || 'Copy';
            copyBtn.textContent = T.copied || 'Copied';
            setTimeout(() => { copyBtn.textContent = prev; }, 1800);
          };
          try {
            if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(NAP_PHONE).then(done, () => {});
          } catch (_) {}
        });
        num.appendChild(numTx); num.appendChild(copyBtn);
        slot.appendChild(note); slot.appendChild(num);
      }
    }

    // Burbuja de atención: una vez por sesión, a los pocos segundos de cargar.
    // Suprimida cuando la barra CTA móvil está visible (body.has-ctabar) para no
    // solapar FAB + barra + nudge en la esquina (seam-12).
    try {
      if (nudge && !sessionStorage.getItem('mrcNudge')) {
        setTimeout(() => {
          const ctaBar = document.body && document.body.classList.contains('has-ctabar');
          if (!opened && !ctaBar && nudge) {
            nudge.hidden = false;
            try { sessionStorage.setItem('mrcNudge', '1'); } catch (_) {}
            setTimeout(() => { if (nudge && !opened) nudge.hidden = true; }, 9000);
          }
        }, 3500);
      }
    } catch (_) {}

    // Al enfocar un campo: reajusta al teclado y, si está dentro del log (campos
    // de la captura), lo deja a la vista por encima del teclado.
    panel.addEventListener('focusin', () => {
      syncViewport();
      setTimeout(() => {
        syncViewport();
        const a = document.activeElement;
        if (a && a.scrollIntoView && log && log.contains(a)) a.scrollIntoView({ block: 'center' });
      }, 280);
    });

    // ESC + focus-trap dentro del panel
    panel.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') { e.preventDefault(); closePanel(); return; }
      if (e.key !== 'Tab') return;
      const nodes = panel.querySelectorAll('button, a[href], textarea, input, [tabindex]:not([tabindex="-1"])');
      const list = Array.prototype.filter.call(nodes, (el) => !el.disabled && el.offsetParent !== null);
      if (!list.length) return;
      const first = list[0]; const lastEl = list[list.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); lastEl.focus(); }
      else if (!e.shiftKey && document.activeElement === lastEl) { e.preventDefault(); first.focus(); }
    });
  }
</script>
