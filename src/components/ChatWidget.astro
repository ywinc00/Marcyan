    font-family: var(--font-body); font-size: var(--text-xs);
    transition: background var(--duration-fast), border-color var(--duration-fast);
  }
  .mrc-copy-btn:hover { background: var(--accent-teal-dim); border-color: var(--accent-teal); }
  .mrc-copy-btn:focus-visible { outline: 2px solid var(--accent-teal); outline-offset: 2px; }
  .mrc-opt-pills { display: flex; flex-wrap: nowrap; gap: var(--space-2); margin-top: var(--space-2); }
  .mrc-pill {
    flex: 1 1 0; min-width: 0; justify-content: center;
