---
// PLANTILLA de las landings de cluster (Ola 1 SEO), BILINGÜE (prop `lang`).
// Cada ruta (/es/houston/seo-local, /en/houston/local-seo, …) es un archivo fino
// que pasa su slice de contenido (ClusterPage) + lang aquí.
//
// Estructura (mobile-first, DS v2): Nav · Hero+Breadcrumb · AnswerBlock (AEO) ·
// Qué incluye · Proceso · Contexto local · Precio · Proof · FAQ · CTA · Relacionados
// · Contacto (form → /api/brief) · Footer. hasEn se deriva en el Layout (routes.ts).
import Layout from '../layouts/Layout.astro';
import SiteNav from './layout/SiteNav.astro';
import SiteFooter from './layout/SiteFooter.astro';
import Breadcrumb from './ui/Breadcrumb.astro';
import LandingHero from './sections/LandingHero.astro';
import AnswerBlock from './sections/AnswerBlock.astro';
import FeatureGrid from './sections/FeatureGrid.astro';
import Process from './sections/Process.astro';
import Prose from './sections/Prose.astro';
import Pricing from './sections/Pricing.astro';
import Projects from './sections/Projects.astro';
import Faq from './sections/Faq.astro';
import CtaBand from './sections/CtaBand.astro';
import RelatedLinks from './sections/RelatedLinks.astro';
import Contact from './sections/Contact.astro';
import SpaceBackdrop from './SpaceBackdrop.astro';
import ServiceLd from './seo/ServiceLd.astro';
import { content } from '../i18n/content';
import { clusterNav, clusterNavEn, type ClusterPage } from '../i18n/clusters';

interface Props { cluster: ClusterPage; lang?: 'es' | 'en' }
const { cluster, lang = 'es' } = Astro.props;
const c = content[lang];
const nav = lang === 'en' ? clusterNavEn : clusterNav;
// path sin prefijo de idioma para el Layout (construye canonical + hreflang).
const pathNoLocale = cluster.path.replace(/^\/(es|en)\//, '');

// ── Prellenado del formulario de contacto desde el cluster ──
function deriveDefaultCity(city?: string): string | undefined {
  if (city === 'Houston') return 'Houston, TX';
  if (city === 'Miami') return 'Miami, FL';
  return undefined;
}
// defaultService: por substring del path (ES o EN); coincide con las options del select por idioma.
function deriveDefaultService(path: string, lang: 'es' | 'en'): string | undefined {
  const es = lang === 'es';
  if (/abogados-inmigracion|bienes-raices|immigration-lawyers|real-estate/.test(path)) return es ? 'Diseño Web' : 'Web Design';
  if (/diseno-web|pagina-web|web-design|website-cost/.test(path)) return es ? 'Diseño Web' : 'Web Design';
  if (/ia-conversacional|chatbot|ia-para-pymes|conversational-ai|ai-for-small-business/.test(path)) return es ? 'IA Conversacional / Chatbot' : 'Conversational AI / Chatbot';
  if (/ecommerce/.test(path)) return es ? 'E-Commerce / Tienda Online' : 'E-Commerce / Online Store';
  if (/seo-para-ia|ai-seo/.test(path)) return es ? 'SEO para IA (Visibilidad en IA)' : 'AI Visibility (AEO)';
  if (/seo-local|local-seo/.test(path)) return es ? 'SEO Local' : 'Local SEO';
  if (/branding/.test(path)) return es ? 'Branding & Identidad' : 'Branding & Identity';
  return undefined;
}
const defaultCity = deriveDefaultCity(cluster.service.areaCity);
const defaultService = deriveDefaultService(cluster.path, lang);

const relatedTone: 'gold' | 'teal' =
  cluster.hero.tone === 'teal' || cluster.includes.tone === 'teal' ? 'teal' : 'gold';
---
<Layout
  title={cluster.meta.title}
  description={cluster.meta.description}
  lang={lang}
  path={pathNoLocale}
>
  <ServiceLd slot="head" {...cluster.service} />

  <SiteNav nav={nav} lang={lang} homeHref={lang === 'en' ? '/en/' : '/es/'} currentPath={Astro.url.pathname} />

  <main id="main">
    <LandingHero {...cluster.hero}>
      <Breadcrumb slot="breadcrumb" items={cluster.breadcrumb} lang={lang} />
    </LandingHero>

    <AnswerBlock q={cluster.answer.q} a={cluster.answer.a} source={cluster.answer.source} lang={lang} />

    <FeatureGrid
      tag={cluster.includes.tag}
      title={cluster.includes.title}
      intro={cluster.includes.intro}
      items={cluster.includes.items}
      tone={cluster.includes.tone}
    />

    <Process process={c.process} />

    <Prose
      tag={cluster.local.tag}
      title={cluster.local.title}
      paragraphs={cluster.local.paragraphs}
      tone={cluster.local.tone}
    />

    <Pricing
      tag={cluster.pricing.tag}
      title={cluster.pricing.title}
      price={cluster.pricing.price}
      unit={cluster.pricing.unit}
      lead={cluster.pricing.lead}
      features={cluster.pricing.features}
      cta={cluster.pricing.cta}
      note={cluster.pricing.note}
      tone={cluster.pricing.tone}
      lang={lang}
    />

    <Projects projects={cluster.proof} lang={lang} />

    <Faq tag={cluster.faq.tag} title={cluster.faq.title} items={cluster.faq.items} />

    <CtaBand
      title={cluster.cta.title}
      sub={cluster.cta.sub}
      primary={cluster.cta.primary}
      tone={cluster.cta.tone}
      city={cluster.service.areaCity === 'Miami' ? 'miami' : 'houston'}
      lang={lang}
    />

    <RelatedLinks tag={cluster.related.tag} title={cluster.related.title} links={cluster.related.links} tone={relatedTone} />

    <Contact contact={c.contact} defaultCity={defaultCity} defaultService={defaultService} />
  </main>

  {/* Atmósfera espacial de página (mismo lenguaje visual que la home) — detrás de todo. */}
  <SpaceBackdrop tone={relatedTone} />

  <SiteFooter footer={c.footer} lang={lang} />
</Layout>
