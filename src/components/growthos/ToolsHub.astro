---
// Hub de herramientas gratis (Growth OS): 2 calculadoras client-side puras (sin IA,
// sin fetch) + card al diagnóstico. Ponen número a una sospecha con los inputs del
// usuario y prefijo "≈" (nunca una cifra fabricada). Fórmulas documentadas abajo.
import { GOS } from '../../i18n/growth-os';
import Icon from '../ui/Icon.astro';
import { computeMissedCalls, computeNoShows } from '../../../lib/tools-formulas.mjs';
import './range.css';

interface Props { lang: 'es' | 'en' }
const { lang } = Astro.props;
const tt = GOS[lang].tools;
const diagHref = lang === 'en' ? '/en/checkup' : '/es/diagnostico';
// Ids de ancla por idioma para deep-links (Marcy y las landings enlazan aquí).
const ids = lang === 'en' ? { calls: 'calls', appt: 'appointments' } : { calls: 'llamadas', appt: 'citas' };

const nf = new Intl.NumberFormat(lang === 'en' ? 'en-US' : 'es-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
const fmtVal = (v: number, kind: string) => (kind === 'cur' ? nf.format(v) : kind === 'pct' ? `${v}%` : String(v));

// Calc 1 — llamadas perdidas: perdidasMes = callsWeek·4.33·(missed/100);
//          perdidaUSD = perdidasMes·ticket·(close/100).
const callsSliders = [
  { role: 'callsWeek', label: tt.inCallsWeek, min: 5, max: 100, step: 1, val: 25, fmt: 'int' },
  { role: 'missed',    label: tt.inMissed,    min: 5, max: 60,  step: 1, val: 20, fmt: 'pct' },
  { role: 'ticket',    label: tt.inTicket,    min: 50, max: 5000, step: 50, val: 350, fmt: 'cur' },
  { role: 'close',     label: tt.inClose,     min: 10, max: 80,  step: 1, val: 30, fmt: 'pct' },
];
// Calc 2 — citas perdidas: noShowsMes = apptWeek·4.33·(noShow/100);
//          recuperableUSD = noShowsMes·apptValue·0.4 (40% recuperable con recordatorios).
const apptSliders = [
  { role: 'apptWeek',  label: tt.inApptWeek,  min: 10, max: 200, step: 1, val: 40, fmt: 'int' },
  { role: 'noShow',    label: tt.inNoShow,    min: 5, max: 40,  step: 1, val: 15, fmt: 'pct' },
  { role: 'apptValue', label: tt.inApptValue, min: 20, max: 500, step: 1, val: 65, fmt: 'cur' },
];
// Valores iniciales desde la fuente única (mismos defaults que los sliders).
const initCalls = computeMissedCalls({ llamadas_semana: 25, pct_sin_contestar: 20, ticket: 350, tasa_cierre: 30 }).monthly;
const initAppt = computeNoShows({ citas_semana: 40, pct_no_show: 15, valor_cita: 65 }).monthly;
---
<section class="gtool">
  <div class="container">
    <div class="gtool__grid">

      <div class="gtcard" data-calc="calls" id={ids.calls}>
        <h2 class="gtcard__title">{tt.calcCallsTitle}</h2>
        <p class="gtcard__sub">{tt.calcCallsSub}</p>
        <div class="gtcard__sliders">
          {callsSliders.map((s) => (
            <label class="gtsl">
              <span class="gtsl__lbl">{s.label}<b data-val data-fmt={s.fmt}>{fmtVal(s.val, s.fmt)}</b></span>
              <input class="gos-range" type="range" min={s.min} max={s.max} step={s.step} value={s.val} data-role={s.role} aria-label={s.label} />
            </label>
          ))}
        </div>
        <div class="gtcard__out">
          <span class="gtcard__outlbl">{tt.outCalls}</span>
          <strong class="gtcard__num" data-out>≈ {nf.format(initCalls)}</strong>
        </div>
        <p class="gtcard__disc">{tt.calcDisclaimer}</p>
        <div class="gtcard__actions">
          <a class="gtcard__cta" href={diagHref} data-track="tool_cta_clicked">{tt.calcCta} <Icon name="lucide:arrow-right" /></a>
          <button type="button" class="gtcard__cta gtcard__cta--marcy" data-marcy>{tt.calcMarcy} <Icon name="lucide:messages-square" /></button>
        </div>
      </div>

      <div class="gtcard" data-calc="appt" id={ids.appt}>
        <h2 class="gtcard__title">{tt.calcApptTitle}</h2>
        <p class="gtcard__sub">{tt.calcApptSub}</p>
        <div class="gtcard__sliders">
          {apptSliders.map((s) => (
            <label class="gtsl">
              <span class="gtsl__lbl">{s.label}<b data-val data-fmt={s.fmt}>{fmtVal(s.val, s.fmt)}</b></span>
              <input class="gos-range" type="range" min={s.min} max={s.max} step={s.step} value={s.val} data-role={s.role} aria-label={s.label} />
            </label>
          ))}
        </div>
        <div class="gtcard__out">
          <span class="gtcard__outlbl">{tt.outAppt}</span>
          <strong class="gtcard__num" data-out>≈ {nf.format(initAppt)}</strong>
        </div>
        <p class="gtcard__disc">{tt.calcDisclaimer}</p>
        <div class="gtcard__actions">
          <a class="gtcard__cta" href={diagHref} data-track="tool_cta_clicked">{tt.calcCta} <Icon name="lucide:arrow-right" /></a>
          <button type="button" class="gtcard__cta gtcard__cta--marcy" data-marcy>{tt.calcMarcy} <Icon name="lucide:messages-square" /></button>
        </div>
      </div>

      <a class="gtcard gtcard--diag" href={diagHref} data-track="tool_cta_clicked">
        <span class="gtcard__diag-ic"><Icon name="lucide:scan-search" /></span>
        <h2 class="gtcard__title">{tt.diagCardTitle}</h2>
        <p class="gtcard__sub">{tt.diagCardSub}</p>
        <span class="gtcard__cta gtcard__cta--ghost">{tt.diagCardCta} <Icon name="lucide:arrow-right" /></span>
      </a>

    </div>
  </div>
</section>

<style>
  .gtool { padding-block: var(--section-gap); }
  .gtool__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-6); align-items: start; }
  .gtcard { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-xl);
            box-shadow: var(--shadow-card); padding: clamp(var(--space-5), 3vw, var(--space-7));
            display: flex; flex-direction: column;
            scroll-margin-top: calc(var(--nav-h) + var(--space-4)); }
  .gtcard__title { font-family: var(--font-display); font-size: var(--text-lg); color: var(--fg-primary);
                   letter-spacing: var(--tracking-tight); margin: 0 0 var(--space-2); }
  .gtcard__sub { color: var(--fg-secondary); font-size: var(--text-sm); line-height: var(--leading-normal); margin: 0 0 var(--space-5); }
  .gtcard__sliders { display: grid; gap: var(--space-5); margin-bottom: var(--space-6); }
  .gtsl { display: grid; gap: var(--space-3); }
  .gtsl__lbl { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-3);
               font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: var(--tracking-wide);
               text-transform: uppercase; color: var(--fg-secondary); }
  .gtsl__lbl b { color: var(--accent-gold); font-size: var(--text-sm); font-weight: 600; }
  .gtcard__out { border-top: 1px solid var(--border-subtle); padding-top: var(--space-5); margin-top: auto; }
  .gtcard__outlbl { display: block; font-family: var(--font-mono); font-size: var(--text-xs);
                    letter-spacing: var(--tracking-wide); text-transform: uppercase; color: var(--fg-subtle); margin-bottom: var(--space-2); }
  .gtcard__num { font-family: var(--font-mono); font-size: var(--text-3xl); font-weight: 600; color: var(--accent-gold);
                 line-height: 1; letter-spacing: var(--tracking-tight); }
  .gtcard__disc { font-size: var(--text-xs); color: var(--fg-subtle); line-height: var(--leading-normal); margin: var(--space-3) 0 var(--space-5); }
  .gtcard__cta { display: inline-flex; align-items: center; gap: var(--space-2); align-self: flex-start;
                 min-height: var(--tap-min); font-family: var(--font-mono); font-size: var(--text-sm);
                 letter-spacing: var(--tracking-wide); color: var(--accent-gold); text-decoration: none;
                 transition: gap var(--duration-base) var(--ease); }
  .gtcard__cta svg { width: 16px; height: 16px; }
  .gtcard__cta:hover { gap: var(--space-3); }
  .gtcard__actions { display: flex; align-items: center; gap: var(--space-6); flex-wrap: wrap; }
  /* Puente a Marcy: mismo lenguaje que el CTA, en teal (el color de Marcy). */
  .gtcard__cta--marcy { background: none; border: 0; padding: 0; cursor: pointer; color: var(--accent-teal); }

  .gtcard--diag { grid-column: 1 / -1; text-decoration: none; align-items: flex-start;
                  transition: border-color var(--duration-base) var(--ease), box-shadow var(--duration-base) var(--ease); }
  .gtcard--diag:hover { border-color: var(--border-accent); box-shadow: var(--shadow-hover); }
  .gtcard__diag-ic { display: grid; place-items: center; width: 44px; height: 44px; border-radius: var(--radius-md);
                     background: var(--accent-gold-dim); border: 1px solid var(--accent-gold-line); margin-bottom: var(--space-4); }
  .gtcard__diag-ic svg { width: 22px; height: 22px; color: var(--accent-gold); }
  .gtcard__cta--ghost { margin-top: var(--space-4); }

  @media (max-width: 767px) {
    .gtool__grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { track } from '../../lib/track.js';
  import { computeMissedCalls, computeNoShows } from '../../../lib/tools-formulas.mjs';

  const lang = document.documentElement.lang === 'en' ? 'en' : 'es';
  const nf = new Intl.NumberFormat(lang === 'en' ? 'en-US' : 'es-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const bucket = (v) => (v < 1000 ? '<1k' : v < 5000 ? '1-5k' : v < 15000 ? '5-15k' : '15k+');

  document.querySelectorAll('[data-calc]').forEach((card) => {
    const type = card.dataset.calc;
    const inputs = [...card.querySelectorAll('input[type=range]')];
    const out = card.querySelector('[data-out]');
    const get = (role) => Number(card.querySelector(`input[data-role=${role}]`)?.value || 0);
    let started = false;
    let cur = numFromOut(out);
    let doneTimer = null;

    function numFromOut(el) { const m = (el.textContent || '').replace(/[^\d.]/g, ''); return Number(m) || 0; }

    function compute() {
      if (type === 'calls') return computeMissedCalls({ llamadas_semana: get('callsWeek'), pct_sin_contestar: get('missed'), ticket: get('ticket'), tasa_cierre: get('close') }).monthly;
      return computeNoShows({ citas_semana: get('apptWeek'), pct_no_show: get('noShow'), valor_cita: get('apptValue') }).monthly;
    }

    function fmtLabel(input) {
      const b = input.closest('.gtsl').querySelector('[data-val]');
      const kind = b.dataset.fmt;
      const v = Number(input.value);
      b.textContent = kind === 'cur' ? nf.format(v) : kind === 'pct' ? `${v}%` : String(v);
    }

    function animateTo(target) {
      target = Math.round(target);
      if (reduce) { out.textContent = '≈ ' + nf.format(target); cur = target; return; }
      const from = cur, t0 = performance.now();
      const tick = (t) => {
        const k = Math.min(1, (t - t0) / 500);
        const v = Math.round(from + (target - from) * (1 - Math.pow(1 - k, 3)));
        out.textContent = '≈ ' + nf.format(v);
        if (k < 1) requestAnimationFrame(tick); else cur = target;
      };
      requestAnimationFrame(tick);
    }

    inputs.forEach((input) => {
      input.addEventListener('input', () => {
        fmtLabel(input);
        animateTo(compute());
        if (!started) { started = true; track('calculator_started', { type }); }
        clearTimeout(doneTimer);
        doneTimer = setTimeout(() => track('calculator_completed', { type, loss_bucket: bucket(compute()) }), 700);
      });
    });

    // Puente a Marcy: manda al chat los números que el propio visitante puso (sin
    // PII) vía `mrc:ask`; el ChatWidget lo envía por su flujo normal y Marcy los
    // confirma con su calculadora interna antes de proponer.
    const marcyBtn = card.querySelector('[data-marcy]');
    if (marcyBtn) marcyBtn.addEventListener('click', () => {
      const v = nf.format(Math.round(compute()));
      const en = lang === 'en';
      let msg;
      if (type === 'calls') {
        msg = en
          ? 'I just used the missed-calls calculator: about ' + get('callsWeek') + ' calls a week, I miss ' + get('missed') + '%, my average ticket is $' + get('ticket') + ' and I close ' + get('close') + '%. It says I could be losing ' + v + ' a month. What should I do about it?'
          : 'Acabo de usar la calculadora de llamadas perdidas: recibo unas ' + get('callsWeek') + ' llamadas por semana, se me escapa el ' + get('missed') + '%, mi ticket promedio es $' + get('ticket') + ' y cierro el ' + get('close') + '%. Me sale que podría estar perdiendo ' + v + ' al mes. ¿Qué me conviene hacer?';
      } else {
        msg = en
          ? 'I just used the no-show calculator: about ' + get('apptWeek') + ' appointments a week, ' + get('noShow') + '% no-shows, and each appointment is worth $' + get('apptValue') + '. It says I could recover ' + v + ' a month. What should I do about it?'
          : 'Acabo de usar la calculadora de citas perdidas: tengo unas ' + get('apptWeek') + ' citas por semana, el ' + get('noShow') + '% no llega, y cada cita vale $' + get('apptValue') + '. Me sale que podría recuperar ' + v + ' al mes. ¿Qué me conviene hacer?';
      }
      track('calc_marcy_opened', { type });
      window.dispatchEvent(new CustomEvent('mrc:ask', { detail: { text: msg } }));
    });
  });
</script>
