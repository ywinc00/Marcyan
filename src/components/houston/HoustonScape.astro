---
// Silueta del centro de Houston de noche para el pie de /es/houston y /en/houston (slot "scape" de SiteFooter).
// Calcada de una foto con licencia libre (Wikimedia Commons, "DowntownHouston.jpg", CC BY-SA 2.0).
---
<div class="foot__scape" aria-hidden="true">
  <div class="foot__clouds" data-clouds="foot"></div>
  <canvas class="foot__skyline" data-skyline></canvas>
</div>

<style>
  .foot__scape {
    position: relative; height: clamp(210px, 28vh, 270px); margin-top: 4px; pointer-events: none;
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 18%);
    mask-image: linear-gradient(180deg, transparent, #000 18%);
  }
  .foot__clouds { position: absolute; inset: 0; }
  .foot__skyline { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .foot__clouds :global(.clouds__l) { position: absolute; inset: 0; }
  .foot__clouds :global(.cloud) { position: absolute; display: block; }
  @media (max-width: 600px) { .foot__scape { height: 170px; } }
  /* la línea legal del pie cae en la misma columna que el resto (en el pie común su relleno lateral queda a cero) */
  :global(.footer .footer__bottom.container) { padding-inline: var(--container-pad); }
</style>

<script>
  import { initSkyline } from './skyline.js';
  initSkyline();
</script>
