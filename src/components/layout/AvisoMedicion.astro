---
// Banner de medición (encargo legal 2026-11-15 §2c). Google Analytics no se carga hasta
// «Aceptar»; la elección se recuerda en este navegador (clave mrc-medicion, ver gaInit en
// Layout.astro). Los dos botones con el mismo peso: ninguno empuja más que el otro.
// Piezas: F-09 (aparece fijo abajo, fuera del flujo: no mueve la página), H-09 (foco de 2 px y
// contraste del texto), F-02 (sin movimiento con movimiento reducido). Abajo a la izquierda para
// no tapar el botón del chat; el chat abierto queda por encima.
import Button from '../ui/Button.astro';
interface Props { lang: 'es' | 'en' }
const { lang } = Astro.props;
const t = lang === 'en'
  ? { text: 'We use Google Analytics to measure visits.', ok: 'Accept', no: 'Decline', label: 'Measurement notice' }
  : { text: 'Usamos Google Analytics para medir visitas.', ok: 'Aceptar', no: 'Rechazar', label: 'Aviso de medición' };
---
<section class="medicion" data-medicion aria-label={t.label} hidden>
  <p class="medicion__txt">{t.text}</p>
  <div class="medicion__btns">
    <Button variant="secondary" size="md" data-medicion-si>{t.ok}</Button>
    <Button variant="secondary" size="md" data-medicion-no>{t.no}</Button>
  </div>
</section>

<style>
  .medicion {
    position: fixed; z-index: calc(var(--z-drawer) - 1);
    left: max(12px, env(safe-area-inset-left, 0px));
    bottom: max(12px, env(safe-area-inset-bottom, 0px));
    /* En el teléfono deja libre la esquina del chat (botón de 56 px más su margen). */
    right: calc(12px + 56px + 12px);
    max-inline-size: 400px;
    display: grid; gap: var(--space-3);
    padding: var(--space-4);
    background: var(--bg-card); border: 1px solid var(--border-accent); border-radius: var(--radius-lg);
    box-shadow: 0 12px 32px -12px rgba(0, 0, 0, .7);
    animation: medicion-in var(--duration-base, 240ms) var(--ease-out-expo, ease-out) both;
  }
  /* Desde tableta, una sola fila baja (texto y botones en línea) para tapar lo mínimo de la portada. */
  @media (min-width: 640px) {
    .medicion { right: auto; inline-size: auto; max-inline-size: calc(100vw - 48px - 80px); bottom: 24px; left: 24px;
      grid-template-columns: auto auto; align-items: center; gap: var(--space-4); padding: var(--space-3) var(--space-3) var(--space-3) var(--space-4); }
    .medicion__btns { grid-template-columns: auto auto; }
    .medicion__btns :global(.btn) { min-inline-size: 104px; }
  }
  /* display:grid le gana al atributo hidden: sin esto el banner no se iría nunca. */
  .medicion[hidden] { display: none; }
  .medicion__txt { margin: 0; font-family: var(--font-body); font-size: var(--text-sm); line-height: 1.5; color: var(--fg-primary); }
  .medicion__btns { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2); }
  .medicion__btns :global(.btn) { inline-size: 100%; }
  @keyframes medicion-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .medicion { animation: none; } }
</style>

<script>
  // Sin elección guardada, se enseña. Si el navegador no deja guardar (ventana privada o
  // bloqueo), se enseña en cada visita y Analytics sigue sin cargarse hasta «Aceptar».
  const box = document.querySelector<HTMLElement>('[data-medicion]');
  if (box) {
    let v: string | null = null;
    try { v = localStorage.getItem('mrc-medicion'); } catch { v = null; }
    if (v !== 'si' && v !== 'no') box.hidden = false;
    const elegir = (ok: boolean) => {
      const w = window as any;
      if (typeof w.mrcMedicion === 'function') w.mrcMedicion(ok);
      else { try { localStorage.setItem('mrc-medicion', ok ? 'si' : 'no'); } catch {} }
      // El foco estaba en el botón que desaparece: vuelve al contenido principal sin saltar.
      const main = document.getElementById('main');
      box.hidden = true;
      if (main && document.activeElement === document.body) { main.setAttribute('tabindex', '-1'); main.focus({ preventScroll: true }); }
    };
    box.querySelector('[data-medicion-si]')?.addEventListener('click', () => elegir(true));
    box.querySelector('[data-medicion-no]')?.addEventListener('click', () => elegir(false));
  }
</script>
