---
// ─────────────────────────────────────────────────────────────
// LangNotice — aviso de idioma ES↔EN SIN redirección (plan maestro, Fase 0.3).
//
// Qué hace: si el navegador del visitante prefiere el OTRO idioma y esta página
// tiene espejo publicado, muestra una nota pequeña y fija ("Prefer English?")
// con UN enlace al espejo (la misma URL que ya declara el hreflang) y un cierre.
// Nunca redirige: el HTML es idéntico para todos y canonical/hreflang no cambian.
//
// Montaje: Layout.astro lo renderiza solo cuando `mirrorPath()` devuelve espejo
// (misma fuente que el conmutador de la nav). El servidor emite ÚNICAMENTE un
// <template> inerte (cero píxeles, cero CLS); el DOM visible lo construye el
// script client-side cuando se cumplen las condiciones de display.
//
// Display (todas a la vez): idioma primario del navegador empieza por el idioma
// contrario · no fue descartado (`mrc_lang_notice_dismissed`) · nunca eligió
// idioma (`mrc_lang_pref`, la escribe también el conmutador de la nav) · y cabe
// en el presupuesto de apilado móvil (fijos combinados ≤25% del viewport en el
// primer render; si no cabe, aparece tras el primer scroll).
//
// Decisión consciente: Googlebot renderiza con locale en-US y sin storage, así
// que en las páginas ES el aviso ES→EN formará parte del DOM indexado. Por eso es
// texto corto, un solo enlace al alternate ya declarado, y role="status".
//
// Acotación de precedente: esta es la ÚNICA lógica de display por visitante
// sancionada en el sitio. No sirve de precedente para otra personalización.
// ─────────────────────────────────────────────────────────────
import Icon from '../ui/Icon.astro';

interface Props {
  /** Idioma de la PÁGINA actual. El aviso invita al otro. */
  lang: 'es' | 'en';
  /** Ruta del espejo (sale de mirrorPath en Layout). */
  href: string;
}
const { lang, href } = Astro.props;

// Direcciones activas, por idioma de la página en la que aparece el aviso.
//   es: true → en páginas ES se ofrece inglés ("Prefer English?"). ACORDADA.
//   en: true → en páginas EN se ofrece español ("¿Prefieres español?"). Se enseña
//              funcionando en el preview y el DUEÑO decide si sale activada.
//              Para apagarla: en → false (una línea, sin tocar nada más).
const DIRECTIONS: Record<'es' | 'en', boolean> = { es: true, en: true };

const target: 'es' | 'en' = lang === 'es' ? 'en' : 'es';
// El texto va en el idioma del VISITANTE (el destino), no en el de la página.
const copy =
  target === 'en'
    ? { q: 'Prefer English?', action: 'View in English', close: 'Close', region: 'Language' }
    : { q: '¿Prefieres español?', action: 'Ver en español', close: 'Cerrar', region: 'Idioma' };
---
{DIRECTIONS[lang] && (
  <template data-lang-notice data-dir={`${lang}-${target}`} data-target={target}>
    <aside class="langnotice" role="status" lang={target} aria-label={copy.region}>
      <span class="langnotice__ic" aria-hidden="true"><Icon name="lucide:languages" /></span>
      <div class="langnotice__body">
        <p class="langnotice__q">{copy.q}</p>
        <a class="langnotice__go" href={href} hreflang={target} data-lang-accept>
          <span>{copy.action}</span>
          <Icon name="lucide:arrow-right" />
        </a>
      </div>
      <button type="button" class="langnotice__close" aria-label={copy.close} data-lang-dismiss>
        <Icon name="lucide:x" />
      </button>
    </aside>
  </template>
)}

<style>
  /* Nota pequeña abajo a la izquierda. Deja libre la zona del FAB del chat
     (58px + márgenes, a la derecha) en todos los anchos: el ancho máximo se
     resta esa franja. z-index --z-nav: por debajo del FAB (--z-drawer), del
     velo/drawer del menú y del panel del chat; misma capa que la barra CTA. */
  .langnotice {
    position: fixed; left: var(--space-3);
    bottom: calc(var(--space-3) + env(safe-area-inset-bottom));
    z-index: var(--z-nav);
    width: max-content;
    max-width: min(360px, calc(100vw - var(--space-3) - 96px));
    display: flex; align-items: flex-start; gap: var(--space-3);
    padding: var(--space-3) var(--space-2) var(--space-3) var(--space-4);
    background: var(--bg-elevated); border: 1px solid var(--border);
    border-radius: var(--radius-lg); box-shadow: var(--shadow-card);
    opacity: 0; transform: translateY(8px);
    transition: opacity var(--duration-base) var(--ease-out-expo),
                transform var(--duration-base) var(--ease-out-expo),
                bottom var(--duration-base) var(--ease-out-expo);
  }
  .langnotice.is-in { opacity: 1; transform: none; }

  /* Móvil: cuando la barra CTA inferior está visible, sube por encima de ella
     (mismo offset que usa el FAB del chat, así los dos quedan alineados). */
  @media (--lt-md) {
    :global(body.has-ctabar) .langnotice {
      bottom: calc(var(--tap-min) + var(--space-3) * 3 + env(safe-area-inset-bottom));
    }
  }

  .langnotice__ic { color: var(--accent-gold); flex: 0 0 auto; margin-top: 3px; display: inline-flex; }
  .langnotice__ic :global(svg) { width: 18px; height: 18px; stroke-width: 1.5; }

  .langnotice__body { display: flex; flex-direction: column; min-width: 0; }
  .langnotice__q {
    font-family: var(--font-body); font-weight: 600; font-size: var(--text-sm);
    line-height: var(--leading-snug); color: var(--fg-primary);
    padding-top: 2px;
  }
  /* Acción principal = enlace real (no un botón nuevo: la gramática de botones
     es del sitio). Oro, 44px de alto para el pulgar, flecha que se desplaza. */
  .langnotice__go {
    display: inline-flex; align-items: center; gap: var(--space-1);
    /* 44px de zona táctil, pero la caja visual se recoge con margen negativo
       para que la tarjeta no quede alta y hueca; align-self para que la flecha
       abrace al texto en vez de irse al borde derecho de la tarjeta. */
    align-self: flex-start; min-height: var(--tap-min); margin: -6px 0 -10px;
    font-family: var(--font-body); font-weight: 600; font-size: var(--text-sm);
    color: var(--accent-gold); text-decoration: none;
    transition: color var(--duration-fast);
  }
  .langnotice__go :global(svg) {
    width: 16px; height: 16px; stroke-width: 1.5; flex: 0 0 auto;
    transition: transform var(--duration-fast) var(--ease-out-expo);
  }
  .langnotice__go:hover { color: var(--fg-primary); }
  .langnotice__go:hover :global(svg) { transform: translateX(3px); }

  /* Cierre: mismo patrón que .nav__close (44×44, secundario → primario). */
  .langnotice__close {
    display: inline-flex; align-items: center; justify-content: center;
    width: var(--tap-min); height: var(--tap-min); flex: 0 0 auto;
    margin: calc(var(--space-2) * -1) 0 calc(var(--space-2) * -1) 0;
    color: var(--fg-secondary); border-radius: var(--radius-md);
    transition: color var(--duration-fast);
  }
  .langnotice__close:hover { color: var(--fg-primary); }
  .langnotice__close :global(svg) { width: 20px; height: 20px; stroke-width: 1.75; }

  @media (--motion-reduce) {
    .langnotice, .langnotice__go, .langnotice__go :global(svg), .langnotice__close { transition: none; }
    .langnotice__go:hover :global(svg) { transform: none; }
  }
  @media print { .langnotice { display: none; } }
</style>

<script>
  import { track } from '../../lib/track.js';

  const KEY_PREF = 'mrc_lang_pref';                 // 'es' | 'en' · elección explícita (silencia ambas direcciones)
  const KEY_DISMISS = 'mrc_lang_notice_dismissed';  // '1' · cierre sin elegir
  // Presupuesto de apilado en el primer render (móvil): fijos combinados ≤ 25%.
  const STACK_BUDGET = 0.25;

  const read = (k: string) => { try { return localStorage.getItem(k); } catch { return null; } };
  const write = (k: string, v: string) => { try { localStorage.setItem(k, v); } catch {} };

  const tpl = document.querySelector<HTMLTemplateElement>('template[data-lang-notice]');

  function wants(target: string): boolean {
    const primary = ((navigator.languages && navigator.languages[0]) || navigator.language || '').toLowerCase();
    return primary.startsWith(target);
  }

  function mount(tpl: HTMLTemplateElement) {
    const dir = tpl.dataset.dir || '';
    const target = tpl.dataset.target || '';
    const node = tpl.content.firstElementChild?.cloneNode(true) as HTMLElement | null;
    if (!node) return;
    document.body.appendChild(node);

    // Tope de apilado: nav fija + este aviso (el FAB comparte su misma franja
    // inferior, no suma). Si no cabe en el 25% del viewport, se retira y vuelve
    // a intentarlo tras el primer scroll del visitante.
    // (innerHeight 0 = pestaña aún sin viewport medible: no se juzga, se muestra.)
    const navH = document.querySelector<HTMLElement>('[data-nav]')?.offsetHeight || 0;
    if (window.innerHeight > 0 && window.scrollY < 24 && navH + node.offsetHeight > window.innerHeight * STACK_BUDGET) {
      node.remove();
      window.addEventListener('scroll', () => mount(tpl), { once: true, passive: true });
      return;
    }

    requestAnimationFrame(() => requestAnimationFrame(() => node.classList.add('is-in')));
    track('lang_notice_shown', { dir });

    const onKey = (e: KeyboardEvent) => {
      // Esc cierra SOLO si el foco está dentro del aviso (no roba el Esc del menú/chat).
      if (e.key === 'Escape' && node.contains(document.activeElement)) dismiss();
    };
    const teardown = () => { document.removeEventListener('keydown', onKey); node.remove(); };
    const dismiss = () => { write(KEY_DISMISS, '1'); track('lang_notice_dismissed', { dir }); teardown(); };

    node.querySelector('[data-lang-dismiss]')?.addEventListener('click', dismiss);
    node.querySelector('[data-lang-accept]')?.addEventListener('click', () => {
      write(KEY_PREF, target);                      // elección explícita → silencio permanente
      track('lang_notice_accepted', { dir });       // sendBeacon sobrevive a la navegación
    });
    document.addEventListener('keydown', onKey);
  }

  function init() {
    if (!tpl) return;
    const target = tpl.dataset.target || '';
    if (!wants(target)) return;
    if (read(KEY_PREF)) return;
    if (read(KEY_DISMISS) === '1') return;
    mount(tpl);
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
</script>
