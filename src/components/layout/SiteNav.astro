---
// Navegación del sitio. Mobile-first:
//  · < md  → marca + hamburguesa → drawer off-canvas (links + lang + CTA dentro)
//  · ≥ md  → barra completa (links + lang ES|EN + CTA outline inline).
// Sobre el hero la barra es TRANSPARENTE (se funde); al hacer scroll gana blur+fondo.
// Accesible: aria-expanded, aria-hidden/inert, foco atrapado, Esc/overlay cierran,
// objetivos ≥44px. NUNCA se oculta la nav sin reemplazo (regla dura nº2).
import Icon from '../ui/Icon.astro';
import BrandType from '../brand/BrandType.astro';
import Button from '../ui/Button.astro';
import { toggleHref } from '../../i18n/routes';
import { t, type Lang } from '../../i18n/ui';
// Megamenú (design/rediseno-workos.md §2.12, G10) + sprite de iconos-objeto (§2.8).
import MegaServicios from '../w/nav/MegaServicios.astro';
import DrawerGrupos from '../w/nav/DrawerGrupos.astro';
import { navW, navIcon, cubiertoPorGrupos } from '../../i18n/w/nav';

interface Props {
  nav: any;
  lang?: string;
  homeHref?: string;
  hasEn?: boolean;
  currentPath?: string;
  /** Ruta para el enlace del otro idioma, si no es la actual (un artículo del blog
   *  sin traducción manda al índice del blog en el otro idioma). */
  langPath?: string;
  /** Megamenú de Servicios + grupos del drawer. false = nav de siempre (plan B, §2.12). */
  mega?: boolean;
}
const {
  nav,
  lang = 'es',
  homeHref = '/es',
  hasEn = true,
  currentPath,
  langPath,
  mega = true,
} = Astro.props;
const otherHref = toggleHref(langPath ?? currentPath ?? '/', lang as Lang);
const uin = t(lang as Lang);
// Evento del CTA: por defecto "propuesta pedida"; una página cuyo CTA es otra
// cosa (p. ej. WhatsApp en el brief y el kit) pasa nav.cta.track.
const ctaTrack = nav.cta.track || 'proposal_requested';

// aria-current: marca el link activo (no aplica al ancla de #contacto). La página
// exacta lleva 'page'; una página de dentro de esa sección (un artículo del blog,
// una landing de Houston) lleva 'true': se ve igual, pero no se anuncia como
// «página actual» a quien no está en ella.
const isActive = (href: string) =>
  !!currentPath && href !== '#contacto' && currentPath.startsWith(href);
const sinBarra = (p: string) => p.replace(/\/+$/, '') || '/';
const ariaCurrent = (href: string) =>
  !isActive(href) ? undefined : sinBarra(currentPath || '') === sinBarra(href) ? 'page' : 'true';

// Megamenú: se acopla al enlace cuyo href termina en /servicios o /services.
const navLang = (lang === 'en' ? 'en' : 'es') as 'es' | 'en';
const isServicesLink = (href: string) => /\/(servicios|services)\/?$/.test(href);
const hasMega = mega && nav.links.some((l: any) => isServicesLink(l.href));
const uiw = navW[navLang];
// En el drawer, los enlaces que ya representan los grupos no se repiten.
const drawerLinks = hasMega ? nav.links.filter((l: any) => !cubiertoPorGrupos(l.href)) : nav.links;
---
<header class="nav" data-nav>
  <div class="nav__bar container">
    <a class="nav__logo" href={homeHref} aria-label={uin.nav.home}>
      <BrandType />
    </a>

    <nav class="nav__links" aria-label={uin.nav.primary}>
      {nav.links.map((l: any) => hasMega && isServicesLink(l.href)
        ? (
          <span class="nav__mega" data-nav-mega-wrap>
            <a href={l.href} aria-current={ariaCurrent(l.href)}>{l.label}</a>
            <button class="nav__mega-btn" type="button" aria-expanded="false" aria-controls="nav-mega" aria-label={uiw.megaBtn} data-nav-mega-btn>
              {/* SVG propio (navIcon), no astro-icon: así ningún icono de la página
                  (p. ej. el hero de portada) cambia de marcado por el megamenú. */}
              <Fragment set:html={navIcon('lucide:chevron-down')} />
            </button>
            {/* Justo detrás del botón: el Tab entra en el panel. Posición absoluta
                respecto al <header> (ningún ancestro intermedio está posicionado). */}
            <MegaServicios lang={navLang} currentPath={currentPath} />
          </span>
        )
        : <a href={l.href} aria-current={ariaCurrent(l.href)}>{l.label}</a>)}
    </nav>

    <div class="nav__actions">
      <div class="nav__lang" aria-label={uin.nav.language}>
        {lang === 'es'
          ? <span class="nav__lang-opt is-on" aria-current="true">ES</span>
          : <a class="nav__lang-opt" href={otherHref} hreflang="es">ES</a>}
        <span class="nav__lang-sep" aria-hidden="true"></span>
        {lang === 'en'
          ? <span class="nav__lang-opt is-on" aria-current="true">EN</span>
          : <a class="nav__lang-opt" href={otherHref} hreflang="en" title={lang === 'es' ? 'English version' : 'Versión en español'}>EN</a>}
      </div>
      <a class="nav__cta" href={nav.cta.href} data-track={ctaTrack}>{nav.cta.label}</a>
      <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-drawer" data-nav-toggle>
        <span class="sr-only">{nav.openMenu}</span>
        <Icon name="lucide:menu" />
      </button>
    </div>
  </div>
</header>

{/* El menú móvil es un <dialog> abierto con showModal() (pieza E-03): el navegador
    da el foco atrapado, la página inerte detrás, Escape y el gesto atrás de
    Android, sin trampa hecha a mano. Va FUERA del <header>: .nav aplica
    backdrop-filter y un ancestro con filtro o transform es el containing block
    de sus descendientes fijos. El velo es su ::backdrop. */}
<dialog id="nav-drawer" class="nav__drawer" data-nav-drawer aria-label={uin.nav.menu}>
  <div class="nav__drawer-head">
    <BrandType />
    <button class="nav__close" type="button" data-nav-close>
      <span class="sr-only">{nav.closeMenu}</span>
      <Icon name="lucide:x" />
    </button>
  </div>
  <nav class="nav__drawer-links" aria-label={uin.nav.mobileMenu}>
    {drawerLinks.map((l: any) => <a href={l.href} data-nav-link aria-current={ariaCurrent(l.href)}>{l.label}</a>)}
  </nav>
  {hasMega
    ? <DrawerGrupos lang={navLang} currentPath={currentPath} />
    : (
      <div class="nav__drawer-foot">
        <Button href={nav.cta.href} variant="primary" size="lg" class="u-full" data-nav-link data-track={ctaTrack}>{nav.cta.label}</Button>
      </div>
    )}
</dialog>

{/* v5 (dueño, 2026-11-07): sin barra fija de «Propuesta gratis» en móvil; el formulario normal
    vive en el chat de Marcy («Formulario de contacto») y en la sección #contacto. */}

<style>
  .nav {
    position: fixed; inset: 0 0 auto 0; z-index: var(--z-nav);
    transition: background var(--duration-slow) var(--ease-out-expo),
                border-color var(--duration-slow), backdrop-filter var(--duration-slow);
    border-bottom: 1px solid transparent;
  }
  /* Sobre el hero: transparente (se funde). Al hacer scroll: blur + fondo. */
  .nav.is-scrolled {
    background: var(--bg-overlay);
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    border-bottom-color: var(--border);
  }
  .nav__bar {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-4);
    height: var(--nav-h);
  }
  .nav__logo { flex: 0 0 auto; display: inline-flex; align-items: center; }

  .nav__links { display: none; }
  .nav__actions { display: flex; align-items: center; gap: var(--space-3); }

  /* Switch de idioma ES | EN (ambos visibles, el activo en oro) — visible también en móvil */
  .nav__lang { display: inline-flex; align-items: center; gap: var(--space-2); }
  .nav__lang-opt {
    font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: var(--tracking-wide);
    color: var(--fg-secondary); transition: color var(--duration-fast);
    min-height: var(--tap-min); display: inline-flex; align-items: center;
    position: relative;
  }
  /* Zona táctil de 44 px de ancho sin mover el dibujo del conmutador (WCAG 2.5.8). */
  .nav__lang-opt::before { content: ''; position: absolute; inset: 0 -12px; }
  .nav__lang-opt.is-on { color: var(--accent-gold); }
  .nav__lang-opt.is-disabled { color: var(--fg-subtle); opacity: .5; cursor: default; }
  a.nav__lang-opt:hover { color: var(--fg-primary); }
  .nav__lang-sep { width: 1px; height: 13px; background: var(--border); }

  /* CTA outline dorado (se funde con el hero, no es un bloque sólido) */
  .nav__cta {
    display: none; align-items: center; justify-content: center;
    min-height: var(--tap-min); padding: 9px 18px; border-radius: var(--radius-md);
    font-family: var(--font-body); font-size: var(--text-sm); font-weight: 600;
    color: var(--accent-gold); background: var(--accent-gold-dim);
    border: 1px solid var(--accent-gold-line);
    white-space: nowrap;
    transition: background var(--duration-fast) var(--ease-out-expo), color var(--duration-fast);
  }
  .nav__cta:hover { background: var(--accent-gold); color: var(--fg-inverse); }

  .nav__toggle {
    display: inline-flex; align-items: center; justify-content: center;
    width: var(--tap-min); height: var(--tap-min); color: var(--fg-primary);
    border-radius: var(--radius-md);
  }
  .nav__toggle :global(svg) { width: 26px; height: 26px; stroke-width: 1.75; }

  /* página actual (aria-current), en barra y drawer, todos los breakpoints: color y
     además un subrayado de 2 px, para que no dependa solo del color y se distinga
     del hover (DESIGN.md de la agencia, NAVEGACIÓN). */
  .nav__links a[aria-current], .nav__drawer-links a[aria-current] {
    color: var(--accent-gold); text-decoration-line: underline; text-decoration-thickness: 2px; text-decoration-color: var(--accent-gold); text-underline-offset: 6px;
  }

  /* ── ≥ md: barra completa ─────────────────────────────── */
  @media (--md) {
    /* gap ajustado para que 6 enlaces + marca + lang + CTA quepan a 768px */
    .nav__links { display: flex; align-items: center; gap: var(--space-4); }
    .nav__links a {
      font-family: var(--font-body); font-size: var(--text-sm); color: var(--fg-secondary);
      padding: var(--space-2) 0; transition: color var(--duration-fast); white-space: nowrap;
    }
    .nav__links a:hover { color: var(--fg-primary); }
    .nav__lang { display: inline-flex; }
    .nav__cta { display: inline-flex; }
    .nav__toggle { display: none; }
  }
  /* Megamenú: "Servicios" sigue siendo enlace; a su lado, el botón-chevron.
     16 px visibles y 44 de objetivo táctil con ::after. Entre 768 y 1024 el hueco
     entre enlaces baja de 16 a 12: devuelve los ~18 px que ocupa el botón y la
     barra mide lo mismo que antes (el CTA no se estrecha). */
  .nav__mega { display: none; }
  @media (--md) and (--lt-lg) { .nav__links:has(.nav__mega) { gap: var(--space-3); } .nav__cta { padding: 9px 12px; } }
  @media (--md) {
    .nav__mega { display: inline-flex; align-items: center; gap: 2px; }
    .nav__mega-btn {
      position: relative; display: inline-flex; align-items: center; justify-content: center;
      width: 16px; height: var(--tap-min); padding: 0; color: var(--fg-secondary);
      transition: color var(--duration-fast);
    }
    .nav__mega-btn::after { content: ''; position: absolute; inset: 0 -12px; }
    .nav__mega-btn :global(svg) {
      flex: none; width: 14px; height: 14px; stroke-width: 2;
      transition: transform 150ms var(--w-ease-ui, ease);
    }
    .nav__mega-btn[aria-expanded="true"] { color: var(--fg-primary); }
    .nav__mega-btn[aria-expanded="true"] :global(svg) { transform: rotate(180deg); }
    .nav__mega-btn:hover { color: var(--fg-primary); }
  }
  @media (--motion-reduce) { .nav__mega-btn :global(svg) { transition: none; } }

  /* ≥ lg: hay espacio de sobra → respira más entre enlaces */
  @media (--lg) { .nav__links { gap: var(--space-6); } }

  /* ── Drawer (off-canvas) ──────────────────────────────── */
  /* El velo es el ::backdrop del <dialog>: vive en la capa superior del navegador,
     por encima del botón del chat sin pelear con z-index. */
  .nav__drawer::backdrop {
    background: var(--bg-scrim);
    opacity: 0; transition: opacity var(--duration-base) var(--ease-out-expo);
  }
  /* Bloqueo de scroll con el drawer abierto. Va por clase, no por estilo inline, para
     que el propio CSS lo levante al pasar a ≥md: si se rota a horizontal con el menú
     abierto, el drawer se oculta y la página quedaría sin scroll y sin salida. */
  :global(body.has-drawer-open) { overflow: hidden; }
  @media (--md) { :global(body.has-drawer-open) { overflow: visible; } }
  /* El desenfoque solo mientras está abierto: en la regla base dejaría una capa de
     composición a pantalla completa en cada página móvil, aunque no se vea. */
  .nav__drawer[data-open]::backdrop {
    opacity: 1;
    backdrop-filter: blur(2px); -webkit-backdrop-filter: blur(2px);
  }

  /* Se anulan los estilos del navegador para <dialog> (margen, borde, tope de
     alto y ancho) para que el panel mida y se vea igual que antes. Cerrado no se
     pinta; abierto entra deslizándose desde la derecha. */
  .nav__drawer {
    position: fixed; inset: 0 0 0 auto; margin: 0; border: 0;
    width: min(86vw, 360px); max-width: 100%; height: 100%; max-height: none;
    color: inherit;
    display: none; flex-direction: column; gap: var(--space-6);
    padding: var(--space-5) var(--space-5) calc(var(--space-6) + env(safe-area-inset-bottom));
    background: var(--bg-elevated); border-left: 1px solid var(--border);
    transform: translateX(100%); transition: transform var(--duration-slow) var(--ease-out-expo);
    overflow-y: auto; overscroll-behavior: contain;
  }
  .nav__drawer[open] { display: flex; }
  .nav__drawer[data-open] { transform: translateX(0); }

  .nav__drawer-head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); }
  .nav__close {
    display: inline-flex; align-items: center; justify-content: center;
    width: var(--tap-min); height: var(--tap-min); color: var(--fg-secondary);
    border-radius: var(--radius-md); flex: 0 0 auto;
  }
  .nav__close:hover { color: var(--fg-primary); }
  .nav__close :global(svg) { width: 24px; height: 24px; stroke-width: 1.75; }

  .nav__drawer-links { display: flex; flex-direction: column; }
  .nav__drawer-links a {
    display: flex; align-items: center; min-height: var(--tap-min);
    font-family: var(--font-display); font-size: var(--text-lg); font-weight: 500;
    color: var(--fg-primary); padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border-subtle);
  }
  .nav__drawer-links a:hover { color: var(--accent-gold); }

  .nav__drawer-foot { margin-top: auto; display: flex; flex-direction: column; gap: var(--space-4); }

  @media (--md) { .nav__drawer[open] { display: none; } }

  @media (--motion-reduce) {
    .nav, .nav__drawer, .nav__drawer::backdrop { transition: none; }
  }

</style>

<script>
  const root = document.querySelector('[data-nav]');
  // El drawer es HERMANO del header (ver nota en el markup), así que se busca en
  // el documento, no dentro de [data-nav].
  const toggle = document.querySelector('[data-nav-toggle]') as HTMLButtonElement;
  const drawer = document.querySelector('[data-nav-drawer]') as HTMLDialogElement;
  const closeBtn = document.querySelector('[data-nav-close]') as HTMLButtonElement;
  // Estado "scrolled" de la barra. Va en su propio guard porque no depende del drawer:
  // así un cambio en el menú no puede dejar la nav sin fondo en todo el sitio.
  if (root) {
    // Solo se toca la clase cuando el estado CAMBIA (antes se tocaba en cada evento de scroll).
    let estado: boolean | null = null;
    const onScroll = () => {
      // Con el megamenú abierto la barra conserva su fondo (data-mega-open).
      const s = window.scrollY > 24 || root.hasAttribute('data-mega-open');
      if (s !== estado) { estado = s; root.classList.toggle('is-scrolled', s); }
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  // ── Megamenú de Servicios (§2.12) ──────────────────────────
  // Clic/Enter/Espacio siempre; hover con intención (120 ms entrar, 200 ms salir)
  // solo con puntero fino; Esc cierra y devuelve el foco; clic fuera, foco fuera
  // y pasar a < md cierran. Busca dentro de su propio nodo (E-51).
  const megaWrap = root?.querySelector<HTMLElement>('[data-nav-mega-wrap]');
  const megaBtn = root?.querySelector<HTMLButtonElement>('[data-nav-mega-btn]');
  const megaPanel = root?.querySelector<HTMLElement>('[data-nav-mega]');
  if (root && megaWrap && megaBtn && megaPanel) {
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
    const desk = window.matchMedia('(min-width: 768px)');
    let tIn = 0, tOut = 0, raf = 0;
    const isOpen = () => !megaPanel.hidden;
    const inside = (n: Node | null) => !!n && (megaWrap.contains(n) || megaPanel.contains(n));
    const openMega = () => {
      clearTimeout(tOut);
      if (isOpen()) return;
      megaPanel.hidden = false;
      megaBtn.setAttribute('aria-expanded', 'true');
      root.setAttribute('data-mega-open', '');
      root.classList.add('is-scrolled');
      cancelAnimationFrame(raf);
      // Dos fotogramas: el panel ya pintado en opacidad 0 antes del fundido.
      raf = requestAnimationFrame(() => { raf = requestAnimationFrame(() => megaPanel.setAttribute('data-open', '')); });
    };
    const closeMega = (returnFocus = false) => {
      clearTimeout(tIn); clearTimeout(tOut); cancelAnimationFrame(raf);
      if (!isOpen()) return;
      megaPanel.removeAttribute('data-open');
      megaPanel.hidden = true;
      megaBtn.setAttribute('aria-expanded', 'false');
      root.removeAttribute('data-mega-open');
      root.classList.toggle('is-scrolled', window.scrollY > 24);
      if (returnFocus) megaBtn.focus();
    };
    megaBtn.addEventListener('click', () => (isOpen() ? closeMega() : openMega()));
    [megaWrap, megaPanel].forEach((el) => {
      el.addEventListener('pointerenter', (e) => {
        if (e.pointerType !== 'mouse' || !fine.matches) return;
        clearTimeout(tOut);
        if (!isOpen()) tIn = window.setTimeout(openMega, 120);
      });
      el.addEventListener('pointerleave', (e) => {
        if (e.pointerType !== 'mouse' || !fine.matches) return;
        clearTimeout(tIn);
        tOut = window.setTimeout(() => closeMega(), 200);
      });
      el.addEventListener('focusout', (e) => {
        if (isOpen() && !inside(e.relatedTarget as Node | null)) closeMega();
      });
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) closeMega(true);
    });
    document.addEventListener('pointerdown', (e) => {
      if (isOpen() && !inside(e.target as Node)) closeMega();
    });
    desk.addEventListener('change', () => { if (!desk.matches) closeMega(); });
  }

  // Elección EXPLÍCITA de idioma (plan maestro 0.3): el conmutador ES|EN escribe
  // mrc_lang_pref y con ello silencia el aviso LangNotice en ambas direcciones.
  document.querySelectorAll<HTMLAnchorElement>('a.nav__lang-opt[hreflang]').forEach((a) =>
    a.addEventListener('click', () => { try { localStorage.setItem('mrc_lang_pref', a.hreflang); } catch {} }));

  if (toggle && drawer && closeBtn && typeof drawer.showModal === 'function') {
    const links = Array.from(drawer.querySelectorAll<HTMLElement>('[data-nav-link], a'));
    let lastFocus: HTMLElement | null = null;
    let closeTimer = 0;
    let porEnlace = false;   // cerrado por un enlace: el foco lo decide el salto, no se devuelve
    const quieto = window.matchMedia('(prefers-reduced-motion: reduce)');

    const focusables = () =>
      Array.from(drawer.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'))
        .filter((el) => el.offsetParent !== null);

    // showModal() da el foco atrapado, la página inerte y Escape. data-open va un
    // fotograma después para que el panel entre deslizándose como siempre.
    function open() {
      if (drawer.open) return;
      clearTimeout(closeTimer);
      lastFocus = document.activeElement as HTMLElement;
      drawer.showModal();
      toggle.setAttribute('aria-expanded', 'true');
      document.body.classList.add('has-drawer-open');
      focusables()[0]?.focus();
      requestAnimationFrame(() => requestAnimationFrame(() => drawer.setAttribute('data-open', '')));
    }
    // Al cerrar se deja salir el panel y luego se cierra el <dialog>. Con
    // movimiento reducido, o si se pide al instante (un enlace del menú), sin espera.
    function close(instant = false) {
      if (!drawer.open) return;
      drawer.removeAttribute('data-open');
      clearTimeout(closeTimer);
      if (instant || quieto.matches) { drawer.close(); return; }
      closeTimer = window.setTimeout(() => drawer.close(), 400);   // --duration-slow
    }
    // Lo que pasa al cerrarse, venga de donde venga (aspa, velo, Escape, enlace).
    drawer.addEventListener('close', () => {
      clearTimeout(closeTimer);
      drawer.removeAttribute('data-open');
      toggle.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('has-drawer-open');
      // Tras un enlace (p. ej. un ancla de la misma página) el foco sigue al destino:
      // devolverlo a la hamburguesa haría que Tab volviera arriba del todo.
      if (porEnlace) { porEnlace = false; return; }
      // Safari (iOS/macOS) no da foco a un <button> al tocarlo, así que lastFocus suele
      // ser el <body> y devolverle el foco lo mandaría al inicio del documento.
      (lastFocus && lastFocus !== document.body ? lastFocus : toggle).focus();
    });
    // Escape: el navegador lo cierra de golpe; se intercepta para que salga animado.
    drawer.addEventListener('cancel', (e) => { e.preventDefault(); close(); });
    // Toque en el velo: cae sobre el propio <dialog> pero fuera de su rectángulo
    // (no se mira solo event.target, que cerraría al tocar un hueco del panel).
    drawer.addEventListener('click', (e) => {
      if (e.target !== drawer) return;
      const r = drawer.getBoundingClientRect();
      const fuera = e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
      if (fuera) close();
    });

    // Tras el scroll a #contacto, mover el foco al primer campo del formulario.
    // Si #contacto no existe en la página, no hace nada (no lanza error).
    const focusContact = () => {
      requestAnimationFrame(() => {
        const t = document.getElementById('contacto');
        if (t) {
          t.setAttribute('tabindex', '-1');
          const f = t.querySelector<HTMLElement>('input,select,textarea');
          (f || t).focus({ preventScroll: true });
        }
      });
    };
    const isContactLink = (el: Element | null): el is HTMLAnchorElement =>
      !!el && el instanceof HTMLAnchorElement &&
      (el.getAttribute('href') || '').endsWith('#contacto');

    toggle.addEventListener('click', open);
    closeBtn.addEventListener('click', () => close());
    // Links del drawer: cerrar primero; si apuntan a #contacto, scroll+focus en el
    // siguiente frame para evitar el salto a medias mientras el drawer se cierra.
    // Solo un ancla de esta misma página manda el foco al destino. Teléfono, correo,
    // WhatsApp u otra página: el foco vuelve a la hamburguesa como al cerrar con el aspa.
    const esAnclaDeAqui = (a: HTMLElement) => {
      const href = a.getAttribute('href') || '';
      if (!href.includes('#')) return false;
      try { const u = new URL(href, location.href); return u.origin === location.origin && u.pathname === location.pathname; }
      catch { return false; }
    };
    links.forEach((l) => l.addEventListener('click', () => {
      porEnlace = esAnclaDeAqui(l);
      close(true);
      if (isContactLink(l)) requestAnimationFrame(focusContact);
    }));

    // Cualquier otro enlace a #contacto (nav__cta inline):
    // tras el scroll nativo del ancla, mover el foco al primer campo.
    document.addEventListener('click', (e) => {
      const a = (e.target as Element | null)?.closest?.('a[href$="#contacto"]');
      if (!a) return;
      if (drawer.contains(a)) return; // ya manejado arriba (con cierre previo)
      focusContact();
    });

    // Al rotar a horizontal (o ensanchar) el drawer pasa a display:none y con él
    // desaparecen el velo y la hamburguesa: sin esto nadie llamaría a close() y el
    // body se quedaría con el scroll bloqueado y sin manera visible de cerrarlo.
    // Se consulta el display real para no duplicar aquí el breakpoint de media.css.
    window.addEventListener('resize', () => {
      if (drawer.open && getComputedStyle(drawer).display === 'none') close(true);
    }, { passive: true });
  }
</script>
