---
// Sección "Tecnología Marcyan" (#ia) · vuelta 2 (design/rediseno-workos-v2.md §3 G01, notas 1 y 8).
// Se conservan section#ia[data-fx="teal"], kicker, H2, bajada, las 4 capacidades y el botón de
// content.ts (verbatim). Dos tramos:
//  (a) Izquierda: texto + capacidades como filas separadas por filetes de 1 px.
//      Derecha: VentanaAgente guion "marcy" piel "noche" (P05, W-ADV-16 + W-NEW-04): Marcy atiende
//      una petición real y el visitante elige qué más le pide; marca del modelo = LogoMarca claude.
//  (b) Debajo, centrado: "Así está montada" + ChipIA variante "portada" (P07, W-HOME-12/13) con
//      PildorasMarcas (P06): Piensa con · Contesta en · Te encuentran en (copy en i18n/w/portada.ts).
// Sin lienzo nuevo: la ventana es HTML y el chip es SVG. El demo de burbujas de la v1 se retira.
import Icon from '../ui/Icon.astro';
import Kicker from '../ui/Kicker.astro';
import Button from '../ui/Button.astro';
import VentanaAgente from '../w/agente/VentanaAgente.astro';
import ChipIA from '../w/chip/ChipIA.astro';
import PildorasMarcas from '../w/marcas/PildorasMarcas.astro';
import { iaMontada, iaRotulos } from '../../i18n/w/portada';

interface Props { ai: any }
const { ai } = Astro.props;
const lang: 'es' | 'en' = Astro.url.pathname.startsWith('/en') ? 'en' : 'es';
const M = iaMontada[lang];
---
<section class="section ai" id="ia" data-fx="teal">
  <div class="container ai__inner">
    <div class="ai__intro">
      <Kicker tone="teal">{ai.tag}</Kicker>
      <h2 class="h2" set:html={ai.title} />
      <p class="lead">{ai.desc}</p>
      {ai.cta && (
        <Button href={ai.cta.href} variant="teal" size="md" class="ai__cta">{ai.cta.label}</Button>
      )}
    </div>

    <div class="ai__agente">
      <VentanaAgente guion="marcy" piel="noche" lang={lang} />
    </div>

    <ul class="ai__caps">
      {ai.features.map((f: any) => (
        <li class="ai__cap">
          <span class="ai__cap-ic"><Icon name={f.icon} /></span>
          <div class="ai__cap-tx">
            <h3>{f.title}</h3>
            <p>{f.desc}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>

  <div class="ai__montada">
    <header class="container ai__mhead">
      <p class="ai__mk">{M.kicker}</p>
      <h3 class="ai__mt">{M.titulo}</h3>
      <p class="ai__mb">{M.bajada}</p>
    </header>
    <ChipIA variante="portada" lang={lang}>
      <PildorasMarcas slot="pildoras" filas={M.filas} rotulos={iaRotulos} />
    </ChipIA>
  </div>
</section>

<style>
  .ai :global(em) { color: var(--accent-teal); font-style: normal; }
  /* El horizonte del chip cierra la sección: menos aire abajo que el resto de secciones. */
  .ai { padding-bottom: clamp(40px, 4vw, 64px); }
  .ai__inner {
    --ai-l: rgba(var(--star-rgb, 240, 237, 232), .08);
    display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-7); align-items: start;
  }

  /* ── (a) Texto ── */
  .ai__intro { display: flex; flex-direction: column; gap: var(--space-4); align-items: flex-start; min-width: 0; }
  .ai__cta { margin-top: var(--space-3); }

  /* ── (a) Ventana de agente ── */
  .ai__agente { min-width: 0; display: flex; justify-content: center; }

  /* ── (a) Capacidades: filas con filete de 1 px (móvil) · 4 columnas con líneas de 1 px (PC) ── */
  .ai__caps { list-style: none; margin: 0; padding: 0; min-width: 0; border-top: 1px solid var(--ai-l); }
  .ai__cap {
    display: grid; grid-template-columns: 20px minmax(0, 1fr); column-gap: 14px; align-items: start;
    padding: 16px 0; border-bottom: 1px solid var(--ai-l);
  }
  .ai__cap-ic { display: inline-flex; color: var(--accent-teal); padding-top: 2px; }
  .ai__cap-ic :global(svg) { width: 18px; height: 18px; stroke-width: 1.5; }
  .ai__cap-tx { min-width: 0; }
  .ai__cap-tx h3 { margin: 0 0 4px; font-family: var(--font-display); font-size: 17px; line-height: 1.25; font-weight: 500; letter-spacing: -.01em; }
  .ai__cap-tx p { margin: 0; color: var(--fg-secondary); font-size: var(--text-sm); line-height: var(--leading-normal); }

  /* ── (b) Así está montada ── */
  .ai__montada { margin-top: clamp(64px, 7vw, 96px); }
  .ai__mhead { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 12px; margin-bottom: clamp(0px, 1vw, 12px); }
  .ai__mk {
    margin: 0; font-family: var(--font-mono); font-size: 12px; line-height: 1; letter-spacing: var(--tracking-wide);
    text-transform: uppercase; color: var(--accent-teal);
  }
  .ai__mt {
    margin: 0; font-family: var(--font-display); font-weight: 500; color: var(--fg-primary);
    font-size: clamp(28px, 3.4vw, 40px); line-height: 1.1; letter-spacing: -.03em; text-wrap: balance;
  }
  /* Las filas de píldoras (Piensa con · Contesta en · Te encuentran en) van una junto a otra y
     saltan solo si no caben: en PC, una línea; en móvil, dos (las de una píldora comparten fila).
     Así la escena no se alarga con tres pisos de una sola píldora. */
  .ai__montada :global(.pm:has(.pm-et)) { flex-direction: row; flex-wrap: wrap; justify-content: center; align-items: flex-start; column-gap: clamp(20px, 3vw, 40px); row-gap: 24px; }
  .ai__mb { margin: 0; max-width: 520px; color: var(--fg-secondary); font-size: 17px; line-height: 1.5; text-wrap: balance; }

  @media (--lg) {
    .ai__inner { grid-template-columns: minmax(0, 1fr) minmax(0, 528px); column-gap: var(--space-9); row-gap: 56px; align-items: center; }
    .ai__caps { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--ai-l); border-bottom: 0; }
    .ai__cap { display: flex; flex-direction: column; gap: 10px; padding: 28px 28px 4px; border-bottom: 0; }
    .ai__cap + .ai__cap { border-left: 1px solid var(--ai-l); }
    .ai__cap:first-child { padding-left: 0; }
    .ai__cap:last-child { padding-right: 0; }
    .ai__cap-ic { padding-top: 0; }
  }
</style>
