---
// Bloque "answer-first" (palanca AEO #1): H2 = pregunta literal + respuesta
// directa de 40-60 palabras con un dato/fuente. Pensado para citarse verbatim
// por asistentes de IA (ChatGPT/Gemini) y para featured snippets.
// El texto NO se duplica en schema aquí (la FAQPage vive en Faq.astro); este
// bloque es contenido visible de alta densidad informativa.
//
// Rediseño DS v2 "Space-Tech": tratamos la pregunta como TITULAR fuerte y la
// respuesta como CITA de alta densidad enmarcada por un riel mono "RESPUESTA"
// (lectura cómoda ~62ch). Acento teal de "dato/en vivo" (eco de AiSection):
// glow de esquina sutil, comilla line-art aria-hidden detrás de la pregunta,
// y la fuente como chip de dato mono con su icono bar-chart.
// NO se altera el texto de q / a / source (contenido citable verbatim).
import Icon from '../ui/Icon.astro';
interface Props {
  q: string;
  a: string;
  /** Fuente del dato citado, p.ej. "Google" o "SOCi, 2026". */
  source?: string;
}
const { q, a, source } = Astro.props;
---
<section class="section answer" aria-labelledby="answer-q">
  <div class="container">
    <article class="answer__card">
      <!-- comilla / eco espacial: line-art decorativo (no contenido) -->
      <svg class="answer__quote" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
        <path d="M27 18c-8 2-13 8-13 17 0 6 4 11 10 11 5 0 9-4 9-9s-4-9-9-9c-1 0-2 0-3 .3 1-4 4-7 9-8.3L27 18zM52 18c-8 2-13 8-13 17 0 6 4 11 10 11 5 0 9-4 9-9s-4-9-9-9c-1 0-2 0-3 .3 1-4 4-7 9-8.3L52 18z"/>
      </svg>

      <p class="answer__tag"><span class="answer__dot" aria-hidden="true"></span>Respuesta directa</p>
      <h2 class="answer__q" id="answer-q">{q}</h2>

      <div class="answer__readout">
        <p class="answer__a">{a}</p>
      </div>

      {source && (
        <p class="answer__src">
          <Icon name="lucide:bar-chart-3" /> <span>Fuente: {source}</span>
        </p>
      )}
    </article>
  </div>
</section>

<style>
  .answer { padding-block: 0; }

  .answer__card {
    position: relative; min-width: 0; overflow: hidden; isolation: isolate;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-card);
  }
  /* glow de esquina teal (eco de la barra de chat de AiSection), muy sutil */
  .answer__card::before {
    content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background:
      radial-gradient(120% 90% at 100% 0%, var(--accent-teal-dim), transparent 55%);
  }
  /* filete teal a la izquierda: señal de "dato citable" */
  .answer__card::after {
    content: ""; position: absolute; top: var(--space-6); bottom: var(--space-6); left: 0;
    width: 2px; border-radius: 0 2px 2px 0;
    background: linear-gradient(180deg, var(--accent-teal), transparent);
  }

  /* comilla decorativa, esquina superior derecha */
  .answer__quote {
    position: absolute; top: var(--space-4); right: var(--space-4);
    width: 56px; height: 56px; z-index: -1; pointer-events: none;
    fill: var(--accent-teal); opacity: 0.08;
  }

  /* kicker mono "en vivo" */
  .answer__tag {
    display: inline-flex; align-items: center; gap: var(--space-2);
    font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 500;
    letter-spacing: var(--tracking-widest); text-transform: uppercase;
    color: var(--accent-teal); margin-bottom: var(--space-3);
  }
  .answer__dot {
    width: 6px; height: 6px; border-radius: 50%; flex: 0 0 auto;
    background: var(--accent-teal);
    box-shadow: 0 0 0 0 var(--accent-teal);
    animation: answerlive 2.4s var(--ease-out-expo) infinite;
  }

  /* pregunta = titular fuerte (display) */
  .answer__q {
    font-family: var(--font-display); font-weight: 600;
    font-size: var(--fluid-h3); line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight); color: var(--fg-primary);
    max-width: 24ch; margin-bottom: var(--space-5);
  }

  /* respuesta = cita de alta densidad, ancho de lectura cómodo */
  .answer__readout { position: relative; padding-left: var(--space-5); }
  .answer__readout::before {
    content: ""; position: absolute; top: 6px; bottom: 6px; left: 0;
    width: 1px; background: var(--accent-teal-line);
  }
  .answer__a {
    font-family: var(--font-body); font-size: var(--fluid-lead);
    line-height: var(--leading-loose); color: var(--fg-primary); max-width: 62ch;
  }

  /* fuente = chip de dato mono */
  .answer__src {
    display: inline-flex; align-items: center; gap: var(--space-2);
    margin-top: var(--space-5); padding: var(--space-1) var(--space-3);
    border: 1px solid var(--accent-teal-line); border-radius: var(--radius-pill);
    background: var(--accent-teal-dim);
    font-family: var(--font-mono); font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide); color: var(--fg-secondary);
  }
  .answer__src :global(svg) { width: 14px; height: 14px; color: var(--accent-teal); flex: 0 0 auto; }

  @keyframes answerlive {
    0%   { box-shadow: 0 0 0 0 var(--accent-teal); }
    70%  { box-shadow: 0 0 0 5px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }
  @media (--motion-reduce) { .answer__dot { animation: none; } }

  @media (--md) {
    .answer__card { padding: var(--space-7) var(--space-8); }
    .answer__card::after { top: var(--space-7); bottom: var(--space-7); }
    .answer__quote { top: var(--space-6); right: var(--space-6); width: 72px; height: 72px; }
    .answer__readout { padding-left: var(--space-6); }
  }
</style>
