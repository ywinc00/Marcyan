---
// Cuerpo del artículo v3 (design/rediseno-workos.md §4.8; W-CONT-23 + W-CONV-37).
// Estiliza el HTML que produce <Content/> (el Markdown NO se reescribe). Escala de
// lectura de revista técnica: párrafo 19/1.65 en 680 (17 en móvil) con tinta al 90 %,
// H2 26/33.8 500, H3 22/28.6 500. Enlaces en oro subrayados SOLO dentro del texto
// (E-22). Las tablas que ya trae el Markdown se pintan como la comparativa W-CONV-37:
// tarjeta opaca de radio 12, cabecera 18/500, primera columna en tinta 500, divisores
// de 1 px, sin rayado de filas. Estilos a contenido dinámico = :global() bajo .article__body.
---
<div class="article">
  <div class="article__body"><slot /></div>
</div>

<style>
  .article { min-width: 0; }
  .article__body { position: relative; max-width: 680px; }

  /* Ritmo vertical */
  .article__body :global(p),
  .article__body :global(ul),
  .article__body :global(ol),
  .article__body :global(blockquote),
  .article__body :global(pre),
  .article__body :global(figure),
  .article__body :global(table),
  .article__body :global(hr) { margin: 24px 0 0; }
  .article__body :global(h2) { margin: 64px 0 0; }
  .article__body :global(h3) { margin: 40px 0 0; }
  .article__body :global(h4) { margin: 32px 0 0; }
  .article__body :global(h2 + p),
  .article__body :global(h3 + p),
  .article__body :global(h4 + p) { margin-top: 16px; }
  .article__body > :global(:first-child) { margin-top: 0; }

  /* Encabezados (W-CONT-23: 26/33.8 y 22/28.6, peso 500) */
  .article__body :global(h2),
  .article__body :global(h3),
  .article__body :global(h4) {
    font-family: var(--font-display); font-weight: 500; color: var(--w-ink);
    text-wrap: balance; scroll-margin-top: calc(var(--nav-h) + 24px);
  }
  .article__body :global(h2) { font-size: 1.625rem; line-height: 1.3; letter-spacing: -0.025em; }
  .article__body :global(h3) { font-size: 1.375rem; line-height: 1.3; letter-spacing: -0.02em; }
  .article__body :global(h4) { font-size: 1.1875rem; line-height: 1.35; letter-spacing: -0.01em; }

  /* Lectura: 19/1.65, tinta al 90 % */
  .article__body :global(p),
  .article__body :global(li) {
    font-family: var(--font-body); font-size: 1.1875rem; line-height: 1.65;
    color: rgba(var(--star-rgb), .9); text-wrap: pretty;
  }
  .article__body :global(strong) { color: var(--w-ink); font-weight: 600; }
  .article__body :global(em) { font-style: italic; }

  .article__body :global(a) {
    color: var(--accent-gold); text-decoration: underline;
    text-decoration-color: rgba(var(--accent-gold-rgb), .4); text-decoration-thickness: 1px; text-underline-offset: 4px;
    transition: text-decoration-color var(--w-dur-micro) var(--w-ease-ui);
  }
  @media (--hover-fine) { .article__body :global(a:hover) { text-decoration-color: var(--accent-gold); } }
  .article__body :global(a:focus-visible) {
    outline: 2px solid var(--accent-gold); outline-offset: 2px; border-radius: 2px;
  }

  /* Listas */
  .article__body :global(ul),
  .article__body :global(ol) { padding-left: 1.4em; }
  .article__body :global(ul) { list-style: disc; }
  .article__body :global(ol) { list-style: decimal; }
  .article__body :global(li + li) { margin-top: 10px; }
  .article__body :global(li::marker) { color: var(--accent-gold); }
  .article__body :global(li > ul),
  .article__body :global(li > ol) { margin-top: 10px; }

  /* Cita: bandeja opaca con filo oro a la izquierda */
  .article__body :global(blockquote) {
    background: var(--w-s1); border: 1px solid var(--w-line);
    border-left: 2px solid var(--accent-gold);
    border-radius: 0 var(--w-r-obj) var(--w-r-obj) 0;
    padding: 18px 24px; box-shadow: var(--w-edge);
  }
  .article__body :global(blockquote p) { color: var(--w-ink); font-size: 1.0625rem; line-height: 1.6; }
  .article__body :global(blockquote :first-child) { margin-top: 0; }

  /* Código */
  .article__body :global(code) {
    font-family: var(--font-mono); font-size: 0.85em; color: var(--w-ink);
    background: var(--w-s2); border: 1px solid var(--w-line);
    padding: 2px 6px; border-radius: 6px;
  }
  .article__body :global(pre) {
    background: var(--w-s2); border: 1px solid var(--w-line);
    border-radius: var(--w-r-obj); padding: 20px; overflow-x: auto;
  }
  .article__body :global(pre code) { background: none; border: 0; padding: 0; }

  .article__body :global(img) { border-radius: var(--w-r-cell); border: 1px solid var(--w-line); }
  .article__body :global(figcaption) { margin-top: 8px; font-size: 0.875rem; color: var(--w-ink-60); text-align: center; }

  .article__body :global(hr) { border: 0; height: 1px; background: var(--w-line); margin-block: 48px; }

  /* Tablas del Markdown = comparativa W-CONV-37 (tarjeta opaca, radio 12, divisores 1 px). */
  .article__body :global(table) {
    width: 100%; border-collapse: separate; border-spacing: 0;
    background: var(--w-s2); border: 1px solid var(--w-line); border-radius: var(--w-r-obj);
    box-shadow: var(--w-edge); overflow: hidden;
    font-family: var(--font-body); font-size: 0.9375rem; line-height: 1.5;
    margin-top: 32px;
  }
  .article__body :global(th),
  .article__body :global(td) {
    padding: 14px 20px; text-align: left; vertical-align: top;
    border-bottom: 1px solid var(--w-line);
  }
  .article__body :global(th) {
    font-family: var(--font-display); font-weight: 500; font-size: 1.0625rem; letter-spacing: -0.01em;
    color: var(--w-ink); padding-top: 20px; padding-bottom: 16px;
    border-bottom-color: var(--w-line-strong);
  }
  .article__body :global(td) { color: var(--w-ink-80); }
  .article__body :global(td:first-child) { color: var(--w-ink); font-weight: 500; }
  .article__body :global(tbody tr:last-child td) { border-bottom: 0; }
  @media (--lt-md) {
    .article__body :global(p),
    .article__body :global(li) { font-size: 1.0625rem; }
    .article__body :global(h2) { font-size: 1.5rem; margin-top: 52px; }
    .article__body :global(h3) { font-size: 1.25rem; }
    .article__body :global(table) { font-size: 0.875rem; }
    .article__body :global(th),
    .article__body :global(td) { padding: 12px 14px; }
    .article__body :global(th) { font-size: 0.9375rem; }
  }

  @media (--motion-reduce) {
    .article__body :global(a) { transition: none; }
  }
</style>
