---
// Header editorial de una pieza de blog: eyebrow (kicker + badge) + H1 + lead +
// meta (fecha · lectura) + tags. Cabecera de revista premium sobre la atmósfera
// espacial de la página (la sección es transparente; solo aporta un glow local).
// Sin CTA: el CTA vive al final del artículo. El breadcrumb entra por slot.
//
// Marca de tema (DESIGN.md §8.5): el hero muestra la ilustración PROPIA del tema del
// post (BlogIllustration, inline-SVG line-art, aria-hidden) como acento lateral —
// misma ilustración que la tarjeta del índice, reusada aquí como firma visual. Es
// decorativa: nunca compite con el H1 (va en columna aparte en desktop; en móvil se
// apila arriba, contenida). Deriva el tema de topic/tags (aditivo, mismo criterio que
// el índice, que le pasa los tags del post).
import Kicker from '../ui/Kicker.astro';
import Icon from '../ui/Icon.astro';
import BlogIllustration from '../BlogIllustration.astro';

interface Props {
  kicker?: string;
  /** Pill secundario opcional junto al kicker (p.ej. categoría o etiqueta destacada). */
  badge?: string;
  title: string;
  lead?: string;
  /** Fecha en formato máquina YYYY-MM-DD (atributo datetime). */
  dateISO: string;
  /** Fecha legible, p.ej. "10 de junio de 2026". */
  dateLabel: string;
  /** Texto de tiempo de lectura ya formateado, p.ej. "6 min de lectura". */
  readingLabel?: string;
  tags?: string[];
  /** Tema explícito opcional para la ilustración de marca; si falta, se deriva de tags. */
  topic?: string;
}
const { kicker, badge, title, lead, dateISO, dateLabel, readingLabel, tags = [], topic } = Astro.props;
const hasMeta = Boolean(dateLabel || readingLabel);
---
<header class="p-hero">
  <div class="container p-hero__inner">
    <div class="p-hero__col">
      <slot name="breadcrumb" />

      {(kicker || badge) && (
        <div class="p-hero__eyebrow">
          {kicker && <Kicker>{kicker}</Kicker>}
          {badge && <span class="p-hero__badge">{badge}</span>}
        </div>
      )}

      <h1 class="display p-hero__title">{title}</h1>

      {lead && <p class="lead p-hero__lead">{lead}</p>}

      {hasMeta && (
        <div class="p-hero__rule" aria-hidden="true"><span class="p-hero__node"></span></div>
      )}

      {hasMeta && (
        <div class="p-hero__meta">
          {dateLabel && (
            <time datetime={dateISO}><Icon name="lucide:calendar" /> {dateLabel}</time>
          )}
          {readingLabel && <span><Icon name="lucide:clock" /> {readingLabel}</span>}
        </div>
      )}

      {tags.length > 0 && (
        <ul class="p-hero__tags" aria-label="Temas">
          {tags.map((t) => <li>{t}</li>)}
        </ul>
      )}
    </div>

    {/* Marca de tema: ilustración de la casa (decorativa, aria-hidden vive en el propio
        componente). Encuadrada en un marco line-art para leerse como firma, no como imagen suelta. */}
    <div class="p-hero__aside">
      <div class="p-hero__illo-frame">
        <BlogIllustration topic={topic} tags={tags} class="p-hero__illo" />
      </div>
    </div>
  </div>
</header>

<style>
  .p-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    /* La sección es TRANSPARENTE: la atmósfera de la página se ve detrás. */
    padding-block: calc(var(--nav-h) + var(--space-8)) var(--space-7);
  }
  /* Acento espacial local: glow de esquina (eco de la viñeta del hero de la home). */
  .p-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(70% 90% at 85% 0%, var(--accent-gold-glow), transparent 60%),
      radial-gradient(60% 80% at 0% 100%, color-mix(in srgb, var(--accent-teal), transparent 90%), transparent 55%);
  }

  .p-hero__inner {
    /* Móvil: una columna. La ilustración (aside) se coloca ARRIBA vía order,
       contenida, sin robarle protagonismo al H1 (que la sigue de inmediato). */
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    min-width: 0;
  }
  .p-hero__col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
    min-width: 0;
    /* Columna de lectura editorial, no centrada full-bleed. */
    max-width: 60rem;
    order: 2;
  }

  /* ── Marca de tema: ilustración de la casa, encuadre line-art ─────────── */
  .p-hero__aside {
    min-width: 0;
    order: 1;
    /* En móvil la firma es discreta: acotada y alineada al inicio. */
    width: 100%;
    max-width: 22rem;
  }
  .p-hero__illo-frame {
    position: relative;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(120% 120% at 100% 0%, var(--accent-gold-dim), transparent 62%),
      color-mix(in srgb, var(--bg-card) 62%, transparent);
    padding: var(--space-4);
    overflow: hidden;
  }
  /* Filete-marcador teal "en vivo" en la esquina (eco de la señal de dato). */
  .p-hero__illo-frame::before {
    content: "";
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: var(--space-4);
    width: clamp(28px, 20%, 56px);
    height: 2px;
    border-radius: var(--radius-pill);
    background: linear-gradient(90deg, var(--accent-teal-line), transparent);
  }
  .p-hero__illo { display: block; }

  /* ── Eyebrow: filete-marcador editorial oro + kicker + badge ─────────── */
  .p-hero__eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    position: relative;
    padding-inline-start: var(--space-4);
  }
  .p-hero__eyebrow::before {
    content: "";
    position: absolute;
    inset-block: 2px;
    inset-inline-start: 0;
    width: 2px;
    border-radius: var(--radius-pill);
    background: linear-gradient(var(--accent-gold), color-mix(in srgb, var(--accent-gold), transparent 70%));
  }

  .p-hero__badge {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    color: var(--accent-teal);
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--accent-teal), transparent 88%);
    border: 1px solid color-mix(in srgb, var(--accent-teal), transparent 70%);
  }

  /* ── Título: manda. Display fluido, tracking apretado. ───────────────── */
  .p-hero__title {
    max-width: 20ch;
    text-wrap: balance;
  }

  .p-hero__lead {
    max-width: 60ch;
    color: var(--fg-secondary);
  }

  /* ── Divisor "constelación": línea oro-line con un nodo ──────────────── */
  .p-hero__rule {
    position: relative;
    width: clamp(120px, 28vw, 200px);
    height: 1px;
    margin-block: calc(var(--space-2) * -1);
    background: linear-gradient(90deg, var(--accent-gold-line), transparent);
  }
  .p-hero__node {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 0;
    width: 4px;
    height: 4px;
    border-radius: var(--radius-pill);
    background: var(--accent-gold);
    transform: translateY(-50%);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent-gold), transparent 82%);
  }

  /* ── Meta: telemetría en mono, icono teal "señal" ───────────────────── */
  .p-hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--fg-secondary);
  }
  .p-hero__meta time,
  .p-hero__meta span {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
  }
  .p-hero__meta :global(svg) {
    width: 14px;
    height: 14px;
    color: var(--accent-teal);
    flex: 0 0 auto;
  }

  /* ── Tags: pills mono; afinidad de borde en hover (NO son enlaces) ───── */
  .p-hero__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
  }
  .p-hero__tags li {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--fg-secondary);
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    background: var(--bg-card);
    border: 1px solid var(--border);
    transition: border-color var(--duration-base) var(--ease-out-expo),
                color var(--duration-base) var(--ease-out-expo);
  }
  @media (--hover-fine) {
    .p-hero__tags li:hover {
      border-color: var(--border-accent);
      color: var(--fg-primary);
    }
  }

  @media (--md) {
    /* Desktop: composición asimétrica editorial — contenido a la izquierda (manda),
       la ilustración de tema como firma a la derecha, alineada al inicio del título. */
    .p-hero__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 15rem);
      gap: var(--space-8);
      align-items: start;
    }
    .p-hero__col { order: 0; gap: var(--space-6); }
    .p-hero__aside {
      order: 0;
      max-width: none;
      /* Baja la firma para alinearla con el título, no con el breadcrumb. */
      margin-block-start: var(--space-7);
    }
  }

  @media (--lg) {
    .p-hero__inner { grid-template-columns: minmax(0, 1fr) minmax(0, 17rem); }
  }

  @media (--motion-reduce) {
    .p-hero__tags li { transition: none; }
  }
</style>
