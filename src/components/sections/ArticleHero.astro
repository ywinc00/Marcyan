---
// Cabecera de artículo v3 (design/rediseno-workos.md §4.8; W-CONT-20).
// Columna de lectura de 680: migas · título H1 48/1.1 500 (el `title` del frontmatter
// VERBATIM) · bajada ~22 al 80 % · fila de firma y fecha (sin autor inventado: "Equipo
// Marcyan" + el tipo de guía) · filete de 1 px · fila "Pregúntale a tu IA" (slot `ia`,
// W-CONT-22) · portada ensanchada a 746 (sobresale 33 px por lado) con la ilustración
// PROPIA del tema (BlogIllustration, decorativa) sobre la luz de la página.
// Coreografía única (§2.9): migas y título en el paso 1, bajada en el 2, firma e IA en
// el 3, portada como objeto. Sin CTA: la conversión vive en el raíl y al final.
import BlogIllustration from '../BlogIllustration.astro';

interface Props {
  /** Tipo de guía (heroKicker del frontmatter), va en la fila de firma. */
  kicker?: string;
  title: string;
  lead?: string;
  /** Fecha en formato máquina YYYY-MM-DD (atributo datetime). */
  dateISO: string;
  /** Fecha legible, p.ej. "10 de junio de 2026". */
  dateLabel: string;
  /** Texto de tiempo de lectura ya formateado, p.ej. "6 min de lectura". */
  readingLabel?: string;
  tags?: string[];
  /** Tema explícito opcional para la ilustración; si falta, se deriva de tags. */
  topic?: string;
  class?: string;
}
const { kicker, title, lead, dateISO, dateLabel, readingLabel, tags = [], topic, class: cls } = Astro.props;
---
<header class:list={['ahero', cls]}>
  {Astro.slots.has('breadcrumb') && (
    <div class="ahero__crumbs" data-w-in="1"><slot name="breadcrumb" /></div>
  )}

  <h1 class="ahero__title" data-w-in="1">{title}</h1>

  {lead && <p class="ahero__lead" data-w-in="2">{lead}</p>}

  <div class="ahero__meta" data-w-in="3">
    <p class="ahero__by">
      <span class="ahero__mark" aria-hidden="true"></span>
      <span>Equipo Marcyan</span>
      {kicker && <span class="ahero__kind">{kicker}</span>}
    </p>
    <p class="ahero__when">
      <time datetime={dateISO}>{dateLabel}</time>
      {readingLabel && <span class="ahero__dot" aria-hidden="true"></span>}
      {readingLabel && <span>{readingLabel}</span>}
    </p>
  </div>

  {Astro.slots.has('ia') && (
    <div class="ahero__ia" data-w-in="3"><slot name="ia" /></div>
  )}

  <div class="ahero__cover" data-w-in="obj" aria-hidden="true">
    <div class="ahero__frame">
      <BlogIllustration topic={topic} tags={tags} class="ahero__illo" />
    </div>
  </div>
</header>

<style>
  .ahero { display: flex; flex-direction: column; min-width: 0; max-width: 680px; }

  .ahero__crumbs { margin-bottom: 28px; }
  .ahero__crumbs :global(ol) { padding-inline-start: 0; margin: 0; flex-wrap: nowrap; }
  /* La última miga repite el H1 entero: en una sola línea, recortada con puntos suspensivos
     (el título completo se lee justo debajo; el BreadcrumbList no cambia). */
  .ahero__crumbs :global(li:last-child) { flex: 1 1 auto; min-width: 0; }
  .ahero__crumbs :global([aria-current="page"]) {
    display: block; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    color: var(--w-ink-60);
  }

  /* Título: H1 48/1.1 500 (W-CONT-20 mide 48/52.8 y -2.16 px). Verbatim. */
  .ahero__title {
    margin: 0;
    font-family: var(--font-display); font-weight: 500;
    font-size: clamp(1.875rem, 1.2rem + 2.1vw, 3rem);
    line-height: 1.1; letter-spacing: -0.035em;
    color: var(--w-ink); text-wrap: balance;
  }
  .ahero__lead {
    margin: 20px 0 0;
    font-family: var(--font-body); font-weight: 400;
    font-size: clamp(1.125rem, 1rem + 0.45vw, 1.375rem); line-height: 1.42;
    color: var(--w-ink-80); text-wrap: pretty;
  }

  /* Firma y fecha: texto de lectura (14-15), nunca mono de adorno (E-40). */
  .ahero__meta {
    margin-top: 32px; padding-bottom: 20px;
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 24px;
    border-bottom: 1px solid var(--w-line);
    font-family: var(--font-body); font-size: 0.9375rem; line-height: 1.4; color: var(--w-ink-70);
  }
  .ahero__by, .ahero__when { margin: 0; display: inline-flex; align-items: center; flex-wrap: wrap; gap: 6px 10px; min-width: 0; }
  .ahero__by { color: var(--w-ink); font-weight: 500; }
  /* Marca de firma: el mismo cuadrado redondeado de los iconos-objeto, sin logo de nadie. */
  .ahero__mark {
    inline-size: 24px; block-size: 24px; border-radius: 7px; flex: none;
    background: linear-gradient(180deg, #232321, #141414);
    border: 1px solid rgba(var(--accent-gold-rgb), .45);
    box-shadow: var(--w-edge);
    position: relative;
  }
  .ahero__mark::after {
    content: ''; position: absolute; inset: 0; margin: auto;
    inline-size: 6px; block-size: 6px; border-radius: 50%; background: var(--accent-gold);
  }
  .ahero__kind {
    font-weight: 400; color: var(--w-ink-70);
    padding-left: 10px; border-left: 1px solid var(--w-line-strong);
  }
  .ahero__dot { inline-size: 3px; block-size: 3px; border-radius: 50%; background: var(--w-ink-30); }

  .ahero__ia { padding-block: 16px; border-bottom: 1px solid var(--w-line); }

  /* Portada ensanchada (746 = 680 + 33 por lado), radio 8, con la luz de la página:
     amanecer oro desde abajo + trama de puntos; la ilustración de la casa encima. */
  .ahero__cover { margin-top: 40px; }
  .ahero__frame {
    position: relative; overflow: hidden;
    aspect-ratio: 746 / 360;
    border-radius: var(--w-r-cell);
    border: 1px solid var(--w-line);
    background: var(--w-dawn), var(--w-s1);
    box-shadow: var(--w-edge);
    display: grid; place-items: center;
  }
  .ahero__frame::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: var(--w-dots);
    -webkit-mask-image: radial-gradient(70% 80% at 50% 60%, #000 30%, transparent 85%);
            mask-image: radial-gradient(70% 80% at 50% 60%, #000 30%, transparent 85%);
    opacity: .7;
  }
  .ahero__frame :global(.ahero__illo) { position: relative; width: min(64%, 440px); }
  @media (--lg) {
    .ahero__cover { margin-inline: -33px; }
  }
  @media (--lt-md) {
    .ahero__frame { aspect-ratio: 358 / 220; }
    .ahero__frame :global(.ahero__illo) { width: 82%; }
  }
</style>
