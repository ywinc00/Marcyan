---
// Raíl de lectura del blog. En desktop (--lg) el raíl fluye con la página SIN
// scroll interno: la ToC y las 2 tarjetas (conversión + herramientas) se ven
// completas, una debajo de otra. Al bajar, la ToC se desplaza normal y, cuando
// la primera tarjeta llega arriba, las 2 tarjetas se FIJAN (sticky) y quedan
// siempre visibles mientras se lee. En móvil solo aporta la ToC colapsable (las
// tarjetas se ocultan; la conversión móvil sigue siendo CtaBand/Contact).
import ArticleToc from './ArticleToc.astro';
import RailCta from './RailCta.astro';
import RailTools from './RailTools.astro';

interface Heading { depth: number; slug: string; text: string }
interface Props { headings: Heading[]; tocLabel: string; rail: any; postTitle: string }
const { headings, tocLabel, rail, postTitle } = Astro.props;
---
<div class="rail">
  <ArticleToc headings={headings} label={tocLabel} embedded />
  <div class="rail__cards">
    <RailCta t={rail.cta} postTitle={postTitle} />
    <RailTools t={rail.tools} />
  </div>
</div>

<style>
  .rail { display: flex; flex-direction: column; gap: var(--space-5); min-width: 0; }

  /* Móvil: solo la ToC (details). Las tarjetas viven en el raíl desktop. */
  .rail__cards { display: none; }

  @media (--lg) {
    /* El raíl ocupa todo el alto del aside (que se estira al alto del artículo)
       para que las tarjetas puedan fijarse a lo largo de toda la lectura. No hay
       scroll interno: la ToC y las tarjetas se ven completas. */
    .rail { height: 100%; }
    /* La ToC (arriba) se desplaza normal con la página. Las 2 tarjetas se fijan
       cuando la primera llega arriba y quedan siempre visibles. */
    .rail__cards {
      display: flex; flex-direction: column; gap: var(--space-4);
      position: sticky;
      top: calc(var(--nav-h) + var(--space-3));
    }
  }
</style>
