---
// Índice "En esta guía" v3 (design/rediseno-workos.md §4.8; W-CONT-21). Solo con ≥3 H2.
// Un solo bloque con tres presentaciones según ancho:
//   · ≥1280: columna de 200 desplegada, pegajosa a 32 px bajo la barra; la entrada
//     activa en tinta con barra oro (scroll-spy).
//   · 1024-1279: plegada en rayas oro de 18×1 cada 11 px (una por sección, la activa
//     más larga); se despliega en 250 ms con clic o toque (y con el ratón encima, solo
//     en punteros finos; nunca hover en táctil, E-40). Esc, clic fuera o elegir una
//     entrada la vuelven a plegar.
//   · <1024: botón "En esta guía" con las rayas, CERRADO al cargar (E-23); se despliega
//     debajo en 250 ms.
// Progresivo: sin JS el índice es una lista de anclas siempre visible (el script inline
// marca data-js antes del primer pintado, sin salto de maquetación).
// Solo transform y opacidad; con movimiento reducido el cambio es instantáneo.
interface Heading { depth: number; slug: string; text: string }
interface Props { headings: Heading[]; label: string; embedded?: boolean }
const { headings, label } = Astro.props as Props;
const items = headings.filter((h: Heading) => h.depth === 2);
---
{items.length >= 3 && (
  <nav class="toc" id="toc" aria-label={label} data-toc-spy>
    <div class="toc__in">
      <button class="toc__btn" type="button" aria-expanded="false" aria-controls="toc-panel" data-toc-btn>
        <span class="toc__ticks" aria-hidden="true">
          {items.map((h) => <span class="toc__tick" data-toc-tick={h.slug}></span>)}
        </span>
        <span class="toc__btnlabel">{label}</span>
        <span class="toc__chev" aria-hidden="true"></span>
      </button>
      <div class="toc__panel" id="toc-panel">
        <p class="toc__label">{label}</p>
        <ol class="toc__list">
          {items.map((h) => (
            <li class="toc__item">
              <a class="toc__link" href={`#${h.slug}`} data-toc-link={h.slug}>{h.text}</a>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </nav>
)}
{items.length >= 3 && <script is:inline>document.getElementById('toc').setAttribute('data-js', '')</script>}

<style>
  /* z-index: el panel desplegado (1024-1279) pinta ENCIMA del texto de la lectura. */
  .toc { min-width: 0; position: relative; z-index: 5; }

  /* ── Lista (común) ─────────────────────────────────────────────── */
  .toc__label {
    margin: 0 0 14px;
    font-family: var(--font-mono); font-size: var(--w-micro); font-weight: 500; line-height: 1.2;
    letter-spacing: var(--w-tr-micro); text-transform: uppercase; color: var(--w-ink-60);
  }
  .toc__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 4px; }
  .toc__item { min-width: 0; }
  .toc__link {
    position: relative; display: block;
    padding: 6px 0 6px 14px;
    font-family: var(--font-body); font-size: 0.875rem; line-height: 1.3;
    color: var(--w-ink-60); text-decoration: none; text-wrap: pretty;
    transition: color var(--w-dur-micro) var(--w-ease-ui);
  }
  .toc__link::before {
    content: ''; position: absolute; left: 0; top: 7px; bottom: 7px; width: 1px;
    background: var(--w-line-strong); transform-origin: 50% 0;
  }
  .toc__link[aria-current="true"] { color: var(--w-ink); }
  .toc__link[aria-current="true"]::before { width: 2px; background: var(--accent-gold); }
  @media (--hover-fine) { .toc__link:hover { color: var(--w-ink); } }
  .toc__link:focus-visible { outline: 2px solid var(--accent-gold); outline-offset: 2px; border-radius: 4px; color: var(--w-ink); }

  /* ── Botón (sin JS no existe) ──────────────────────────────────── */
  .toc__btn { display: none; }
  .toc[data-js] .toc__btn {
    display: flex; align-items: center; gap: 14px;
    width: 100%; min-height: 52px; padding: 12px 16px;
    background: var(--w-s1); border: 1px solid var(--w-line); border-radius: var(--w-r-obj);
    box-shadow: var(--w-edge); color: var(--w-ink); cursor: pointer; text-align: left;
    font: inherit;
  }
  .toc[data-js] .toc__btn:focus-visible { outline: 2px solid var(--accent-gold); outline-offset: 2px; }
  .toc__ticks { display: flex; flex-direction: column; gap: 4px; flex: none; }
  .toc__tick {
    display: block; inline-size: 18px; block-size: 1px;
    background: rgba(var(--accent-gold-rgb), .5); transform-origin: 0 50%;
    transition: transform var(--w-dur-hover) var(--w-ease-ui), background-color var(--w-dur-hover) var(--w-ease-ui);
  }
  .toc__tick.is-on { background: var(--accent-gold); transform: scaleX(1.45); }
  .toc__btnlabel {
    flex: 1; font-family: var(--font-mono); font-size: var(--w-micro); font-weight: 500;
    letter-spacing: var(--w-tr-micro); text-transform: uppercase; color: var(--w-ink-70);
  }
  .toc__chev {
    inline-size: 8px; block-size: 8px; flex: none; margin-right: 4px;
    border-right: 1.5px solid var(--accent-gold); border-bottom: 1.5px solid var(--accent-gold);
    transform: translateY(-2px) rotate(45deg);
    transition: transform var(--w-dur-hover) var(--w-ease-ui);
  }
  .toc[data-open] .toc__chev { transform: translateY(2px) rotate(-135deg); }

  /* ── Móvil y tableta (<1024): botón + panel debajo, cerrado al cargar ── */
  .toc[data-js] .toc__panel { display: none; }
  .toc[data-js][data-open] .toc__panel {
    display: block; margin-top: 8px; padding: 18px 16px 12px;
    background: var(--w-s1); border: 1px solid var(--w-line); border-radius: var(--w-r-obj);
    animation: toc-in 250ms var(--w-ease-ui) both;
  }
  .toc[data-js] .toc__panel .toc__label { display: none; }
  .toc[data-js] .toc__link { padding-block: 10px; font-size: 0.9375rem; }
  @keyframes toc-in { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }

  /* ── Escritorio (≥1024): columna pegajosa ───────────────────────── */
  @media (--lg) {
    .toc__in { position: sticky; top: calc(var(--nav-h) + 32px); }

    /* 1024-1279: plegado en rayas 18×1 cada 11 px (W-CONT-21-indice-plegado). */
    .toc[data-js] .toc__btn {
      width: 44px; min-height: 0; padding: 10px 13px 10px 3px; margin-left: -3px;
      background: none; border: 0; box-shadow: none; border-radius: 6px;
      transition: opacity var(--w-dur-hover) var(--w-ease-ui);
    }
    .toc__ticks { gap: 10px; }
    .toc[data-js] .toc__btnlabel {
      position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap;
    }
    .toc[data-js] .toc__chev { display: none; }
    .toc[data-js][data-open] .toc__btn { opacity: 0; }
    .toc[data-js][data-open] .toc__panel {
      position: absolute; top: -12px; left: -16px; z-index: 6; margin: 0;
      inline-size: 264px; max-height: calc(calc(100vh / var(--z, 1)) - var(--nav-h) - 48px); overflow-y: auto; overscroll-behavior: contain;
      padding: 18px 18px 14px;
      background: var(--w-s-solid); border: 1px solid var(--w-line-strong); border-radius: var(--w-r-obj);
      box-shadow: var(--w-edge), 0 18px 40px rgba(0, 0, 0, .45);
      animation-name: toc-unfold;
    }
    .toc[data-js] .toc__panel .toc__label { display: block; }
    .toc[data-js] .toc__link { padding-block: 6px; font-size: 0.875rem; }
    @keyframes toc-unfold { from { opacity: 0; transform: translateX(-8px); } to { opacity: 1; transform: none; } }
  }

  /* ≥1280: desplegado siempre, sin botón (W-CONT-21-indice-lateral). */
  @media (--xl) {
    .toc[data-js] .toc__btn { display: none; }
    .toc[data-js] .toc__panel,
    .toc[data-js][data-open] .toc__panel {
      display: block; position: static; inline-size: auto; max-height: calc(calc(100vh / var(--z, 1)) - var(--nav-h) - 64px); overflow-y: auto;
      padding: 0; background: none; border: 0; box-shadow: none; animation: none;
    }
  }

  @media (--motion-reduce) {
    .toc__link, .toc__tick, .toc__chev, .toc[data-js] .toc__btn { transition: none; }
    .toc[data-js][data-open] .toc__panel { animation: none; }
  }
</style>

<script>
  // Índice: plegar/desplegar (<1280) + scroll-spy (entrada activa y raya activa).
  // Busca solo dentro de su propio nodo (E-51).
  const toc = document.querySelector<HTMLElement>('nav.toc[data-toc-spy]');
  if (toc) {
    const btn = toc.querySelector<HTMLButtonElement>('[data-toc-btn]')!;
    const panel = toc.querySelector<HTMLElement>('.toc__panel')!;
    const wide = window.matchMedia('(min-width: 1280px)');
    const desk = window.matchMedia('(min-width: 1024px)');
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
    let hoverT = 0;

    const setOpen = (open: boolean, focusBtn = false) => {
      if (open) toc.setAttribute('data-open', ''); else toc.removeAttribute('data-open');
      btn.setAttribute('aria-expanded', String(open));
      if (!open && focusBtn) btn.focus();
    };
    btn.addEventListener('click', () => {
      const open = !toc.hasAttribute('data-open');
      setOpen(open);
      if (open && desk.matches) panel.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
    });
    toc.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toc.hasAttribute('data-open') && !wide.matches) { e.preventDefault(); setOpen(false, true); }
    });
    // Elegir una entrada pliega el índice (salvo ≥1280, donde siempre está abierto).
    panel.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a') && !wide.matches) setOpen(false);
    });
    document.addEventListener('click', (e) => {
      if (toc.hasAttribute('data-open') && desk.matches && !wide.matches && !toc.contains(e.target as Node)) setOpen(false);
    });
    toc.addEventListener('focusout', (e) => {
      if (desk.matches && !wide.matches && !toc.contains(e.relatedTarget as Node | null) && e.relatedTarget) setOpen(false);
    });
    // Ratón encima: solo puntero fino y 1024-1279 (intención: 120 ms para abrir, 200 para cerrar).
    toc.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse' || !fine.matches || !desk.matches || wide.matches) return;
      clearTimeout(hoverT); hoverT = window.setTimeout(() => setOpen(true), 120);
    });
    toc.addEventListener('pointerleave', (e) => {
      if (e.pointerType !== 'mouse' || !fine.matches || !desk.matches || wide.matches) return;
      clearTimeout(hoverT); hoverT = window.setTimeout(() => setOpen(false), 200);
    });
    const reset = () => setOpen(false);
    wide.addEventListener?.('change', reset);
    desk.addEventListener?.('change', reset);

    // Scroll-spy: la entrada activa es el último H2 que ya cruzó el 30 % alto de la ventana.
    // Con el desplazamiento (pasivo, una lectura por fotograma) y no con IntersectionObserver:
    // un salto largo (ancla, barra, Inicio/Fin) cruzaba un H2 sin "entrar" en la banda y el
    // índice se quedaba sin activa.
    const links = Array.from(toc.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
    const ticks = new Map(Array.from(toc.querySelectorAll<HTMLElement>('[data-toc-tick]')).map((t) => [t.dataset.tocTick!, t]));
    const targets = links.map((a) => document.getElementById(a.dataset.tocLink!)).filter((el): el is HTMLElement => !!el);
    let current = '';
    let raf = 0;
    const setCurrent = (slug: string) => {
      if (slug === current) return;
      current = slug;
      for (const a of links) {
        if (a.dataset.tocLink === slug) a.setAttribute('aria-current', 'true'); else a.removeAttribute('aria-current');
      }
      for (const [s, t] of ticks) t.classList.toggle('is-on', s === slug);
    };
    const spy = () => {
      raf = 0;
      const line = window.innerHeight * 0.3;
      let slug = '';
      for (const t of targets) { if (t.getBoundingClientRect().top <= line) slug = t.id; else break; }
      setCurrent(slug);
    };
    const onScroll = () => { if (!raf) raf = requestAnimationFrame(spy); };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    spy();
  }
</script>
