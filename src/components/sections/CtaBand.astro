---
// Banda de CTA final con GRAVEDAD. Panel centrado sobre la atmósfera:
//  · glow de acento más rico (eco de la viñeta del hero) + filete superior,
//  · motivo espacial line-art inline (órbita + satélite + estrellas tenues, aria-hidden),
//  · jerarquía dura: 1 acción PRIMARIA dominante (oro/teal sólido) + secundaria como
//    enlace mono discreto (no 2 CTAs gemelos).
// Contrato de props INTACTO: title(set:html), sub, primary, secondary, tone.
import Button from '../ui/Button.astro';

interface Props {
  title: string;
  sub?: string;
  primary: { label: string; href: string };
  secondary?: { label: string; href: string };
  tone?: 'gold' | 'teal';
}
const { title, sub, primary, secondary, tone = 'gold' } = Astro.props;
const uid = 'cta' + Math.random().toString(36).slice(2, 7);
---
<section class:list={['section ctaband', `ctaband--${tone}`]}>
  <div class="container">
    <div class="ctaband__inner">
      <!-- motivo espacial: órbita + satélite + estrellas (decorativo) -->
      <svg class="ctaband__motif" viewBox="0 0 600 240" aria-hidden="true" focusable="false" preserveAspectRatio="xMidYMid slice">
        <defs>
          <radialGradient id={`${uid}-h`} cx="50%" cy="0%" r="75%">
            <stop offset="0%" stop-color="var(--tint)" stop-opacity="0.20" />
            <stop offset="100%" stop-color="var(--tint)" stop-opacity="0" />
          </radialGradient>
        </defs>
        <rect x="0" y="0" width="600" height="240" fill={`url(#${uid}-h)`} />
        <g class="ctaband__stars">
          <circle cx="78"  cy="44"  r="1.1" />
          <circle cx="156" cy="88"  r="0.9" />
          <circle cx="240" cy="34"  r="1.3" />
          <circle cx="372" cy="60"  r="0.9" />
          <circle cx="468" cy="40"  r="1.1" />
          <circle cx="528" cy="92"  r="1.2" />
          <circle cx="44"  cy="128" r="0.8" />
          <circle cx="556" cy="150" r="0.9" />
        </g>
        <!-- arco de órbita inclinado, recortado por el viewBox (horizonte) -->
        <ellipse class="ctaband__orbit" cx="300" cy="250" rx="318" ry="118"
          transform="rotate(-9 300 250)" />
        <!-- satélite de IA recorriendo la órbita -->
        <g class="ctaband__sat" aria-hidden="true">
          <circle r="4.5" />
        </g>
      </svg>

      <h2 class="h2 ctaband__title" set:html={title} />
      {sub && <p class="lead ctaband__sub">{sub}</p>}

      <div class="ctaband__cta">
        <Button href={primary.href} variant={tone === 'teal' ? 'teal' : 'primary'} size="lg">{primary.label}</Button>
        {secondary && (
          <a class="ctaband__alt" href={secondary.href}>
            <span>{secondary.label}</span>
            <svg class="ctaband__arrow" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
              <path d="M3 8h9M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .ctaband--gold { --tint: var(--accent-gold); --glow: var(--accent-gold-glow); --line: var(--accent-gold-line); }
  .ctaband--teal { --tint: var(--accent-teal); --glow: color-mix(in srgb, var(--accent-teal), transparent 74%); --line: var(--accent-teal-line); }

  /* acento del titular inyectado por set:html (scope acotado) */
  .ctaband__title :global(em) { color: var(--tint); font-style: normal; }

  .ctaband__inner {
    position: relative; isolation: isolate; overflow: hidden;
    display: flex; flex-direction: column; align-items: center; text-align: center;
    gap: var(--space-4);
    padding: var(--space-9) var(--space-6) var(--space-8);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(120% 150% at 50% 0%, color-mix(in srgb, var(--tint), transparent 94%), transparent 55%),
      var(--bg-card);
    border: 1px solid var(--border);
  }
  /* filete superior de acento (señal de "remate") */
  .ctaband__inner::before {
    content: ""; position: absolute; inset-inline: 0; top: 0; height: 1px; pointer-events: none;
    background: linear-gradient(90deg, transparent, var(--tint), transparent);
    opacity: 0.7;
  }
  /* glow más rico — eco de la viñeta del hero, anclado arriba */
  .ctaband__inner::after {
    content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background:
      radial-gradient(70% 90% at 50% -8%, var(--glow), transparent 62%),
      radial-gradient(140% 80% at 50% 130%, rgba(0, 0, 0, 0.5), transparent 60%);
  }

  /* motivo espacial line-art */
  .ctaband__motif {
    position: absolute; inset-inline: 0; top: 0; z-index: -1;
    width: 100%; height: 62%; min-height: 0;
    pointer-events: none; opacity: 0.85;
    -webkit-mask-image: linear-gradient(180deg, #000 30%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 30%, transparent 100%);
  }
  .ctaband__stars circle { fill: var(--fg-primary); opacity: 0.28; }
  .ctaband__orbit { fill: none; stroke: var(--line); stroke-width: 1; }
  .ctaband__sat circle { fill: var(--accent-teal); }
  .ctaband--gold .ctaband__sat circle { fill: var(--accent-gold); }
  /* el satélite recorre el arco visible de la órbita (sólo decorativo) */
  .ctaband__sat {
    offset-path: path("M 0 145 A 318 118 -9 0 1 600 95");
    offset-rotate: 0deg;
    transform: translateX(-300px);
    animation: cta-orbit 22s linear infinite;
  }
  @keyframes cta-orbit {
    from { offset-distance: 0%; }
    to   { offset-distance: 100%; }
  }
  /* fallback si no hay soporte de offset-path: oculta el satélite (la órbita ya da el motivo) */
  @supports not (offset-path: path("M0 0")) { .ctaband__sat { display: none; } }
  .ctaband__stars circle:nth-child(2n) { animation: cta-twinkle 4s ease-in-out infinite; }
  .ctaband__stars circle:nth-child(3n) { animation: cta-twinkle 5.5s ease-in-out 1s infinite; }
  @keyframes cta-twinkle { 0%, 100% { opacity: 0.16; } 50% { opacity: 0.42; } }

  .ctaband__title { max-width: 22ch; }
  .ctaband__sub { max-width: 54ch; color: var(--fg-secondary); margin-top: var(--space-1); }

  /* jerarquía: primaria sólida domina; secundaria = enlace mono discreto */
  .ctaband__cta {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: center;
    gap: var(--space-3) var(--space-6); margin-top: var(--space-5); min-width: 0;
  }
  .ctaband__alt {
    display: inline-flex; align-items: center; gap: var(--space-2);
    min-height: var(--tap-min); padding-inline: var(--space-2);
    font-family: var(--font-mono); font-size: var(--text-sm); letter-spacing: var(--tracking-wide);
    color: var(--fg-secondary); text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out-expo);
  }
  .ctaband__arrow { width: 15px; height: 15px; flex: 0 0 auto; transition: transform var(--duration-base) var(--ease-out-expo); }
  .ctaband__alt:hover { color: var(--tint); }
  .ctaband__alt:hover .ctaband__arrow,
  .ctaband__alt:focus-visible .ctaband__arrow { transform: translateX(3px); }

  @media (--md) {
    .ctaband__inner { padding: var(--space-10) var(--space-8) var(--space-9); }
    .ctaband__title { max-width: none; }
  }

  @media (--motion-reduce) {
    .ctaband__sat,
    .ctaband__stars circle { animation: none; }
    .ctaband__arrow { transition: none; }
  }
</style>
