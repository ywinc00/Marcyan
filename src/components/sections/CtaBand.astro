---
// Banda de CTA final con GRAVEDAD. Panel centrado sobre la atmósfera:
//  · glow de acento (eco de la viñeta del hero) + filete superior de "remate".
//  · SIN decoración de arco/constelación (retiradas a pedido del dueño): limpio.
//  · CONVERSIÓN = 3 canales reales, NUNCA el brief (/formulario). El brief es para
//    un cliente que YA quiere el servicio y nos da datos de su negocio, no para captar.
//      - Formulario de contacto (#contacto, la sección de abajo)
//      - WhatsApp (wa.me del número de la ciudad)
//      - Llamar (tel: del número de la ciudad)
//    Prioridad por dispositivo (dictado del dueño):
//      · Móvil  → LLAMAR domina, luego WhatsApp, luego formulario.
//      · PC/desktop → FORMULARIO domina, luego WhatsApp, luego llamar.
// Contrato de props: title(set:html), sub, primary(=acción de formulario), tone,
// + `city` (opcional, 'houston' por defecto) para el número. `secondary` se mantiene
// en la interfaz por compatibilidad con las páginas, pero YA NO se renderiza (era el
// enlace al brief que el dueño pidió eliminar como método de captación).
import Icon from '../ui/Icon.astro';
import { nap } from '../../i18n/content';
import { t, type Lang } from '../../i18n/ui';

interface Props {
  title: string;
  sub?: string;
  primary: { label: string; href: string };
  secondary?: { label: string; href: string };
  tone?: 'gold' | 'teal';
  city?: 'houston' | 'miami';
  lang?: Lang;
}
const { title, sub, primary, tone = 'gold', city = 'houston', lang = 'es' } = Astro.props;
const uic = t(lang);

// Número por ciudad (Houston por defecto = sede/línea principal).
const tel = nap[city];
const telHref = 'tel:' + tel.replace(/[^\d+]/g, '');
const waHref = 'https://wa.me/' + tel.replace(/\D/g, '');
// El formulario de contacto vive al final de la propia página (#contacto). Se respeta
// el href de `primary` si la página lo define; si no, ancla a la sección de contacto.
const formHref = primary.href || '#contacto';
---
<section class:list={['section ctaband', `ctaband--${tone}`]}>
  <div class="container">
    <div class="ctaband__inner">
      <h2 class="h2 ctaband__title" set:html={title} />
      {sub && <p class="lead ctaband__sub">{sub}</p>}

      {/* Trío de conversión. El orden/énfasis se invierte por dispositivo vía CSS:
          móvil = Llamar dominante · desktop = Formulario dominante. */}
      <div class="ctaband__actions">
        <a class="ctaband__act ctaband__act--form" href={formHref}>
          <Icon name="lucide:arrow-right" />
          <span>{primary.label}</span>
        </a>
        <a class="ctaband__act ctaband__act--wa" href={waHref} data-track="whatsapp_clicked">
          <Icon name="lucide:message-circle" />
          <span>WhatsApp</span>
        </a>
        <a class="ctaband__act ctaband__act--call" href={telHref} data-track="call_clicked">
          <Icon name="lucide:phone" />
          <span>{uic.cta.call}</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .ctaband--gold { --tint: var(--accent-gold); --glow: var(--accent-gold-glow); }
  .ctaband--teal { --tint: var(--accent-teal); --glow: color-mix(in srgb, var(--accent-teal), transparent 74%); }

  /* acento del titular inyectado por set:html (scope acotado) */
  .ctaband__title :global(em) { color: var(--tint); font-style: normal; }

  .ctaband__inner {
    position: relative; isolation: isolate; overflow: hidden;
    display: flex; flex-direction: column; align-items: center; text-align: center;
    gap: var(--space-4);
    padding: var(--space-9) var(--space-6) var(--space-8);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(120% 150% at 50% 0%, color-mix(in srgb, var(--tint), transparent 94%), transparent 55%),
      var(--bg-card);
    border: 1px solid var(--border);
  }
  /* filete superior de acento (señal de "remate") */
  .ctaband__inner::before {
    content: ""; position: absolute; inset-inline: 0; top: 0; height: 1px; pointer-events: none;
    background: linear-gradient(90deg, transparent, var(--tint), transparent);
    opacity: 0.7;
  }
  /* glow — eco de la viñeta del hero, anclado arriba + profundidad inferior */
  .ctaband__inner::after {
    content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background:
      radial-gradient(70% 90% at 50% -8%, var(--glow), transparent 62%),
      radial-gradient(140% 80% at 50% 130%, rgba(0, 0, 0, 0.5), transparent 60%);
  }

  .ctaband__title { max-width: 22ch; }
  .ctaband__sub { max-width: 54ch; color: var(--fg-secondary); margin-top: var(--space-1); }

  /* ── Trío de conversión ──────────────────────────────────────────────
     Móvil: apilado full-width, LLAMAR dominante (sólido). Desktop: fila,
     FORMULARIO dominante. WhatsApp siempre en medio, contorno. */
  .ctaband__actions {
    display: flex; flex-direction: column; align-items: stretch; gap: var(--space-3);
    width: 100%; max-width: 22rem; margin: var(--space-6) auto 0; min-width: 0;
  }
  .ctaband__act {
    display: inline-flex; align-items: center; justify-content: center; gap: var(--space-2);
    min-height: var(--tap-min); padding: 13px 24px; border-radius: var(--radius-md);
    font-family: var(--font-body); font-weight: 600; font-size: var(--text-base);
    text-decoration: none; white-space: nowrap; min-width: 0;
    background: transparent; color: var(--fg-primary); border: 1px solid var(--border-accent);
    transition: background var(--duration-fast) var(--ease-out-expo),
                border-color var(--duration-fast) var(--ease-out-expo),
                color var(--duration-fast), box-shadow var(--duration-base), transform var(--duration-fast);
  }
  .ctaband__act :global(svg) { width: 18px; height: 18px; flex: 0 0 auto; stroke-width: 1.5; }
  .ctaband__act:hover { border-color: var(--tint); color: var(--tint); }
  .ctaband__act:focus-visible { outline: 2px solid var(--tint); outline-offset: 2px; }
  .ctaband__act:active { transform: scale(0.98); }

  /* ── MÓVIL: LLAMAR domina (sólido). Orden: llamar · WhatsApp · formulario ── */
  .ctaband__act--call {
    order: 1; background: var(--tint); color: var(--fg-inverse); border-color: var(--tint);
  }
  .ctaband__act--call:hover {
    background: color-mix(in srgb, var(--tint), white 10%); color: var(--fg-inverse);
    border-color: var(--tint); box-shadow: 0 8px 30px -12px var(--glow);
  }
  .ctaband__act--wa { order: 2; }
  .ctaband__act--form { order: 3; }

  /* ── DESKTOP: FORMULARIO domina (sólido); LLAMAR vuelve a contorno.
     Fila centrada. Orden: formulario · WhatsApp · llamar ── */
  @media (--md) {
    .ctaband__actions {
      flex-direction: row; flex-wrap: wrap; justify-content: center;
      align-items: center; max-width: none;
    }
    .ctaband__act { width: auto; }

    .ctaband__act--call {
      order: 3; background: transparent; color: var(--fg-primary); border-color: var(--border-accent);
    }
    .ctaband__act--call:hover {
      background: transparent; color: var(--tint); border-color: var(--tint); box-shadow: none;
    }
    .ctaband__act--wa { order: 2; }
    .ctaband__act--form {
      order: 1; background: var(--tint); color: var(--fg-inverse); border-color: var(--tint);
    }
    .ctaband__act--form:hover {
      background: color-mix(in srgb, var(--tint), white 10%); color: var(--fg-inverse);
      border-color: var(--tint); box-shadow: 0 8px 30px -12px var(--glow);
    }
  }

  @media (--md) {
    .ctaband__inner { padding: var(--space-10) var(--space-8) var(--space-9); }
    .ctaband__title { max-width: none; }
  }

  @media (--motion-reduce) {
    .ctaband__act { transition: color var(--duration-fast), border-color var(--duration-fast); }
    .ctaband__act:active { transform: none; }
  }
</style>
