---
// Banda de CTA final con GRAVEDAD. Panel centrado sobre la atmósfera:
//  · glow de acento más rico (eco de la viñeta del hero) + filete superior,
//  · motivo espacial en ESPACIO NEGATIVO: arco de horizonte anclado al borde INFERIOR
//    (bajo el CTA) + constelación pequeña en la esquina superior — NUNCA detrás del título;
//    animación mínima y estable (leve parpadeo de estrellas), sin satélites que tartamudeen.
//  · jerarquía dura: 1 acción PRIMARIA dominante (oro/teal sólido) + secundaria como
//    enlace mono discreto (no 2 CTAs gemelos).
// Contrato de props INTACTO: title(set:html), sub, primary, secondary, tone.
import Button from '../ui/Button.astro';

interface Props {
  title: string;
  sub?: string;
  primary: { label: string; href: string };
  secondary?: { label: string; href: string };
  tone?: 'gold' | 'teal';
}
const { title, sub, primary, secondary, tone = 'gold' } = Astro.props;
const uid = 'cta' + Math.random().toString(36).slice(2, 7);
---
<section class:list={['section ctaband', `ctaband--${tone}`]}>
  <div class="container">
    <div class="ctaband__inner">
      <!-- constelación pequeña en esquina superior (espacio negativo, lejos del título) -->
      <svg class="ctaband__constellation" viewBox="0 0 120 80" aria-hidden="true" focusable="false" preserveAspectRatio="xMidYMid meet">
        <g class="ctaband__lines">
          <path d="M18 24 L52 14 L86 40 L104 22" />
          <path d="M52 14 L60 52" />
        </g>
        <g class="ctaband__stars">
          <circle cx="18"  cy="24" r="1.4" />
          <circle cx="52"  cy="14" r="1.8" />
          <circle cx="86"  cy="40" r="1.4" />
          <circle cx="104" cy="22" r="1.2" />
          <circle cx="60"  cy="52" r="1.1" />
        </g>
      </svg>

      <!-- arco de horizonte anclado al borde INFERIOR, bajo el CTA (no cruza el texto) -->
      <svg class="ctaband__horizon" viewBox="0 0 600 120" aria-hidden="true" focusable="false" preserveAspectRatio="xMidYMax slice">
        <defs>
          <linearGradient id={`${uid}-arc`} x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%"   stop-color="var(--tint)" stop-opacity="0" />
            <stop offset="50%"  stop-color="var(--tint)" stop-opacity="0.85" />
            <stop offset="100%" stop-color="var(--tint)" stop-opacity="0" />
          </linearGradient>
        </defs>
        <!-- curva del horizonte: cúpula centrada, borde inferior del panel -->
        <path class="ctaband__arc" d="M -40 150 Q 300 8 640 150"
          fill="none" stroke={`url(#${uid}-arc)`} />
        <!-- satélite ESTÁTICO posado sobre la curva (sin animación de recorrido) -->
        <circle class="ctaband__dot" cx="300" cy="20" r="3.5" />
      </svg>

      <h2 class="h2 ctaband__title" set:html={title} />
      {sub && <p class="lead ctaband__sub">{sub}</p>}

      <div class="ctaband__cta">
        <Button href={primary.href} variant={tone === 'teal' ? 'teal' : 'primary'} size="lg">{primary.label}</Button>
        {secondary && (
          <a class="ctaband__alt" href={secondary.href}>
            <span>{secondary.label}</span>
            <svg class="ctaband__arrow" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
              <path d="M3 8h9M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .ctaband--gold { --tint: var(--accent-gold); --glow: var(--accent-gold-glow); --line: var(--accent-gold-line); }
  .ctaband--teal { --tint: var(--accent-teal); --glow: color-mix(in srgb, var(--accent-teal), transparent 74%); --line: var(--accent-teal-line); }

  /* acento del titular inyectado por set:html (scope acotado) */
  .ctaband__title :global(em) { color: var(--tint); font-style: normal; }

  .ctaband__inner {
    position: relative; isolation: isolate; overflow: hidden;
    display: flex; flex-direction: column; align-items: center; text-align: center;
    gap: var(--space-4);
    padding: var(--space-9) var(--space-6) var(--space-8);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(120% 150% at 50% 0%, color-mix(in srgb, var(--tint), transparent 94%), transparent 55%),
      var(--bg-card);
    border: 1px solid var(--border);
  }
  /* filete superior de acento (señal de "remate") */
  .ctaband__inner::before {
    content: ""; position: absolute; inset-inline: 0; top: 0; height: 1px; pointer-events: none;
    background: linear-gradient(90deg, transparent, var(--tint), transparent);
    opacity: 0.7;
  }
  /* glow más rico — eco de la viñeta del hero, anclado arriba */
  .ctaband__inner::after {
    content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background:
      radial-gradient(70% 90% at 50% -8%, var(--glow), transparent 62%),
      radial-gradient(140% 80% at 50% 130%, rgba(0, 0, 0, 0.5), transparent 60%);
  }

  /* ── motivo espacial line-art (ESPACIO NEGATIVO — nunca detrás del título) ── */

  /* constelación: esquina superior, discreta, fuera del ancho del texto */
  .ctaband__constellation {
    position: absolute; top: var(--space-5); z-index: -1;
    inset-inline-end: var(--space-5); inset-inline-start: auto;
    width: clamp(96px, 22%, 140px); height: auto; min-width: 0;
    pointer-events: none; opacity: 0.6;
  }
  .ctaband__lines path { fill: none; stroke: var(--line); stroke-width: 1; }
  .ctaband__stars circle { fill: var(--fg-primary); opacity: 0.35; }
  /* la estrella "ancla" toma el color de acento */
  .ctaband__stars circle:nth-child(2) { fill: var(--tint); opacity: 0.9; }

  /* horizonte: arco anclado al borde INFERIOR del panel (debajo del CTA) */
  .ctaband__horizon {
    position: absolute; inset-inline: 0; bottom: 0; z-index: -1;
    width: 100%; height: clamp(56px, 22%, 100px); min-height: 0;
    pointer-events: none;
  }
  .ctaband__arc { stroke-width: 1.25; }
  .ctaband__dot { fill: var(--tint); opacity: 0.85; }

  /* parpadeo mínimo y estable de un par de estrellas (sin recorridos ni saltos) */
  .ctaband__stars circle:nth-child(3) { animation: cta-twinkle 5s ease-in-out infinite; }
  .ctaband__stars circle:nth-child(5) { animation: cta-twinkle 6.5s ease-in-out 1.2s infinite; }
  @keyframes cta-twinkle { 0%, 100% { opacity: 0.2; } 50% { opacity: 0.5; } }

  .ctaband__title { max-width: 22ch; }
  .ctaband__sub { max-width: 54ch; color: var(--fg-secondary); margin-top: var(--space-1); }

  /* jerarquía: primaria sólida domina; secundaria = enlace mono discreto */
  .ctaband__cta {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: center;
    gap: var(--space-3) var(--space-6); margin-top: var(--space-5); min-width: 0;
  }
  .ctaband__alt {
    display: inline-flex; align-items: center; gap: var(--space-2);
    min-height: var(--tap-min); padding-inline: var(--space-2);
    font-family: var(--font-mono); font-size: var(--text-sm); letter-spacing: var(--tracking-wide);
    color: var(--fg-secondary); text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out-expo);
  }
  .ctaband__arrow { width: 15px; height: 15px; flex: 0 0 auto; transition: transform var(--duration-base) var(--ease-out-expo); }
  .ctaband__alt:hover { color: var(--tint); }
  .ctaband__alt:hover .ctaband__arrow,
  .ctaband__alt:focus-visible .ctaband__arrow { transform: translateX(3px); }

  @media (--md) {
    .ctaband__inner { padding: var(--space-10) var(--space-8) var(--space-9); }
    .ctaband__title { max-width: none; }
  }

  @media (--motion-reduce) {
    .ctaband__stars circle { animation: none; }
    .ctaband__arrow { transition: none; }
  }
</style>
