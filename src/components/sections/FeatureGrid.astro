---
// "Manifiesto técnico" — antes era el 3-card icono+título+párrafo (cliché SaaS, DESIGN.md §3).
// Ahora: UN panel-documento. Header (kicker + H2 + intro) y una LISTA NUMERADA de capacidades
// (numeral mono · icono-chip · título · desc) unidas por un filete-riel continuo. Se lee como
// una hoja de especificaciones escaneable de arriba abajo, no como cajas gemelas flotando.
// En --lg el header queda pegado a la izquierda y la lista a la derecha (asimétrico, como la home).
// Sección transparente: la atmósfera (SpaceBackdrop) se ve detrás. tone: gold | teal.
import Icon from '../ui/Icon.astro';
import Kicker from '../ui/Kicker.astro';

interface Item { icon: string; title: string; desc: string }
interface Props {
  tag: string;
  title: string;
  intro?: string;
  items: Item[];
  tone?: 'gold' | 'teal';
}
const { tag, title, intro, items, tone = 'gold' } = Astro.props;
---
<section class:list={['section fgrid', `fgrid--${tone}`]}>
  <div class="container fgrid__inner">
    <header class="fgrid__head">
      <Kicker tone={tone}>{tag}</Kicker>
      <h2 class="h2" set:html={title} />
      {intro && <p class="lead fgrid__intro">{intro}</p>}
      <span class="fgrid__count" aria-hidden="true">{String(items.length).padStart(2, '0')} <span>capacidades</span></span>
    </header>

    <ol class="fgrid__list" role="list">
      {items.map((it, i) => (
        <li class="fgrow">
          <span class="fgrow__rail" aria-hidden="true"><span class="fgrow__node"></span></span>
          <span class="fgrow__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <span class="fgrow__ic"><Icon name={it.icon} /></span>
          <span class="fgrow__tx">
            <span class="fgrow__title">{it.title}</span>
            <span class="fgrow__desc">{it.desc}</span>
          </span>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  /* set:html del <em> inyectado en el título → :global() acotado bajo el scope. */
  .fgrid :global(.h2 em) { font-style: normal; }
  .fgrid--gold :global(.h2 em) { color: var(--accent-gold); }
  .fgrid--teal :global(.h2 em) { color: var(--accent-teal); }

  .fgrid--gold { --tint: var(--accent-gold); --tint-dim: var(--accent-gold-dim); --tint-line: var(--accent-gold-line); }
  .fgrid--teal { --tint: var(--accent-teal); --tint-dim: var(--accent-teal-dim); --tint-line: var(--accent-teal-line); }

  .fgrid__inner { display: grid; grid-template-columns: 1fr; gap: var(--space-6); align-items: start; }

  /* ── Header (columna izquierda en desktop) ─────────────────── */
  .fgrid__head { display: flex; flex-direction: column; gap: var(--space-4); min-width: 0; max-width: 60ch; }
  .fgrid__intro { color: var(--fg-secondary); }
  .fgrid__count {
    display: inline-flex; align-items: baseline; gap: var(--space-2);
    font-family: var(--font-mono); font-size: var(--text-lg); font-weight: 600;
    color: var(--tint); letter-spacing: var(--tracking-tight); margin-top: var(--space-1);
  }
  .fgrid__count span {
    font-size: var(--text-xs); font-weight: 500; letter-spacing: var(--tracking-wide);
    text-transform: uppercase; color: var(--fg-subtle);
  }

  /* ── Lista-manifiesto (columna derecha en desktop) ─────────── */
  .fgrid__list { list-style: none; display: flex; flex-direction: column; min-width: 0; }

  .fgrow {
    position: relative; display: grid;
    grid-template-columns: auto auto 44px 1fr;
    align-items: start; column-gap: var(--space-4);
    padding: var(--space-5) 0;
    border-top: 1px solid var(--border-subtle);
  }
  .fgrow:first-child { border-top: 0; }

  /* Riel-filete continuo: el segmento vive en cada fila y se une visualmente con el vecino.
     El nodo marca el inicio de la fila. Decorativo. */
  .fgrow__rail {
    grid-column: 1; align-self: stretch; position: relative;
    width: 1px; background: var(--tint-line); margin-top: 2px; min-height: 100%;
  }
  .fgrow:first-child .fgrow__rail { top: 0; }
  .fgrow__node {
    position: absolute; top: 0; left: 50%; transform: translateX(-50%);
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--bg-base); border: 1px solid var(--tint-line);
    transition: background var(--duration-base) var(--ease-out-expo),
                border-color var(--duration-base) var(--ease-out-expo),
                box-shadow var(--duration-base) var(--ease-out-expo);
  }

  .fgrow__num {
    grid-column: 2; font-family: var(--font-mono); font-size: var(--text-xs);
    font-weight: 600; color: var(--tint); letter-spacing: var(--tracking-wide);
    line-height: 1.7; padding-top: 2px; opacity: 0.85;
    transition: opacity var(--duration-base) var(--ease-out-expo);
  }

  .fgrow__ic {
    grid-column: 3; display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; border-radius: var(--radius-md);
    background: var(--tint-dim); border: 1px solid var(--tint-line); color: var(--tint);
    transition: box-shadow var(--duration-base) var(--ease-out-expo);
  }
  .fgrow__ic :global(svg) { width: 20px; height: 20px; stroke-width: 1.5; }

  .fgrow__tx { grid-column: 4; display: flex; flex-direction: column; gap: var(--space-1); min-width: 0; padding-top: 2px; }
  .fgrow__title { font-family: var(--font-display); font-size: var(--text-md); font-weight: 600; line-height: var(--leading-snug); }
  .fgrow__desc { color: var(--fg-secondary); font-size: var(--text-sm); line-height: var(--leading-normal); }

  /* Realce al pasar el ratón (solo punteros finos; nunca dispara en táctil). */
  @media (--hover-fine) {
    .fgrow { transition: none; }
    .fgrow:hover .fgrow__node { background: var(--tint); border-color: var(--tint); box-shadow: 0 0 10px var(--tint-line); }
    .fgrow:hover .fgrow__num { opacity: 1; }
    .fgrow:hover .fgrow__ic { box-shadow: 0 0 0 1px var(--tint-line), 0 0 18px var(--tint-line); }
  }

  /* En pantallas estrechas el numeral se apoya sobre el chip para no robar ancho al texto. */
  @media (--lt-sm) {
    .fgrow { grid-template-columns: auto 44px 1fr; column-gap: var(--space-3); }
    /* El numeral pasa a una fila propia (row 1); el riel debe abarcar AMBAS filas
       para no cortarse bajo el numeral y mantener el filete continuo. */
    .fgrow__rail { grid-column: 1; grid-row: 1 / 3; }
    .fgrow__num { grid-column: 2 / 4; grid-row: 1; align-self: start; line-height: 1; padding-top: 0; margin-bottom: var(--space-2); }
    .fgrow__ic { grid-column: 2; grid-row: 2; }
    .fgrow__tx { grid-column: 3; grid-row: 2; }
  }

  @media (--lg) {
    .fgrid__inner { grid-template-columns: 0.82fr 1.18fr; gap: var(--space-9); }
    /* El header acompaña el scroll de la lista larga (sensación de "índice" del documento). */
    .fgrid__head { position: sticky; top: calc(var(--nav-h) + var(--space-6)); }
  }

  @media (--motion-reduce) {
    .fgrow__node, .fgrow__num, .fgrow__ic { transition: none; }
  }
</style>
