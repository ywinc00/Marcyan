---
// Navegación entre artículos v3 (design/rediseno-workos.md §4.8). Dos celdas separadas
// por una línea de 1 px (rejilla de celdas del sistema, sin sombras): dirección como
// rótulo corto, título 18/500 y chevron que se desplaza 3 px. Debajo, "Ver todas las
// guías" con la variante enlace del botón. prev/next salen de la colección ordenada
// por fecha en [slug].astro. Contrato de props INTACTO.
import Button from '../ui/Button.astro';

interface NavLink { title: string; path: string }
interface Props {
  prev?: NavLink | null;
  next?: NavLink | null;
  indexHref: string;
  labels: { prev: string; next: string; index: string };
}
const { prev, next, indexHref, labels } = Astro.props;
---
<nav class="postnav" aria-label="Más artículos">
  <div class:list={['postnav__grid', !(prev && next) && 'postnav__grid--one']}>
    {prev ? (
      <a class="postnav__item postnav__item--prev" href={prev.path}>
        <span class="postnav__dir"><span class="postnav__chev" aria-hidden="true">‹</span>{labels.prev}</span>
        <span class="postnav__title">{prev.title}</span>
      </a>
    ) : null}
    {next ? (
      <a class="postnav__item postnav__item--next" href={next.path}>
        <span class="postnav__dir">{labels.next}<span class="postnav__chev" aria-hidden="true">›</span></span>
        <span class="postnav__title">{next.title}</span>
      </a>
    ) : null}
  </div>
  <div class="postnav__index">
    <Button variant="link" href={indexHref}>{labels.index}</Button>
  </div>
</nav>

<style>
  .postnav { min-width: 0; }
  .postnav__grid {
    display: grid; grid-template-columns: 1fr; gap: 1px;
    background: var(--w-line); border: 1px solid var(--w-line); border-radius: var(--w-r-obj);
    overflow: hidden;
  }
  .postnav__item {
    display: flex; flex-direction: column; gap: 10px; min-width: 0;
    padding: 24px; background: var(--w-s1); text-decoration: none;
    transition: background-color var(--w-dur-hover) var(--w-ease-ui);
  }
  @media (--hover-fine) { a.postnav__item:hover { background: var(--w-s2); } }
  a.postnav__item:focus-visible { outline: 2px solid var(--accent-gold); outline-offset: -2px; }

  .postnav__dir {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--font-mono); font-size: var(--w-micro); font-weight: 500; line-height: 1.2;
    letter-spacing: var(--w-tr-micro); text-transform: uppercase; color: var(--w-ink-60);
  }
  .postnav__chev {
    font-family: var(--font-body); font-size: 18px; line-height: 1; color: var(--accent-gold);
    transition: transform var(--w-dur-hover) var(--w-ease-ui);
  }
  @media (--hover-fine) {
    .postnav__item--prev:hover .postnav__chev { transform: translateX(-3px); }
    .postnav__item--next:hover .postnav__chev { transform: translateX(3px); }
  }
  .postnav__item--prev:focus-visible .postnav__chev { transform: translateX(-3px); }
  .postnav__item--next:focus-visible .postnav__chev { transform: translateX(3px); }
  .postnav__title {
    font-family: var(--font-display); font-weight: 500; font-size: 1.125rem; line-height: 1.3; letter-spacing: -0.015em;
    color: var(--w-ink); text-wrap: pretty;
  }
  .postnav__item--next { align-items: flex-end; text-align: right; }

  .postnav__index { margin-top: 12px; }

  @media (--sm) {
    .postnav__grid { grid-template-columns: 1fr 1fr; }
    /* Con un solo vecino (primer o último artículo) la celda ocupa todo el ancho. */
    .postnav__grid--one { grid-template-columns: 1fr; }
  }
  @media (--motion-reduce) {
    .postnav__item, .postnav__chev { transition: none; }
    .postnav__item--prev:hover .postnav__chev,
    .postnav__item--next:hover .postnav__chev { transform: none; }
  }
</style>
