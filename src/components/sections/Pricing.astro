---
// Panel de precio "desde $" + lista de lo que incluye + CTA. Publicar precios
// reales es palanca AEO (la IA no cita números que no diste) y de confianza.
// Rediseño "consola de cotización": el precio es el héroe (numeral display),
// panel a 2 zonas con regla divisoria + acento de esquina; checklist en chips.
import Icon from '../ui/Icon.astro';
import Kicker from '../ui/Kicker.astro';
import Button from '../ui/Button.astro';
import { t, type Lang } from '../../i18n/ui';

interface Props {
  tag: string;
  title: string;
  /** Precio mostrado, p.ej. "$600". */
  price: string;
  /** Sufijo de unidad, p.ej. "/mes" o "proyecto único". */
  unit?: string;
  lead?: string;
  features: string[];
  cta: { label: string; href: string };
  /** Nota fina (p.ej. honestidad sobre alcance). */
  note?: string;
  tone?: 'gold' | 'teal';
  lang?: Lang;
}
const { tag, title, price, unit, lead, features, cta, note, tone = 'gold', lang = 'es' } = Astro.props;
const uip = t(lang);
---
<section class:list={['section pricing', `pricing--${tone}`]}>
  <div class="container">
    <div class="pricing__card">
      <span class="pricing__stamp" aria-hidden="true">// {uip.price.offer}</span>
      <span class="pricing__corner" aria-hidden="true"></span>

      <div class="pricing__intro">
        <Kicker tone={tone}>{tag}</Kicker>
        <h2 class="h3" set:html={title} />
        {lead && <p class="pricing__lead">{lead}</p>}

        <p class="pricing__price">
          <span class="pricing__from">{uip.price.from}</span>
          <span class="pricing__amt">{price}</span>
          {unit && <span class="pricing__unit">{unit}</span>}
        </p>

        <Button href={cta.href} variant={tone === 'teal' ? 'teal' : 'primary'} size="lg" class="pricing__cta">{cta.label}</Button>
        {note && <p class="pricing__note">{note}</p>}
      </div>

      <div class="pricing__panel">
        <span class="pricing__panel-label">{uip.price.includes}</span>
        <ul class="pricing__features">
          {features.map((f) => (
            <li>
              <span class="pricing__check" aria-hidden="true"><Icon name="lucide:check" /></span>
              <span>{f}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .pricing :global(.h3 em) { font-style: normal; }
  .pricing--gold { --tint: var(--accent-gold); --tint-dim: var(--accent-gold-dim); --tint-line: var(--accent-gold-line); }
  .pricing--teal { --tint: var(--accent-teal); --tint-dim: var(--accent-teal-dim); --tint-line: var(--accent-teal-line); }
  .pricing :global(.h3 em) { color: var(--tint); }

  /* El panel: tarjeta opaca que flota sobre la atmósfera de la página (SpaceBackdrop). */
  .pricing__card {
    position: relative; min-width: 0; overflow: hidden;
    background: var(--bg-card);
    border: 1px solid var(--border); border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    padding: var(--space-6);
    display: grid; grid-template-columns: 1fr; gap: var(--space-6);
  }

  /* Acento de gradiente de esquina (eco del svc-hero de la home) — decorativo. */
  .pricing__corner {
    position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background: radial-gradient(120% 90% at 0% 0%, var(--tint-dim), transparent 52%);
  }
  /* El contenido va por encima del acento. */
  .pricing__intro, .pricing__panel { position: relative; z-index: 1; }

  /* Marca de telemetría en la esquina (mono, baja jerarquía). */
  .pricing__stamp {
    position: absolute; top: var(--space-5); right: var(--space-5); z-index: 1;
    font-family: var(--font-mono); font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide); color: var(--fg-subtle);
  }

  .pricing__intro { display: flex; flex-direction: column; gap: var(--space-4); align-items: flex-start; min-width: 0; }
  .pricing__lead { color: var(--fg-secondary); font-size: var(--text-sm); line-height: var(--leading-normal); max-width: 46ch; }

  /* El precio es el héroe: numeral display grande, "desde" mono encima, unidad en pill. */
  .pricing__price { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-1); margin-block: var(--space-1); }
  .pricing__from {
    font-family: var(--font-mono); font-size: var(--text-xs); color: var(--fg-secondary);
    text-transform: uppercase; letter-spacing: var(--tracking-wider);
  }
  .pricing__amt {
    font-family: var(--font-display); font-size: var(--fluid-display); font-weight: 700;
    color: var(--tint); line-height: 0.95; letter-spacing: var(--tracking-tight);
  }
  .pricing__unit {
    align-self: flex-start; margin-top: var(--space-1);
    display: inline-flex; align-items: center;
    font-family: var(--font-mono); font-size: var(--text-xs); color: var(--fg-secondary);
    padding: 3px var(--space-3); border-radius: var(--radius-pill);
    background: var(--bg-elevated); border: 1px solid var(--border);
  }

  .pricing__cta { margin-top: var(--space-2); }
  .pricing__note { font-size: var(--text-xs); color: var(--fg-secondary); line-height: var(--leading-normal); max-width: 50ch; }

  /* Panel "Incluye": encabezado mono + checklist con chips de acento. */
  .pricing__panel { display: flex; flex-direction: column; gap: var(--space-4); min-width: 0; }
  .pricing__panel-label {
    font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 500;
    text-transform: uppercase; letter-spacing: var(--tracking-widest); color: var(--fg-secondary);
  }

  .pricing__features { list-style: none; display: grid; grid-template-columns: 1fr; gap: var(--space-3); align-content: start; }
  .pricing__features li { display: flex; align-items: flex-start; gap: var(--space-3); font-size: var(--text-sm); color: var(--fg-primary); line-height: var(--leading-snug); min-width: 0; }

  /* Check en chip teal-dim (señal "incluido"), alineado al baseline del texto. */
  .pricing__check {
    flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center;
    width: 22px; height: 22px; border-radius: var(--radius-pill);
    background: var(--tint-dim); border: 1px solid var(--tint-line); color: var(--tint);
    margin-top: 1px;
  }
  .pricing__check :global(svg) { width: 13px; height: 13px; stroke-width: 2; }

  @media (--sm) { .pricing__features { grid-template-columns: repeat(2, 1fr); } }

  @media (--lg) {
    .pricing__card {
      grid-template-columns: 0.82fr 1.18fr;
      gap: var(--space-8); padding: var(--space-8); align-items: stretch;
    }
    /* Regla divisoria vertical: separa la cotización del listado (la "regla del panel"). */
    .pricing__panel {
      padding-left: var(--space-8);
      border-left: 1px solid var(--border);
    }
    .pricing__intro { justify-content: center; }
  }
</style>
