---
// Sección Proceso "Del concepto al lanzamiento" · vuelta 2 (design/rediseno-workos-v2.md §3 G01, nota 3).
// Se conservan section#proceso[data-process][data-fx="gold"], kicker, H2 y los 5 pasos de
// content.process (verbatim). El riel horizontal de la v1 se sustituye por LineaFases variante
// "portada" (P11: fases a la izquierda + panel fijo de escenas a la derecha, gesto F-05 de WorkOS)
// con EscenaAbreApps (P08, W2N-03: el portátil que se abre y enseña tu web, tu ficha y Marcy ya
// funcionando) en el slot final. El CTA va bajo el portátil.
//
// Revisión 1 de G01 (tope de alto ≤ 1.800 px a 1440 y portátil legible):
//  · Escritorio (≥ 1120): la fase final va en dos columnas, su texto (300 px) y el portátil al
//    resto del ancho (≈ 855 px a 1440, antes 600) con el CTA debajo del portátil.
//  · v3 (E-57 regla 4): la tapa se abre con la pieza FIJADA y centrada en la ventana (el tramo
//    de 450 px de EscenaAbreApps). La v2 la abría sin fijar y giraba mientras el portátil aún
//    asomaba por abajo. El alto visible no cambia; el tramo suma 450 px de scroll.
//  · Por debajo de 900 px el portátil NO se pinta: su lienzo de 1.415 px a 350 px de ancho deja
//    la letra en 3-4 px (§1.8 pide ≥ 9 en lo decorativo). La fase 05 queda con su texto y el CTA
//    (y en móvil, el cohete), como en producción.
//
// Cohete del final móvil (E-02, adaptación escrita en P11): el motor launch(), las clases
// has-finale / is-launched / is-done y TODO su CSS quedan iguales. Solo cambian dos cosas:
//  · la detección del paso: en vez de medir los [data-step] del riel, escucha el evento
//    `w2:fases-fin` que LineaFases emite cuando se activa su última fase;
//  · el origen del vuelo: el centro del punto de esa fase, `detail.origen` (px relativos a la
//    <section>), en vez de `.riel__dot` del último paso.
// Una sola vez por visita, solo tras una interacción real que haya movido la página (igual que antes).
//  · reduced-motion / sin JS: CTA inline (sin capa).
import Icon from '../ui/Icon.astro';
import Kicker from '../ui/Kicker.astro';
import Button from '../ui/Button.astro';
import LineaFases from '../w/proceso/LineaFases.astro';
import EscenaAbreApps from '../w/mac/EscenaAbreApps.astro';
import { fasesDe } from '../w/proceso/proceso';

interface Props { process: any }
const { process } = Astro.props;
const lang: 'es' | 'en' = Astro.url.pathname.startsWith('/en') ? 'en' : 'es';
const launch = process.launch ?? { label: 'Lanza tu proyecto ahora', href: '#contacto' };
---
<section class="section process" id="proceso" data-process data-fx="gold">
  <div class="container">
    <header class="process__head">
      <Kicker>{process.tag}</Kicker>
      <h2 class="h2" set:html={process.title} />
    </header>

    <LineaFases fases={fasesDe(process.steps)} lang={lang} variante="portada" class="process__fases">
      <div slot="final" class="process__fin">
        <EscenaAbreApps lang={lang} ancho={880} />
        <!-- CTA inline (PC / reduced-motion / sin JS / tras el show en móvil), bajo el portátil -->
        <div class="riel__launch-inline">
          {launch.kicker && <span class="riel__cta-kicker">{launch.kicker}</span>}
          <Button href={launch.href} variant="primary" size="lg">{launch.label}</Button>
        </div>
      </div>
    </LineaFases>
  </div>

  <!-- FINALE (móvil, una sola vez): el cohete vuela al centro + CTA + fondo difuminado -->
  <div class="riel__finale" data-finale aria-hidden="true">
    <span class="riel__rocket-fly" data-rocket aria-hidden="true"><Icon name="lucide:rocket" /></span>
    <div class="riel__finale-cta">
      {launch.kicker && <span class="riel__cta-kicker">{launch.kicker}</span>}
      <Button href={launch.href} variant="primary" size="lg">{launch.label}</Button>
    </div>
  </div>
</section>

<style>
  .process :global(em) { color: var(--accent-gold); font-style: normal; }
  .process__head { display: flex; flex-direction: column; gap: var(--space-4); margin-bottom: var(--space-7); }

  /* ── Fase final: portátil + CTA (slot `final` de LineaFases) ── */
  .process__fin { min-width: 0; }
  /* v3: la tapa vuelve a abrirse con el portátil FIJADO y centrado (tramo de EscenaAbreApps).
     Sin fijar, giraba mientras la pieza aún asomaba por abajo (E-57 regla 4). */
  @media (max-width: 899.98px) {
    .process[data-process] :global(.process__fin .abre) { display: none; }
  }
  /* Apilado: las escenas de LineaFases llevan content-visibility:auto, y en la portada (hero con
     animación continua) eso costaba ≈ 100 ms de TBT móvil medidos (perf ×4, 412 px, mediana de 7-9
     pasadas: 150-200 ms con él, ≈ 30 ms sin él; producción ≈ 10). Aquí se pintan normal. */
  @media (max-width: 1119.98px) {
    .process[data-process] :global(.lf__esc) { content-visibility: visible; }
  }
  @media (min-width: 1120px) {
    /* Tope de alto (≤ 1.800 a 1440): menos aire abajo (el CTA ya cierra) y entre fases. */
    .process { padding-bottom: 56px; }
    .process__head { margin-bottom: 40px; }
    .process[data-process] :global(.lf__grid .lf__paso) { padding-bottom: 16px; }
    /* 40 px arriba: el panel fijo de las fases termina donde acaba su rejilla y no debe rozar la tapa. */
    .process[data-process] :global(.lf__fin) { grid-template-columns: 300px minmax(0, 1fr); column-gap: 40px; align-items: center; padding-top: 40px; }
    .process__fin .riel__launch-inline { margin-top: 12px; }
  }

  /* ── CTA inline (abajo, bajo el portátil) ──────────────── */
  .riel__launch-inline { margin-top: var(--space-6); display: flex; flex-direction: column; align-items: center; gap: var(--space-3); text-align: center; }
  .has-finale .riel__launch-inline { display: none; }
  .riel__cta-kicker { font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: var(--tracking-wide); text-transform: uppercase; color: var(--accent-gold); }

  /* ── FINALE: cohete al centro + CTA + fondo difuminado (móvil, una vez) ── */
  .riel__finale {
    position: fixed; inset: 0; z-index: 60; display: none;
    flex-direction: column; align-items: center; justify-content: center; gap: var(--space-6);
    pointer-events: none; opacity: 0; visibility: hidden;
    background: rgba(8, 8, 8, 0.42);
    -webkit-backdrop-filter: blur(7px); backdrop-filter: blur(7px);
    transition: opacity 0.5s var(--ease-out-expo), visibility 0s linear 0.5s;
  }
  .has-finale .riel__finale { display: flex; }
  .process.is-launched .riel__finale { opacity: 1; visibility: visible; transition: opacity 0.5s var(--ease-out-expo); }
  .process.is-done .riel__finale { opacity: 0; visibility: hidden; transition: opacity 0.35s var(--ease-out-expo), visibility 0s linear 0.35s; }

  /* el cohete que vuela (FLIP: arranca en el nodo, JS le pone el transform inicial). Vuelo LENTO. */
  .riel__rocket-fly { position: relative; color: var(--accent-gold); transition: transform 1.9s cubic-bezier(0.22, 1, 0.36, 1); }
  .riel__rocket-fly :global(svg) { width: 54px; height: 54px; display: block; }
  .riel__rocket-fly::after { content: ""; position: absolute; left: 50%; bottom: -10px; width: 24px; height: 24px; border-radius: 50%; background: radial-gradient(circle, var(--accent-gold-glow), transparent 70%); transform: translateX(-50%) scale(0); opacity: 0; pointer-events: none; }
  .process.is-launched .riel__rocket-fly::after { animation: rsmoke 1.9s var(--ease-out-expo) forwards; }
  @keyframes rsmoke { 0% { transform: translateX(-50%) scale(0.4); opacity: 0.7; } 100% { transform: translateX(-50%) translateY(26px) scale(2.8); opacity: 0; } }

  /* el CTA sale CUANDO el cohete ya se detuvo (delay ~ el vuelo) */
  .riel__finale-cta { display: flex; flex-direction: column; align-items: center; gap: var(--space-3); pointer-events: auto; opacity: 0; transform: translateY(16px); transition: opacity 0.55s var(--ease-out-expo), transform 0.55s var(--ease-out-expo); }
  .process.is-launched .riel__finale-cta { opacity: 1; transform: none; transition-delay: 1.7s; }
  /* el punto de la fase final se apaga (se ve que el cohete "salió" de él)… */
  .process.is-launched :global(.lf__paso--fin .lf__dot) { opacity: 0; }
  /* …y al salir del finale VUELVE */
  .process.is-done :global(.lf__paso--fin .lf__dot) { opacity: 1; }

  @media (--motion-reduce) {
    .riel__finale { display: none !important; }
    .has-finale .riel__launch-inline { display: flex; }
  }
</style>

<script>
  const section = document.querySelector('[data-process]') as HTMLElement | null;
  if (section) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Desktop (≥1024) → sin capa. Layout apilado (<1024) → cohete, que se reproduce UNA sola vez.
    if (window.innerWidth < 1024 && !reduce) {
      const rocket = section.querySelector<HTMLElement>('[data-rocket]');
      let phase: 'idle' | 'launched' | 'done' = 'idle';
      let ticking = false;
      // Origen del vuelo: centro del punto de la última fase, en px relativos a la <section>
      // (detail.origen de `w2:fases-fin`). Se convierte a pantalla en el momento del lanzamiento.
      let origen: { x: number; y: number } | null = null;
      const origenEnPantalla = () => {
        const S = section.getBoundingClientRect();
        return origen ? { x: S.left + origen.x, y: S.top + origen.y } : null;
      };
      // La capa del cohete SOLO se lanza tras una interacción real de la persona (toque,
      // rueda, tecla o puntero) que haya movido la página. Un render sin scroll (p. ej. Google
      // con un viewport móvil altísimo) no puede dejar la capa fija tapando la página.
      // has-finale (que prepara la capa y oculta el CTA de abajo) también espera a esa
      // primera interacción: sin ella, el CTA de abajo sigue visible y se puede pulsar.
      // Solo si en ese momento el CTA de abajo aún está por debajo de la pantalla: si ya está
      // a la vista o se dejó atrás, se deja como está (ocultarlo movería la página bajo el
      // dedo) y esa visita no tiene capa.
      let interacted = false;
      let lastScroll = 0;
      const inlineCta = section.querySelector<HTMLElement>('.riel__launch-inline');
      const interactionEvents = ['touchstart', 'wheel', 'keydown', 'pointerdown'] as const;
      // Un toque o clic en un enlace a otra sección de la MISMA página no cuenta como interacción:
      // su salto suave cruzaría la sección y haría un destello de la capa. Mientras dura ese salto
      // la capa tampoco puede lanzarse.
      let jumpUntil = 0;
      const isInPageJump = (e: Event) => {
        const a = (e.target as Element | null)?.closest?.('a[href]') as HTMLAnchorElement | null;
        if (!a) return false;
        try {
          const u = new URL(a.href, location.href);
          return !!u.hash && u.origin === location.origin && u.pathname === location.pathname;
        } catch { return false; }
      };
      const markInteraction = (e: Event) => {
        if (isInPageJump(e)) { jumpUntil = performance.now() + 2000; return; }
        if (interacted) return;
        interacted = true;
        const r = inlineCta?.getBoundingClientRect();
        if (r && r.top >= window.innerHeight) section.classList.add('has-finale');
      };
      interactionEvents.forEach((ev) => window.addEventListener(ev, markInteraction, { passive: true }));

      // el cohete arranca EN el punto de la fase final y vuela LENTO a su sitio (centro)
      function launch() {
        phase = 'launched';
        const o = origenEnPantalla();
        if (rocket && o) {
          const rr = rocket.getBoundingClientRect();      // posición de reposo (centrada)
          const dx = o.x - (rr.left + rr.width / 2);
          const dy = o.y - (rr.top + rr.height / 2);
          rocket.style.transition = 'none';
          rocket.style.transform = `translate(${dx}px, ${dy}px) scale(0.5)`;
        }
        section.classList.add('is-launched');             // overlay + blur + apaga el punto de la fase
        setTimeout(() => { if (rocket) { rocket.style.transition = ''; rocket.style.transform = ''; } }, 40);
      }
      // una vez reproducido: se cierra (sin revertir), no recarga
      function finish() {
        phase = 'done';
        section.classList.add('is-done');
        section.classList.remove('has-finale');           // CTA inline para futuras visitas
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onResize);
        section.removeEventListener('w2:fases-fin', onFin);
        interactionEvents.forEach((ev) => window.removeEventListener(ev, markInteraction));
      }
      // Detección del paso: LineaFases avisa cuando su última fase se activa.
      const onFin = (e: Event) => {
        const d = (e as CustomEvent).detail;
        if (d?.origen) origen = d.origen;
        if (phase !== 'idle') return;
        const now = performance.now();
        const canLaunch = interacted && window.scrollY > 0 && now >= jumpUntil && now - lastScroll < 700;
        if (canLaunch && section.classList.contains('has-finale')) launch(); // dispara JUSTO cuando la energía llega a la fase final
      };
      section.addEventListener('w2:fases-fin', onFin);

      const update = () => {
        ticking = false;
        if (phase !== 'launched') return;
        // se cierra al alejarte de la fase final (punto medio: ni tan pronto ni tan tarde)
        const vh = window.innerHeight;
        const o = origenEnPantalla();
        if (!o) return;
        if (o.y < vh * 0.16 || o.y > vh * 0.98) finish();
      };
      const schedule = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
      const onScroll = () => {
        // mientras sigue el salto suave a un ancla, se alarga la ventana hasta que pare
        if (performance.now() < jumpUntil) jumpUntil = performance.now() + 250;
        lastScroll = performance.now();
        schedule();
      };
      const onResize = () => schedule();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onResize, { passive: true });
    }
  }
</script>
