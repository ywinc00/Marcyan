---
// Sección Proceso "Del concepto al lanzamiento" · vuelta 2 (design/rediseno-workos-v2.md §3 G01, nota 3).
// Se conservan section#proceso[data-process][data-fx="gold"], kicker, H2 y los 5 pasos de
// content.process (verbatim). El riel horizontal de la v1 se sustituye por LineaFases variante
// "portada" (P11: fases a la izquierda + panel fijo de escenas a la derecha, gesto F-05 de WorkOS)
// con EscenaAbreApps (P08, W2N-03: el portátil que se abre y enseña tu web, tu ficha y Marcy ya
// funcionando) en el slot final. El CTA va bajo el portátil.
//
// Revisión 1 de G01 (tope de alto ≤ 1.800 px a 1440 y portátil legible):
//  · Escritorio (≥ 1120): la fase final va en dos columnas, su texto (300 px) y el portátil al
//    resto del ancho (≈ 855 px a 1440, antes 600) con el CTA debajo del portátil.
//  · v3 (E-57 regla 4): la tapa se abre con la pieza FIJADA y centrada en la ventana (el tramo
//    de 450 px de EscenaAbreApps). La v2 la abría sin fijar y giraba mientras el portátil aún
//    asomaba por abajo. El alto visible no cambia; el tramo suma 450 px de scroll.
//  · v5 (dueño, 2026-11-06): en móvil y tableta el portátil SÍ se pinta en la fase 05, como
//    W2N-03 en 390 (portátil entero bajo el titular, base incluida, mismo ritmo, 3 apps). El cohete
//    del final móvil se ELIMINA: «ya no tiene sentido», la fase final es el portátil.
import Kicker from '../ui/Kicker.astro';
import Button from '../ui/Button.astro';
import LineaFases from '../w/proceso/LineaFases.astro';
import EscenaAbreApps from '../w/mac/EscenaAbreApps.astro';
import { fasesDe } from '../w/proceso/proceso';
import { portfolioProjects as PES } from '../../i18n/portfolio';
import { portfolioProjects as PEN } from '../../i18n/portfolio.en';

interface Props { process: any; projects?: any }
const { process, projects } = Astro.props;
const lang: 'es' | 'en' = Astro.url.pathname.startsWith('/en') ? 'en' : 'es';
const launch = process.launch ?? { label: 'Lanza tu proyecto ahora', href: '#contacto' };
// Modo viaje (dueño, 2026-11-08): con `projects`, la fase final se fija, el portátil se acerca y los
// proyectos reales salen como ventanas en su pantalla (la sección Proyectos queda de respaldo).
const lista = lang === 'en' ? PEN : PES;
const MOVIL_H: Record<string, number> = { trr: 958, mja: 899, jls: 944, rn: 1068 };
const DOMINIOS: Record<string, string> = { trr: 'texasrushremove.com', mja: 'movejunkaway.com' };
// TRR y MJA tienen colores muy parecidos: nunca uno detrás del otro (dueño, 2026-11-08).
const ORDEN = ['trr', 'jls', 'mja', 'rn'];
const viaje = projects ? {
  proyectos: (projects.items as any[]).map((p) => {
    const slug = lista.find((x) => x.name === p.name)?.slug ?? PES.find((x) => x.name === p.name)?.slug;
    const parts = String(p.cat ?? '').split('·').map((x: string) => x.trim());
    const city = slug === 'mja' ? 'Florida (Orlando)' : (parts[1] ?? '').replace(/,\s*[A-Z]{2}$/, '');
    return slug ? { slug, name: p.name, cat: [parts[0], city].filter(Boolean).join(' · '), result: p.result, domain: DOMINIOS[slug], movilH: MOVIL_H[slug] ?? 960 } : null;
  }).filter(Boolean).sort((a: any, b: any) => ORDEN.indexOf(a.slug) - ORDEN.indexOf(b.slug)),
  cab: { tag: projects.tag, titleHtml: projects.title, cta: { label: lang === 'en' ? 'See the full portfolio' : 'Ver todo el portafolio', href: lang === 'en' ? '/en/portfolio' : '/es/portafolio' } },
  lanza: launch,
} : undefined;
---
<section class="section process" id="proceso" data-process data-fx="gold">
  <div class="container">
    <header class="process__head">
      <Kicker>{process.tag}</Kicker>
      <h2 class="h2" set:html={process.title} />
    </header>

    <LineaFases fases={fasesDe(process.steps)} lang={lang} variante="portada" pin={!!viaje} class="process__fases">
      <div slot="final" class="process__fin">
        <EscenaAbreApps lang={lang} ancho={880} viaje={viaje as any} />
        <!-- CTA bajo el portátil (todas las anchuras) -->
        <div class="riel__launch-inline">
          {launch.kicker && <span class="riel__cta-kicker">{launch.kicker}</span>}
          <Button href={launch.href} variant="primary" size="lg">{launch.label}</Button>
        </div>
      </div>
    </LineaFases>
  </div>

</section>

<style>
  .process :global(em) { color: var(--accent-gold); font-style: normal; }
  .process__head { display: flex; flex-direction: column; gap: var(--space-4); margin-bottom: var(--space-7); }

  /* ── Fase final: portátil + CTA (slot `final` de LineaFases) ── */
  .process__fin { min-width: 0; }
  /* Modo viaje encendido: el CTA ya vive en el pie del portátil y la sección Proyectos de debajo
     (respaldo sin JS) se retira: los proyectos salen en la pantalla del portátil. */
  :global(.lf--pin[data-pin-on]) .process__fin > .riel__launch-inline { display: none; }
  :global(body:has(.lf--pin[data-pin-on])) :global(section.projects) { display: none; }
  :global(.lf--pin[data-pin-on]) .process__fin { position: absolute; inset: 0; }
  /* v4: el recorte lateral de la tapa en 3D vive aquí, a ancho de ventana (antes en .abre, que le
     cortaba las esquinas). overflow-x:clip no crea contenedor de scroll: el tramo fijado sigue. */
  .process[data-process] { overflow-x: clip; }
  /* v3: la tapa vuelve a abrirse con el portátil FIJADO y centrado (tramo de EscenaAbreApps).
     Sin fijar, giraba mientras la pieza aún asomaba por abajo (E-57 regla 4). */
  /* Apilado: las escenas de LineaFases llevan content-visibility:auto, y en la portada (hero con
     animación continua) eso costaba ≈ 100 ms de TBT móvil medidos (perf ×4, 412 px, mediana de 7-9
     pasadas: 150-200 ms con él, ≈ 30 ms sin él; producción ≈ 10). Aquí se pintan normal. */
  @media (max-width: 1119.98px) {
    .process[data-process] :global(.lf__esc) { content-visibility: visible; }
  }
  @media (min-width: 1120px) {
    /* Tope de alto (≤ 1.800 a 1440): menos aire abajo (el CTA ya cierra) y entre fases. */
    .process { padding-bottom: 56px; }
    .process__head { margin-bottom: 40px; }
    .process[data-process] :global(.lf__grid .lf__paso) { padding-bottom: 16px; }
    /* 40 px arriba: el panel fijo de las fases termina donde acaba su rejilla y no debe rozar la tapa. */
    .process[data-process] :global(.lf__fin) { grid-template-columns: 300px minmax(0, 1fr); column-gap: 40px; align-items: center; padding-top: 40px; }
    .process__fin .riel__launch-inline { margin-top: 12px; }
  }

  /* ── CTA inline (abajo, bajo el portátil) ──────────────── */
  .riel__launch-inline { margin-top: var(--space-6); display: flex; flex-direction: column; align-items: center; gap: var(--space-3); text-align: center; }
  .riel__cta-kicker { font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: var(--tracking-wide); text-transform: uppercase; color: var(--accent-gold); }

</style>
