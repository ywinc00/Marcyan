---
// Sección Proyectos · detalles permitidos de la portada (design/rediseno-workos.md §4.1, W-PROOF-12).
// El carrusel portátil + teléfono pasa a figuras de proyecto (w/FiguraProyecto): captura REAL
// en marco de navegador radio 8 (3 puntos + dominio sin enlace), teléfono solapado y pie mono
// 13 con el nombre (translate="no"). Dos por fila en escritorio, con el teléfono hacia fuera
// (alternando); en móvil una columna y "Ver Proyectos" despliega el resto. Se conservan
// id="proyectos", data-fx, la cabecera y el texto de resultado de cada proyecto (content.ts).
// El script del carrusel ([data-projects]) se borra; queda solo el botón de desplegar.
import Icon from '../ui/Icon.astro';
import Kicker from '../ui/Kicker.astro';
import Button from '../ui/Button.astro';
import FiguraProyecto from '../w/FiguraProyecto.astro';
import { t, type Lang } from '../../i18n/ui';

interface Props { projects: any; lang?: Lang }
const { projects, lang = 'es' } = Astro.props;
const uipr = t(lang);
const items = projects.items as any[];
const extra = items.length > 2;
---
<section class="section projects" id="proyectos" data-fx="gold">
  <div class="container">
    <header class="projects__head">
      <div class="projects__intro">
        <Kicker>{projects.tag}</Kicker>
        <h2 class="h2" set:html={projects.title} />
      </div>
      <Button href={projects.cta.href} variant="secondary" class="projects__head-cta">{projects.cta.label}</Button>
    </header>

    <div class="pjw" data-pjw>
      {items.map((p, idx) => (
        <article class:list={['pjw__item', idx >= 2 && 'pjw__item--more']}>
          <FiguraProyecto project={p} side={idx % 2 === 0 ? 'left' : 'right'} lang={lang} />
          <p class="pjw__result">{p.result}</p>
        </article>
      ))}
    </div>
    {extra && (
      <button class="pjw__more" type="button" data-pjw-more aria-expanded="false">
        <span>{projects.more ?? uipr.projects.more}</span>
        <Icon name="lucide:chevron-down" class="pjw__more-ic" />
      </button>
    )}
  </div>
</section>

<style>
  .projects :global(em) { color: var(--accent-gold); font-style: normal; }
  .projects__head { display: flex; flex-direction: column; gap: var(--space-5); align-items: flex-start; margin-bottom: var(--space-7); }
  .projects__intro { display: flex; flex-direction: column; gap: var(--space-4); }

  /* ── Figuras W-PROOF-12 ────────────────────────────────── */
  .pjw { display: grid; grid-template-columns: 1fr; row-gap: 56px; }
  .pjw__item { min-width: 0; display: flex; flex-direction: column; align-items: center; }
  .pjw__item--more { display: none; }
  .pjw.is-expanded .pjw__item--more { display: flex; }
  .pjw__result {
    margin: 10px auto 0; max-width: 46ch; text-align: center;
    font-family: var(--font-body); font-size: 15px; line-height: 1.6; color: var(--fg-secondary);
  }

  /* "Ver Proyectos" (móvil): despliega los dos que quedan. */
  .pjw__more {
    display: flex; align-items: center; gap: var(--space-2); margin: var(--space-6) auto 0;
    min-height: var(--tap-min); padding: var(--space-2) var(--space-4);
    color: var(--fg-secondary); background: transparent; border: 0; cursor: pointer;
    font-family: var(--font-mono); font-size: var(--text-sm); letter-spacing: var(--tracking-wide); text-transform: uppercase;
    transition: color var(--duration-fast);
  }
  .pjw__more:hover { color: var(--accent-gold); }
  .pjw__more :global(.pjw__more-ic) { width: 16px; height: 16px; transition: transform var(--duration-base) var(--ease-out-expo); }
  .pjw.is-expanded + .pjw__more :global(.pjw__more-ic) { transform: rotate(180deg); }

  @media (--md) {
    .projects__head { flex-direction: row; align-items: flex-end; justify-content: space-between; }
    .pjw { grid-template-columns: 1fr 1fr; column-gap: 48px; row-gap: 72px; }
    .pjw__item--more { display: flex; }
    .pjw__more { display: none; }
    .pjw__result { font-size: 16px; }
  }
  @media (--lg) { .pjw { column-gap: 64px; row-gap: 88px; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-pjw]').forEach((root) => {
    const more = root.parentElement?.querySelector<HTMLButtonElement>('[data-pjw-more]');
    more?.addEventListener('click', () => {
      const exp = root.classList.toggle('is-expanded');
      more.setAttribute('aria-expanded', exp ? 'true' : 'false');
    });
  });
</script>
