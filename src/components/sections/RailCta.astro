---
// Tarjeta de conversión del raíl del blog (superficie DESKTOP — el raíl la
// oculta en móvil). SIN formulario propio: el blog no debe ser un formulario de
// contacto más. Un solo botón que lleva al formulario de contacto de la propia
// página (#contacto), donde viven el formulario, WhatsApp y llamar. El brief
// (/formulario) nunca capta.
import Icon from '../ui/Icon.astro';

interface Props { t: any }
const { t } = Astro.props;
---
<aside class="rcta" aria-label={t.aria}>
  <h2 class="rcta__title" set:html={t.title} />
  <a class="rcta__btn" href={t.button.href}>
    <span>{t.button.label}</span>
    <Icon name="lucide:arrow-right" />
  </a>
</aside>

<style>
  .rcta {
    position: relative; isolation: isolate; overflow: hidden;
    display: flex; flex-direction: column; gap: var(--space-4);
    background:
      radial-gradient(120% 140% at 50% 0%, color-mix(in srgb, var(--accent-gold), transparent 92%), transparent 60%),
      var(--bg-card);
    border: 1px solid var(--border); border-radius: var(--radius-lg);
    padding: var(--space-5);
  }
  /* filete superior de acento — eco de CtaBand, versión mini */
  .rcta::before {
    content: ""; position: absolute; inset-inline: 0; top: 0; height: 1px; pointer-events: none;
    background: linear-gradient(90deg, transparent, var(--accent-gold), transparent);
    opacity: 0.7;
  }

  .rcta__title {
    margin: 0; font-family: var(--font-display); font-size: var(--text-lg);
    line-height: var(--leading-snug); color: var(--fg-primary);
  }
  .rcta__title :global(em) { color: var(--accent-gold); font-style: normal; }

  .rcta__btn {
    display: inline-flex; align-items: center; justify-content: center; gap: var(--space-2);
    min-height: var(--tap-min); padding: 11px 18px; border-radius: var(--radius-md);
    background: var(--accent-gold); color: var(--fg-inverse); border: 1px solid var(--accent-gold);
    font-family: var(--font-body); font-weight: 600; font-size: var(--text-sm); text-decoration: none;
    transition: background var(--duration-fast) var(--ease-out-expo), box-shadow var(--duration-base), gap var(--duration-fast);
  }
  .rcta__btn :global(svg) { width: 16px; height: 16px; flex: 0 0 auto; }
  .rcta__btn:hover { background: color-mix(in srgb, var(--accent-gold), white 10%); box-shadow: 0 8px 30px -12px var(--accent-gold-glow); gap: var(--space-3); }
  .rcta__btn:focus-visible { outline: 2px solid var(--accent-gold); outline-offset: 2px; }

  @media (--motion-reduce) { .rcta__btn { transition: none; } }
</style>
