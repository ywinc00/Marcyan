---
// Sección Servicios · detalles permitidos de la portada (design/rediseno-workos.md §4.1, W-HOME-10 + G6).
// La cabecera (kicker, titular, nota y botón) queda TAL CUAL. Las tarjetas "destacado +
// compactas" pasan a la rejilla de WorkOS: 2 columnas de 552 (hueco 96 × 75), icono-objeto
// de 80 + nombre 20/500 + texto 16/24, y el 7.º servicio (Mantenimiento) como fila ancha
// final con icono 56 ("2×3 son 6"). Cada celda enlaza a su servicio con el href de
// content.ts; el precio sigue visible (citable para AEO) en el acento del icono (E-14).
// Sin fondos: la sección conserva data-fx="gold" y StarField pinta detrás.
import Kicker from '../ui/Kicker.astro';
import Button from '../ui/Button.astro';
import IconoObjeto from '../w/IconoObjeto.astro';
import { ICONOS } from '../w/objects/registry';
import { servicioIcono } from '../../i18n/w/portada';

interface Props { services: any }
const { services } = Astro.props;
const items = (services.items as any[]).map((s, i) => {
  const id = servicioIcono[s.n] ?? 'diseno-web';
  return { ...s, id, tone: ICONOS[id].tone, wide: i === 6 };
});
---
<section class="section services" id="servicios" data-fx="gold">
  <div class="container">
    <header class="services__head">
      <div class="services__intro">
        <Kicker>{services.tag}</Kicker>
        <h2 class="h2" set:html={services.title} />
        {services.note && <p class="services__note">{services.note}</p>}
      </div>
      <Button href={services.cta.href} variant="secondary" class="services__head-cta">{services.cta.label}</Button>
    </header>

    <ul class="svc-w" role="list">
      {items.map((s) => (
        <li class:list={['svc-w__item', s.wide && 'svc-w__item--wide']}>
          <a class="svc-w__cell" href={s.href} data-tone={s.tone}>
            <span class="svc-w__ic"><IconoObjeto id={s.id} size={s.wide ? 56 : 80} /></span>
            <div class="svc-w__tx">
              <h3 class="svc-w__name">{s.title}</h3>
              <p class="svc-w__desc">{s.desc}</p>
              <span class="svc-w__price">{s.price}<span class="svc-w__chev" aria-hidden="true">›</span></span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .services__head { display: flex; flex-direction: column; gap: var(--space-5); align-items: flex-start; margin-bottom: var(--space-7); }
  .services__intro { display: flex; flex-direction: column; gap: var(--space-4); }
  .services__intro :global(.h2) :global(em) { color: var(--accent-gold); font-style: normal; }
  .services__note {
    display: inline-flex; align-items: center; gap: var(--space-2);
    font-family: var(--font-mono); font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide); color: var(--accent-teal); max-width: 56ch;
  }

  /* ── Rejilla W-HOME-10 ─────────────────────────────────── */
  .svc-w { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr; row-gap: 40px; }
  .svc-w__item { min-width: 0; }
  .svc-w__cell {
    color: inherit; text-decoration: none;
    display: grid; grid-template-columns: 56px 1fr; column-gap: 20px; align-items: start;
    border-radius: var(--w-r-obj, 12px);
  }
  .svc-w__ic { display: block; padding-top: 2px; }
  /* El icono se pinta a 80; en móvil se lee a 56 con el oficio de 56 (IconoObjeto §2.8). */
  .svc-w__ic :global(.wi) { width: 56px; height: 56px; --wi-sw: 2.5; --wi-tint: 0.2; --wi-edge-a: 0.6; --wi-edge-hover: 0.9; --wi-bw: 1.2; }
  @media (--lt-lg) { .svc-w__ic :global(.wi--glow) { filter: none; } }
  .svc-w__tx { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .svc-w__name {
    margin: 0; font-family: var(--font-display); font-weight: 500;
    font-size: 18px; line-height: 1.25; letter-spacing: -0.01em; color: var(--fg-primary);
  }
  .svc-w__desc { margin: 0; font-family: var(--font-body); font-size: 15px; line-height: 1.55; color: var(--fg-secondary); }
  .svc-w__price {
    margin-top: 4px; display: inline-flex; align-items: center; gap: 6px; align-self: flex-start;
    font-family: var(--font-body); font-weight: 500; font-size: 14px; line-height: 1.3; color: var(--accent-gold);
  }
  .svc-w__cell[data-tone='teal'] .svc-w__price { color: var(--accent-teal); }
  .svc-w__chev { font-size: 18px; line-height: 1; transition: transform var(--w-dur-hover, 200ms) var(--w-ease-ui, ease); }
  .svc-w__name { transition: color var(--w-dur-micro, 150ms) var(--w-ease-ui, ease); }
  @media (--hover-fine) {
    .svc-w__cell:hover .svc-w__chev { transform: translateX(3px); }
    .svc-w__cell:hover .svc-w__name { color: var(--accent-gold); }
    .svc-w__cell[data-tone='teal']:hover .svc-w__name { color: var(--accent-teal); }
  }
  .svc-w__cell:focus-visible .svc-w__chev { transform: translateX(3px); }
  @media (--motion-reduce) { .svc-w__chev { transition: none; } .svc-w__cell:hover .svc-w__chev, .svc-w__cell:focus-visible .svc-w__chev { transform: none; } }

  /* Mantenimiento: fila ancha final, tras un filete de 1 px. */
  .svc-w__item--wide { padding-top: 40px; border-top: 1px solid var(--w-line, rgba(200,169,110,.09)); }

  @media (--md) {
    .svc-w { grid-template-columns: 1fr 1fr; column-gap: 48px; row-gap: 56px; }
    .svc-w__item--wide { grid-column: 1 / -1; padding-top: 48px; }
  }
  @media (--lg) {
    .services__head { flex-direction: row; align-items: flex-end; justify-content: space-between; }
    .svc-w { column-gap: 96px; row-gap: 75px; }
    .svc-w__cell { grid-template-columns: 80px 1fr; column-gap: 32px; }
    .svc-w__item:not(.svc-w__item--wide) .svc-w__ic :global(.wi) { width: 80px; height: 80px; --wi-sw: 2; --wi-tint: 0.1; --wi-edge-a: 0.45; --wi-edge-hover: 0.8; --wi-bw: 1; }
    .svc-w__name { font-size: 20px; line-height: 1.2; }
    .svc-w__desc { font-size: 16px; line-height: 1.5; max-width: 440px; }
    /* Fila ancha: icono 56, nombre y texto en una línea de lectura, precio al final. */
    .svc-w__item--wide .svc-w__cell { grid-template-columns: 56px 1fr; column-gap: 32px; align-items: center; }
    .svc-w__item--wide .svc-w__tx { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 48px; row-gap: 6px; align-items: center; }
    .svc-w__item--wide .svc-w__name { grid-column: 1; }
    .svc-w__item--wide .svc-w__desc { grid-column: 1; max-width: 640px; }
    .svc-w__item--wide .svc-w__price { grid-column: 2; grid-row: 1 / span 2; margin-top: 0; align-self: center; }
  }
</style>
