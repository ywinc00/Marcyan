---
// Botón / enlace-botón. Variantes: primary (oro) · secondary (contorno) · teal · ghost
// · link (texto + chevron, rediseño WorkOS §2.7; aditiva: las otras no cambian).
// Renderiza <a> si hay href, si no <button>. Altura mínima ≥44px (objetivo táctil).
interface Props {
  variant?: 'primary' | 'secondary' | 'teal' | 'ghost' | 'link';
  size?: 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit';
  class?: string;
  [key: string]: any;
}
const { variant = 'primary', size = 'md', href, type = 'button', class: cls, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
---
<Tag
  class:list={['btn', `btn--${variant}`, `btn--${size}`, cls]}
  href={href}
  type={href ? undefined : type}
  {...rest}
>
  <slot />{variant === 'link' && <span class="btn__chev" aria-hidden="true">›</span>}
</Tag>

<style>
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: var(--space-2);
    font-family: var(--font-body); font-weight: 600; letter-spacing: 0.01em;
    border-radius: var(--radius-md); cursor: pointer; text-align: center;
    text-decoration: none; white-space: nowrap; min-height: var(--tap-min);
    transition: background var(--duration-fast) var(--ease-out-expo),
                border-color var(--duration-fast) var(--ease-out-expo),
                color var(--duration-fast), box-shadow var(--duration-base), transform var(--duration-fast);
  }
  .btn--md { padding: 10px 22px; font-size: var(--text-sm); }
  .btn--lg { padding: 14px 28px; font-size: var(--text-base); }
  .btn:active { transform: scale(0.97); }
  /* Nunca más ancho que su sitio: en teléfonos estrechos el texto largo pasa a dos líneas
     en vez de cortarse ("Pide una propuesta combina…" a 320, barrido 2026-11-07). */
  .btn { max-width: 100%; }
  @media (max-width: 419.98px) { .btn { white-space: normal; text-wrap: balance; line-height: 1.25; } }

  .btn--primary { background: var(--accent-gold); color: var(--fg-inverse); }
  .btn--primary:hover { background: color-mix(in srgb, var(--accent-gold), white 10%); box-shadow: var(--shadow-gold); }

  .btn--secondary { background: transparent; color: var(--fg-primary); border: 1px solid var(--border-accent); }
  .btn--secondary:hover { border-color: var(--accent-gold); color: var(--accent-gold); }

  .btn--teal { background: var(--accent-teal); color: var(--fg-inverse); }
  .btn--teal:hover { background: color-mix(in srgb, var(--accent-teal), white 10%); box-shadow: var(--shadow-teal); }

  .btn--ghost { background: transparent; color: var(--fg-secondary); padding-inline: var(--space-2); }
  .btn--ghost:hover { color: var(--accent-gold); }

  /* Enlace con chevron (G7). Después de .btn--md/.btn--lg: con la misma
     especificidad gana por orden y el relleno queda en 8px 0. Sin subrayado (E-22).
     El chevron usa el acento de la página (--w-accent, oro por defecto). */
  .btn--link {
    gap: 8px; padding: 8px 0; min-height: var(--tap-min);
    font: 500 16px/1 var(--font-body); letter-spacing: 0;
    color: var(--w-ink, var(--fg-primary)); background: none; border: 0;
    transition: color var(--w-dur-micro, 150ms) var(--w-ease-ui, ease);
  }
  .btn__chev {
    font-size: 18px; line-height: 1; color: var(--w-accent, var(--accent-gold));
    transition: transform var(--w-dur-hover, 200ms) var(--w-ease-ui, ease);
  }
  @media (--hover-fine) {
    .btn--link:hover { color: var(--w-accent, var(--accent-gold)); }
    .btn--link:hover .btn__chev { transform: translateX(3px); }
  }
  .btn--link:focus-visible { color: var(--w-accent, var(--accent-gold)); }
  .btn--link:focus-visible .btn__chev { transform: translateX(3px); }

  /* Estado deshabilitado (feedback de carga "Enviando…") — cubre todas las variantes */
  .btn:disabled { opacity: .55; cursor: not-allowed; pointer-events: none; box-shadow: none; }
  .btn:disabled:hover { transform: none; }

  /* Estado completado: el botón se convierte en el acuse de recibo. Teal limpio
     (borde de un píxel por sombra interior, sin halo difuso) y a plena opacidad,
     porque sigue deshabilitado pero ya no es un estado "apagado". La pila de
     rótulos y el trazo del check los aporta BtnStates. Va al final del bloque
     para ganarle a las variantes por orden de fuente. */
  .btn[data-state='done'],
  .btn[data-state='done']:disabled {
    background: var(--accent-teal-dim); color: var(--accent-teal);
    box-shadow: inset 0 0 0 1px var(--accent-teal-line);
    opacity: 1; cursor: default;
  }

  @media (--motion-reduce) {
    .btn:active { transform: none; }
    .btn--link .btn__chev, .btn--link:hover .btn__chev, .btn--link:focus-visible .btn__chev { transform: none; }
  }
</style>
