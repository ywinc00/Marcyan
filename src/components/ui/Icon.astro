---
// Wrapper de astro-icon. Por defecto marca el icono como DECORATIVO (aria-hidden),
// porque en todo el sitio el texto adyacente ya transmite el significado (WCAG 1.1.1).
// Para un icono con significado propio, pasar `title` y se expone como imagen accesible.
import { Icon as AstroIcon } from 'astro-icon/components';

interface Props {
  name: string;
  title?: string;
  [key: string]: any;
}
const { name, title, ...rest } = Astro.props;
// is:inline: cada icono lleva su propio dibujo. Sin él, astro-icon define el <symbol> solo en el
// PRIMER uso de la página y las demás copias lo referencian; si ese primer uso queda oculto en un
// ancho (menú, versión móvil, lista escondida), todas las copias salían vacías (barrido 2026-11-07:
// X de cerrar del chat, lupas, pines, teléfonos a 2560...).
---
{title
  ? <AstroIcon name={name} title={title} is:inline {...rest} />
  : <AstroIcon name={name} aria-hidden="true" is:inline {...rest} />}
