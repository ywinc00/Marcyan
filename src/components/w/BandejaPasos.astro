---
// Tres pasos en tarjetas dentro de una bandeja (W-ADV-37 · design/rediseno-workos.md §3.5).
// Cabecera centrada: H2 40 + bajada 18/29; 50 px. Bandeja 1200 radio 22 padding 16
// con 3 tarjetas radio 12 hueco 16: franja superior de 46 px ("Paso 01" mono 14 al
// 60 % + línea de 1 px), zona de objeto ~180 px (slots `ui-1..3`, p. ej. MiniPasos),
// título 18/500 y texto 15/24 con padding 32. Aparición por opacidad (revelado F-04).
// Bandeja opaca (--w-s1) y tarjetas de sistema (--w-s2): los objetos de producto
// en claro que van dentro son la luz de la sección (§2.4).
interface Step { label: string; title: string; text: string }
interface Props {
  titleHtml: string;
  lead: string;
  steps: [Step, Step, Step];
  tone?: 'gold' | 'teal';
  id?: string;
  class?: string;
}
const { titleHtml, lead, steps, tone = 'gold', id, class: cls } = Astro.props;
const uis = await Promise.all(
  [1, 2, 3].map(async (n) => (Astro.slots.has(`ui-${n}`) ? await Astro.slots.render(`ui-${n}`) : '')),
);
---
<div class:list={['wd-bp', cls]} id={id} data-w-tone={tone}>
  <header class="wd-bp__head" data-w-reveal>
    <h2 class="wd-bp__h" set:html={titleHtml} />
    <p class="wd-bp__lead">{lead}</p>
  </header>
  <ol class="wd-bp__tray" data-w-reveal>
    {steps.map((s, i) => (
      <li class="wd-bp__card">
        <p class="wd-bp__lab">{s.label}</p>
        <div class="wd-bp__obj" set:html={uis[i]} />
        <div class="wd-bp__txt">
          <h3 class="wd-bp__t">{s.title}</h3>
          <p class="wd-bp__x">{s.text}</p>
        </div>
      </li>
    ))}
  </ol>
</div>

<style>
  .wd-bp { max-width: var(--w-rail-max); margin-inline: auto; }
  .wd-bp__head { text-align: center; max-width: 640px; margin: 0 auto 50px; }
  .wd-bp__h {
    margin: 0; font-family: var(--font-display); font-weight: 500;
    font-size: var(--w-h2); line-height: var(--w-lh-h2); letter-spacing: var(--w-tr-h2); color: var(--w-ink); text-wrap: balance;
  }
  .wd-bp__lead {
    margin: 16px auto 0; max-width: 36rem;
    font-family: var(--font-body); font-size: 18px; line-height: 29px; color: var(--w-ink-80);
  }
  .wd-bp__tray {
    list-style: none; margin: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px;
    padding: 16px; border-radius: var(--w-r-tray);
    background: var(--w-s1); border: 1px solid var(--w-line); box-shadow: var(--w-edge);
  }
  .wd-bp__card {
    display: flex; flex-direction: column; min-width: 0; overflow: hidden;
    border-radius: var(--w-r-obj); background: var(--w-s2); border: 1px solid var(--w-line); box-shadow: var(--w-edge);
  }
  .wd-bp__lab {
    margin: 0; display: flex; align-items: center; height: 46px; padding: 0 16px;
    border-bottom: 1px solid var(--w-line);
    font-family: var(--font-mono); font-weight: 500; font-size: 14px; line-height: 1; color: var(--w-ink-60);
  }
  .wd-bp__obj { display: grid; place-items: center; min-height: 180px; padding: 24px 20px 8px; }
  .wd-bp__obj > :global(*) { width: 100%; max-width: 320px; }
  .wd-bp__txt { padding: 24px 32px 32px; }
  .wd-bp__t {
    margin: 0; font-family: var(--font-display); font-weight: 500;
    font-size: 18px; line-height: 1.3; letter-spacing: -0.01em; color: var(--w-ink);
  }
  .wd-bp__x { margin: 8px 0 0; font-family: var(--font-body); font-size: 15px; line-height: 24px; color: var(--fg-secondary); }
  @media (--lg) {
    .wd-bp__tray { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  /* El revelado global sube 16 px; aquí la aparición es solo por opacidad (W-ADV-37). */
  :global(:root[data-ds="v3"].w-anim) .wd-bp [data-w-reveal] { transform: none; }
</style>
