---
// Chips de veredicto y de memoria (W-ADV-05/06 y W-ADV-23 · design/rediseno-workos.md §3.5).
// Una sola pieza para IA conversacional (§4.12: Respondido · Te lo pasa · Fuera de
// horario) y para el diagnóstico (§4.9: Bien · Mejorable · Falta).
// Píldoras mono 13 radio 999 borde 1 px; estado por VALOR (§2.11, E-14/E-35):
//   ok  → acento de la página, con check   ·   mid → crema, con persona
//   off → gris con borde discontinuo, con aspa (siempre ≥ 4.5:1, E-40)
// · Con `note` en los items: filas de 44 px separadas por 1 px (chip + motivo 13),
//   como la 3.ª columna de W-ADV-05.
// · `memory`: chips etiqueta-valor de W-ADV-23 (etiqueta 13/500 al 60 %, valor
//   15/500), estáticos.
// Sin notas: en fila con salto (también en móvil).
import Icon from '../ui/Icon.astro';

interface Item { label: string; kind?: 'ok' | 'mid' | 'off'; note?: string; value?: string }
interface Props {
  items: Item[];
  memory?: boolean;
  /** dark = sobre noche · light = dentro de un objeto de producto claro (§2.4: el acento solo como relleno). */
  on?: 'dark' | 'light';
  tone?: 'gold' | 'teal';
  /** Icono del estado intermedio. Por defecto la persona (IA: "Te lo pasa"); en el
   *  diagnóstico "Mejorable" no es una persona: allí va un aviso. */
  midIcon?: string;
  /** Etiqueta accesible del grupo (opcional). */
  label?: string;
  id?: string;
  class?: string;
}
const { items, memory = false, on = 'dark', tone = 'teal', midIcon = 'lucide:user-round', label, id, class: cls } = Astro.props;
const ICON: Record<'ok' | 'mid' | 'off', string> = { ok: 'lucide:check', mid: midIcon, off: 'lucide:x' };
const rows = !memory && items.some((i) => i.note);
---
{memory ? (
  <ul class:list={['wd-chips', 'wd-chips--mem', on === 'light' && 'wd-chips--light', cls]} id={id} data-w-tone={tone} aria-label={label}>
    {items.map((it) => (
      <li class="wd-chips__mem"><span class="wd-chips__mk">{it.label}</span><span class="wd-chips__mv">{it.value}</span></li>
    ))}
  </ul>
) : rows ? (
  <ul class:list={['wd-chips', 'wd-chips--rows', on === 'light' && 'wd-chips--light', cls]} id={id} data-w-tone={tone} aria-label={label}>
    {items.map((it) => (
      <li class="wd-chips__row">
        <span class:list={['wd-chips__c', `wd-chips__c--${it.kind ?? 'ok'}`]}><Icon name={ICON[it.kind ?? 'ok']} class="wd-chips__i" />{it.label}</span>
        {it.note && <span class="wd-chips__note">{it.note}</span>}
      </li>
    ))}
  </ul>
) : (
  <ul class:list={['wd-chips', 'wd-chips--wrap', on === 'light' && 'wd-chips--light', cls]} id={id} data-w-tone={tone} aria-label={label}>
    {items.map((it) => (
      <li><span class:list={['wd-chips__c', `wd-chips__c--${it.kind ?? 'ok'}`]}><Icon name={ICON[it.kind ?? 'ok']} class="wd-chips__i" />{it.label}</span></li>
    ))}
  </ul>
)}

<style>
  .wd-chips {
    --wd-acc: var(--w-accent, var(--accent-teal));
    --wd-acc-rgb: var(--w-accent-rgb, var(--accent-teal-rgb));
    list-style: none; margin: 0; padding: 0;
  }
  .wd-chips--wrap { display: flex; flex-wrap: wrap; gap: 8px; }
  .wd-chips__c {
    display: inline-flex; align-items: center; gap: 6px; white-space: nowrap;
    padding: 4px 11px 4px 9px; border-radius: 999px; border: 1px solid transparent;
    font-family: var(--font-mono); font-weight: 500; font-size: 13px; line-height: 1.3;
  }
  .wd-chips__i { width: 13px; height: 13px; flex: none; }
  .wd-chips__c--ok { color: var(--wd-acc); background: rgba(var(--wd-acc-rgb), .12); border-color: rgba(var(--wd-acc-rgb), .34); }
  .wd-chips__c--mid { color: var(--w-ink); background: rgba(var(--star-rgb), .08); border-color: rgba(var(--star-rgb), .2); }
  .wd-chips__c--off { color: var(--w-ink-70); border-style: dashed; border-color: rgba(var(--star-rgb), .28); }

  .wd-chips--rows { display: grid; }
  .wd-chips__row {
    display: flex; align-items: center; gap: 12px; flex-wrap: wrap; min-height: 44px; padding: 6px 0;
    border-bottom: 1px solid var(--w-line);
  }
  .wd-chips__row:last-child { border-bottom: 0; }
  .wd-chips__note { font-family: var(--font-body); font-size: 13px; line-height: 1.4; color: var(--w-ink-70); }

  .wd-chips--mem { display: grid; gap: 8px; max-width: 376px; }
  .wd-chips__mem {
    display: grid; grid-template-columns: 76px minmax(0, 1fr); align-items: center; gap: 12px;
    min-height: 52px; padding: 8px 20px; border-radius: 999px;
    background: var(--w-s2); border: 1px solid var(--w-line); box-shadow: var(--w-edge);
  }
  .wd-chips__mem:first-child { background: var(--w-s3); border-color: var(--w-line-strong); }
  .wd-chips__mk { font-family: var(--font-body); font-weight: 500; font-size: 13px; color: var(--w-ink-60); }
  .wd-chips__mv { font-family: var(--font-body); font-weight: 500; font-size: 15px; color: var(--w-ink); }
  /* Sobre objeto claro: el acento como relleno con tinta encima; el resto en tinta (AA). */
  .wd-chips--light .wd-chips__c--ok { color: var(--w-p-ink); background: var(--wd-acc); border-color: transparent; }
  .wd-chips--light .wd-chips__c--mid { color: var(--w-p-ink); background: rgba(14, 14, 13, .06); border-color: rgba(14, 14, 13, .16); }
  .wd-chips--light .wd-chips__c--off { color: var(--w-p-ink-2); border-color: rgba(14, 14, 13, .3); }
  .wd-chips--light .wd-chips__row { border-color: var(--w-p-line); }
  .wd-chips--light .wd-chips__note { color: var(--w-p-ink-2); }
  .wd-chips--light .wd-chips__mem { background: #fff; border-color: var(--w-p-line); box-shadow: none; }
  .wd-chips--light .wd-chips__mk { color: var(--w-p-ink-2); }
  .wd-chips--light .wd-chips__mv { color: var(--w-p-ink); }
</style>
