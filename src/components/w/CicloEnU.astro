---
// Ciclo en U (W-PROOF-11 · design/rediseno-workos.md §3.5; v2 G08 en design/rediseno-workos-v2.md §3).
// v1 → v2 (FI §4.8 "mucho vacío, nodos pequeños"): panel a ancho de contenedor (lienzo 960×560),
// nodos píldora de 140×64 con icono en círculo y, como el original con su avatar, el actor del
// paso (Marcy con su avatar real cuando el paso es suyo; si no, el número); título 15/500 y texto
// 14 debajo; en el centro, título 36 y subtítulo.
// Línea: UN trazado continuo (1 → 2 recto, curva por la derecha, 3 → 4 recto) que pasa por debajo
// de las píldoras. Se DIBUJA una vez al entrar en vista (stroke-dashoffset del largo real a 0, 1,6 s) y después
// un punto de luz recorre la U en bucle lento (8 s) mientras está a la vista, con la pestaña
// visible y sin la pausa global (<html data-w-pausa>, contrato de fondos/Fondo.astro). Puntas
// de flecha en CSS junto a cada píldora (no se deforman con el lienzo). Solo stroke-dashoffset,
// transform y opacity. Sin JS o con reducir movimiento: línea entera y quieta.
// < 1024: lista vertical con la línea a la izquierda (se dibuja con scaleY y la luz baja con
// translateY). Orden del DOM = orden del ciclo (1 → 4); la U es solo colocación.
import Icon from '../ui/Icon.astro';

interface Node { icon: string; label: string; text?: string }
interface Props {
  nodes: [Node, Node, Node, Node];
  title?: string;
  sub?: string;
  tone?: 'gold' | 'teal';
  id?: string;
  class?: string;
}
const { nodes, title, sub, tone = 'gold', id, class: cls } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
const esMarcy = (n: Node) => /marcy/i.test(n.label);
const D = 'M70 32H770A178 178 0 0 1 770 388H70';
---
<div class:list={['cu', cls]} id={id} data-w-tone={tone} data-cu>
  <div class="cu__panel">
    <div class="cu__lienzo">
      <svg class="cu__svg" viewBox="0 0 960 560" preserveAspectRatio="none" aria-hidden="true">
        <path class="cu__base" d={D} />
        <path class="cu__luz cu__luz--halo" d={D} />
        <path class="cu__luz" d={D} />
      </svg>
      {(title || sub) && (
        <div class="cu__mid">
          {title && <p class="cu__title">{title}</p>}
          {sub && <p class="cu__sub">{sub}</p>}
        </div>
      )}
      <div class="cu__lista">
      <span class="cu__vl" aria-hidden="true"><span class="cu__vluz"></span></span>
      <ol class="cu__nodes">
        {nodes.map((n, i) => (
          <li class:list={['cu__node', `cu__node--${i + 1}`]}>
            <span class="cu__pill">
              <span class="cu__ic"><Icon name={n.icon} width={20} height={20} /></span>
              {esMarcy(n)
                ? <img class="cu__av" src="/assets/bot/marcy-mini.webp" alt="" width="40" height="40" loading="lazy" decoding="async" />
                : <span class="cu__num" aria-hidden="true">{pad(i + 1)}</span>}
              {i > 0 && <span class="cu__flecha" aria-hidden="true"></span>}
            </span>
            <span class="cu__txt">
              <span class="cu__t">{n.label}</span>
              {n.text && <span class="cu__x">{n.text}</span>}
            </span>
          </li>
        ))}
      </ol>
      </div>
    </div>
  </div>
</div>

<script>
  // Dibujo una vez (transición CSS) y luz en bucle de 8 s con la API de animaciones (el largo real
  // del trazo se mide aquí, y así play/pause sigue a la vista, a la pestaña y a la pausa global).
  const mq = matchMedia('(prefers-reduced-motion: reduce)');
  const pausaGlobal = () => document.documentElement.hasAttribute('data-w-pausa');
  for (const el of document.querySelectorAll<HTMLElement>('[data-cu]:not([data-cu-on])')) {
    el.setAttribute('data-cu-on', '');
    if (mq.matches) continue;
    const base = el.querySelector<SVGPathElement>('.cu__base');
    const L = base ? Math.ceil(base.getTotalLength()) : 0;
    if (L) el.style.setProperty('--cu-l', L + 'px');
    el.classList.add('cu-arm');
    const anims: Animation[] = [];
    const vertical = matchMedia('(max-width: 1023.98px)');
    const crear = () => {
      anims.splice(0).forEach((a) => a.cancel());
      if (vertical.matches) {
        const v = el.querySelector<HTMLElement>('.cu__vluz');
        if (v) anims.push(v.animate([{ transform: 'translateY(0)' }, { transform: 'translateY(calc(100% + 60px))' }], { duration: 8000, iterations: Infinity, delay: 1800 }));
      } else {
        el.querySelectorAll<SVGPathElement>('.cu__luz').forEach((p) => {
          const d = p.classList.contains('cu__luz--halo') ? 96 : 64;
          anims.push(p.animate([{ strokeDashoffset: d + 'px' }, { strokeDashoffset: -L + 'px' }], { duration: 8000, iterations: Infinity, delay: 1800 }));
        });
      }
      aplicar();
    };
    let visible = false; let dibujada = false;
    const aplicar = () => {
      const corre = visible && dibujada && !document.hidden && !pausaGlobal();
      anims.forEach((a) => (corre ? a.play() : a.pause()));
    };
    new IntersectionObserver((es) => {
      visible = es[0].isIntersecting;
      if (visible && !dibujada) { dibujada = true; el.classList.add('is-drawn'); crear(); }
      aplicar();
    }, { threshold: 0.35 }).observe(el.querySelector('.cu__lienzo') ?? el);
    document.addEventListener('visibilitychange', aplicar);
    document.addEventListener('w:pausa', aplicar);
    new MutationObserver(aplicar).observe(document.documentElement, { attributes: true, attributeFilter: ['data-w-pausa'] });
    vertical.addEventListener('change', () => { if (dibujada) crear(); });
  }
</script>

<style>
  .cu {
    --cu-acc-rgb: var(--w-accent-rgb, var(--accent-gold-rgb));
    --cu-ln: rgba(var(--cu-acc-rgb), .5);
    --cu-ease: cubic-bezier(.22, 1, .36, 1);
    width: 100%; max-width: 1136px; margin-inline: auto; box-sizing: border-box;
    padding: 16px; border-radius: var(--w-r-tray); background: var(--w-s1); border: 1px solid var(--w-line); box-shadow: var(--w-edge);
  }
  .cu__panel { position: relative; padding: 40px 24px; border-radius: var(--w-r-cell); background: var(--w-s2); border: 1px solid var(--w-line); }
  .cu__lienzo { position: relative; }
  .cu__svg { display: none; }
  .cu__mid { margin-bottom: 36px; }
  .cu__title { margin: 0; font: 500 26px/1.15 var(--font-display); letter-spacing: -0.025em; color: var(--w-ink); text-wrap: balance; }
  .cu__sub { margin: 8px 0 0; font: 400 15px/1.45 var(--font-body); color: var(--w-ink-60); }

  /* ── Píldora 140×64: icono en círculo + actor (avatar de Marcy o número) ── */
  .cu__pill {
    position: relative; z-index: 2; flex: none; box-sizing: border-box; display: inline-flex; align-items: center; justify-content: space-between;
    width: 140px; height: 64px; padding: 0 12px; border-radius: 999px;
    background: var(--w-s3); border: 1px solid var(--w-line-strong); box-shadow: var(--w-edge), 0 10px 24px rgba(0, 0, 0, .3);
  }
  .cu__ic { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; color: var(--w-ink); background: rgba(240, 237, 232, .06); box-shadow: inset 0 0 0 1px rgba(240, 237, 232, .08); }
  .cu__av { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; background: #f0ede8; box-shadow: 0 0 0 2px rgba(var(--cu-acc-rgb), .55); }
  .cu__num { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; font: 500 13px/1 var(--font-mono); letter-spacing: .04em; color: rgb(var(--cu-acc-rgb)); box-shadow: inset 0 0 0 1px rgba(var(--cu-acc-rgb), .35); }
  .cu__txt { display: grid; gap: 6px; }
  .cu__t { font: 500 15px/1.3 var(--font-display); color: var(--w-ink); }
  .cu__x { font: 400 14px/1.6 var(--font-body); color: var(--w-ink-70); max-width: 34ch; }
  .cu__flecha { display: none; }

  /* ── Vertical (< 1024): línea a la izquierda, por el centro de las píldoras ── */
  .cu__nodes { list-style: none; margin: 0; padding: 0; position: relative; display: grid; gap: 32px; }
  .cu__node { position: relative; display: grid; grid-template-columns: 140px minmax(0, 1fr); column-gap: 18px; align-items: start; }
  .cu__node .cu__txt { padding-top: 10px; }
  .cu__vl { position: absolute; z-index: 1; left: 70px; width: 1px; bottom: 32px; overflow: hidden; background: var(--cu-ln); transform-origin: top; }
  .cu__vluz { position: absolute; left: -1px; right: -1px; top: 0; height: 100%; }
  .cu__vluz::before { content: ''; position: absolute; left: 0; right: 0; top: -60px; height: 60px; background: linear-gradient(180deg, transparent, rgba(var(--cu-acc-rgb), 1)); border-radius: 2px; }
  /* La línea vive desde el centro de la píldora 1 hasta el de la 4: lo que sobra bajo la última píldora lo tapa su columna. */
  .cu__node--4::before { content: ''; position: absolute; z-index: 1; left: 0; width: 140px; top: 32px; bottom: -40px; background: var(--w-s2); }
  .cu__lista { position: relative; }
  .cu__vl { top: 32px; }

  @media (min-width: 1024px) {
    .cu__panel { padding: 64px 72px; }
    .cu__lienzo { height: 560px; }
    .cu__svg { display: block; position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
    /* Sin vector-effect: con non-scaling-stroke Chrome ignora pathLength en los guiones. */
    .cu__svg path { fill: none; }
    .cu__base { stroke: var(--cu-ln); stroke-width: 1; }
    .cu__luz { stroke: rgba(var(--cu-acc-rgb), 1); stroke-width: 2; stroke-linecap: round; stroke-dasharray: 64px var(--cu-l, 2000px); stroke-dashoffset: 64px; }
    .cu__luz--halo { stroke: rgba(var(--cu-acc-rgb), .22); stroke-width: 7; stroke-dasharray: 96px var(--cu-l, 2000px); stroke-dashoffset: 96px; }
    .cu__vl, .cu__node--4::before { display: none; }
    .cu__nodes, .cu__lista { position: static; display: block; }
    .cu__node { position: absolute; display: flex; flex-direction: column; align-items: flex-start; gap: 20px; width: min(300px, 31%); }
    .cu__node .cu__txt { padding-top: 0; }
    .cu__node--1 { left: 0; top: 0; }
    .cu__node--2 { left: 50%; top: 0; }
    .cu__node--3 { left: 50%; top: 356px; }
    .cu__node--4 { left: 0; top: 356px; }
    .cu__mid { position: absolute; left: 0; top: 212px; width: min(640px, 70%); margin: 0; }
    .cu__title { font-size: 36px; line-height: 1.1; }
    .cu__sub { font-size: 16px; }
    /* Puntas de flecha junto a la píldora a la que llega la línea. */
    .cu__flecha { display: block; position: absolute; top: 50%; width: 10px; height: 10px; margin-top: -6px; border-top: 1.5px solid rgba(var(--cu-acc-rgb), .9); border-right: 1.5px solid rgba(var(--cu-acc-rgb), .9); }
    .cu__node--2 .cu__flecha { left: -20px; transform: rotate(45deg); }
    .cu__node--3 .cu__flecha, .cu__node--4 .cu__flecha { right: -20px; transform: rotate(-135deg); }

    /* Dibujo una vez + luz en bucle (8 s) mientras está a la vista. */
    .cu-arm .cu__base { stroke-dasharray: var(--cu-l) var(--cu-l); stroke-dashoffset: var(--cu-l); transition: stroke-dashoffset 1.6s cubic-bezier(.65, 0, .35, 1); }
    .cu-arm .cu__flecha { opacity: 0; }
    .cu-arm.is-drawn .cu__base { stroke-dashoffset: 0px; }
    .cu-arm.is-drawn .cu__flecha { animation: cu-ap 300ms ease-out forwards; }
    .cu-arm.is-drawn .cu__node--2 .cu__flecha { animation-delay: .5s; }
    .cu-arm.is-drawn .cu__node--3 .cu__flecha { animation-delay: 1.15s; }
    .cu-arm.is-drawn .cu__node--4 .cu__flecha { animation-delay: 1.55s; }
  }
  @keyframes cu-ap { to { opacity: 1; } }

  @media (max-width: 1023.98px) {
    .cu-arm .cu__vl { transform: scaleY(0); }
    .cu-arm.is-drawn .cu__vl { transition: transform 1.6s cubic-bezier(.65, 0, .35, 1); transform: none; }
  }
  @media (--lt-md) {
    .cu { padding: 10px; }
    .cu__panel { padding: 28px 16px; }
    .cu__pill { width: 112px; height: 56px; padding: 0 8px; }
    .cu__ic, .cu__av, .cu__num { width: 36px; height: 36px; }
    .cu__node { grid-template-columns: 112px minmax(0, 1fr); column-gap: 14px; }
    .cu__vl { left: 56px; }
    .cu__node--4::before { width: 112px; top: 28px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cu__luz, .cu__vluz { display: none; }
  }
</style>
