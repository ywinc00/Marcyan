---
// Ciclo en U (W-PROOF-11 · design/rediseno-workos.md §3.5).
// Panel 736×644 radio 8 dentro de una bandeja: 4 nodos píldora ~100×56 en U
// (arriba de izquierda a derecha, curva que baja por la derecha, abajo de derecha
// a izquierda), con icono Lucide y número (sin fotos de personas), unidos por una
// línea de 1 px con puntas. Bajo cada nodo, título 16 y texto 13; en el centro,
// título 30 y subtítulo. Estático. Móvil: vertical con la línea a la izquierda.
// Orden del DOM = orden del ciclo (1 → 4); la U es solo colocación en la rejilla.
// Textos de nodo cortos (≤ 4 líneas de 13 px): la fila de nodos mide 200 px fijos.
import Icon from '../ui/Icon.astro';

interface Node { icon: string; label: string; text?: string }
interface Props {
  nodes: [Node, Node, Node, Node];
  title?: string;
  sub?: string;
  tone?: 'gold' | 'teal';
  id?: string;
  class?: string;
}
const { nodes, title, sub, tone = 'gold', id, class: cls } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---
<div class:list={['wd-u', cls]} id={id} data-w-tone={tone}>
  <div class="wd-u__panel">
    {(title || sub) && (
      <div class="wd-u__mid">
        {title && <p class="wd-u__title">{title}</p>}
        {sub && <p class="wd-u__sub">{sub}</p>}
      </div>
    )}
    <span class="wd-u__curve" aria-hidden="true"></span>
    <ol class="wd-u__nodes">
      {nodes.map((n, i) => (
        <li class:list={['wd-u__node', `wd-u__node--${i + 1}`]}>
          <span class="wd-u__pillrow">
            <span class="wd-u__pill">
              <Icon name={n.icon} class="wd-u__ic" />
              <span class="wd-u__num" aria-hidden="true">{pad(i + 1)}</span>
            </span>
            {(i === 0 || i === 3) && <span class:list={['wd-u__line', i === 3 && 'wd-u__line--back']} aria-hidden="true"></span>}
          </span>
          <span class="wd-u__t">{n.label}</span>
          {n.text && <span class="wd-u__x">{n.text}</span>}
        </li>
      ))}
    </ol>
  </div>
</div>

<style>
  .wd-u {
    --wd-acc: var(--w-accent, var(--accent-gold));
    --wd-acc-rgb: var(--w-accent-rgb, var(--accent-gold-rgb));
    --wd-ln: rgba(var(--wd-acc-rgb), .55);
    width: 100%; max-width: 768px; margin-inline: auto;
    padding: 16px; border-radius: var(--w-r-tray);
    background: var(--w-s1); border: 1px solid var(--w-line); box-shadow: var(--w-edge);
  }
  .wd-u__panel {
    position: relative; padding: 32px 24px; border-radius: var(--w-r-cell);
    background: var(--w-s2); border: 1px solid var(--w-line);
  }
  .wd-u__mid { margin-bottom: 32px; }
  .wd-u__title { margin: 0; font-family: var(--font-display); font-weight: 500; font-size: 24px; line-height: 1.2; letter-spacing: -0.02em; color: var(--w-ink); }
  .wd-u__sub { margin: 6px 0 0; font-family: var(--font-body); font-size: 15px; line-height: 1.4; color: var(--w-ink-60); }
  .wd-u__curve { display: none; }

  /* Móvil: lista vertical con la línea a la izquierda. */
  .wd-u__nodes { list-style: none; margin: 0; padding: 0; display: grid; gap: 28px; position: relative; }
  .wd-u__nodes::before {
    content: ''; position: absolute; left: 50px; top: 28px; bottom: 28px; width: 1px; background: var(--wd-ln);
  }
  .wd-u__node { position: relative; display: grid; grid-template-columns: 100px minmax(0, 1fr); column-gap: 16px; align-items: start; }
  .wd-u__pillrow { grid-row: 1 / span 2; display: flex; align-items: center; }
  .wd-u__pill {
    position: relative; z-index: 1; display: inline-flex; align-items: center; justify-content: center; gap: 10px;
    width: 100px; height: 56px; border-radius: 999px;
    background: var(--w-s3); border: 1px solid var(--w-line-strong); box-shadow: var(--w-edge);
  }
  .wd-u__ic { width: 20px; height: 20px; color: var(--w-ink); }
  .wd-u__num { font-family: var(--font-mono); font-weight: 500; font-size: 12px; color: var(--wd-acc); letter-spacing: .04em; }
  .wd-u__line { display: none; }
  .wd-u__t { padding-top: 6px; font-family: var(--font-display); font-weight: 500; font-size: 16px; line-height: 1.3; color: var(--w-ink); }
  .wd-u__x { margin-top: 6px; font-family: var(--font-body); font-size: 13px; line-height: 1.6; color: var(--w-ink-70); }

  @media (--md) {
    /* Alto fijo de fila de nodos: así la curva cae justo en el centro de la píldora 3. */
    .wd-u { --wd-u-node: 200px; }
    .wd-u__panel { padding: 56px 48px; min-height: 644px; }
    .wd-u__nodes { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: var(--wd-u-node) 1fr var(--wd-u-node); column-gap: 56px; row-gap: 0; min-height: calc(644px - 112px); }
    .wd-u__nodes::before { display: none; }
    .wd-u__node { display: flex; flex-direction: column; align-items: flex-start; height: var(--wd-u-node); }
    .wd-u__pillrow { width: 100%; margin-bottom: 18px; }
    .wd-u__t { padding-top: 0; }
    .wd-u__x { max-width: 30ch; }
    /* La U: 1 → 2 arriba, 3 abajo a la derecha, 4 abajo a la izquierda. */
    .wd-u__node--1 { grid-column: 1; grid-row: 1; }
    .wd-u__node--2 { grid-column: 2; grid-row: 1; }
    .wd-u__node--3 { grid-column: 2; grid-row: 3; }
    .wd-u__node--4 { grid-column: 1; grid-row: 3; }
    /* Tramo recto que sale del nodo hacia el siguiente (punta al final). */
    .wd-u__line {
      display: block; flex: 1; position: relative; height: 1px; margin: 0 -44px 0 12px; background: var(--wd-ln);
    }
    .wd-u__line::after {
      content: ''; position: absolute; right: 0; top: -4px; width: 8px; height: 8px;
      border-top: 1px solid var(--wd-ln); border-right: 1px solid var(--wd-ln); transform: rotate(45deg);
    }
    /* 3 → 4: la línea vive en el nodo 4 y apunta hacia él (a la izquierda). */
    .wd-u__line--back::after { right: auto; left: 0; transform: rotate(-135deg); }
    .wd-u__mid {
      position: absolute; left: 48px; right: 140px; top: 50%; transform: translateY(-50%); margin: 0;
    }
    .wd-u__title { font-size: 30px; }
    .wd-u__sub { font-size: 16px; }
    /* Curva de la derecha: del nodo 2 baja hasta el nodo 3 (centro de las píldoras). */
    .wd-u__curve {
      display: block; position: absolute;
      top: calc(56px + 28px); bottom: calc(56px + var(--wd-u-node) - 28px);
      left: calc(48px + (100% - 96px - 56px) / 2 + 56px + 100px + 12px); right: 28px;
      border: 1px solid var(--wd-ln); border-left: 0; border-radius: 0 999px 999px 0;
    }
    .wd-u__curve::after {
      content: ''; position: absolute; left: 0; bottom: -4.5px; width: 8px; height: 8px;
      border-top: 1px solid var(--wd-ln); border-right: 1px solid var(--wd-ln); transform: rotate(-135deg);
    }
  }
</style>
