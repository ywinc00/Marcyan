---
// Cuatro razones (W-CONV-27, design/rediseno-workos.md §3.4).
// Rejilla 2×2 de ~470: icono Lucide 20 en cuadro de 32 (radio 6 → token 8),
// título 16/500 y texto de hasta 3 líneas a 16. Sin tarjetas: el ritmo lo dan
// las líneas de 1 px entre filas (E-04). Móvil: 1 columna.
import Icon from '../ui/Icon.astro';

interface Item { icon: string; title: string; text: string }
interface Props {
  titleHtml?: string;
  items: [Item, Item, Item, Item];
  tone?: 'gold' | 'teal';
  id?: string;
  class?: string;
}
const { titleHtml, items, tone = 'gold', id, class: cls } = Astro.props;
---
<div class:list={['why4', cls]} id={id} data-w-tone={tone}>
  {titleHtml && <h2 class="why4__title" set:html={titleHtml} />}
  <ul class="why4__grid">
    {items.map((it) => (
      <li class="why4__item">
        <span class="why4__ic"><Icon name={it.icon} /></span>
        <div>
          <h3 class="why4__h">{it.title}</h3>
          <p class="why4__text">{it.text}</p>
        </div>
      </li>
    ))}
  </ul>
</div>

<style>
  .why4 { max-width: calc(470px * 2 + 64px); margin-inline: auto; }
  .why4__title {
    margin: 0 0 48px; font-family: var(--font-display); font-weight: var(--w-weight-head);
    font-size: var(--w-h2); line-height: var(--w-lh-h2); letter-spacing: var(--w-tr-h2);
    color: var(--w-ink); text-wrap: balance; max-width: 18ch;
  }
  .why4__title :global(em) { font-style: normal; color: var(--w-accent); }
  .why4__grid {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: 1fr; column-gap: 64px;
  }
  .why4__item {
    display: grid; grid-template-columns: 32px minmax(0, 1fr); gap: 16px; align-items: start;
    padding-block: 24px; border-top: 1px solid var(--w-line); min-width: 0;
  }
  .why4__ic {
    display: grid; place-items: center; inline-size: 32px; block-size: 32px;
    border-radius: var(--w-r-cell); background: var(--w-s2); border: 1px solid var(--w-line);
    box-shadow: var(--w-edge); color: var(--w-accent);
  }
  .why4__ic :global(svg) { width: 20px; height: 20px; }
  .why4__h {
    margin: 4px 0 0; font-family: var(--font-display); font-weight: 500;
    font-size: 16px; line-height: 1.35; color: var(--w-ink);
  }
  .why4__text { margin: 6px 0 0; font-family: var(--font-body); font-size: 16px; line-height: 1.6; color: var(--fg-secondary); }
  @media (--md) { .why4__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
