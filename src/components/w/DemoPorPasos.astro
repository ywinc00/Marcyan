---
// Demo por pasos con panel pegajoso (W-CORE-05 + F-05 · design/rediseno-workos.md §3.5).
// Izquierda (~520): H2 32/40, párrafo 16/26 y los pasos como filas legibles 16/26
// con número mono; la columna mide ≥ 680 px para que el pegajoso tenga recorrido.
// Derecha: bloque de 544 px pegajoso (top: nav + 24) con una pantalla radio 20 en
// marco --w-s2 y fondo claro (slot `screen`, normalmente <WebEjemplo frame="tarjeta">) y, encima
// a su izquierda, la lista de pasos en mono 13 oro (no un terminal de código).
// Al entrar en vista (UNA vez, ~3 s): los pasos se escriben uno a uno con brillo
// de 0,9 s en el activo, la pantalla pasa de esqueleto a la web terminada y la
// leyenda pasa del spinner a "✓ Web publicada".
// Estado final por defecto (sin JS o con reducir movimiento): web terminada y
// pasos marcados. El script solo "arma" el estado inicial si hay movimiento y la
// demo aún no está en pantalla. Móvil: texto arriba, demo debajo, sin pegajoso.
interface Props {
  titleHtml: string;
  text: string;
  steps: string[];
  /** Leyenda final, p. ej. "Web publicada" (el check lo pinta el componente). */
  done: string;
  /** Leyenda mientras corre, p. ej. "Publicando tu web". */
  working?: string;
  tone?: 'gold' | 'teal';
  lang?: 'es' | 'en';
  id?: string;
  class?: string;
}
const { titleHtml, text, steps, done, tone = 'gold', lang = 'es', id, class: cls } = Astro.props;
const en = lang === 'en';
const working = Astro.props.working ?? (en ? 'Building your website' : 'Construyendo tu web');
const pad = (n: number) => String(n).padStart(2, '0');
const sr = (en ? 'Example: ' : 'Ejemplo: ') + steps.join(', ') + '. ' + done + '.';
---
<div class:list={['wd-demo', cls]} id={id} data-w-tone={tone} data-wd-demo>
  <div class="wd-demo__copy">
    <h2 class="wd-demo__h" set:html={titleHtml} />
    <p class="wd-demo__p">{text}</p>
    <ol class="wd-demo__rows">
      {steps.map((s, i) => (
        <li class="wd-demo__row"><span class="wd-demo__n" aria-hidden="true">{pad(i + 1)}</span><span>{s}</span></li>
      ))}
    </ol>
  </div>

  <div class="wd-demo__side">
    <div class="wd-demo__stick">
      <p class="sr-only">{sr}</p>
      <div class="wd-demo__stage" aria-hidden="true">
        <div class="wd-demo__screen">
          <div class="wd-demo__screen-in" data-wd-screen><slot name="screen" /></div>
        </div>
        <div class="wd-demo__log">
          <ol class="wd-demo__steps">
            {steps.map((s) => (
              <li class="wd-demo__step is-done" data-wd-step>
                <span class="wd-demo__mark"></span><span class="wd-demo__lbl">{s}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
      <p class="wd-demo__cap" aria-hidden="true">
        <span class="wd-demo__spin"></span>
        <span class="wd-demo__ok">✓</span>
        <span class="wd-demo__cap-w">{working}</span>
        <span class="wd-demo__cap-d">{done}</span>
      </p>
    </div>
  </div>
</div>

<style>
  .wd-demo {
    --wd-acc: var(--w-accent, var(--accent-gold));
    --wd-acc-rgb: var(--w-accent-rgb, var(--accent-gold-rgb));
    display: grid; grid-template-columns: minmax(0, 1fr); gap: 48px;
    max-width: var(--w-rail-max); margin-inline: auto;
  }
  /* ── Texto ── */
  .wd-demo__h {
    margin: 0; font-family: var(--font-display); font-weight: 500;
    font-size: var(--w-h2-small); line-height: 1.25; letter-spacing: -0.03em; color: var(--w-ink);
    text-wrap: balance;
  }
  .wd-demo__p {
    margin: 16px 0 0; max-width: 32.5rem;
    font-family: var(--font-body); font-size: 16px; line-height: 26px; color: var(--fg-secondary);
  }
  .wd-demo__rows { list-style: none; margin: 32px 0 0; padding: 0; max-width: 32.5rem; }
  .wd-demo__row {
    display: grid; grid-template-columns: 40px minmax(0, 1fr); align-items: baseline;
    padding: 18px 0; border-top: 1px solid var(--w-line);
    font-family: var(--font-body); font-size: 16px; line-height: 26px; color: var(--w-ink);
  }
  .wd-demo__row:last-child { border-bottom: 1px solid var(--w-line); }
  .wd-demo__n { font-family: var(--font-mono); font-weight: 500; font-size: 12px; color: var(--wd-acc); letter-spacing: .04em; }

  /* ── Demo ── */
  .wd-demo__stage { position: relative; }
  .wd-demo__screen {
    position: relative; z-index: 1;
    padding: 12px; border-radius: 20px;
    background: var(--w-s2); border: 1px solid var(--w-line); box-shadow: var(--w-edge);
  }
  .wd-demo__screen-in {
    border-radius: var(--w-r-obj); overflow: hidden; min-height: 380px;
    padding: 28px 24px 44px; background: var(--w-p-bg); color: var(--w-p-ink);
  }
  .wd-demo__screen-in > :global(*) { height: 100%; }
  .wd-demo__log {
    position: relative; z-index: 2;
    margin: -28px 0 0 0; width: min(82%, 300px);
    padding: 16px 18px; border-radius: var(--w-r-obj);
    background: var(--w-s-solid); border: 1px solid var(--w-line-strong); box-shadow: var(--w-edge), 0 18px 40px rgba(0, 0, 0, .45);
  }
  .wd-demo__steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .wd-demo__step {
    position: relative; overflow: hidden;
    display: grid; grid-template-columns: 16px minmax(0, 1fr); gap: 10px; align-items: center;
    font-family: var(--font-mono); font-weight: 500; font-size: 13px; line-height: 1.35; color: var(--wd-acc);
  }
  .wd-demo__mark {
    position: relative; width: 12px; height: 12px; border-radius: 3px;
    border: 1px solid rgba(var(--wd-acc-rgb), .7); transform: rotate(45deg) scale(.8);
  }
  .wd-demo__mark::after {
    content: ''; position: absolute; inset: 2px; border-radius: 1px; background: var(--wd-acc);
    opacity: 0; transition: opacity var(--w-dur-hover) var(--w-ease-ui);
  }
  .wd-demo__step.is-done .wd-demo__mark::after { opacity: 1; }
  .wd-demo__lbl { min-width: 0; }
  /* Brillo de 0,9 s en el paso activo: una capa que cruza con transform. */
  .wd-demo__step::after {
    content: ''; position: absolute; inset: 0 auto 0 0; width: 45%;
    background: linear-gradient(90deg, transparent, rgba(var(--star-rgb), .22), transparent);
    transform: translateX(-120%); opacity: 0; pointer-events: none;
  }
  .wd-demo__step.is-active::after { opacity: 1; animation: wd-demo-shine 900ms var(--w-ease-ui) infinite; }
  @keyframes wd-demo-shine { to { transform: translateX(260%); } }

  /* Estado armado (antes de entrar en vista): pasos ocultos, sin marca. */
  .wd-demo.is-armed .wd-demo__step { opacity: 0; transform: translateY(6px); }
  .wd-demo__step { transition: opacity 320ms var(--w-ease-ui), transform 320ms var(--w-ease-ui); }
  .wd-demo.is-armed .wd-demo__step.is-shown { opacity: 1; transform: none; }

  /* Leyenda: spinner → check. */
  .wd-demo__cap {
    margin: 18px 0 0; display: flex; align-items: center; justify-content: center; gap: 8px;
    font-family: var(--font-body); font-size: 14px; line-height: 20px; color: var(--w-ink-70);
  }
  .wd-demo__spin {
    width: 14px; height: 14px; border-radius: 50%;
    border: 2px solid rgba(var(--star-rgb), .18); border-top-color: var(--wd-acc);
    animation: wd-demo-spin 800ms linear infinite;
  }
  @keyframes wd-demo-spin { to { transform: rotate(360deg); } }
  .wd-demo__ok { color: var(--wd-acc); font-weight: 600; }
  .wd-demo__spin, .wd-demo__cap-w { display: none; }
  .wd-demo.is-working .wd-demo__spin, .wd-demo.is-working .wd-demo__cap-w { display: inline-block; }
  .wd-demo.is-working .wd-demo__ok, .wd-demo.is-working .wd-demo__cap-d { display: none; }

  @media (--lg) {
    .wd-demo { grid-template-columns: minmax(0, 520px) 544px; justify-content: space-between; align-items: start; gap: 64px; }
    /* ≥ 680 px de columna para que el bloque pegajoso tenga recorrido. */
    .wd-demo__copy { min-height: 720px; padding-top: 24px; }
    /* La columna derecha se estira al alto de la fila: así el bloque tiene por dónde pegarse. */
    .wd-demo__side { align-self: stretch; }
    .wd-demo__stick { position: sticky; top: calc(var(--nav-h) + 24px); }
    /* Como en W-CORE-05: la lista asoma por la izquierda y solo tapa el margen de la pantalla. */
    .wd-demo__screen { margin-left: 200px; }
    .wd-demo__screen-in { padding-bottom: 28px; }
    .wd-demo__cap { margin-left: 200px; }
    .wd-demo__log { position: absolute; left: 0; top: 132px; margin: 0; width: 236px; }
  }
  @media (--motion-reduce) {
    .wd-demo__step, .wd-demo__mark::after { transition: none; }
    .wd-demo__step.is-active::after, .wd-demo__spin { animation: none; }
  }
</style>

<script>
  // Tiempos medidos en la tira de W-CORE-05 (~3 s en total, una vez).
  const STEP_MS = 560, SHINE_MS = 900;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLElement>('[data-wd-demo]').forEach((el) => {
    const steps = Array.from(el.querySelectorAll<HTMLElement>('[data-wd-step]'));
    const webs = () => Array.from(el.querySelectorAll<HTMLElement>('[data-wd-screen] [data-wo-state]'));
    if (reduced.matches || !('IntersectionObserver' in window) || !steps.length) return;
    const timers: number[] = [];
    const settle = () => {
      timers.forEach((t) => clearTimeout(t));
      el.classList.remove('is-armed', 'is-working');
      steps.forEach((s) => { s.classList.remove('is-active'); s.classList.add('is-done', 'is-shown'); });
      webs().forEach((w) => w.setAttribute('data-wo-state', 'lista'));
    };
    reduced.addEventListener?.('change', (e) => { if (e.matches) settle(); });
    const arm = () => {
      el.classList.add('is-armed', 'is-working');
      steps.forEach((s) => s.classList.remove('is-done', 'is-active', 'is-shown'));
      webs().forEach((w) => w.setAttribute('data-wo-state', 'esqueleto'));
    };
    const play = () => {
      steps.forEach((s, i) => {
        timers.push(window.setTimeout(() => {
          steps[i - 1]?.classList.replace('is-active', 'is-done');
          s.classList.add('is-shown', 'is-active');
        }, i * STEP_MS));
      });
      const last = (steps.length - 1) * STEP_MS;
      // La web se llena a mitad del recorrido y queda terminada con el último paso.
      timers.push(window.setTimeout(() => webs().forEach((w) => w.setAttribute('data-wo-state', 'lista')), Math.round(last * 0.6)));
      timers.push(window.setTimeout(() => {
        steps[steps.length - 1].classList.replace('is-active', 'is-done');
        el.classList.remove('is-working');
      }, last + SHINE_MS));
    };
    let armed = false;
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!armed) {
          armed = true;
          // Si ya está a la vista al cargar, no se esconde nada: queda terminada.
          if (e.isIntersecting && e.intersectionRatio > 0.05) { io.disconnect(); return; }
          arm();
          continue;
        }
        if (e.isIntersecting && e.intersectionRatio >= 0.35) { io.disconnect(); play(); }
      }
    }, { threshold: [0, 0.05, 0.35] });
    io.observe(el.querySelector('.wd-demo__stage') || el);
  });
</script>
