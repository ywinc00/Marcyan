---
// Tarjetas de caso (W-PROOF-13 sin citas, §3.3): antetítulo mono 12; tarjetas
// 582×336, hueco 36, radio 8, FRANJA SUPERIOR de 4 px en el accent del proyecto
// de portfolio.ts (oro o teal; prohibido muestrear colores de las webs, E-47),
// padding 48/48/64: nombre Space Grotesk 24/500 translate="no", UN solo texto 16/26
// (control 2: did y result se repetían y el cuerpo a 20 px aplanaba la jerarquía): el
// `result` que trae la página si lo hay, si no el `did` del portafolio; pie "Ver caso ›".
// Franja superior en el acento de la PÁGINA para todas (E-14: un acento por bloque).
// Captura REAL de la web del proyecto (/Galeria/<slug>-pc-900.webp) al pie de la tarjeta,
// recortada por abajo (control 2 ronda 2: solo texto con mucho aire se leía como
// plantilla). Móvil: sin captura (diseño por sustracción, E-18).
// Cerrojo 5: sale de v3, así que TODO su CSS va aquí (solo variables --w-* y del sitio).
import Button from '../ui/Button.astro';
import { portfolioProjects as PES } from '../../i18n/portfolio';
import { portfolioProjects as PEN } from '../../i18n/portfolio.en';

interface ProjectLike { name: string; cat?: string; slug?: string; accent?: string; did?: string; result?: string; url?: string }
interface Props {
  /** Proyectos (de portfolioProjects o proof.items; se completan por nombre con el portafolio). */
  items: ProjectLike[];
  /** Antetítulo mono ("Más proyectos"). */
  label: string;
  lang?: 'es' | 'en';
  /** Nivel del nombre del cliente. */
  as?: 'h2' | 'h3';
  class?: string;
}
const { items, label, lang = 'es', as: H = 'h3', class: cls } = Astro.props;
const list = lang === 'en' ? PEN : PES;
const portHref = lang === 'en' ? '/en/portfolio' : '/es/portafolio';
const linkLabel = lang === 'en' ? 'See case' : 'Ver caso';
const cards = items.map((it) => {
  const full = list.find((p) => p.name === it.name);
  const p = { ...full, ...it } as ProjectLike;
  return {
    name: p.name,
    accent: p.accent === 'teal' ? 'teal' : 'gold',
    text: it.result ?? p.did ?? full?.did ?? p.result,
    slug: p.slug,
    href: p.slug ? `${portHref}#${p.slug}` : (p.url ?? portHref),
  };
});
---
<div class:list={['w-cases', cls]}>
  <p class="w-cases__label">{label}</p>
  <ul class="w-cases__grid">
    {cards.map((c) => (
      <li class:list={['w-case', `w-case--${c.accent}`]}>
        <H class="w-case__name" translate="no">{c.name}</H>
        {c.text && <p class="w-case__did">{c.text}</p>}
        <div class="w-case__foot">
          <Button variant="link" href={c.href}>{linkLabel}</Button>
        </div>
        {c.slug && (
          <div class="w-case__shot">
            <img
              src={`/Galeria/${c.slug}-pc-900.webp`}
              srcset={[480, 640, 900, 1280].map((w) => `/Galeria/${c.slug}-pc-${w}.webp ${w}w`).join(', ') + `, /Galeria/${c.slug}-pc.webp 1920w`}
              sizes="(min-width: 1024px) 480px, (min-width: 768px) 45vw, calc(100vw - 72px)" width="900" height="506"
              alt={`${c.name}, ${lang === 'en' ? 'desktop view' : 'vista de escritorio'}`}
              loading="lazy" decoding="async"
            />
          </div>
        )}
      </li>
    ))}
  </ul>
</div>

<style>
  .w-cases__label {
    margin: 0 0 24px;
    font-family: var(--font-mono); font-weight: 500; font-size: 12px; line-height: 1.2;
    text-transform: uppercase; letter-spacing: var(--w-tr-micro, 0.1em); color: var(--w-ink-60);
  }
  .w-cases__grid {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: minmax(0, 1fr); gap: 20px;
  }
  .w-case {
    position: relative; display: flex; flex-direction: column;
    padding: 36px 24px 32px;
    background: var(--w-s2); border: 1px solid var(--w-line);
    border-radius: var(--w-r-cell, 8px); box-shadow: var(--w-edge);
    overflow: hidden;
  }
  /* Franja superior de 4 px en el accent del proyecto. */
  .w-case::before {
    content: ''; position: absolute; inset: 0 0 auto 0; height: 4px;
    background: var(--w-accent, var(--accent-gold)); opacity: .85;
  }
  .w-case__name {
    margin: 0;
    font-family: var(--font-display); font-weight: 500; font-size: 24px; line-height: 1.2;
    letter-spacing: -0.02em; color: var(--w-ink);
  }
  .w-case__did {
    margin: 24px 0 0;
    font-family: var(--font-body); font-size: 16px; line-height: 26px; color: var(--w-ink-70);
  }
  .w-case__foot { margin-top: auto; padding-top: 24px; }

  /* v5 (dueño: «en móvil pierde elementos»): la captura al pie también en móvil, igual que en
     escritorio (sale del borde inferior, recortada arriba), a menor altura. */
  .w-case__shot {
    display: block; margin-top: 20px; height: 150px; overflow: hidden;
    border: 1px solid var(--w-line); border-bottom: 0; border-radius: var(--w-r-cell, 8px) var(--w-r-cell, 8px) 0 0;
    background: var(--w-s1);
  }
  .w-case__shot img { display: block; width: 100%; height: auto; }
  /* Móvil compacto (sistema tras el piloto, E-18): mismo contenido, menos aire. */
  @media (--lt-md) {
    .w-cases__grid { gap: 12px; }
    .w-case { padding: 26px 20px 0; }
    .w-case__name { font-size: 22px; }
    .w-case__did { margin-top: 10px; }
    .w-case__foot { padding-top: 12px; }
  }
  @media (--md) {
    .w-cases__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 36px; }
    .w-case { padding: 48px 48px 0; }
    .w-case__foot { padding-top: 20px; }
    /* Captura al pie: sale del borde inferior de la tarjeta, recortada (solo arriba). */
    .w-case__shot {
      display: block; margin-top: 32px; height: 172px; overflow: hidden;
      border: 1px solid var(--w-line); border-bottom: 0; border-radius: var(--w-r-cell, 8px) var(--w-r-cell, 8px) 0 0;
      background: var(--w-s1);
    }
    .w-case__shot img { display: block; width: 100%; height: auto; }
  }
</style>
