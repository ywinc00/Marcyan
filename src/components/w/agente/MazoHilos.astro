---
// Mazo de hilos (W-ADV-22 · design/rediseno-workos-v2.md §2 P05). Pila de 4 conversaciones,
// una por canal que nombra la página y que Marcy contesta (§1.4, §5-14), con las de detrás
// asomando por arriba con su cabecera (como las pestañas de canal del original). Avance
// automático cada 5 s mientras está a la vista: la de delante sale hacia arriba y se apaga en
// 400 ms y la siguiente avanza. Controles: Pausar/Reanudar (PRIMER control, conectado al estado
// global de pausa, §1.5), ‹ · puntos con barra de progreso · ›. Se para con hover o foco.
// Contrato §1.6: las tarjetas son ilustración (aria-hidden + data-nosnippet) con resumen sr-only;
// los controles son botones reales. aria-roledescription="carrusel".
import Ejemplo from '../Ejemplo.astro';

type Canal = 'whatsapp' | 'instagram' | 'web' | 'google';
interface Props {
  lang?: 'es' | 'en';
  canales?: Canal[];
  class?: string;
}
const { lang = 'es', canales = ['whatsapp', 'instagram', 'web', 'google'], class: cls } = Astro.props;
const en = lang === 'en';

const logoMods = import.meta.glob('../marcas/LogoMarca.astro', { eager: true }) as Record<string, { default: any }>;
const LogoMarca = Object.values(logoMods)[0]?.default;

type Msg = { m?: boolean; h: string; t: string };
const HILOS: Record<Canal, { logo?: string; titulo: string; sub: string; msgs: Msg[] }> = en
  ? {
      whatsapp: { logo: 'whatsapp', titulo: 'WhatsApp', sub: 'Your Business', msgs: [
        { h: '9:40 PM', t: 'Hi, are you open on Saturday?' },
        { m: true, h: '9:40 PM', t: 'Hi! Yes, Saturday from 9:00 AM to 2:00 PM. Want me to save you a spot?' },
        { h: '9:41 PM', t: 'Yes, 10:00 AM please.' },
        { m: true, h: '9:41 PM', t: "Done: Saturday at 10:00 AM. You'll get the confirmation here." },
      ] },
      instagram: { logo: 'instagram', titulo: 'Instagram', sub: 'messages', msgs: [
        { h: '7:15 PM', t: 'Do you work in Katy?' },
        { m: true, h: '7:15 PM', t: 'Yes, we go to Katy. Tell me what you need and I’ll pass you to the team.' },
        { h: '7:16 PM', t: 'A leak under the kitchen sink.' },
      ] },
      web: { titulo: 'Your website', sub: 'chat', msgs: [
        { h: '11:02 PM', t: 'Can you send me a quote?' },
        { m: true, h: '11:02 PM', t: 'Sure. Send me a photo of the job and your ZIP code, and the owner will prepare it.' },
      ] },
      google: { logo: 'google', titulo: 'Google', sub: 'your listing', msgs: [
        { h: '8:30 AM', t: 'Are you open today?' },
        { m: true, h: '8:30 AM', t: 'Yes, today from 8:00 AM to 6:00 PM. Want me to book you a visit?' },
      ] },
    }
  : {
      whatsapp: { logo: 'whatsapp', titulo: 'WhatsApp', sub: 'Tu Negocio', msgs: [
        { h: '9:40 p. m.', t: 'Hola, ¿atienden el sábado?' },
        { m: true, h: '9:40 p. m.', t: '¡Hola! Sí, el sábado de 9:00 a. m. a 2:00 p. m. ¿Te aparto un hueco?' },
        { h: '9:41 p. m.', t: 'Sí, a las 10:00 a. m.' },
        { m: true, h: '9:41 p. m.', t: 'Listo: sábado a las 10:00 a. m. Te llega la confirmación por aquí.' },
      ] },
      instagram: { logo: 'instagram', titulo: 'Instagram', sub: 'mensajes', msgs: [
        { h: '7:15 p. m.', t: '¿Hacen trabajos en Katy?' },
        { m: true, h: '7:15 p. m.', t: 'Sí, vamos a Katy. Cuéntame qué necesitas y te paso con el equipo.' },
        { h: '7:16 p. m.', t: 'Una fuga debajo del fregadero.' },
      ] },
      web: { titulo: 'Tu web', sub: 'chat', msgs: [
        { h: '11:02 p. m.', t: '¿Me pueden mandar un presupuesto?' },
        { m: true, h: '11:02 p. m.', t: 'Claro. Mándame una foto del trabajo y tu código postal, y el dueño te lo prepara.' },
      ] },
      google: { logo: 'google', titulo: 'Google', sub: 'tu ficha', msgs: [
        { h: '8:30 a. m.', t: '¿Abren hoy?' },
        { m: true, h: '8:30 a. m.', t: 'Sí, hoy de 8:00 a. m. a 6:00 p. m. ¿Quieres que te reserve una visita?' },
      ] },
    };
const L = en
  ? { cliente: 'Customer', asist: 'Assistant', region: 'Conversations Marcy answers', carrusel: 'carousel', diapo: 'slide', prev: 'Previous conversation', next: 'Next conversation', ir: 'Go to conversation', pausa: 'Pause', pausaL: 'Pause conversations', de: 'of' }
  : { cliente: 'Cliente', asist: 'Asistente', region: 'Conversaciones que contesta Marcy', carrusel: 'carrusel', diapo: 'diapositiva', prev: 'Conversación anterior', next: 'Conversación siguiente', ir: 'Ir a la conversación', pausa: 'Pausar', pausaL: 'Pausar conversaciones', de: 'de' };
const lista = canales.map((c) => ({ c, ...HILOS[c] }));
const sr = en
  ? `Example: Marcy answers your customers on ${lista.map((x) => x.titulo).join(', ')}, books appointments and passes along what matters.`
  : `Ejemplo: Marcy contesta a tus clientes en ${lista.map((x) => x.titulo).join(', ')}, agenda citas y te pasa lo importante.`;
---
<section class:list={['mz', cls]} data-w2-mazo data-lang={lang} aria-roledescription={L.carrusel} aria-label={L.region} data-nosnippet>
  <p class="sr-only">{sr}</p>
  <div class="mz__pila" data-w2-pila>
    {lista.map((x, i) => (
      <div class="mz__carta" data-w2-carta data-pos={i} data-titulo={`${x.titulo} · ${x.sub}, ${i + 1} ${L.de} ${lista.length}`} aria-roledescription={L.diapo} aria-hidden={i === 0 ? 'false' : 'true'}>
        <div class="mz__cab" aria-hidden="true">
          {x.logo && LogoMarca ? <LogoMarca id={x.logo} size={16} tono="color" titulo="" /> : x.c === 'web' ? (
            <svg class="mz__web" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.6 2.6 3.8 5.6 3.8 9s-1.2 6.4-3.8 9c-2.6-2.6-3.8-5.6-3.8-9S9.4 5.6 12 3z" /></svg>
          ) : null}
          <b translate="no">{x.titulo}</b><span>· {x.sub}</span>
        </div>
        <div class="mz__msgs" aria-hidden="true">
          {x.msgs.map((m) => (
            <div class:list={['mz__msg', m.m && 'is-m']}>
              {m.m
                ? <img class="mz__av" src="/assets/bot/marcy-mini.webp" width="26" height="26" alt="" loading="lazy" decoding="async" />
                : <span class="mz__av mz__av--c"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="8.5" r="4.2" /><path d="M3.8 21c.7-4.3 4-7 8.2-7s7.5 2.7 8.2 7z" /></svg></span>}
              <div>
                <p class="mz__who"><b>{m.m ? 'Marcy' : L.cliente}</b>{m.m && <span class="mz__tag">{L.asist}</span>}<span class="mz__h">{m.h}</span></p>
                <p class="mz__t">{m.t}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
  <div class="mz__ctrl">
    <button type="button" class="mz__btn mz__pausa" data-w2-pausa aria-pressed="false" aria-label={L.pausaL}>
      <svg class="mz__ip" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="5" y="4" width="5" height="16" rx="1" /><rect x="14" y="4" width="5" height="16" rx="1" /></svg>
      <svg class="mz__ir" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15a1 1 0 0 0 1.5.86l12-7.5a1 1 0 0 0 0-1.72l-12-7.5A1 1 0 0 0 7 4.5z" /></svg>
      <span data-w2-pausa-t>{L.pausa}</span>
    </button>
    <button type="button" class="mz__btn mz__flecha" data-w2-prev aria-label={L.prev}>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
    </button>
    <div class="mz__puntos">
      {lista.map((x, i) => (
        <button type="button" class:list={['mz__punto', i === 0 && 'is-on']} data-w2-punto aria-label={`${L.ir} ${i + 1}: ${x.titulo}`} aria-current={i === 0 ? 'true' : 'false'}><i><b></b></i></button>
      ))}
    </div>
    <button type="button" class="mz__btn mz__flecha" data-w2-next aria-label={L.next}>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
    </button>
  </div>
  <Ejemplo lang={lang} pos="inline" class="mz__ej" />
  <p class="sr-only" aria-live="polite" data-w2-live></p>
</section>

<script>
  import { montarMazo } from './agente';
  document.querySelectorAll<HTMLElement>('[data-w2-mazo]').forEach((el) => montarMazo(el));
</script>

<style>
  .mz {
    --mz-w: min(300px, 100%);
    --mz-step: 22px;
    position: relative;
    display: flex; flex-direction: column; align-items: center; gap: 22px;
    width: 100%; max-width: 360px; margin-inline: auto;
    font-family: var(--font-body);
  }
  .mz p { margin: 0; }
  .mz__pila {
    position: relative; width: var(--mz-w); height: 300px;
    margin-top: calc(var(--mz-step) * 3);
  }
  .mz__carta {
    position: absolute; inset: 0;
    display: flex; flex-direction: column;
    border-radius: 12px; overflow: hidden;
    background: #FBFAF8; color: #16161a;
    box-shadow: 0 0 0 1px rgba(14, 14, 13, .08), 0 18px 40px -18px rgba(0, 0, 0, .55);
    transform-origin: 50% 0;
    transition: transform 420ms cubic-bezier(.22, 1, .36, 1), opacity 400ms cubic-bezier(.22, 1, .36, 1);
  }
  .mz__carta[data-pos='0'] { z-index: 4; transform: none; }
  .mz__carta[data-pos='1'] { z-index: 3; transform: translateY(calc(var(--mz-step) * -1)) scale(.955); }
  .mz__carta[data-pos='2'] { z-index: 2; transform: translateY(calc(var(--mz-step) * -2)) scale(.91); }
  .mz__carta[data-pos='3'] { z-index: 1; transform: translateY(calc(var(--mz-step) * -3)) scale(.865); }
  .mz__carta[data-pos='1'] .mz__msgs, .mz__carta[data-pos='2'] .mz__msgs, .mz__carta[data-pos='3'] .mz__msgs { opacity: 0; }
  .mz__carta[data-pos='2'] .mz__cab, .mz__carta[data-pos='3'] .mz__cab { opacity: .75; }
  .mz__carta.is-out { z-index: 5 !important; opacity: 0 !important; transform: translateY(-12px) !important; transition-duration: 400ms; }
  /* Sin textos mezclados en el cambio: la que sale apaga su texto en 100 ms y la que entra lo
     enciende cuando la otra ya casi no se ve. */
  .mz__carta.is-out .mz__msgs { opacity: 0; transition-duration: 100ms; transition-delay: 0ms; }
  .mz.is-js .mz__carta[data-pos='0']:not(.is-out) .mz__msgs { transition: opacity 260ms ease 200ms; }

  .mz__cab {
    flex: none; display: flex; align-items: center; gap: 7px;
    height: 36px; padding: 0 14px;
    background: #F3F1EC; border-bottom: 1px solid rgba(14, 14, 13, .07);
    font-size: 13px; color: #5d5a55;
  }
  .mz__cab b { font: 600 13px/1 var(--font-display); color: #16161a; }
  .mz__cab :global(svg) { flex: none; display: block; }
  .mz__web { color: #3c3a36; }
  .mz__msgs { flex: 1; display: flex; flex-direction: column; gap: 12px; padding: 14px 14px 12px; transition: opacity 300ms; overflow: hidden; }
  .mz__msg { display: grid; grid-template-columns: 26px 1fr; gap: 10px; align-items: start; }
  .mz__av { width: 26px; height: 26px; border-radius: 7px; object-fit: cover; background: #e7e3dc; }
  .mz__av--c { display: grid; place-items: end center; overflow: hidden; background: #E4E1DB; color: #A7A29A; }
  .mz__av--c svg { width: 22px; height: 22px; margin-bottom: -3px; }
  .mz__who { display: flex; align-items: baseline; gap: 6px; font-size: 13px; line-height: 1.2; }
  .mz__who b { font-weight: 700; }
  .mz__tag { font: 600 9px/1 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; padding: 2px 4px; border-radius: 3px; background: rgba(14, 14, 13, .07); color: #5d5a55; }
  .mz__h { font-size: 11px; color: #6c6964; }
  .mz__t { margin-top: 3px !important; font-size: 13.5px; line-height: 1.38; color: #24242a; }

  /* Controles (patrón del original: flechas redondas y una píldora de puntos) */
  .mz__ctrl { display: flex; align-items: center; gap: 6px; }
  .mz__btn {
    appearance: none; border: 0; cursor: pointer;
    min-width: 44px; height: 44px; padding: 0;
    display: inline-flex; align-items: center; justify-content: center; gap: 6px;
    background: none; color: var(--w-ink-80, rgba(240, 237, 232, .8));
    border-radius: 999px;
  }
  .mz__flecha::before {
    content: ''; position: absolute; width: 36px; height: 36px; border-radius: 50%;
    background: rgba(240, 237, 232, .07); box-shadow: inset 0 0 0 1px rgba(240, 237, 232, .1);
    transition: background-color 160ms;
  }
  .mz__flecha { position: relative; }
  .mz__flecha svg { position: relative; }
  .mz__flecha:hover::before { background: rgba(240, 237, 232, .14); }
  .mz__pausa {
    height: 36px; margin-block: 4px; padding: 0 12px 0 10px;
    font: 500 12px/1 var(--font-mono); letter-spacing: .04em;
    background: rgba(240, 237, 232, .07); box-shadow: inset 0 0 0 1px rgba(240, 237, 232, .1);
    margin-right: 6px; position: relative;
  }
  .mz__pausa::after { content: ''; position: absolute; inset: -4px 0; }
  .mz__pausa:hover { background: rgba(240, 237, 232, .14); }
  .mz__ir { display: none; }
  .mz__pausa[data-estado='pausa'] .mz__ip { display: none; }
  .mz__pausa[data-estado='pausa'] .mz__ir { display: block; }
  .mz__puntos {
    display: inline-flex; align-items: center; gap: 0; padding: 0 6px; height: 36px;
    border-radius: 999px; background: rgba(240, 237, 232, .07); box-shadow: inset 0 0 0 1px rgba(240, 237, 232, .1);
  }
  .mz__punto { appearance: none; border: 0; background: none; cursor: pointer; width: 24px; height: 36px; padding: 0; display: grid; place-items: center; transition: width 300ms cubic-bezier(.22, 1, .36, 1); }
  .mz__punto i { position: relative; display: block; width: 7px; height: 7px; border-radius: 999px; background: rgba(240, 237, 232, .35); overflow: hidden; transition: width 300ms cubic-bezier(.22, 1, .36, 1); }
  .mz__punto.is-on { width: 40px; }
  .mz__punto.is-on i { width: 26px; background: rgba(240, 237, 232, .25); }
  .mz__punto i b { position: absolute; inset: 0; background: var(--w-ink, #f0ede8); transform: scaleX(1); transform-origin: 0 50%; }
  .mz__punto:not(.is-on) i b { opacity: 0; }
  .mz.is-js .mz__punto.is-on i b { transform: scaleX(0); }
  .mz.is-js:not(.is-playing) .mz__punto.is-on i b { transform: scaleX(0); }
  .mz.is-playing.is-tick .mz__punto.is-on i b { animation: mz-prog 5s linear forwards; }
  @keyframes mz-prog { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  .mz__btn:focus-visible, .mz__punto:focus-visible { outline: 2px solid var(--accent-gold, #c8a96e); outline-offset: 2px; }
  .mz :global(.mz__ej) { margin-top: -8px; }

  @media (prefers-reduced-motion: reduce) {
    .mz__carta { transition: none; }
    .mz.is-playing.is-tick .mz__punto.is-on i b { animation: none; }
  }
  .mz.is-rm .mz__pausa { display: none; }
</style>
