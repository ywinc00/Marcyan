---
// ─────────────────────────────────────────────────────────────
// P09 · Asistente de alta de Marcy con "Repetir" (design/rediseno-workos-v2.md §2 P09).
// Original: W2N-05 de WorkOS (Passport, "Enroll once"), medido en
// w2/ref/nuevo/W2N-05-asistente-alta/ (pantallas_hd.jpg, tira-1440.jpg, hd/medidas.json).
//
// Situación que resuelve: EMPEZAR. Enseña que arrancar con Marcy es corto y guiado.
// Lienzo 528×488 radio 20 (medido en el original; a 390 se encoge y la ventana escala)
// con UN acento (teal → crema sobre --w-s2); ventana clara 356×372 radio 14 con
// 3 semáforos, puntos de paso y "Continuar" teal con tinta (AA).
//
// Secuencia (una vez al entrar en vista al 35 %, otra al reentrar tras ≥ 8 s fuera):
//   0 s Conoce a Marcy · 2,5 s Hola, Tu Negocio · 4,8 s Tus canales (checks cada 250 ms
//   y la lista baja sola) · 8,2 s Lista para contestar · 10,5 s la ventana se recoge en
//   un PANEL WEB de ejemplo ("Ejemplo de configuración contigo"), sin app en la barra de
//   menús ni "Ajustes…" (crítica de veracidad) · 11,2 s píldora "↻ Repetir".
// Estado final (sin JS, reducir movimiento y al terminar): el panel con el interruptor
// "Marcy contesta" encendido; micro-vida: el halo del interruptor y el punto "en línea" laten.
//
// Contrato de objetos de ejemplo (§1.6): la escena es aria-hidden + data-nosnippet con
// resumen sr-only; sin h1-h6, sin tel:/wa.me/data-track. "Repetir" es un botón real.
// Reducir movimiento: panel quieto; "Repetir" despliega los 4 pasos como lista.
// Logos: vía LogoMarca de P06 (src/components/w/marcas/). Si aún no está integrado, la
// carga es opcional (import.meta.glob) y se pinta un glifo genérico, nunca un logo dibujado.
// Cerrojo 5: todo el CSS va aquí y solo lee variables --w-* y tokens.
// ─────────────────────────────────────────────────────────────
import Icon from '../../ui/Icon.astro';

type Lang = 'es' | 'en';
export type CanalAlta = 'whatsapp' | 'web' | 'calendario' | 'correo' | 'llamadas';

interface Props {
  lang?: Lang;
  /** Solo los canales que la página nombra Y que Marcy contesta de verdad (§5-14). */
  canales?: CanalAlta[];
  /** Sufijo de ids por instancia (por defecto aleatorio). */
  uid?: string;
  class?: string;
}

const {
  lang = 'es',
  canales = ['whatsapp', 'web', 'calendario', 'correo', 'llamadas'],
  uid = Math.random().toString(36).slice(2, 8),
  class: cls,
} = Astro.props;

// LogoMarca (P06) opcional: si el archivo existe, se usa; si no, glifo genérico.
const mods = import.meta.glob('../marcas/LogoMarca.astro', { eager: true }) as Record<string, { default: any }>;
const LogoMarca = Object.values(mods)[0]?.default ?? null;

const T = {
  es: {
    ejemplo: 'Ejemplo',
    ejemploPanel: 'Ejemplo de configuración contigo',
    negocio: 'Tu Negocio',
    sr: 'Ejemplo de cómo empiezas con Marcy en cuatro pasos: la conoces, revisas el horario y los idiomas de tu negocio, conectas tus canales y queda lista para contestar. Al final, Marcy contesta en tus canales.',
    atras: 'Atrás', continuar: 'Continuar', empezar: 'Empezar', repetir: 'Repetir',
    s1t: 'Conoce a Marcy', s1d: 'Tu asistente para Tu Negocio. Contesta, agenda y te avisa.',
    s1rows: [
      ['messages-square', 'Contesta sola', 'A cualquier hora'],
      ['layout-grid', 'En tus canales', 'Donde ya te escriben'],
      ['bell-ring', 'Te pasa lo importante', 'Tú decides qué'],
    ],
    s2t: 'Hola, Tu Negocio', s2d: 'Revisa lo que Marcy sabe de tu negocio.',
    s2rows: [['Negocio', 'Tu Negocio'], ['Horario', 'Lun a sáb · 9:00 a. m. a 7:00 p. m.'], ['Idiomas', 'Español e inglés']],
    s3t: 'Tus canales', s3d: 'Marcy se conecta a lo que ya usas.',
    s4t: 'Lista para contestar', s4d: 'Marcy ya atiende a Tu Negocio.',
    s4rows: [['Respuestas automáticas', 'Activadas · Contesta a cualquier hora'], ['Te avisa por correo', 'Activado · Te pasa cada contacto']],
    enLinea: 'Marcy · En línea', tusCanales: 'Tus canales',
    contesta: 'Marcy contesta', contestaD: 'Activado · En todos tus canales',
    horario: 'Horario', idiomas: 'Idiomas',
    listaT: 'Los 4 pasos',
  },
  en: {
    ejemplo: 'Example',
    ejemploPanel: 'Example setup, done with you',
    negocio: 'Your Business',
    sr: 'Example of how you start with Marcy in four steps: you meet her, check your business hours and languages, connect your channels, and she is ready to answer. At the end, Marcy answers on your channels.',
    atras: 'Back', continuar: 'Continue', empezar: 'Get started', repetir: 'Replay',
    s1t: 'Meet Marcy', s1d: 'Your assistant for Your Business. Answers, books and lets you know.',
    s1rows: [
      ['messages-square', 'Answers on her own', 'At any hour'],
      ['layout-grid', 'On your channels', 'Where people already message you'],
      ['bell-ring', 'Flags what matters', 'You decide what'],
    ],
    s2t: 'Hi, Your Business', s2d: 'Check what Marcy knows about your business.',
    s2rows: [['Business', 'Your Business'], ['Hours', 'Mon to Sat · 9:00 AM to 7:00 PM'], ['Languages', 'Spanish and English']],
    s3t: 'Your channels', s3d: 'Marcy plugs into what you already use.',
    s4t: 'Ready to answer', s4d: 'Marcy is now looking after Your Business.',
    s4rows: [['Automatic replies', 'On · Answers at any hour'], ['Email alerts', 'On · Sends you every lead']],
    enLinea: 'Marcy · Online', tusCanales: 'Your channels',
    contesta: 'Marcy answers', contestaD: 'On · Across your channels',
    horario: 'Hours', idiomas: 'Languages',
    listaT: 'The 4 steps',
  },
}[lang];

// Canales: nombre, línea gris, logo de P06 (si es una marca) y glifo genérico.
const CANALES: Record<CanalAlta, { es: [string, string]; en: [string, string]; marca?: string; icono: string; avatar?: boolean }> = {
  whatsapp: { es: ['WhatsApp', 'Contesta tus mensajes'], en: ['WhatsApp', 'Answers your messages'], marca: 'whatsapp', icono: 'message-circle-more' },
  web: { es: ['Chat de tu web', 'Contesta en tu página'], en: ['Your website chat', 'Answers on your site'], icono: 'globe', avatar: true },
  calendario: { es: ['Calendario', 'Agenda las citas'], en: ['Calendar', 'Books appointments'], icono: 'calendar-days' },
  correo: { es: ['Correo', 'Te pasa cada contacto'], en: ['Email', 'Sends you every lead'], icono: 'mail' },
  llamadas: { es: ['Llamadas perdidas', 'Te avisa al momento'], en: ['Missed calls', 'Lets you know right away'], icono: 'phone-missed' },
};
const filas = canales.map((id) => ({ id, ...CANALES[id], txt: CANALES[id][lang] }));
// Alto de la lista: 142 px; baja lo justo para que la última fila quede entera (como el original).
const bajar = Math.max(0, filas.length * 34 + 4 - 142);

const listaId = `w2-alta-lista-${uid}`;
const pasos = [
  [T.s1t, T.s1d],
  [T.s2t, `${T.s2rows[1][0]}: ${T.s2rows[1][1].replace(/\.$/, '')}. ${T.s2rows[2][0]}: ${T.s2rows[2][1]}.`],
  [T.s3t, filas.map((f) => f.txt[0]).join(', ') + '.'],
  [T.s4t, T.s4rows.map((r) => r[0]).join(lang === 'en' ? ' and ' : ' y ') + '.'],
];
const avatar = '/assets/bot/marcy-mini.webp';
---
<div class:list={['alta', cls]} data-w2-alta data-w2-step="5" lang={lang} style={`--alta-bajar:${bajar}px`}>
  <p class="sr-only">{T.sr}</p>
  <div class="alta-lienzo">
    <div class="alta-escena" aria-hidden="true" data-nosnippet>
      <span class="alta-rot">
        <span class="alta-rot-a">{T.ejemplo}</span>
        <span class="alta-rot-b">{T.ejemploPanel}</span>
      </span>

      <div class="alta-pos">
        <!-- Ventana del asistente (4 pantallas) -->
        <div class="alta-win">
          <div class="alta-bar"><i></i><i></i><i></i></div>

          <div class="alta-scr" data-s="1">
            <span class="alta-app"><img src={avatar} alt="" width="48" height="48" loading="lazy" decoding="async" /></span>
            <span class="alta-t">{T.s1t}</span>
            <span class="alta-d">{T.s1d}</span>
            <span class="alta-feat">
              {T.s1rows.map(([ic, a, b]) => (
                <span class="alta-feat-row">
                  <Icon name={`lucide:${ic}`} class="alta-feat-ic" />
                  <span><span class="alta-rt">{a}</span><span class="alta-rd">{b}</span></span>
                </span>
              ))}
            </span>
          </div>

          <div class="alta-scr" data-s="2">
            <span class="alta-ava"><Icon name="lucide:store" /></span>
            <span class="alta-t">{T.s2t}</span>
            <span class="alta-d">{T.s2d}</span>
            <span class="alta-tabla">
              {T.s2rows.map(([k, v]) => (
                <span class="alta-tabla-row"><span class="alta-k">{k}</span><span class="alta-v">{v}</span></span>
              ))}
            </span>
          </div>

          <div class="alta-scr" data-s="3">
            <span class="alta-glifo"><Icon name="lucide:inbox" /></span>
            <span class="alta-t">{T.s3t}</span>
            <span class="alta-d">{T.s3d}</span>
            <span class="alta-lst">
              <span class="alta-lst-in">
                {filas.map((f) => (
                  <span class="alta-row" data-w2-alta-c3>
                    <span class="alta-tile">
                      {f.marca && LogoMarca
                        ? <LogoMarca id={f.marca} size={22} tono="color" baldosa />
                        : f.avatar
                          ? <img src={avatar} alt="" width="22" height="22" loading="lazy" decoding="async" />
                          : <Icon name={`lucide:${f.icono}`} />}
                    </span>
                    <span class="alta-row-tx"><span class="alta-rt">{f.txt[0]}</span><span class="alta-rd">{f.txt[1]}</span></span>
                    <span class="alta-chk"><Icon name="lucide:check" /></span>
                  </span>
                ))}
              </span>
            </span>
          </div>

          <div class="alta-scr" data-s="4">
            <svg class="alta-big" viewBox="0 0 40 40" width="40" height="40"><path d="M9 21.5l7.2 7L31.5 12" pathLength="1" /></svg>
            <span class="alta-t">{T.s4t}</span>
            <span class="alta-d">{T.s4d}</span>
            <span class="alta-caja">
              {T.s4rows.map(([a, b]) => (
                <span class="alta-row alta-row--caja" data-w2-alta-c4>
                  <span class="alta-row-tx"><span class="alta-rt">{a}</span><span class="alta-rd">{b}</span></span>
                  <span class="alta-chk"><Icon name="lucide:check" /></span>
                </span>
              ))}
            </span>
          </div>

          <div class="alta-foot">
            <span class="alta-back">{T.atras}</span>
            <span class="alta-dots"><i></i><i></i><i></i><i></i><b></b></span>
            <span class="alta-btn alta-btn-a">{T.continuar}</span>
            <span class="alta-btn alta-btn-b">{T.empezar}</span>
          </div>
        </div>

        <!-- Panel web de ejemplo (estado final) -->
        <div class="alta-panel">
          <span class="alta-p-head">
            <span class="alta-p-ava"><img src={avatar} alt="" width="38" height="38" loading="lazy" decoding="async" /></span>
            <span>
              <span class="alta-p-name">{T.negocio}</span>
              <span class="alta-p-on"><i class="alta-p-dot"></i>{T.enLinea}</span>
            </span>
          </span>
          <span class="alta-p-sec">
            <span class="alta-p-lab">{T.tusCanales}</span>
            <span class="alta-p-tiles">
              {filas.map((f) => (
                <span class="alta-tile alta-tile--p">
                  {f.marca && LogoMarca
                    ? <LogoMarca id={f.marca} size={30} tono="color" baldosa />
                    : f.avatar
                      ? <img src={avatar} alt="" width="30" height="30" loading="lazy" decoding="async" />
                      : <Icon name={`lucide:${f.icono}`} />}
                </span>
              ))}
            </span>
          </span>
          <span class="alta-p-sec alta-p-sw">
            <span><span class="alta-rt">{T.contesta}</span><span class="alta-rd">{T.contestaD}</span></span>
            <span class="alta-sw"><i class="alta-sw-halo"></i><i class="alta-sw-knob"></i></span>
          </span>
          <span class="alta-p-sec alta-p-sw">
            <span><span class="alta-rt">{T.s4rows[1][0]}</span><span class="alta-rd">{T.s4rows[1][1]}</span></span>
            <span class="alta-chk alta-chk--on"><Icon name="lucide:check" /></span>
          </span>
          <span class="alta-p-sec alta-p-dl">
            <span class="alta-p-kv"><span class="alta-k">{T.horario}</span><span class="alta-v">{T.s2rows[1][1]}</span></span>
            <span class="alta-p-kv"><span class="alta-k">{T.idiomas}</span><span class="alta-v">{T.s2rows[2][1]}</span></span>
          </span>
        </div>
      </div>
    </div>

    <button class="alta-replay" type="button" data-w2-alta-replay>
      <Icon name="lucide:rotate-ccw" />
      <span>{T.repetir}</span>
    </button>

    <div class="alta-lista" id={listaId} hidden data-w2-alta-lista>
      <p class="alta-lista-t">{T.listaT}</p>
      <ol>
        {pasos.map(([a, b]) => (<li><span class="alta-rt">{a}</span><span class="alta-rd">{b}</span></li>))}
      </ol>
    </div>
  </div>
</div>

<script>
  import { initAltas } from './alta';
  initAltas();
</script>

<style>
  .alta {
    --alta-k: 1;
    --alta-acc: var(--accent-teal, #4fc3a1);
    --alta-acc-ink: color-mix(in oklab, var(--accent-teal, #4fc3a1) 60%, #0e0e0d);
    --alta-ok: #23a55a;
    --alta-paper: var(--w-p-bg, #f0ede8);
    --alta-ink: var(--w-p-ink, #0e0e0d);
    --alta-ink-2: #625e58;
    --alta-ink-3: #77726b;
    --alta-line: var(--w-p-line, rgba(14,14,13,.08));
    --alta-ease: var(--w-ease-text, cubic-bezier(.33,1,.68,1));
    width: 100%;
  }

  /* ── Lienzo ─────────────────────────────────────────── */
  .alta-lienzo {
    position: relative;
    width: 100%; max-width: 528px; min-width: 0; margin-inline: auto;
    height: 404px; /* a 390: ventana escalada (--alta-k) + aire; desde 600 px, el lienzo medido 528×488 */
    border-radius: 20px; overflow: hidden;
    background:
      radial-gradient(90% 60% at 50% 0%, rgba(79,195,161,.20), rgba(79,195,161,0) 70%),
      linear-gradient(180deg, rgba(79,195,161,.24) 0%, rgba(79,195,161,.12) 55%, rgba(240,237,232,.13) 100%),
      var(--w-s2, #181817);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.06);
    container: alta / inline-size;
  }
  @media (min-width: 600px) { .alta-lienzo { height: 488px; } }
  .alta-escena { position: absolute; inset: 0; }

  @container alta (max-width: 383px) { .alta-escena { --alta-k: .92; } }
  @container alta (max-width: 349px) { .alta-escena { --alta-k: .84; } }
  @container alta (max-width: 319px) { .alta-escena { --alta-k: .76; } }
  @container alta (max-width: 289px) { .alta-escena { --alta-k: .7; } }
  @container alta (max-width: 259px) { .alta-escena { --alta-k: .64; } }

  /* Rótulo "Ejemplo" (uno por objeto): se alarga al recogerse la ventana. */
  .alta-rot {
    position: absolute; top: 12px; left: 14px; z-index: 3;
    font-family: var(--font-mono); font-size: 11px; line-height: 14px; font-weight: 500;
    letter-spacing: var(--w-tr-micro, .1em); text-transform: uppercase;
    color: var(--w-ink-80, rgba(240,237,232,.8));
  }
  .alta-rot > span { display: block; transition: opacity 300ms var(--alta-ease), transform 300ms var(--alta-ease); }
  .alta-rot-b { position: absolute; top: 0; left: 0; white-space: nowrap; opacity: 0; transform: translateY(4px); }
  .alta[data-w2-step="5"] .alta-rot-a { opacity: 0; transform: translateY(-4px); }
  .alta[data-w2-step="5"] .alta-rot-b { opacity: 1; transform: none; transition-delay: 150ms; }

  .alta-pos {
    position: absolute; left: 50%; top: 50%;
    width: 356px; height: 372px; margin: -186px 0 0 -178px;
    scale: var(--alta-k);
  }

  /* ── Ventana ────────────────────────────────────────── */
  .alta-win {
    position: absolute; inset: 0;
    border-radius: 14px; overflow: hidden;
    background: var(--alta-paper);
    box-shadow: 0 0 0 .5px rgba(0,0,0,.14), 0 22px 50px -18px rgba(0,0,0,.55);
    color: var(--alta-ink);
    font-family: var(--font-body); -webkit-font-smoothing: antialiased;
    transition: opacity 350ms var(--alta-ease), transform 350ms var(--alta-ease);
  }
  .alta[data-w2-step="5"] .alta-win { opacity: 0; transform: scale(.96); pointer-events: none; }

  .alta-bar { position: absolute; top: 13px; left: 14px; display: flex; gap: 7px; }
  .alta-bar i { width: 11px; height: 11px; border-radius: 50%; background: #d3d0cb; box-shadow: inset 0 0 0 .5px rgba(0,0,0,.12); }
  .alta-bar i:first-child { background: #ee6a5f; }

  .alta-scr {
    position: absolute; inset: 0 0 56px; padding: 30px 28px 0;
    display: flex; flex-direction: column; align-items: center; text-align: center;
    opacity: 0; transform: translateY(8px);
    transition: opacity 280ms var(--alta-ease), transform 280ms var(--alta-ease);
  }
  .alta[data-w2-step="1"] .alta-scr[data-s="1"],
  .alta[data-w2-step="2"] .alta-scr[data-s="2"],
  .alta[data-w2-step="3"] .alta-scr[data-s="3"],
  .alta[data-w2-step="4"] .alta-scr[data-s="4"] {
    opacity: 1; transform: none;
    transition-duration: 380ms; transition-delay: 220ms;
  }

  .alta-t { display: block; font-family: var(--font-display); font-weight: 600; font-size: 19px; line-height: 24px; letter-spacing: -.015em; color: var(--alta-ink); }
  .alta-d { display: block; margin-top: 6px; font-size: 12.5px; line-height: 17px; color: var(--alta-ink-2); max-width: 280px; }
  .alta-rt { display: block; font-size: 12.5px; line-height: 16px; font-weight: 600; color: var(--alta-ink); }
  .alta-rd { display: block; font-size: 11px; line-height: 15px; color: var(--alta-ink-3); }

  /* Pantalla 1 */
  .alta-app {
    width: 48px; height: 48px; margin-bottom: 12px; border-radius: 22.5%;
    overflow: hidden; background: #1b1d1c;
    box-shadow: 0 6px 14px -6px rgba(0,0,0,.45), inset 0 0 0 1px rgba(255,255,255,.08);
  }
  .alta-app img, .alta-p-ava img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .alta-feat { display: grid; gap: 13px; margin-top: 20px; text-align: left; width: 236px; }
  .alta-feat-row { display: grid; grid-template-columns: 20px 1fr; gap: 10px; align-items: start; }
  .alta-feat-row :global(.alta-feat-ic) { width: 18px; height: 18px; margin-top: 1px; color: var(--alta-acc-ink); }

  /* Pantalla 2 */
  .alta-ava {
    display: grid; place-items: center; width: 62px; height: 62px; margin-bottom: 12px; border-radius: 50%;
    background: linear-gradient(180deg, #a9a49d, #7d7871); color: #fff;
    box-shadow: inset 0 0 0 1px rgba(0,0,0,.06);
  }
  .alta-ava :global(svg) { width: 26px; height: 26px; }
  .alta-tabla {
    display: grid; width: 300px; margin-top: 22px; padding: 2px 12px;
    border-radius: 10px; background: rgba(14,14,13,.045); text-align: left;
  }
  .alta-tabla-row { display: flex; justify-content: space-between; gap: 12px; padding: 9px 0; font-size: 12px; line-height: 15px; }
  .alta-tabla-row + .alta-tabla-row { border-top: 1px solid var(--alta-line); }
  .alta-k { color: var(--alta-ink); font-weight: 500; white-space: nowrap; }
  .alta-v { color: var(--alta-ink-2); text-align: right; }

  /* Pantalla 3 */
  .alta-glifo { display: grid; place-items: center; width: 36px; height: 36px; margin-bottom: 8px; color: var(--alta-acc-ink); }
  .alta-glifo :global(svg) { width: 30px; height: 30px; stroke-width: 1.6; }
  .alta-lst {
    position: relative; display: block; width: 300px; height: 142px; margin-top: 12px;
    border-radius: 10px; overflow: hidden; text-align: left;
    background: #fbfaf8; box-shadow: inset 0 0 0 1px var(--alta-line);
  }
  .alta-lst::after {
    content: ''; position: absolute; inset: auto 0 0; height: 26px; pointer-events: none;
    background: linear-gradient(180deg, rgba(251,250,248,0), #fbfaf8);
  }
  .alta-lst-in { display: block; transition: transform 900ms var(--w-ease-loop, cubic-bezier(.645,.045,.355,1)); }
  .alta.is-bajada .alta-lst-in { transform: translateY(calc(var(--alta-bajar) * -1)); }
  .alta-row {
    display: grid; grid-template-columns: 24px 1fr 16px; gap: 10px; align-items: center;
    height: 34px; padding: 0 12px 0 10px;
  }
  .alta-lst .alta-row + .alta-row { border-top: 1px solid var(--alta-line); }
  .alta-row .alta-rt { font-size: 12.5px; line-height: 15px; }
  .alta-row .alta-rd { font-size: 10.5px; line-height: 13px; }
  .alta-tile {
    display: grid; place-items: center; width: 24px; height: 24px; border-radius: 22.5%; overflow: hidden;
    background: #fff; color: var(--alta-ink); box-shadow: inset 0 0 0 1px rgba(0,0,0,.08);
  }
  .alta-tile :global(svg) { width: 14px; height: 14px; }
  /* Glifo genérico (canales que no son una marca): baldosa de app oscura con glifo crema. */
  .alta-tile:has(> svg) {
    background: linear-gradient(180deg, #2f3331, #1b1d1c); color: #f0ede8;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.06), 0 1px 2px rgba(0,0,0,.18);
  }
  .alta-tile img { width: 100%; height: 100%; object-fit: cover; display: block; }
