---
// F08 · Trama de calles (barrios). FO/bocetos/f08-barrios.html; E-41 / E-49.
// HERO: trama ABSTRACTA declarada (no pretende ser un mapa), tenue y sin alfiler: el
// hero de barrios ya dibuja SU mapa (ChipBarrio, con su I-10 y su negocio), y un
// segundo mapa del mismo sitio que no coincide lo contradiría (rev1 I-3). Vida: tres
// destellos que recorren calles de la trama como tráfico (stroke-dashoffset, 11 s),
// lejos de la fila de botones (el núcleo de noche tapa el bloque de texto).
// ECO (capítulo de contraste, quieto): con `barrio`, las VÍAS REALES del barrio, de
// public/geo/<ciudad>-mapa.json (los mismos datos del mapa de zonas de los hubs: r1
// vías principales, r2 secundarias), proyectadas al norte verdadero alrededor del
// centro del barrio, simplificadas en la compilación (Douglas-Peucker) y con la vía
// principal más larga del recorte en oro. Sin `barrio`, la misma trama abstracta.
import type { BarrioFondo } from '../landing/types';
import houston from '../../../../public/geo/houston-mapa.json';
import miami from '../../../../public/geo/miami-mapa.json';

interface Props { estilos?: boolean; eco?: boolean; barrio?: BarrioFondo }
const { estilos = true, eco = false, barrio } = Astro.props;

type Pt = [number, number];
type Linea = Pt[];
const CENTROS: Record<BarrioFondo, { mapa: { r1: Linea[]; r2: Linea[] }; lon: number; lat: number }> = {
  katy: { mapa: houston as never, lon: -95.8245, lat: 29.7858 },
  'sugar-land': { mapa: houston as never, lon: -95.6349, lat: 29.6197 },
  doral: { mapa: miami as never, lon: -80.3553, lat: 25.8195 },
  hialeah: { mapa: miami as never, lon: -80.2781, lat: 25.8576 },
};

// Douglas-Peucker en píxeles.
function dp(p: Pt[], t: number): Pt[] {
  if (p.length < 3) return p;
  const a = p[0], b = p[p.length - 1];
  const dx = b[0] - a[0], dy = b[1] - a[1], L = Math.hypot(dx, dy) || 1;
  let md = 0, mi = 0;
  for (let i = 1; i < p.length - 1; i++) {
    const d = Math.abs(dy * p[i][0] - dx * p[i][1] + b[0] * a[1] - b[1] * a[0]) / L;
    if (d > md) { md = d; mi = i; }
  }
  return md > t ? dp(p.slice(0, mi + 1), t).slice(0, -1).concat(dp(p.slice(mi), t)) : [a, b];
}
const largo = (p: Pt[]) => p.reduce((s, q, i) => (i ? s + Math.hypot(q[0] - p[i - 1][0], q[1] - p[i - 1][1]) : 0), 0);
const dStr = (p: Pt[]) => 'M' + p.map((q) => q.join(' ')).join('L');

let real: { r1: string; r2: string; oro: string } | null = null;
if (barrio && eco) {
  const { mapa, lon, lat } = CENTROS[barrio];
  const K = 3000, kx = K * Math.cos((lat * Math.PI) / 180);
  const recorta = (lineas: Linea[], W: number, H: number, tol: number, min: number) => {
    const segs: { p: Pt[]; L: number; src: number }[] = [];
    lineas.forEach((ln, src) => {
      let seg: Pt[] = [];
      const cierra = () => {
        if (seg.length > 1) { const p = dp(seg, tol); const L = largo(p); if (L >= min) segs.push({ p, L, src }); }
        seg = [];
      };
      for (const [lo, la] of ln) {
        const x = Math.round((lo - lon) * kx), y = Math.round(-(la - lat) * K);
        if (Math.abs(x) > W || Math.abs(y) > H) { cierra(); continue; }
        seg.push([x, y]);
      }
      cierra();
    });
    return segs;
  };
  const r1 = recorta(mapa.r1, 1000, 560, 4, 40);
  const r2 = recorta(mapa.r2, 1000, 560, 4, 30);
  // Vía en oro: la línea principal con más recorrido dentro del recorte.
  const porSrc = new Map<number, number>();
  r1.forEach((s) => porSrc.set(s.src, (porSrc.get(s.src) ?? 0) + s.L));
  const oroSrc = [...porSrc.entries()].sort((a, b) => b[1] - a[1])[0]?.[0];
  real = {
    r1: r1.filter((s) => s.src !== oroSrc).map((s) => dStr(s.p)).join(''),
    r2: r2.map((s) => dStr(s.p)).join(''),
    oro: r1.filter((s) => s.src === oroSrc).map((s) => dStr(s.p)).join(''),
  };
}
// Trama abstracta: rejilla irregular ladeada (cubre hasta 2560 sin acabar en el vacío).
const abstracta = real ? null : {
  v: Array.from({ length: 46 }, (_, i) => `M${i * 62 + ((i * 13) % 20) - 1400} -560L${i * 62 + ((i * 29) % 40) - 1400} 560`),
  h: Array.from({ length: 19 }, (_, i) => `M-1400 ${i * 62 + ((i * 17) % 25) - 560}L1400 ${i * 62 + ((i * 7) % 30) - 560}`),
};
// Destellos de tráfico (solo hero): calles de la trama, en los laterales y abajo.
const trafico = abstracta && !eco ? [abstracta.v[13], abstracta.h[11], abstracta.v[32]] : [];
// Estilos en línea: solo viajan a las páginas que montan este fondo (una vez por página).
const CSS = `
  .wf-ca {
    position: absolute; inset: 0;
    /* Nada bajo la barra de navegación. */
    -webkit-mask-image: linear-gradient(180deg, transparent var(--nav-h, 72px), #000 calc(var(--nav-h, 72px) + 120px));
            mask-image: linear-gradient(180deg, transparent var(--nav-h, 72px), #000 calc(var(--nav-h, 72px) + 120px));
  }
  .wf--eco .wf-ca { -webkit-mask-image: none; mask-image: none; }
  .wf-ca__svg {
    position: absolute; left: 50%; top: 0; width: 2800px; height: 1120px;
    margin-left: -1400px; overflow: visible;
    /* Abierta en el centro (texto y objeto) y viva en los laterales y abajo. */
    -webkit-mask-image: radial-gradient(46% 62% at 50% 38%, transparent 30%, #000 70%);
            mask-image: radial-gradient(46% 62% at 50% 38%, transparent 30%, #000 70%);
  }
  .wf--eco .wf-ca__svg {
    top: 50%; width: 2000px; margin: -560px 0 0 -1000px;
    -webkit-mask-image: radial-gradient(50% 50% at 50% 50%, #000 35%, transparent);
            mask-image: radial-gradient(50% 50% at 50% 50%, #000 35%, transparent);
  }
  .wf-ca path { fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .wf-ca__s { stroke: rgba(var(--wf-s), .065); stroke-width: 1; }
  .wf-ca__a { stroke: rgba(var(--wf-s), .12); stroke-width: 1.4; }
  .wf--eco .wf-ca__s { stroke: rgba(var(--wf-s), .16); }
  .wf--eco .wf-ca__a { stroke: rgba(var(--wf-s), .26); stroke-width: 1.6; }
  .wf-ca__o { stroke: rgba(var(--wf-a), .5); stroke-width: 3; }
  .wf-ca__t {
    stroke: rgba(var(--wf-a), .75); stroke-width: 2; stroke-dasharray: 70 1400; stroke-dashoffset: 1470;
    animation: wf-ca-t 11s linear infinite;
  }
  .wf-ca__t:nth-of-type(2) { animation-delay: -3.7s; }
  .wf-ca__t:nth-of-type(3) { animation-delay: -7.3s; animation-direction: reverse; }
  @keyframes wf-ca-t { to { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) { .wf-ca__t { display: none; } }
  @media (max-width: 767.98px) {
    .wf-ca__svg { transform: scale(.62); transform-origin: 50% 0; }
  }
`;
---
{estilos && <style is:inline set:html={CSS}></style>}
<div class="wf-ca">
  <svg class="wf-ca__svg" viewBox={real ? '-1000 -560 2000 1120' : '-1400 -560 2800 1120'} focusable="false">
    {real && (
      <g>
        <path class="wf-ca__s" d={real.r2} />
        <path class="wf-ca__a" d={real.r1} />
        <path class="wf-ca__o" d={real.oro} />
      </g>
    )}
    {abstracta && (
      <g transform="rotate(-8)">
        {abstracta.v.map((d, i) => <path class={i % 5 === 0 ? 'wf-ca__a' : 'wf-ca__s'} d={d} />)}
        {abstracta.h.map((d, i) => <path class={i % 4 === 0 ? 'wf-ca__a' : 'wf-ca__s'} d={d} />)}
        <g>{trafico.map((d) => <path class="wf-ca__t" d={d} />)}</g>
      </g>
    )}
  </svg>
</div>
