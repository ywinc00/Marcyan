---
// F20 · Fondo de las landings de sector (v3). El tipo `sector` monta UN fondo para todas sus páginas,
// pero cada oficio cuenta su tema con una escena propia y un solo motivo (E-57 (1)):
//   bienes raíces            → F21 atardecer: cielo de noche que se calienta en el horizonte detrás de
//                              la casa, con el haz de líneas que sale por la izquierda (W-CORE-16).
//   contratistas/contractors → F22 obra: el armazón de madera de una casa en alzado, a línea fina.
//   restaurantes (EN)        → F07 plano, sin cambios (fuera del encargo de la v3).
// La escena se elige por la ruta de la página (el KindSpec solo admite un fondo por tipo).
import F21Atardecer from './F21Atardecer.astro';
import F22Obra from './F22Obra.astro';
import F07Plano from './F07Plano.astro';

interface Props { estilos?: boolean; eco?: boolean }
const { estilos = true, eco = false } = Astro.props;
const ruta = Astro.url.pathname.replace(/\/+$/, '');
const ESCENA: Record<string, 'atardecer' | 'obra'> = {
  '/es/houston/bienes-raices': 'atardecer',
  '/es/houston/contratistas': 'obra',
  '/en/houston/contractors': 'obra',
};
const escena = ESCENA[ruta] ?? 'plano';
---
{escena === 'atardecer' && <F21Atardecer estilos={estilos} />}
{escena === 'obra' && <F22Obra estilos={estilos} lang={ruta.startsWith('/en') ? 'en' : 'es'} />}
{escena === 'plano' && <F07Plano estilos={estilos} eco={eco} />}
