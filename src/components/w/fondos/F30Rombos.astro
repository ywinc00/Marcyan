---
// F30 · Malla de rombos (barrios, vuelta 3). Pedido del dueño: «el patrón de malla de rombos,
// bien hecho, sin las rayas: solo el patrón de rombos» (E-57: UN motivo por hero).
// Parte de la rejilla isométrica de F07 (30° y 150°) pero SIN la familia vertical ni las cotas,
// y dibujada como patrón SVG (líneas nítidas a 1 px, sin el dentado de los degradados en
// ángulo). Pieza G-03 del catálogo: patrón técnico desvanecido, con el módulo de un plano de
// parcelas. Quieto: el movimiento del hero lo lleva el chip del barrio y sus vías.
// Lectura: viva en los laterales, tenue (no ausente) detrás del titular y apagada bajo la
// barra de navegación; el fundido a la sección siguiente lo pone Fondo.astro (.wf).
interface Props { estilos?: boolean; eco?: boolean }
const { estilos = true } = Astro.props;
// Módulo: rombo de 96 × 56 (lados a 30°, como el plano isométrico de F07): grande y calmado.
const W = 96, H = 56;
const CSS = `
  .wf-rb {
    position: absolute; inset: 0;
    -webkit-mask-image: linear-gradient(180deg, transparent var(--nav-h, 72px), #000 calc(var(--nav-h, 72px) + 160px));
            mask-image: linear-gradient(180deg, transparent var(--nav-h, 72px), #000 calc(var(--nav-h, 72px) + 160px));
  }
  .wf-rb svg {
    position: absolute; inset: 0; width: 100%; height: 100%;
    /* Hueco suave tras el bloque de texto (no vacío: la malla sigue leyéndose al 30 %). */
    -webkit-mask-image: radial-gradient(48% 46% at 50% 30%, rgba(0,0,0,.28) 40%, #000 100%);
            mask-image: radial-gradient(48% 46% at 50% 30%, rgba(0,0,0,.28) 40%, #000 100%);
  }
  .wf-rb path { fill: none; stroke: rgba(var(--wf-s), .085); stroke-width: 1; vector-effect: non-scaling-stroke; }
  /* Filo de luz en oro arriba a la izquierda, sobre la MISMA malla (no es otro motivo). */
  .wf-rb__oro path { stroke: rgba(var(--wf-a), .16); }
  .wf-rb__oro {
    -webkit-mask-image: radial-gradient(38% 52% at 6% 8%, #000, transparent 100%);
            mask-image: radial-gradient(38% 52% at 6% 8%, #000, transparent 100%);
  }
  @media (max-width: 767.98px) {
    .wf-rb svg {
      -webkit-mask-image: radial-gradient(90% 34% at 50% 26%, rgba(0,0,0,.22) 40%, #000 100%);
              mask-image: radial-gradient(90% 34% at 50% 26%, rgba(0,0,0,.22) 40%, #000 100%);
    }
  }
`;
---
{estilos && <style is:inline set:html={CSS}></style>}
<div class="wf-rb">
  <svg focusable="false">
    <defs>
      <pattern id="wf-rb-p" width={W} height={H} patternUnits="userSpaceOnUse" x="50%">
        <path d={`M0 ${H / 2}L${W / 2} 0L${W} ${H / 2}L${W / 2} ${H}Z`} />
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#wf-rb-p)" />
  </svg>
  <svg class="wf-rb__oro" focusable="false">
    <defs>
      <pattern id="wf-rb-o" width={W} height={H} patternUnits="userSpaceOnUse" x="50%">
        <path d={`M0 ${H / 2}L${W / 2} 0L${W} ${H / 2}L${W / 2} ${H}Z`} />
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#wf-rb-o)" />
  </svg>
</div>
