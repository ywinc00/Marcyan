---
// Hero de las landings de barrio (design/rediseno-workos.md §4.20, ola 2; W-CONV-23/30).
// Centrado: eyebrow oro con el barrio ("Katy, TX"), H1 de hub VERBATIM sin cola (R2),
// bajada 19 px, botón + "Ver precios ›". Debajo, el chip del barrio (ChipBarrio) con las
// vías REALES por las que se reconoce (TIGER/Line, objetos/barrios/<barrio>.svg.ts) y los
// pulsos que llegan al chip: es la firma de la página. Las pistas viven SOLO en la franja
// bajo los botones (nunca detrás del texto, E-37): el chip es un bloque aparte.
// Resplandor oro al 6 % arriba a la izquierda (capa de la sección, sin texto encima de
// ningún detalle).
// v6: el chip del barrio deja la portada; en su lugar, el producto que promete cada barrio y la
// píldora quién → qué → resultado (ver la escena abajo).
import HeroTexto from '../HeroTexto.astro';
import PildoraFlujo from '../objetos/PildoraFlujo.astro';
import FichaMapa from '../objetos/barrios/FichaMapa.astro';
import WebEjemplo from '../objetos/WebEjemplo.astro';
import EscenaBilingue from '../proceso/EscenaBilingue.astro';
import ChatMarcy from '../objetos/ChatMarcy.astro';

interface Cta { label: string; href: string; track?: string }
interface Msg { from: 'c' | 'm'; text: string; time?: string }
interface Props {
  h1Html: string;
  eyebrow: string;
  lead: string;
  primary: Cta;
  link?: Cta;
  name: string;
  /** v6: el producto de la portada (el que promete la bajada) y su píldora quién → qué → resultado. */
  producto: 'ficha' | 'web' | 'bilingue' | 'chat';
  pildora: { quien: string; que: string; resultado: string; icon?: string };
  chat?: Msg[];
  chatSr?: string;
  lang?: 'es' | 'en';
}
const { h1Html, eyebrow, lead, primary, link, name, producto, pildora, chat, chatSr, lang = 'es' } = Astro.props;
---
<section class="w-hero w-hero--bleed hb">
  <div class="w-container hb__text">
    <HeroTexto
      eyebrow={eyebrow}
      tone="gold"
      h1Html={h1Html}
      lead={lead}
      primary={primary}
      link={link}
      size="hub"
    >
      <slot name="crumbs" slot="crumbs" />
    </HeroTexto>
  </div>
  <!-- v6 (dueño, 2026-11-07): cada barrio con su portada. Mecanismo de WorkOS W-EVT-06: la píldora
       quién → qué → resultado encima de la tarjeta del producto, sobre el plano real del barrio (F31). -->
  <div class="w-container hb__escena" data-w-in="obj">
    <PildoraFlujo {...pildora} class="hb__pf" />
    <div class:list={['hb__prod', `hb__prod--${producto}`]}>
      {producto === 'ficha' && <FichaMapa marca="restaurante" lang={lang} city={name} size="hero" />}
      {producto === 'web' && <WebEjemplo marca="plomeria" frame="navegador" vista="completa" city={name} lang={lang} />}
      {producto === 'bilingue' && <EscenaBilingue lang={lang} city={name} />}
      {producto === 'chat' && <ChatMarcy mode="compacto" tabsBar={false} tone="neutral" lang={lang} size="card" tabs={[{ label: name, script: chat ?? [] }]} sr={chatSr} />}
    </div>
  </div>
</section>

<style>
  .hb { position: relative; overflow-x: clip; }
  /* Resplandor oro al 6 % arriba a la izquierda (§4.20). */
  .hb::before {
    content: ''; position: absolute; inset: 0 0 auto 0; height: 720px; pointer-events: none; z-index: 0;
    background: radial-gradient(60% 70% at 8% 0%, rgba(var(--accent-gold-rgb), .06), transparent 70%);
  }
  .hb > * { position: relative; z-index: 1; }
  .hb__escena {
    position: relative; display: flex; flex-direction: column; align-items: center; gap: 18px;
    margin-top: 40px; padding-bottom: 72px;
  }
  .hb__pf { position: relative; z-index: 2; }
  .hb__prod { position: relative; width: min(100%, 440px); }
  .hb__prod--web { width: min(100%, 720px); }
  .hb__prod--bilingue { width: min(100%, 560px); container-type: inline-size; }
  .hb__prod--chat { width: min(100%, 420px); }
  /* sombra de noche bajo el objeto, para que se despegue del plano de calles */
  .hb__prod::after {
    content: ''; position: absolute; left: 8%; right: 8%; bottom: -24px; height: 48px; z-index: -1; pointer-events: none;
    background: radial-gradient(50% 50% at 50% 50%, rgba(0, 0, 0, .7), transparent 70%); filter: blur(6px);
  }
  @media (--lt-md) {
    .hb__escena { margin-top: 32px; gap: 14px; padding-bottom: 56px; }
  }
</style>
