---
// Hero de IA conversacional por ciudad (design/rediseno-workos-v2.md §3 G06, P08).
// W2N-01 (hero de Passport) calzado: "¿Quién contesta a las 11 de la noche?" → "Respondido
// por Marcy". Monta EscenaDosActos (P08, pieza compartida, no se edita aquí) con:
//   · slot "titulo": el H1 VERBATIM de la página, único <h1>, visible al 100 % desde el
//     primer pintado (sin data-w-in ni opacidad: B3, LCP independiente de la coreografía);
//   · slot "bajada": la bajada de hoy; slot "acciones": los botones del sitio (mismos
//     destinos y data-track que la v1).
// Fondo: F04 (hilos de voz, P12) lo monta WLanding detrás de toda la zona del hero; aquí
// solo se aclaran las capas de cielo propias de la escena (noche opaca → transparente;
// el amanecer teal del acto 2 queda como luz baja) para que los hilos se vean a través.
// Migas: arriba a la izquierda en la línea del logo (como HeroTexto en escritorio); en
// móvil, centradas encima de la pregunta del acto 1.
import EscenaDosActos from '../mac/EscenaDosActos.astro';
import Button from '../../ui/Button.astro';

interface Cta { label: string; href: string; track?: string }
interface Props {
  h1Html: string;
  lead: string;
  primary: Cta;
  link?: Cta;
  lang?: 'es' | 'en';
}
const { h1Html, lead, primary, link, lang = 'es' } = Astro.props;
---
<div class="hic" data-w-tone="teal">
  {Astro.slots.has('crumbs') && <div class="hic__crumbs"><slot name="crumbs" /></div>}
  <EscenaDosActos lang={lang} id="dos-actos">
    <h1 slot="titulo" class="hic__h1" set:html={h1Html} />
    <p slot="bajada">{lead}</p>
    <Fragment slot="acciones">
      <Button variant="primary" size="lg" href={primary.href} data-track={primary.track}>{primary.label}</Button>
      {link && <Button variant="secondary" size="lg" href={link.href} data-track={link.track}>{link.label}</Button>}
    </Fragment>
  </EscenaDosActos>
</div>

<style>
  .hic { position: relative; }
  /* El cielo de la escena deja ver el F04 de la zona: la noche pasa a transparente (la
     noche lisa de la página sigue debajo) y el amanecer del acto 2 es solo su luz baja. */
  .hic :global(.da-noche) { background: none; }
  .hic :global(.da-alba) {
    background:
      var(--w-dawn-teal),
      linear-gradient(180deg, transparent 0%, rgba(79,195,161,.035) 45%, rgba(79,195,161,.09) 100%);
  }
  .hic__crumbs {
    position: absolute; z-index: 3; left: 0; right: 0;
    top: calc(var(--nav-h, 72px) + 12px);
    display: flex; justify-content: center; padding-inline: 16px;
  }
  .hic__crumbs :global(ol) { padding-inline-start: 0; margin: 0; }
  /* En móvil las migas ocupan su línea: la escena baja lo justo para no pisar la pregunta. */
  .hic :global(.da) { padding-top: calc(var(--nav-h, 72px) + 56px); }
  @media (min-width: 1024px) {
    .hic__crumbs {
      justify-content: flex-start;
      left: max(0px, calc(50% - var(--container-max) / 2)); padding-inline: var(--container-pad);
    }
    .hic :global(.da) { padding-top: calc(var(--nav-h, 72px) + 48px); }
  }
</style>
