---
// Hero de las landings de SEO local (design/rediseno-workos.md §4.16, ola 2).
// A-05 + W-CORE-16: partido. Izquierda, HeroTexto alineado a la izquierda SIN eyebrow
// (el nombre del producto coincide con el H1, R3): chip de ciudad, H1 verbatim, cola,
// bajada y botones. Derecha, TarjetaObjeto con la ficha de mapa de EJEMPLO dentro
// (W-CORE-16 tal cual: tarjeta clara, capa oro desplazada 25 px, haces recortados a la
// columna de la tarjeta, luz de horizonte, "Llamar" con halo oro de la propia ficha). SIN radar en el hero
// (revisión 1, E-08/E-37): el radar es la firma de la sección 01.
// Coreografía §2.9 (HeroTexto + data-w-in de la tarjeta). Móvil: texto arriba y la
// tarjeta entera debajo (W-CORE-41), sin haces.
import HeroTexto from '../HeroTexto.astro';
import TarjetaObjeto from '../objetos/TarjetaObjeto.astro';
import FichaMapaEjemplo from '../objetos/FichaMapaEjemplo.astro';
import IconoObjeto from '../IconoObjeto.astro';

interface Cta { label: string; href: string; track?: string }
interface Props {
  h1Html: string;
  chip: string;
  tail?: string;
  lead: string;
  primary: Cta;
  link?: Cta;
  cityName: string;
  sr: string;
  lang?: 'es' | 'en';
}
const { h1Html, chip, tail, lead, primary, link, cityName, sr, lang = 'es' } = Astro.props;
---
<section class="w-hero hs">
  <div class="hs__horizon" aria-hidden="true"></div>
  <div class="w-container hs__grid">
    <div class="hs__text">
      <HeroTexto
        tone="gold"
        chip={chip}
        h1Html={h1Html}
        tail={tail}
        lead={lead}
        primary={primary}
        link={link}
        align="left"
      >
        <slot name="crumbs" slot="crumbs" />
      </HeroTexto>
    </div>
    <div class="hs__obj">
      <TarjetaObjeto lang={lang} surface="product" tone="gold" sr={sr} example={false}>
        <IconoObjeto id="seo-local" size={56} slot="icon" />
        <FichaMapaEjemplo lang={lang} city={cityName} size="hero" />
      </TarjetaObjeto>
    </div>
  </div>
</section>

<style>
  /* Recorta en los dos ejes: los haces no pasan del borde del hero (ni asoman sobre la
     sección 01) y la capa desplazada de la tarjeta cabe en el padding superior. */
  .hs { overflow: clip; padding-bottom: 96px; position: relative; }
  /* Luz de horizonte (la del piloto, W-CORE-01/02): franjas oro a ventana completa en la
     base del hero, fundidas en los cuatro bordes. Detrás de la tarjeta (opaca) y por
     debajo de la fila de botones: nunca detrás de texto (E-37). */
  .hs__horizon {
    position: absolute; z-index: 0; left: 0; right: 0; bottom: 0; height: 150px;
    background: var(--w-stripes);
    -webkit-mask-image:
      linear-gradient(180deg, transparent 0%, #000 60%, #000 100%),
      linear-gradient(90deg, transparent 0%, #000 12%, #000 88%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(180deg, transparent 0%, #000 60%, #000 100%),
      linear-gradient(90deg, transparent 0%, #000 12%, #000 88%, transparent 100%);
    mask-composite: intersect;
    pointer-events: none;
  }
  .hs__grid { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 1fr); gap: 56px; align-items: center; }
  .hs__obj { display: flex; justify-content: center; padding: 25px 0 0 25px; }
  /* Haces (W-CORE-16), recortados a la columna de la tarjeta: solo se ve el tramo que
     cruza el hueco entre texto y tarjeta y entra en ella; nunca pasan por detrás de la
     bajada ni de los botones (E-37, revisión 1). El tramo visible se funde por la izquierda. */
  .hs__obj :global(.wo-to__beams) {
    top: 30%;
    clip-path: inset(0 0 0 calc(100% - 140px));
    -webkit-mask-image: linear-gradient(90deg, transparent calc(100% - 140px), #000 calc(100% - 60px));
    mask-image: linear-gradient(90deg, transparent calc(100% - 140px), #000 calc(100% - 60px));
  }
  /* Capa desplazada: más oro y menos losa (en noche, el 40 % sólido se leía marrón). */
  .hs__obj :global(.wo-to__layer) {
    background: linear-gradient(180deg, rgba(var(--accent-gold-rgb), .30), rgba(var(--accent-gold-rgb), .05) 70%);
    border-color: rgba(var(--accent-gold-rgb), .62);
  }
  /* "Llamar" de la ficha de EJEMPLO: oro rebajado hacia crema para que no compita con el
     botón principal del hero (un solo dorado pleno en la primera pantalla). */
  .hs__obj :global(.wo-map__act--main) { background: color-mix(in srgb, var(--accent-gold) 42%, #f6f3ee); }
  @media (--lg) {
    /* W-CORE-16: texto a la izquierda en su columna y la tarjeta de 476 a la derecha.
       La columna de texto se ensancha (560 → 620) para que el H1 entre en una línea. */
    .hs__grid { grid-template-columns: minmax(0, 1fr) 476px; gap: 72px; }
    .hs__text :global(.w-herotext--left) { max-width: 620px; }
    .hs__obj { justify-content: flex-end; padding: 25px 0 0; }
  }
  @media (--lt-md) {
    .hs { padding-bottom: 64px; }
    .hs__horizon { height: 140px; }
    .hs__grid { gap: 48px; }
    .hs__obj { padding-left: 25px; }
  }
</style>
