---
// Sugar Land · portada «pasaporte» (dueño, 2026-11-07; WorkOS /passport: la parte de arriba de un
// portátil entra por abajo de la portada y dentro se abre una ventana). Piezas del sitio: Portatil
// (sin base) + Escritorio (barra de menús, fondo noche con horizonte de planeta) + VentanaApp. Lo
// nuevo es la web de ejemplo de la ventana, propia de esta página (una clínica en First Colony),
// para no repetir el contenido de otras landings. La ventana se abre con escala, opacidad y foco
// (cargando 0,7 s → lista con «Publicada ✓»); con movimiento reducido queda abierta.
import Portatil from '../../mac/Portatil.astro';
import Escritorio from '../../mac/Escritorio.astro';
import VentanaApp from '../../mac/VentanaApp.astro';

interface Props { lang?: 'es' | 'en' }
const { lang = 'es' } = Astro.props;
const T = {
  dominio: 'tuclinica.example',
  marca: 'Tu Clínica Dental',
  zona: 'First Colony · Sugar Land',
  titular: 'Sonrisas cuidadas, sin esperas.',
  bajada: 'Odontología general y estética, en español e inglés.',
  cta: 'Reservar cita',
  servicios: ['Limpieza', 'Blanqueamiento', 'Ortodoncia', 'Urgencias'],
  horario: 'Lun a sáb · 8:00 a. m. a 6:00 p. m.',
  publicada: 'Publicada',
  carga: 'Abriendo tu web',
  sr: 'Ejemplo: la web a medida de una clínica dental de First Colony, en Sugar Land, se abre en la pantalla de un portátil.',
};
---
<div class="pp" data-pp>
  <p class="sr-only">{T.sr}</p>
  <div class="pp__pt" data-nosnippet>
    <Portatil ancho={1040} base={false}>
      <Escritorio lang={lang} dock={false} app="Safari" fase="escritorio">
        <VentanaApp id="clinica" url={`${T.dominio} · Ejemplo`} x={239} y={70} w={900} h={640} z={2} chipTop={60} estado="cargando" on={false} textoCarga={T.carga}>
          <div class="pp-web">
            <div class="pp-web__nav">
              <span class="pp-web__logo"><i></i>{T.marca}</span>
              <span class="pp-web__links"><span>Servicios</span><span>Equipo</span><span>Contacto</span><b>{T.cta}</b></span>
            </div>
            <div class="pp-web__hero">
              <div class="pp-web__txt">
                <span class="pp-web__zona">{T.zona}</span>
                <span class="pp-web__h">{T.titular}</span>
                <span class="pp-web__p">{T.bajada}</span>
                <span class="pp-web__btn">{T.cta}</span>
              </div>
              <span class="pp-web__arte" aria-hidden="true"><i></i><i></i></span>
            </div>
            <div class="pp-web__svc">{T.servicios.map((s) => <span>{s}</span>)}</div>
            <div class="pp-web__pie">{T.horario}</div>
          </div>
          <svg slot="carga" width="40" height="40" viewBox="0 0 40 40"><circle cx="20" cy="20" r="17" fill="#e9efe9" stroke="#2f6b5e" stroke-width="1.4" /><path d="M14 15c0-3 2.6-4 6-4s6 1 6 4c0 4-1.4 6-2 11-.3 2-1.6 2-2 0l-1-5h-2l-1 5c-.4 2-1.7 2-2 0-.6-5-2-7-2-11z" fill="none" stroke="#2f6b5e" stroke-width="1.4" stroke-linejoin="round" /></svg>
          <Fragment slot="chip">{T.publicada}</Fragment>
        </VentanaApp>
      </Escritorio>
    </Portatil>
  </div>
</div>

<script>
  // Abre la ventana cuando la portada está a la vista: escala + opacidad + foco, cargando → lista.
  document.querySelectorAll<HTMLElement>('[data-pp]').forEach((root) => {
    const v = root.querySelector<HTMLElement>('[data-w2-ventana="clinica"]');
    if (!v) return;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const abrir = () => {
      v.dataset.ventOn = 'true';
      if (reduce) { v.dataset.ventEstado = 'lista'; return; }
      window.setTimeout(() => { v.dataset.ventEstado = 'lista'; }, 900);
    };
    if (reduce) { abrir(); return; }
    const io = new IntersectionObserver((es) => {
      if (es.some((e) => e.isIntersecting)) { io.disconnect(); window.setTimeout(abrir, 650); }
    }, { threshold: 0.2 });
    io.observe(root);
  });
</script>

<style>
  .pp { position: relative; width: 100%; display: flex; justify-content: center; }
  .pp__pt { width: min(1040px, 92vw); }
  /* la ventana se abre desde más pequeña y desenfocada (como en Passport) */
  .pp :global([data-w2-ventana="clinica"]) { transition: opacity .7s ease, transform .9s cubic-bezier(.2, .8, .2, 1), filter .9s ease; }
  .pp :global([data-w2-ventana="clinica"][data-vent-on="false"]) { opacity: 0; transform: scale(.9) translateY(24px); filter: blur(10px); }
  @media (prefers-reduced-motion: reduce) { .pp :global([data-w2-ventana="clinica"]) { transition: none; } }

  /* ── la web de ejemplo (px de la pantalla fuente, 1378×895) ── */
  .pp-web { position: absolute; inset: 0; background: #f4f1ea; color: #1d2622; font-family: 'DM Sans', system-ui, sans-serif; display: flex; flex-direction: column; }
  .pp-web__nav { display: flex; justify-content: space-between; align-items: center; padding: 22px 34px; border-bottom: 1px solid #e3ddd1; }
  .pp-web__logo { display: inline-flex; align-items: center; gap: 10px; font: 600 19px 'Space Grotesk', sans-serif; letter-spacing: -.01em; }
  .pp-web__logo i { width: 22px; height: 22px; border-radius: 7px; background: linear-gradient(140deg, #2f6b5e, #6aa797); }
  .pp-web__links { display: inline-flex; gap: 22px; align-items: center; font-size: 15px; color: #4c5a54; }
  .pp-web__links b { background: #2f6b5e; color: #f4f1ea; padding: 9px 16px; border-radius: 999px; font-weight: 600; }
  .pp-web__hero { flex: 1; display: grid; grid-template-columns: 1.1fr .9fr; gap: 28px; padding: 40px 34px 20px; align-items: center; }
  .pp-web__txt { display: flex; flex-direction: column; gap: 14px; }
  .pp-web__zona { font: 500 13px 'JetBrains Mono', monospace; letter-spacing: .14em; text-transform: uppercase; color: #2f6b5e; }
  .pp-web__h { font: 500 50px/1.02 'Space Grotesk', sans-serif; letter-spacing: -.03em; }
  .pp-web__p { font-size: 18px; color: #4c5a54; }
  .pp-web__btn { align-self: flex-start; margin-top: 8px; background: #1d2622; color: #f4f1ea; padding: 13px 22px; border-radius: 999px; font-weight: 600; font-size: 16px; }
  .pp-web__arte { position: relative; height: 300px; border-radius: 22px; overflow: hidden; background: linear-gradient(160deg, #cfe0d8, #9fc2b4 60%, #6aa797); }
  .pp-web__arte i:first-child { position: absolute; left: 18%; top: 22%; width: 64%; height: 64%; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #fbfaf6, #e8efe9 60%, #cfe0d8); box-shadow: 0 30px 60px -20px rgba(29, 38, 34, .35); }
  .pp-web__arte i:last-child { position: absolute; right: -10%; bottom: -30%; width: 70%; height: 70%; border-radius: 50%; background: rgba(47, 107, 94, .25); }
  .pp-web__svc { display: flex; gap: 12px; padding: 0 34px 18px; }
  .pp-web__svc span { border: 1px solid #d9d2c4; border-radius: 999px; padding: 8px 16px; font-size: 14px; color: #34413b; background: #fbf9f4; }
  .pp-web__pie { padding: 14px 34px; border-top: 1px solid #e3ddd1; font: 13px 'JetBrains Mono', monospace; color: #6a756f; }
</style>
