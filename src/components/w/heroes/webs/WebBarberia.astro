---
// Web de ejemplo de SEO local en Miami: barbería sin cita en la Pequeña Habana (v8, 2026-11-08).
// Principio de Refero Titan (56105743, titan.com): titular sans negro y compacto, mucho blanco,
// una pastilla negra como acción y datos en cifras con línea fina debajo. Aquí la cifra es lo que
// el cliente de una barbería sin cita quiere saber: cuánta gente espera ahora mismo.
interface Props { lang?: 'es' | 'en' }
const { lang = 'es' } = Astro.props;
const T = lang === 'en'
  ? { marca: 'Your Barbershop', zona: 'Little Havana · Miami', h: 'Walk in. We’ll take it from there.', cta: 'Get in line', lnk: 'Directions', datos: [['3', 'waiting now'], ['20 min', 'estimated wait'], ['8 PM', 'open until']], pie: ['Cut', 'Beard', 'Kids', 'Line-up'] }
  : { marca: 'Tu Barbería', zona: 'Pequeña Habana · Miami', h: 'Entra sin cita. Del resto nos ocupamos.', cta: 'Ponerme en la fila', lnk: 'Cómo llegar', datos: [['3', 'esperando ahora'], ['20 min', 'de espera'], ['8 p. m.', 'abierto hasta']], pie: ['Corte', 'Barba', 'Niños', 'Perfilado'] };
---
<div class="wb">
  <header class="wb__nav"><span class="wb__marca">{T.marca}</span><span class="wb__menu" aria-hidden="true"><i></i><i></i></span></header>
  <div class="wb__hero">
    <span class="wb__zona">{T.zona}</span>
    <span class="wb__h">{T.h}</span>
    <span class="wb__acc"><b class="wb__cta">{T.cta}</b><span class="wb__lnk">{T.lnk}</span></span>
  </div>
  <div class="wb__datos">{T.datos.map(([n, l], i) => <span class:list={['wb__dato', i === 0 && 'is-vivo']}><b>{n}</b><small>{l}</small></span>)}</div>
  <footer class="wb__pie">{T.pie.map((p) => <span>{p}</span>)}</footer>
</div>

<style>
  .wb { position: absolute; inset: 0; container: wb / inline-size; display: flex; flex-direction: column; background: #fbfaf7; color: #111318; font-family: 'DM Sans', system-ui, sans-serif; }
  .wb__nav { display: flex; align-items: center; justify-content: space-between; padding: 22px 40px; }
  .wb__marca { font-size: 17px; font-weight: 700; letter-spacing: -.02em; }
  .wb__menu { display: grid; gap: 5px; } .wb__menu i { display: block; width: 20px; height: 1.5px; background: #111318; }
  .wb__hero { display: flex; flex-direction: column; gap: 16px; padding: 40px 40px 28px; max-width: 640px; }
  .wb__zona { font-size: 13px; color: #1b2a4a; font-weight: 600; }
  .wb__h { font-size: 52px; line-height: 1; font-weight: 700; letter-spacing: -.045em; }
  .wb__acc { display: flex; align-items: center; gap: 20px; margin-top: 8px; }
  .wb__cta { display: inline-flex; align-items: center; height: 46px; padding: 0 24px; border-radius: 999px; background: #111318; color: #fbfaf7; font-size: 15px; font-weight: 600; }
  .wb__lnk { font-size: 15px; font-weight: 600; } .wb__lnk::after { content: ' →'; }
  .wb__datos { display: grid; grid-template-columns: repeat(3, 1fr); margin: auto 40px 0; border-top: 1px solid #e3e1db; }
  .wb__dato { display: flex; flex-direction: column; gap: 4px; padding: 18px 0; }
  .wb__dato b { font: 600 30px/1 var(--font-mono, ui-monospace, monospace); letter-spacing: -.02em; }
  .wb__dato small { font-size: 13px; color: #6a6d75; }
  .wb__dato.is-vivo b::after { content: ''; display: inline-block; width: 8px; height: 8px; margin-left: 8px; vertical-align: middle; border-radius: 50%; background: #2f9e5b; }
  .wb__pie { display: flex; gap: 22px; padding: 14px 40px 22px; border-top: 1px solid #e3e1db; font-size: 13px; color: #6a6d75; }
  @container wb (max-width: 520px) {
    .wb__nav { padding: 16px 18px; }
    .wb__hero { padding: 22px 18px 18px; gap: 12px; }
    .wb__h { font-size: 40px; }
    .wb__acc { flex-direction: column; align-items: flex-start; gap: 12px; }
    .wb__datos { grid-template-columns: 1fr 1fr; margin: 8px 18px 0; }
    .wb__dato:nth-child(3) { grid-column: 1 / -1; border-top: 1px solid #e3e1db; }
    .wb__dato b { font-size: 26px; }
    .wb__pie { flex-wrap: wrap; gap: 8px 16px; padding: 14px 18px 18px; }
  }
</style>
