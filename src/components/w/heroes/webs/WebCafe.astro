---
// Web de ejemplo de Hialeah: cafetería cubana con ventanita (v8, 2026-11-08).
// Principio de Refero Monte (698567da, montecafe.com.au): UN campo de color terracota a sangre,
// marca serif centrada, rótulos pequeños en mayúsculas en las esquinas (horario y lugar) y un
// dibujo de línea propio en el centro. Nada de bloques de relleno: color, letra y un dibujo.
// Se adapta sola: ancha en una ventana de escritorio, en columna dentro de un teléfono (≤ 520 px).
interface Props { lang?: 'es' | 'en' }
const { lang = 'es' } = Astro.props;
const T = lang === 'en'
  ? { menu: 'Menu', pedir: 'Order', izq: 'Today from 6:00 AM', der: 'Hialeah · Palm Ave', h: ['Cuban coffee,', 'right at the window.'], cta: 'Order on WhatsApp', nota: 'Pastelitos out of the oven at 6:30', carta: ['Cafecito', 'Colada', 'Pastelitos', 'Cuban bread'] }
  : { menu: 'Menú', pedir: 'Pedir', izq: 'Hoy desde las 6:00 a. m.', der: 'Hialeah · Palm Ave', h: ['Café cubano,', 'en la ventanita.'], cta: 'Pedir por WhatsApp', nota: 'Pastelitos recién salidos a las 6:30', carta: ['Cafecito', 'Colada', 'Pastelitos', 'Pan cubano'] };
---
<div class="wf">
  <header class="wf__nav">
    <span class="wf__l">{T.menu}</span>
    <span class="wf__marca">tu café</span>
    <span class="wf__r">{T.pedir}</span>
  </header>
  <div class="wf__campo">
    <span class="wf__esq wf__esq--i">{T.izq}</span>
    <span class="wf__esq wf__esq--d">{T.der}</span>
    <div class="wf__centro">
      <svg class="wf__taza" viewBox="0 0 160 150" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M66 18c-6 8 6 13 0 22M84 12c-7 10 7 16 0 27M101 18c-6 8 6 13 0 22" />
        <path d="M40 62h80l-7 46a20 20 0 0 1-20 17H67a20 20 0 0 1-20-17z" />
        <path d="M120 72h7a13 13 0 0 1 0 26h-11" />
        <path d="M22 134h116" />
        <path d="M60 86c8 6 32 6 40 0" opacity=".55" />
      </svg>
      <span class="wf__h">{T.h[0]}<br />{T.h[1]}</span>
      <span class="wf__acc"><b class="wf__cta">{T.cta}</b><span class="wf__nota">{T.nota}</span></span>
    </div>
  </div>
  <footer class="wf__pie">{T.carta.map((c) => <span>{c}</span>)}</footer>
</div>

<style>
  .wf { position: absolute; inset: 0; container: wf / inline-size; display: flex; flex-direction: column; background: #b4492f; color: #f6ead8; font-family: 'DM Sans', system-ui, sans-serif; }
  .wf__nav { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 22px 36px; }
  .wf__l, .wf__r, .wf__esq { font: 600 12px/1 var(--font-mono, ui-monospace, monospace); letter-spacing: .14em; text-transform: uppercase; }
  .wf__r { justify-self: end; }
  .wf__marca { font: 400 30px/1 Georgia, 'Times New Roman', serif; letter-spacing: -.01em; }
  .wf__campo { position: relative; flex: 1; display: grid; place-items: center; }
  .wf__esq { position: absolute; top: 50%; opacity: .9; }
  .wf__esq--i { left: 36px; } .wf__esq--d { right: 36px; }
  .wf__centro { display: flex; flex-direction: column; align-items: center; gap: 18px; text-align: center; }
  .wf__taza { width: 118px; height: auto; color: #f6ead8; }
  .wf__h { font: 400 46px/1.05 Georgia, 'Times New Roman', serif; letter-spacing: -.02em; }
  .wf__acc { display: flex; flex-direction: column; align-items: center; gap: 12px; margin-top: 4px; }
  .wf__cta { display: inline-flex; align-items: center; height: 46px; padding: 0 24px; border-radius: 999px; background: #f6ead8; color: #7a2a17; font-size: 15px; font-weight: 600; }
  .wf__nota { font-size: 13.5px; opacity: .85; }
  .wf__pie { display: flex; justify-content: center; gap: 28px; padding: 16px 36px 22px; border-top: 1px solid rgba(246, 234, 216, .25); font: 400 16px/1 Georgia, 'Times New Roman', serif; }
  @container wf (max-width: 520px) {
    .wf__nav { padding: 14px 18px; }
    .wf__marca { font-size: 24px; }
    .wf__esq { position: static; display: block; text-align: center; font-size: 11px; }
    .wf__esq--d { display: none; }
    .wf__campo { display: flex; flex-direction: column; justify-content: center; gap: 22px; padding: 0 18px 10px; }
    .wf__taza { width: 96px; }
    .wf__h { font-size: 38px; }
    .wf__pie { flex-wrap: wrap; gap: 10px 18px; padding: 14px 18px 18px; font-size: 15px; }
  }
</style>
