---
// Web de ejemplo de Sugar Land: clínica dental de First Colony (v7, 2026-11-08).
// Minimalista a propósito (dueño: "los ejemplos parecen PowerPoint"). Principios tomados de Refero
// Ease Health (954854b3): lienzo crema, titular serif grande, verde bosque solo en la acción y
// superficies teñidas sin sombras; y Handhold (da999138): aire y una sola acción fuerte.
// En vez de una foto inventada, la columna derecha es UI real del negocio: las horas libres.
// Medidas en px de la ventana fuente (900 × 602 de cuerpo).
---
<div class="wc">
  <header class="wc__nav">
    <span class="wc__marca">Tu Clínica</span>
    <span class="wc__menu" aria-hidden="true"><i></i><i></i></span>
    <nav><span>Tratamientos</span><span>Equipo</span><span>Seguros</span></nav>
    <b class="wc__cta wc__cta--sm">Reservar</b>
  </header>
  <div class="wc__hero">
    <div class="wc__txt">
      <span class="wc__zona">First Colony · Sugar Land</span>
      <span class="wc__h">Una sonrisa sana, sin esperas.</span>
      <span class="wc__p">Odontología general y estética para toda la familia. Te atendemos en español o en inglés.</span>
      <span class="wc__acc"><b class="wc__cta">Reservar cita</b><span class="wc__lnk">Ver tratamientos</span></span>
    </div>
    <div class="wc__panel">
      <span class="wc__pt">Próximas horas libres</span>
      <span class="wc__dias"><i>Lun 9</i><i class="on">Mar 10</i><i>Mié 11</i></span>
      <span class="wc__horas"><i>8:30 a. m.</i><i class="on">10:00 a. m.</i><i>11:30 a. m.</i><i>3:15 p. m.</i></span>
      <b class="wc__conf">Confirmar 10:00 a. m.</b>
    </div>
  </div>
  <footer class="wc__pie"><span>Limpieza</span><span>Blanqueamiento</span><span>Ortodoncia</span><span>Urgencias</span></footer>
</div>

<style>
  .wc { position: absolute; inset: 0; container: wc / inline-size; display: flex; flex-direction: column; background: #f7f4ee; color: #1f2a24; font-family: 'DM Sans', system-ui, sans-serif; }
  .wc__nav { display: flex; align-items: center; gap: 28px; padding: 22px 40px; }
  .wc__marca { font: 400 22px/1 Georgia, 'Times New Roman', serif; letter-spacing: -.01em; }
  .wc__nav nav { display: flex; gap: 24px; margin-left: auto; font-size: 14px; color: #5a655f; }
  .wc__cta { display: inline-flex; align-items: center; height: 44px; padding: 0 22px; border-radius: 999px; background: #1f4a3a; color: #f7f4ee; font-size: 15px; font-weight: 600; }
  .wc__cta--sm { height: 36px; padding: 0 16px; font-size: 13.5px; }
  .wc__hero { flex: 1; display: grid; grid-template-columns: 1.08fr .92fr; gap: 36px; align-items: center; padding: 8px 40px 28px; }
  .wc__txt { display: flex; flex-direction: column; gap: 18px; }
  .wc__zona { font-size: 13px; letter-spacing: .02em; color: #4f7a68; }
  .wc__h { margin: 0; font: 400 54px/1.04 Georgia, 'Times New Roman', serif; letter-spacing: -.025em; color: #18221d; }
  .wc__p { margin: 0; max-width: 380px; font-size: 16px; line-height: 1.55; color: #56615b; }
  .wc__acc { display: flex; align-items: center; gap: 20px; margin-top: 6px; }
  .wc__lnk { font-size: 14.5px; color: #1f4a3a; border-bottom: 1px solid rgba(31, 74, 58, .35); padding-bottom: 2px; }
  .wc__panel { display: flex; flex-direction: column; gap: 16px; padding: 26px; border-radius: 14px; background: #e6ece6; }
  .wc__pt { font-size: 13px; color: #4f5d55; }
  .wc__dias, .wc__horas { display: flex; flex-wrap: wrap; gap: 8px; }
  .wc__dias i, .wc__horas i { font-style: normal; font-size: 14px; padding: 9px 14px; border-radius: 10px; background: #f7f4ee; color: #2c3a33; }
  .wc__dias i.on { background: #1f2a24; color: #f7f4ee; }
  .wc__horas i.on { box-shadow: inset 0 0 0 1.5px #1f4a3a; color: #1f4a3a; font-weight: 600; }
  .wc__conf { margin-top: 4px; text-align: center; padding: 13px; border-radius: 10px; background: #1f4a3a; color: #f7f4ee; font-size: 14.5px; font-weight: 600; }
  .wc__pie { display: flex; gap: 0; padding: 0 40px 24px; font-size: 13px; color: #6b746f; }
  .wc__pie span { padding-right: 16px; margin-right: 16px; border-right: 1px solid #ddd8cd; }
  .wc__pie span:last-child { border: 0; }
  .wc__menu { display: none; }
  /* En un teléfono (la misma web, adaptada): una columna, menú plegado y las horas libres debajo. */
  @container wc (max-width: 520px) {
    .wc__nav { padding: 16px 18px; gap: 12px; }
    .wc__marca { font-size: 18px; }
    .wc__nav nav, .wc__nav .wc__cta--sm { display: none; }
    .wc__menu { display: grid; gap: 5px; margin-left: auto; }
    .wc__menu i { display: block; width: 20px; height: 1.5px; background: #1f2a24; }
    .wc__hero { display: flex; flex-direction: column; align-items: stretch; gap: 22px; padding: 10px 18px 18px; }
    .wc__txt { gap: 12px; }
    .wc__zona { font-size: 12px; }
    .wc__h { font-size: 34px; }
    .wc__p { font-size: 14.5px; }
    .wc__acc { flex-direction: column; align-items: flex-start; gap: 12px; }
    .wc__cta { height: 44px; }
    .wc__panel { padding: 16px; gap: 12px; }
    .wc__dias i, .wc__horas i { font-size: 13px; padding: 8px 11px; }
    .wc__conf { padding: 11px; font-size: 13.5px; }
    .wc__pie { display: none; }
  }
</style>
