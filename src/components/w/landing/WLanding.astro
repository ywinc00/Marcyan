---
// ─────────────────────────────────────────────────────────────
// Plantilla v3 de las landings de cluster (design/rediseno-workos.md §3.7, ola 0C).
// La monta la PÁGINA de cada ruta cuando su tipo está listo, pasándole su
// `kinds/<kind>.ts` (activación por página: por qué, en registry.ts).
//
// Estructura: Layout ds="v3" · ServiceLd (head, igual que hoy) · SiteNav (con
// megamenú y sprite de iconos) · main.w-rails[data-w] · hero del tipo · secciones
// del tipo en orden · Contact (#contacto, mismos defaultCity/defaultService que
// hoy: w/landing/defaults.ts) · SpaceBackdrop · SiteFooter.
//
// El hero recibe las migas por el slot `crumbs` (Breadcrumb emite el
// BreadcrumbList, contrato SEO). Las secciones se envuelven en `.w-cell` según
// su `wrap` (types.ts). El formulario nunca lleva data-w-in ni data-w-reveal (§2.9).
//
// Fondo temático (v2 §1.3 / P12): si el tipo trae `fondo`, el hero va dentro de una
// zona (div.wf-zona) que también contiene <Fondo> (absolute, z-index 0, mide lo que el
// hero) y NO se monta SpaceBackdrop; con `eco`, vuelve quieto en la sección de
// contraste. `fondoOpciones(ctx).vars` llega al fondo como `style` (ajustes --wf-*).
// Sin `fondo`, el HTML sale igual que antes.
// ─────────────────────────────────────────────────────────────
import Layout from '../../../layouts/Layout.astro';
import SiteNav from '../../layout/SiteNav.astro';
import SiteFooter from '../../layout/SiteFooter.astro';
import Breadcrumb from '../../ui/Breadcrumb.astro';
import Contact from '../../sections/Contact.astro';
import SpaceBackdrop from '../../SpaceBackdrop.astro';
import ServiceLd from '../../seo/ServiceLd.astro';
import WStyles from '../WStyles.astro';
import { content } from '../../../i18n/content';
import { clusterNav, clusterNavEn, type ClusterPage } from '../../../i18n/clusters';
import { KIND_BY_PATH } from './registry';
import { deriveDefaultCity, deriveDefaultService } from './defaults';
import { temaDeFondo, type KindSpec, type LandingCtx, type LandingLang, type LandingTone } from './types';
// Al final a propósito: importarlo antes movía el orden del CSS en línea de las landings.
import Fondo from '../fondos/Fondo.astro';

interface Props {
  cluster: ClusterPage;
  lang?: LandingLang;
  /** Especificación del tipo (default de `kinds/<kind>.ts`), importada por la página. */
  spec: KindSpec;
}
const { cluster, lang = 'es', spec } = Astro.props;

const kind = KIND_BY_PATH[cluster.path];
if (!kind) throw new Error(`WLanding: ${cluster.path} no está en KIND_BY_PATH (registry.ts).`);
if (spec.kind !== kind) {
  throw new Error(`WLanding: ${cluster.path} es del tipo "${kind}" y la página le pasa "${spec.kind}".`);
}
const defaultCity = deriveDefaultCity(cluster.service.areaCity);
const defaultService = deriveDefaultService(cluster.path, lang);

const c = content[lang];
const nav = lang === 'en' ? clusterNavEn : clusterNav;
const pathNoLocale = cluster.path.replace(/^\/(es|en)\//, '');
const area = cluster.service.areaCity;
const city: LandingCtx['city'] = area === 'Houston' ? 'houston' : area === 'Miami' ? 'miami' : undefined;
const base = { cluster, lang, kind, city };
const tone: LandingTone =
  typeof spec.tone === 'function'
    ? spec.tone(base)
    : spec.tone ?? (cluster.hero.tone === 'teal' ? 'teal' : 'gold');
const ctx: LandingCtx = { ...base, tone };

const fondo = spec.fondo ? temaDeFondo(spec.fondo) : undefined;
const fondoOp: ReturnType<NonNullable<KindSpec['fondoOpciones']>> =
  fondo && spec.fondoOpciones ? spec.fondoOpciones(ctx) : {};
const conEco = !!(fondo && fondoOp.eco);

const Hero = spec.Hero;
const heroProps = spec.hero ? spec.hero(ctx) : {};
const sections = spec.sections
  .filter((s) => !s.when || s.when(ctx))
  .map((s) => ({
    C: s.component,
    props: s.props ? s.props(ctx) : {},
    id: s.id,
    wrap: s.wrap ?? 'cell',
    Tag: s.as ?? 'section',
    contrast: s.contrast,
    reveal: s.reveal ?? true,
  }));
---
<Layout
  title={cluster.meta.title}
  description={cluster.meta.description}
  lang={lang}
  path={pathNoLocale}
  ds="v3"
>
  <ServiceLd slot="head" {...cluster.service} />
  <WStyles />

  <SiteNav nav={nav} lang={lang} homeHref={lang === 'en' ? '/en' : '/es'} currentPath={Astro.url.pathname} />

  <main id="main" class="w-rails" data-w data-w-tone={tone} data-w-kind={kind} data-w-fondo={fondo}>
    {fondo ? (
      <div class="wf-zona">
        <Fondo tema={fondo} lang={lang} texto={fondoOp.texto} barrio={fondoOp.barrio} style={fondoOp.vars} />
        <Hero {...heroProps}>
          <Breadcrumb slot="crumbs" items={cluster.breadcrumb} lang={lang} />
        </Hero>
      </div>
    ) : (
      <Hero {...heroProps}>
        <Breadcrumb slot="crumbs" items={cluster.breadcrumb} lang={lang} />
      </Hero>
    )}

    {sections.map(({ C, props, id, wrap, Tag, contrast, reveal }) =>
      wrap === 'none' ? (
        <C {...props} />
      ) : (
        <Tag class:list={['w-cell', contrast && `w-${contrast}`]} id={id} data-w-eco={(conEco && contrast) ? '' : undefined}>{conEco && contrast && fondo && <Fondo tema={fondo} lang={lang} eco texto={fondoOp.texto} barrio={fondoOp.barrio} style={fondoOp.vars} />}
          {wrap === 'cell' ? (
            <div class="w-container" data-w-reveal={reveal || undefined}>
              <C {...props} />
            </div>
          ) : (
            <C {...props} />
          )}
        </Tag>
      ),
    )}

    <Contact contact={c.contact} defaultCity={defaultCity} defaultService={defaultService} />
  </main>

  {!fondo && <SpaceBackdrop tone={tone} />}{' '}

  <SiteFooter footer={c.footer} lang={lang} />
</Layout>
