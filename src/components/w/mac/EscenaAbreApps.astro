  @keyframes pp-retira { to { opacity: 0; visibility: hidden; } }
  @keyframes pp-ven-entra { from { opacity: 0; transform: translateY(90px) scale(.96); visibility: hidden; } to { opacity: 1; transform: none; visibility: visible; } }
  :global(.lf--pin[data-pin-on]) .abre--viaje :global(.pp-ven--0) { animation-range: contain 40% contain 45%; }
  :global(.lf--pin[data-pin-on]) .abre--viaje :global(.pp-ven--1) { animation-range: contain 54% contain 59%; }
