  }
  @keyframes pp-ven-pasa { 0% { opacity: 0; transform: translateY(90px) scale(.96); visibility: hidden; } 26%, 74% { opacity: 1; transform: none; visibility: visible; } 100% { opacity: 0; transform: translateY(-60px) scale(.97); visibility: hidden; } }
  /* Las ventanas del salón se retiran cuando llegan los proyectos (pantalla limpia). */
  :global(.lf--pin[data-pin-on]) .abre--viaje :global([data-w2-ventana='web']),
  :global(.lf--pin[data-pin-on]) .abre--viaje :global([data-w2-ventana='mapa']),
