  .abre :global(.pp-img) { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; object-fit: cover; object-position: 50% 0; }
  .abre[data-modo='pc'] :global(.pp-img--movil), .abre[data-modo='movil'] :global(.pp-img--pc) { display: none; }
