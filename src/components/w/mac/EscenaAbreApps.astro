---
// ─────────────────────────────────────────────────────────────
// P08 · EscenaAbreApps (W2N-03 calzado: "tu web, tu ficha y Marcy ya
// funcionando"; portada, "En vivo y contigo"). Marca de ejemplo: SALÓN (§1.6).
// La tapa se abre con el scroll (Portatil tapa="scroll"); con la tapa abierta
// y la pieza a la vista, una secuencia POR TIEMPO, una vez (re-ejecutable al
// volver tras ≥ 8 s fuera, §1.5):
//   0-1,7 s bloqueo · 2,1 s escritorio + dock · 2,7-3,6 s el cursor pulsa el
//   navegador → 4,0 s ventana cargando → 4,8 s la web publicada ("Publicada ✓")
//   · 5,45 s mapa → 5,8 s ficha ("Te encuentran ✓") · 6,5 s WhatsApp → 7,1 s
//   mensaje, "escribiendo…", 8,1 s Marcy responde · 7,7 s correo → 8,35 s
//   "Nuevo contacto" · ~9 s quieto con 4 ventanas en cascada y micro-vida
//   (punto "en línea" de Marcy y halo del cursor, pausados fuera de vista).
// Móvil (≤ 640 px): mismo ritmo, 3 apps (sin correo).
// Slot "cabecera": el titular de la sección va DENTRO de la parte fijada y BAJA con
// la tapa: con la tapa cerrada se queda justo encima de la base (un solo grupo,
// como W2N-03) y sube siguiendo el borde superior de la tapa mientras gira (misma
// línea de tiempo, curva medida de la proyección de la tapa). La secuencia por
// tiempo arranca cuando el giro termina (pista entera a la vista, E-56 regla 7).
// Estado final en el HTML (sin JS y con reducir movimiento se ve completo).
// Objetos de ejemplo (§1.6): sin h1-h6 dentro, raíz aria-hidden + data-nosnippet
// + resumen sr-only, sin tel:/wa.me/data-track, un solo rótulo "Ejemplo".
// Piezas de otras tareas, si ya están en la rama (import.meta.glob):
//   WebEjemplo (P02) y FichaMapaEjemplo mini (P03); si no, composición propia.
// ─────────────────────────────────────────────────────────────
import Portatil from './Portatil.astro';
import Escritorio from './Escritorio.astro';
import VentanaApp from './VentanaApp.astro';
import { centroDock } from './mac';
import WebSalon from '../heroes/webs/WebSalon.astro';
import FichaMapaEjemplo from '../objetos/FichaMapaEjemplo.astro';
import LogoMarca from '../marcas/LogoMarca.astro';
import Kicker from '../../ui/Kicker.astro';
import Button from '../../ui/Button.astro';

/** Proyecto real (capturas de /Galeria) para el modo «viaje» de la portada. */
export interface ProyectoViaje { slug: string; name: string; cat: string; result: string; domain?: string; movilH: number }
interface Props {
  lang?: 'es' | 'en';
  ancho?: number;
  tapa?: 'abierta' | 'scroll';
  /** Modo viaje (portada, dueño 2026-11-08): la escena vive dentro del tramo fijado de LineaFases
   *  (`pin`). La tapa se abre con ese tramo, el portátil se acerca al centro y, al seguir bajando,
   *  los proyectos reales salen como ventanas en su pantalla, con conmutador Escritorio | Móvil. */
  viaje?: {
    proyectos: ProyectoViaje[];
    cab: { tag: string; titleHtml: string; cta: { label: string; href: string } };
    lanza: { kicker?: string; label: string; href: string };
  };
  class?: string;
}
const { lang = 'es', ancho = 990, tapa = 'scroll', viaje, class: cls } = Astro.props;
const TV = lang === 'en'
  ? { modo: 'View projects on', pc: 'Desktop', movil: 'Mobile', de: 'of', vista: (n: string) => `${n}, website` }
  : { modo: 'Ver los proyectos en', pc: 'Escritorio', movil: 'Móvil', de: 'de', vista: (n: string) => `${n}, sitio web` };
const dos = (n: number) => String(n).padStart(2, '0');

const T = {
  es: {
    resumen: 'Ejemplo animado: un portátil se abre y muestra, ya funcionando, la web publicada de un salón, su ficha en el mapa, Marcy contestando por WhatsApp y el aviso de nuevo contacto por correo.',
    negocio: 'Tu Salón', cuenta: 'Tu Negocio', dominio: 'tusalon.example', ejemplo: 'Ejemplo',
    fecha: 'jueves, 5 de noviembre', horaBloqueo: '9:41', horaMenu: 'jue 5 nov  9:41 p. m.',
    apps: { inicio: 'Escritorio', web: 'Navegador', mapa: 'Mapas', wa: 'WhatsApp', correo: 'Correo' },
    publicada: 'Publicada', encuentran: 'Te encuentran', nuevo: 'Nuevo contacto',
    cargaWeb: 'Abriendo tusalon.example', cargaMapa: 'Buscando “salón cerca de mí”', cargaWa: 'Conectando WhatsApp', cargaCorreo: 'Abriendo el correo',
    web: {
      nav: ['Servicios', 'Equipo', 'Visítanos'], reservar: 'Reservar cita',
      eyebrow: 'Salón de belleza · Houston', titulo: ['Tu mejor versión,', 'sin prisa.'],
      bajada: 'Corte, color y peinado con cita, en español y en inglés.', ver: 'Ver servicios',
      servicios: ['Corte', 'Color', 'Peinados', 'Tratamientos'], horario: 'Mar a sáb · 9:00 a. m. a 7:00 p. m.',
    },
    mapa: { busca: 'salón de belleza cerca de mí', tipo: 'Salón de belleza · Heights, Houston', abierto: 'Abierto', cierra: 'cierra 7:00 p. m.', acciones: ['Cómo llegar', 'Llamar', 'Sitio web'], zona: 'Heights' },
    wa: {
      cliente: 'Laura M.', estado: 'en línea', pregunta: 'Hola, ¿tienen cita mañana para corte y color?', hPregunta: '9:38 p. m.',
      marcy: 'Marcy · Tu Salón', escribiendo: 'escribiendo…',
      respuesta: '¡Hola, Laura! Mañana tengo libre a las 10:00 a. m. o a las 3:30 p. m. ¿Te aparto una?', hRespuesta: '9:38 p. m.',
      escribe: 'Escribe un mensaje',
    },
    correo: {
      bandeja: 'Recibidos', otros: ['Destacados', 'Enviados'], de: 'Marcy', asunto: 'Nuevo contacto · Tu Salón', hora: '9:39 p. m.',
      saludo: 'Laura M. pidió cita por WhatsApp. Ya le contesté con dos horarios.',
      filas: [['Canal', 'WhatsApp'], ['Servicio', 'Corte y color'], ['Prefiere', 'mañana, 10:00 a. m.']],
      cierre: 'Te aviso en cuanto confirme.',
    },
  },
  en: {
    resumen: 'Animated example: a laptop opens and shows, already working, a salon’s live website, its map listing, Marcy answering on WhatsApp and the new lead email.',
    negocio: 'Your Salon', cuenta: 'Your Business', dominio: 'yoursalon.example', ejemplo: 'Example',
    fecha: 'Thursday, November 5', horaBloqueo: '9:41', horaMenu: 'Thu Nov 5  9:41 PM',
    apps: { inicio: 'Desktop', web: 'Browser', mapa: 'Maps', wa: 'WhatsApp', correo: 'Mail' },
    publicada: 'Live', encuentran: 'On the map', nuevo: 'New lead',
    cargaWeb: 'Opening yoursalon.example', cargaMapa: 'Searching “salon near me”', cargaWa: 'Connecting WhatsApp', cargaCorreo: 'Opening mail',
    web: {
      nav: ['Services', 'Team', 'Visit'], reservar: 'Book now',
      eyebrow: 'Hair salon · Houston', titulo: ['Your best look,', 'unhurried.'],
      bajada: 'Cuts, color and styling by appointment, in English and Spanish.', ver: 'See services',
      servicios: ['Cuts', 'Color', 'Styling', 'Treatments'], horario: 'Tue to Sat · 9:00 AM to 7:00 PM',
    },
    mapa: { busca: 'hair salon near me', tipo: 'Hair salon · Heights, Houston', abierto: 'Open', cierra: 'closes 7:00 PM', acciones: ['Directions', 'Call', 'Website'], zona: 'Heights' },
    wa: {
      cliente: 'Laura M.', estado: 'online', pregunta: 'Hi, do you have an opening tomorrow for a cut and color?', hPregunta: '9:38 PM',
      marcy: 'Marcy · Your Salon', escribiendo: 'typing…',
      respuesta: 'Hi Laura! Tomorrow I have 10:00 AM or 3:30 PM open. Want me to hold one for you?', hRespuesta: '9:38 PM',
      escribe: 'Type a message',
    },
    correo: {
      bandeja: 'Inbox', otros: ['Starred', 'Sent'], de: 'Marcy', asunto: 'New lead · Your Salon', hora: '9:39 PM',
      saludo: 'Laura M. asked for an appointment on WhatsApp. I already replied with two times.',
      filas: [['Channel', 'WhatsApp'], ['Service', 'Cut and color'], ['Prefers', 'tomorrow, 10:00 AM']],
      cierre: 'I’ll let you know as soon as she confirms.',
    },
  },
}[lang];

const destinos = {
  web: centroDock('navegador'),
  mapa: centroDock('googlemaps'),
  wa: centroDock('whatsapp'),
  correo: centroDock('gmail'),
};
---
<div class:list={['abre', viaje && 'abre--viaje', cls]} style={`--abre-w:${ancho}px`} data-tapa={tapa} data-viaje={viaje ? '' : undefined} data-modo="pc" data-w2-abreapps data-lang={lang} data-destinos={JSON.stringify(destinos)} data-apps={JSON.stringify(T.apps)}>
  <span class="abre-hueco" aria-hidden="true"></span>
  <div class="abre-fijo">
  <div class="abre-cab"><slot name="cabecera" /></div>
  <div class="abre-obj" data-nosnippet>
  <p class="sr-only">{T.resumen}</p>
  <Portatil ancho={ancho} tapa={tapa}>
    <Escritorio lang={lang} cursor app={T.apps.correo} hora={T.horaMenu}
      bloqueo={{ fecha: T.fecha, hora: T.horaBloqueo, nombre: T.cuenta }}>

      {/* 1 · la web publicada (salón) */}
      <VentanaApp id="web" url={`${T.dominio} · ${T.ejemplo}`} x={56} y={54} w={650} h={520} z={1} chipTop={114} textoCarga={T.cargaWeb}>
        {/* Cuerpos de las 4 ventanas en <template> (v2 §4.6, nodos): el script los pone al acercarse el portátil. */}
        <template data-w2-tpl><div class="abre-web-p02"><WebSalon lang={lang} /></div></template>
        <svg slot="carga" width="40" height="40" viewBox="0 0 40 40"><circle cx="20" cy="20" r="17" fill="#d5dacb" stroke="#8c5a4a" stroke-width="1.4" /><path d="M20 9c3.6 3 3.6 6.2 0 9.2-3.6-3-3.6-6.2 0-9.2zM20 21.8c3.6 3 3.6 6.2 0 9.2-3.6-3-3.6-6.2 0-9.2z" fill="none" stroke="#8c5a4a" stroke-width="1.4" /></svg>
        <Fragment slot="chip">{T.publicada}</Fragment>
      </VentanaApp>

      {/* 2 · la ficha en el mapa */}
      <VentanaApp id="mapa" titulo={T.apps.mapa} x={700} y={84} w={620} h={420} z={2} textoCarga={T.cargaMapa}>
        <template data-w2-tpl><div class="abre-ficha-p03"><FichaMapaEjemplo variante="mini" marca="salon" lang={lang} /></div></template>
        <LogoMarca slot="carga" id="googlemaps" size={40} tono="color" titulo="" />
        <Fragment slot="chip">{T.encuentran}</Fragment>
      </VentanaApp>

      {/* 3 · WhatsApp: Marcy contesta */}
      <VentanaApp id="wa" titulo={T.apps.wa} x={286} y={292} w={450} h={440} z={3} textoCarga={T.cargaWa}>
        <template data-w2-tpl><div class="wa" data-wa-paso="3">
          <div class="wa-cab">
            <span class="wa-av">LM</span>
            <span class="wa-quien"><b>{T.wa.cliente}</b><small>{T.wa.estado}</small></span>
          </div>
          <div class="wa-chat">
            <span class="wa-msg wa-msg--in"><span>{T.wa.pregunta}</span><small data-reloj="hora" data-reloj-min="-2">{T.wa.hPregunta}</small></span>
            <span class="wa-marcy"><span class="wa-punto"></span>{T.wa.marcy}</span>
            <span class="wa-msg wa-msg--out wa-msg--tecleo"><i></i><i></i><i></i></span>
            <span class="wa-msg wa-msg--out wa-msg--resp"><span>{T.wa.respuesta}</span><small><span data-reloj="hora" data-reloj-min="-1">{T.wa.hRespuesta}</span> <svg width="16" height="10" viewBox="0 0 16 10"><path d="m1 5.5 3 3 6-7M6.5 8.5l1 1 6-8" fill="none" stroke="#53bdeb" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg></small></span>
          </div>
          <div class="wa-pie"><span>{T.wa.escribe}</span></div>
        </div></template>
        <LogoMarca slot="carga" id="whatsapp" size={40} tono="color" titulo="" />
      </VentanaApp>

      {/* 4 · correo al dueño (solo ≥ 641 px) */}
      <VentanaApp id="correo" titulo={T.apps.correo} x={742} y={338} w={590} h={400} z={4} textoCarga={T.cargaCorreo} class="abre-correo">
        <template data-w2-tpl><div class="cor">
          <div class="cor-lado">
            <span class="cor-carpeta cor-carpeta--on">{T.correo.bandeja}<b>1</b></span>
            {T.correo.otros.map((o) => <span class="cor-carpeta">{o}</span>)}
          </div>
          <div class="cor-main">
            <span class="cor-asunto">{T.correo.asunto}</span>
            <span class="cor-de">
              <img src="/assets/bot/marcy-mini-128.webp" srcset="/assets/bot/marcy-mini-32.webp 32w, /assets/bot/marcy-mini-64.webp 64w, /assets/bot/marcy-mini-96.webp 96w, /assets/bot/marcy-mini-128.webp 128w, /assets/bot/marcy-mini.webp 256w" sizes="21px" width="34" height="34" alt="" loading="lazy" decoding="async" />
              <span><b>{T.correo.de}</b><small data-reloj="hora">{T.correo.hora}</small></span>
            </span>
            <span class="cor-txt">{T.correo.saludo}</span>
            <span class="cor-filas">{T.correo.filas.map(([k, v]) => <span><small>{k}</small>{v}</span>)}</span>
            <span class="cor-txt cor-txt--2">{T.correo.cierre}</span>
          </div>
        </div></template>
        <LogoMarca slot="carga" id="gmail" size={40} tono="color" titulo="" />
        <Fragment slot="chip">{T.nuevo}</Fragment>
      </VentanaApp>

      {/* 5 · Modo viaje: un proyecto REAL por ventana (capturas de /Galeria, escritorio y móvil). */}
      {viaje?.proyectos.map((pr, i) => (
        <VentanaApp id={`p${i}`} url={pr.domain ?? pr.name} x={214} y={70} w={950} h={600} z={10 + i} class={`pp-ven pp-ven--${i}`}>
          <img class="pp-img pp-img--pc" src={`/Galeria/${pr.slug}-pc-900.webp`} srcset={`/Galeria/${pr.slug}-pc-480.webp 480w, /Galeria/${pr.slug}-pc-640.webp 640w, /Galeria/${pr.slug}-pc-900.webp 900w, /Galeria/${pr.slug}-pc-1280.webp 1280w`} sizes="(min-width: 1120px) 680px, 340px" width="900" height="506" alt="" loading="lazy" decoding="async" />
          <img class="pp-img pp-img--movil" src={`/Galeria/${pr.slug}-movil-520.webp`} width="520" height={pr.movilH} alt="" loading="lazy" decoding="async" />
        </VentanaApp>
      ))}
    </Escritorio>
  </Portatil>
  </div>
  {viaje && (
    <Fragment>
      <div class="pp-cab">
        <div class="pp-tit">
          <Kicker>{viaje.cab.tag}</Kicker>
          <h2 class="h2 pp-h2" set:html={viaje.cab.titleHtml} />
        </div>
        <div class="pp-seg" role="radiogroup" aria-label={TV.modo} data-pp-seg>
          <span class="pp-seg__pill" aria-hidden="true"></span>
          <button type="button" role="radio" aria-checked="true" data-pp-modo="pc">{TV.pc}</button>
          <button type="button" role="radio" aria-checked="false" data-pp-modo="movil">{TV.movil}</button>
        </div>
      </div>
      <div class="pp-pie">
        <div class="pp-lanza">
          {viaje.lanza.kicker && <span class="pp-lanza__k">{viaje.lanza.kicker}</span>}
          <Button href={viaje.lanza.href} variant="primary" size="lg">{viaje.lanza.label}</Button>
        </div>
        <ol class="pp-caps" role="list">
          {viaje.proyectos.map((pr, i) => (
            <li class:list={['pp-cap', i === viaje.proyectos.length - 1 && 'pp-cap--fin']} style={`--i:${i}`}>
              <span class="pp-cap__n">{dos(i + 1)} {TV.de} {dos(viaje.proyectos.length)}</span>
              <span class="pp-cap__t"><b translate="no">{pr.name}</b> · {pr.cat}</span>
              <span class="pp-cap__r">{pr.result}</span>
            </li>
          ))}
        </ol>
        <a class="pp-ver" href={viaje.cab.cta.href}>{viaje.cab.cta.label}<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M3.5 8h9M9 4.5 12.5 8 9 11.5" /></svg></a>
      </div>
    </Fragment>
  )}
  </div>
  <span class="abre-pista" aria-hidden="true" data-w2-abre-pista></span>
</div>

<style>
  /* Tapa por scroll (W2N-03): el grupo entra con la página, se queda fijado CENTRADO en
     la ventana (--abre-b lo calcula el guion: mitad del hueco libre; 24 px sin JS)
     mientras la tapa gira en --abre-rec px (450 escritorio, 300 móvil) y después sigue
     con la página. Un hueco de --abre-rec delante deja que la parte fijada (titular +
     portátil) se quede pegada. Una pista invisible
     de --abre-rec px al pie de la escena da la línea de tiempo (timeline-scope):
     su entrada completa coincide EXACTAMENTE con el tramo fijado. Sin listener (E-50). */
  /* v4: SIN recorte aquí. Al girar, la tapa en 3D se proyecta hasta ~10 % más ancha que la caja
     (medido: 76 px por lado a 1440) y overflow-x:clip en .abre le cortaba las esquinas de arriba
     en el tramo final. El recorte horizontal (para no crear scroll lateral) lo hace la sección
     que la contiene, a ancho de ventana (Process.astro / quien la use). */
  .abre { position: relative; display: flex; flex-direction: column; }
  .abre[data-tapa="scroll"] {
    --abre-rec: 300px;
    --abre-b: calc(24px + env(safe-area-inset-bottom, 0px)); /* v5: ya no hay barra fija de CTA en móvil */
    position: relative;
    timeline-scope: --abre-vista;
    --pt-linea: --abre-vista;
    --pt-rango: cover var(--abre-b) cover calc(var(--abre-b) + var(--abre-rec));
  }
  @media (min-width: 768px) {
    .abre[data-tapa="scroll"] {
      --abre-rec: 450px; --abre-b: 24px;
      /* Al final del tramo fijado el grupo entero (titular + portátil) cabe bajo la
         navegación: el ancho del portátil se limita por el alto de la ventana. Alto
         del portátil ≈ 0,638 × su ancho (tapa 1/1,08 × 933/1415 + base 2,75 %).
         --abre-cabh = alto del titular con su aire (lo mide el script; 220 sin JS). */
      --abre-wv: max(600px, calc((calc(100svh / var(--z, 1)) - var(--nav-h, 72px) - 24px - var(--abre-cabh, 220px) - 20px) / .638));
    }
    .abre[data-tapa="scroll"] :global(.pt) { width: min(100%, var(--pt-w), var(--abre-wv)); }
  }
  .abre[data-tapa="scroll"] .abre-fijo { position: sticky; bottom: var(--abre-b); }
  /* Titular y portátil, un solo grupo: --abre-h = alto de la tapa abierta (ancho del
     portátil / 1,08 × 933/1415). Con la tapa a -90° el titular baja ese alto y queda
     sobre la base; sube siguiendo la proyección del borde de la tapa (v5: perspectiva
     900cqw, origen 50% 150%; fracción visible calculada en los 13 fotogramas de pt-gira:
     0,04 · 0,06 · 0,15 · 0,33 · 0,60 · 0,84 · 0,96 · 1). Con la tapa cerrada el titular
     queda sobre la franja de la tapa, encima de la base. Su margen inferior (≈ 40 px) es el aire con la tapa. */
  .abre-fijo { container-type: inline-size; }
  .abre-cab { position: relative; z-index: 2; }
  @keyframes abre-cab-baja {
    0% { transform: translateY(calc(var(--abre-h) * 0.96)); }
    8.33% { transform: translateY(calc(var(--abre-h) * 0.938)); }
    16.67% { transform: translateY(calc(var(--abre-h) * 0.854)); }
    25% { transform: translateY(calc(var(--abre-h) * 0.674)); }
    33.33% { transform: translateY(calc(var(--abre-h) * 0.396)); }
    41.67% { transform: translateY(calc(var(--abre-h) * 0.158)); }
    50% { transform: translateY(calc(var(--abre-h) * 0.045)); }
    58.33% { transform: translateY(calc(var(--abre-h) * 0.005)); }
    66.67%, 100% { transform: none; }
  }
  @supports (animation-timeline: view()) {
    .abre[data-tapa="scroll"] .abre-cab {
      --abre-h: calc(min(100cqw, var(--abre-w, 990px), var(--abre-wv, 9999px)) / 1.08 * 933 / 1415);
      animation: abre-cab-baja linear both;
      animation-timeline: --abre-vista;
      animation-range: var(--pt-rango);
      will-change: transform;
    }
  }
  .abre-pista { position: absolute; left: 0; bottom: 0; width: 1px; height: var(--abre-rec, 0px); pointer-events: none; view-timeline: --abre-vista block; }
  .abre-hueco { display: none; }
  .abre[data-tapa="scroll"] .abre-hueco { display: block; height: var(--abre-rec); }
  @supports not (animation-timeline: view()) { .abre[data-tapa="scroll"] .abre-hueco { display: none; } .abre[data-tapa="scroll"] .abre-fijo { position: static; } }
  @media (prefers-reduced-motion: reduce) { .abre[data-tapa="scroll"] .abre-hueco { display: none; } .abre[data-tapa="scroll"] .abre-fijo { position: static; } .abre[data-tapa="scroll"] .abre-cab { animation: none !important; transform: none !important; } }
  .abre-web-p02, .abre-ficha-p03 { position: absolute; inset: 0; }
  @media (max-width: 640px) { .abre :global(.abre-correo) { display: none; } }

  /* ── WhatsApp ── */
  .wa { position: absolute; inset: 0; display: grid; grid-template-rows: 58px 1fr 52px; font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; }
  .wa-cab { display: flex; align-items: center; gap: 12px; padding: 0 16px; background: #f0f2f5; border-bottom: 1px solid #e3e5e8; }
  .wa-av { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%; background: #c9b8e8; color: #3f2d6b; font-size: 14px; font-weight: 700; }
  .wa-quien { display: grid; gap: 1px; font-size: 15px; }
  .wa-quien small { font-size: 12px; color: #667781; }
  .wa-chat {
    display: flex; flex-direction: column; justify-content: flex-end; gap: 8px; padding: 16px 18px;
    background: #efeae2;
    background-image: radial-gradient(rgba(120,100,80,.07) 1px, transparent 1.4px); background-size: 14px 14px;
  }
