  .abre[data-modo='pc'] :global(.pp-ven--2) { left: 294px !important; top: 142px !important; width: 950px !important; height: 600px !important; }
  .abre[data-modo='pc'] :global(.pp-ven--3) { left: 334px !important; top: 180px !important; width: 950px !important; height: 600px !important; }
  /* Móvil: cada proyecto en una ventana con forma de teléfono, en fila. */
