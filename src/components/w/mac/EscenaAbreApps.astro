  :global(.lf--pin[data-pin-on]) .abre--viaje :global(.pp-ven--3) { animation-range: contain 82% contain 87%; }
  /* Escritorio: cascada que baja hacia la derecha (cada ventana tapa la anterior). */
  .abre[data-modo='pc'] :global(.pp-ven--0) { left: 214px !important; top: 66px !important; width: 950px !important; height: 600px !important; }
