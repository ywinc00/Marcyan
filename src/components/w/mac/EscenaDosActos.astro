---
// ─────────────────────────────────────────────────────────────
// P08 · EscenaDosActos (W2N-01 calzado: "¿quién contesta de noche?" →
// "Respondido por Marcy"; hero de IA conversacional, G06). Corrección B3:
//   · el H1 VERBATIM de la página va en el slot "titulo" (único <h1>) y se ve al
//     100 % desde el primer pintado: nada de opacidad ni coreografía sobre él;
//   · el acto 1 es un <p aria-hidden> en la línea ENCIMA del H1, a ~60 % de su
//     tamaño, que se funde al pasar al acto 2 (no es encabezado).
// Secuencia (una vez POR SESIÓN, sessionStorage con try/catch):
//   0-0,7 s noche · 0,7-3,2 s entran 10 ventanas oscuras (6 en móvil), cada
//   280 ms, SOLO de canales que Marcy contesta (§5-14): WhatsApp, Instagram,
//   formulario web, Messenger, chat de la web; llamada perdida y SMS solo como
//   aviso ("Te avisa"), nunca "Respondido" · 3,9 s hoja "Marcy está
//   contestando" · 4,5 s "Respondido por Marcy" · 5,2 s la hoja se vuelve el
//   panel "Hoy, mientras dormías", el cielo cruza a amanecer teal y la
//   pregunta se funde · 5,6-6,6 s los canales pasan a color uno a uno ·
//   6,8 s cae el sello "RESPONDIDO" · desde ~7 s quieto con el punto "en línea"
//   latiendo (pausado fuera de vista).
// Visitas siguientes, sin JS o con reducir movimiento: acto 2 directo (es el
// estado del HTML; un guion en línea decide ANTES del primer pintado si toca
// reproducir).
// Slots: "titulo" (H1 de la página), "bajada", "acciones" (botones del sitio),
// "fondo" (motivo F04 de P12 cuando exista; si no, noche propia).
// ─────────────────────────────────────────────────────────────
import Portatil from './Portatil.astro';
import Escritorio from './Escritorio.astro';
import { logoReserva, type LogoReservaId } from './mac';

interface Props {
  lang?: 'es' | 'en';
  id?: string;
  class?: string;
}
const { lang = 'es', id, class: cls } = Astro.props;

const logoMods = import.meta.glob('../marcas/LogoMarca.astro', { eager: true }) as Record<string, { default: any }>;
const LogoMarca = Object.values(logoMods)[0]?.default ?? null;
const uid = 'da' + Math.random().toString(36).slice(2, 8);

type Canal = 'whatsapp' | 'instagram' | 'messenger' | 'form' | 'web' | 'llamada' | 'sms';
interface Ventana { canal: Canal; x: number; y: number; w: number; quien: string; texto: string; hora: string; extra?: boolean; enLang?: boolean }

const T = {
  es: {
    acto1: '¿Quién contesta a las 11 de la noche?',
    resumen: 'Ejemplo animado: de noche llegan mensajes por WhatsApp, Instagram, Messenger, el formulario y el chat de la web; Marcy los contesta y por la mañana el panel muestra todo respondido, y te avisa de la llamada perdida y del mensaje de texto.',
    ejemplo: 'Ejemplo', app: 'Escritorio', hora: 'jue 5 nov  11:58 p. m.', horaDia: 'vie 6 nov  7:02 a. m.',
    canales: { whatsapp: 'WhatsApp', instagram: 'Instagram', messenger: 'Messenger', form: 'Formulario web', web: 'Chat de la web', llamada: 'Llamada perdida', sms: 'Mensaje de texto' },
    pedir: 'Pedir presupuesto', campos: ['Nombre', 'Servicio', 'Mensaje'], enviado: 'Enviado', enviar: 'Enviar',
    sinLeer: 'sin leer', escribe: 'Escribe un mensaje',
    contestando: 'Marcy está contestando', respondidoPor: 'Respondido por Marcy',
    panel: 'Hoy, mientras dormías', enLinea: 'Marcy · en línea',
    respondido: 'Respondido', avisa: 'Te avisa', sello: 'RESPONDIDO',
    ventanas: [
      { canal: 'whatsapp', x: 36, y: 50, w: 300, quien: 'Ana R.', texto: '¿Pueden venir mañana a medir?', hora: '10:47 p. m.' },
      { canal: 'instagram', x: 318, y: 74, w: 290, quien: 'marisol.hz', texto: 'Hola, ¿pueden venir el sábado a ver la cocina?', hora: '10:52 p. m.' },
      { canal: 'form', x: 584, y: 46, w: 300, quien: 'Carlos P.', texto: '¿Pueden venir esta semana a ver la casa?', hora: '11:02 p. m.' },
      { canal: 'messenger', x: 862, y: 66, w: 290, quien: 'Rosa G.', texto: 'Hi! Could someone come by this week for an estimate?', hora: '11:06 p. m.', enLang: true },
      { canal: 'web', x: 1104, y: 44, w: 250, quien: 'Visitante', texto: 'Hola, ¿me pueden llamar mañana?', hora: '11:10 p. m.' },
      { canal: 'llamada', x: 1030, y: 318, w: 318, quien: '(281) 555-0142', texto: 'No dejó mensaje', hora: '11:14 p. m.' },
      { canal: 'whatsapp', x: 110, y: 352, w: 300, quien: 'Luis T.', texto: 'Buenas noches, ¿cuánto tarda una cotización?', hora: '11:21 p. m.', extra: true },
      { canal: 'instagram', x: 402, y: 400, w: 290, quien: 'casa.verde', texto: 'Me interesa, ¿hacen visitas en Katy?', hora: '11:33 p. m.', extra: true },
      { canal: 'sms', x: 1030, y: 452, w: 318, quien: '(832) 555-0187', texto: '¿Toman trabajos esta semana?', hora: '11:41 p. m.', extra: true },
      { canal: 'web', x: 714, y: 404, w: 290, quien: 'Visitante', texto: 'Hi, can you come out early Monday?', hora: '11:52 p. m.', extra: true, enLang: true },
    ] as Ventana[],
    filas: [
      { canal: 'whatsapp', txt: 'Ana R. y Luis T.', est: 'ok' },
      { canal: 'instagram', txt: 'marisol.hz y casa.verde', est: 'ok' },
      { canal: 'form', txt: 'Carlos P. · presupuesto', est: 'ok' },
      { canal: 'messenger', txt: 'Rosa G. · en inglés', est: 'ok' },
      { canal: 'web', txt: '2 visitantes', est: 'ok' },
      { canal: 'llamada', txt: '(281) 555-0142', est: 'aviso' },
      { canal: 'sms', txt: '(832) 555-0187', est: 'aviso' },
    ] as Array<{ canal: Canal; txt: string; est: 'ok' | 'aviso' }>,
  },
  en: {
    acto1: 'Who answers at 11 at night?',
    resumen: 'Animated example: at night messages arrive on WhatsApp, Instagram, Messenger, the website form and website chat; Marcy answers them and in the morning the panel shows everything answered, and flags the missed call and the text message for you.',
    ejemplo: 'Example', app: 'Desktop', hora: 'Thu Nov 5  11:58 PM', horaDia: 'Fri Nov 6  7:02 AM',
    canales: { whatsapp: 'WhatsApp', instagram: 'Instagram', messenger: 'Messenger', form: 'Website form', web: 'Website chat', llamada: 'Missed call', sms: 'Text message' },
    pedir: 'Request a quote', campos: ['Name', 'Service', 'Message'], enviado: 'Sent', enviar: 'Send',
    sinLeer: 'unread', escribe: 'Type a message',
    contestando: 'Marcy is answering', respondidoPor: 'Answered by Marcy',
    panel: 'Today, while you slept', enLinea: 'Marcy · online',
    respondido: 'Answered', avisa: 'Flagged for you', sello: 'ANSWERED',
    ventanas: [
      { canal: 'whatsapp', x: 36, y: 50, w: 300, quien: 'Ana R.', texto: 'Can you come measure tomorrow?', hora: '10:47 PM' },
      { canal: 'instagram', x: 318, y: 74, w: 290, quien: 'marisol.hz', texto: 'Hi, could you come Saturday to look at the kitchen?', hora: '10:52 PM' },
      { canal: 'form', x: 584, y: 46, w: 300, quien: 'Carlos P.', texto: 'Can you come see the house this week?', hora: '11:02 PM' },
      { canal: 'messenger', x: 862, y: 66, w: 290, quien: 'Rosa G.', texto: '¡Hola! ¿Pueden venir esta semana a dar un presupuesto?', hora: '11:06 PM', enLang: true },
      { canal: 'web', x: 1104, y: 44, w: 250, quien: 'Visitor', texto: 'Hi, can you call me tomorrow?', hora: '11:10 PM' },
      { canal: 'llamada', x: 1030, y: 318, w: 318, quien: '(281) 555-0142', texto: 'No voicemail', hora: '11:14 PM' },
      { canal: 'whatsapp', x: 110, y: 352, w: 300, quien: 'Luis T.', texto: 'Good evening, how long does a quote take?', hora: '11:21 PM', extra: true },
      { canal: 'instagram', x: 402, y: 400, w: 290, quien: 'casa.verde', texto: 'Interested, do you do visits in Katy?', hora: '11:33 PM', extra: true },
      { canal: 'sms', x: 1030, y: 452, w: 318, quien: '(832) 555-0187', texto: 'Taking jobs this week?', hora: '11:41 PM', extra: true },
      { canal: 'web', x: 714, y: 404, w: 290, quien: 'Visitor', texto: 'Hola, ¿pueden venir el lunes temprano?', hora: '11:52 PM', extra: true, enLang: true },
    ] as Ventana[],
    filas: [
      { canal: 'whatsapp', txt: 'Ana R. and Luis T.', est: 'ok' },
      { canal: 'instagram', txt: 'marisol.hz and casa.verde', est: 'ok' },
      { canal: 'form', txt: 'Carlos P. · quote', est: 'ok' },
      { canal: 'messenger', txt: 'Rosa G. · in Spanish', est: 'ok' },
      { canal: 'web', txt: '2 visitors', est: 'ok' },
      { canal: 'llamada', txt: '(281) 555-0142', est: 'aviso' },
      { canal: 'sms', txt: '(832) 555-0187', est: 'aviso' },
    ] as Array<{ canal: Canal; txt: string; est: 'ok' | 'aviso' }>,
  },
}[lang];
const otro = lang === 'es' ? 'en' : 'es';

const MARCA: Partial<Record<Canal, LogoReservaId>> = { whatsapp: 'whatsapp', instagram: 'instagram', messenger: 'messenger' };
const GLIFO: Record<'form' | 'web' | 'llamada' | 'sms', string> = {
  form: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="2.5"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>',
  web: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.4-4.9A8 8 0 1 1 21 12z"/><path d="M8.5 12h.01M12 12h.01M15.5 12h.01" stroke-width="2.6"/></svg>',
  llamada: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/><path d="m16 2 6 6M22 2l-6 6"/></svg>',
  sms: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="14" rx="3"/><path d="m8 18-3 3v-3M7.5 9.5h9M7.5 13h5.5"/></svg>',
};
const icono = (c: Canal, size = 22) => (MARCA[c] ? logoReserva(MARCA[c]!, size, c === 'instagram' ? 'blanco' : 'color') : GLIFO[c as keyof typeof GLIFO]);
const iniciales = (q: string) => q.replace(/[^A-Za-zÁÉÍÓÚÑáéíóúñ ]/g, ' ').trim().split(/\s+/).map((p) => p[0]).join('').slice(0, 2).toUpperCase() || '·';
---
<section class:list={['da', cls]} id={id} data-w2-dosactos data-da-fase="final" lang={lang}>
  <script is:inline>
    (function () {
      var s = document.currentScript && document.currentScript.parentElement;
      if (!s) return;
      var ya = null;
      try { ya = sessionStorage.getItem('w2-dosactos'); } catch (e) { ya = '1'; }
      var rm = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!ya && !rm) s.setAttribute('data-da-fase', 'inicio');
    })();
  </script>
  <div class="da-cielo" aria-hidden="true">
    <span class="da-noche"></span>
    <span class="da-alba"></span>
    <slot name="fondo" />
  </div>

  <div class="da-texto">
    <p class="da-acto1" aria-hidden="true">{T.acto1}</p>
    <div class="da-h1"><slot name="titulo" /></div>
  </div>
  <div class="da-pie">
    <div class="da-bajada"><slot name="bajada" /></div>
    <div class="da-acciones"><slot name="acciones" /></div>
  </div>

  <div class="da-mac" data-nosnippet>
    <p class="sr-only">{T.resumen}</p>
    <span class="da-ejemplo" aria-hidden="true">{T.ejemplo}</span>
    <Portatil ancho={976}>
      <Escritorio lang={lang} dock={false} app={T.app} hora={T.hora} horaDia={T.horaDia} class="da-esc">
        {T.ventanas.map((v, i) => (
          <div class:list={['dv', `dv--${v.canal}`, v.extra && 'dv--extra']} data-da-v={i} style={`left:${v.x}px;top:${v.y}px;width:${v.w}px;--i:${i}`}>
            <div class="dv-cab">
              <span class:list={['dv-ico', `dv-ico--${v.canal}`]}>
                {LogoMarca && MARCA[v.canal]
                  ? <LogoMarca id={MARCA[v.canal]} size={22} tono="color" titulo="" />
                  : <Fragment set:html={icono(v.canal)} />}
              </span>
              <b>{T.canales[v.canal]}</b>
              <small>{v.hora}</small>
            </div>
            {v.canal === 'form' ? (
              <div class="dv-form">
                <span class="dv-form-t">{T.pedir}</span>
                <span class="dv-campo"><small>{T.campos[0]}</small>{v.quien}</span>
                <span class="dv-campo"><small>{T.campos[2]}</small>{v.texto}</span>
                <span class="dv-enviar">{T.enviar}</span>
                <span class="dv-nota">{T.enviado} · {v.hora}</span>
              </div>
            ) : v.canal === 'llamada' || v.canal === 'sms' ? (
              <div class="dv-aviso">
                <b>{v.quien}</b>
                <span>{v.canal === 'sms' ? `“${v.texto}”` : v.texto}</span>
              </div>
            ) : (
              <div class="dv-chat">
                <span class="dv-quien"><span class="dv-av">{iniciales(v.quien)}</span>{v.quien}<i>1 {T.sinLeer}</i></span>
                <span class="dv-burbuja" lang={v.enLang ? otro : undefined}>{v.texto}</span>
                <span class="dv-escribe">{T.escribe}</span>
              </div>
            )}
          </div>
        ))}

        <div class="da-hoja" aria-hidden="true">
          <span class="da-hoja-luces"><i></i><i></i><i></i></span>
          <img src="/assets/bot/marcy-mini.webp" width="56" height="56" alt="" loading="lazy" decoding="async" />
          <span class="da-hoja-t da-hoja-t--1">{T.contestando}</span>
          <span class="da-hoja-t da-hoja-t--2">{T.respondidoPor}</span>
          <span class="da-spin"></span>
          <span class="da-check"><svg width="34" height="34" viewBox="0 0 34 34"><circle cx="17" cy="17" r="17" fill="#22a06b" /><path d="m10 17.5 4.6 4.6L24 12.5" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
        </div>

        <div class="da-panel">
          <div class="da-panel-cab">
            <span class="da-hoja-luces"><i></i><i></i><i></i></span>
          </div>
          <div class="da-panel-top">
            <img src="/assets/bot/marcy-mini.webp" width="52" height="52" alt="" loading="lazy" decoding="async" />
            <span class="da-panel-tit"><b>{T.panel}</b><small><span class="da-punto"></span>{T.enLinea}</small></span>
          </div>
          <ul class="da-filas">
            {T.filas.map((f, i) => (
              <li class:list={['da-fila', `da-fila--${f.est}`]} style={`--j:${i}`}>
                <span class:list={['dv-ico', 'da-fila-ico', `dv-ico--${f.canal}`]}>
                  {LogoMarca && MARCA[f.canal]
                    ? <LogoMarca id={MARCA[f.canal]} size={22} tono="color" titulo="" />
                    : <Fragment set:html={icono(f.canal)} />}
                </span>
                <span class="da-fila-txt"><b>{T.canales[f.canal]}</b><small>{f.txt}</small></span>
                <span class="da-estado"><i></i>{f.est === 'ok' ? T.respondido : T.avisa}</span>
              </li>
            ))}
          </ul>
          <span class="da-sello">
            <svg width="104" height="104" viewBox="0 0 132 132">
              <defs><path id={`${uid}-c`} d="M66 66m-48 0a48 48 0 1 1 96 0a48 48 0 1 1-96 0" /></defs>
              <circle cx="66" cy="66" r="62" fill="none" stroke="currentColor" stroke-width="2.5" />
              <circle cx="66" cy="66" r="36" fill="none" stroke="currentColor" stroke-width="1.5" />
              <text font-size="12.5" font-weight="700" letter-spacing="2.2" fill="currentColor" font-family="system-ui, sans-serif"><textPath href={`#${uid}-c`}>{T.sello} · {T.sello} ·</textPath></text>
              <path d="m52 66 10 10 19-21" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </div>
      </Escritorio>
    </Portatil>
  </div>
</section>

<style>
  .da {
    --da-t: 40px;
    position: relative; isolation: isolate; overflow: clip;
    min-height: max(100svh, 800px);
    display: flex; flex-direction: column; align-items: center;
    padding: calc(var(--nav-h, 72px) + 24px) 16px 0;
    text-align: center; color: var(--w-ink, #f0ede8);
  }
  @media (min-width: 375px) { .da { --da-t: 46px; } }
  @media (min-width: 640px) { .da { --da-t: 54px; padding-top: calc(var(--nav-h, 72px) + 28px); } }
  @media (min-width: 1024px) { .da { --da-t: 68px; padding-top: calc(var(--nav-h, 72px) + 32px); } }
  /* 80 px solo con alto de sobra: a 1440×900 el titular de 2 líneas a 80 y una bajada
     larga dejaban el portátil en y≈575 (dos tercios de la demo bajo el pliegue) */
  @media (min-width: 1280px) and (min-height: 1000px) { .da { --da-t: 80px; padding-top: calc(var(--nav-h, 72px) + 40px); } }
  @media (min-width: 1920px) and (min-height: 1200px) { .da { --da-t: 96px; } }

  /* cielo: noche → amanecer teal (600 ms) */
  .da-cielo { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .da-cielo > span, .da-cielo > :global(*) { position: absolute; inset: 0; }
  .da-noche {
    background:
      radial-gradient(60% 40% at 50% 100%, rgba(79,195,161,.10), transparent 70%),
      linear-gradient(180deg, #07080d 0%, #0b0e18 45%, #10162a 100%);
  }
  .da-alba { background: var(--w-dawn-teal), linear-gradient(180deg, #08090f 0%, #0d1622 55%, #12302d 100%); opacity: 1; transition: opacity .6s ease; }

  /* texto: el acto 1 vive ENCIMA del H1 y se funde; el H1 nunca baja de opacidad */
  .da-texto { position: relative; z-index: 2; max-width: 1100px; display: grid; justify-items: center; }
  .da-acto1 {
    margin: 0 0 .25em; font-family: var(--font-display); font-weight: 500;
    font-size: calc(var(--da-t) * .6); line-height: 1.1; letter-spacing: -.03em;
    color: var(--w-ink-70, rgba(240,237,232,.7));
    opacity: 0; transition: opacity .6s ease;
  }
  .da-h1 :global(h1) {
    margin: 0; font-family: var(--font-display); font-weight: 500;
    font-size: var(--da-t); line-height: 1; letter-spacing: -.035em;
    color: var(--w-ink, #f0ede8); text-wrap: balance;
  }
  .da-h1 :global(h1 em) { font-style: normal; color: var(--accent-teal, #4fc3a1); }
  .da-bajada :global(p) {
    margin: clamp(10px, 1.2vw, 16px) auto 0; max-width: 60ch;
    font-size: clamp(17px, 1rem + .3vw, 21px); line-height: 1.32; letter-spacing: -.012em; color: var(--w-ink-70, rgba(240,237,232,.7));
  }
  .da-acciones { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: clamp(18px, 2vw, 26px); }
  /* escritorio: bajada más ancha y algo menor (3 líneas, no 4) y aire justo, para que
     el portátil suba y la demo quede casi entera en la primera pantalla */
  @media (min-width: 1024px) {
    .da-bajada :global(p) { max-width: 900px; font-size: 19px; line-height: 1.34; margin-top: 12px; }
    .da-acciones { margin-top: 20px; }
  }

  /* portátil */
  .da-mac { position: relative; z-index: 1; width: min(976px, 100%); margin-top: clamp(28px, 3vw, 44px); }
  @media (min-width: 1024px) { .da-mac { margin-top: 30px; } }
  .da-ejemplo { position: absolute; right: 5%; top: -22px; font-family: var(--font-mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--w-ink-60, rgba(240,237,232,.6)); }
  .da-pie { position: relative; z-index: 2; max-width: 1100px; }
  /* Móvil: la demo va justo bajo el H1 (si no, una bajada larga la deja fuera de la
     primera pantalla); bajada y botones debajo. El orden del DOM no cambia. */
  @media (max-width: 639px) {
    .da-mac { order: 2; margin-top: 44px; } /* aire para el rótulo "Ejemplo" (va a -22 px) */
    .da-pie { order: 3; margin: 26px 0 48px; }
    .da-acciones { flex-direction: column; align-items: center; }
    .da-mac :global(.dv--extra) { display: none; }
  }

  /* ventanas oscuras (cada canal con su forma) */
  .dv {
    position: absolute; z-index: 1;
    border-radius: 12px; overflow: hidden;
    background: #1d1d22; color: #ececf0;
    box-shadow: 0 0 0 .5px rgba(255,255,255,.14), 0 18px 40px -10px rgba(0,0,0,.65);
    font-size: 14px; text-align: left;
    transition: opacity .3s ease, transform .4s cubic-bezier(.22,1,.36,1);
  }
  .dv-cab { display: flex; align-items: center; gap: 9px; height: 44px; padding: 0 14px; background: #24242a; border-bottom: 1px solid rgba(255,255,255,.06); }
  .dv-cab b { font-size: 14px; font-weight: 600; }
  .dv-cab small { margin-left: auto; font-size: 12px; color: #9a9aa3; }
