    transition: opacity .4s ease, transform .5s cubic-bezier(.22,1,.36,1);
  }
  .da-panel-cab { height: 34px; position: relative; }
  .da-panel-top { display: flex; align-items: center; gap: 14px; padding: 2px 28px 14px; border-bottom: 1px solid rgba(0,0,0,.07); text-align: left; }
  .da-panel-top img { width: 52px; height: 52px; border-radius: 15px; background: #15161b; object-fit: cover; }
  .da-panel-tit { display: grid; gap: 3px; }
  .da-panel-tit b { font-size: 24px; font-weight: 600; letter-spacing: -.02em; }
  .da-panel-tit small { display: inline-flex; align-items: center; gap: 7px; font-size: 13.5px; color: #4a4743; }
  .da-punto { width: 8px; height: 8px; border-radius: 50%; background: #22a06b; }
  .da.is-vivo .da-punto { animation: da-late 2s ease-in-out infinite; }
  @keyframes da-late { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: .35; transform: scale(.7); } }
  .da-filas { list-style: none; margin: 0; padding: 8px 18px 16px; text-align: left; }
  .da-fila { display: grid; grid-template-columns: 34px 1fr auto; align-items: center; gap: 14px; padding: 8px 10px; border-radius: 10px; }
  .da-fila + .da-fila { border-top: 1px solid rgba(0,0,0,.05); }
  .da-fila-ico { width: 34px; height: 34px; border-radius: 9px; transition: opacity .3s ease; }
  .da-fila-ico.dv-ico--whatsapp { background: #25d366; } .da-fila-ico.dv-ico--whatsapp :global(path) { fill: #fff; }
  .da-fila-ico.dv-ico--instagram { background: #1f1f1f; }
  .da-fila-ico.dv-ico--messenger { background: #eef3ff; }
  .da-fila-ico.dv-ico--form { background: #e3f4ee; color: #0b7a5f; }
  .da-fila-ico.dv-ico--web { background: #f6ecd9; color: #8a5a12; }
  .da-fila-ico.dv-ico--llamada { background: #fde8e6; color: #c43d33; }
  .da-fila-ico.dv-ico--sms { background: #e6f4e6; color: #2f7d32; }
  .da-fila-txt { display: grid; gap: 1px; }
  .da-fila-txt b { font-size: 15.5px; font-weight: 600; }
  .da-fila-txt small { font-size: 13px; color: #5d5a55; }
  .da-estado { display: inline-flex; align-items: center; gap: 7px; height: 28px; padding: 0 12px; border-radius: 99px; font-size: 13px; font-weight: 600; background: #e6f6ee; color: #0e6b45; transition: opacity .3s ease; }
  .da-estado i { width: 7px; height: 7px; border-radius: 50%; background: #22a06b; }
  .da-fila--aviso .da-estado { background: #fbf1df; color: #8a5a12; }
  .da-fila--aviso .da-estado i { background: #d99a2b; }
  .da-sello {
    position: absolute; right: 22px; top: 10px; width: 104px; height: 104px; color: #0f5e8c;
    transform: rotate(-14deg); transition: opacity .3s ease, transform .3s cubic-bezier(.3,1.3,.5,1);
  }
  .da-sello svg { display: block; }

  /* ── fase INICIO (acto 1: guion en línea, primera visita) ── */
  .da[data-da-fase="inicio"] .da-acto1 { opacity: 1; }
  .da[data-da-fase="inicio"] .da-alba { opacity: 0; }
  /* fondo de la pantalla: noche en el acto 1, amanecer en el acto 2 (cruce de 600 ms del Escritorio) */
  .da:not([data-da-fase="inicio"]) :global(.esc-cielo-dia) { opacity: 1; }
  .da:not([data-da-fase="inicio"]) :global(.esc-estrellas) { opacity: 0; }
  /* barra de menús: 11:58 p. m. de noche, hora de la mañana en el acto 2 */
  .da:not([data-da-fase="inicio"]) :global(.esc-hora--noche) { display: none; }
  .da:not([data-da-fase="inicio"]) :global(.esc-hora--dia) { display: inline; }
  .da[data-da-fase="inicio"] .dv:not(.is-on) { opacity: 0; transform: translateY(14px) scale(.96); }
  .da[data-da-fase="inicio"] .da-hoja:not(.is-on) { opacity: 0; transform: scale(.96); }
  .da[data-da-fase="inicio"] .da-hoja:not(.is-ok) .da-hoja-t--2,
  .da[data-da-fase="inicio"] .da-hoja:not(.is-ok) .da-check { opacity: 0; }
  .da[data-da-fase="inicio"] .da-hoja:not(.is-ok) .da-check { transform: scale(.6); }
  .da[data-da-fase="inicio"] .da-hoja.is-ok .da-hoja-t--1,
  .da[data-da-fase="inicio"] .da-hoja.is-ok .da-spin { opacity: 0; }
  .da[data-da-fase="inicio"] .da-hoja:not(.is-ok) .da-spin { animation: da-gira .9s linear infinite; }
  @keyframes da-gira { to { transform: rotate(360deg); } }
  .da[data-da-fase="inicio"] .da-panel { opacity: 0; transform: scale(.94) translateY(16px); }
  .da[data-da-fase="inicio"] .da-sello { opacity: 0; transform: rotate(-14deg) scale(1.3); }
  .da[data-da-fase="inicio"] .da-fila:not(.is-on) .da-fila-ico { opacity: .28; }
  .da[data-da-fase="inicio"] .da-fila:not(.is-on) .da-estado { opacity: 0; }

  /* ── fase ACTO 2 (también el estado del HTML: "final") ── */
  .da:not([data-da-fase="inicio"]) .dv { opacity: 0; transform: scale(.98); pointer-events: none; }
  .da:not([data-da-fase="inicio"]) .da-hoja { opacity: 0; transform: scale(1.04); }
  .da:not([data-da-fase="inicio"]) .da-hoja .da-hoja-t--1, .da:not([data-da-fase="inicio"]) .da-hoja .da-spin { opacity: 0; }
  .da[data-da-fase="final"] .da-sello { opacity: 1; }
  .da[data-da-fase="acto2"] .da-sello:not(.is-on) { opacity: 0; transform: rotate(-14deg) scale(1.3); }
  .da[data-da-fase="acto2"] .da-fila:not(.is-on) .da-fila-ico { opacity: .28; }
  .da[data-da-fase="acto2"] .da-fila:not(.is-on) .da-estado { opacity: 0; }

  @media (prefers-reduced-motion: reduce) {
    .da *, .da *::before, .da *::after { transition: none !important; animation: none !important; }
  }
</style>

<script>
  import { secuencia, vigilar, reducido, sesion } from './mac';

  for (const raiz of document.querySelectorAll<HTMLElement>('[data-w2-dosactos]')) {
    if (raiz.dataset.listo) continue;
    raiz.dataset.listo = '1';
    const mac = raiz.querySelector<HTMLElement>('.da-mac');
    const vida = () => vigilar(mac ?? raiz, { umbral: 0.1, alEntrar: () => {}, vivo: (si) => raiz.classList.toggle('is-vivo', si && raiz.dataset.daFase !== 'inicio') });
    if (raiz.dataset.daFase !== 'inicio' || reducido()) { raiz.dataset.daFase = 'final'; vida(); continue; }

    const movil = matchMedia('(max-width: 639px)').matches;
    const off = movil ? 500 : 0;
    const ventanas = [...raiz.querySelectorAll<HTMLElement>('.dv')].filter((v) => !(movil && v.classList.contains('dv--extra')));
    const hoja = raiz.querySelector<HTMLElement>('.da-hoja');
    const filas = [...raiz.querySelectorAll<HTMLElement>('.da-fila')];
    const sello = raiz.querySelector<HTMLElement>('.da-sello');

    const pasos: Array<[number, () => void]> = [];
    ventanas.forEach((v, i) => pasos.push([off + 700 + i * 280, () => v.classList.add('is-on')]));
    const tFin = off + 700 + (ventanas.length - 1) * 280;
    const t0 = Math.max(tFin + 600, off + 3900);
    pasos.push(
      [t0, () => hoja?.classList.add('is-on')],
      [t0 + 600, () => hoja?.classList.add('is-ok')],
      [t0 + 1300, () => { raiz.dataset.daFase = 'acto2'; sesion.set('w2-dosactos', '1'); }],
    );
    filas.forEach((f, i) => pasos.push([t0 + 1700 + i * 170, () => f.classList.add('is-on')]));
    pasos.push(
      [t0 + 1700 + filas.length * 170 + 60, () => sello?.classList.add('is-on')],
      [t0 + 1700 + filas.length * 170 + 500, () => { raiz.dataset.daFase = 'final'; vida(); }],
    );
    // Es el hero: arranca al cargar (si por un ancla llega fuera de vista, arranca al entrar).
    const sec = secuencia(pasos);
    let hecho = false;
    const corta = vigilar(raiz, { umbral: 0.2, alEntrar: () => { if (!hecho) { hecho = true; sec.play(); corta(); } } });
  }
</script>
