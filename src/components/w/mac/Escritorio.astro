---
// ─────────────────────────────────────────────────────────────
// P08 · Escritorio: contenido de la pantalla del Portatil (px de la pantalla
// fuente, 1378×895). Barra de menús GENÉRICA (sin manzana ni nombre de sistema),
// dock de 12 baldosas, cursor que viaja y pantalla de bloqueo opcional.
// Fondo: universo Marcyan (noche + horizonte de planeta con amanecer oro), sin
// dunas ni paisaje dibujado (E-38). `data-esc-dia="true"` cruza a amanecer.
// Control desde la escena (atributos en la raíz o en sus nodos):
//   data-esc-fase="bloqueo|escritorio" · [data-w2-menu-app] (texto)
//   [data-w2-dock="<id>"] + clase is-rebote · [data-w2-cursor] (style.translate)
// horaDia: segunda hora de la barra (la de la mañana); se ve con data-esc-dia="true"
//   o cuando la escena muestra .esc-hora--dia (EscenaDosActos, acto 2).
// Logos: LogoMarca (P06), con el cerrojo legal de LICENCIAS.md.
// ─────────────────────────────────────────────────────────────
import { DOCK_ORDEN, type DockId } from './mac';
import LogoMarca from '../marcas/LogoMarca.astro';
import type { MarcaId } from '../marcas/datos';

interface Props {
  lang?: 'es' | 'en';
  app?: string;
  hora?: string;
  horaDia?: string;
  dock?: boolean;
  cursor?: boolean;
  fase?: 'bloqueo' | 'escritorio';
  dia?: boolean;
  bloqueo?: { fecha: string; hora: string; nombre: string };
  /** false: sin fondo propio (la pantalla deja ver el paisaje del hero, WorkOS /passport). */
  fondo?: boolean;
  class?: string;
}
const {
  lang = 'es',
  app,
  hora,
  horaDia,
  dock = true,
  cursor = false,
  fase = 'escritorio',
  dia = false,
  bloqueo,
  fondo = true,
  class: cls,
} = Astro.props;

const T = {
  es: { app: 'Escritorio', menus: ['Archivo', 'Edición', 'Ver', 'Ventana', 'Ayuda'], hora: 'jue 5 nov  9:41 p. m.' },
  en: { app: 'Desktop', menus: ['File', 'Edit', 'View', 'Window', 'Help'], hora: 'Thu Nov 5  9:41 PM' },
}[lang];

// Gmail, Calendar, Maps y Claude están bajo el cerrojo legal: LogoMarca los pinta como pictograma genérico.
const MARCA: Partial<Record<DockId, MarcaId>> = {
  gmail: 'gmail', googlecalendar: 'googlecalendar', googlemaps: 'googlemaps', whatsapp: 'whatsapp',
  instagram: 'instagram', messenger: 'messenger', claude: 'claude',
};
---
<div
  class:list={['esc', cls]}
  data-w2-escritorio
  data-esc-fase={fase}
  data-esc-dia={dia ? 'true' : 'false'}
  data-esc-dock={dock ? 'true' : 'false'}
>
  {fondo && (
    <div class="esc-fondo">
      <span class="esc-cielo-dia"></span>
      <span class="esc-estrellas"></span>
      <span class="esc-alba"></span>
      <span class="esc-planeta"></span>
    </div>
  )}

  <div class="esc-ventanas"><slot /></div>

  <div class="esc-menu">
    <span class="esc-menu-izq">
      <svg class="esc-glifo" width="18" height="18" viewBox="0 0 18 18"><circle cx="9" cy="9" r="4.6" fill="currentColor" /><ellipse cx="9" cy="9" rx="8.2" ry="2.6" fill="none" stroke="currentColor" stroke-width="1.3" transform="rotate(-18 9 9)" /></svg>
      <b data-w2-menu-app>{app ?? T.app}</b>
      {T.menus.map((m) => <span>{m}</span>)}
    </span>
    <span class="esc-menu-der">
      <svg width="22" height="12" viewBox="0 0 22 12"><rect x=".6" y=".6" width="18" height="10.8" rx="3" fill="none" stroke="currentColor" stroke-opacity=".6" /><rect x="2.4" y="2.4" width="12" height="7.2" rx="1.6" fill="currentColor" /><rect x="19.8" y="4" width="1.6" height="4" rx=".8" fill="currentColor" fill-opacity=".6" /></svg>
      <svg width="17" height="13" viewBox="0 0 17 13"><path d="M8.5 12.2 6.2 9.6a3.3 3.3 0 0 1 4.6 0zM3.6 7a7 7 0 0 1 9.8 0l-1.4 1.5a5 5 0 0 0-7 0zM1 4.3a10.7 10.7 0 0 1 15 0l-1.4 1.5a8.7 8.7 0 0 0-12.2 0z" fill="currentColor" /></svg>
      <svg width="15" height="15" viewBox="0 0 15 15"><circle cx="6.3" cy="6.3" r="4.6" fill="none" stroke="currentColor" stroke-width="1.6" /><path d="m9.8 9.8 3.8 3.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
      <span class:list={['esc-hora', 'esc-hora--noche', horaDia && 'esc-hora--doble']} data-reloj="menu">{hora ?? T.hora}</span>
      {horaDia && <span class="esc-hora esc-hora--dia" data-reloj="menu">{horaDia}</span>}
    </span>
  </div>

  {dock && (
    <div class="esc-dock">
      {DOCK_ORDEN.map((id) => (
        <span class:list={['esc-app', `esc-app--${id}`]} data-w2-dock={id}>
          {MARCA[id] ? (
            <LogoMarca id={MARCA[id]!} size={58} tono="color" baldosa titulo="" />
          ) : id === 'marcy' ? (
            <span class="esc-baldosa"><img src="/assets/bot/marcy-mini-128.webp" srcset="/assets/bot/marcy-mini-32.webp 32w, /assets/bot/marcy-mini-64.webp 64w, /assets/bot/marcy-mini-96.webp 96w, /assets/bot/marcy-mini-128.webp 128w, /assets/bot/marcy-mini.webp 256w" sizes="36px" width="58" height="58" alt="" loading="lazy" decoding="async" /></span>
          ) : id === 'navegador' ? (
            <span class="esc-baldosa">
              <svg width="40" height="40" viewBox="0 0 40 40"><circle cx="20" cy="20" r="15" fill="none" stroke="#fff" stroke-width="2.2" /><ellipse cx="20" cy="20" rx="6.5" ry="15" fill="none" stroke="#fff" stroke-width="2" /><path d="M5.5 15h29M5.5 25h29" stroke="#fff" stroke-width="2" /></svg>
            </span>
          ) : id === 'archivos' ? (
            <span class="esc-baldosa">
              <svg width="40" height="40" viewBox="0 0 40 40"><g fill="none" stroke="#e9e7e2" stroke-width="2" stroke-linejoin="round"><rect x="9" y="9" width="22" height="22" rx="4" /><path d="M9 21h7l2 3h4l2-3h7" /></g></svg>
            </span>
          ) : id === 'notas' ? (
            <span class="esc-baldosa">
              <svg width="40" height="40" viewBox="0 0 40 40"><g fill="none" stroke="#e9e7e2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 28.5 13.2 24 25 12.2a2.3 2.3 0 0 1 3.2 3.2L16.4 27.2z" /><path d="M23 14.2l3.2 3.2" /><path d="M12 31h16" stroke-opacity=".55" /></g></svg>
            </span>
          ) : (
            <span class="esc-baldosa">
              <svg width="40" height="40" viewBox="0 0 40 40"><g stroke="#e9e7e2" stroke-width="2" stroke-linecap="round"><path d="M11 14h18M11 20h18M11 26h18" stroke-opacity=".5" /><circle cx="16" cy="14" r="2.6" fill="#2a2b31" /><circle cx="24" cy="20" r="2.6" fill="#2a2b31" /><circle cx="14" cy="26" r="2.6" fill="#2a2b31" /></g></svg>
            </span>
          )}
        </span>
      ))}
    </div>
  )}

  {cursor && (
    <span class="esc-cursor" data-w2-cursor>
      <span class="esc-cursor-halo"></span>
      <svg width="26" height="34" viewBox="0 0 26 34"><path d="M2 2v26l6.5-6.2 4.4 10.4 4.2-1.8-4.3-10.1H22z" fill="#111" stroke="#fff" stroke-width="2" stroke-linejoin="round" /></svg>
    </span>
  )}

  {bloqueo && (
    <div class="esc-bloqueo">
      <p class="esc-bl-fecha" data-reloj="fecha">{bloqueo.fecha}</p>
      <p class="esc-bl-hora" data-reloj="hm">{bloqueo.hora}</p>
      <div class="esc-bl-user">
        <span class="esc-bl-av"><svg width="64" height="64" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="9.6" r="4.3" fill="currentColor" /><path d="M2.8 25c.7-5.5 4.6-8.7 9.2-8.7s8.5 3.2 9.2 8.7z" fill="currentColor" /></svg></span>
        <p>{bloqueo.nombre}</p>
      </div>
    </div>
  )}
</div>

<style>
  .esc {
    position: absolute; inset: 0; overflow: hidden;
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
    color: #fff; text-align: left;
  }
  /* ── fondo: noche + planeta con amanecer ─────────────── */
  .esc-fondo { position: absolute; inset: 0; background: linear-gradient(180deg, #080a12 0%, #10142a 45%, #1c1d33 72%, #2a2230 100%); }
  .esc-fondo > span { position: absolute; inset: 0; }
  .esc-cielo-dia {
    background: linear-gradient(180deg, #2f5466 0%, #5f8b94 26%, #a9bdb3 46%, #e6d2ac 64%, #efbf7f 76%, #b9714f 100%);
    opacity: 0; transition: opacity .6s ease;
  }
  .esc-estrellas {
    background:
      radial-gradient(1.4px 1.4px at 12% 18%, rgba(255,255,255,.7), transparent 60%),
      radial-gradient(1.2px 1.2px at 28% 8%, rgba(255,255,255,.55), transparent 60%),
      radial-gradient(1.6px 1.6px at 47% 22%, rgba(255,255,255,.6), transparent 60%),
      radial-gradient(1.1px 1.1px at 63% 11%, rgba(255,255,255,.5), transparent 60%),
      radial-gradient(1.5px 1.5px at 78% 26%, rgba(255,255,255,.65), transparent 60%),
      radial-gradient(1.2px 1.2px at 91% 9%, rgba(255,255,255,.5), transparent 60%),
      radial-gradient(1px 1px at 7% 40%, rgba(255,255,255,.4), transparent 60%),
      radial-gradient(1.3px 1.3px at 86% 44%, rgba(255,255,255,.45), transparent 60%),
      radial-gradient(1px 1px at 38% 38%, rgba(255,255,255,.35), transparent 60%);
    transition: opacity .6s ease;
  }
  .esc-alba {
    background: radial-gradient(70% 38% at 50% 78%, rgba(232,184,108,.42) 0%, rgba(232,184,108,.12) 45%, transparent 75%);
    transition: opacity .6s ease;
  }
  .esc-planeta {
    inset: auto -30% -128% -30% !important; height: 175%;
    border-radius: 50%;
    background: radial-gradient(60% 50% at 50% 0%, #1b1a22 0%, #0b0b10 60%, #060609 100%);
    box-shadow: 0 -2px 0 rgba(240,200,130,.55), 0 -10px 40px rgba(232,184,108,.35);
    transition: box-shadow .6s ease;
  }
  .esc[data-esc-dia="true"] .esc-cielo-dia { opacity: 1; }
  .esc[data-esc-dia="true"] .esc-estrellas { opacity: 0; }
  .esc[data-esc-dia="true"] .esc-planeta { box-shadow: 0 -2px 0 rgba(255,236,200,.8), 0 -14px 50px rgba(255,214,160,.5); }

  .esc-ventanas { position: absolute; inset: 0; z-index: 10; }

  /* ── barra de menús ─────────────────────────────── */
  .esc-menu {
    position: absolute; top: 0; left: 0; right: 0; height: 32px; z-index: 30;
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 22px 0 18px;
    font-size: 14px; letter-spacing: -.01em;
    background: rgba(8,8,12,.28);
    transition: opacity .4s ease;
  }
  .esc-menu-izq, .esc-menu-der { display: flex; align-items: center; gap: 22px; }
  .esc-menu-izq b { font-weight: 700; }
  .esc-menu-izq span, .esc-menu-der span { opacity: .92; }
  .esc-menu-der { gap: 18px; font-variant-numeric: tabular-nums; }
  .esc-menu-der span { margin-left: 4px; }
  .esc-hora--dia { display: none; }
  .esc[data-esc-dia="true"] .esc-hora--doble { display: none; }
  .esc[data-esc-dia="true"] .esc-hora--dia { display: inline; }
  .esc-glifo { margin-right: -4px; }
  /* la muesca tapa el centro: el contenido vive a los lados */

  /* ── dock ─────────────────────────────── */
  .esc-dock {
    position: absolute; left: 50%; bottom: 12px; translate: -50%; z-index: 30;
    display: flex; gap: 8px; padding: 8px;
    border-radius: 22px;
    background: rgba(46,46,52,.94);
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.14), 0 10px 30px rgba(0,0,0,.35);
    transition: opacity .45s ease, transform .45s cubic-bezier(.22,1,.36,1);
  }
  .esc-app { position: relative; display: block; width: 58px; height: 58px; }
  .esc-app :global(svg), .esc-app img { display: block; }
  .esc-baldosa {
    display: grid; place-items: center; width: 58px; height: 58px; overflow: hidden;
    border-radius: 22.5%;
    box-shadow: 0 0 0 .5px rgba(0,0,0,.1), 0 1px 2px rgba(0,0,0,.16);
    background: #fff; color: #202124;
  }
  /* archivos, notas y ajustes: baldosas GENÉRICAS de grafito con glifo de trazo
     (sin la carpeta azul, las notas amarillas ni el engranaje de un sistema concreto) */
  .esc-app--archivos .esc-baldosa, .esc-app--notas .esc-baldosa, .esc-app--ajustes .esc-baldosa {
    background: linear-gradient(180deg, #3a3b42, #2a2b31); box-shadow: inset 0 0 0 1px rgba(255,255,255,.08), 0 1px 2px rgba(0,0,0,.2);
  }
  .esc-app--navegador .esc-baldosa { background: linear-gradient(160deg, #4fc3a1, #1e7f99 70%, #165a7a); }
  .esc-app--whatsapp .esc-baldosa { background: #25d366; }
  .esc-app--claude .esc-baldosa { background: #f0ede8; }
  .esc-app--marcy .esc-baldosa { background: radial-gradient(circle at 50% 35%, #2a2b33, #121318); }
  .esc-app--marcy img { width: 58px; height: 58px; object-fit: cover; }
  .esc-app::after { /* punto de app abierta */
    content: ""; position: absolute; left: 50%; bottom: -6px; translate: -50%;
    width: 4px; height: 4px; border-radius: 50%; background: rgba(255,255,255,.75);
    opacity: 0; transition: opacity .3s ease;
  }
  .esc-app.is-abierta::after { opacity: 1; }
  .esc-app.is-rebote { animation: esc-rebote .62s cubic-bezier(.3,0,.4,1); }
  @keyframes esc-rebote {
    0%, 100% { transform: none; }
    22% { transform: translateY(-8px); } 44% { transform: none; }
    66% { transform: translateY(-8px); } 88% { transform: none; }
  }

  /* ── cursor ─────────────────────────────── */
  .esc-cursor {
    position: absolute; left: 0; top: 0; z-index: 40; display: block;
    translate: 980px 520px;
    transition: translate .8s cubic-bezier(.45,0,.2,1), opacity .3s ease;
    pointer-events: none;
  }
  .esc-cursor svg { display: block; filter: drop-shadow(0 2px 3px rgba(0,0,0,.35)); transition: transform .12s ease; transform-origin: 2px 2px; }
  .esc-cursor.is-pulsa svg { transform: scale(.9); }
  .esc-cursor-halo {
    position: absolute; left: -10px; top: -10px; width: 26px; height: 26px; border-radius: 50%;
    background: radial-gradient(circle, rgba(255,255,255,.35), transparent 70%);
    opacity: 0;
  }
  .esc.is-vivo .esc-cursor-halo { animation: esc-halo 2.4s ease-in-out infinite; }
  @keyframes esc-halo { 0%, 100% { opacity: 0; transform: scale(.7); } 50% { opacity: 1; transform: scale(1.15); } }

  /* ── bloqueo ─────────────────────────────── */
  .esc-bloqueo {
    position: absolute; inset: 0; z-index: 45; text-align: center;
    transition: opacity .5s ease;
  }
  .esc-bl-fecha { margin: 0; position: absolute; top: 86px; left: 0; right: 0; font-size: 30px; font-weight: 600; color: rgba(255,255,255,.72); }
  .esc-bl-hora {
    margin: 0; position: absolute; top: 112px; left: 0; right: 0;
    font-size: 132px; line-height: 1.1; font-weight: 700; letter-spacing: -.02em;
    background: linear-gradient(180deg, #fff 30%, rgba(255,255,255,.62));
    -webkit-background-clip: text; background-clip: text; color: transparent;
    transition: opacity .5s ease, transform .5s ease;
  }
  .esc-bl-user { position: absolute; left: 0; right: 0; bottom: 92px; display: grid; justify-items: center; gap: 10px; }
  .esc-bl-av {
    display: grid; place-items: center; width: 64px; height: 64px; border-radius: 50%;
    overflow: hidden; background: linear-gradient(180deg, #9a9ca6, #6b6d76); color: rgba(255,255,255,.92);
  }
  .esc-bl-user p { margin: 0; font-size: 17px; font-weight: 600; }

  /* fases */
  .esc[data-esc-fase="bloqueo"] .esc-menu,
  .esc[data-esc-fase="bloqueo"] .esc-dock { opacity: 0; }
  .esc[data-esc-fase="bloqueo"] .esc-dock { transform: translateY(24px); }
  .esc[data-esc-fase="bloqueo"] .esc-cursor { opacity: 0; }
  .esc[data-esc-fase="escritorio"] .esc-bloqueo { opacity: 0; }
  .esc[data-esc-fase="escritorio"] .esc-bl-hora { transform: translateY(-16px); }

  @media (prefers-reduced-motion: reduce) {
    .esc *, .esc *::before, .esc *::after { transition: none !important; animation: none !important; }
  }
</style>

<script>
  import { iniciaRelojes } from '../reloj';
  iniciaRelojes();
</script>
