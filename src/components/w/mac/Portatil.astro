---
// ─────────────────────────────────────────────────────────────
// P08 · Portatil (G-07, maqueta de dispositivo mínima: CSS + SVG, sin imagen).
// Portátil GENÉRICO (§1.4): sin manzana, sin nombre de marca en pantalla.
// Medidas del original W2N-03 (N/css-passport-reglas.txt):
//   tapa 1415×933 fuente · marco #09090b 17,75 / 18,5 / 20,25 · radio 35 arriba
//   · doble filo #6f7074 + #a1a2a6 · muesca 177×30 con cámara de 5 px
//   · pantalla 1378×895 fuente, escalada con consultas de contenedor
//     (scale = 100cqw / 1415px; donde el navegador no divide longitudes,
//      un ResizeObserver escribe --pt-s; ver script).
// Props:
//   ancho  → ancho máximo del conjunto (base incluida), por defecto 990
//   tapa   → 'abierta' | 'scroll'. 'scroll': la tapa gira de -90° a 0° con
//            animation-timeline: view(). Por defecto en contain 0% → contain 70%: empieza
//            con la pieza ENTERA ya encuadrada, nunca al asomar (E-57 regla 4; v3), con la
//            curva de pt-gira (compositor, sin listener: E-50). Sin view(): se abre por
//            tiempo (1,2 s) con el 85 % de la pieza a la vista. Reducir movimiento: abierta.
//            Una escena puede dar su propia línea y rango heredando --pt-linea y
//            --pt-rango (EscenaAbreApps: portátil fijado y centrado en la ventana).
//   base   → pinta la base y la bisagra (por defecto true)
//   encendida → false deja la pantalla apagada (la escena la enciende con
//            data-pt-encendida="true")
// Slot por defecto: el contenido de la pantalla (px de la pantalla fuente).
// ─────────────────────────────────────────────────────────────
interface Props {
  ancho?: number;
  tapa?: 'abierta' | 'scroll';
  base?: boolean;
  encendida?: boolean;
  class?: string;
}
const { ancho = 990, tapa = 'abierta', base = true, encendida = true, class: cls } = Astro.props;
---
<div
  class:list={['pt', cls]}
  data-w2-portatil
  data-pt-tapa={tapa}
  data-pt-base={base ? 'true' : 'false'}
  data-pt-encendida={encendida ? 'true' : 'false'}
  style={`--pt-w:${ancho}px`}
  aria-hidden="true"
>
  <div class="pt-zona">
    <div class="pt-tapa">
      <div class="pt-fuente">
        <div class="pt-pantalla">
          <slot />
          <div class="pt-apagada"></div>
        </div>
        <div class="pt-marco"></div>
        <div class="pt-muesca">
          <svg width="177" height="30" viewBox="0 0 177 30"><path d="M0 0h177c-6 0-9 3-9 9v9c0 7-5 12-12 12H21c-7 0-12-5-12-12V9c0-6-3-9-9-9z" /></svg>
          <span class="pt-camara"></span>
        </div>
      </div>
      <span class="pt-canto"></span>
    </div>
  </div>
  {base && (
    <div class="pt-base">
      <span class="pt-sombra"></span>
      <span class="pt-pie pt-pie--i"></span>
      <span class="pt-pie pt-pie--d"></span>
      <span class="pt-bisagra"></span>
      <span class="pt-hendidura"></span>
    </div>
  )}
</div>

<style>
  .pt {
    /* el conjunto mide --pt-w con la base; la tapa es 1/1,08 de ese ancho */
    width: min(100%, var(--pt-w));
    margin-inline: auto;
    position: relative;
    container-type: inline-size;
    view-timeline: --pt-vista block;
  }
  .pt-zona {
    position: relative;
    width: calc(100% / 1.08);
    margin-inline: auto;
    aspect-ratio: 1415 / 933;
    container-type: inline-size;
    perspective: 260cqw;
    perspective-origin: 50% 20%;
    /* la tapa casi cerrada (giro hacia quien mira) se proyecta POR DEBAJO de la
       bisagra y colgaba como un trapecio oscuro bajo la base: se recorta en la
       línea de la bisagra; por arriba y a los lados queda holgura para el 3D */
    clip-path: inset(-40% -12% 0 -12%);
  }
  .pt-tapa {
    position: absolute; inset: 0;
    transform-origin: 50% 100%;
    transform-style: preserve-3d;
  }
  .pt-fuente {
    --pt-s: .5;
    position: absolute; top: 0; left: 0;
    width: 1415px; height: 933px;
    transform-origin: 0 0;
    transform: scale(var(--pt-s));
  }
  @supports (width: calc(100cqw / 1415px * 1px)) {
    .pt-fuente { --pt-s: calc(100cqw / 1415px); }
  }
  .pt-pantalla {
    position: absolute; top: 17.75px; left: 18.5px;
    width: 1378px; height: 895px;
    overflow: hidden; isolation: isolate;
    background: #050506;
    -webkit-font-smoothing: antialiased;
  }
  .pt-pantalla::after {
    content: ""; position: absolute; inset: 0; z-index: 60; pointer-events: none;
    border-radius: 18.75px 18.75px 5px 5px;
    box-shadow: 0 0 0 20px #09090b;
  }
  .pt-apagada {
    position: absolute; inset: 0; z-index: 55; pointer-events: none;
    background: linear-gradient(160deg, rgba(255,255,255,.07), rgba(0,0,0,0) 45%), #060607;
    opacity: 0;
    transition: opacity .7s cubic-bezier(.22,1,.36,1) .15s;
  }
  .pt[data-pt-encendida="false"] .pt-apagada { opacity: 1; transition-duration: .25s; transition-delay: 0s; }
  .pt-marco {
    position: absolute; inset: 0; pointer-events: none;
    border: solid #09090b; border-width: 17.75px 18.5px 20.25px;
    border-radius: 35px 35px 15px 15px;
    box-shadow: 0 0 0 1px #6f7074, 0 0 0 2px #a1a2a6, inset 0 0 0 1.25px #262628;
  }
  .pt-muesca { position: absolute; top: 13.75px; left: 50%; translate: -50%; width: 177px; height: 30px; z-index: 2; }
  .pt-muesca svg { display: block; fill: #09090b; }
  .pt-camara {
    position: absolute; top: 10.25px; right: 36px; width: 5.25px; height: 5.25px; border-radius: 50%;
    background: #131824; box-shadow: inset 0 0 2px #28304d;
  }
  /* canto de aluminio: solo se ve mientras la tapa está casi cerrada */
  .pt-canto {
    position: absolute; left: .4%; right: .4%; top: 0; height: 1.6%;
    transform-origin: 50% 0; transform: rotateX(90deg);
    background: linear-gradient(#9c9da1, #cbccd0 25%, #b3b4b8 55%, #85868a 90%, #2a2a2d);
    border-radius: 3px 3px 0 0;
    backface-visibility: hidden;
  }

  /* Base (v3, W2N-03 medida en imagen): una losa de aluminio vista de frente, NO una cuchilla.
     Alto 3,1 % del ancho (24 px en 745 del original). Cara frontal con filo de luz arriba
     (canto superior) y degradado que oscurece hacia abajo; extremos con esquina pequeña arriba
     y grande abajo; hendidura para el pulgar centrada (17 % del ancho, media altura); dos pies
     oscuros bajo la losa al 5,5 % de cada extremo; sombra de contacto debajo. Todo en cqw del
     conjunto (.pt es contenedor): escala igual de 320 a 1440 sin reglas por tamaño. */
  .pt-base {
    position: relative; display: block;
    width: 100%; height: 3.1cqw;
    margin-top: -.12cqw;
    border-radius: .55cqw .55cqw 1.7cqw 1.7cqw / .55cqw .55cqw 1.95cqw 1.95cqw;
    background:
      linear-gradient(90deg, rgba(0,0,0,.34), rgba(0,0,0,.08) 1.6%, rgba(0,0,0,0) 5% 95%, rgba(0,0,0,.08) 98.4%, rgba(0,0,0,.34)),
      linear-gradient(180deg, #eef0f2 0, #d3d4d8 6%, #c3c4c8 25%, #a3a4a8 31%, #9a9b9f 55%, #838488 80%, #626367 100%);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.8), inset 0 -1px 0 rgba(0,0,0,.28);
  }
  .pt-sombra {
    position: absolute; left: 4%; right: 4%; top: calc(100% - .2cqw); height: 2.4cqw;
    background: radial-gradient(50% 50% at 50% 22%, rgba(0,0,0,.62), rgba(0,0,0,.28) 45%, rgba(0,0,0,0) 72%);
    pointer-events: none;
  }
  .pt-pie {
    position: absolute; top: calc(100% - .1cqw); width: 6.3%; height: .62cqw;
    border-radius: 0 0 .7cqw .7cqw / 0 0 .5cqw .5cqw;
    background: linear-gradient(180deg, #121214, #2e2f32 55%, #0d0d0f);
  }
  .pt-pie--i { left: 5.5%; }
  .pt-pie--d { right: 5.5%; }
  .pt-bisagra {
    position: absolute; left: calc((100% - 100% / 1.08) / 2 + 1.2%); right: calc((100% - 100% / 1.08) / 2 + 1.2%);
    top: 0; height: 16%;
    background: linear-gradient(#1c1c1e, #2a2a2d 70%, #0e0e10);
    border-radius: 0 0 .3cqw .3cqw;
  }
  .pt-hendidura {
    position: absolute; left: 50%; translate: -50%; top: 0;
    width: 17%; height: 46%;
    border-radius: 0 0 1.4cqw 1.4cqw / 0 0 1.2cqw 1.2cqw;
    background: linear-gradient(180deg, #7d7e82 0, #a9aaae 30%, #c6c7cb 100%);
    box-shadow: inset 0 .12cqw .18cqw rgba(0,0,0,.4), 0 1px 0 rgba(255,255,255,.35);
  }

  /* ── tapa por scroll ─────────────────────────────── */
  /* Curva de apertura (v3): cubic-bezier(.45,0,.25,1) muestreada en 13 fotogramas (lineales
     entre sí). Arranca suave al quedar fijado, la tapa está abierta al 67 % del tramo y el
     último tercio es la pantalla encendiéndose, como W2N-03. El titular de EscenaAbreApps
     usa la MISMA muestra (abre-cab-baja), así sigue al borde de la tapa sin desfase. */
  @keyframes pt-gira {
    0% { transform: rotateX(-90deg); }
    8.33% { transform: rotateX(-88.81deg); }
    16.67% { transform: rotateX(-84.32deg); }
    25% { transform: rotateX(-74.48deg); }
    33.33% { transform: rotateX(-57.64deg); }
    41.67% { transform: rotateX(-38.71deg); }
    50% { transform: rotateX(-24.36deg); }
    58.33% { transform: rotateX(-14.73deg); }
    66.67% { transform: rotateX(-8.37deg); }
    75% { transform: rotateX(-4.25deg); }
    83.33% { transform: rotateX(-1.73deg); }
    91.67% { transform: rotateX(-.4deg); }
    100% { transform: rotateX(0deg); }
  }
  @keyframes pt-enciende { 0%, 70% { opacity: 1; } 88%, 100% { opacity: 0; } }
  @supports (animation-timeline: view()) {
    .pt[data-pt-tapa="scroll"] .pt-tapa {
      animation: pt-gira linear both;
      animation-timeline: var(--pt-linea, --pt-vista);
      animation-range: var(--pt-rango, contain 0% contain 70%);
      will-change: transform;
    }
    .pt[data-pt-tapa="scroll"] .pt-apagada {
      animation: pt-enciende linear both;
      animation-timeline: var(--pt-linea, --pt-vista);
      animation-range: var(--pt-rango, contain 0% contain 70%);
    }
  }
  /* reserva sin view(): cerrada hasta que el guion pone data-pt-abierta (por tiempo) */
  @supports not (animation-timeline: view()) {
    .pt[data-pt-tapa="scroll"] .pt-tapa { transform: rotateX(-90deg); transition: transform 1.2s cubic-bezier(.22,1,.36,1); }
    .pt[data-pt-tapa="scroll"] .pt-apagada { opacity: 1; transition: opacity .7s cubic-bezier(.22,1,.36,1) .85s; }
    .pt[data-pt-tapa="scroll"][data-pt-abierta] .pt-tapa { transform: none; }
    .pt[data-pt-tapa="scroll"][data-pt-abierta] .pt-apagada { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pt[data-pt-tapa="scroll"] .pt-tapa { animation: none !important; transform: none !important; transition: none !important; }
    .pt[data-pt-tapa="scroll"] .pt-apagada { animation: none !important; opacity: 0 !important; }
    .pt-apagada { transition: none; }
  }
</style>

<script>
  // 1) Escala de la pantalla donde el CSS no divide longitudes (Firefox y otros).
  // 2) Reserva de la tapa sin view(): se abre por tiempo con el 85 % de la pieza a la vista.
  const sinDivision = !CSS.supports('width', 'calc(100cqw / 1415px * 1px)');
  const sinView = !CSS.supports('animation-timeline', 'view()');
  for (const pt of document.querySelectorAll<HTMLElement>('[data-w2-portatil]')) {
    if (pt.dataset.ptListo) continue;
    pt.dataset.ptListo = '1';
    if (sinDivision) {
      const zona = pt.querySelector<HTMLElement>('.pt-zona');
      const fuente = pt.querySelector<HTMLElement>('.pt-fuente');
      if (zona && fuente) {
        const ro = new ResizeObserver(() => fuente.style.setProperty('--pt-s', String(zona.clientWidth / 1415)));
        ro.observe(zona);
      }
    }
    if (sinView && pt.dataset.ptTapa === 'scroll') {
      const io = new IntersectionObserver((ents) => {
        if (ents.some((e) => e.intersectionRatio >= 0.85)) { pt.setAttribute('data-pt-abierta', ''); io.disconnect(); }
      }, { threshold: [0.85] });
      io.observe(pt);
    }
  }
</script>
