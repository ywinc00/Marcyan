---
// ─────────────────────────────────────────────────────────────
// P08 · VentanaApp: ventana de app DENTRO de una interfaz dibujada (los
// semáforos de color son contenido, no gramática: §0.2 E-15). Opaca (sin
// backdrop-filter, §1.8). Medidas en px de la pantalla fuente.
// Estados (data-vent-estado): 'cargando' = logo 40 px + barra fina de progreso
// (600 ms, como "Signing in to GitHub") · 'lista' = contenido + chip
// "… ✓" en la esquina (como "Signed in with Passport ✓").
// data-vent-on="false" la oculta (la escena la abre con escala + opacidad).
// Slots: por defecto (contenido), "carga" (logo de la app), "chip" (texto).
// ─────────────────────────────────────────────────────────────
interface Props {
  titulo?: string;
  url?: string;
  x: number; y: number; w: number; h: number;
  tema?: 'claro' | 'oscuro';
  estado?: 'cargando' | 'lista';
  on?: boolean;
  textoCarga?: string;
  id?: string;
  z?: number;
  /** alto del chip desde arriba (px), por defecto 48 */
  chipTop?: number;
  class?: string;
}
const { titulo, url, x, y, w, h, tema = 'claro', estado = 'lista', on = true, textoCarga, id, z = 1, chipTop = 48, class: cls } = Astro.props;
const conChip = Astro.slots.has('chip');
---
<div
  class:list={['vent', `vent--${tema}`, cls]}
  data-w2-ventana={id}
  data-vent-estado={estado}
  data-vent-on={on ? 'true' : 'false'}
  style={`left:${x}px;top:${y}px;width:${w}px;height:${h}px;z-index:${z}`}
>
  <div class="vent-barra">
    <span class="vent-luces"><i data-luz="cerrar"></i><i data-luz="min"></i><i data-luz="max"></i></span>
    {url ? (
      <span class="vent-url">
        <svg width="10" height="12" viewBox="0 0 10 12"><rect x="1" y="5" width="8" height="6.4" rx="1.4" fill="currentColor" /><path d="M2.8 5V3.6a2.2 2.2 0 0 1 4.4 0V5" fill="none" stroke="currentColor" stroke-width="1.3" /></svg>
        {url}
      </span>
    ) : titulo ? <span class="vent-titulo">{titulo}</span> : null}
  </div>
  <div class="vent-cuerpo"><slot /></div>
  <div class="vent-carga">
    <span class="vent-carga-logo"><slot name="carga" /></span>
    {textoCarga && <span class="vent-carga-txt">{textoCarga}</span>}
    <span class="vent-progreso"><i></i></span>
  </div>
  {conChip && (
    <span class="vent-chip" style={`top:${chipTop}px`}>
      <slot name="chip" />
      <svg width="14" height="14" viewBox="0 0 14 14"><circle cx="7" cy="7" r="7" fill="currentColor" /><path d="m4 7.2 2 2 4-4.4" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </span>
  )}
</div>

<style>
  .vent {
    position: absolute; overflow: hidden;
    border-radius: 10px;
    background: #fff; color: #1d1d1f;
    box-shadow: 0 0 0 .5px rgba(0,0,0,.28), 0 24px 54px -16px rgba(0,0,0,.55), 0 4px 12px rgba(0,0,0,.12);
    transform-origin: 50% 60%;
    transition: opacity .26s ease, transform .32s cubic-bezier(.22,1,.36,1);
  }
  .vent--oscuro { background: #1c1c20; color: #f2f2f4; box-shadow: 0 0 0 .5px rgba(255,255,255,.14), 0 24px 54px -16px rgba(0,0,0,.7); }
  .vent[data-vent-on="false"] { opacity: 0; transform: scale(.94) translateY(10px); }

  .vent-barra {
    position: relative; height: 38px; display: flex; align-items: center; justify-content: center;
    border-bottom: 1px solid rgba(0,0,0,.07); background: #f6f6f7;
  }
  .vent--oscuro .vent-barra { background: #232328; border-color: rgba(255,255,255,.06); }
  .vent-luces { position: absolute; left: 14px; top: 13px; display: flex; gap: 8px; }
  .vent-luces i {
    display: block; width: 12px; height: 12px; border-radius: 50%;
    background: linear-gradient(180deg, var(--lt) 22%, var(--lb) 78%);
    box-shadow: inset 0 0 0 .5px color-mix(in srgb, var(--lr) 30%, transparent);
  }
  .vent-luces i[data-luz="cerrar"] { --lt: #ec776b; --lb: #ea958b; --lr: #b40b0b; }
  .vent-luces i[data-luz="min"] { --lt: #f3bf50; --lb: #f8d764; --lr: #91190a; }
  .vent-luces i[data-luz="max"] { --lt: #7fcd4b; --lb: #acdc8a; --lr: #0a540b; }
  .vent-titulo { font-size: 13px; font-weight: 600; opacity: .78; }
  .vent-url {
    display: inline-flex; align-items: center; gap: 7px;
    min-width: 42%; justify-content: center; height: 24px; padding: 0 14px;
    border-radius: 7px; background: #e9e9ec; font-size: 12.5px; color: #3c3c43;
  }
  .vent--oscuro .vent-url { background: #2e2e34; color: #c9c9cf; }
  .vent-url svg { opacity: .55; }

  .vent-cuerpo { position: absolute; top: 38px; left: 0; right: 0; bottom: 0; overflow: hidden; transition: opacity .3s ease; }
  .vent-carga {
    position: absolute; top: 38px; left: 0; right: 0; bottom: 0;
    display: grid; place-content: center; justify-items: center; gap: 14px;
    background: inherit; opacity: 0; pointer-events: none; transition: opacity .25s ease;
  }
  .vent-carga-logo { display: grid; place-items: center; width: 40px; height: 40px; }
  .vent-carga-txt { font-size: 13px; color: #6e6e73; }
  .vent-progreso { position: relative; width: 168px; height: 3px; border-radius: 3px; background: rgba(0,0,0,.08); overflow: hidden; }
  .vent-progreso i { position: absolute; inset: 0; background: #1d1d1f; transform-origin: 0 50%; transform: scaleX(0); }
  .vent[data-vent-estado="cargando"] .vent-carga { opacity: 1; }
  .vent[data-vent-estado="cargando"] .vent-cuerpo { opacity: 0; }
  .vent[data-vent-estado="cargando"] .vent-progreso i { animation: vent-prog .6s cubic-bezier(.4,0,.2,1) forwards; }
  @keyframes vent-prog { to { transform: scaleX(1); } }

  .vent-chip {
    position: absolute; top: 48px; right: 14px; z-index: 3;
    display: inline-flex; align-items: center; gap: 7px;
    height: 28px; padding: 0 10px 0 12px; border-radius: 999px;
    background: #e6f6f0; color: #0b7a5f; font-size: 13px; font-weight: 600;
    box-shadow: inset 0 0 0 1px #bfe6d8, 0 2px 8px rgba(11,122,95,.12);
    transition: opacity .3s ease .1s, transform .3s cubic-bezier(.22,1,.36,1) .1s;
  }
  .vent-chip svg { color: #12a37f; }
  .vent[data-vent-estado="cargando"] .vent-chip { opacity: 0; transform: translateY(-4px); }

  @media (prefers-reduced-motion: reduce) {
    .vent, .vent * { transition: none !important; animation: none !important; }
  }
</style>
