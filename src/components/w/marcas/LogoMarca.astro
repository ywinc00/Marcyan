---
// ─────────────────────────────────────────────────────────────
// LogoMarca · un logo de plataforma (design/rediseno-workos-v2.md §1.4 y §2, P06).
// ÚNICA puerta de entrada de logos de marcas al sitio: ningún <svg> de marca fuera de w/marcas/.
//
//   <LogoMarca id="claude" size={24} tono="color" />          glifo con su hex oficial
//   <LogoMarca id="whatsapp" size={40} tono="color" baldosa /> icono de app (squircle 22,5 %)
//   <LogoMarca id="meta" size={24} tono="mono" />              crema SÓLIDA #F0EDE8 (listados)
//   <LogoMarca id="chatgpt-texto" size={24} />                 palabra "ChatGPT" (Space Grotesk 600)
//
// Reglas (§1.4):
// · size = alto de la caja en px (14-40). El factor óptico de datos.ts se aplica en el viewBox:
//   todos se leen del mismo tamaño y la caja de maquetación no cambia.
// · tono 'mono' = #F0EDE8 sólido, sin opacidad (la jerarquía se baja con tamaño).
// · tono 'color' = hex oficial del paquete. Las MULTICOLOR (google, googlemaps, gmail, googlecalendar, googlegemini,
//   instagram) nunca se pintan con un solo hex: en baldosa van en negro sobre blanco; sin baldosa
//   toman la tinta del contexto (--marca-tinta o currentColor: blanco sobre noche, negro sobre claro).
// · Las palabras (chatgpt-texto, applemaps-texto, bing-texto) en tono 'color' usan esa misma tinta.
// · titulo = aria-label (por defecto el título oficial). titulo="" → aria-hidden (el nombre ya está
//   escrito al lado).
// · Cerrojo legal (BLOQUEADAS en datos.ts, LICENCIAS.md): claude y los 5 de Google nunca salen como
//   logo. En baldosa o a ≥ 26 px → pictograma genérico sin marca; si no, `siBloqueada` decide:
//   'palabra' (su nombre en texto) o 'nada' (el nombre ya va escrito al lado). Por defecto, 'nada'
//   cuando titulo="" y 'palabra' en otro caso.
// Todo su CSS va dentro (Cerrojo 5): sirve también fuera de las páginas v3.
// ─────────────────────────────────────────────────────────────
import { MARCAS, BLOQUEADAS, PALABRA_BLOQUEADA, PICTO_BLOQUEADA, type MarcaId } from './datos';

interface Props {
  id: MarcaId;
  /** Alto en px, 14-40. */
  size?: number;
  tono?: 'color' | 'mono';
  /** aria-label; por defecto el título oficial. Cadena vacía = decorativo (aria-hidden). */
  titulo?: string;
  /** Icono de app: squircle radio 22,5 %. */
  baldosa?: boolean;
  class?: string;
  /** Qué pintar si la marca está bajo el cerrojo legal y no es icono de app. */
  siBloqueada?: 'palabra' | 'nada';
}

const { id, size = 24, tono = 'color', titulo, baldosa = false, class: extra = '', siBloqueada } = Astro.props;
const bloqueada = BLOQUEADAS.has(id);
const picto = bloqueada && (baldosa || size >= 26);
const modoBloq = siBloqueada ?? (titulo === '' ? 'nada' : 'palabra');
const m0 = MARCAS[id];
if (!m0) throw new Error(`LogoMarca: id desconocido "${id}"`);
// Bajo el cerrojo, fuera de un icono de app, la marca se pinta como palabra (nunca su glifo).
const m = bloqueada && !picto ? { tipo: 'texto' as const, titulo: m0.titulo, palabra: PALABRA_BLOQUEADA[id] ?? m0.titulo, optico: 1 } : m0;

const label = titulo ?? m.titulo;
const oculto = titulo === '';
const a11y = oculto ? { 'aria-hidden': 'true' } : { role: 'img', 'aria-label': label };

const CREMA = '#F0EDE8';
// viewBox con el factor óptico (centrado): f > 1 agranda el glifo sin mover la caja.
const vb = (f: number) => {
  const w = 24 / f;
  const o = +(12 - w / 2).toFixed(3);
  return `${o} ${o} ${+w.toFixed(3)} ${+w.toFixed(3)}`;
};

let fill = CREMA;
let tileBg = '';
let glyph = size;
if (m.tipo === 'trazo') {
  if (tono === 'mono') fill = m.monoBlanco ? '#FFFFFF' : CREMA;
  else if (baldosa) {
    if (m.multicolor) { tileBg = '#FFFFFF'; fill = '#111111'; }
    else if (m.baldosa === 'marca') { tileBg = `#${m.hex}`; fill = '#FFFFFF'; }
    else { tileBg = '#FFFFFF'; fill = `#${m.hex}`; }
  } else fill = m.multicolor ? 'var(--marca-tinta, currentColor)' : `#${m.hex}`;
  if (baldosa) glyph = Math.round(size * 0.58);
}
const tinta = tono === 'mono' ? CREMA : baldosa ? '#111111' : 'var(--marca-tinta, currentColor)';
const cls = ['lm', extra].filter(Boolean).join(' ');
// Bajo el cerrojo no se marca como logo de marca (las pruebas buscan data-w2-marca).
const attr = bloqueada ? { 'data-w2-bloq': id } : { 'data-w2-marca': id };
---
{picto && (
  <span class:list={[cls, 'lm--tile', 'lm--picto']} {...attr} style={`--lm-s:${size}px;--lm-bg:#FFFFFF`} {...a11y}>
    <svg width={Math.round(size * 0.6)} height={Math.round(size * 0.6)} viewBox="0 0 24 24" fill="none" stroke="#3C4043" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" focusable="false" aria-hidden="true"><path d={PICTO_BLOQUEADA[id]} /></svg>
  </span>
)}
{!picto && !(bloqueada && modoBloq === 'nada') && m.tipo === 'trazo' && !baldosa && (
  <svg class={cls} {...attr} width={size} height={size} viewBox={vb(m.optico)} fill={fill} focusable="false" {...a11y}><path d={m.d} /></svg>
)}
{!picto && m.tipo === 'trazo' && baldosa && (
  <span class={`${cls} lm--tile`} {...attr} style={`--lm-s:${size}px;--lm-bg:${tileBg}`} {...a11y}>
    <svg width={glyph} height={glyph} viewBox={vb(m.optico)} fill={fill} focusable="false" aria-hidden="true"><path d={m.d} /></svg>
  </span>
)}
{!picto && !(bloqueada && modoBloq === 'nada') && m.tipo === 'texto' && (
  <span class={`${cls} lm--word${baldosa ? ' lm--tile lm--tile-word' : ''}`} {...attr} style={`--lm-s:${size}px;--lm-ink:${tinta}${baldosa ? ';--lm-bg:#FFFFFF' : ''}`} {...a11y}>
    <span aria-hidden="true">{m.palabra}</span>
  </span>
)}

<style>
  .lm { display: inline-block; flex: none; vertical-align: middle; overflow: visible; }
  .lm--tile {
    display: inline-flex; align-items: center; justify-content: center;
    width: var(--lm-s); height: var(--lm-s);
    border-radius: 22.5%;
    background: var(--lm-bg);
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, .06);
  }
  .lm--word {
    display: inline-flex; align-items: center;
    height: var(--lm-s);
    /* Mismo alto óptico que un glifo de igual size: mayúscula ≈ 62 % de la caja. */
    font-family: var(--font-display, 'Space Grotesk Variable', 'Space Grotesk', system-ui, sans-serif);
    font-weight: 600;
    font-size: calc(var(--lm-s) * .86);
    line-height: 1;
    letter-spacing: -.035em;
    white-space: nowrap;
    color: var(--lm-ink);
  }
  .lm--tile-word {
    width: auto; padding: 0 calc(var(--lm-s) * .28);
    border-radius: calc(var(--lm-s) * .225);
    font-size: calc(var(--lm-s) * .4);
  }
</style>
