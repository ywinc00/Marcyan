---
// Escáner de señales VIVO (W-ADV-45 · design/rediseno-workos-v2.md §1.5 y §2 P04). Objeto de SISTEMA.
//
// Composición (como el original): mosaico de chips en 7 filas que RODEAN la caja central y
// le dejan su hueco (nunca se monta encima): 2 filas anchas arriba y 2 abajo, que arrancan
// del mismo margen izquierdo y se pierden por la derecha (máscara), y 3 filas a los lados
// con columnas de ANCHO FIJO pegadas a la caja. Cada chip se pinta ENTERO o no se pinta, y
// cada señal sale UNA vez por instancia: el guion reparte los 19 chips midiendo el texto
// (largo si cabe, corto si no) y salta la etiqueta "Ejemplo" y el botón de pausa.
// Chips = señales REALES que revisa el motor del diagnóstico (lib/diagnostic-checks.mjs).
//
// Movimiento (pantalla viva, §1.5): la barra 132×10 barre la caja de abajo arriba en 1,8 s
// (--w-ease-ui), pausa 0,6 s y repite MIENTRAS esté a la vista, en TODAS las páginas; cada
// pasada enciende 2 chips (texto 60 %→90 % y filo oro en 900 ms, se apagan en 600 ms).
// Pausa fuera de vista (rootMargin 100px), con la pestaña oculta, con el puntero o el foco
// dentro y con el botón "Pausar animación" (loop.ts; el estado global de pausa, cuando lo
// tenga loop.ts, se hereda solo). Con un formulario en la misma sección (diagnóstico) se
// pausa al escribir: focusin del visitante en un campo de closest('section') (o en
// `pausarCon`, selector relativo a esa sección). Movimiento reducido: barra a media altura
// y 3 chips encendidos, quieto. Solo transform y opacity.
//
// Props que se conservan: variant, size, class, motion (motion ya NO apaga el bucle: 'once'
// y 'static' se aceptan por compatibilidad y también viven).
// Tamaños (tabla en W2/escaner-vivo/informe.md); "aire" = relleno lateral del mosaico:
//   mini (portada y hubs): radio 24, caja 160×110, chips 30, aire 24, barra 88×8 (escala de
//     la 132×10 a esta caja). Móvil: caja 128×88 (112×78 bajo 360), chips 25, aire 14, alto 236.
//   card: radio 32, caja 204×141, chips 40, aire 24.
//   hero (diagnóstico): radio 48, caja 250×172 con 24 px de aire, chips 49 radio 12, texto 16,
//     aire 32 (no 64: así caben las columnas). Móvil hero y card: caja 150×104, chips 32, alto 360
//     (116×80 y chips 30 bajo 360). En PC la escala del hero la manda el ancho de la TARJETA
//     (@container): card bajo 570 px y caja de mini con chips 38 bajo 490 (diagnóstico de ~1000 a ~1250).
// Caja central: web en línea NEUTRA (sin marca) con cotas de diseño. Provisional hasta que
// A0 integre WebEjemplo estado="alambre" (se cambia aquí por ese componente).
// CERROJO 5: sale de v3 (portada y hubs), así que TODO su CSS va aquí y solo lee variables.
import Ejemplo from '../Ejemplo.astro';

interface Props {
  lang?: 'es' | 'en';
  variant?: 'completo' | 'compacto';
  motion?: 'loop' | 'once' | 'static';
  size?: 'hero' | 'card' | 'mini';
  /** Selector (relativo a la sección que contiene el escáner) cuyo foco pausa el bucle. */
  pausarCon?: string;
  class?: string;
}
const { lang = 'es', variant = 'completo', motion = 'loop', size = 'card', pausarCon, class: cls } = Astro.props;
const en = lang === 'en';

// Señales reales del motor (lib/diagnostic-checks.mjs): [nombre largo, nombre corto].
// El corto se usa donde el largo no cabe entero (lados de la caja, móvil). Cada señal sale
// UNA sola vez por instancia, larga o corta (W-ADV-45 enseña ~20 señales sin repetir).
const SENALES: [string, string][] = en
  ? [['Mobile version', 'Mobile'], ['Visible phone', 'Phone'], ['Text without JavaScript', 'Text without JavaScript'], ['Secure connection', 'Secure'], ['A page per service', 'Services'], ['Google reviews', 'Reviews'], ['Clear title', 'Title'], ['Tap to call', 'Tap to call'], ['Data for AI', 'Data for AI'], ['City mentioned', 'City'], ['Contact form', 'Form'], ['Photo descriptions', 'Photos'], ['Direct answers', 'Answers'], ['Visible WhatsApp', 'WhatsApp'], ['Business data', 'Business data'], ['Summary up top', 'Summary'], ['Google description', 'Description'], ['Contact button in view', 'Contact'], ['Live website', 'Live site']]
  : [['Versión móvil', 'Móvil'], ['Teléfono visible', 'Teléfono'], ['Texto sin JavaScript', 'Texto sin JavaScript'], ['Conexión segura', 'Candado'], ['Páginas por servicio', 'Servicios'], ['Reseñas en Google', 'Reseñas'], ['Título claro', 'Título'], ['Llamar con un toque', 'Llamar'], ['Datos para IA', 'Datos para IA'], ['Ciudad mencionada', 'Ciudad'], ['Formulario de contacto', 'Formulario'], ['Fotos con descripción', 'Fotos'], ['Respuestas directas', 'Respuestas'], ['WhatsApp visible', 'WhatsApp'], ['Datos del negocio', 'Negocio'], ['Resumen al inicio', 'Resumen'], ['Descripción en Google', 'Descripción'], ['Botón de contacto a la vista', 'Contacto'], ['Sitio activo', 'Sitio activo']];
// Reparto inicial (sin JavaScript): 6 señales cortas a los lados de la caja y las 13
// restantes, largas, en las 4 filas anchas. El guion lo rehace midiendo: columnas laterales
// de ancho fijo, filas anchas desde el mismo margen izquierdo, nada repetido ni cortado.
const chip = (i: number, corta: boolean) => {
  const [l, c] = SENALES[i];
  return { t: corta ? c : l, l: corta && c !== l ? l : undefined, c: !corta && c !== l ? c : undefined };
};
const LADOS = [[0, 1], [3, 5], [6, 9]];
const resto = SENALES.map((_, i) => i).filter((i) => !LADOS.flat().includes(i));
const ANCHAS = [resto.slice(9, 12), resto.slice(0, 4), resto.slice(4, 8), [resto[8], resto[12]]];
type Fila = { tipo: 'ancha'; chips: ReturnType<typeof chip>[] } | { tipo: 'lados'; izq: ReturnType<typeof chip>[]; der: ReturnType<typeof chip>[] };
const filas: Fila[] = [
  { tipo: 'ancha', chips: ANCHAS[0].map((i) => chip(i, false)) },
  { tipo: 'ancha', chips: ANCHAS[1].map((i) => chip(i, false)) },
  ...LADOS.map(([a, b]): Fila => ({ tipo: 'lados', izq: [chip(a, true)], der: [chip(b, true)] })),
  { tipo: 'ancha', chips: ANCHAS[2].map((i) => chip(i, false)) },
  { tipo: 'ancha', chips: ANCHAS[3].map((i) => chip(i, false)) },
];
const sr = en
  ? 'Example: the free checkup scans a website for signals such as mobile version, visible phone, Google reviews and data for AI.'
  : 'Ejemplo: el diagnóstico gratis revisa una web buscando señales como la versión móvil, el teléfono visible, las reseñas en Google y los datos para IA.';
---
<div
  class:list={['wo-scan', `wo-scan--${variant}`, `wo-scan--${size}`, `wo-scan--${motion}`, cls]}
  data-wo-scan="loop"
  data-wo-scan-pausar={pausarCon}
  data-wo-scan-lang={lang}
>
  <p class="wo-scan__sr">{sr}</p>
  <Ejemplo lang={lang} on="dark" />
  <div class="wo-scan__wall" aria-hidden="true" data-nosnippet>
    {filas.map((f) => (
      f.tipo === 'ancha' ? (
        <div class="wo-scan__row wo-scan__row--ancha">
          {f.chips.map((s) => <span data-l={s.l} data-c={s.c}>{s.t}</span>)}
        </div>
      ) : (
        <div class="wo-scan__row wo-scan__row--lados">
          <div class="wo-scan__lado wo-scan__lado--izq">{f.izq.map((s) => <span data-l={s.l} data-c={s.c}>{s.t}</span>)}</div>
          <div class="wo-scan__lado wo-scan__lado--der">{f.der.map((s) => <span data-l={s.l} data-c={s.c}>{s.t}</span>)}</div>
        </div>
      )
    ))}
  </div>
  <div class="wo-scan__box" aria-hidden="true">
    <svg viewBox="0 0 250 172" preserveAspectRatio="xMidYMid meet">
      <path class="wo-scan__web" d="M41 22H209a7 7 0 0 1 7 7V143a7 7 0 0 1-7 7H41a7 7 0 0 1-7-7V29a7 7 0 0 1 7-7ZM34 38H216M52 72H142M52 83H126M58.5 106H89.5a6.5 6.5 0 0 1 0 13H58.5a6.5 6.5 0 0 1 0-13ZM156 66H196a4 4 0 0 1 4 4V118a4 4 0 0 1-4 4H156a4 4 0 0 1-4-4V70a4 4 0 0 1 4-4Z" />
      <path class="wo-scan__fino" d="M52 52H86M150 52H164M172 52H186M194 52H202M52 96H122M152 66l48 56M200 66l-48 56M52 134H200" />
      <path class="wo-scan__cota" d="M52 64V60M142 64V60M52 62H142M208 66H212M208 122H212M210 66V122" />
      <path class="wo-scan__dots" d="M41.8 30a2.2 2.2 0 1 0 4.4 0a2.2 2.2 0 1 0-4.4 0M49.8 30a2.2 2.2 0 1 0 4.4 0a2.2 2.2 0 1 0-4.4 0M57.8 30a2.2 2.2 0 1 0 4.4 0a2.2 2.2 0 1 0-4.4 0" />
    </svg>
    <span class="wo-scan__bar"></span>
  </div>
</div>

<script>
  import { registerLoop } from '../loop';

  const rectsOverlap = (a: DOMRect, b: DOMRect) =>
    a.left < b.right && a.right > b.left && a.top < b.bottom && a.bottom > b.top;
  // Orden de reparto por instancia (rotado): dos escáneres de la misma página no empiezan igual.
  let instancia = 0;
  let ctx: CanvasRenderingContext2D | null = null;

  function setup(el: HTMLElement) {
    if (el.dataset.woScanReady) return;
    el.dataset.woScanReady = '1';
    const wall = el.querySelector<HTMLElement>('.wo-scan__wall');
    const bar = el.querySelector<HTMLElement>('.wo-scan__bar');
    const lang = el.dataset.woScanLang === 'en' ? 'en' : 'es';
    if (!wall || !bar) return;
    // Cada señal es UN span (19, del servidor): el reparto los coloca, nunca los duplica.
    const rot = (instancia++ * 7) % 19;
    const all = Array.from(wall.querySelectorAll<HTMLElement>('span')).map((s) => {
      const t = s.textContent || '';
      return { s, long: s.dataset.l || t, short: s.dataset.c || t };
    });
    const sig = [...all.slice(rot % all.length), ...all.slice(0, rot % all.length)];
    const rows = Array.from(wall.querySelectorAll<HTMLElement>(':scope > .wo-scan__row'));

    // Si el escáner vive dentro de un enlace (portada y hubs), el botón de pausa no puede ir
    // dentro del <a>: se envuelve el enlace en un contenedor del mismo tamaño y el botón
    // cuelga de él, en la esquina de la tarjeta.
    let host: HTMLElement = el;
    const link = el.closest('a');
    if (link && link.parentElement) {
      const wrap = document.createElement('div');
      wrap.className = 'wo-scan-host';
      wrap.style.position = 'relative';
      link.parentElement.insertBefore(wrap, link);
      wrap.appendChild(link);
      host = wrap;
    }

    // Reparto medido (W-ADV-45): columnas laterales de ANCHO FIJO pegadas a la caja, filas
    // anchas desde el mismo margen izquierdo; el borde derecho lo funde la máscara. Cada chip
    // entero o fuera; ninguna señal dos veces; si se acaban, la fila sale más corta.
    let candidates: HTMLElement[] = [];
    const layout = () => {
      all.forEach(({ s }) => { s.style.paddingInline = ''; });
      const probe = all[0].s;
      if (!probe.isConnected) rows[0].appendChild(probe);
      const ps = getComputedStyle(probe);
      ctx = ctx || document.createElement('canvas').getContext('2d');
      if (!ctx) return;
      ctx.font = `${ps.fontWeight} ${ps.fontSize} ${ps.fontFamily}`;
      const pad = parseFloat(ps.paddingLeft) * 2 + 3; // relleno + borde + holgura
      const width = (t: string) => Math.ceil(ctx!.measureText(t).width + pad);
      // En las columnas laterales el chip ya tiene ancho fijo: si ninguna señal cabe con su
      // relleno normal, se admite una con relleno de 10 px antes de dejar el hueco vacío.
      const ajuste = Math.max(0, parseFloat(ps.paddingLeft) * 2 - 20);
      // Las medidas se leen del mosaico (las escalas por ancho de tarjeta, @container, viven ahí).
      const ws = getComputedStyle(wall);
      const gap = parseFloat(ws.getPropertyValue('--sc-gap')) || 8;
      const cap = parseFloat(ws.getPropertyValue('--sc-col')) || 180;

      all.forEach(({ s }) => { s.remove(); s.classList.remove('is-lit', 'is-on'); s.style.width = ''; });
      wall.querySelectorAll('.wo-scan__gap').forEach((g) => g.remove());
      rows.forEach((r) => r.classList.remove('is-vacia'));
      const free = new Set(sig);
      const pick = (max: number, preferShort = false, tight = 0) => {
        const order: ('long' | 'short')[] = preferShort ? ['short', 'long'] : ['long', 'short'];
        for (const k of order) for (const x of sig) {
          if (!free.has(x)) continue;
          const w = width(x[k]) - tight;
          if (w <= max) { free.delete(x); x.s.textContent = x[k]; return { x, w }; }
        }
        return null;
      };
      const obstacles = [el.querySelector('.w-example'), host.querySelector('.w-loop-pause')]
        .filter((o): o is Element => !!o && !(o as HTMLElement).hidden)
        .map((o) => { const r = o.getBoundingClientRect(); return new DOMRect(r.left - 6, r.top - 6, r.width + 12, r.height + 12); });

      // 1) lados de la caja (lo más nítido), fila a fila: izquierda y derecha.
      const lados = rows.filter((r) => r.classList.contains('wo-scan__row--lados'));
      for (const r of lados) {
        for (const side of r.querySelectorAll<HTMLElement>('.wo-scan__lado')) {
          const sr = side.getBoundingClientRect();
          const k = Math.max(1, Math.round(sr.width / cap));
          const colW = Math.floor((sr.width - (k - 1) * gap) / k);
          for (let j = 0; j < k; j++) {
            const x0 = sr.left + j * (colW + gap);
            const slot = new DOMRect(x0, sr.top, colW, sr.height);
            const libre = !obstacles.some((o) => rectsOverlap(slot, o));
            const normal = libre ? pick(colW, colW < cap * 0.7) : null;
            const p = normal || (libre ? pick(colW, true, ajuste) : null);
            if (p && !normal) p.x.s.style.paddingInline = '10px';
            const n: HTMLElement = p ? p.x.s : Object.assign(document.createElement('i'), { className: 'wo-scan__gap' });
            n.style.width = `${colW}px`;
            side.appendChild(n);
          }
        }
      }
      // 2) filas anchas: las de dentro antes que las del borde; cada pareja (dentro, borde) se llena a la
      //    par (chip a chip) para que arriba y abajo queden equilibradas.
      const anchas = rows.filter((r) => r.classList.contains('wo-scan__row--ancha'));
      const fila = (r: HTMLElement) => {
        const rr = r.getBoundingClientRect();
        const cs = getComputedStyle(r);
        const left = rr.left + parseFloat(cs.paddingLeft);
        let right = rr.right - parseFloat(cs.paddingRight);
        obstacles.forEach((o) => { if (o.top < rr.bottom && o.bottom > rr.top && o.left < right) right = Math.min(right, o.left); });
        return { r, room: rr.width ? right - left : 0, used: 0, chips: [] as { s: HTMLElement; w: number }[] };
      };
      const put = (f: ReturnType<typeof fila>) => {
        const p = pick(f.room - (f.used ? f.used + gap : 0));
        if (!p) return false;
        f.used = f.used ? f.used + gap + p.w : p.w;
        f.chips.push({ s: p.x.s, w: p.w });
        f.r.appendChild(p.x.s);
        return true;
      };
      const dentro = [anchas[1], anchas[2]].filter(Boolean).map(fila);
      for (let more = true; more;) { more = false; for (const f of dentro) more = put(f) || more; }
      const borde = [anchas[0], anchas[3]].filter(Boolean).map(fila);
      for (let more = true; more;) { more = false; for (const f of borde) more = put(f) || more; }
      // Si las señales no llegan a las dos filas del borde (tarjeta muy ancha), salen las dos:
      // el muro sigue centrado en la caja y no queda una fila vacía.
      if (borde.length === 2 && borde.some((f) => !f.chips.length)) {
        borde.forEach((f) => { f.chips.forEach(({ s }) => s.remove()); f.chips = []; f.r.classList.add('is-vacia'); });
      }
      // Lo que sobra en cada fila se reparte entre sus chips (celdas algo más anchas, como el
      // muro del original), con tope, para que la fila llegue al filo de la máscara.
      for (const f of [...dentro, ...borde]) {
        const left = f.room - f.used;
        if (!f.chips.length || left <= 0 || left > f.room * 0.45) continue;
        const extra = Math.min(left / f.chips.length, Math.min(...f.chips.map((c) => c.w)) * 0.6);
        f.chips.forEach((c) => { c.s.style.width = `${Math.floor(c.w + extra)}px`; });
      }

      const card = el.getBoundingClientRect();
      candidates = [];
      for (const { s } of all) {
        if (!s.isConnected) continue;
        const r = s.getBoundingClientRect();
        const cx = (r.left + r.right) / 2 - (card.left + card.width / 2);
        const cy = (r.top + r.bottom) / 2 - (card.top + card.height / 2);
        // a encender: dentro de la zona nítida (la máscara funde la derecha y los bordes)
        if (cx < card.width * 0.3 && (cx / (card.width * 0.44)) ** 2 + (cy / (card.height * 0.4)) ** 2 < 1) candidates.push(s);
      }
      // Movimiento reducido: cada nuevo reparto (redimensión, fuentes, botón) vuelve a dejar
      // 3 chips encendidos; sin esto el relayout los apagaba.
      if (el.classList.contains('is-still')) { lastLit = []; light(3, true); }
    };

    let lastLit: HTMLElement[] = [];
    const light = (n: number, still = false) => {
      const pool = candidates.filter((c) => !lastLit.includes(c));
      const chosen: HTMLElement[] = [];
      while (chosen.length < n && pool.length) chosen.push(pool.splice(Math.floor(Math.random() * pool.length), 1)[0]);
      lastLit = chosen;
      chosen.forEach((c, i) => {
        if (still) { c.classList.add('is-on'); return; }
        c.classList.remove('is-lit');
        c.style.setProperty('--d', `${i * 380}ms`);
        void c.offsetWidth; // reinicia la animación
        c.classList.add('is-lit');
      });
    };

    let ro: ResizeObserver | null = null;
    let raf = 0;
    const relayout = () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(layout); };
    layout();
    (document as any).fonts?.ready?.then(relayout);
    if ('ResizeObserver' in window) { ro = new ResizeObserver(relayout); ro.observe(el); }

    // El chip se apaga al terminar SU animación (con la pausa puesta se queda como está).
    wall.addEventListener('animationend', (e) => {
      if (e.animationName === 'wo-scan-lit-t') (e.target as HTMLElement).classList.remove('is-lit');
    });
    // Cada pasada de la barra enciende 2 chips.
    bar.addEventListener('animationstart', () => light(2));
    bar.addEventListener('animationiteration', () => light(2));

    const ctl = registerLoop(el, {
      start: () => { el.classList.remove('is-still'); el.querySelectorAll('.is-on').forEach((c) => c.classList.remove('is-on')); el.classList.add('is-run', 'is-playing'); },
      stop: () => el.classList.remove('is-playing'),
      still: () => { el.classList.remove('is-run', 'is-playing'); el.classList.add('is-still'); requestAnimationFrame(layout); },
    }, { lang, buttonHost: host });
    relayout(); // el botón de pausa ya existe: quitar los chips que pisa
    void ctl;

    // Formulario en la misma sección (diagnóstico): se pausa mientras el visitante escribe.
    // El foco programático al cargar no cuenta: solo tras un toque o una tecla del visitante.
    const section = el.closest('section');
    const sel = el.dataset.woScanPausar;
    if (section) {
      const field = (t: EventTarget | null) => t instanceof Element && !el.contains(t) &&
        (sel ? !!t.closest(sel) && section.querySelector(sel)?.contains(t) : t.matches('input, select, textarea, [contenteditable]'));
      let user = false;
      const mark = () => { user = true; };
      section.addEventListener('pointerdown', (e) => { mark(); if (field(e.target)) el.classList.add('is-held'); }, true);
      section.addEventListener('keydown', mark, true);
      section.addEventListener('focusin', (e) => { if (user && field(e.target)) el.classList.add('is-held'); });
      section.addEventListener('focusout', (e) => {
        if (field(e.relatedTarget)) return;
        el.classList.remove('is-held');
      });
    }
  }

  const init = () => document.querySelectorAll<HTMLElement>('[data-wo-scan]').forEach(setup);
  init();
</script>

<style is:global>
  /* is:global: sin atributos de ámbito en cada chip (peso del HTML); todo va bajo .wo-scan. */
  .wo-scan {
    --gold: var(--accent-gold-rgb);
    /* medidas por tamaño (hero por defecto; ver --mini / --card) */
    --sc-bw: 250px; --sc-bh: 172px; --sc-air: 24px;
    --sc-ch: 49px; --sc-gap: 12px; --sc-px: 22px; --sc-fs: 16px; --sc-r: 12px;
    --sc-bar: 132px; --sc-pad: 32px; --sc-col: 210px;
    --sc-travel: calc(var(--sc-bh) - 34px);
    position: relative; overflow: hidden; isolation: isolate;
    container: wo-scan / inline-size; /* escalas por ancho de TARJETA (ver "Tamaños") */
    width: 100%; min-height: 480px;
    border-radius: 48px;
    background: var(--w-s1);
    border: 1px solid var(--w-line);
    box-shadow: var(--w-edge);
    font-family: var(--font-body);
  }
  .wo-scan__sr {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  /* ── Mosaico (W-ADV-45): 7 filas; la del medio a la altura de la caja. Filas anchas desde
     el margen izquierdo común; lados en columnas de ancho fijo pegadas a la caja (el guion
     fija el ancho). Máscara: nítido a la izquierda y en el centro, se pierde por la derecha
     y se suaviza arriba y abajo. ── */
  .wo-scan__wall {
    position: absolute; left: 0; right: 0; top: 50%;
    display: flex; flex-direction: column; gap: var(--sc-gap);
    transform: translateY(-50%);
    -webkit-mask-image: linear-gradient(90deg, #000 62%, rgba(0,0,0,.16) 100%), linear-gradient(180deg, rgba(0,0,0,.5) 0, #000 26%, #000 74%, rgba(0,0,0,.5) 100%);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(90deg, #000 62%, rgba(0,0,0,.16) 100%), linear-gradient(180deg, rgba(0,0,0,.5) 0, #000 26%, #000 74%, rgba(0,0,0,.5) 100%);
    mask-composite: intersect;
  }
  .wo-scan__row { display: flex; height: var(--sc-ch); padding-inline: var(--sc-pad); }
  .wo-scan__row--ancha, .wo-scan__lado {
    flex-wrap: wrap; overflow: hidden; height: var(--sc-ch); gap: var(--sc-gap); align-content: flex-start;
  }
  .wo-scan__row--ancha { justify-content: flex-start; }
  .wo-scan__lado { display: flex; flex: 1 1 0; min-width: 0; }
