---
// Respuesta de asistente que te cita (W-CORE-10 · design/rediseno-workos.md §3.6).
// Objeto de PRODUCTO: bandeja radio 20 padding 14 (noche) con tarjeta interior CLARA radio
// 12: la pregunta, "Buscando…" que pasa a check, "Leyendo fuentes" que pasa a check y la
// burbuja final que cita "Tu Negocio" en negrita. variant="tres-columnas" (IA para pymes):
// "ChatGPT te recomienda · Google te resume · Marcy agenda", con los nombres SOLO en texto
// (sin logotipos de terceros, §1.C). Se escribe UNA vez (~2,5 s) al entrar en vista; sin
// JS o con reduced-motion se ve el estado final. Ilustración: aria-hidden + sr-only.
import Ejemplo from '../Ejemplo.astro';

interface Props {
  lang?: 'es' | 'en';
  variant?: 'tarjeta' | 'tres-columnas';
  tone?: 'teal' | 'gold';
  size?: 'hero' | 'card' | 'mini';
  question?: string;
  business?: string;
  class?: string;
}
const { lang = 'es', variant = 'tarjeta', tone = 'teal', size = 'card', class: cls } = Astro.props;
const en = lang === 'en';
const biz = Astro.props.business ?? (en ? 'Your Business' : 'Tu Negocio');
const q = Astro.props.question ?? (en ? 'Who builds websites in Spanish in Houston?' : '¿Quién hace webs en español en Houston?');
const T = en
  ? { searching: 'Searching the web', reading: 'Reading sources', pre: 'A good option is ', post: ': bilingual website, quick replies and real work on display.', sr: `Example: someone asks an AI assistant who builds websites in Spanish in Houston, and the answer names ${biz}.` }
  : { searching: 'Buscando en la web', reading: 'Leyendo fuentes', pre: 'Una buena opción es ', post: ': web bilingüe, responde rápido y enseña su trabajo.', sr: `Ejemplo: alguien le pregunta a un asistente de IA quién hace webs en español en Houston y la respuesta nombra a ${biz}.` };
const COLS = en
  ? [
      { who: 'ChatGPT recommends you', q: 'Best plumber near me in Houston?', a: [`I recommend `, biz, `: open today and answers in Spanish.`] },
      { who: 'Google sums you up', q: 'plumber houston spanish', a: ['', biz, ` is a Houston plumber with bilingual service.`] },
      { who: 'Marcy books it', q: 'Can someone come on Saturday?', a: [`Yes, `, 'Saturday 10:00', ` is booked. I sent you the confirmation.`] },
    ]
  : [
      { who: 'ChatGPT te recomienda', q: '¿Un buen plomero cerca de mí en Houston?', a: ['Te recomiendo ', biz, ': abre hoy y atiende en español.'] },
      { who: 'Google te resume', q: 'plomero houston en español', a: ['', biz, ' es un plomero de Houston con atención bilingüe.'] },
      { who: 'Marcy agenda', q: '¿Pueden venir el sábado?', a: ['Sí, quedó el ', 'sábado a las 10:00', '. Te mandé la confirmación.'] },
    ];
const srCols = en
  ? `Example: ChatGPT recommends ${biz}, Google sums it up, and Marcy books the appointment.`
  : `Ejemplo: ChatGPT recomienda a ${biz}, Google lo resume y Marcy agenda la cita.`;
---
<div class:list={['wo-ans', `wo-ans--${variant}`, `wo-ans--${size}`, cls]} data-tone={tone} data-wo-ans>
  {variant === 'tarjeta' ? (
    <>
      <p class="sr-only">{T.sr}</p>
      <div class="wo-ans__card" aria-hidden="true">
        <Ejemplo lang={lang} on="light" />
        <p class="wo-ans__q">{q}</p>
        <p class="wo-ans__step" style="--d:0ms"><span class="wo-ans__chk"><i></i></span>{T.searching}</p>
        <p class="wo-ans__step" style="--d:700ms"><span class="wo-ans__chk"><i></i></span>{T.reading}</p>
        <p class="wo-ans__bub" style="--d:1500ms">{T.pre}<b translate="no">{biz}</b>{T.post}</p>
      </div>
    </>
  ) : (
    <>
      <p class="sr-only">{srCols}</p>
      <div class="wo-ans__cols" aria-hidden="true">
        {COLS.map((c, i) => (
          <div class="wo-ans__card" style={`--d:${i * 500}ms`}>
            {i === 0 && <Ejemplo lang={lang} on="light" />}
            <p class="wo-ans__who">{c.who}</p>
            <p class="wo-ans__q">{c.q}</p>
            <p class="wo-ans__bub" style={`--d:${i * 500 + 600}ms`}>{c.a[0]}<b translate="no">{c.a[1]}</b>{c.a[2]}</p>
          </div>
        ))}
      </div>
    </>
  )}
</div>

<script>
  // Disparo único al entrar en vista (no es un bucle: sin registerLoop ni botón de pausa).
  const mq = window.matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLElement>('[data-wo-ans]').forEach((el) => {
    if (mq.matches || !('IntersectionObserver' in window)) return;
    const r = el.getBoundingClientRect();
    if (r.top < innerHeight && r.bottom > 0) { el.classList.add('is-armed'); requestAnimationFrame(() => requestAnimationFrame(() => el.classList.add('is-run'))); return; }
    el.classList.add('is-armed');
    const io = new IntersectionObserver((es) => {
      if (es.some((e) => e.isIntersecting)) { el.classList.add('is-run'); io.disconnect(); }
    }, { threshold: .35 });
    io.observe(el);
  });
</script>

<style>
  .wo-ans {
    --wo-acc: var(--accent-teal);
    position: relative; width: min(100%, 420px);
    padding: 14px; border-radius: 20px;
    background: var(--w-s1, #121211); border: 1px solid var(--w-line); box-shadow: var(--w-edge);
    font-family: var(--font-body); text-align: left;
  }
  .wo-ans[data-tone='gold'] { --wo-acc: var(--accent-gold); }
  .wo-ans--tres-columnas { width: 100%; max-width: 1200px; }
  .wo-ans__cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .wo-ans__card {
    position: relative; display: flex; flex-direction: column; gap: 10px;
    padding: 18px; border-radius: var(--w-r-obj, 12px);
    background: var(--w-p-bg, #f0ede8); color: var(--w-p-ink, #0e0e0d);
    border: 1px solid var(--w-p-line, rgba(14,14,13,.08));
  }
  .wo-ans__who { margin: 0 0 2px; font: 500 15px/1.25 var(--font-display); letter-spacing: -0.01em; padding-right: 84px; }
  .wo-ans__q {
    margin: 0; padding-right: 84px; font: 500 15px/1.35 var(--font-display); letter-spacing: -0.01em;
  }
  .wo-ans--tres-columnas .wo-ans__q {
    padding: 8px 12px; border-radius: 8px; background: #fff; border: 1px solid var(--w-p-line);
    font: 400 14px/1.35 var(--font-body); color: var(--w-p-ink-2, #4a4743); align-self: flex-start;
  }
  .wo-ans--tres-columnas .wo-ans__card:not(:first-child) .wo-ans__who { padding-right: 0; }
  .wo-ans__step { margin: 0; display: flex; align-items: center; gap: 10px; font-size: 14px; color: var(--w-p-ink-2, #4a4743); }
  .wo-ans__chk {
    position: relative; flex: none; width: 18px; height: 18px; border-radius: 50%;
    background: var(--wo-acc);
  }
  .wo-ans__chk i {
    position: absolute; left: 6px; top: 3px; width: 5px; height: 9px;
    border: solid #0e0e0d; border-width: 0 2px 2px 0; transform: rotate(45deg);
  }
  .wo-ans__bub {
    margin: 4px 0 0; padding: 12px 14px; border-radius: 8px;
    background: #fff; border: 1px solid var(--w-p-line, rgba(14,14,13,.08));
    font-size: 14px; line-height: 1.5;
  }
  .wo-ans__bub b { font-weight: 700; }

  /* Disparo único: solo si el script lo arma (sin JS o con reduced-motion, estado final). */
  .wo-ans.is-armed .wo-ans__step,
  .wo-ans.is-armed .wo-ans__bub { opacity: 0; transform: translateY(6px); }
  .wo-ans.is-armed .wo-ans__chk { background: transparent; box-shadow: inset 0 0 0 2px rgba(14,14,13,.18); }
  .wo-ans.is-armed .wo-ans__chk i { opacity: 0; }
  .wo-ans.is-run .wo-ans__step,
  .wo-ans.is-run .wo-ans__bub {
    opacity: 1; transform: none;
    transition: opacity 320ms var(--w-ease-ui) var(--d), transform 320ms var(--w-ease-ui) var(--d);
  }
  .wo-ans.is-run .wo-ans__chk { background: var(--wo-acc); box-shadow: none; transition: background-color 200ms var(--w-ease-ui) calc(var(--d) + 600ms), box-shadow 200ms calc(var(--d) + 600ms); }
  .wo-ans.is-run .wo-ans__chk i { opacity: 1; transition: opacity 200ms var(--w-ease-ui) calc(var(--d) + 600ms); }
  @media (--lt-md) {
    .wo-ans__cols { grid-template-columns: 1fr; }
  }
</style>
