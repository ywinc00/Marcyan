---
// Túnel de rejilla (W-ADV-28 · design/rediseno-workos.md §3.6). Objeto de SISTEMA, fondo.
// Rejilla de 1 px oro en perspectiva hacia un rectángulo central limpio de 840×600 (4
// paredes, SVG inline generado aquí), y un arco teal suave desde la esquina inferior
// derecha (radial CSS, fuera de la máscara de la rejilla). Cubre la ventana entera (E-36): el SVG va con "slice" y el
// hero que lo monte le da position:relative + overflow:clip. El texto vive en el
// rectángulo central, que no lleva líneas (E-37). Estático. Decorativo: aria-hidden,
// sin etiqueta "Ejemplo" (no muestra datos).
interface Props {
  /** Opacidad de las líneas. 0.16 se quedaba en un valor 23-30 sobre fondo 8 tras la máscara
   *  (control 2): a 0.30 la rejilla se ve de lejos sin competir con el titular. */
  strength?: number;
  arc?: boolean;
  class?: string;
}
const { strength = 0.3, arc = true, class: cls } = Astro.props;
const W = 1920, H = 1080;
const I = { x0: 540, y0: 240, x1: 1380, y1: 840 };          // rectángulo central 840×600
const O = { x0: -260, y0: -300, x1: W + 260, y1: H + 300 };  // fuera del lienzo: siempre cubre
const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
const f = (n: number) => n.toFixed(1);
// Anillos en profundidad (más juntos hacia el fondo, como una perspectiva real).
const rings = Array.from({ length: 9 }, (_, i) => Math.pow((i + 1) / 9, 1.9)).map((t) => {
  const x0 = lerp(I.x0, O.x0, t), y0 = lerp(I.y0, O.y0, t), x1 = lerp(I.x1, O.x1, t), y1 = lerp(I.y1, O.y1, t);
  return `M${f(x0)} ${f(y0)}H${f(x1)}V${f(y1)}H${f(x0)}Z`;
});
// Líneas de fuga: de cada punto del borde interior al punto equivalente del exterior.
const rays: string[] = [];
const NX = 10, NY = 7;
for (let i = 0; i <= NX; i++) {
  const t = i / NX;
  rays.push(`M${f(lerp(I.x0, I.x1, t))} ${I.y0}L${f(lerp(O.x0, O.x1, t))} ${O.y0}`);
  rays.push(`M${f(lerp(I.x0, I.x1, t))} ${I.y1}L${f(lerp(O.x0, O.x1, t))} ${O.y1}`);
}
for (let j = 1; j < NY; j++) {
  const t = j / NY;
  rays.push(`M${I.x0} ${f(lerp(I.y0, I.y1, t))}L${O.x0} ${f(lerp(O.y0, O.y1, t))}`);
  rays.push(`M${I.x1} ${f(lerp(I.y0, I.y1, t))}L${O.x1} ${f(lerp(O.y0, O.y1, t))}`);
}
const inner = `M${I.x0} ${I.y0}H${I.x1}V${I.y1}H${I.x0}Z`;
---
<div class:list={['wo-tunnel', cls]} aria-hidden="true" style={`--wo-a:${strength}`}>
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice">
    <path class="wo-tunnel__grid" d={rings.join('') + rays.join('')} />
    <path class="wo-tunnel__in" d={inner} />
  </svg>
  {arc && <span class="wo-tunnel__arc"></span>}
</div>

<style>
  .wo-tunnel { position: absolute; inset: 0; overflow: hidden; pointer-events: none; z-index: 0; }
  .wo-tunnel svg {
    position: absolute; inset: 0; width: 100%; height: 100%;
    /* Funde arriba (bajo la nav) y abajo, sin bordes rectos (E-36). Solo la rejilla: con la
       máscara en todo el túnel, el arco de la esquina inferior quedaba borrado. */
    -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 12%, #000 82%, transparent 100%);
    mask-image: linear-gradient(180deg, transparent 0, #000 12%, #000 82%, transparent 100%);
  }
  .wo-tunnel__grid { fill: none; stroke: rgba(var(--accent-gold-rgb), var(--wo-a)); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .wo-tunnel__in { fill: none; stroke: rgba(var(--accent-gold-rgb), calc(var(--wo-a) * 1.6)); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .wo-tunnel__arc {
    position: absolute; inset: 0;
    /* Amanecer teal desde la esquina inferior derecha: presencia real en el cuadrante bajo,
       casi nada a la altura del titular (sin halo detrás del texto, E-03/E-37). Su propia
       máscara lo apaga poco a poco en el último 40 % para no dejar borde recto abajo (E-36). */
    background:
      radial-gradient(60% 75% at 100% 88%, rgba(var(--accent-teal-rgb), .30) 0%, rgba(var(--accent-teal-rgb), .14) 32%, rgba(var(--accent-teal-rgb), .04) 58%, transparent 74%),
      radial-gradient(40% 40% at 100% 88%, rgba(var(--accent-teal-rgb), .12) 0%, transparent 70%);
    -webkit-mask-image: linear-gradient(180deg, #000 0, #000 58%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 0, #000 58%, transparent 100%);
  }
</style>
