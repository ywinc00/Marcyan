  .ej[data-ej-estado='alambre'] .ej__arte :global(*) { visibility: visible; }
  .ej[data-ej-estado='alambre'] .ej__arte :global(.ej-ilu__plano),
  .ej[data-ej-estado='alambre'] .ej__arte :global(.ej-ilu__gota) { fill: none; }
  .ej[data-ej-estado='alambre'] .ej__arte :global(.ej-ilu__gota) { stroke: currentColor; stroke-width: 1; vector-effect: non-scaling-stroke; }
  .ej[data-ej-estado='alambre'] :is(.ej__gar, .ej__g, .ej__sv-f, .ej__hor-f) { border-color: rgba(var(--ej-crema), .18); }
  .ej__cotas { display: none; }
  .ej[data-ej-estado='alambre'] .ej__cotas {
    display: block; position: absolute; inset: 0; pointer-events: none;
    background: repeating-linear-gradient(90deg, rgba(var(--ej-crema), .05) 0 1px, transparent 1px calc((100% - var(--ej-cp, 128px)) / var(--ej-cn, 12)));
  }
