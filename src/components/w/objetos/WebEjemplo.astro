  .ej__seg-d { font-size: 18px; color: var(--ej-ink-2); align-self: flex-start; }
  /* servicios */
  .ej__sv { display: flex; flex-direction: column; align-items: flex-start; }
  .ej__sv-filas { align-self: stretch; display: flex; flex-direction: column; }
  .ej__sv-f { display: grid; align-items: center; border-top: 1px solid var(--ej-rule); }
  .ej__sv-f:last-child { border-bottom: 1px solid var(--ej-rule); }
  .ej__sv-t { font-family: var(--ej-font-display); font-weight: 500; letter-spacing: -.02em; justify-self: start; }
  .ej__sv-d { color: var(--ej-ink-2); justify-self: start; }
  .ej__sv-a { display: inline-flex; align-items: center; gap: .5em; color: var(--ej-accent); font-weight: 500; justify-self: end; }
  .ej--escritorio .ej__sv { padding-top: 64px; }
  .ej--escritorio .ej__sv .ej__tit { margin-top: 18px; font-size: 96px; line-height: .96; letter-spacing: -.045em; }
