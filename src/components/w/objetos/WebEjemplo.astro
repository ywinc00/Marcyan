  .ej--movil .ej__ante { font-size: 15.5px; letter-spacing: .1em; }
  .ej--movil .ej__tit { margin-top: 16px; font-size: 50px; line-height: 1; letter-spacing: -.04em; }
  .ej--movil .ej__baj { margin-top: 16px; font-size: 17.5px; line-height: 1.45; max-width: 18em; }
  .ej--movil .ej__acc { margin-top: 26px; }
