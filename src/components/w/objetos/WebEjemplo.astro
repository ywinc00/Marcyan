  /* ═══ Lienzo: tamaño fuente fijo, escalado al ancho sin JS ═══ */
  .ej__vp { position: relative; overflow: hidden; container-type: inline-size; background: var(--ej-bg); transition: background-color var(--ej-t); }
  .ej--escritorio .ej__vp { aspect-ratio: 1280 / 800; }
  .ej--vertical .ej__vp { aspect-ratio: 400 / 520; }
  .ej--movil .ej__vp { aspect-ratio: 390 / 844; }
  .ej__lz {
    position: absolute; left: 0; top: 0; width: var(--ej-w); height: var(--ej-h);
    transform-origin: 0 0; transform: scale(min(1, tan(atan2(100cqw, var(--ej-w)))));
  }
  .ej__l { height: 100%; }
  /* mini: composición propia a tamaño natural, sin lienzo */
  .ej--mini .ej__vp { aspect-ratio: auto; container-type: normal; }
  .ej--mini .ej__lz { position: static; width: auto; height: auto; transform: none; }
  .ej--movil.ej--mini .ej__marco { padding-bottom: 0; border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
  .ej--movil.ej--mini .ej__vp { border-bottom-left-radius: 0; border-bottom-right-radius: 0; }

  /* ═══ Página (común) ═══ */
  .ej__pg {
    position: relative; height: 100%; box-sizing: border-box; display: flex; flex-direction: column;
    color: var(--ej-ink); background: var(--ej-bg);
    transition: background-color var(--ej-t), color var(--ej-t);
  }
  .ej__pg p { margin: 0; }
  .ej__nav { display: grid; grid-template-columns: auto 1fr auto; align-items: center; flex: none; }
  .ej__logo { display: inline-flex; line-height: 0; }
  .ej__links { display: flex; justify-content: center; font-weight: 500; }
  .ej__navder { display: flex; align-items: center; justify-content: flex-end; }
  .ej__abierto { display: inline-flex; align-items: center; color: var(--ej-ink-2); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .ej__abierto i { width: .5em; height: .5em; border-radius: 50%; background: #3F8F5A; margin-right: .55em; flex: none; animation: ej-late 2s ease-in-out infinite; }
  .ej__menu { display: none; line-height: 0; }
  .ej__hero { position: relative; }
  .ej__copy { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: flex-start; }
  .ej__ante { display: inline-block; font-family: var(--font-mono); font-weight: 500; text-transform: uppercase; letter-spacing: .12em; color: var(--ej-ink-2); }
  .ej__tit { font-family: var(--ej-font-display); font-weight: var(--ej-display-weight); text-wrap: balance; color: var(--ej-ink); }
  .ej__baj { color: var(--ej-ink-2); }
  .ej__acc { display: flex; }
  .ej__num { font-variant-numeric: tabular-nums; display: inline-flex; align-items: center; }
  .ej__num::before { content: ''; width: 1px; height: 1.05em; background: currentColor; opacity: .38; margin: 0 .75em 0 .2em; }
  .ej__arte { line-height: 0; }
  .ej__gar { display: grid; border-top: 1px solid var(--ej-rule); flex: none; }
  .ej__g > span { display: inline-flex; align-items: center; font-weight: 500; }
  .ej__g :global(svg) { color: var(--ej-accent); }

  /* ═══ Botones: base < marca (data-ej-btn-def) < raíz (data-ej-btn) < scope ═══ */
  .ej__btn, .ej__btn2 {
    display: inline-flex; align-items: center; white-space: nowrap; font-weight: 500;
    border: 1.5px solid transparent; border-radius: calc(var(--ej-radius) * .5);
    transition: background-color var(--ej-t), color var(--ej-t), border-color var(--ej-t), border-radius var(--ej-t);
  }
  .ej__btn { background: var(--ej-accent); color: var(--ej-on-accent); border-color: var(--ej-accent); }
  .ej__btn2 { color: var(--ej-ink); border-color: color-mix(in srgb, var(--ej-ink) 70%, transparent); }
  .ej__btn2:hover { background: var(--ej-ink); color: var(--ej-bg); }
  .ej[data-ej-btn-def='outline'] .ej__btn { background: transparent; color: var(--ej-ink); border-color: var(--ej-ink); }
  .ej[data-ej-btn-def='pill'] .ej__btn, .ej[data-ej-btn-def='pill'] .ej__btn2 { border-radius: 999px; }
  .ej[data-ej-btn='fill'] .ej__btn { background: var(--ej-accent); color: var(--ej-on-accent); border-color: var(--ej-accent); border-radius: calc(var(--ej-radius) * .5); }
  .ej[data-ej-btn='fill'] .ej__btn2 { border-radius: calc(var(--ej-radius) * .5); }
  .ej[data-ej-btn='outline'] .ej__btn { background: transparent; color: var(--ej-ink); border-color: var(--ej-ink); border-radius: calc(var(--ej-radius) * .5); }
  .ej[data-ej-btn='outline'] .ej__btn2 { border-radius: calc(var(--ej-radius) * .5); }
  .ej[data-ej-btn='pill'] .ej__btn { background: var(--ej-accent); color: var(--ej-on-accent); border-color: var(--ej-accent); border-radius: 999px; }
  .ej[data-ej-btn='pill'] .ej__btn2 { border-radius: 999px; }
  :global([data-ej-scope][data-ej-btn='fill']) .ej .ej__btn { background: var(--ej-accent); color: var(--ej-on-accent); border-color: var(--ej-accent); border-radius: calc(var(--ej-radius) * .5); }
  :global([data-ej-scope][data-ej-btn='fill']) .ej .ej__btn2 { border-radius: calc(var(--ej-radius) * .5); }
  :global([data-ej-scope][data-ej-btn='outline']) .ej .ej__btn { background: transparent; color: var(--ej-ink); border-color: var(--ej-ink); border-radius: calc(var(--ej-radius) * .5); }
  :global([data-ej-scope][data-ej-btn='outline']) .ej .ej__btn2 { border-radius: calc(var(--ej-radius) * .5); }
  :global([data-ej-scope][data-ej-btn='pill']) .ej .ej__btn { background: var(--ej-accent); color: var(--ej-on-accent); border-color: var(--ej-accent); border-radius: 999px; }
  :global([data-ej-scope][data-ej-btn='pill']) .ej .ej__btn2 { border-radius: 999px; }

  /* ═══ ESCRITORIO 1280×800 ═══ */
  .ej--escritorio .ej__pg { padding: 0 64px; }
  .ej--escritorio .ej__nav { height: 92px; gap: 32px; }
