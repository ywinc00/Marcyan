  .ej--escritorio .ej__form { padding: 32px; gap: 14px; align-self: start; }
  .ej--escritorio .ej__campo { height: 56px; padding: 0 18px; font-size: 18px; }
  .ej--escritorio .ej__campo--alto { height: 120px; padding-top: 16px; }
  .ej--escritorio .ej__btn--form { height: 56px; padding: 0 30px; font-size: 18px; margin-top: 6px; }

  /* ═══ VERTICAL 400×520 · la web en columna ═══ */
