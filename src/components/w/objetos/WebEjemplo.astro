    color: transparent; background: none; border-color: transparent; border-radius: 3px;
    outline: 1px solid rgba(var(--ej-crema), .34); outline-offset: 2px;
  }
  .ej[data-ej-estado='alambre'] .ej-k :global(*) { visibility: hidden; }
