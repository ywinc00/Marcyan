  .ej--movil .ej__navder { display: contents; }
  .ej--movil .ej__menu { display: block; }
  .ej--movil .ej__abierto { grid-column: 1 / -1; grid-row: 2; margin-top: 18px; font-size: 15.5px; justify-self: start; }
