  .ej--vertical .ej__sv { padding-top: 26px; }
  .ej--vertical .ej__sv .ej__tit { margin-top: 12px; font-size: 44px; line-height: 1; letter-spacing: -.04em; }
  .ej--vertical .ej__sv .ej__baj { margin-top: 10px; font-size: 15px; }
  .ej--vertical .ej__sv-filas { margin-top: 22px; }
  .ej--vertical .ej__sv-f { grid-template-columns: 1fr auto; grid-template-rows: auto auto; row-gap: 4px; padding: 13px 0; }
  .ej--vertical .ej__sv-t { font-size: 19px; }
  .ej--vertical .ej__sv-d { grid-row: 2; font-size: 13.5px; }
  .ej--vertical .ej__sv-a { grid-row: 1 / span 2; grid-column: 2; font-size: 0; }
  .ej--vertical .ej__ct { padding-top: 26px; }
  .ej--vertical .ej__ct .ej__tit { font-size: 44px; line-height: 1; letter-spacing: -.04em; }
  .ej--vertical .ej__ct .ej__baj { margin-top: 12px; font-size: 15px; line-height: 1.45; }
  .ej--vertical .ej__ct .ej__acc { margin-top: 18px; }
  .ej--vertical .ej__hor { margin-top: 22px; font-size: 13.5px; }
  .ej--vertical .ej__hor-f { padding: 9px 0; }
  .ej--vertical .ej__zona { margin-top: 10px; font-size: 13px; }
  .ej--vertical .ej__form { display: none; }

  /* ═══ MÓVIL 390×844 ═══ */
  .ej--movil .ej__pg { padding: 52px 22px 0; }
  .ej--movil .ej__nav { grid-template-columns: 1fr auto; column-gap: 12px; padding-top: 10px; }
