  .ej--escritorio .ej__sv-d { font-size: 19px; }
  .ej--escritorio .ej__sv-a { font-size: 18px; }
  /* contacto */
  .ej__ct-a { display: flex; flex-direction: column; align-items: flex-start; }
  .ej__hor { display: flex; flex-direction: column; align-self: stretch; }
  .ej__hor-f { display: flex; justify-content: space-between; gap: 1em; border-top: 1px solid var(--ej-rule); font-variant-numeric: tabular-nums; }
  .ej__hor-h { color: var(--ej-ink-2); }
  .ej__zona { color: var(--ej-ink-2); }
  .ej__form {
    display: flex; flex-direction: column; box-sizing: border-box;
    background: color-mix(in srgb, var(--ej-ink) 5%, var(--ej-bg)); border-radius: var(--ej-radius);
    transition: border-radius var(--ej-t), background-color var(--ej-t);
  }
  .ej__campo {
    display: flex; align-items: center; color: var(--ej-ink-2); background: var(--ej-bg);
    border: 1px solid color-mix(in srgb, var(--ej-ink) 22%, transparent); border-radius: calc(var(--ej-radius) * .5);
    transition: border-radius var(--ej-t), background-color var(--ej-t);
