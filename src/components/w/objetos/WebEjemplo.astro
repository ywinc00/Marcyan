---
// ═════════════════════════════════════════════════════════════════════════════════════════
// WEB DE EJEMPLO · CONTRATO (design/rediseno-workos-v2.md §1.6, §1.8 y §2 · P02a)
// La usan P01 (demo y personalizador), P03 (objetos), P04 (escáner, estado `alambre`),
// P08 (portátil) y P11 (proceso). Marco Marcyan, interior de marca ajena (negocios.ts).
//
// PROPS
//   marca   NegocioId (plomeria · salon · restaurante · tienda · inmobiliaria · marca)
//   frame   navegador (barra 28 px + dominio "· Ejemplo") · movil (radio 28, isla 64×18)
//           · tarjeta (sin barra; demo de P01) · desnudo
//   lienzo  escritorio 1280×800 · vertical 400×520 · movil 390×844. Por defecto según frame:
//           navegador→escritorio, tarjeta/desnudo→vertical, movil→movil. El lienzo se dibuja a su
//           tamaño fuente y se escala al ancho con transform: scale(min(1, 100cqw / ancho))
//           (cociente de longitudes con tan(atan2()), sin JS). Cada lienzo tiene su PROPIA
//           composición (el vertical es "la web en columna", no la de escritorio encogida).
//           LEGIBILIDAD (texto renderizado ≥ 11 px donde se lee, ≥ 9 px decorativo):
//             escritorio · texto fuente ≥ 18 px → legible (≥ 11) desde 782 px de ancho; entre 640 y 782
//               queda ≥ 9 (decorativo). El marco navegador se usa SOLO en huecos ≥ 640.
//             vertical   · texto fuente ≥ 13 px → legible desde 339 px (en 360, escala 0,9).
//             movil      · texto fuente ≥ 15,5 px → legible con el marco a ≥ 300 px (por defecto).
//   vista   hero (primera pantalla) · completa (hero + segunda franja) · mini (≤ 240 px:
//           composición PROPIA recortada, logo + titular + 1 acción, a tamaño natural, sin lienzo)
//   pagina  inicio · servicios · contacto (plomeria y marca; el resto cae a inicio)
//   estado  lista · esqueleto (la misma estructura en bloques crema al 8 % sobre noche, la revela
//           la consola de P01) · alambre (la web en línea con cotas; escáner P04, MiniPasos P03)
//           · antes (la misma marca con una web anticuada pero digna; "Rediseño" de P01)
//           esqueleto ⇄ lista ⇄ alambre se cambian EN VIVO con el atributo data-ej-estado de la raíz
//           (mismo DOM; las cotas solo existen si se pinta en alambre). `antes` es otro DOM: para
//           alternar Antes/Después se montan dos instancias (o una en <template>).
//   lang    idioma de la PÁGINA (el logotipo y el rótulo salen de aquí y no cambian)
//   ejemplo rótulo "Ejemplo" (por defecto true): en la barra del navegador o al pie del marco
//   city    ciudad de los textos (por defecto Houston) · modo/boton: valores de partida opcionales
//   Alias de compatibilidad (los usos de la v1 compilan): kind→marca, state→estado,
//   example→ejemplo, frame "pantalla"→navegador, size hero|card|mini→vista hero|completa|mini,
//   site→idioma inicial de la web, pages (se ignora).
//
// PERSONALIZAR DESDE FUERA (prioridad del scope, crítica A2)
//   Un ancestro [data-ej-scope] escribe --ej-s-bg, --ej-s-ink, --ej-s-ink-2, --ej-s-accent,
//   --ej-s-on-accent, --ej-s-radius, --ej-s-font-display (y --ej-s-display-weight). La raíz declara
//   --ej-bg: var(--ej-s-bg, <marca>) y así cada una: el scope GANA siempre a la marca.
//   Atributos en el scope (o en la raíz .ej): data-ej-btn fill|outline|pill, data-ej-mode
//   claro|oscuro (paleta o paletaNoche de la marca), data-ej-lang es|en. Selectores:
//   [data-ej-scope][data-ej-btn=…] .ej .ej__btn pesa más que .ej[data-ej-btn=…] .ej__btn, que pesa
//   más que el botón propio de la marca (data-ej-btn-def): manda el scope.
//   Si el scope escribe --ej-s-* y además pide modo oscuro, manda la variable: para "Pino de noche"
//   el personalizador escribe alternativas[i].noche (negocios.ts).
//   Las pruebas leen la variable EFECTIVA en un nodo interior (.ej__btn, .ej__tit), nunca en el scope.
//
// IDIOMA (§1.8): se pinta el de `site ?? lang`; el otro va en <template data-ej-l> y se inyecta al
//   primer cambio de data-ej-lang (en el scope o en la raíz). El elemento <ej-web> lo resuelve y
//   escribe data-ej-l-activo; emite el evento `ej:idioma` (burbujea) con { lang }.
//
// CONTRATO COMÚN (§1.6): dentro no hay h1-h6 (solo p/span/div); raíz aria-hidden + data-nosnippet
//   + resumen sr-only hermano; el panel del otro idioma lleva `lang`; ningún tel:, wa.me ni
//   data-track ("Llamar" es un span); SVG sin ids (cero choques con varias instancias).
// ═════════════════════════════════════════════════════════════════════════════════════════
import LogoEjemplo from './ejemplos/LogoEjemplo.astro';
import Ilustracion from './ejemplos/Ilustracion.astro';
import { negocios, conCiudad, type NegocioId, type Boton } from './ejemplos/negocios';

type Frame = 'navegador' | 'movil' | 'tarjeta' | 'desnudo';
type Lienzo = 'escritorio' | 'vertical' | 'movil';
type Vista = 'hero' | 'completa' | 'mini';
type Estado = 'esqueleto' | 'alambre' | 'antes' | 'lista';
type L = 'es' | 'en';

interface Props {
  marca?: NegocioId;
  frame?: Frame | 'pantalla';
  lienzo?: Lienzo;
  vista?: Vista;
  pagina?: 'inicio' | 'servicios' | 'contacto';
  estado?: Estado;
  lang?: L;
  ejemplo?: boolean;
  city?: string;
  modo?: 'claro' | 'oscuro';
  boton?: Boton;
  class?: string;
  /** @deprecated alias de `marca` */ kind?: NegocioId;
  /** @deprecated alias de `estado` */ state?: 'esqueleto' | 'lista';
  /** @deprecated alias de `ejemplo` */ example?: boolean;
  /** @deprecated hero→hero · card→completa · mini→mini */ size?: 'hero' | 'card' | 'mini';
  /** @deprecated idioma inicial de la web si no es el de la página */ site?: L;
  /** @deprecated se ignora (menú de páginas de la v1) */ pages?: string[];
}

const p = Astro.props;
const marca: NegocioId = p.marca ?? p.kind ?? 'plomeria';
const frame: Frame = p.frame === 'pantalla' ? 'navegador' : (p.frame ?? 'tarjeta');
const lienzo: Lienzo = p.lienzo ?? (frame === 'navegador' ? 'escritorio' : frame === 'movil' ? 'movil' : 'vertical');
const vista: Vista = p.vista ?? (p.size === 'mini' ? 'mini' : p.size === 'hero' ? 'hero' : 'completa');
const lang: L = p.lang ?? 'es';
const city = p.city ?? 'Houston';
const ejemplo = p.ejemplo ?? p.example ?? true;
const n = negocios[marca];
let estado: Estado = p.estado ?? p.state ?? 'lista';
if (estado === 'antes' && !n.textos[lang].antes) estado = 'lista'; // solo plomería tiene "antes" en P02a
let pagina = p.pagina ?? 'inicio';
if (pagina === 'servicios' && !n.textos[lang].servicios) pagina = 'inicio';
if (pagina === 'contacto' && !n.textos[lang].contacto) pagina = 'inicio';
const webLang: L = p.site ?? lang;
const otra: L = webLang === 'es' ? 'en' : 'es';

const DIM: Record<Lienzo, [number, number]> = { escritorio: [1280, 800], vertical: [400, 520], movil: [390, 844] };
const [W, H] = DIM[lienzo];
const mini = vista === 'mini';
// Tamaños que dependen del lienzo (alto de la mayúscula del logotipo y glifos, en px fuente).
const LOGO: Record<Lienzo, number> = { escritorio: 17, vertical: 11, movil: 13 };
const GLIFO: Record<Lienzo, number> = { escritorio: 22, vertical: 17, movil: 20 };
const ARTE: Record<Lienzo, Record<'hero' | 'completa', number>> = {
  escritorio: { hero: 470, completa: 360 }, vertical: { hero: 220, completa: 112 }, movil: { hero: 320, completa: 150 },
};
const logoCap = mini ? 9.5 : LOGO[lienzo];
const glifo = mini ? 14 : GLIFO[lienzo];
const arte = mini ? 0 : ARTE[lienzo][vista as 'hero' | 'completa'];
const iconosGar = ['presupuesto', 'urgencia', 'idiomas'] as const;

const resumen = (() => {
  const nom = n.nombre[lang];
  if (lang === 'en') return estado === 'antes' ? `Example: an outdated website for ${nom}, a made-up business.`
    : estado === 'lista' ? `Example: website for ${nom}, a made-up business.` : `Example: the layout of a website for ${nom}, a made-up business.`;
  return estado === 'antes' ? `Ejemplo: web anticuada de ${nom}, un negocio inventado.`
    : estado === 'lista' ? `Ejemplo: web de ${nom}, un negocio inventado.` : `Ejemplo: estructura de la web de ${nom}, un negocio inventado.`;
})();
const rotulo = lang === 'en' ? 'Example' : 'Ejemplo';
const pal = (pre: string, x: typeof n.paleta) =>
  `--ej-${pre}-bg:${x.bg};--ej-${pre}-ink:${x.ink};--ej-${pre}-ink-2:${x.ink2};--ej-${pre}-accent:${x.accent};--ej-${pre}-on-accent:${x.onAccent};`;
const estilo = pal('m', n.paleta) + pal('n', n.paletaNoche) + `--ej-m-radius:${n.radio}px;`;

// Cotas del alambre (solo se pintan si la instancia nace en alambre): [texto, clase de posición].
const COTAS: Record<Lienzo, string[]> = {
  escritorio: ['1280', 'nav 92', '7 col', '5 col', 'Aa 92'],
  vertical: ['400', 'nav 64', '1 col', 'Aa 44'],
  movil: ['390', 'nav 60', '1 col', 'Aa 50'],
};
---
<span class="ej-sr" data-nosnippet>{resumen}</span>
<ej-web
  class:list={['ej', `ej--${frame}`, `ej--${lienzo}`, `ej--${vista}`, p.class]}
  aria-hidden="true"
  data-nosnippet
  data-ej-marca={marca}
  data-ej-frame={frame}
  data-ej-lienzo={lienzo}
  data-ej-vista={vista}
  data-ej-pagina={pagina}
  data-ej-estado={estado}
  data-wo-state={estado === 'esqueleto' || estado === 'lista' ? estado : undefined}
  data-ej-lang={webLang}
  data-ej-l-activo={webLang}
  data-ej-btn-def={n.boton}
  data-ej-btn={p.boton}
  data-ej-mode={p.modo}
  style={estilo + `--ej-w:${W}px;--ej-h:${H}px;`}
>
  <div class="ej__marco">
    {frame === 'navegador' && (
      <div class="ej__barra">
        <i></i><i></i><i></i>
        <span class="ej__url"><span translate="no">{n.dominio}</span>{ejemplo && <span class="ej__url-ej"> · {rotulo}</span>}</span>
      </div>
    )}
    {frame === 'movil' && <span class="ej__isla"></span>}
    <div class="ej__vp">
      <div class="ej__lz">
        {[webLang, otra].map((L) => {
          const T = n.textos[L];
          const c = (t?: string) => conCiudad(t, city);
          const panel = (
            <div class="ej__l" data-ej-l-pane={L} lang={L !== lang ? L : undefined}>
              {estado === 'antes' && T.antes ? (
                /* ── ANTES: web de hace diez años, digna (alineada, legible, de una pieza) pero sin
                   jerarquía: la llamada enterrada arriba a la derecha, foto de banco que no dice
                   nada, párrafo de relleno justificado, un solo idioma, nada pensado para el móvil. */
                <div class="ej__pg ea">
                  <div class="ea__top">
                    <span class="ea__logo" translate="no">{n.nombre[lang]}</span>
                    <span class="ea__tel">{T.antes.llamada} <b>{n.telefono}</b></span>
                  </div>
                  <div class="ea__nav">{T.antes.nav.map((x, i) => <span class:list={[i === 0 && 'is-on']}>{x}</span>)}</div>
                  <div class="ea__foto"><i></i><i></i><i></i></div>
                  <div class="ea__cuerpo">
                    <p class="ea__bien">{T.antes.bienvenida}</p>
                    <p class="ea__txt">{c(T.antes.texto)}</p>
                  </div>
                  <div class="ea__pie">{T.antes.pie}</div>
                </div>
              ) : (
                <div class="ej__pg" data-pg={pagina}>
                  <div class="ej__nav">
                    <span class="ej__logo ej-k"><LogoEjemplo marca={marca} size={logoCap} lang={lang} /></span>
                    {T.nav && <span class="ej__links">{T.nav.map((x) => <span class="ej-k">{x}</span>)}</span>}
                    <span class="ej__navder">
                      {T.abierto && <span class="ej__abierto ej-k"><i></i>{T.abierto}</span>}
                      {T.accionTel && <span class="ej__btn2 ej-k">{T.accion}</span>}
                      <span class="ej__menu ej-k"><Ilustracion id="menu" size={glifo + 4} /></span>
                    </span>
                  </div>

                  {pagina === 'inicio' && (
                    <div class="ej__hero">
                      <div class="ej__copy">
                        {T.antetitulo && <span class="ej__ante ej-k">{c(T.antetitulo)}</span>}
                        <p class="ej__tit"><span class="ej-k">{T.titular}</span></p>
                        {T.bajada && <p class="ej__baj"><span class="ej-k">{T.bajada}</span></p>}
                        <span class="ej__acc">
                          <span class="ej__btn ej-k">
                            {T.accionTel && <Ilustracion id="tel" size={glifo} />}
                            <span>{T.accion}</span>
                            {T.accionTel && <span class="ej__num">{n.telefono}</span>}
                          </span>
                        </span>
                      </div>
                      {n.ilustracion && !mini && (
                        <div class="ej__arte ej-k"><Ilustracion id="codo-gota" size={arte} /></div>
                      )}
                    </div>
                  )}

                  {pagina === 'inicio' && T.garantias && !mini && (lienzo === 'escritorio' || vista === 'completa') && (
                    <div class="ej__gar">
                      {T.garantias.map((g, i) => (
                        <span class="ej__g"><span class="ej-k"><Ilustracion id={iconosGar[i]} size={glifo} /><span>{g}</span></span></span>
                      ))}
                    </div>
                  )}

                  {pagina === 'inicio' && vista === 'completa' && lienzo === 'escritorio' && T.servicios && (
                    <div class="ej__seg">
                      <span class="ej__ante ej-k">{T.servicios.rotulo}</span>
                      <div class="ej__seg-filas">
                        {T.servicios.filas.map((f) => (
                          <span class="ej__seg-f"><span class="ej__seg-t ej-k">{f.t}</span><span class="ej__seg-d ej-k">{f.d}</span></span>
                        ))}
                      </div>
                    </div>
                  )}

                  {pagina === 'servicios' && T.servicios && (
                    <div class="ej__sv">
                      <span class="ej__ante ej-k">{T.servicios.rotulo}</span>
                      <p class="ej__tit"><span class="ej-k">{T.servicios.titulo}</span></p>
                      <p class="ej__baj"><span class="ej-k">{c(T.servicios.intro)}</span></p>
                      <div class="ej__sv-filas">
                        {T.servicios.filas.map((f) => (
                          <span class="ej__sv-f">
                            <span class="ej__sv-t ej-k">{f.t}</span>
                            <span class="ej__sv-d ej-k">{f.d}</span>
                            <span class="ej__sv-a ej-k"><span>{T.servicios!.accionFila}</span><Ilustracion id="flecha" size={glifo - 2} /></span>
                          </span>
                        ))}
                      </div>
                    </div>
                  )}

                  {pagina === 'contacto' && T.contacto && (
                    <div class="ej__ct">
                      <div class="ej__ct-a">
                        <p class="ej__tit"><span class="ej-k">{T.contacto.titulo}</span></p>
                        <p class="ej__baj"><span class="ej-k">{T.contacto.intro}</span></p>
                        <span class="ej__acc">
                          <span class="ej__btn ej-k">
                            {T.accionTel && <Ilustracion id="tel" size={glifo} />}
                            <span>{T.accion}</span>
                            {T.accionTel && <span class="ej__num">{n.telefono}</span>}
                          </span>
                        </span>
                        <span class="ej__hor">
                          {T.contacto.horario.map((h) => <span class="ej__hor-f ej-k"><span>{h.d}</span><span class="ej__hor-h">{h.h}</span></span>)}
                        </span>
                        <span class="ej__zona ej-k">{c(T.contacto.zona)}</span>
                      </div>
                      <div class="ej__form ej-k">
                        {T.contacto.campos.map((f, i) => <span class:list={['ej__campo', i === 2 && 'ej__campo--alto']}>{f}</span>)}
                        <span class="ej__btn ej__btn--form"><span>{T.contacto.enviar}</span></span>
                      </div>
                    </div>
                  )}

                  {estado === 'alambre' && (
                    <div class="ej__cotas">
                      {COTAS[lienzo].map((t, i) => <span class={`ej__cota ej__cota--${i}`}>{t}</span>)}
                    </div>
                  )}
                </div>
              )}
            </div>
          );
          return L === webLang ? panel : <template data-ej-l={L}>{panel}</template>;
        })}
      </div>
    </div>
  </div>
  {ejemplo && frame !== 'navegador' && <span class="ej__rot"><span translate="no">{n.dominio}</span> · {rotulo}</span>}
</ej-web>

<script>
  // <ej-web>: resuelve el idioma efectivo (scope > raíz), inyecta el panel del otro idioma desde su
  // <template> la primera vez y puentea el atributo de la v1 (data-wo-state, DemoPorPasos) a
  // data-ej-estado. Solo actúa dentro de su propio nodo; no arranca nada hasta que hay un cambio.
  class EjWeb extends HTMLElement {
    private obs?: MutationObserver;
    private scope: Element | null = null;
    connectedCallback() {
      this.scope = this.parentElement?.closest('[data-ej-scope]') ?? null;
      this.obs = new MutationObserver((recs) => {
        for (const r of recs) {
          if (r.target === this && r.attributeName === 'data-wo-state') {
            const v = this.getAttribute('data-wo-state');
            if (v) this.setAttribute('data-ej-estado', v);
          }
        }
        this.idioma();
      });
      this.obs.observe(this, { attributes: true, attributeFilter: ['data-ej-lang', 'data-wo-state'] });
      if (this.scope) this.obs.observe(this.scope, { attributes: true, attributeFilter: ['data-ej-lang'] });
      this.idioma();
    }
    disconnectedCallback() { this.obs?.disconnect(); }
    private idioma() {
      const l = this.scope?.getAttribute('data-ej-lang') || this.getAttribute('data-ej-lang') || 'es';
      if (this.getAttribute('data-ej-l-activo') === l) return;
      if (!this.querySelector(`.ej__l[data-ej-l-pane="${l}"]`)) {
        const t = this.querySelector<HTMLTemplateElement>(`template[data-ej-l="${l}"]`);
        if (!t) return;
        t.replaceWith(t.content.cloneNode(true));
      }
      this.setAttribute('data-ej-l-activo', l);
      this.dispatchEvent(new CustomEvent('ej:idioma', { bubbles: true, detail: { lang: l } }));
    }
  }
  if (!customElements.get('ej-web')) customElements.define('ej-web', EjWeb);
</script>

<style>
  /* ═══ Raíz: variables con prioridad del scope ═══ */
  .ej-sr { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .ej {
    --ej-bg: var(--ej-s-bg, var(--ej-m-bg));
    --ej-ink: var(--ej-s-ink, var(--ej-m-ink));
    --ej-ink-2: var(--ej-s-ink-2, var(--ej-m-ink-2));
    --ej-accent: var(--ej-s-accent, var(--ej-m-accent));
    --ej-on-accent: var(--ej-s-on-accent, var(--ej-m-on-accent));
    --ej-radius: var(--ej-s-radius, var(--ej-m-radius));
    --ej-font-display: var(--ej-s-font-display, var(--font-display));
    --ej-display-weight: var(--ej-s-display-weight, 500);
    --ej-rule: color-mix(in srgb, var(--ej-ink) 16%, transparent);
    --ej-crema: 240, 237, 232;
    --ej-t: 220ms cubic-bezier(.22, 1, .36, 1);
    position: relative; display: block; width: 100%;
    font-family: var(--font-body); text-align: left;
  }
  /* Modo noche: raíz < scope (el scope pesa más). Si el scope escribe --ej-s-*, mandan esas. */
  .ej[data-ej-mode='oscuro'],
  :global([data-ej-scope][data-ej-mode='oscuro']) .ej {
    --ej-bg: var(--ej-s-bg, var(--ej-n-bg)); --ej-ink: var(--ej-s-ink, var(--ej-n-ink)); --ej-ink-2: var(--ej-s-ink-2, var(--ej-n-ink-2));
    --ej-accent: var(--ej-s-accent, var(--ej-n-accent)); --ej-on-accent: var(--ej-s-on-accent, var(--ej-n-on-accent));
  }
  :global([data-ej-scope][data-ej-mode='claro']) .ej {
    --ej-bg: var(--ej-s-bg, var(--ej-m-bg)); --ej-ink: var(--ej-s-ink, var(--ej-m-ink)); --ej-ink-2: var(--ej-s-ink-2, var(--ej-m-ink-2));
    --ej-accent: var(--ej-s-accent, var(--ej-m-accent)); --ej-on-accent: var(--ej-s-on-accent, var(--ej-m-on-accent));
  }
  /* Idioma: lo resuelve <ej-web> en data-ej-l-activo. */
  .ej[data-ej-l-activo='es'] .ej__l:not([data-ej-l-pane='es']),
  .ej[data-ej-l-activo='en'] .ej__l:not([data-ej-l-pane='en']) { display: none; }

  /* ═══ Marcos ═══ */
  .ej--movil { width: 300px; max-width: 100%; }
  .ej__marco { position: relative; }
  .ej--navegador .ej__marco {
    border-radius: 12px; overflow: hidden; background: #1a1a19;
    box-shadow: 0 0 0 1px rgba(255,255,255,.10), 0 24px 48px -24px rgba(0,0,0,.6);
  }
  .ej__barra { display: flex; align-items: center; gap: 6px; height: 28px; padding: 0 12px; }
  .ej__barra > i { width: 8px; height: 8px; border-radius: 50%; background: #626468; flex: none; }
  .ej__url {
    margin: 0 auto; transform: translateX(-21px); max-width: 70%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    font: 500 11px/18px var(--font-mono); letter-spacing: .02em; color: rgba(var(--ej-crema), .72);
    padding: 0 10px; border-radius: 6px; background: rgba(255,255,255,.06);
  }
  .ej__url-ej { color: rgba(var(--ej-crema), .6); }
  .ej--tarjeta .ej__marco { border-radius: 12px; overflow: hidden; }
  .ej--movil .ej__marco {
    padding: 8px; border-radius: 28px; background: #111110;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.10), 0 0 0 1px rgba(var(--accent-gold-rgb, 196,163,90), .12);
  }
  .ej--movil .ej__vp { border-radius: 21px; }
  .ej__isla { position: absolute; z-index: 2; top: 18px; left: 50%; width: 64px; height: 18px; margin-left: -32px; border-radius: 9px; background: #111110; }
  .ej__rot {
    display: block; margin-top: 10px; font: 500 11px/1.3 var(--font-mono); letter-spacing: .06em;
    color: rgba(var(--ej-crema), .6); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
