  .ej--vertical.ej--completa .ej__arte { right: -6px; bottom: auto; top: 194px; }
  .ej--vertical .ej__gar { margin-top: auto; margin-bottom: 18px; grid-template-columns: 1fr; }
  .ej--vertical .ej__g { padding: 10px 0; border-bottom: 1px solid var(--ej-rule); }
