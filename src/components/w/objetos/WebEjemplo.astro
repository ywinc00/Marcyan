  /* ═══ ESTADO alambre: la web en línea, con cotas (escáner P04, MiniPasos P03) ═══ */
  .ej[data-ej-estado='alambre'] .ej__vp,
  .ej[data-ej-estado='alambre'] .ej__pg { background: transparent; }
  .ej[data-ej-estado='alambre'] .ej__pg { color: rgba(var(--ej-crema), .55); }
