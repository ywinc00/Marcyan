  .ej--escritorio .ej__hero { flex: 1; display: grid; grid-template-columns: repeat(12, 1fr); column-gap: 24px; padding-top: 72px; }
  .ej--escritorio .ej__copy { grid-column: 1 / span 7; }
  .ej--escritorio .ej__arte { grid-column: 8 / span 5; justify-self: end; margin-top: -40px; }
