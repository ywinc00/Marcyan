const t = TRAZOS[marca];
const [w, h, d] = t[lang];
const alto = +(size * h / t.cap).toFixed(2);
const ancho = +(alto * w / h).toFixed(2);
const conSigno = signo && marca === 'plomeria';
const s = +(size * 1.75).toFixed(2);
const idPal = `ej-s-logo-${marca}-${lang}`;
// Signo de plomería (ronda 1): anillo más fino (6 de 20) con brida a la salida y la gota separada,
// para que a tamaño de nav se lea como un codo de tubería y no como una mancha.
const CODO = 'M3 3A20 20 0 0 1 23 23H17A14 14 0 0 0 3 9Z';
const BRIDA = 'M15.6 23.4H24.4V25H15.6Z';
const GOTA = 'M20 26.4C20 26.4 22.4 29 22.4 30.2A2.4 2.4 0 0 1 17.6 30.2C17.6 29 20 26.4 20 26.4Z';
const fGota = 'fill:var(--ej-logo-gota,var(--ej-accent,currentColor))';
---
{modo === 'simbolo' ? (
  <>
    {solo !== 'signo' && <symbol id={idPal} viewBox={`0 0 ${w} ${h}`} overflow="visible"><path d={d} fill="currentColor" /></symbol>}
    {(solo === 'signo' || (solo !== 'palabra' && conSigno)) && (
      <symbol id="ej-s-signo" viewBox="2 2 23 31" overflow="visible"><path d={CODO + BRIDA} fill="currentColor" /><path d={GOTA} style={fGota} /></symbol>
    )}
  </>
) : (
  <span class:list={['ej-logo', `ej-logo--${tono}`, cls]} style={`--ej-logo-cap:${size}px`} aria-hidden="true">
    {conSigno && (modo === 'uso' ? (
      <svg class="ej-logo__signo" width={+(s * 23 / 31).toFixed(2)} height={s} focusable="false"><use href="#ej-s-signo" /></svg>
    ) : (
      <svg class="ej-logo__signo" width={+(s * 23 / 31).toFixed(2)} height={s} viewBox="2 2 23 31" fill="none" focusable="false">
        <path d={CODO + BRIDA} fill="currentColor" /><path d={GOTA} style={fGota} />
      </svg>
    ))}
    {modo === 'uso' ? (
      <svg class="ej-logo__palabra" width={ancho} height={alto} focusable="false"><use href={`#${idPal}`} /></svg>
    ) : (
      <svg class="ej-logo__palabra" width={ancho} height={alto} viewBox={`0 0 ${w} ${h}`} focusable="false"><path d={d} fill="currentColor" /></svg>
    )}
  </span>
)}

<style>
  .ej-logo { display: inline-flex; align-items: center; gap: calc(var(--ej-logo-cap) * .5); color: var(--ej-ink, currentColor); line-height: 0; flex: none; }
  .ej-logo svg { display: block; overflow: visible; flex: none; }
  .ej-logo__signo { margin-block: calc(var(--ej-logo-cap) * -.3); }
  .ej-logo--mono { --ej-logo-gota: currentColor; }
</style>
