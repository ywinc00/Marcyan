---
// P11 · Escena 02 "Plan a la vista" (design/rediseno-workos-v2.md §2 P11).
// Plan de EJEMPLO en papel claro: 4 casillas de alcance que se marcan una a una (250 ms),
// total "Desde $X" de PRICE_ANCHORS (diseño web, vía proceso.ts) y un cursor que pulsa
// "Aprobar" → "Aprobado ✓". Satélite (gesto W-ADV-58 / W-CORE-05): la tarjeta oscura "Cada mes"
// asoma por la derecha con el SEO local y el mantenimiento, también de PRICE_ANCHORS (el paso 02
// dice "incluido el SEO mensual y el mantenimiento que otros te esconden").
// Se reproduce cuando un ancestro recibe .is-play (LineaFases); sin JS, sin .is-play o con
// reducir movimiento se ve el estado final (aprobado). Micro-vida (§1.5): una luz recorre el botón
// "Aprobado" cada 4 s mientras la línea está a la vista (.is-vista).
// Objeto de ejemplo (§1.6): aria-hidden + data-nosnippet, sin h1-h6, sin botones reales.
import { copy, type Lang } from './proceso';

interface Props { lang?: Lang; class?: string }
const { lang = 'es', class: cls } = Astro.props;
const T = copy[lang].alcance;
---
<div class:list={['al', cls]} aria-hidden="true" data-nosnippet>
  <div class="al__card">
    <div class="al__top">
      <span class="al__lab">{T.lab}</span>
      <span class="al__name">{T.producto}</span>
    </div>
    <ul class="al__list">
      {T.items.map((t, i) => (
        <li style={`--i:${i}`}>
          <span class="al__chk"><svg viewBox="0 0 16 16" width="10" height="10"><path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
          <span class="al__it">{t}</span>
        </li>
      ))}
    </ul>
    <div class="al__tot"><span>{T.total}</span><b>{T.desde}</b></div>
    <div class="al__act">
      <span class="al__btn">
        <span class="al__b1">{T.aprobar}</span>
        <span class="al__b2">{T.aprobado} <svg viewBox="0 0 16 16" width="12" height="12"><path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
        <span class="al__glint"></span>
      </span>
      <svg class="al__cursor" viewBox="0 0 20 22" width="20" height="22"><path d="M2 1.5l15 9.2-6.6 1.5-3.3 6.3z" fill="#0e0e0d" stroke="#f0ede8" stroke-width="1.4" stroke-linejoin="round" /></svg>
    </div>
  </div>
  <div class="al__mes">
    <span class="al__ml">{T.mes}</span>
    {T.mensual.map(([k, v]) => <span class="al__mr"><span>{k}</span><b>{v}</b></span>)}
  </div>
</div>

<style>
  .al { position: relative; display: grid; place-items: center; width: 100%; height: 100%; font-family: var(--font-body); }
  .al__card {
    position: relative; width: 340px; padding: 18px 20px 16px; transform: translateX(-68px);
    background: #fbfaf8; color: var(--w-p-ink, #0e0e0d);
    border-radius: var(--w-r-obj, 12px); border: 1px solid rgba(14,14,13,.10);
    box-shadow: 0 1px 0 rgba(255,255,255,.6) inset, 0 30px 60px -22px rgba(0,0,0,.75);
  }
  .al__top { display: flex; flex-direction: column; gap: 5px; padding-bottom: 12px; border-bottom: 1px solid rgba(14,14,13,.08); }
  .al__lab { font: 500 11px/1.2 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--w-p-ink-2, #4a4743); }
  .al__name { font: 500 20px/1.2 var(--font-display); letter-spacing: -.02em; }
  .al__list { list-style: none; margin: 0; padding: 2px 0; }
  .al__list li { display: flex; align-items: center; gap: 12px; padding: 8px 0; font-size: 15px; line-height: 1.3; border-bottom: 1px solid rgba(14,14,13,.08); }
  .al__chk {
    position: relative; flex: none; width: 18px; height: 18px; border-radius: 50%;
    display: grid; place-items: center; color: #fbfaf8; background: var(--w-p-ink, #0e0e0d);
  }
  .al__tot { display: flex; align-items: baseline; justify-content: space-between; padding: 12px 0 0; }
  .al__tot span { font: 500 11px/1.2 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--w-p-ink-2, #4a4743); }
  .al__tot b { font: 500 24px/1.1 var(--font-display); letter-spacing: -.02em; }
  .al__act { position: relative; display: flex; justify-content: flex-end; padding-top: 12px; }
  .al__btn {
    position: relative; display: inline-grid; height: 36px; padding: 0 16px; border-radius: 8px; overflow: hidden;
    background: var(--w-p-ink, #0e0e0d); color: #fbfaf8; font-size: 14px; font-weight: 500;
  }
  .al__b1, .al__b2 { grid-area: 1 / 1; display: inline-flex; align-items: center; justify-content: center; gap: 6px; white-space: nowrap; }
  .al__b1 { opacity: 0; }
  .al__b2 svg { color: var(--accent-gold, #c8a96e); }
  .al__glint { position: absolute; inset: 0; width: 40%; background: linear-gradient(100deg, transparent, rgba(255,240,205,.28), transparent); transform: translateX(-120%); pointer-events: none; }
  .al__cursor { position: absolute; right: 30px; bottom: -4px; opacity: 0; pointer-events: none; }

  /* Satélite "Cada mes": tarjeta oscura que asoma por la derecha, encima del borde del plan. */
  .al__mes {
    position: absolute; right: 18px; top: 50%; width: 212px; translate: 0 -64%;
    display: flex; flex-direction: column; padding: 12px 14px 6px; border-radius: var(--w-r-obj, 12px);
    background: var(--w-s3, #1f1f1d); color: var(--w-ink, #f0ede8);
    border: 1px solid rgba(200,169,110,.18); box-shadow: 0 22px 44px -14px rgba(0,0,0,.8);
  }
  .al__ml { padding-bottom: 8px; font: 500 11px/1.2 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--accent-gold, #c8a96e); }
  .al__mr { display: flex; flex-direction: column; gap: 3px; padding: 9px 0; border-top: 1px solid rgba(240,237,232,.09); }
  .al__mr span { font-size: 13px; color: rgba(240,237,232,.72); white-space: nowrap; }
  .al__mr b { white-space: nowrap; }
  .al__mr b { font: 500 16px/1.15 var(--font-display); letter-spacing: -.01em; }

  /* ── Compacta y móvil: compuesta a su tamaño, nunca encogida (ningún texto < 11 px). ── */
  @container (max-width: 440px) {
    .al { align-content: center; justify-items: stretch; padding: 14px 6px; }
    .al__card { width: min(100%, 300px); justify-self: start; transform: none; padding: 14px 16px 12px; }
    .al__name { font-size: 17px; }
    .al__list li { padding: 6px 0; font-size: 13px; gap: 10px; }
    .al__tot b { font-size: 20px; }
    .al__mes { position: relative; right: auto; top: auto; translate: none; justify-self: end; width: 230px; margin-top: -18px; padding: 10px 12px 4px; }
    .al__mr { padding: 6px 0; flex-direction: row; justify-content: space-between; align-items: baseline; gap: 8px; }
    .al__mr span { font-size: 12px; }
    .al__mr b { font-size: 13px; }
  }
  /* Compacta de escritorio (panel 420×320, escenario 388×252): plan y satélite lado a lado. */
  @media (min-width: 1120px) {
    :global(.lf--compacta) .al { grid-template-columns: 236px 150px; align-content: center; justify-content: center; padding: 0; }
    :global(.lf--compacta) .al__card { width: 100%; padding: 10px 12px 10px; }
    :global(.lf--compacta) .al__top { padding-bottom: 6px; gap: 3px; }
    :global(.lf--compacta) .al__name { font-size: 14px; }
    :global(.lf--compacta) .al__list li { padding: 3px 0; font-size: 12px; gap: 8px; }
    :global(.lf--compacta) .al__chk { width: 14px; height: 14px; }
    :global(.lf--compacta) .al__tot { padding-top: 6px; }
    :global(.lf--compacta) .al__tot b { font-size: 16px; }
    :global(.lf--compacta) .al__act { padding-top: 6px; }
    :global(.lf--compacta) .al__btn { height: 28px; padding: 0 12px; font-size: 12px; }
    :global(.lf--compacta) .al__mes { width: 160px; margin: 0 0 0 -10px; align-self: center; }
    :global(.lf--compacta) .al__mr { flex-direction: column; align-items: flex-start; gap: 2px; }
    :global(.lf--compacta) .al__mr b { font-size: 13px; }
  }

  /* ── Coreografía (solo con .is-play en un ancestro; sin él, estado final) ── */
  :global(.is-play) .al__card { animation: al-card 480ms var(--w-ease-text, ease) 60ms both; }
  :global(.is-play) .al__chk { animation: al-chk 320ms var(--w-ease-text, ease) both; animation-delay: calc(450ms + var(--i) * 250ms); }
  :global(.is-play) .al__it { animation: al-it 320ms ease both; animation-delay: calc(450ms + var(--i) * 250ms); }
  :global(.is-play) .al__tot { animation: al-in 420ms var(--w-ease-text, ease) 1550ms both; }
  :global(.is-play) .al__mes { animation: al-sat 560ms var(--w-ease-sat, ease) 1850ms both; }
  :global(.is-play) .al__mr { animation: al-in 360ms ease both; }
  :global(.is-play) .al__mr:nth-of-type(2) { animation-delay: 2150ms; }
  :global(.is-play) .al__mr:nth-of-type(3) { animation-delay: 2300ms; }
  :global(.is-play) .al__btn { animation: al-press 220ms ease 2750ms both; }
  :global(.is-play) .al__b1 { animation: al-b1 3000ms linear both; }
  :global(.is-play) .al__b2 { animation: al-b2 3000ms linear both; }
  :global(.is-play) .al__cursor { animation: al-cur 3600ms var(--w-ease-ui, ease) both; }
  @keyframes al-card { from { opacity: 0; translate: 0 10px; scale: .98; } }
  @keyframes al-chk { from { opacity: 0; transform: scale(.4); background: transparent; } to { opacity: 1; transform: scale(1); } }
  @keyframes al-it { from { opacity: .35; } to { opacity: 1; } }
  @keyframes al-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @keyframes al-sat { from { opacity: 0; transform: translateX(-24px); } to { opacity: 1; transform: none; } }
  @keyframes al-press { 0% { transform: scale(1); } 45% { transform: scale(.95); } 100% { transform: scale(1); } }
  @keyframes al-b1 { 0%, 92% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes al-b2 { 0%, 92% { opacity: 0; transform: translateY(4px); } 100% { opacity: 1; transform: none; } }
  @keyframes al-cur {
    0%, 45% { opacity: 0; transform: translate(70px, 60px); }
    52% { opacity: 1; transform: translate(70px, 60px); }
    74% { opacity: 1; transform: translate(0, 0); }
    78% { transform: translate(0, 0) scale(.88); }
    82% { transform: translate(0, 0) scale(1); opacity: 1; }
    94%, 100% { opacity: 0; transform: translate(10px, 14px); }
  }
  /* Micro-vida: luz que recorre "Aprobado" cada 4 s (solo a la vista). */
  .al__glint { animation: al-glint 4s var(--w-ease-ui, ease) 3.4s infinite; animation-play-state: paused; }
  :global(.is-vista) .al__glint { animation-play-state: running; }
  @keyframes al-glint { 0% { transform: translateX(-120%); } 30%, 100% { transform: translateX(260%); } }
  @media (prefers-reduced-motion: reduce) {
    :global(.is-play) .al__card, :global(.is-play) .al__chk, :global(.is-play) .al__it, :global(.is-play) .al__tot, :global(.is-play) .al__btn,
    :global(.is-play) .al__b1, :global(.is-play) .al__b2, :global(.is-play) .al__cursor, :global(.is-play) .al__mes, :global(.is-play) .al__mr,
    .al__glint { animation: none !important; }
  }
</style>
