---
// P11 · Escena 03 "Diseño bilingüe" (design/rediseno-workos-v2.md §2 P11).
// La web de EJEMPLO del salón ("Tu Salón" / "Your Salon", §1.6), con la paleta, el logotipo, el titular y la acción
// CANÓNICOS de P02a (negocios.ts, ver proceso.ts: SALON_PALETA / SALON_LOGO), para que no haya dos salones distintos;
// hero tipográfico + volumen geométrico (sin cuadradito con inicial ni botón a todo el ancho), en un
// navegador dibujado, con el segmentado ES | EN como satélite. Cambia UNA vez al otro idioma y vuelve:
// el idioma nuevo entra con una cortina que barre de izquierda a derecha con su filo de luz (máscara
// por translate contrapuesto, §1.8: nunca se ven los dos textos a la vez). Arranca con .is-play en un
// ancestro (LineaFases); sin él, o con reducir movimiento, queda en el idioma de la página, quieta.
// Micro-vida (§1.5): el sol del arco respira mientras la línea está a la vista (.is-vista).
// Mientras P02 (WebEjemplo premium) no esté integrado, la web se dibuja aquí; cuando entre, el
// director decide si se sustituye por <WebEjemplo marca="salon" frame="tarjeta" lienzo="vertical" />.
import { copy, type Lang } from './proceso';

interface Props { lang?: Lang; city?: string; class?: string }
const { lang = 'es', city = 'Houston', class: cls } = Astro.props;
// v8 (dueño, 2026-11-08: «no todo ejemplo de web tiene que ser tu salón»): la web bilingüe es la de un
// BUFETE de inmigración y familia, donde el idioma es el servicio. Principios de Refero Legora
// (0ab6a10a) y Titan (56105743): pergamino, titular serif, pastilla negra y áreas en filas finas.
const B = {
  es: { nav: ['Áreas', 'Equipo', 'Contacto'], zona: `Inmigración y familia · ${city}`, h: 'Te explicamos tu caso en tu idioma.', sub: 'Primera consulta sin costo, con un abogado que te habla claro.', btn: 'Pedir consulta', areas: ['Residencia', 'Ciudadanía', 'Visas de trabajo', 'Familia'], pie: 'Atendemos en español e inglés', hor: 'Lun a vie · 9 a. m. a 6 p. m.' },
  en: { nav: ['Practice', 'Team', 'Contact'], zona: `Immigration and family · ${city}`, h: 'We explain your case in your language.', sub: 'First consultation at no cost, with a lawyer who speaks plainly.', btn: 'Book a consultation', areas: ['Green cards', 'Citizenship', 'Work visas', 'Family'], pie: 'We serve you in English and Spanish', hor: 'Mon to Fri · 9 AM to 6 PM' },
} as const;
const T = copy[lang].bilingue;
const otro: Lang = lang === 'es' ? 'en' : 'es';
const capas = [{ l: lang, c: 'a' }, { l: otro, c: 'b' }] as const;
const marca = lang === 'en' ? 'Your Law Firm' : 'Tu Bufete';
---
<div class:list={['bi', cls]} aria-hidden="true" data-nosnippet>
  <div class="bi__win">
    <div class="bi__chrome">
      <span class="bi__dots"><i></i><i></i><i></i></span>
      <span class="bi__url" translate="no">tubufete.example</span>
    </div>
    <div class="bi__view">
      {capas.map(({ l, c }) => {
        const S = B[l];
        const site = (
          <div class="bi__site" lang={l}>
            <div class="bi__nav">
              <span class="bi__logo">{marca}</span>
              <span class="bi__links">{S.nav.map((n) => <span>{n}</span>)}<b>{l.toUpperCase()}</b></span>
            </div>
            <div class="bi__hero">
              <div class="bi__txt">
                <span class="bi__zona">{S.zona}</span>
                <span class="bi__h">{S.h}</span>
                <span class="bi__sub">{S.sub}</span>
                <span class="bi__btn">{S.btn}</span>
              </div>
              <ul class="bi__areas">{S.areas.map((x) => <li>{x}<i>→</i></li>)}</ul>
            </div>
            <div class="bi__strip">
              <span class="bi__svc">{S.pie}</span>
              <span class="bi__hor">{S.hor}</span>
            </div>
          </div>
        );
        return c === 'a'
          ? <div class="bi__la">{site}</div>
          : <div class="bi__wipe"><div class="bi__lb">{site}</div><span class="bi__edge bi__edge--r"></span><span class="bi__edge bi__edge--l"></span></div>;
      })}
    </div>
  </div>
  <span class="bi__seg" data-from={lang}>
    <span class="bi__pill"></span>
    <span class:list={['bi__o', lang === 'es' && 'is-a']}>{T.es}</span>
    <span class:list={['bi__o', lang === 'en' && 'is-a']}>{T.en}</span>
  </span>
</div>

<style>
  .bi { position: relative; display: grid; place-items: center; width: 100%; height: 100%; font-family: var(--font-body); }
  .bi__win {
    width: 424px; border-radius: var(--w-r-obj, 12px); overflow: hidden; background: #fbfaf8;
    border: 1px solid rgba(14,14,13,.10); box-shadow: 0 30px 60px -22px rgba(0,0,0,.75); transform: translateX(-12px);
  }
  .bi__chrome { display: flex; align-items: center; gap: 10px; height: 32px; padding: 0 12px; border-bottom: 1px solid rgba(14,14,13,.08); }
  .bi__dots { display: flex; gap: 5px; }
  .bi__dots i { width: 8px; height: 8px; border-radius: 50%; background: rgba(14,14,13,.14); }
  .bi__url { flex: 1; margin-right: 44px; text-align: center; font: 500 11px/22px var(--font-mono); color: #4a4743; background: rgba(14,14,13,.05); border-radius: 6px; }

  /* Vista: la capa A (idioma de la página) debajo; la B dentro de una cortina que la descubre. */
  .bi__view { position: relative; display: grid; overflow: hidden; }
  .bi__la, .bi__wipe { grid-area: 1 / 1; }
  .bi__wipe { position: relative; overflow: hidden; transform: translateX(-101%); }
  .bi__lb { transform: translateX(101%); }
  /* Las dos capas ocupan el alto de la más alta (el titular EN canónico es más largo): sin franja vacía bajo la capa corta. */
  .bi__la, .bi__wipe { display: flex; }
  .bi__lb { flex: 1; display: flex; }
  .bi__la > .bi__site, .bi__lb > .bi__site { flex: 1; display: flex; flex-direction: column; }
  .bi__hero { flex: 1; }
  .bi__edge { position: absolute; top: 0; bottom: 0; width: 56px; pointer-events: none; opacity: 0; }
  .bi__edge--r { right: 0; background: linear-gradient(90deg, rgba(246,239,234,0), rgba(246,239,234,.85)); }
  .bi__edge--l { left: 0; background: linear-gradient(270deg, rgba(246,239,234,0), rgba(246,239,234,.85)); }

  .bi__site { background: #f6f4ef; color: #16181d; padding: 14px 20px 0; }
  .bi__nav { display: flex; align-items: center; justify-content: space-between; padding-bottom: 18px; }
  .bi__logo { font: 400 17px/1 Georgia, 'Times New Roman', serif; letter-spacing: -.01em; }
  .bi__links { display: inline-flex; align-items: center; gap: 14px; font-size: 11px; color: #5d6068; }
  .bi__links b { font: 600 11px/1 var(--font-mono); letter-spacing: .08em; color: #1d2b4f; }
  .bi__hero { display: grid; grid-template-columns: 1fr 136px; gap: 20px; align-items: end; }
  .bi__txt { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; padding-bottom: 22px; }
  .bi__zona { font-size: 11px; font-weight: 600; color: #1d2b4f; }
  .bi__h { font: 400 30px/1.02 Georgia, 'Times New Roman', serif; letter-spacing: -.02em; text-wrap: balance; }
  .bi__sub { font-size: 12px; line-height: 1.4; color: #5d6068; }
  .bi__btn { display: inline-flex; align-items: center; height: 30px; padding: 0 16px; border-radius: 999px; background: #16181d; color: #f6f4ef; font: 600 12px/1 var(--font-body); }
  .bi__areas { margin: 0 0 22px; padding: 0; list-style: none; display: flex; flex-direction: column; }
  .bi__areas li { display: flex; justify-content: space-between; padding: 8px 0; border-top: 1px solid #dcd8cf; font-size: 12px; color: #16181d; }
  .bi__areas li:last-child { border-bottom: 1px solid #dcd8cf; }
  .bi__areas i { font-style: normal; color: #8a8c93; }
  .bi__strip { display: flex; align-items: center; justify-content: space-between; gap: 12px; height: 38px; border-top: 1px solid #dcd8cf; font-size: 12px; }
  .bi__svc { font-weight: 600; }
  .bi__hor { font: 500 11px/1 var(--font-mono); color: #5d6068; white-space: nowrap; }

  /* Segmentado: satélite que asoma por arriba a la derecha de la ventana (gesto W-ADV-58). */
  .bi__seg {
    position: absolute; top: max(6px, calc(50% - 168px)); right: max(6px, calc(50% - 236px));
    display: grid; grid-template-columns: 1fr 1fr; padding: 4px; border-radius: 999px;
    background: var(--w-s3, #1f1f1d); border: 1px solid rgba(200,169,110,.18);
    box-shadow: 0 12px 28px -10px rgba(0,0,0,.7);
    font: 500 12px/1 var(--font-mono); letter-spacing: .1em;
  }
  .bi__o { position: relative; z-index: 1; width: 44px; height: 28px; display: grid; place-items: center; color: rgba(240,237,232,.6); }
  .bi__o.is-a { color: var(--w-p-ink, #0e0e0d); }
  .bi__pill { position: absolute; top: 4px; left: 4px; width: 44px; height: 28px; border-radius: 999px; background: var(--accent-gold, #c8a96e); }
  .bi__seg[data-from='en'] .bi__pill { transform: translateX(44px); }

  /* ── Compacta y móvil: la web compuesta a su tamaño (texto ≥ 11 px), no encogida. ── */
  @container (max-width: 440px) {
    .bi { padding: 22px 0 8px; }
    .bi__win { width: min(100%, 320px); transform: none; }
    .bi__chrome { height: 26px; }
    .bi__dots { display: none; }
    .bi__url { margin-right: 70px; }
    .bi__site { padding: 10px 14px 0; }
    .bi__nav { padding-bottom: 10px; }
    .bi__links span { display: none; }
    .bi__hero { grid-template-columns: 1fr; gap: 0; }
    .bi__areas { display: none; }
    .bi__txt { gap: 7px; padding-bottom: 12px; }
    .bi__h { font-size: 21px; }
    .bi__sub { font-size: 11px; }
    .bi__btn { height: 26px; padding: 0 12px; font-size: 11px; }
    .bi__strip { height: 30px; font-size: 11px; }
    .bi__hor { display: none; }
    .bi__seg { top: 6px; right: max(6px, calc(50% - 166px)); }
    .bi__o { width: 38px; height: 24px; font-size: 11px; }
    .bi__pill { width: 38px; height: 24px; }
    .bi__seg[data-from='en'] .bi__pill { transform: translateX(38px); }
  }

  /* ── Coreografía (5,4 s): idioma de la página · cortina al otro (900 ms) · se queda · vuelve ── */
  :global(.is-play) .bi__win { animation: bi-win 480ms var(--w-ease-text, ease) 60ms both; }
  :global(.is-play) .bi__wipe { animation: bi-wipe 5400ms var(--w-ease-ui, ease) both; }
  :global(.is-play) .bi__lb { animation: bi-lb 5400ms var(--w-ease-ui, ease) both; }
  :global(.is-play) .bi__edge--r { animation: bi-er 5400ms linear both; }
  :global(.is-play) .bi__edge--l { animation: bi-el 5400ms linear both; }
  :global(.is-play) .bi__seg[data-from='es'] .bi__pill { animation: bi-pill 5400ms var(--w-ease-ui, ease) both; --d: 44px; }
  :global(.is-play) .bi__seg[data-from='en'] .bi__pill { animation: bi-pill-r 5400ms var(--w-ease-ui, ease) both; --d: 44px; }
  @keyframes bi-win { from { opacity: 0; translate: 0 10px; scale: .98; } }
  /* 0-24 % quieta · 24-41 % la cortina descubre el otro idioma · 41-72 % quieta · 72-89 % la cortina se va y vuelve el de la página. */
  /* v8 (rev. móvil 2026-11-08): en vez de cortina, un idioma se va del todo antes de que entre el otro
     (a media cortina se leían los dos textos partidos). La capa B ya está en su sitio; solo cambia la opacidad. */
  .bi__wipe, .bi__lb { transform: none !important; }
  .bi__wipe { opacity: 0; }
  .bi__edge { display: none; }
  @keyframes bi-wipe { 0%, 30% { opacity: 0; } 35%, 72% { opacity: 1; } 76%, 100% { opacity: 0; } }
  @keyframes bi-lb { from { opacity: 1; } to { opacity: 1; } }
  :global(.is-play) .bi__la { animation: bi-la 5400ms linear both; }
  @keyframes bi-la { 0%, 25% { opacity: 1; } 29%, 77% { opacity: 0; } 81%, 100% { opacity: 1; } }
  @keyframes bi-er { 0%, 24% { opacity: 0; } 26%, 39% { opacity: 1; } 41%, 100% { opacity: 0; } }
  @keyframes bi-el { 0%, 72% { opacity: 0; } 74%, 87% { opacity: 1; } 89%, 100% { opacity: 0; } }
  @keyframes bi-pill { 0%, 24% { transform: none; } 30%, 72% { transform: translateX(var(--d)); } 78%, 100% { transform: none; } }
  @keyframes bi-pill-r { 0%, 24% { transform: translateX(var(--d)); } 30%, 72% { transform: none; } 78%, 100% { transform: translateX(var(--d)); } }
  @container (max-width: 440px) { :global(.is-play) .bi__pill { --d: 38px; } }
  /* El texto del segmentado sigue a la píldora. */
  :global(.is-play) .bi__o.is-a { animation: bi-oa 5400ms linear both; }
  :global(.is-play) .bi__o:not(.is-a) { animation: bi-ob 5400ms linear both; }
  @keyframes bi-oa { 0%, 26% { color: var(--w-p-ink, #0e0e0d); } 28%, 74% { color: rgba(240,237,232,.6); } 76%, 100% { color: var(--w-p-ink, #0e0e0d); } }
  @keyframes bi-ob { 0%, 26% { color: rgba(240,237,232,.6); } 28%, 74% { color: var(--w-p-ink, #0e0e0d); } 76%, 100% { color: rgba(240,237,232,.6); } }
  @media (prefers-reduced-motion: reduce) {
    :global(.is-play) .bi__win, :global(.is-play) .bi__wipe, :global(.is-play) .bi__lb, :global(.is-play) .bi__edge--r, :global(.is-play) .bi__edge--l,
    :global(.is-play) .bi__pill, :global(.is-play) .bi__o, :global(.is-play) .bi__la { animation: none !important; }
  }
</style>
