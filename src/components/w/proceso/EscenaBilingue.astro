---
// P11 · Escena 03 "Diseño bilingüe" (design/rediseno-workos-v2.md §2 P11).
// La web de EJEMPLO del salón (WebEjemplo, marco tarjeta: el panel no llega a 640 px, §1.8)
// con un segmentado ES | EN que cambia SOLO una vez a EN con un brillo que barre el texto
// (900 ms) y vuelve a ES. Arranca con .is-play en un ancestro (LineaFases); sin él, o con
// reducir movimiento, queda en el idioma de la página, quieta.
// WebEjemplo: hoy es la versión v1 (props kind/site). Cuando entre P02 (marca/lienzo/<template>
// del idioma inactivo) se cambia aquí: <WebEjemplo marca="salon" frame="tarjeta" lienzo="vertical" />.
import WebEjemplo from '../objetos/WebEjemplo.astro';
import { copy, type Lang } from './proceso';

interface Props { lang?: Lang; class?: string }
const { lang = 'es', class: cls } = Astro.props;
const T = copy[lang].bilingue;
const otro: Lang = lang === 'es' ? 'en' : 'es';
---
<div class:list={['bi', cls]} aria-hidden="true" data-nosnippet>
  <div class="bi__web">
    <div class="bi__l bi__l--a"><WebEjemplo kind="salon" frame="tarjeta" lang={lang} site={lang} example={false} /></div>
    <div class="bi__l bi__l--b"><WebEjemplo kind="salon" frame="tarjeta" lang={lang} site={otro} example={false} /></div>
    <span class="bi__shine"></span>
  </div>
  <span class="bi__seg" data-from={lang}>
    <span class="bi__pill"></span>
    <span class:list={['bi__o', lang === 'es' && 'is-a']}>{T.es}</span>
    <span class:list={['bi__o', lang === 'en' && 'is-a']}>{T.en}</span>
  </span>
</div>

<style>
  .bi { position: relative; display: grid; place-items: center; width: 100%; height: 100%; }
  .bi__web { position: relative; display: grid; width: min(100%, 360px); padding: 18px; border-radius: var(--w-r-obj, 12px); overflow: clip; background: var(--w-p-bg, #f0ede8); border: 1px solid var(--w-p-line, rgba(14,14,13,.08)); box-shadow: 0 24px 48px -18px rgba(0,0,0,.6); }
  .bi__l { grid-area: 1 / 1; }
  .bi__l--b { opacity: 0; }
  .bi__l :global(.wo-web) { width: 100%; max-width: none; }
  .bi__shine {
    position: absolute; inset: 0; pointer-events: none; opacity: 0;
    background: linear-gradient(100deg, transparent 35%, rgba(255,255,255,.55) 50%, transparent 65%);
    transform: translateX(-100%);
  }
  /* Segmentado: satélite que asoma por arriba a la derecha de la web (gesto W-ADV-58). */
  .bi__seg {
    position: absolute; top: max(6px, calc(50% - 168px)); right: max(6px, calc(50% - 222px));
    display: grid; grid-template-columns: 1fr 1fr; padding: 4px; border-radius: 999px;
    background: var(--w-s3, #1f1f1d); border: 1px solid var(--w-line-strong, rgba(200,169,110,.18));
    box-shadow: 0 12px 28px -10px rgba(0,0,0,.7);
    font: 500 12px/1 var(--font-mono); letter-spacing: .1em;
  }
  .bi__o { position: relative; z-index: 1; width: 44px; height: 28px; display: grid; place-items: center; color: var(--w-ink-60, rgba(240,237,232,.6)); }
  .bi__o.is-a { color: var(--w-p-ink, #0e0e0d); }
  .bi__pill { position: absolute; top: 4px; left: 4px; width: 44px; height: 28px; border-radius: 999px; background: var(--accent-gold); }
  .bi__seg[data-from='en'] .bi__pill { transform: translateX(44px); }

  @container (max-width: 480px) {
    .bi { padding: 40px 0 16px; }
    .bi__web { width: min(100%, 300px); }
    .bi__seg { top: 4px; right: 8px; }
  }
  /* ── Coreografía: 0-1,3 s idioma de la página · cambia al otro · 3,6 s vuelve ── */
  :global(.is-play) .bi__l--a { animation: bi-a 4800ms ease both; }
  :global(.is-play) .bi__l--b { animation: bi-b 4800ms ease both; }
  :global(.is-play) .bi__shine { animation: bi-shine 4800ms linear both; }
  :global(.is-play) .bi__seg[data-from='es'] .bi__pill { animation: bi-pill-es 4800ms var(--w-ease-ui, ease) both; }
  :global(.is-play) .bi__seg[data-from='en'] .bi__pill { animation: bi-pill-en 4800ms var(--w-ease-ui, ease) both; }
  :global(.is-play) .bi__o { animation: bi-o 4800ms linear both; }
  @keyframes bi-a { 0%, 27% { opacity: 1; } 33%, 75% { opacity: 0; } 81%, 100% { opacity: 1; } }
  @keyframes bi-b { 0%, 27% { opacity: 0; } 33%, 75% { opacity: 1; } 81%, 100% { opacity: 0; } }
  @keyframes bi-shine { 0%, 25% { opacity: 0; transform: translateX(-100%); } 27% { opacity: 1; } 44% { opacity: 1; transform: translateX(100%); } 45%, 100% { opacity: 0; transform: translateX(100%); } }
  @keyframes bi-pill-es { 0%, 25% { transform: none; } 30%, 75% { transform: translateX(44px); } 80%, 100% { transform: none; } }
  @keyframes bi-pill-en { 0%, 25% { transform: translateX(44px); } 30%, 75% { transform: none; } 80%, 100% { transform: translateX(44px); } }
  /* El texto del segmentado sigue a la píldora: el activo en tinta, el otro apagado. */
  :global(.is-play) .bi__o.is-a { animation-name: bi-oa; }
  :global(.is-play) .bi__o:not(.is-a) { animation-name: bi-ob; }
  @keyframes bi-oa { 0%, 27% { color: var(--w-p-ink, #0e0e0d); } 29%, 77% { color: rgba(240,237,232,.6); } 79%, 100% { color: var(--w-p-ink, #0e0e0d); } }
  @keyframes bi-ob { 0%, 27% { color: rgba(240,237,232,.6); } 29%, 77% { color: var(--w-p-ink, #0e0e0d); } 79%, 100% { color: rgba(240,237,232,.6); } }
  @media (prefers-reduced-motion: reduce) {
    :global(.is-play) .bi__l--a, :global(.is-play) .bi__l--b, :global(.is-play) .bi__shine,
    :global(.is-play) .bi__pill, :global(.is-play) .bi__o { animation: none !important; }
  }
</style>
