---
// Cabecera del índice del blog (W-CONT-01, design/rediseno-workos.md §4.7).
// Hub = cabecera compacta (A-04, E-05): migas, H1 hub 52/500 verbatim a la izquierda en la
// línea del logo, sin bajada ni cola. A la derecha, en la línea del H1, una píldora 232×41
// al diagnóstico (la suscripción por correo de WorkOS NO se construye: decisión del dueño).
// En móvil la píldora desaparece, como en WorkOS: la destacada va justo debajo.
interface Props {
  h1Html: string;
  pill?: { label: string; href: string };
}
const { h1Html, pill } = Astro.props;
---
<section class="w-hero bh">
  <div class="w-container bh__in">
    <div class="bh__crumbs"><slot name="crumbs" /></div>
    <div class="bh__row">
      <h1 class="w-h1 w-h1--hub bh__h1" data-w-in="1" set:html={h1Html} />
      {pill && (
        <a class="bh__pill" href={pill.href} data-track="tool_cta_clicked" data-w-in="3">
          <span>{pill.label}</span><span class="bh__chev" aria-hidden="true">›</span>
        </a>
      )}
    </div>
  </div>
</section>

<style>
  .bh { padding-bottom: 72px; }
  .bh__crumbs { margin-bottom: 28px; }
  .bh__crumbs :global(ol) { padding-inline-start: 0; margin: 0; }
  .bh__row { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px 48px; min-width: 0; }
  .bh__h1 { margin: 0; max-width: 15.5em; text-wrap: balance; }
  .bh__pill {
    flex: none; display: inline-flex; align-items: center; gap: 8px;
    min-height: 44px; padding: 0 18px 0 20px; margin-bottom: 6px;
    border: 1px solid var(--w-line-strong); border-radius: 999px;
    font: 500 14px/1 var(--font-body); color: var(--w-ink-80); text-decoration: none; white-space: nowrap;
    transition: border-color var(--w-dur-micro) var(--w-ease-ui), color var(--w-dur-micro) var(--w-ease-ui);
  }
  .bh__chev { font-size: 17px; line-height: 1; color: var(--w-accent); transition: transform var(--w-dur-hover) var(--w-ease-ui); }
  @media (--hover-fine) {
    .bh__pill:hover { border-color: rgba(var(--accent-gold-rgb), .5); color: var(--w-ink); }
    .bh__pill:hover .bh__chev { transform: translateX(3px); }
  }
  .bh__pill:focus-visible { outline: 2px solid var(--accent-gold); outline-offset: 3px; }
  @media (--lt-md) {
    .bh { padding-bottom: 40px; }
    .bh__crumbs { margin-bottom: 20px; }
    .bh__pill { display: none; }
  }
  @media (--motion-reduce) {
    .bh__pill, .bh__chev { transition: none; }
    .bh__pill:hover .bh__chev { transform: none; }
  }
</style>
