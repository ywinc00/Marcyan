---
// "Pregúntale a tu IA" (v1 §4.8 · v2 G11 "L6"; W-CONT-22 "Explore with AI"). Fila bajo la
// firma del artículo: rótulo corto a la izquierda y tres enlaces que abren Claude,
// Perplexity y ChatGPT con la PREGUNTA DEL ARTÍCULO y su dirección escritas. Solo eso:
// ningún dato del visitante viaja en la URL. Se abren en otra pestaña y se avisa.
//
// Marcas (v2 §1.4, uso nominativo, todo por LogoMarca): como en el original, cada enlace
// lleva la marca del asistente delante de su nombre. Perplexity con su glifo monocromo
// crema SÓLIDO de 14 px (veredicto "apto" de w/marcas/LICENCIAS.md). ChatGPT en palabra
// (simple-icons ya no lo trae; decisión §5-2 sin respuesta). Claude también en palabra: el
// cerrojo de LICENCIAS.md (guía de marca de Anthropic, 2026-11-05) prohíbe su glifo en
// páginas públicas sin permiso escrito, y la crema ya sería una alteración. Cuando el dueño
// tenga el permiso, basta con pasar `claude` a { glifo: true } abajo. Orden: Claude
// primero (el modelo con el que trabajamos de verdad).
import Icon from '../../../ui/Icon.astro';
import LogoMarca from '../../marcas/LogoMarca.astro';
import type { MarcaId } from '../../marcas/datos';

interface Props {
  /** La pregunta del artículo (answer.q del frontmatter). */
  question: string;
  /** Dirección pública del artículo (canonical). */
  url: string;
  label?: string;
}
const { question, url, label = 'Pregúntale a tu IA' } = Astro.props;
const prompt = encodeURIComponent(`Lee esta guía de Marcyan Studio y respóndeme: ${question} ${url}`);
type Tool = { name: string; href: string; glifo?: MarcaId };
const tools: Tool[] = [
  { name: 'Claude', href: `https://claude.ai/new?q=${prompt}` },
  { name: 'Perplexity', href: `https://www.perplexity.ai/search?q=${prompt}`, glifo: 'perplexity' },
  { name: 'ChatGPT', href: `https://chatgpt.com/?q=${prompt}` },
];
---
<div class="askai">
  <p class="askai__label">{label}</p>
  <ul class="askai__list">
    {tools.map((t) => (
      <li>
        <a class="askai__link" href={t.href} target="_blank" rel="noopener noreferrer">
          <span class="askai__pre">Abrir en</span>
          <span class="askai__brand">
            {t.glifo && <LogoMarca id={t.glifo} size={14} tono="mono" titulo="" class="askai__glyph" />}
            {t.name === 'ChatGPT'
              ? <LogoMarca id="chatgpt-texto" size={16} tono="mono" titulo="ChatGPT" class="askai__word" />
              : <span class="askai__name">{t.name}</span>}
          </span>
          <Icon name="lucide:arrow-up-right" />
          <span class="askai__sr">(se abre en otra pestaña)</span>
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .askai { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 6px 24px; min-width: 0; }
  .askai__label {
    margin: 0;
    font-family: var(--font-mono); font-size: var(--w-micro); font-weight: 500; line-height: 1.2;
    letter-spacing: var(--w-tr-micro); text-transform: uppercase; color: var(--w-ink-60);
  }
  .askai__list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0 20px; }
  .askai__link {
    display: inline-flex; align-items: center; gap: 6px; min-height: 44px;
    font-family: var(--font-body); font-size: 0.875rem; font-weight: 500; color: var(--w-ink-60);
    text-decoration: none; transition: color var(--w-dur-micro) var(--w-ease-ui);
  }
  /* La marca: glifo crema sólido + nombre en la voz de las palabras de marca (Space Grotesk
     600, crema), al mismo alto óptico que "ChatGPT" de LogoMarca. La jerarquía la da el
     tamaño y el peso, nunca la transparencia del logo (§1.4). */
  .askai__brand { display: inline-flex; align-items: center; gap: 5px; color: #F0EDE8; }
  .askai__name {
    font-family: var(--font-display, 'Space Grotesk Variable', 'Space Grotesk', system-ui, sans-serif);
    font-weight: 600; font-size: 13.76px; line-height: 1; letter-spacing: -.035em;
  }
  .askai__link :global(svg) {
    width: 14px; height: 14px; color: var(--accent-gold);
    transition: transform var(--w-dur-hover) var(--w-ease-ui);
  }
  @media (--hover-fine) {
    .askai__link:hover { color: var(--w-ink-80); }
    .askai__link:hover :global(svg) { transform: translate(2px, -2px); }
  }
  .askai__link:focus-visible { outline: 2px solid var(--accent-gold); outline-offset: 2px; border-radius: 4px; color: var(--w-ink); }
  .askai__sr { position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (--lt-md) {
    .askai { flex-direction: column; align-items: flex-start; }
    .askai__list { gap: 0 16px; }
  }
  @media (--motion-reduce) {
    .askai__link, .askai__link :global(svg) { transition: none; }
    .askai__link:hover :global(svg) { transform: none; }
  }
</style>
