---
// Isotipo de la marca de EJEMPLO "Tu Marca": monograma "m." en un círculo (geometría en signo.ts,
// la MISMA que dibuja el plano del hero, PlanoTuMarca.astro). Ronda 1 (I3): deja el sello dentado
// con estrella de 4 puntas, que cantaba a IA. Diseñada por nosotros; nunca la marca de un cliente
// (E-32, E-47). Decorativa: aria-hidden. Colores por variables: --bm-ink (disco) y --bm-paper (letra).
import { SIGNO } from './signo';

interface Props { size?: number; class?: string }
const { size = 64, class: cls } = Astro.props;
---
<svg class:list={['bm-seal', cls]} viewBox="0 0 200 200" width={size} height={size} aria-hidden="true">
  <circle cx="100" cy="100" r={SIGNO.r} fill="var(--bm-ink, #6B4FA0)" />
  <path d={SIGNO.m} fill="none" stroke="var(--bm-paper, #F0EDE8)" stroke-width={SIGNO.trazo} />
  <circle cx={SIGNO.punto.cx} cy={SIGNO.punto.cy} r={SIGNO.punto.r} fill="var(--bm-paper, #F0EDE8)" />
</svg>
<style>
  .bm-seal { display: block; flex: none; }
</style>
