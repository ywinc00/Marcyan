---
// Diagnóstico gratis v3 (design/rediseno-workos.md §4.9, ola 3). Cuerpo común de
// /es/diagnostico y /en/checkup; cada página conserva su redirección por bandera,
// su ServiceLd (precio 0) y sus migas.
//
// Hero (A-05 + W-GAP-03 + W-NEW-41 + W-ADV-45): H1 hub verbatim a la izquierda y la
// bajada (verbatim) a la derecha en su línea base; debajo, partido 600/600: el wizard
// ENTERO en su tarjeta opaca (el contraste de la página) y el escáner con su bucle (la
// firma), con los 2 checks de "lo que pasa después" debajo, fuera del formulario.
// El escáner se para mientras el visitante escribe (E-42): lo hace el propio escáner vivo
// (P04: focusin del visitante en un campo de su closest('section')).
// Fondo (v2 §1.3 · G11): F12 "Escaneo" (trama de puntos y una línea de lectura que baja,
// continua), que casa con el escáner vivo. Vive en la zona del hero (div.wf-zona) y NO se
// monta SpaceBackdrop (una atmósfera por página). Con el escaneo, el resultado o el éxito
// REALES a la vista, la línea del fondo también se queda quieta en su sitio (E-42/E-43).
// El wizard NO lleva data-w-in ni data-w-reveal (§2.9): nace visible.
// Mientras el panel enseña el escaneo, el resultado o el éxito (lo REAL del visitante),
// el escáner "Ejemplo" se queda quieto a media altura y sin botón de pausa: nunca dos
// "revisando" a la vez ni un ejemplo en bucle junto al resultado real (E-42/E-43).
// Secciones: 01 Lo que verás (resultado de ejemplo con la forma del real) · 02 Gratis de
// verdad · FAQ (la del wizard, única FAQPage, con la piel v3) + enlace de vuelta al
// formulario. Sin Contact: el trío vive en el cierre del éxito del propio wizard.
import Layout from '../../../../layouts/Layout.astro';
import SiteNav from '../../../layout/SiteNav.astro';
import SiteFooter from '../../../layout/SiteFooter.astro';
import Breadcrumb from '../../../ui/Breadcrumb.astro';
import Button from '../../../ui/Button.astro';
import Icon from '../../../ui/Icon.astro';
import ServiceLd from '../../../seo/ServiceLd.astro';
import DiagnosticWizard from '../../../growthos/DiagnosticWizard.astro';
import WStyles from '../../WStyles.astro';
import Escaner from '../../objetos/Escaner.astro';
import Fondo from '../../fondos/Fondo.astro';
import GratisDeVerdad from '../../GratisDeVerdad.astro';
import CabeceraNumerada from '../../CabeceraNumerada.astro';
import PreguntasFrecuentes from '../../PreguntasFrecuentes.astro';
import ResultadoEjemplo from './ResultadoEjemplo.astro';
import { content } from '../../../../i18n/content';
import { clusterNav, clusterNavEn } from '../../../../i18n/clusters';
import { GOS } from '../../../../i18n/growth-os';
import { diagCopy } from '../../../../i18n/w/diagnostico';

interface Crumb { name: string; path: string }
interface Props {
  lang: 'es' | 'en';
  service: { name: string; serviceType: string; description: string; path: string; priceValue: string };
  breadcrumb: Crumb[];
}
const { lang, service, breadcrumb } = Astro.props;
const c = content[lang];
const t = GOS[lang].page;
const w = diagCopy[lang];
const baseNav = lang === 'en' ? clusterNavEn : clusterNav;
const nav = { ...baseNav, cta: { ...baseNav.cta, href: lang === 'en' ? '/en#contacto' : '/es#contacto' } };
const home = lang === 'en' ? '/en' : '/es';
---
<Layout title={t.metaTitle} description={t.metaDesc} lang={lang} path={lang === 'en' ? 'checkup' : 'diagnostico'} ds="v3">
  <ServiceLd slot="head" {...service} />
  <WStyles />

  <SiteNav nav={nav} lang={lang} homeHref={home} currentPath={Astro.url.pathname} />

  <main id="main" class="w-rails" data-w data-w-tone="gold" data-w-kind="diagnostico">
    <div class="wf-zona dgz">
    <Fondo tema="F12" lang={lang} />
    <section class="w-hero dgh">
      <div class="w-container">
        <div class="dgh__crumbs"><Breadcrumb items={breadcrumb} lang={lang} /></div>
        <div class="dgh__top">
          <h1 class="w-h1 w-h1--hub dgh__h1" data-w-in="1" set:html={t.h1} />
          <p class="w-lead dgh__lead" data-w-in="2">{t.sub}</p>
        </div>
        <div class="dgh__split">
          <div class="dgh__form">
            <DiagnosticWizard lang={lang} />
          </div>
          <div class="dgh__side">
            <div data-w-in="obj">
              <Escaner lang={lang} motion="loop" size="hero" class="dgh__scan" />
            </div>
            <ul class="dgh__checks" data-w-in="3">
              {w.despues.map((d) => <li><Icon name="lucide:check" class="dgh__ck" />{d}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>
    </div>

    <section class="w-cell" id="lo-que-veras">
      <div class="w-container" data-w-reveal>
        <ResultadoEjemplo copy={w.resultado} n={1} lang={lang} resultTitle={t.resultTitle} />
      </div>
    </section>

    <section class="w-cell" id="gratis">
      <div class="w-container" data-w-reveal>
        <CabeceraNumerada n={2} label={w.gratis.label} titleHtml={w.gratis.heading} lead={w.gratis.lead} />
        <GratisDeVerdad
          class="dg__free"
          items={w.gratis.items}
          title={w.gratis.title}
          checks={w.gratis.checks}
          cta={{ label: w.gratis.cta, href: '#diagnostico-form' }}
        />
      </div>
    </section>

    <div class="w-cell">
      <div class="w-container" data-w-reveal>
        <PreguntasFrecuentes id="faq" tag={w.faq.tag} titleHtml={w.faq.title} items={GOS[lang].faq.map((f) => ({ q: f.q, a: f.a }))} lang={lang} />
        <p class="dg__again"><Button variant="link" href="#diagnostico-form">{w.gratis.cta}</Button></p>
      </div>
    </div>
  </main>

  <SiteFooter footer={c.footer} lang={lang} />
</Layout>

<style>
  .dgh { padding-bottom: var(--w-section-y); overflow-x: clip; }
  .dgh__crumbs { margin-bottom: 28px; }
  .dgh__crumbs :global(ol) { padding-inline-start: 0; margin: 0; }
  .dgh__top { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; }
  .dgh__h1 { margin: 0; }
  .dgh__lead { margin: 0; }
  .dgh__split { margin-top: 56px; display: grid; grid-template-columns: minmax(0, 1fr); gap: 32px; align-items: start; }
  .dgh__side { display: grid; gap: 24px; min-width: 0; }
  .dgh__checks { list-style: none; margin: 0; padding: 0 8px; display: grid; gap: 12px; }
  .dgh__checks li { display: flex; align-items: center; gap: 12px; font-size: 16px; line-height: 1.4; color: var(--w-ink-80); }
  .dgh__checks :global(.dgh__ck) { width: 18px; height: 18px; flex: none; color: var(--accent-gold); }

  @media (min-width: 1024px) {
    /* H1 a la izquierda (columna del formulario) y bajada a la derecha en su línea base (W-NEW-41). */
    .dgh__top { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; align-items: end; }
    .dgh__lead { padding-bottom: 6px; }
    .dgh__split { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; }
    /* El escáner acompaña al formulario mientras el resultado (largo) baja. */
    .dgh__side { position: sticky; top: calc(var(--nav-h) + 24px); }
    /* Partido 600/600 alineado: la tarjeta del formulario y la del escaneo miden al menos
       lo que el escáner (480), con la acción abajo; los pasos más largos crecen. */
    .dgh__form :global(.dgw__panel[data-view="form"]) { min-height: 480px; display: flex; flex-direction: column; }
    .dgh__form :global(.dgw__form) { flex: 1; display: flex; flex-direction: column; }
    .dgh__form :global(.dgw__nav) { margin-top: auto; padding-top: 24px; }
    .dgh__form :global(.dgw__panel[data-view="scan"]) { min-height: 480px; }
  }

  /* E-42/E-43: con el escaneo, el resultado o el éxito reales a la vista, el escáner de
     ejemplo se queda quieto a media altura (sin animación = transform base del objeto) y
     su botón de pausa, que ya no pausaría nada, no se pinta (loop.ts lo pinta con estilo
     en línea: solo !important lo vence sin tocar loop.ts). */
  .dgh__split:has(.dgw__panel:is([data-view="scan"], [data-view="result"], [data-view="success"]):not([hidden])) :global(.wo-scan .wo-scan__bar) { animation: none; }
  .dgh__split:has(.dgw__panel:is([data-view="scan"], [data-view="result"], [data-view="success"]):not([hidden])) :global(.w-loop-pause) { display: none !important; }
  /* Y la línea de lectura del fondo F12 vuelve a su sitio quieto (sobre el objeto). */
  /* E-42: mientras el visitante escribe (el escáner queda en .is-held), la línea del fondo
     también se detiene donde está; al salir del formulario siguen las dos. */
  .dgz:has(.wo-scan.is-held) :global(.wf-es__linea) { animation-play-state: paused; }
  .dgz:has(.dgw__panel:is([data-view="scan"], [data-view="result"], [data-view="success"]):not([hidden])) :global(.wf-es__linea) { animation: none; }

  /* F12: la línea de lectura sale justo sobre el formulario y el escáner (--wf-obj, medido
     en el HTML compilado) y baja hasta el pie del hero. */
  .dgz > :global(.wf) { --wf-obj: 420px; }
  @media (max-width: 1023.98px) { .dgz > :global(.wf) { --wf-obj: 400px; } }

  :global(.dg__free) { margin-top: var(--w-chapter-gap); }
  /* Vuelta al formulario tras la FAQ, en su misma columna (776, la de PreguntasFrecuentes). */
  .dg__again { margin: 24px auto 0; max-width: 776px; }
</style>
