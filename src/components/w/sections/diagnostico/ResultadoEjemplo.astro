---
// Diagnóstico · 01 "Lo que verás" (design/rediseno-workos.md §4.9-2).
// Cabecera numerada + un resultado de EJEMPLO dibujado como objeto de sistema (noche
// opaca, rotulado "Ejemplo") con la MISMA forma que el resultado real del wizard
// (E-10/E-13): "Resultado inicial para" + prioridad, puntaje 0-100 en anillo, las 5
// áreas del motor (GOS.cats: web móvil, SEO local, lectura por IA, conversión, reseñas)
// con barra y cifra, señales detectadas (frases verbatim del catálogo) y ruta sugerida.
// ChipsVeredicto (Bien · Mejorable · Falta, §4.9) queda como LECTURA de cada cifra.
// Cifras de ejemplo coherentes con la ponderación real (56 → prioridad media; área más
// débil IA → "SEO para IA"). Marca de ejemplo "Tu Negocio" (nunca se traduce).
// La ruta NO lleva chevron: aquí no es un enlace. Ilustración: aria-hidden + sr-only.
import CabeceraNumerada from '../../CabeceraNumerada.astro';
import ChipsVeredicto from '../../ChipsVeredicto.astro';
import Ejemplo from '../../Ejemplo.astro';
import type { DiagCopy } from '../../../../i18n/w/diagnostico';

interface Props { copy: DiagCopy['resultado']; n: number; lang?: 'es' | 'en'; resultTitle: string }
const { copy, n, lang = 'es', resultTitle } = Astro.props;
const R = 62;
const C = 2 * Math.PI * R;
const off = (C * (1 - copy.score / 100)).toFixed(1);
---
<CabeceraNumerada n={n} label={copy.label} titleHtml={copy.title} lead={copy.lead} />
<div class="re">
  <p class="re__sr">{copy.sr}</p>
  <div class="re__obj" aria-hidden="true">
    <Ejemplo lang={lang} on="dark" />
    <div class="re__head">
      <p class="re__kick">{resultTitle} <b translate="no">{copy.biz}</b></p>
      <p class="re__risk">{copy.risk}</p>
    </div>
    <div class="re__body">
      <div class="re__main">
        <div class="re__ring">
          <svg viewBox="0 0 150 150">
            <circle class="re__track" cx="75" cy="75" r={R} />
            <circle class="re__fill" cx="75" cy="75" r={R} stroke-dasharray={C.toFixed(1)} stroke-dashoffset={off} />
          </svg>
          <p class="re__score"><b>{copy.score}</b><span>/100</span></p>
          <p class="re__slbl">{copy.scoreLabel}</p>
        </div>
        <div class="re__areas">
          <p class="re__lbl">{copy.areasLabel}</p>
          <ul class="re__list">
            {copy.areas.map((a) => (
              <li class="re__row">
                <span class="re__name">{a.name}</span>
                <span class="re__bar"><i style={`width:${a.value}%`}></i></span>
                <b class="re__val">{a.value}</b>
                <ChipsVeredicto items={[{ label: a.verdict, kind: a.kind }]} tone="gold" class="re__chip" />
              </li>
            ))}
          </ul>
        </div>
      </div>
      <div class="re__side">
        <p class="re__lbl">{copy.signalsLabel}</p>
        <ul class="re__sig">
          {copy.signals.map((s) => <li>{s}</li>)}
        </ul>
        <div class="re__ruta">
          <p class="re__lbl">{copy.rutaLabel}</p>
          <p class="re__svc">{copy.ruta}</p>
          <p class="re__rnote">{copy.rutaNote}</p>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .re { margin-top: var(--w-chapter-gap); }
  .re__sr { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .re__obj {
    position: relative; border-radius: var(--w-r-tray); background: var(--w-s1);
    border: 1px solid var(--w-line); box-shadow: var(--w-edge); overflow: hidden;
  }
  /* E-40: lo que se lee va en letra de texto (no mono en mayúsculas). */
  .re__head {
    display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px;
    padding: 22px 132px 22px 32px; border-bottom: 1px solid var(--w-line);
  }
  .re__kick { margin: 0; font-size: 15px; line-height: 1.4; color: var(--w-ink-80); }
  .re__kick b { color: var(--w-ink); font-weight: 600; }
  .re__risk {
    margin: 0; padding: 4px 12px; border-radius: 999px; border: 1px solid var(--w-line-strong);
    font-size: 14px; font-weight: 500; line-height: 1.4; color: var(--w-ink-80);
  }
  .re__body { display: grid; grid-template-columns: minmax(0, 1fr); }
  .re__main { padding: 28px 32px; display: grid; grid-template-columns: minmax(0, 1fr); gap: 28px; justify-items: start; }
  .re__lbl { margin: 0 0 12px; font-weight: 500; font-size: 14px; line-height: 1.3; color: var(--w-ink-80); }

  .re__ring { position: relative; width: 150px; aspect-ratio: 1; display: grid; place-items: center; align-content: center; }
  .re__ring svg { position: absolute; inset: 0; width: 100%; height: 100%; transform: rotate(-90deg); }
  .re__track { fill: none; stroke: var(--w-line-strong); stroke-width: 9; }
  .re__fill { fill: none; stroke: var(--accent-gold); stroke-width: 9; stroke-linecap: round; }
  .re__score { margin: 0; display: flex; align-items: baseline; gap: 2px; }
  .re__score b { font-family: var(--font-display); font-weight: 500; font-size: 40px; line-height: 1; letter-spacing: -0.02em; color: var(--w-ink); }
  .re__score span { font-size: 14px; color: var(--w-ink-70); }
  .re__slbl { margin: 4px 0 0; font-size: 14px; color: var(--w-ink-70); }

  .re__areas { width: 100%; min-width: 0; }
  .re__list { list-style: none; margin: 0; padding: 0; }
  .re__row {
    display: grid; grid-template-columns: 128px minmax(0, 1fr) 32px 132px; align-items: center; gap: 16px;
    min-height: 52px; padding: 6px 0; border-top: 1px solid var(--w-line);
  }
  .re__name { font-weight: 500; font-size: 15px; color: var(--w-ink); }
  .re__bar { height: 6px; border-radius: 999px; background: var(--w-line-strong); overflow: hidden; }
  .re__bar i { display: block; height: 100%; border-radius: inherit; background: var(--accent-gold); }
  .re__val { font-family: var(--font-mono); font-weight: 500; font-size: 15px; color: var(--w-ink); text-align: right; }

  .re__side { padding: 28px 32px 32px; border-top: 1px solid var(--w-line); background: var(--w-s2); display: flex; flex-direction: column; }
  .re__sig { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .re__sig li { position: relative; padding-left: 18px; font-size: 15px; line-height: 1.45; color: var(--w-ink-80); }
  .re__sig li::before { content: ''; position: absolute; left: 0; top: .6em; width: 7px; height: 7px; border-radius: 50%; background: var(--accent-gold); }
  .re__ruta { margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--w-line); }
  .re__svc { margin: 0; font-family: var(--font-display); font-weight: 500; font-size: 26px; line-height: 1.15; color: var(--accent-gold); letter-spacing: -0.02em; }
  .re__rnote { margin: 8px 0 0; font-size: 15px; line-height: 1.5; color: var(--w-ink-70); max-width: 34ch; }

  @media (min-width: 1024px) {
    .re__body { grid-template-columns: minmax(0, 1fr) 360px; }
    .re__main { grid-template-columns: 150px minmax(0, 1fr); gap: 40px; align-items: center; padding: 32px; }
    .re__side { border-top: 0; border-left: 1px solid var(--w-line); }
  }
  @media (max-width: 767.98px) {
    .re { margin-top: 48px; }
    .re__head { padding: 18px 20px; padding-right: 96px; }
    .re__main, .re__side { padding-inline: 20px; }
    .re__main { justify-items: center; }
    /* Columna de cifra fija: todas las barras miden lo mismo; el chip se alinea a la derecha. */
    .re__row { grid-template-columns: minmax(0, 1fr) 36px; gap: 8px 12px; padding: 10px 0; }
    .re__name { grid-column: 1; grid-row: 1; }
    .re__bar { grid-column: 1; grid-row: 2; }
    .re__val { grid-column: 2; grid-row: 2; }
    .re__row :global(.re__chip) { grid-column: 1 / -1; grid-row: 1; justify-self: end; }
  }
</style>
