---
// Tienda en línea · capítulo de contraste (§4.15-5): CapituloDosFrases + RegistroVivo
// variant="static" "El día de tu tienda" (W-ADV-44 sin bucle: la firma de la página es la
// lista de pedidos del hero). Cinco filas al 100 %, la central ("Pagado", en el acento)
// realzada por fondo; el resto de estados en crema (por valor, §2.11).
import CapituloDosFrases from '../../CapituloDosFrases.astro';
import RegistroVivo from '../../RegistroVivo.astro';
import type { ShopCopy } from '../../../../i18n/w/ecommerce';

interface Props { copy: ShopCopy['dia']; lang?: 'es' | 'en' }
const { copy, lang = 'es' } = Astro.props;
---
<CapituloDosFrases tone1={copy.tone1} tone2={copy.tone2} sub={copy.sub} />
<div class="ws-gap">
  <RegistroVivo titleHtml={copy.title} text={copy.text} rows={copy.rows} variant="static" lang={lang} class="ws-dia" />
</div>
<style>
  .ws-gap { margin-top: var(--w-chapter-gap); }
  @media (--lt-md) { .ws-gap { margin-top: 48px; } }
  /* La tarjeta se ajusta a sus 5 filas: el min-height de 530 es del modo en bucle y en
     estático dejaba ~140 px de losa vacía arriba y abajo (rev1, importante 2). Pendiente
     [SISTEMA] de llevarlo a RegistroVivo para todo variant="static". */
  /* La fila "Pagado" en superficie clara cálida (§2.4, rev2 menor): da luz a la tarjeta
     oscura sobre la banda gris. Sobre crema el acento no tiene contraste de texto: el chip
     va en tinta de producto con el acento en fondo y borde. */
  .ws-gap :global(.wd-log.ws-dia .wd-log__row.is-center) { background: var(--w-p-bg); border-bottom-color: var(--w-p-line); }
  .ws-gap :global(.wd-log.ws-dia .wd-log__row.is-center .wd-log__ic),
  .ws-gap :global(.wd-log.ws-dia .wd-log__row.is-center .wd-log__lbl) { color: var(--w-p-ink); }
  .ws-gap :global(.wd-log.ws-dia .wd-log__row.is-center .wd-log__chip) {
    color: var(--w-p-ink); background: rgba(var(--w-accent-rgb), .22); border-color: rgba(var(--w-accent-rgb), .7);
  }
  @media (--md) {
    .ws-gap :global(.wd-log.ws-dia) { min-height: 0; }
    .ws-gap :global(.ws-dia .wd-log__win) { min-height: 0; padding-block: 48px; }
  }
</style>
