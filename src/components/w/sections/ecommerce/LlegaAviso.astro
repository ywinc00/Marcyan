---
// "¿Y a ti cómo te llega?" · navegador con dos satélites, variante tienda (design/rediseno-workos-v2.md
// G04 y P03 NavegadorSatelites; original W-CORE-30 de WorkOS MFA: navegador 710 con el producto en uso y
// dos tarjetas satélite 264×156 que sobresalen por los lados y entran con "moveUp" 0,8 s a los 0,6 y 0,9 s,
// más un anillo que cuenta en bucle). Versión local de la tienda mientras P03 no esté integrado ([SISTEMA]).
//
// Aquí: el navegador enseña la página de "gracias" de Tu Tienda (pedido pagado) y de él NACEN dos líneas de
// 1 px (resuelve la línea sin origen de FI §3-9) hasta los satélites: el correo al dueño y el pedido que
// entra en el panel de su tienda. (Revisión r1: el satélite de WhatsApp prometía un aviso que la página no
// vende, WhatsApp es un botón para el cliente; se cambió por el panel, que toda tienda trae.) Las líneas se dibujan con stroke-dashoffset (700 ms)
// y los satélites entran con translateY(8px)→0 a los 0,6 y 0,9 s, tiempos del original.
// Pantalla viva (§1.5): cada 5 s entra el pedido siguiente (3 pedidos de ejemplo en rueda) y la escena se
// repite; registerLoop la pausa fuera de vista, con la pestaña oculta, con foco o puntero dentro y con su
// botón 44×44. Reducir movimiento o sin JS: el primer pedido completo, quieto.
// Escritorio (escena ≥ 1000 px): composición absoluta del original. Más estrecho: navegador arriba y los
// dos satélites debajo, solapando su borde, con la línea corta que sube hasta el navegador.
// Contrato común (§1.6): aria-hidden + data-nosnippet + sr-only, sin h1-h6, sin enlaces.
import LogoEjemplo from '../../objetos/ejemplos/LogoEjemplo.astro';
import ProductoArte, { type ProductoId } from './ProductoArte.astro';
import { negocios } from '../../objetos/ejemplos/negocios';

interface Props { city: 'houston' | 'miami'; lang?: 'es' | 'en'; sr: string }
const { city, lang = 'es', sr } = Astro.props;
const en = lang === 'en';
const miami = city === 'miami';
const P = negocios.tienda.paleta;
type Ord = { n: string; who: string; first: string; prod: string; art: ProductoId };
const ORD: Ord[] = en
  ? [{ n: '1042', who: 'Ana R.', first: 'Ana', prod: 'Scented candle', art: 'vela' },
     { n: '1043', who: 'Luis M.', first: 'Luis', prod: 'Ground coffee, 2 lb', art: 'cafe' },
     { n: '1044', who: 'Sofía G.', first: 'Sofía', prod: 'Gift box', art: 'caja' }]
  : [{ n: '1042', who: 'Ana R.', first: 'Ana', prod: 'Vela aromática', art: 'vela' },
     { n: '1043', who: 'Luis M.', first: 'Luis', prod: 'Café de olla, 1 kg', art: 'cafe' },
     { n: '1044', who: 'Sofía G.', first: 'Sofía', prod: 'Caja de regalo', art: 'caja' }];
const T = en
  ? { url: 'yourshop.example/thanks', ex: 'Example', nav: ['Shop', 'Coffee', 'Candles'], thanks: (f: string) => `Thank you, ${f}.`,
      paid: (n: string) => `Order #${n} is paid.`, how: miami ? 'Shipping to your address' : 'Pickup today at the shop',
      mail: 'Email', now: 'now', mailT: (n: string) => `New order #${n}`, mailB: (w: string, p: string) => `${w} paid for ${p}.`,
      panel: 'Your store admin', pst: 'Paid' }
  : { url: 'tutienda.example/gracias', ex: 'Ejemplo', nav: ['Tienda', 'Café', 'Velas'], thanks: (f: string) => `Gracias, ${f}.`,
      paid: (n: string) => `Tu pedido #${n} está pagado.`, how: miami ? 'Envío a tu dirección' : 'Recogida hoy en la tienda',
      mail: 'Correo', now: 'ahora', mailT: (n: string) => `Pedido nuevo #${n}`, mailB: (w: string, p: string) => `${w} pagó ${p}.`,
      panel: 'Tu panel', pst: 'Pagado' };
const vars = `--la-bg:${P.bg};--la-ink:${P.ink};--la-ink2:${P.ink2};--la-acc:${P.accent}`;
---
<div class="la" data-la data-nosnippet style={vars}>
  <p class="sr-only">{sr}</p>
  <div class="la__stage" aria-hidden="true" data-o="0">
    <svg class="la__lines" viewBox="0 0 1000 400" preserveAspectRatio="none" focusable="false">
      <path d="M384 276 C 330 276, 330 250, 286 250" />
      <path d="M616 276 C 664 276, 664 190, 712 190" />
    </svg>

    <div class="la__win">
      <div class="la__bar">
        <span class="la__dots"><i></i><i></i><i></i></span>
        <span class="la__url">
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></svg>
          {T.url}<span class="la__ex">· {T.ex}</span>
        </span>
      </div>
      <div class="la__page">
        <div class="la__nav">
          <LogoEjemplo marca="tienda" size={11} tono="mono" lang={lang} class="la__logo" />
          <span class="la__links">{T.nav.map((x) => <span>{x}</span>)}</span>
        </div>
        <div class="la__swap">
          {[ORD[0]].map((o, i) => (
            <div class="la__body" data-i={i}>
              <span class="la__thanks">{T.thanks(o.first)}</span>
              <span class="la__paid">{T.paid(o.n)}</span>
              <span class="la__order">
                <span class="la__th"><ProductoArte id={o.art} size={34} sombra={false} /></span>
                <span class="la__otx"><b>{o.prod}</b><span>{T.how}</span></span>
                <span class="la__ok"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></span>
              </span>
            </div>
          ))}
<template data-la-t>{ORD.slice(1).map((o, j) => { const i = j + 1; return (
            <div class="la__body" data-i={i}>
              <span class="la__thanks">{T.thanks(o.first)}</span>
              <span class="la__paid">{T.paid(o.n)}</span>
              <span class="la__order">
                <span class="la__th"><ProductoArte id={o.art} size={34} sombra={false} /></span>
                <span class="la__otx"><b>{o.prod}</b><span>{T.how}</span></span>
                <span class="la__ok"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></span>
              </span>
            </div>
          ); })}</template>
        </div>
      </div>
    </div>

    <div class="la__sat la__sat--mail">
      <p class="la__sh">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2.5" /><path d="M3.5 6.5l8.5 6.5 8.5-6.5" /></svg>
        <span>{T.mail}</span><time>{T.now}</time>
      </p>
      <div class="la__swap">
        {[ORD[0]].map((o, i) => (
          <div class="la__sb" data-i={i}>
            <b>{T.mailT(o.n)}</b>
            <span>{T.mailB(o.who, o.prod)}</span>
          </div>
        ))}
<template data-la-t>{ORD.slice(1).map((o, j) => { const i = j + 1; return (
          <div class="la__sb" data-i={i}>
            <b>{T.mailT(o.n)}</b>
            <span>{T.mailB(o.who, o.prod)}</span>
          </div>
        ); })}</template>
      </div>
    </div>

    <div class="la__sat la__sat--panel">
      <p class="la__sh">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2.5" /><path d="M3 9h18M8 13.5h8M8 16.5h5" /></svg>
        <span>{T.panel}</span><time>{T.now}</time>
      </p>
      <div class="la__swap">
        {[ORD[0]].map((o, i) => (
          <div class="la__sb la__prow" data-i={i}>
            <span class="la__pth"><ProductoArte id={o.art} size={30} sombra={false} /></span>
            <span class="la__ptx"><b>#{o.n} · {o.who}</b><span>{o.prod}</span></span>
            <span class="la__pst">{T.pst}</span>
          </div>
        ))}
<template data-la-t>{ORD.slice(1).map((o, j) => { const i = j + 1; return (
          <div class="la__sb la__prow" data-i={i}>
            <span class="la__pth"><ProductoArte id={o.art} size={30} sombra={false} /></span>
            <span class="la__ptx"><b>#{o.n} · {o.who}</b><span>{o.prod}</span></span>
            <span class="la__pst">{T.pst}</span>
          </div>
        ); })}</template>
      </div>
    </div>
  </div>
</div>

<script>
  import { registerLoop } from '../../loop';
  const CICLO = 5000;
  document.querySelectorAll<HTMLElement>('[data-la]').forEach((el) => {
    if (el.dataset.laListo) return;
    el.dataset.laListo = '1';
    const stage = el.querySelector<HTMLElement>('.la__stage');
    if (!stage) return;
    let timer = 0;
    let o = 0;
    // Primera vez (y al volver tras ≥ 8 s fuera): coreografía entera del original (los satélites entran).
    // Después, cada 5 s solo cambia el pedido: la página de gracias, las líneas y el contenido de los
    // satélites, que no desaparecen (como el anillo que cuenta en W-CORE-31).
    let fuera = 0;
    const play = (first: boolean) => {
      stage.dataset.o = String(o);
      stage.classList.remove('is-run', 'is-first'); void stage.offsetWidth;
      stage.classList.add('is-run'); if (first) stage.classList.add('is-first');
    };
    // Los pedidos 2 y 3 viajan en <template> (§1.8, presupuesto de DOM) y se montan en el primer cambio.
    const montar = () => el.querySelectorAll<HTMLTemplateElement>('template[data-la-t]').forEach((t) => { t.parentElement?.append(t.content.cloneNode(true)); t.remove(); });
    const tick = () => { montar(); o = (o + 1) % 3; play(false); timer = window.setTimeout(tick, CICLO); };
    new IntersectionObserver((es) => { for (const e of es) if (!e.isIntersecting) fuera = Date.now(); }, { threshold: 0 }).observe(el);
    let primera = true;
    registerLoop(el, {
      start: () => {
        el.classList.remove('is-still');
        const vuelve = primera || (fuera && Date.now() - fuera >= 8000);
        primera = false;
        if (vuelve) { o = 0; play(true); }
        timer = window.setTimeout(tick, vuelve ? CICLO : CICLO / 2);
      },
      stop: () => window.clearTimeout(timer),
      still: () => { window.clearTimeout(timer); o = 0; stage.dataset.o = '0'; stage.classList.remove('is-run'); el.classList.add('is-still'); },
    }, { buttonTone: 'dark' });
    // En PC el botón de pausa se recoge dentro de la esquina del navegador (revisión r1, menor 3).
    el.querySelector<HTMLElement>(':scope > .w-loop-pause')?.classList.add('la__pause');
  });
</script>

<style>
  .la {
    --la-sat: #FBF9F5;
    position: relative; width: 100%; max-width: 1000px; margin-inline: auto;
    font-family: var(--font-body); text-align: left;
  }
  .la__stage { position: relative; height: 400px; }
  .la__lines { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; z-index: 2; pointer-events: none; }
  .la__lines path { fill: none; stroke: rgba(78, 90, 61, .75); stroke-width: 1; vector-effect: non-scaling-stroke; stroke-dasharray: 220; stroke-dashoffset: 0; }

  /* Navegador (producto en uso), 600 de ancho centrado. */
  .la__win {
    position: absolute; left: 200px; top: 0; width: 600px; height: 360px;
    border-radius: 14px; overflow: hidden; background: var(--la-bg); color: var(--la-ink);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, .06), 0 40px 80px -36px rgba(0, 0, 0, .8);
  }
  .la__bar {
    display: grid; grid-template-columns: 64px 1fr 64px; align-items: center; height: 38px; padding: 0 14px;
    background: #F2EBDF; border-bottom: 1px solid rgba(42, 33, 27, .1);
  }
  .la__dots { display: flex; gap: 6px; }
  .la__dots i { width: 10px; height: 10px; border-radius: 50%; background: rgba(42, 33, 27, .16); }
  .la__url {
    justify-self: center; display: inline-flex; align-items: center; gap: 6px; height: 24px; padding: 0 12px;
    border-radius: 7px; background: rgba(42, 33, 27, .06); font: 500 11.5px/1 var(--font-mono); color: var(--la-ink2);
  }
  .la__ex { opacity: .8; }
  .la__page { padding: 18px 28px 0; }
  .la__nav { display: flex; align-items: center; justify-content: space-between; padding-bottom: 14px; border-bottom: 1px solid rgba(42, 33, 27, .12); }
  .la__logo { color: var(--la-ink); }
  .la__links { display: flex; gap: 18px; font-size: 12px; color: var(--la-ink2); }
  .la__swap { display: grid; }
  .la__swap > * { grid-area: 1 / 1; }
  .la__body { padding: 40px 0 0; display: flex; flex-direction: column; align-items: center; text-align: center; }
  .la__thanks { font: 500 44px/1.02 var(--font-display); letter-spacing: -.035em; }
  .la__paid { margin-top: 10px; font-size: 15px; color: var(--la-ink2); }
  .la__order {
    margin-top: 28px; display: flex; align-items: center; gap: 12px; width: 232px; padding: 10px 12px; border-radius: 10px;
    background: #F5F0E7; box-shadow: inset 0 0 0 1px rgba(42, 33, 27, .1), 0 1px 2px rgba(42, 33, 27, .08);
  }
  .la__th { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 8px; background: var(--la-bg); flex: none; }
  .la__otx { text-align: left; flex: 1; min-width: 0; display: flex; flex-direction: column; line-height: 1.3; }
  .la__otx b { font-size: 13px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .la__otx span { font-size: 11.5px; color: var(--la-ink2); }
  .la__ok { display: grid; place-items: center; width: 20px; height: 20px; border-radius: 50%; background: var(--la-acc); color: #F8F5EE; flex: none; }

  /* Satélites 270×150 radio 30 que sobresalen por los lados (W-CORE-30). */
  .la__sat {
    position: absolute; z-index: 3; width: 270px; padding: 18px 20px; border-radius: 30px;
    background: var(--la-sat); color: #1B1A17;
    box-shadow: 0 0 0 1px rgba(27, 26, 23, .05), 0 30px 60px -24px rgba(0, 0, 0, .75), 0 10px 20px -10px rgba(0, 0, 0, .4);
  }
  .la__sat--mail { left: 16px; top: 180px; }
  .la__sat--panel { left: 712px; top: 120px; }
  .la__sh { display: flex; align-items: center; gap: 7px; margin: 0 0 12px; font-size: 12px; font-weight: 500; color: #5F5A52; }
  .la__sh time { margin-left: auto; font: 500 11px/1 var(--font-mono); color: #7A746B; }
  .la__sb { display: flex; flex-direction: column; gap: 4px; line-height: 1.35; }
  .la__sb b { font: 500 15px/1.25 var(--font-display); letter-spacing: -.01em; color: #1B1A17; }
  .la__sb > span { font-size: 13px; color: #4F4A43; }
  /* Panel de la tienda: la fila del pedido nuevo, encendida (miniatura, número y cliente, estado). */
  .la__prow {
    flex-direction: row; align-items: center; gap: 10px; padding: 8px 10px; border-radius: 12px;
    background: #F1EBE0; box-shadow: inset 0 0 0 1px rgba(42, 33, 27, .08);
  }
  .la__pth { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 8px; background: var(--la-bg); flex: none; }
  .la__ptx { flex: 1; min-width: 0; display: flex; flex-direction: column; line-height: 1.3; }
  .la__ptx b { font: 500 13px/1.3 var(--font-body); color: #1B1A17; white-space: nowrap; }
  .la__ptx span { font-size: 12px; color: #5F5A52; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .la__sb > .la__pst {
    flex: none; padding: 3px 8px; border-radius: 999px; font-size: 11.5px; font-weight: 500;
    color: var(--la-acc); background: rgba(78, 90, 61, .12); box-shadow: inset 0 0 0 1px rgba(78, 90, 61, .3);
  }
  @media (min-width: 1080px) {
    .la > :global(.la__pause) {
      right: calc(50% - 300px + 14px) !important; bottom: 54px !important;
      border-color: rgba(14, 14, 13, .18) !important; background: rgba(255, 255, 255, .55) !important; color: rgba(14, 14, 13, .7) !important;
    }
  }

  /* Rueda de pedidos: se ve el de data-o. */
  .la__swap > [data-i] { opacity: 0; }
  .la__stage[data-o='0'] [data-i='0'], .la__stage[data-o='1'] [data-i='1'], .la__stage[data-o='2'] [data-i='2'] { opacity: 1; }

  /* Coreografía de cada pedido (solo transform, opacidad y stroke-dashoffset). */
  .la__stage.is-run .la__body[data-i] { animation: la-in 380ms var(--w-ease-ui) both; }
  .la__stage.is-run .la__lines path { animation: la-line 700ms var(--w-ease-ui) 300ms both; }
  .la__stage.is-run .la__lines path + path { animation-delay: 420ms; }
  .la__stage.is-first .la__sat--mail { animation: la-up 800ms cubic-bezier(.22, 1, .36, 1) 600ms both; }
  .la__stage.is-first .la__sat--panel { animation: la-up 800ms cubic-bezier(.22, 1, .36, 1) 900ms both; }
  .la__stage.is-run .la__sat--mail .la__sb { animation: la-in 420ms var(--w-ease-ui) 450ms both; }
  .la__stage.is-run .la__sat--panel .la__sb { animation: la-in 420ms var(--w-ease-ui) 650ms both; }
  .la__stage.is-run .la__sh time { animation: la-in 300ms var(--w-ease-ui) 700ms both; }
  @keyframes la-in { from { opacity: 0; transform: translateY(6px); } }
  @keyframes la-line { from { stroke-dashoffset: 220; } to { stroke-dashoffset: 0; } }
  @keyframes la-up { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

  /* Escena estrecha: navegador arriba, satélites debajo solapando su borde. */
  @media (max-width: 1079px) {
    .la { padding-bottom: 60px; }
    .la__stage { height: auto; display: grid; grid-template-columns: 1fr 1fr; column-gap: 16px; padding-bottom: 4px; }
    .la__lines { display: none; }
    .la__win { position: relative; left: auto; top: auto; grid-column: 1 / -1; width: 100%; max-width: 600px; height: auto; justify-self: center; padding-bottom: 64px; }
    .la__sat { position: relative; left: auto !important; top: auto !important; width: auto; margin-top: -40px; }
    .la__sat::before {
      content: ''; position: absolute; left: 50%; top: -24px; width: 1px; height: 24px;
      background: rgba(var(--accent-gold-rgb), .8); transform-origin: bottom;
    }
    .la__stage.is-run .la__sat::before { animation: la-grow 500ms var(--w-ease-ui) 300ms both; }
    @keyframes la-grow { from { transform: scaleY(0); } }
  }
  @media (max-width: 560px) {
    .la__page { padding: 14px 16px 0; }
    .la__links { display: none; }
    .la__body { padding-top: 24px; }
    .la__thanks { font-size: 32px; }
    .la__paid { font-size: 14px; }
    .la__win { padding-bottom: 56px; }
    .la__stage { column-gap: 10px; }
    .la__sat { padding: 14px 14px; border-radius: 22px; min-height: 0; }
    .la__sb b { font-size: 13.5px; }
    .la__sb > span { font-size: 12px; }
    .la__prow { padding: 6px 8px; gap: 8px; }
    .la__pth { width: 30px; height: 30px; }
    .la__ptx b { font-size: 12px; }
    .la__ptx span { font-size: 11.5px; }
    .la__sb > .la__pst { display: none; }
    .la__url { font-size: 11px; padding: 0 8px; }
    .la__bar { grid-template-columns: 44px 1fr 8px; }
  }
  @media (max-width: 360px) {
    .la__ex { display: none; }
    .la__stage { grid-template-columns: 1fr; }
    .la__sat { margin-top: 12px; }
    .la__sat--mail { margin-top: -40px; }
    .la__sat--panel::before { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .la__stage.is-run * { animation: none !important; }
  }
</style>
