---
// Tienda en línea · 03 "Qué incluye" (§4.15-6): CabeceraNumerada con titular y bajada +
// Bento2x2 (W-CORE-08 + B-03) con cuatro de `includes.items` reescritos, cada celda con
// su objeto de producto de ejemplo (v2 G04: objetos nuevos de MiniTienda a ~80 % de la celda). Móvil: objeto en la 1 y la 3; la 2 y la 4 en texto
// (diseño por sustracción, E-18; la página móvil del piloto ya iba larga).
import CabeceraNumerada from '../../CabeceraNumerada.astro';
import Bento2x2 from '../../Bento2x2.astro';
import MiniTienda from './MiniTienda.astro';
import type { ShopCopy } from '../../../../i18n/w/ecommerce';

interface Props { copy: ShopCopy['incluye']; tax: ShopCopy['tax']; n: number; city: 'houston' | 'miami'; lang?: 'es' | 'en' }
const { copy, tax, n, city, lang = 'es' } = Astro.props;
const [c1, c2, c3, c4] = copy.cells;
---
<CabeceraNumerada n={n} label={copy.label} titleHtml={copy.title} lead={copy.lead} />
<div class="ws-gap qi">
  <Bento2x2 cells={copy.cells} mobileTextOnly={[2, 4]}>
    <MiniTienda slot="ui-1" kind={c1.ui} tax={tax} city={city} lang={lang} />
    <MiniTienda slot="ui-2" kind={c2.ui} tax={tax} city={city} lang={lang} />
    <MiniTienda slot="ui-3" kind={c3.ui} tax={tax} city={city} lang={lang} />
    <MiniTienda slot="ui-4" kind={c4.ui} tax={tax} city={city} lang={lang} />
  </Bento2x2>
  <p class="qi__ex" aria-hidden="true">tutienda.example · {lang === 'en' ? 'Example' : 'Ejemplo'}</p>
</div>
<style>
  .ws-gap { margin-top: var(--w-chapter-gap); }
  /* Objeto a ~80 % de su celda con aire de bandeja (W-CORE-07/08, v2 G04): bandeja con más aire y el
     objeto llenándola. Un solo rótulo "Ejemplo" para toda la sección (§1.6). */
  .qi :global(.wd-bento__tray) { padding: 24px; }
  .qi :global(.mt) { max-width: none; }
  .qi__ex { margin: 16px 0 0; text-align: right; font: 500 11px/1 var(--font-mono); letter-spacing: .02em; color: var(--w-ink-60); }
  @media (--lt-md) { .qi :global(.wd-bento__tray) { padding: 14.5px; } }
  @media (--lt-md) { .ws-gap { margin-top: 48px; } }
</style>
