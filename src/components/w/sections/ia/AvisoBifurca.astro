---
// "A dónde te avisa" (W-HOME-14 · design/rediseno-workos.md §4.12-6).
// Texto arriba a la izquierda (H2 a dos tonos + párrafo); una línea de 4 px, redondeada,
// que baja desde la derecha, cruza en diagonal con 2 nodos (entra un mensaje · Marcy lo
// resuelve) y se bifurca en 2 destinos: el correo y el WhatsApp del dueño, cada uno con su
// caja-objeto (producto en claro, §2.4: una vista previa de correo y un mensaje) y su texto.
// Estático (la firma de la página es el hero). La línea es decorativa (aria-hidden); los
// destinos son texto real. Móvil: la línea pasa a vertical a la izquierda y los destinos
// se apilan. Datos de EJEMPLO rotulados.
import CabeceraNumerada from '../../CabeceraNumerada.astro';
import Ejemplo from '../../Ejemplo.astro';
import Icon from '../../../ui/Icon.astro';

interface Dest { title: string; text: string }
interface Copy {
  label: string; title: string; text: string;
  nodes: { icon: string; label: string }[];
  mail: { channel: string; from: string; subject: string; body: string; time: string };
  wa: { channel: string; from: string; body: string; time: string };
  destA: Dest; destB: Dest;
}
interface Props { copy: Copy; n: number; lang?: 'es' | 'en' }
const { copy, n, lang = 'es' } = Astro.props;
// Trazado en un lienzo de 1200 × 340 (escala sin deformar el trazo: non-scaling-stroke).
const PATH = 'M1010 0 V58 C1010 92 992 102 960 110 L650 188 C628 192 620 204 620 222 M620 222 C620 236 610 240 592 240 H178 C160 240 150 250 150 268 V340 M620 222 C620 236 630 240 648 240 H722 C740 240 750 250 750 268 V340';
const NODES = [{ x: 73.5, y: 38 }, { x: 60.6, y: 49.5 }];
---
<CabeceraNumerada n={n} label={copy.label} />
<div class="ab">
  <div class="ab__top">
    <div class="ab__text">
      <h2 class="w-h2" set:html={copy.title} />
      <p class="ab__p">{copy.text}</p>
    </div>
    <div class="ab__map" aria-hidden="true">
      <svg class="ab__svg" viewBox="0 0 1200 340" preserveAspectRatio="none" focusable="false">
        <path d={PATH} vector-effect="non-scaling-stroke" />
      </svg>
      {copy.nodes.map((nd, k) => (
        <span class="ab__node" style={`left:${NODES[k].x}%;top:${NODES[k].y}%`}>
          <Icon name={nd.icon} />
          <span class="ab__nlab">{nd.label}</span>
        </span>
      ))}
    </div>
    <ol class="ab__steps" aria-hidden="true">
      {copy.nodes.map((nd) => <li><span class="ab__node ab__node--flow"><Icon name={nd.icon} /></span>{nd.label}</li>)}
    </ol>
  </div>

  <div class="ab__dests">
    <div class="ab__dest">
      <div class="ab__obj">
        <Ejemplo lang={lang} on="light" />
        <p class="ab__ch"><Icon name="lucide:mail" class="ab__chi" />{copy.mail.channel}</p>
        <div class="ab__mail">
          <p class="ab__from"><span>{copy.mail.from}</span><span class="ab__time">{copy.mail.time}</span></p>
          <p class="ab__subj">{copy.mail.subject}</p>
          <p class="ab__body">{copy.mail.body}</p>
        </div>
      </div>
      <div class="ab__dt">
        <h3 class="ab__h3">{copy.destA.title}</h3>
        <p class="ab__d">{copy.destA.text}</p>
      </div>
    </div>
    <div class="ab__dest">
      <div class="ab__obj">
        <Ejemplo lang={lang} on="light" />
        <p class="ab__ch"><Icon name="lucide:message-circle" class="ab__chi" />{copy.wa.channel}</p>
        <div class="ab__msg">
          <p class="ab__bub">{copy.wa.body}<span class="ab__time">{copy.wa.time}</span></p>
        </div>
      </div>
      <div class="ab__dt">
        <h3 class="ab__h3">{copy.destB.title}</h3>
        <p class="ab__d">{copy.destB.text}</p>
      </div>
    </div>
  </div>
</div>

<style>
  .ab { margin-top: 12px; }
  .ab__top { position: relative; }
  .ab__text { position: relative; z-index: 1; max-width: 540px; }
  .ab__p { margin: 16px 0 0; max-width: 500px; font: 400 var(--w-lead)/1.5 var(--font-body); color: var(--w-ink-80); }
  .ab__map { display: none; }
  .ab__steps { list-style: none; margin: 32px 0 0; padding: 0 0 0 23px; border-left: 4px solid var(--w-line-strong); display: grid; gap: 18px; }
  .ab__steps li { display: flex; align-items: center; gap: 12px; margin-left: -48px; font: 500 15px/1.3 var(--font-body); color: var(--w-ink-80); }

  .ab__node {
    position: absolute; transform: translate(-50%, -50%);
    display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%;
    background: var(--w-s2); border: 1px solid rgba(var(--w-accent-rgb), .45); color: var(--w-accent);
    box-shadow: var(--w-edge);
  }
  .ab__node :global(svg) { width: 20px; height: 20px; }
  .ab__node--flow { position: static; transform: none; flex: none; }
  .ab__nlab {
    position: absolute; top: calc(100% + 8px); left: 50%; transform: translateX(-50%);
    white-space: nowrap; font: 500 14px/1.2 var(--font-body); color: var(--w-ink-80);
  }

  .ab__dests { display: grid; gap: 40px; margin-top: 40px; }
  .ab__dest { display: grid; gap: 20px; }
  .ab__obj {
    position: relative; background: var(--w-p-bg); color: var(--w-p-ink);
    border: 1px solid var(--w-p-line); border-radius: 16px; padding: 18px; min-height: 150px;
    max-width: 340px;
  }
  .ab__ch { display: flex; align-items: center; gap: 6px; margin: 0 0 12px; font: 500 12px/1.2 var(--font-mono); letter-spacing: var(--w-tr-micro); text-transform: uppercase; color: var(--w-p-ink-2); }
  .ab__ch :global(.ab__chi) { width: 14px; height: 14px; }
  .ab__mail { background: #fff; border: 1px solid var(--w-p-line); border-radius: 10px; padding: 12px 14px; }
  .ab__from { display: flex; justify-content: space-between; margin: 0; font: 600 14px/1.3 var(--font-body); }
  .ab__time { font: 400 12px/1.3 var(--font-body); color: var(--w-p-ink-2); }
  .ab__subj { margin: 4px 0 0; font: 500 14px/1.35 var(--font-body); }
  .ab__body { margin: 2px 0 0; font: 400 13px/1.4 var(--font-body); color: var(--w-p-ink-2); }
  .ab__msg { display: flex; }
  .ab__bub {
    margin: 0; max-width: 92%; background: rgba(var(--accent-teal-rgb), .16); border-radius: 12px 12px 12px 4px;
    padding: 10px 12px; font: 400 14px/1.45 var(--font-body); color: var(--w-p-ink);
  }
  .ab__bub .ab__time { display: block; margin-top: 4px; text-align: right; }
  .ab__h3 { margin: 0; font: 500 20px/1.25 var(--font-display); color: var(--w-accent); letter-spacing: -0.01em; }
  .ab__d { margin: 6px 0 0; max-width: 300px; font: 400 15px/1.55 var(--font-body); color: var(--w-ink-80); }

  @media (--lg) {
    .ab__steps { display: none; }
    .ab__top { min-height: 340px; }
    .ab__map { display: block; position: absolute; inset: 0; pointer-events: none; }
    .ab__svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
    .ab__svg path { fill: none; stroke: rgba(var(--star-rgb), .10); stroke-width: 4; stroke-linecap: round; stroke-linejoin: round; }
    .ab__dests { grid-template-columns: 1fr 1fr; gap: 0; margin-top: 0; }
    /* Cada destino cuelga de su rama: la caja (300) empieza en el borde de su columna y la
       rama baja a su centro (x = 150 y 750 de 1200). */
    .ab__dest { grid-template-columns: 300px 1fr; align-items: start; gap: 28px; }
    .ab__dt { padding-top: 40px; }
    .ab__obj { width: 300px; }
  }
  @media (--lt-md) { .ab__p { font-size: 1rem; } }
</style>
