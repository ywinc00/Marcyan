---
// IA para pymes · "Dónde trabaja" (design/rediseno-workos-v2.md §3 G06, P06 · W-ADV-21 Atlas).
// Texto a la izquierda y, a la derecha, la constelación de logos de P06 con Marcy de héroe en el
// centro (sustituye las 5 píldoras de texto quietas de la v1, FI §3-8): cada ~0,9 s se enciende
// una casilla y una línea teal se dibuja hasta Marcy, en bucle mientras está a la vista.
// Solo herramientas que la página nombra y con las que Marcy trabaja de verdad (§1.4, §5-14):
// WhatsApp, Instagram y Messenger (canales que contesta), tu calendario (agenda) y tu correo
// (te avisa). "Tu web" no tiene logo: va en el texto.
import CabeceraNumerada from '../../CabeceraNumerada.astro';
import ConstelacionMarcas from '../../marcas/ConstelacionMarcas.astro';

interface Copy { label: string; title: string; text: string; sr: string; chips: string[] }
interface Props { copy: Copy; n: number; lang?: 'es' | 'en' }
const { copy, n, lang = 'es' } = Astro.props;
---
<CabeceraNumerada n={n} label={copy.label} />
<div class="cc">
  <div class="cc__text">
    <h2 class="w-h2 cc__h" set:html={copy.title} />
    <p class="cc__p">{copy.text}</p>
    <ul class="cc__chips" role="list">{copy.chips.map((c) => <li>{c}</li>)}</ul>
  </div>
  <div class="cc__fig">
    <ConstelacionMarcas ids={['whatsapp', 'instagram', 'messenger', 'googlecalendar', 'gmail']} lang={lang} resumen={copy.sr} />
  </div>
</div>
<style>
  .cc { content-visibility: auto; contain-intrinsic-size: auto 480px; margin-top: 12px; display: grid; gap: 40px; align-items: center; }
  @media (--lg) { .cc { grid-template-columns: minmax(0, 440px) minmax(0, 600px); justify-content: space-between; } }
  .cc__h { margin: 0; max-width: 440px; }
  .cc__p { margin: 16px 0 0; max-width: 416px; font: 400 var(--w-lead)/1.5 var(--font-body); color: var(--w-ink-80); }
  .cc__chips { list-style: none; margin: 24px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .cc__chips li {
    padding: 7px 12px; border-radius: 999px; border: 1px solid var(--w-line-strong);
    font: 500 13px/1 var(--font-mono); letter-spacing: .02em; color: var(--w-ink-70);
  }
  .cc__fig { min-width: 0; }
  @media (--lt-md) { .cc__p { font-size: 1rem; } }
</style>
