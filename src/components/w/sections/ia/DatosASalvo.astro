---
// "Tus datos, a salvo" (W-PROOF-25 sin sellos · design/rediseno-workos.md §4.11-6 y §4.12-8).
// Propiedad de 2-ia-chat; la consume también 2-ia-pymes (copy por props, ES y EN).
// Izquierda: cabecera numerada + H2 a dos tonos + texto + 4 checks REALES (cómo está hecha
// Marcy en producción: datos personales fuera del modelo, pasa a una persona, no inventa
// precios, el dueño decide). Sin medallones ni sellos (§1.C: nada de certificaciones).
// Derecha, en vez del cubo isométrico: el MECANISMO (E-34), un objeto de sistema en noche
// opaca con lo que escribe el cliente (burbuja clara, producto) y lo que recibe la IA, con
// el nombre y el teléfono ocultos. Datos de EJEMPLO rotulados. Estático.
import CabeceraNumerada from '../../CabeceraNumerada.astro';
import Ejemplo from '../../Ejemplo.astro';
import Icon from '../../../ui/Icon.astro';

interface Copy {
  label: string; title: string; text: string; checks: string[];
  wrote: string; sees: string;
  /** Mensaje en 5 trozos: texto · NOMBRE · texto · TELÉFONO · texto. */
  msg: [string, string, string, string, string] | string[];
  masked: [string, string] | string[];
  stays: string; sr: string;
}
interface Props { copy: Copy; n: number; lang?: 'es' | 'en' }
const { copy, n, lang = 'es' } = Astro.props;
const m = copy.msg;
const titleId = `datos-title-${n}`;
---
<CabeceraNumerada n={n} label={copy.label} />
<div class="dz">
  <div class="dz__text">
    <h2 class="w-h2 dz__h" id={titleId} set:html={copy.title} />
    <p class="dz__p">{copy.text}</p>
    <ul class="dz__checks" role="list">
      {copy.checks.map((c) => (
        <li><span class="dz__box" aria-hidden="true"><Icon name="lucide:check" /></span><span>{c}</span></li>
      ))}
    </ul>
  </div>

  <figure class="dz__obj" aria-labelledby={`${titleId}-sr`}>
    <Ejemplo lang={lang} />
    <p class="sr-only" id={`${titleId}-sr`}>{copy.sr}</p>
    <div class="dz__stage" aria-hidden="true">
      <p class="dz__cap">{copy.wrote}</p>
      <p class="dz__bubble">{m[0]}<mark>{m[1]}</mark>{m[2]}<mark>{m[3]}</mark>{m[4]}</p>

      <div class="dz__pipe">
        <span class="dz__line"></span>
        <span class="dz__lock"><Icon name="lucide:shield-check" /></span>
        <span class="dz__line"></span>
      </div>

      <p class="dz__cap">{copy.sees}</p>
      <p class="dz__model">{m[0]}<span class="dz__tok">{copy.masked[0]}</span>{m[2]}<span class="dz__tok">{copy.masked[1]}</span>{m[4]}</p>

      <p class="dz__stays"><Icon name="lucide:lock" class="dz__i" />{copy.stays}</p>
    </div>
  </figure>
</div>

<style>
  .dz {
    margin-top: 12px; display: grid; gap: 48px; align-items: center;
  }
  @media (--lg) { .dz { grid-template-columns: minmax(0, 520px) minmax(0, 560px); justify-content: space-between; } }
  .dz__h { max-width: 520px; }
  .dz__p {
    margin: 16px 0 0; max-width: 480px;
    font: 400 var(--w-lead)/1.5 var(--font-body); color: var(--w-ink-80);
  }
  @media (--lt-md) { .dz__p { font-size: 1rem; } }
  .dz__checks { list-style: none; margin: 28px 0 0; padding: 0; display: grid; gap: 14px; }
  .dz__checks li { display: flex; gap: 12px; align-items: flex-start; font: 400 16px/1.5 var(--font-body); color: var(--w-ink); }
  .dz__box {
    flex: none; display: grid; place-items: center; width: 20px; height: 20px; margin-top: 2px;
    border-radius: 6px; background: rgba(var(--w-accent-rgb), .14); color: var(--w-accent);
  }
  .dz__box :global(svg) { width: 13px; height: 13px; }

  /* Objeto de sistema: noche opaca con filo de luz (§2.4, G-10). */
  .dz__obj {
    position: relative; margin: 0;
    background: var(--w-s1); border: 1px solid var(--w-line); border-radius: var(--w-r-tray);
    box-shadow: var(--w-edge); padding: 16px;
  }
  .dz__stage {
    background: var(--w-s2); border: 1px solid var(--w-line); border-radius: var(--w-r-obj);
    padding: 44px 32px 28px;
    /* Rejilla de 1 px muy tenue en la franja superior, nunca detrás del texto que se lee (E-37). */
    background-image: linear-gradient(rgba(var(--w-accent-rgb), .05) 1px, transparent 1px), linear-gradient(90deg, rgba(var(--w-accent-rgb), .05) 1px, transparent 1px);
    background-size: 24px 24px; background-position: -1px -1px;
  }
  .dz__cap {
    margin: 0 0 10px; font: 500 12px/1.2 var(--font-mono); letter-spacing: var(--w-tr-micro);
    text-transform: uppercase; color: var(--w-ink-60);
  }
  .dz__bubble, .dz__model { margin: 0; font: 400 15px/1.55 var(--font-body); border-radius: 12px; padding: 14px 16px; }
  /* Burbuja del cliente: producto en claro (§2.4). */
  .dz__bubble { background: var(--w-p-bg); color: var(--w-p-ink); border: 1px solid var(--w-p-line); }
  .dz__bubble mark { background: rgba(var(--w-accent-rgb), .22); color: var(--w-p-ink); border-radius: 4px; padding: 0 3px; }
  /* Lo que recibe la IA: sistema, mono suave para los marcadores. */
  .dz__model { background: var(--w-s3); color: var(--w-ink-80); border: 1px solid var(--w-line-strong); }
  .dz__tok {
    display: inline-block; font: 500 13px/1.3 var(--font-mono); color: var(--w-accent);
    border: 1px dashed rgba(var(--w-accent-rgb), .55); border-radius: 6px; padding: 1px 6px; margin: 0 1px;
  }
  .dz__pipe { display: flex; flex-direction: column; align-items: center; margin: 6px 0 14px; }
  .dz__line { width: 1px; height: 18px; background: var(--w-line-strong); }
  .dz__lock {
    display: grid; place-items: center; width: 40px; height: 40px; border-radius: 12px;
    background: var(--w-s1); border: 1px solid rgba(var(--w-accent-rgb), .45); color: var(--w-accent);
  }
  .dz__lock :global(svg) { width: 20px; height: 20px; }
  .dz__stays {
    display: flex; align-items: center; gap: 8px; margin: 18px 0 0;
    font: 400 14px/1.4 var(--font-body); color: var(--w-ink-70);
  }
  .dz__stays :global(.dz__i) { width: 16px; height: 16px; color: var(--w-accent); flex: none; }
  @media (--lt-md) { .dz__stage { padding: 40px 18px 22px; } .dz { gap: 36px; } }
</style>
