---
// "Foto" del inmueble de Tu Inmobiliaria, dibujada (G08 ronda 1, I2): la ficha y el listado prometen
// "listados con fotos" y enseñaban un cuadrado azul con una casita de línea (E-56 (3)). Sin foto real
// (decisión §5-12: solo con el OK del dueño), cada casa es una ilustración de arquitectura con oficio:
// cielo de tarde, arbolado al fondo, césped, sombra propia y ventanas encendidas, en tonos sobrios que
// casan con la piedra fría de la marca (negocios.ts → 'inmobiliaria').
//   v 0 · Casa Roble: una planta, tejado a dos aguas, cochera y el roble que le da nombre.
//   v 1 · Townhome Cypress: dos adosados de dos plantas, cubierta plana y balcón.
//   v 2 · Casa Jardín: dos plantas con tejado a cuatro aguas y jardín delantero.
// Decorativa: aria-hidden (el objeto que la usa ya lleva su resumen sr-only). Ids de degradado propios
// por variante y por `uid` para no chocar si se repite en la página.
interface Props { v: 0 | 1 | 2; uid: string; class?: string }
const { v, uid, class: cls } = Astro.props;
const id = (k: string) => `ci-${uid}-${v}-${k}`;
const u = (k: string) => `url(#${id(k)})`;
---
<svg class:list={['ci', cls]} viewBox="0 0 160 110" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <defs>
    <linearGradient id={id('cielo')} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color={v === 1 ? '#B9CADB' : '#C5D4E2'} />
      <stop offset=".75" stop-color={v === 2 ? '#F1E3D0' : '#EDE6DA'} />
    </linearGradient>
    <linearGradient id={id('cesped')} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#94AE7C" />
      <stop offset="1" stop-color="#6F8D5C" />
    </linearGradient>
    <linearGradient id={id('luz')} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#F8DC9C" />
      <stop offset="1" stop-color="#E9B867" />
    </linearGradient>
  </defs>
  <rect width="160" height="110" fill={u('cielo')} />
  <!-- Arbolado lejano -->
  <path d="M0 70c6-9 12-11 18-6 4-8 12-10 18-3 5-6 12-6 16 1 6-7 14-6 18 2 6-6 14-5 18 3 5-5 13-4 17 3 6-6 14-5 19 2 5-4 11-4 16 1 4-3 9-3 12 0V80H0Z" fill="#A9B9A6" />
  <path d="M0 76c8-5 15-5 22-1 7-4 16-4 24 0 9-4 18-4 26 0 9-4 19-4 28 0 8-4 18-4 26 0 9-4 19-3 34 1v8H0Z" fill="#93A790" />
  <rect y="82" width="160" height="28" fill={u('cesped')} />

  {v === 0 && (
    <g>
      <!-- Roble -->
      <rect x="20" y="62" width="4" height="26" rx="1.5" fill="#6B5240" />
      <circle cx="22" cy="54" r="15" fill="#5F7E4D" />
      <circle cx="13" cy="60" r="9" fill="#58764A" />
      <circle cx="31" cy="59" r="10" fill="#6A8A57" />
      <circle cx="18" cy="49" r="7" fill="#7A9A64" />
      <ellipse cx="96" cy="90" rx="62" ry="3.5" fill="#3E5634" opacity=".35" />
      <!-- Casa: cuerpo, cochera y tejado -->
      <rect x="44" y="60" width="72" height="28" fill="#F2EEE7" />
      <rect x="116" y="66" width="30" height="22" fill="#E6E1D8" />
      <path d="M38 62 80 40l42 22Z" fill="#3B4552" />
      <path d="M38 62 80 40l42 22h-4L80 43 42 62Z" fill="#2C343F" />
      <path d="M113 68 131 56l18 12Z" fill="#46505D" />
      <rect x="44" y="60" width="72" height="2.5" fill="#00000014" />
      <!-- Ventanas encendidas y puerta en el azul de la marca -->
      <rect x="51" y="67" width="14" height="11" rx="1" fill={u('luz')} stroke="#2C343F" stroke-width="1.4" />
      <path d="M58 67v11M51 72.5h14" stroke="#2C343F" stroke-width=".8" />
      <rect x="95" y="67" width="14" height="11" rx="1" fill={u('luz')} stroke="#2C343F" stroke-width="1.4" />
      <path d="M102 67v11M95 72.5h14" stroke="#2C343F" stroke-width=".8" />
      <rect x="75" y="68" width="10" height="20" rx="1" fill="#34507A" />
      <circle cx="83" cy="78.5" r=".9" fill="#E9B867" />
      <rect x="119" y="71" width="24" height="17" fill="#D3CEC4" />
      <path d="M119 75h24M119 79h24M119 83h24" stroke="#BDB7AB" stroke-width=".8" />
      <path d="M76 88h8l6 22H70Z" fill="#D9D2C3" opacity=".9" />
      <ellipse cx="54" cy="88" rx="9" ry="4" fill="#5F7E4D" />
      <ellipse cx="106" cy="88" rx="8" ry="3.6" fill="#58764A" />
    </g>
  )}

  {v === 1 && (
    <g>
      <ellipse cx="80" cy="91" rx="58" ry="3.5" fill="#3E5634" opacity=".35" />
      <!-- Dos adosados -->
      <rect x="34" y="36" width="46" height="54" fill="#E9E5DE" />
      <rect x="80" y="40" width="46" height="50" fill="#C9CFD6" />
      <rect x="32" y="33" width="50" height="4" fill="#2F3742" />
      <rect x="78" y="37" width="50" height="4" fill="#3A4350" />
      <rect x="34" y="37" width="46" height="2" fill="#00000012" />
      <rect x="40" y="44" width="34" height="16" fill={u('luz')} stroke="#2F3742" stroke-width="1.4" />
      <path d="M51.3 44v16M62.6 44v16" stroke="#2F3742" stroke-width=".8" />
      <path d="M38 62h38" stroke="#2F3742" stroke-width="1.6" />
      <path d="M40 62v-3M48 62v-3M56 62v-3M64 62v-3M72 62v-3" stroke="#2F3742" stroke-width=".8" />
      <rect x="40" y="68" width="14" height="22" fill="#34507A" />
      <rect x="60" y="69" width="14" height="12" fill={u('luz')} stroke="#2F3742" stroke-width="1.2" />
      <rect x="86" y="47" width="14" height="14" fill="#A9B3BE" stroke="#3A4350" stroke-width="1.2" />
      <rect x="106" y="47" width="14" height="14" fill={u('luz')} stroke="#3A4350" stroke-width="1.2" />
      <rect x="86" y="68" width="14" height="22" fill="#2F3742" />
      <rect x="106" y="69" width="14" height="12" fill="#A9B3BE" stroke="#3A4350" stroke-width="1.2" />
      <rect x="80" y="40" width="1.2" height="50" fill="#00000018" />
      <!-- Arbustos y árbol joven -->
      <rect x="137" y="66" width="2.5" height="24" fill="#6B5240" />
      <ellipse cx="138" cy="60" rx="9" ry="12" fill="#5F7E4D" />
      <ellipse cx="62" cy="90" rx="10" ry="3.6" fill="#58764A" />
      <ellipse cx="108" cy="90" rx="10" ry="3.6" fill="#5F7E4D" />
    </g>
  )}

  {v === 2 && (
    <g>
      <ellipse cx="80" cy="91" rx="60" ry="3.5" fill="#3E5634" opacity=".35" />
      <!-- Dos plantas, cuatro aguas -->
      <rect x="40" y="46" width="80" height="44" fill="#EFE7DA" />
      <path d="M34 48 52 30h56l18 18Z" fill="#5A4E46" />
      <path d="M34 48 52 30h56l18 18h-4L106 33H54L38 48Z" fill="#473D36" />
      <rect x="40" y="48" width="80" height="2.5" fill="#00000014" />
      <path d="M40 68h80" stroke="#DCD2C2" stroke-width="1" />
      {[48, 72, 96].map((x) => (
        <g>
          <rect x={x} y="53" width="13" height="11" rx="1" fill={u('luz')} stroke="#473D36" stroke-width="1.3" />
          <path d={`M${x + 6.5} 53v11`} stroke="#473D36" stroke-width=".8" />
        </g>
      ))}
      <rect x="48" y="73" width="13" height="11" rx="1" fill={u('luz')} stroke="#473D36" stroke-width="1.3" />
      <rect x="99" y="73" width="13" height="11" rx="1" fill="#C9BFAF" stroke="#473D36" stroke-width="1.3" />
      <path d="M74 90V78a6 6 0 0 1 12 0v12Z" fill="#34507A" stroke="#473D36" stroke-width="1" />
      <!-- Jardín delantero con flores -->
      <ellipse cx="54" cy="90" rx="14" ry="4.5" fill="#58764A" />
      <ellipse cx="106" cy="90" rx="14" ry="4.5" fill="#5F7E4D" />
      {[[46, 88, '#E9A2A0'], [52, 86.5, '#F3D27A'], [58, 88, '#E9A2A0'], [100, 88, '#F3D27A'], [107, 86.5, '#E9A2A0'], [113, 88, '#F3D27A']].map(([x, y, c]) => (
        <circle cx={x} cy={y} r="1.6" fill={c as string} />
      ))}
      <path d="M77 90h6l7 20H70Z" fill="#D9D2C3" opacity=".9" />
      <rect x="14" y="64" width="3" height="26" fill="#6B5240" />
      <circle cx="15.5" cy="56" r="12" fill="#6A8A57" />
      <circle cx="9" cy="62" r="7" fill="#5F7E4D" />
    </g>
  )}
</svg>
<style>
  .ci { display: block; width: 100%; height: 100%; }
</style>
