---
// Objetos nuevos de "Lo que necesita tu web" (G08 · design/rediseno-workos-v2.md §3 y §1.6).
// Sustituyen a los de la v1 (cocina dibujada a mano, casitas en cajita gris con botón de bloque,
// tarjeta de QR genérica) por piezas de producto con la marca de ejemplo de cada oficio:
//   antes-despues → página de proyecto de "Tu Plomería" con comparador antes | después (volúmenes
//                   geométricos simples, sin escena dibujada: E-38/E-53) y el sello de licencia.
//   listados      → lista de casas de "Tu Inmobiliaria" (nombre fino, datos mono, miniatura
//                   geométrica en la paleta de la marca), pestañas Comprar | Vender, acción de contorno.
//   mesa-qr       → tarjeta de mesa de "Your Restaurant" en su ladrillo, con QR de ejemplo e idiomas.
//   platos        → (ronda 1, B2) la web de Your Restaurant en un teléfono con sus platos: foto grande de
//                   los tacos y dos platos más (PlatoIlustrado), carta de hoy y pedir por WhatsApp.
// Ronda 1: las casas del listado llevan su "foto" dibujada (CasaIlustrada, I2) y antes | después y el
// listado caben enteros a 390 px (I1, E-18): nada se recorta dentro de su marco.
// Contrato §1.6: aria-hidden + data-nosnippet + resumen sr-only, sin h1-h6, acciones como span,
// un solo rótulo "Ejemplo" por objeto (en la barra o al pie).
// Ronda 2 (I-A): el comparador antes | después ya no es un tirador muerto. La costura barre sola
// (CSS, --of-p registrada) mientras la fila está a la vista, con la pestaña visible y sin la pausa
// global; botón de pausa propio (registerLoop, >5 s). Con el puntero encima el barrido se detiene y
// la costura se arrastra de verdad (pointer capture; touch-action pan-y para no robar el scroll).
// Movimiento reducido: quieto en el 47 %. Dominios de ejemplo en inglés en las páginas EN (M-2).
import LogoEjemplo from '../../objetos/ejemplos/LogoEjemplo.astro';
import LogoMarca from '../../marcas/LogoMarca.astro';
import PlatoIlustrado from './PlatoIlustrado.astro';
import { negocios } from '../../objetos/ejemplos/negocios';

interface Props { kind: 'antes-despues' | 'listados' | 'mesa-qr' | 'platos'; lang?: 'es' | 'en' }
const { kind, lang = 'es' } = Astro.props;
const en = lang === 'en';
// v4 (dueño, 2026-11-06): las casas del listado llevan FOTO, igual que la ficha del hero (la casa
// dibujada "parece PowerPoint"). Casa Roble es la misma foto del hero. Licencias: LICENCIAS.md.
const CASAS = ['/assets/w/sector/casa-roble-mini', '/assets/w/sector/casa-cypress-mini', '/assets/w/sector/casa-jardin-mini'];
const ej = en ? 'Example' : 'Ejemplo';
const T = {
  'antes-despues': en
    ? { sr: 'Example: a project page on your site with a before-and-after view of a new kitchen sink and pipes in Katy and the licensed and insured badge.', nav: ['Projects', 'Services', 'Contact'], k: 'Project', t: 'New kitchen sink and pipes', z: 'Katy, TX', antes: 'Before', despues: 'After', lic: 'Licensed and insured', dom: 'yourplumbing.example' }
    : { sr: 'Ejemplo: página de proyecto de tu web con antes y después de un fregadero y una tubería nuevos en Katy y el sello de licencia y seguro.', nav: ['Proyectos', 'Servicios', 'Contacto'], k: 'Proyecto', t: 'Fregadero y tubería nuevos', z: 'Katy, TX', antes: 'Antes', despues: 'Después', lic: 'Con licencia y asegurado', dom: negocios.plomeria.dominio },
  listados: en
    ? { sr: 'Example: your agent site with your homes listed, a buy or sell filter and a button to book a showing.', tabs: ['Buy', 'Sell'], casas: [['Oak House', 'Katy · yard and garage', ['3 bd', '2 ba']], ['Cypress Townhome', 'Cypress · showing Saturday', ['2 bd', '2.5 ba']], ['Garden House', 'Spring Branch · move-in ready', ['4 bd', '3 ba']]], btn: 'Book a showing', dom: 'yourrealty.example' }
    : { sr: 'Ejemplo: tu sitio de agente con tus casas en lista, un filtro para comprar o vender y un botón para agendar visita.', tabs: ['Comprar', 'Vender'], casas: [['Casa Roble', 'Katy · patio y cochera', ['3 hab', '2 baños']], ['Townhome Cypress', 'Cypress · se muestra el sábado', ['2 hab', '2.5 baños']], ['Casa Jardín', 'Spring Branch · lista para mudarse', ['4 hab', '3 baños']]], btn: 'Agendar visita', dom: negocios.inmobiliaria.dominio },
  platos: en
    ? { sr: "Example: your restaurant's website on a phone, with a large photo of the carne asada tacos, today's menu with two more dishes and a button to order on WhatsApp.", hero: 'Carne asada tacos', k: "Today's menu", abierto: 'Kitchen’s open', platos: ['Birria with consomé', 'Al pastor plate'], btn: 'Order on WhatsApp', dom: 'yourrestaurant.example' }
    : { sr: 'Ejemplo: la web de tu restaurante en un teléfono, con una foto grande de los tacos de asada, la carta de hoy con dos platos más y un botón para pedir por WhatsApp.', hero: 'Tacos de asada', k: 'La carta de hoy', abierto: 'Cocina abierta', platos: ['Birria con consomé', 'Orden al pastor'], btn: 'Pedir por WhatsApp', dom: negocios.restaurante.dominio },
  'mesa-qr': en
    ? { sr: 'Example: a table card with a QR code that opens the menu in English and Spanish.', scan: 'Scan for the menu', mesa: 'Table 4' }
    : { sr: 'Ejemplo: tarjeta de mesa con un código QR que abre la carta en español e inglés.', scan: 'Escanea para ver la carta', mesa: 'Mesa 4' },
}[kind] as any;

// QR de EJEMPLO (no lleva a ningún sitio): 21×21 con sus tres cuadros de posición.
const Q = 21;
const finder = (r: number, c: number) => {
  for (const [r0, c0] of [[0, 0], [0, Q - 7], [Q - 7, 0]]) {
    const y = r - r0, x = c - c0;
    if (y >= -1 && y <= 7 && x >= -1 && x <= 7) {
      if (y < 0 || y > 6 || x < 0 || x > 6) return 0;
      if (y === 0 || y === 6 || x === 0 || x === 6) return 1;
      return y >= 2 && y <= 4 && x >= 2 && x <= 4 ? 1 : 0;
    }
  }
  return -1;
};
let seed = 7;
const rnd = () => ((seed = (seed * 1103515245 + 12345) % 2147483648) / 2147483648);
const qr: string[] = [];
if (kind === 'mesa-qr') for (let r = 0; r < Q; r++) for (let c = 0; c < Q; c++) {
  const f = finder(r, c);
  if (f === 1 || (f === -1 && rnd() > 0.52)) qr.push(`M${c} ${r}h1v1h-1z`);
}
---
<div class:list={['of', `of--${kind}`]} data-nosnippet>
  <p class="sr-only">{T.sr}</p>
  <div class="of__in" aria-hidden="true">
    {kind === 'antes-despues' && (
      <div class="of-ad">
        <p class="of-bar"><i></i><i></i><i></i><span>{T.dom} · {ej}</span></p>
        <div class="of-ad__nav">
          <LogoEjemplo marca="plomeria" size={9} lang={lang} />
          <span class="of-ad__links">{T.nav.map((l: string, i: number) => <span class:list={[i === 0 && 'is-on']}>{l}</span>)}</span>
        </div>
        <p class="of-ad__k">{T.k} · {T.z}</p>
        <p class="of-ad__t">{T.t}</p>
        <div class="of-ad__cmp" data-of-ad>
          <svg class="of-ad__new" viewBox="0 0 320 168" preserveAspectRatio="xMidYMid slice">
            <!-- Después (control v2 r3, M-01): el mueble del fregadero abierto con la tubería NUEVA.
                 Desagüe cromado con su sifón, tomas de cobre con llaves y grifo nuevo; el tema del
                 título se ve en las dos mitades, nunca bajo el tirador (el tirador barre el centro). -->
            <rect width="320" height="168" fill="#efe9de" />
            <rect x="40" y="0" width="240" height="52" fill="#e7e0d3" />
            <path d="M40 17.3h240M40 34.6h240M100 0v17.3M160 0v17.3M220 0v17.3M70 17.3v17.3M130 17.3v17.3M190 17.3v17.3M250 17.3v17.3M100 34.6v17.4M160 34.6v17.4M220 34.6v17.4" stroke="#d9d0c0" stroke-width="1" />
            <path d="M168 50V31a9 9 0 0 1 18 0v4" fill="none" stroke="#14232b" stroke-width="3.4" stroke-linecap="round" />
            <rect x="161" y="44" width="14" height="8" rx="2" fill="#14232b" /><path d="M157 46h-7" stroke="#14232b" stroke-width="3" stroke-linecap="round" />
            <rect x="36" y="52" width="248" height="8" rx="2" fill="#f7f3ec" /><path d="M36 60h248" stroke="#d6ccbb" stroke-width="1" />
            <rect x="46" y="60" width="228" height="98" rx="2" fill="#1d3039" />
            <rect x="92" y="62" width="136" height="94" fill="#0f1b21" />
            <path d="M140 62h40v8a6 6 0 0 1-6 6h-28a6 6 0 0 1-6-6z" fill="#dfe3e4" />
            <path d="M92 62 58 68v84l34 4z" fill="#24414d" /><path d="M228 62l34 6v84l-34 4z" fill="#24414d" />
            <path d="M66 104v12M254 104v12" stroke="#e0935c" stroke-width="3" stroke-linecap="round" />
            <path d="M160 76v26a12 12 0 0 0 24 0v-6h44" fill="none" stroke="#c7ccce" stroke-width="6" stroke-linejoin="round" />
            <path d="M158.6 78v24" stroke="#f4f6f6" stroke-width="1.4" stroke-linecap="round" opacity=".8" />
            <rect x="155" y="98" width="10" height="5" rx="1.5" fill="#9aa2a6" /><rect x="179" y="92" width="10" height="5" rx="1.5" fill="#9aa2a6" />
            <path d="M106 140V92q0-8 8-12l30-8" fill="none" stroke="#c07a43" stroke-width="2.6" stroke-linecap="round" />
            <path d="M118 140V96q0-6 6-9l22-7" fill="none" stroke="#c07a43" stroke-width="2.6" stroke-linecap="round" />
            <circle cx="106" cy="140" r="4.2" fill="#c7ccce" /><circle cx="118" cy="140" r="4.2" fill="#c7ccce" />
            <path d="M102 140h-6M122 140h6" stroke="#e0935c" stroke-width="3" stroke-linecap="round" />
            <rect x="92" y="150" width="136" height="6" fill="#16262e" />
          </svg>
          <span class="of-ad__old">
            <svg viewBox="0 0 320 168" preserveAspectRatio="xMidYMid slice">
              <!-- Antes: el mismo mueble con la tubería VIEJA: desagüe gris oxidado y con cinta, sifón
                   que gotea en un cubo, tomas viejas y grifo gastado (la costura decide cuánto se ve). -->
              <rect width="320" height="168" fill="#d9d4cb" />
              <rect x="40" y="0" width="240" height="52" fill="#cfc8bc" />
              <path d="M40 17.3h240M40 34.6h240M100 0v17.3M160 0v17.3M220 0v17.3M70 17.3v17.3M130 17.3v17.3M190 17.3v17.3M250 17.3v17.3M100 34.6v17.4M160 34.6v17.4M220 34.6v17.4" stroke="#c2baad" stroke-width="1" />
              <path d="M170 50V38a6 6 0 0 1 12 0v2" fill="none" stroke="#8f8676" stroke-width="2.6" stroke-linecap="round" />
              <path d="M182 43c1.3 1.7 1.3 3 0 3.4-1.3-.4-1.3-1.7 0-3.4z" fill="#7d93a0" />
              <rect x="36" y="52" width="248" height="8" rx="1" fill="#b9b2a5" /><path d="M36 60h248" stroke="#a39b8d" stroke-width="1" />
              <rect x="46" y="60" width="228" height="98" rx="2" fill="#b0a798" />
              <rect x="92" y="62" width="136" height="94" fill="#857d70" />
              <path d="M140 62h40v8a6 6 0 0 1-6 6h-28a6 6 0 0 1-6-6z" fill="#b7b1a6" />
              <path d="M92 62 58 68v84l34 4z" fill="#a69d8e" /><path d="M228 62l34 6v84l-34 4z" fill="#a69d8e" />
              <path d="M66 106v8M254 106v8" stroke="#8f8676" stroke-width="2" stroke-linecap="round" />
              <path d="M160 76v26a12 12 0 0 0 24 0v-6h44" fill="none" stroke="#6f685d" stroke-width="6" stroke-linejoin="round" />
              <path d="M155 92h10M179 99h10" stroke="#5c564c" stroke-width="5" />
              <circle cx="161" cy="84" r="1.6" fill="#a0613a" /><circle cx="170" cy="113" r="1.8" fill="#a0613a" /><circle cx="203" cy="96" r="1.5" fill="#a0613a" />
              <path d="M172 118c1.6 2 1.6 3.6 0 4-1.6-.4-1.6-2 0-4z" fill="#7d93a0" /><path d="M172 127c1.3 1.6 1.3 2.9 0 3.3-1.3-.4-1.3-1.7 0-3.3z" fill="#7d93a0" />
              <path d="M161 134h22l-2.5 16h-17z" fill="#9b9286" /><path d="M161 134h22" stroke="#7a7266" stroke-width="1.6" />
              <path d="M106 140V92q0-8 8-12l30-8M118 140V96q0-6 6-9l22-7" fill="none" stroke="#8f8676" stroke-width="2.4" stroke-linecap="round" stroke-dasharray="3 1.6" />
              <circle cx="106" cy="140" r="4" fill="#7a7266" /><circle cx="118" cy="140" r="4" fill="#7a7266" />
              <ellipse cx="148" cy="152" rx="14" ry="2.2" fill="#7d93a0" opacity=".55" />
              <rect x="92" y="150" width="136" height="6" fill="#766f63" opacity=".6" />
            </svg>
          </span>
          <span class="of-ad__seam"></span>
          <span class="of-ad__asa"><svg viewBox="0 0 24 24"><path d="M9 7 4 12l5 5M15 7l5 5-5 5" /></svg></span>
          <span class="of-ad__chip of-ad__chip--a">{T.antes}</span>
          <span class="of-ad__chip of-ad__chip--d">{T.despues}</span>
        </div>
        <p class="of-ad__lic"><svg viewBox="0 0 24 24"><path d="M12 2.5 4.5 5.5v6c0 4.6 3.2 8.4 7.5 10 4.3-1.6 7.5-5.4 7.5-10v-6z" /><path d="m8.5 12 2.5 2.5 4.5-5" /></svg>{T.lic}</p>
      </div>
    )}

    {kind === 'listados' && (
      <div class="of-ls">
        <div class="of-ls__top">
          <LogoEjemplo marca="inmobiliaria" size={10} lang={lang} />
          <span class="of-ls__tabs"><span class="is-on">{T.tabs[0]}</span><span>{T.tabs[1]}</span></span>
        </div>
        <ul class="of-ls__l">
          {T.casas.map(([n, z, d]: [string, string, string[]], i: number) => (
            <li>
              <span class="of-ls__mini"><img src={`${CASAS[i]}-144.webp`} srcset={`${CASAS[i]}-72.webp 72w, ${CASAS[i]}-144.webp 144w, ${CASAS[i]}-216.webp 216w`} sizes="(max-width: 767.98px) 60px, 72px" width="72" height="52" alt="" loading="lazy" decoding="async" /></span>
              <span class="of-ls__t"><b>{n}</b><span>{z}</span></span>
              <span class="of-ls__d">{d.map((x) => <span>{x}</span>)}</span>
            </li>
          ))}
        </ul>
        <p class="of-ls__pie"><span class="of-ls__btn">{T.btn}</span><span class="of-ls__ej">{T.dom} · {ej}</span></p>
      </div>
    )}


    {kind === 'platos' && (
      <div class="of-pl">
        <div class="of-pl__pant">
          <p class="of-pl__top"><span class="of-pl__isla"></span></p>
          <p class="of-pl__bar"><LogoEjemplo marca="restaurante" size={10} lang={lang} tono="mono" /><span class="of-pl__menu"><i></i><i></i></span></p>
          <div class="of-pl__hero">
            <PlatoIlustrado v="tacos" uid={`pl-${lang}`} />
            <span class="of-pl__cap">{T.hero}</span>
          </div>
          <p class="of-pl__k"><span>{T.k}</span><span class="of-pl__ab"><i></i>{T.abierto}</span></p>
          <ul class="of-pl__l">
            <li><span class="of-pl__img"><PlatoIlustrado v="enchiladas" uid={`pl-${lang}`} /></span><b>{T.platos[0]}</b></li>
            <li><span class="of-pl__img"><PlatoIlustrado v="arroz" uid={`pl-${lang}`} /></span><b>{T.platos[1]}</b></li>
          </ul>
          <span class="of-pl__btn"><LogoMarca id="whatsapp" size={16} tono="color" titulo="" />{T.btn}</span>
          <p class="of-pl__pie">{T.dom} · {ej}</p>
        </div>
      </div>
    )}
    {kind === 'mesa-qr' && (
      <div class="of-qrm">
      <img class="of-qrm__foto" src="/fotos/ejemplos/plato-tacos-960.webp" srcset="/fotos/ejemplos/plato-tacos-480.webp 480w, /fotos/ejemplos/plato-tacos-960.webp 960w" sizes="340px" width="960" height="600" alt="" loading="lazy" decoding="async" />
      <div class="of-qr">
        <span class="of-qr__marca"><LogoEjemplo marca="restaurante" size={17} lang={lang} tono="mono" /></span>
        <span class="of-qr__code">
          <svg viewBox={`-1.5 -1.5 ${Q + 3} ${Q + 3}`} shape-rendering="crispEdges">
            <rect x="-1.5" y="-1.5" width={Q + 3} height={Q + 3} rx="1.5" fill="#fff" />
            <path d={qr.join('')} fill="#3a1a0c" />
          </svg>
        </span>
        <p class="of-qr__scan">{T.scan}</p>
        <p class="of-qr__langs"><span class:list={[en && 'is-on']}>EN</span><span class:list={[!en && 'is-on']}>ES</span></p>
        <p class="of-qr__pie"><span>{T.mesa}</span><span>{ej}</span></p>
      </div>
      </div>
    )}
  </div>
</div>

<script>
  import { registerLoop } from '../../loop';
  document.querySelectorAll<HTMLElement>('.of--antes-despues').forEach((el) => {
    const cmp = el.querySelector<HTMLElement>('[data-of-ad]');
    if (!cmp) return;
    registerLoop(el, {}, { buttonTone: 'light' });
    let drag = false;
    const mover = (x: number) => {
      const r = cmp.getBoundingClientRect();
      const p = Math.min(94, Math.max(6, ((x - r.left) / r.width) * 100));
      cmp.style.setProperty('--of-p', `${p.toFixed(1)}%`);
    };
    cmp.addEventListener('pointerdown', (e) => {
      drag = true; cmp.classList.add('is-user'); cmp.setPointerCapture(e.pointerId); mover(e.clientX);
    });
    cmp.addEventListener('pointermove', (e) => { if (drag) mover(e.clientX); });
    const soltar = () => { drag = false; };
    cmp.addEventListener('pointerup', soltar);
    cmp.addEventListener('pointercancel', soltar);
  });
</script>

<style>
  @property --of-p { syntax: '<percentage>'; inherits: true; initial-value: 47%; }
  @keyframes of-ad-barre { 0%, 100% { --of-p: 47%; } 30% { --of-p: 80%; } 65% { --of-p: 20%; } }
  .of { width: min(100%, 380px); min-width: 0; }
  .of__in { position: relative; }
  .of-bar { margin: 0; display: flex; align-items: center; gap: 5px; height: 28px; padding: 0 12px; background: #e9e3d8; border-bottom: 1px solid rgba(20, 35, 43, .08); }
  .of-bar i { width: 7px; height: 7px; border-radius: 50%; background: rgba(20, 35, 43, .22); }
  .of-bar span { margin-left: 10px; padding: 3px 10px; border-radius: 6px; background: rgba(255, 255, 255, .7); font: 500 11px/1 var(--font-mono); color: #4e5a5f; }

  /* ── Antes | después en la página de proyecto de Tu Plomería ── */
  .of-ad { overflow: hidden; border-radius: 14px; background: #f3efe6; color: #14232b; box-shadow: 0 24px 48px rgba(0, 0, 0, .35), 0 0 0 1px rgba(255, 255, 255, .06); }
  .of-ad__nav { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 18px 0; --ej-accent: #a3561f; }
  .of-ad__links { display: flex; gap: 12px; font: 500 12px/1 var(--font-body); color: #4e5a5f; }
  .of-ad__links .is-on { color: #14232b; box-shadow: 0 1px 0 #a3561f; padding-bottom: 3px; }
  .of-ad__k { margin: 18px 18px 0; font: 500 11px/1.2 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; color: #a3561f; }
  .of-ad__t { margin: 6px 18px 0; font: 600 26px/1.05 var(--font-display); letter-spacing: -0.03em; }
  .of-ad__cmp {
    --of-p: 47%;
    position: relative; margin: 14px 18px 0; border-radius: 10px; overflow: hidden; aspect-ratio: 320 / 168;
    cursor: ew-resize; touch-action: pan-y; user-select: none;
    animation: of-ad-barre 9s cubic-bezier(.45, 0, .55, 1) infinite paused;
  }
  .of.is-playing .of-ad__cmp { animation-play-state: running; }
  :global(:root[data-w-pausa]) .of.is-playing .of-ad__cmp { animation-play-state: paused; }
  .of.is-still .of-ad__cmp, .of-ad__cmp.is-user { animation: none; }
  .of-ad__cmp svg { display: block; width: 100%; height: 100%; }
  .of-ad__old { position: absolute; inset: 0; clip-path: inset(0 calc(100% - var(--of-p)) 0 0); }
  .of-ad__seam { position: absolute; top: 0; bottom: 0; left: var(--of-p); width: 2px; margin-left: -1px; background: #fff; }
  .of-ad__asa { position: absolute; left: var(--of-p); top: 50%; width: 30px; height: 30px; margin: -15px 0 0 -15px; display: grid; place-items: center; border-radius: 50%; background: #fff; box-shadow: 0 4px 12px rgba(20, 35, 43, .25); }
  .of-ad__asa svg { width: 16px; fill: none; stroke: #14232b; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .of-ad__chip { position: absolute; top: 8px; padding: 4px 8px; border-radius: 999px; font: 600 11px/1 var(--font-body); }
  .of-ad__chip--a { left: 8px; background: rgba(20, 35, 43, .7); color: #f3efe6; }
  .of-ad__chip--d { right: 8px; background: #fff; color: #14232b; }
  .of-ad__lic { display: flex; align-items: center; gap: 8px; margin: 0; padding: 14px 18px 16px; font: 500 13px/1.2 var(--font-body); color: #14232b; }
  .of-ad__lic svg { width: 18px; fill: none; stroke: #a3561f; stroke-width: 1.8; stroke-linejoin: round; stroke-linecap: round; }

  /* ── Lista de casas de Tu Inmobiliaria ── */
