---
// "Foto" de plato de Your Restaurant, dibujada (G08 ronda 1, B2): la fila "Photos that make people
// hungry" enseñaba un bloque ladrillo sin ningún plato (E-56 (3)). Sin foto real (decisión §5-12: solo
// con el OK del dueño), cada plato es una ilustración cenital con oficio, sobre mantel y en la loza de la
// casa: luz de arriba a la izquierda, sombra propia y textura de ingredientes.
//   tacos      · tres tacos de camarón con col, cilantro, crema y lima (lienzo apaisado del hero).
//   enchiladas · fuente oval con tres enchiladas en salsa verde, crema, queso fresco y cebolla morada.
//   arroz      · plato con arroz rojo, frijoles de olla y un ramito de cilantro.
// Decorativa: aria-hidden. Ids propios por variante y `uid`.
interface Props { v: 'tacos' | 'enchiladas' | 'arroz'; uid: string; class?: string }
const { v, uid, class: cls } = Astro.props;
const id = (k: string) => `pi-${uid}-${v}-${k}`;
const u = (k: string) => `url(#${id(k)})`;
const ancho = v === 'tacos';
const W = ancho ? 240 : 120, H = ancho ? 150 : 120;
// Granos de arroz y migas de queso con semilla fija (mismo dibujo en cada compilación).
let s = 11;
const r = () => ((s = (s * 9301 + 49297) % 233280) / 233280);
const granos = v === 'arroz' ? Array.from({ length: 46 }, () => {
  const a = r() * Math.PI * 2, d = Math.sqrt(r()) * 21;
  return { x: 47 + Math.cos(a) * d * 1.05, y: 58 + Math.sin(a) * d * .9, rot: Math.round(r() * 180) };
}) : [];
const frijoles = v === 'arroz' ? Array.from({ length: 22 }, () => {
  const a = r() * Math.PI * 2, d = Math.sqrt(r()) * 17;
  return { x: 78 + Math.cos(a) * d, y: 66 + Math.sin(a) * d * .85, rot: Math.round(r() * 180) };
}) : [];
const migas = v === 'enchiladas' ? Array.from({ length: 18 }, () => ({ x: 30 + r() * 60, y: 42 + r() * 36 })) : [];
---
<svg class:list={['pi', cls]} viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <defs>
    <radialGradient id={id('loza')} cx=".42" cy=".38" r=".7">
      <stop offset="0" stop-color="#FFFDF8" />
      <stop offset=".8" stop-color="#F1E8DA" />
      <stop offset="1" stop-color="#E2D5C2" />
    </radialGradient>
    <radialGradient id={id('tortilla')} cx=".4" cy=".35" r=".8">
      <stop offset="0" stop-color="#F3D48F" />
      <stop offset="1" stop-color="#D9A856" />
    </radialGradient>
    <linearGradient id={id('salsa')} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#8DB55A" />
      <stop offset="1" stop-color="#5E8A3A" />
    </linearGradient>
    <pattern id={id('mantel')} width="12" height="12" patternUnits="userSpaceOnUse">
      <rect width="12" height="12" fill="#B4573A" />
      <path d="M0 6h12M6 0v12" stroke="#A34B30" stroke-width="2.4" />
      <path d="M0 6h12" stroke="#C26A4B" stroke-width=".6" />
    </pattern>
  </defs>
  <rect width={W} height={H} fill={ancho ? '#E9DCC8' : `url(#${id('mantel')})`} />

  {v === 'tacos' && (
    <g>
      <!-- Tabla de madera -->
      <rect x="0" y="0" width="240" height="150" fill="#E7D7BF" />
      <path d="M0 22h240M0 58h240M0 96h240M0 128h240" stroke="#DCC9AC" stroke-width="1.2" />
      <rect x="22" y="18" width="196" height="118" rx="14" fill="#C69563" />
      <rect x="22" y="18" width="196" height="118" rx="14" fill="none" stroke="#A97A4C" stroke-width="2" />
      <path d="M34 40h172M34 64h172M34 92h172M34 118h172" stroke="#B9875A" stroke-width="1" opacity=".7" />
      <rect x="26" y="134" width="196" height="6" rx="3" fill="#00000026" />
      {[[70, 70, -14], [122, 78, 4], [174, 70, 18]].map(([x, y, a]) => (
        <g transform={`translate(${x} ${y}) rotate(${a})`}>
          <ellipse cx="2" cy="6" rx="30" ry="34" fill="#00000024" />
          <ellipse cx="0" cy="0" rx="30" ry="34" fill={u('tortilla')} />
          <ellipse cx="0" cy="0" rx="30" ry="34" fill="none" stroke="#C48D3F" stroke-width="1.6" />
          <path d="M-22-6c6-3 10 4 16 1s9 3 15 0 9 2 13-1" fill="none" stroke="#B7D38A" stroke-width="5" stroke-linecap="round" />
          <path d="M-20 4c7-2 12 3 18 0s12 2 20-1" fill="none" stroke="#CFE3A6" stroke-width="3.4" stroke-linecap="round" />
          {[[-10, -14], [8, -12], [-2, 12], [14, 8]].map(([sx, sy]) => (
            <g transform={`translate(${sx} ${sy})`}>
              <path d="M-7 0a7 6 0 1 1 9 5.6" fill="none" stroke="#F0895C" stroke-width="5.4" stroke-linecap="round" />
              <path d="M-7 0a7 6 0 1 1 9 5.6" fill="none" stroke="#F8B38E" stroke-width="1.4" stroke-linecap="round" stroke-dasharray="2 3" />
            </g>
          ))}
          <path d="M-18 18c8-6 14 4 22-2s12 2 16-3" fill="none" stroke="#FFF8EE" stroke-width="2.2" stroke-linecap="round" />
          {[[-14, -2], [4, -4], [-4, 22], [18, -2], [10, 18]].map(([cx, cy]) => <circle cx={cx} cy={cy} r="2.2" fill="#3F7D35" />)}
        </g>
      ))}
      <!-- Lima y salsa -->
      <g transform="translate(206 120)">
        <path d="M-14 0a14 14 0 0 1 28 0Z" fill="#7FB24A" />
        <path d="M-11 0a11 11 0 0 1 22 0Z" fill="#CFE79A" />
        <path d="M0 0V-10M0 0l-7-7M0 0l7-7" stroke="#A9D06A" stroke-width="1" />
      </g>
      <circle cx="36" cy="124" r="11" fill="#8E3A1E" />
      <circle cx="36" cy="124" r="8" fill="#B8432A" />
      <circle cx="33" cy="121" r="2" fill="#E07A55" opacity=".7" />
    </g>
  )}

  {v === 'enchiladas' && (
    <g>
      <ellipse cx="62" cy="66" rx="52" ry="40" fill="#00000030" />
      <ellipse cx="60" cy="62" rx="52" ry="40" fill={u('loza')} />
      <ellipse cx="60" cy="62" rx="42" ry="31" fill="none" stroke="#E2D5C2" stroke-width="1.2" />
      {[46, 60, 74].map((y) => (
        <g>
          <rect x="22" y={y - 9} width="76" height="16" rx="8" fill="#E8C27D" />
          <rect x="22" y={y - 9} width="76" height="16" rx="8" fill={u('salsa')} opacity=".95" />
          <path d={`M26 ${y - 3}h68`} stroke="#A7CC72" stroke-width="2" stroke-linecap="round" opacity=".7" />
        </g>
      ))}
      <path d="M28 44c8 6 12-4 20 2s12-4 20 2 12-4 20 2M28 60c8 6 12-4 20 2s12-4 20 2 12-4 20 2M30 76c8 5 12-4 20 1s12-4 20 1 10-3 16 0" fill="none" stroke="#FFF8EE" stroke-width="2" stroke-linecap="round" />
      {migas.map((m) => <rect x={m.x} y={m.y} width="3" height="2.6" rx=".6" fill="#FFFDF6" />)}
      {[[40, 52], [66, 40], [82, 68], [52, 76]].map(([x, y]) => (
        <g><circle cx={x} cy={y} r="3.4" fill="none" stroke="#B14A7E" stroke-width="1.4" /><circle cx={x} cy={y} r="1.6" fill="none" stroke="#D78AB0" stroke-width=".8" /></g>
      ))}
      {[[34, 66], [72, 52], [88, 46], [58, 68]].map(([x, y]) => <circle cx={x} cy={y} r="1.8" fill="#3F7D35" />)}
    </g>
  )}

  {v === 'arroz' && (
    <g>
      <circle cx="63" cy="64" r="48" fill="#00000030" />
      <circle cx="60" cy="60" r="48" fill={u('loza')} />
      <circle cx="60" cy="60" r="38" fill="none" stroke="#E2D5C2" stroke-width="1.2" />
      <ellipse cx="47" cy="58" rx="24" ry="20" fill="#E7A86E" />
      <ellipse cx="45" cy="55" rx="18" ry="14" fill="#EFBC86" />
      {granos.map((g) => <ellipse cx={g.x} cy={g.y} rx="2.2" ry=".9" transform={`rotate(${g.rot} ${g.x} ${g.y})`} fill="#FBE3C2" />)}
      {[[40, 62], [52, 50], [38, 50]].map(([x, y]) => <rect x={x} y={y} width="3" height="3" rx=".6" fill="#F3A33A" />)}
      {[[46, 66], [56, 60]].map(([x, y]) => <circle cx={x} cy={y} r="1.6" fill="#6BA34A" />)}
      <ellipse cx="78" cy="66" rx="20" ry="16" fill="#3B2118" />
      {frijoles.map((f) => (
        <g transform={`rotate(${f.rot} ${f.x} ${f.y})`}>
          <ellipse cx={f.x} cy={f.y} rx="3.4" ry="2.2" fill="#5A2E22" />
          <ellipse cx={f.x - .8} cy={f.y - .6} rx="1.2" ry=".6" fill="#8A5240" />
        </g>
      ))}
      <!-- Ramito de cilantro -->
      <g transform="translate(76 40) rotate(-20)">
        <path d="M0 0v14" stroke="#4E8B3A" stroke-width="1.2" />
        {[[-4, 2], [4, 3], [-3, 8], [4, 9], [0, -3]].map(([x, y]) => <circle cx={x} cy={y} r="3" fill="#5E9C45" />)}
      </g>
    </g>
  )}
</svg>
<style>
  .pi { display: block; width: 100%; height: 100%; }
</style>
