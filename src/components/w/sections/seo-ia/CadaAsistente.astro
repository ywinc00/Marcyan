---
// SEO para IA · 01 "Cada asistente, su respuesta" (design/rediseno-workos.md §4.17-3,
// W-HOME-11). Cabecera numerada + a la izquierda (461) una frase y 4 rasgos (icono en caja
// 32 radio 7 + texto 14); a la derecha (659) la tarjeta de pestañas ChatGPT · Perplexity ·
// Gemini · Google (objeto de SISTEMA en noche opaca, radio 18 → token 22) con la respuesta
// de EJEMPLO de cada asistente en claro (objeto de PRODUCTO) y, debajo, las fuentes que leyó.
// Pestañas que maneja el visitante (§2.10): NO rotan solas; tablist/tab/tabpanel con flechas,
// Inicio y Fin; fundido de 180 ms solo de opacidad. Nombres de terceros solo en texto, sin
// logotipos (§1.C). Sin JS: la 1.ª pestaña visible y las demás ocultas (hidden), como hoy.
import CabeceraNumerada from '../../CabeceraNumerada.astro';
import Ejemplo from '../../Ejemplo.astro';
import Icon from '../../../ui/Icon.astro';

interface Answer { pre: string; biz: string; post: string; refs?: boolean }
interface Tab { id: string; label: string; kind: string; answer: Answer; sources: string[] }
interface Props {
  n: number;
  label: string;
  titleHtml: string;
  lead: string;
  intro: string;
  traits: { icon: string; text: string }[];
  question: string;
  sourcesLabel: string;
  tabs: Tab[];
}
const { n, label, titleHtml, lead, intro, traits, question, sourcesLabel, tabs } = Astro.props;
---
<CabeceraNumerada n={n} label={label} titleHtml={titleHtml} lead={lead} />

<div class="ca" data-ca>
  <div class="ca__side">
    <p class="ca__intro">{intro}</p>
    <ul class="ca__traits">
      {traits.map((t) => (
        <li class="ca__trait">
          <span class="ca__ic"><Icon name={t.icon} /></span>
          <span class="ca__tx">{t.text}</span>
        </li>
      ))}
    </ul>
  </div>

  <div class="ca__card">
    <div class="ca__tabs" role="tablist" aria-label="Asistentes de IA">
      {tabs.map((t, i) => (
        <button
          class="ca__tab"
          type="button"
          role="tab"
          id={`ca-tab-${t.id}`}
          aria-controls={`ca-panel-${t.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
        >{t.label}</button>
      ))}
    </div>

    {tabs.map((t, i) => (
      <div class="ca__panel" role="tabpanel" id={`ca-panel-${t.id}`} aria-labelledby={`ca-tab-${t.id}`} tabindex="0" hidden={i !== 0}>
        <div class="ca__chat">
          <Ejemplo on="light" />
          <p class="ca__kind">{t.kind}</p>
          <p class="ca__q">{question}</p>
          <p class="ca__a">{t.answer.pre}<b translate="no">{t.answer.biz}</b>{t.answer.post}</p>
        </div>
        <div class="ca__src">
          <p class="ca__src-k">{sourcesLabel}</p>
          <ul class="ca__src-list">
            {t.sources.map((s, j) => (
              <li class="ca__chip">{t.answer.refs && <span class="ca__ref">{j + 1}</span>}{s}</li>
            ))}
          </ul>
        </div>
      </div>
    ))}
  </div>
</div>

<script>
  // Pestañas accesibles (patrón APG con activación automática). Cada bloque busca dentro de
  // su propio nodo (Cerrojo 2).
  document.querySelectorAll<HTMLElement>('[data-ca]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = tabs.map((t) => root.querySelector<HTMLElement>('#' + t.getAttribute('aria-controls')));
    const select = (i: number, focus = false) => {
      tabs.forEach((t, j) => {
        const on = j === i;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
        const p = panels[j];
        if (!p) return;
        if (on) {
          p.hidden = false;
          p.classList.remove('is-in');
          requestAnimationFrame(() => requestAnimationFrame(() => p.classList.add('is-in')));
        } else {
          p.hidden = true;
          p.classList.remove('is-in');
        }
      });
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        const k = e.key;
        let to = -1;
        if (k === 'ArrowRight') to = (i + 1) % tabs.length;
        else if (k === 'ArrowLeft') to = (i - 1 + tabs.length) % tabs.length;
        else if (k === 'Home') to = 0;
        else if (k === 'End') to = tabs.length - 1;
        if (to < 0) return;
        e.preventDefault();
        select(to, true);
      });
    });
    panels[0]?.classList.add('is-in');
  });
</script>

<style>
  .ca { margin-top: 64px; display: grid; gap: 40px; }
  @media (--lg) {
    .ca { grid-template-columns: minmax(0, 461fr) minmax(0, 659fr); column-gap: 80px; align-items: start; }
  }

  /* ── Columna de texto (W-HOME-11, 461) ── */
  .ca__intro { margin: 0; max-width: 30rem; font-family: var(--font-body); font-size: 19px; line-height: 1.55; color: var(--w-ink-80); }
  .ca__traits { list-style: none; margin: 40px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px 28px; }
  .ca__trait { display: flex; flex-direction: column; gap: 12px; }
  .ca__ic {
    display: inline-grid; place-items: center; width: 32px; height: 32px; border-radius: 7px;
    background: rgba(var(--w-accent-rgb), .12); color: var(--w-accent);
  }
  .ca__ic :global(svg) { width: 18px; height: 18px; }
  .ca__tx { font-family: var(--font-body); font-size: 15px; line-height: 1.45; color: var(--w-ink-80); }

  /* ── Tarjeta de pestañas (objeto de sistema, opaco) ── */
  .ca__card {
    min-width: 0; background: var(--w-s2); border: 1px solid var(--w-line);
    border-radius: var(--w-r-tray); box-shadow: var(--w-edge), 0 40px 80px -40px rgba(0, 0, 0, .6);
    overflow: hidden;
  }
  .ca__tabs {
    display: flex; gap: 4px; padding: 0 12px; border-bottom: 1px solid var(--w-line);
    overflow-x: auto; scrollbar-width: none;
  }
  .ca__tabs::-webkit-scrollbar { display: none; }
  .ca__tab {
    position: relative; flex: none; min-height: 52px; padding: 0 16px;
    background: none; border: 0; cursor: pointer;
    font: 500 14px/1 var(--font-body); color: var(--w-ink-60);
    transition: color var(--w-dur-micro) var(--w-ease-ui);
  }
  .ca__tab::after {
    content: ''; position: absolute; left: 12px; right: 12px; bottom: -1px; height: 2px;
    background: var(--w-accent); opacity: 0; transition: opacity var(--w-dur-micro) var(--w-ease-ui);
  }
  .ca__tab[aria-selected='true'] { color: var(--w-ink); }
  .ca__tab[aria-selected='true']::after { opacity: 1; }
  @media (--hover-fine) { .ca__tab:hover { color: var(--w-ink); } }
  .ca__tab:focus-visible { outline: 2px solid var(--w-accent); outline-offset: -4px; border-radius: 6px; }

  .ca__panel { padding: 28px; display: grid; gap: 20px; }
  .ca__panel[hidden] { display: none; }
  .ca__panel:focus-visible { outline: 2px solid var(--w-accent); outline-offset: -2px; }
  .ca__panel.is-in { animation: ca-in 180ms var(--w-ease-ui) both; }
  @keyframes ca-in { from { opacity: 0; } to { opacity: 1; } }

  /* Respuesta en claro (objeto de producto, §2.4). */
  .ca__chat {
    position: relative; display: grid; gap: 14px; padding: 24px;
    background: var(--w-p-bg); color: var(--w-p-ink);
    border: 1px solid var(--w-p-line); border-radius: var(--w-r-obj);
  }
  .ca__kind { margin: 0; padding-right: 96px; font: 500 12px/1.2 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--w-p-ink-2); }
  .ca__q {
    justify-self: end; margin: 0; max-width: 85%; padding: 10px 14px; border-radius: 12px 12px 4px 12px;
    background: #fff; border: 1px solid var(--w-p-line);
    font: 400 15px/1.45 var(--font-body); color: var(--w-p-ink);
  }
  .ca__a { margin: 0; font: 400 16px/1.6 var(--font-body); color: var(--w-p-ink); }
  .ca__a b { font-weight: 700; }

  /* Fuentes que leyó (eco del bloque "HTTP 200" de W-HOME-11). */
  .ca__src { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; }
  .ca__src-k { margin: 0; font: 500 12px/1.2 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--w-ink-60); }
  .ca__src-list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .ca__chip {
    display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border-radius: 999px;
    border: 1px solid var(--w-line-strong); background: var(--w-s1);
    font: 400 13px/1.3 var(--font-mono); color: var(--w-ink-80);
  }
  .ca__ref {
    display: inline-grid; place-items: center; width: 18px; height: 18px; border-radius: 50%;
    background: rgba(var(--w-accent-rgb), .16); color: var(--w-accent); font-size: 11px; font-weight: 500;
  }

  @media (--lt-md) {
    .ca { margin-top: 40px; }
    .ca__intro { font-size: 17px; }
    .ca__traits { margin-top: 28px; gap: 24px 20px; }
    .ca__tab { padding: 0 14px; }
    .ca__panel { padding: 16px; }
    .ca__chat { padding: 18px; }
    .ca__q { max-width: 100%; }
  }
  @media (--motion-reduce) { .ca__panel.is-in { animation: none; } }
</style>
