---
// SEO para IA · 04 "La ficha que leen los asistentes" (design/rediseno-workos.md §4.17-6,
// W-NEW-38). Cabecera numerada con H2 y bajada; debajo, a la izquierda (648) la ventana del
// archivo `llms.txt` de EJEMPLO ("Tu Plomería") en mono 13, con los encabezados en el acento;
// a la derecha (462) la tarjeta "Pregúntale a un asistente" con la pregunta de ejemplo y el
// cursor de bloque, y debajo dos tarjetas que dicen qué es cada pieza (índice y datos).
// Ventanas = objetos de SISTEMA en noche opaca (es lo que lee la máquina).
// Movimiento: el cursor parpadea a 1,06 s SOLO al entrar en vista y se para a los 4 ciclos
// (< 5 s: WCAG 2.2.2 sin botón de pausa); con reduced-motion queda fijo.
import CabeceraNumerada from '../../CabeceraNumerada.astro';
import Ejemplo from '../../Ejemplo.astro';

interface Line { t: 'h1' | 'q' | 'h2' | 'li' | 'sp'; text?: string }
interface Props {
  n: number;
  label: string;
  titleHtml: string;
  lead: string;
  file: { name: string; kind: string; lines: Line[]; foot: string };
  prompt: { title: string; kind: string; text: string; biz: string; reply: string; source: string };
  notes: { k: string; text: string }[];
}
const { n, label, titleHtml, lead, file, prompt, notes } = Astro.props;
---
<CabeceraNumerada n={n} label={label} titleHtml={titleHtml} lead={lead} />

<div class="fa" data-fa>
  <figure class="fa__win fa__file">
    <figcaption class="fa__bar">
      <span class="fa__name">{file.name}</span>
      <span class="fa__kind">{file.kind}</span>
    </figcaption>
    <div class="fa__body">
      <Ejemplo />
      <div class="fa__code">
        {file.lines.map((l) => <span class:list={['fa__ln', `fa__ln--${l.t}`]}>{l.text}</span>)}
      </div>
    </div>
    <p class="fa__foot">{file.foot}</p>
  </figure>

  <div class="fa__side">
    <div class="fa__win fa__prompt">
      <p class="fa__bar">
        <span class="fa__name fa__name--txt">{prompt.title}</span>
        <span class="fa__kind">{prompt.kind}</span>
      </p>
      <p class="fa__ask"><span class="fa__caret" aria-hidden="true">›</span><span>{prompt.text}<span class="fa__cursor" data-fa-cursor aria-hidden="true"></span></span></p>
      <div class="fa__reply">
        <p class="fa__reply-t"><b translate="no">{prompt.biz}</b>{prompt.reply}</p>
        <p class="fa__reply-s">{prompt.source}</p>
      </div>
    </div>
    <dl class="fa__win fa__notes">
      {notes.map((x) => (
        <div class="fa__note">
          <dt>{x.k}</dt>
          <dd>{x.text}</dd>
        </div>
      ))}
    </dl>
  </div>
</div>

<script>
  // El cursor parpadea solo cuando su ventana entra en vista; 4 ciclos y queda fijo.
  document.querySelectorAll<HTMLElement>('[data-fa]').forEach((root) => {
    const cur = root.querySelector<HTMLElement>('[data-fa-cursor]');
    if (!cur || !('IntersectionObserver' in window)) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const io = new IntersectionObserver((es) => {
      if (es.some((e) => e.isIntersecting)) { cur.classList.add('is-on'); io.disconnect(); }
    }, { threshold: 0.6 });
    io.observe(cur.closest('.fa__prompt') ?? cur);
  });
</script>

<style>
  .fa { margin-top: 64px; display: grid; gap: 24px; }
  @media (--lg) {
    .fa { grid-template-columns: minmax(0, 648fr) minmax(0, 462fr); column-gap: 24px; align-items: stretch; }
  }

  .fa__win {
    margin: 0; min-width: 0; background: var(--w-s2); border: 1px solid var(--w-line);
    border-radius: var(--w-r-cell); box-shadow: var(--w-edge);
  }
  .fa__bar {
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    margin: 0; padding: 14px 20px; border-bottom: 1px solid var(--w-line);
  }
  .fa__name { font: 400 13px/1.3 var(--font-mono); color: var(--w-ink-70); overflow-wrap: anywhere; }
  .fa__name--txt { font-family: var(--font-body); font-size: 14px; color: var(--w-ink-80); }
  .fa__kind { flex: none; font: 500 12px/1.2 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--w-ink-60); }

  .fa__file { display: flex; flex-direction: column; }
  .fa__body { position: relative; flex: 1; padding: 24px 20px 20px; }
  .fa__code {
    margin: 0; overflow-wrap: anywhere;
    font: 400 13px/1.75 var(--font-mono); color: var(--w-ink-80);
  }
  .fa__ln { display: block; min-height: 1.75em; }
  .fa__ln--li { padding-left: 1.2em; text-indent: -1.2em; }
  .fa__ln--h1 { color: var(--w-ink); font-weight: 500; }
  .fa__ln--q { color: var(--w-accent); }
  .fa__ln--h2 { color: var(--w-accent); }
  .fa__foot {
    margin: 0; padding: 14px 20px; border-top: 1px solid var(--w-line);
    font: 400 14px/1.5 var(--font-body); color: var(--w-ink-70);
  }

  .fa__side { display: grid; gap: 24px; grid-template-rows: 1fr auto; min-width: 0; }
  .fa__ask {
    display: flex; gap: 12px; margin: 0; padding: 24px 20px 32px;
    font: 400 14px/1.75 var(--font-mono); color: var(--w-ink);
  }
  .fa__caret { color: var(--w-accent); flex: none; }
  /* La respuesta que arma el asistente con el archivo: cierra la historia de la ventana. */
  .fa__reply { margin: 0 20px 24px; padding: 16px 18px; border-radius: var(--w-r-cell); border-left: 2px solid var(--w-accent); background: var(--w-s1); }
  .fa__reply-t { margin: 0; font: 400 15px/1.55 var(--font-body); color: var(--w-ink-80); }
  .fa__reply-t b { color: var(--w-ink); font-weight: 600; }
  .fa__reply-s { margin: 8px 0 0; font: 400 13px/1.4 var(--font-mono); color: var(--w-ink-60); overflow-wrap: anywhere; }
  .fa__cursor {
    display: inline-block; width: 8px; height: 1.1em; margin-left: 4px; vertical-align: -0.18em;
    background: var(--w-ink-80);
  }
  .fa__cursor.is-on { animation: fa-blink 1.06s steps(1, end) 4; }
  @keyframes fa-blink { 0% { opacity: 1; } 50% { opacity: 0; } 100% { opacity: 1; } }

  .fa__notes { display: grid; }
  .fa__note { padding: 18px 20px; }
  .fa__note + .fa__note { border-top: 1px solid var(--w-line); }
  .fa__note dt { font: 500 12px/1.2 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--w-ink-60); }
  .fa__note dd { margin: 8px 0 0; font: 400 15px/1.5 var(--font-body); color: var(--w-ink-80); }

  @media (--lt-md) {
    .fa { margin-top: 40px; gap: 16px; }
    .fa__side { gap: 16px; }
    .fa__body { padding: 44px 16px 16px; }
    .fa__bar, .fa__foot, .fa__note { padding-inline: 16px; }
    .fa__ask { padding: 20px 16px 20px; }
    .fa__reply { margin: 0 16px 16px; }
  }
  @media (--motion-reduce) { .fa__cursor.is-on { animation: none; } }
</style>
