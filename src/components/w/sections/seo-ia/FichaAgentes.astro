---
// SEO para IA · 05 "La ficha que leen los asistentes" (design/rediseno-workos-v2.md §3 G07, P10).
// Original: el pase holográfico de WorkOS (W2N-02, pase_hover_hoja.jpg): una ficha de identidad
// clara dentro de una ventana, con la fila de apps que la usan debajo. Situación calzada: "la ficha
// de identidad de tu negocio que leen los asistentes". Objeto principal = PaseNegocio (pieza
// compartida, interactiva con el puntero) dentro de una bandeja, con FilaMarcas "Lo leen" en su
// ranura. A la derecha, el archivo llms.txt de EJEMPLO (lo que hay detrás de la ficha) en mono 13.
// Debajo, tres notas en columnas con filete de 1 px (W-CORE-23).
// Se retira la tarjeta "Lo que pregunta tu cliente" de la v1: esa historia la cuenta ahora,
// interactiva, la sección "Pregúntale tú".
import CabeceraNumerada from '../../CabeceraNumerada.astro';
import Ejemplo from '../../Ejemplo.astro';
import PaseNegocio from '../../pase/PaseNegocio.astro';
import FilaMarcas from '../../marcas/FilaMarcas.astro';
import type { MarcaId } from '../../marcas/datos';

interface Line { t: 'h1' | 'q' | 'h2' | 'li' | 'sp'; text?: string }
interface Props {
  n: number;
  label: string;
  titleHtml: string;
  lead: string;
  loLeen: MarcaId[];
  file: { name: string; kind: string; lines: Line[]; foot: string };
  notes: { k: string; text: string }[];
}
const { n, label, titleHtml, lead, loLeen, file, notes } = Astro.props;
---
<CabeceraNumerada n={n} label={label} titleHtml={titleHtml} lead={lead} />

<div class="fa" data-nosnippet>
  <div class="fa__tray">
    <div class="fa__app" aria-hidden="true">
      <span class="fa__dots"><i></i><i></i><i></i></span>
      <span class="fa__url">tunegocio.example · ficha</span>
    </div>
    <PaseNegocio lang="es" ciudad="houston" ancho={620} class="fa__pase">
      <FilaMarcas slot="lo-leen" ids={loLeen} lang="es" size={20} />
    </PaseNegocio>
  </div>

  <figure class="fa__win fa__file">
    <figcaption class="fa__bar">
      <span class="fa__name" set:html={file.name.replace('/', '/<wbr>')} />
      <span class="fa__kind">{file.kind}</span>
    </figcaption>
    <div class="fa__body">
      <Ejemplo />
      <div class="fa__code">
        {file.lines.map((l) => <span class:list={['fa__ln', `fa__ln--${l.t}`]}>{l.text}</span>)}
      </div>
    </div>
    <p class="fa__foot">{file.foot}</p>
  </figure>

  <dl class="fa__notes">
    {notes.map((x) => (
      <div class="fa__note">
        <dt>{x.k}</dt>
        <dd>{x.text}</dd>
      </div>
    ))}
  </dl>
</div>

<style>
  .fa { margin-top: 64px; display: grid; gap: 24px; }
  @media (--lg) {
    .fa { grid-template-columns: minmax(0, 700fr) minmax(0, 420fr); column-gap: 24px; align-items: stretch; }
    .fa__notes { grid-column: 1 / -1; }
  }

  /* Bandeja del pase = la ventana clara del original (W2N-02): barra con tres puntos grises y la
     dirección, el pase y debajo la fila de quien lo lee. La bandeja de noche la enmarca. */
  .fa__tray {
    position: relative; min-width: 0; display: grid; justify-items: center; align-content: start; gap: 0;
    padding: 0 40px 40px; border-radius: var(--w-r-tray); overflow: hidden;
    background: linear-gradient(180deg, #fbfbf8, #f3f2ec);
    border: 1px solid rgba(14, 14, 13, .08); box-shadow: var(--w-edge), 0 40px 80px -40px rgba(0, 0, 0, .7);
  }
  .fa__app {
    align-self: stretch; justify-self: stretch; display: flex; align-items: center; gap: 14px;
    height: 44px; margin: 0 -40px 48px; padding: 0 18px; border-bottom: 1px solid rgba(14, 14, 13, .07);
    background: #f7f6f2;
  }
  .fa__dots { display: inline-flex; gap: 7px; }
  .fa__dots i { width: 11px; height: 11px; border-radius: 50%; background: #dcd8cf; }
  .fa__url { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font: 400 12px/1 var(--font-mono); color: #6b675f; letter-spacing: .01em; }
  .fa__tray :global(.fa__pase) { width: 100%; max-width: 620px; }
  .fa__tray :global(.w2-pase__ej) { color: #77736b; }
  .fa__tray :global(.w2-pase__leen-k) { color: #6b675f; }
  .fa__tray :global(.fm) { box-shadow: inset 0 0 0 1px rgba(14, 14, 13, .08); }

  .fa__win {
    margin: 0; min-width: 0; background: var(--w-s2); border: 1px solid var(--w-line);
    border-radius: var(--w-r-cell); box-shadow: var(--w-edge);
  }
  .fa__bar {
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    margin: 0; padding: 14px 20px; border-bottom: 1px solid var(--w-line);
  }
  .fa__name { min-width: 0; font: 400 13px/1.3 var(--font-mono); color: var(--w-ink-70); }
  .fa__kind { flex: none; font: 500 12px/1.2 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--w-ink-60); }

  .fa__file { display: flex; flex-direction: column; }
  .fa__body { position: relative; flex: 1; padding: 24px 20px 20px; }
  .fa__code {
    margin: 0; overflow-wrap: anywhere;
    font: 400 13px/1.75 var(--font-mono); color: var(--w-ink-80);
  }
  .fa__ln { display: block; min-height: 1.75em; }
  .fa__ln--li { padding-left: 1.2em; text-indent: -1.2em; }
  .fa__ln--h1 { color: var(--w-ink); font-weight: 500; }
  .fa__ln--q { color: var(--w-accent); }
  .fa__ln--h2 { color: var(--w-accent); margin-top: .6em; }
  .fa__foot {
    margin: 0; padding: 14px 20px; border-top: 1px solid var(--w-line);
    font: 400 14px/1.5 var(--font-body); color: var(--w-ink-70);
  }

  /* Tres notas en columnas con filete (W-CORE-23). */
  .fa__notes { margin: 24px 0 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .fa__note { padding: 20px 28px 4px; border-left: 1px solid var(--w-line); }
  .fa__note:first-child { border-left: 0; padding-left: 0; }
  .fa__note dt { font: 500 12px/1.2 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--w-accent); }
  .fa__note dd { margin: 10px 0 0; font: 400 15px/1.55 var(--font-body); color: var(--w-ink-80); }

  @media (--lt-lg) {
    .fa__notes { grid-template-columns: minmax(0, 1fr); margin-top: 8px; }
    .fa__note { padding: 18px 0; border-left: 0; border-top: 1px solid var(--w-line); }
  }
  @media (--lt-md) {
    .fa { margin-top: 40px; gap: 16px; }
    .fa__tray { padding: 0 14px 24px; }
    .fa__app { margin: 0 -14px 28px; }
    .fa__body { padding: 44px 16px 16px; }
    .fa__bar, .fa__foot { padding-inline: 16px; }
  }
</style>
