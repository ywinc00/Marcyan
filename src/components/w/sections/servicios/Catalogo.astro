---
// Servicios · 02 "Catálogo" (§4.3-3): TarjetasHermanas con los 7 productos (sin currentId)
// dentro de <div id="precios">, con data-track="pricing_card_clicked" en CADA tarjeta
// (contrato de medición de la página de antes: 7 eventos).
// TarjetasHermanas no acepta un data-track por tarjeta (cambio de sistema pedido como
// [SISTEMA] en el informe); mientras tanto el envoltorio recibe el componente por slot,
// renderiza su HTML y añade el atributo a cada <a class="w-sib__card"> en el servidor.
// Es HTML estático: el atributo está en el HTML que lee verify-extra y el rastreo
// delegado de Layout (closest('[data-track]')) lo recoge igual que antes.
interface Props { track: string }
const { track } = Astro.props;
const html = await Astro.slots.render('default');
const tracked = html.replace(/<a(\s[^>]*?)class="w-sib__card/g, `<a$1data-track="${track}" class="w-sib__card`);
---
<div id="precios" class="ws-cat"><Fragment set:html={tracked} /></div>

<style>
  .ws-cat { scroll-margin-top: 96px; }
</style>
