---
// Servicios · objeto de la celda "SEO local" (v2 G09; situación: "¿me encuentran cerca?").
// Recorte de mapa DIBUJADO por nosotros (calles en dos grises, un parque, un río; abstracto,
// sin nombres de calles ni logotipo de Google), ruta curva desde "Tú" hasta el alfiler del
// negocio y, debajo, la ficha: nombre, horario y tres acciones, más la fila "Te encuentran en"
// con los logos nominativos de P06 (dónde te buscan, nunca alianza: §1.4).
// Negocio NEUTRO ("Tu negocio"): la marca tienda ya sale en esta página (reparto §1.6).
// Vida (§1.5, demo con guion): al entrar en vista (35 %) la ruta se dibuja (stroke-dashoffset,
// 900 ms) y el alfiler cae 6 px con rebote corto; queda con micro-vida (el punto "Abierto" late,
// 2 s) y se repite al volver a entrar tras ≥ 8 s fuera. Vida lenta (rev1 de G09, imp. 2): cada
// 6,5 s un punto recorre la ruta y el alfiler salta y suelta un anillo al llegar; pausa global y
// fuera de vista. En el bento llena el alto de la fila (el SVG recorta por los lados). "Tú" y el
// alfiler viven DENTRO del SVG para no despegarse con el recorte. Reducir movimiento: quieto.
// Contrato §1.6: aria-hidden + data-nosnippet + resumen sr-only; acciones como span; sin ids.
// v9 (dueño, 2026-11-08: «las fichas de mapas son iguales, adapta cada una a su contexto; algunas rutas
// se salen de las calles»): cada barrio tiene su propio recorte de calles (Sugar Land con el lago y la
// plaza de Town Square, Katy con la autopista y su vía de servicio, Doral con naves y la pista del
// aeropuerto, Hialeah con su cuadrícula apretada y el canal) y la ruta va SIEMPRE por el eje de las
// calles principales (los mismos puntos que las dibujan). Tú en (84, 238); el alfiler en (340, 94).
import LogoMarca from '../../marcas/LogoMarca.astro';
import { fichaDe, type NegocioId } from '../../objetos/barrios/negociosFicha';

interface Props { lang?: 'es' | 'en'; nombre?: string; negocio?: NegocioId }
const { lang = 'es', nombre, negocio } = Astro.props;
type R = [number, number, number, number];
type Mapa = { agua: string[]; parque: R[]; manzanas: R[]; menores: string[]; mayores: string[]; ruta: string; extra?: string };
const rejilla = (xs: number[], ys: number[], fuera: (x: number, y: number) => boolean = () => false): R[] => {
  const out: R[] = [];
  for (let i = 0; i < xs.length - 1; i++) for (let j = 0; j < ys.length - 1; j++) {
    const x = xs[i] + 10, y = ys[j] + 10, w = xs[i + 1] - xs[i] - 20, h = ys[j + 1] - ys[j] - 20;
    if (w > 8 && h > 8 && !fuera(x + w / 2, y + h / 2)) out.push([x, y, w, h]);
  }
  return out;
};
const MAPAS: Record<string, Mapa> = {
  // Negocio neutro (página de servicios): barrio con río abajo y un parque.
  neutro: {
    agua: ['M-10 282 C 80 264, 150 302, 250 284 S 420 258, 500 272 L 500 330 L -10 330 Z'],
    parque: [[352, 116, 106, 96]],
    manzanas: [[10, 20, 64, 52], [106, 20, 88, 52], [226, 20, 92, 52], [352, 20, 108, 52], [10, 116, 64, 96], [106, 116, 88, 96], [226, 116, 92, 96]],
    menores: ['M90 -10 V 250', 'M335 -10 V 250', 'M-10 166 H 500'],
    mayores: ['M-10 238 H 500', 'M210 -10 V 330', 'M-10 94 H 500'],
    ruta: 'M84 238 H 210 V 94 H 340',
  },
  // Sugar Land: lago de First Colony abajo a la derecha, plaza verde de Town Square y bulevar que rodea el agua.
  clinica: {
    agua: ['M300 330 C 300 268, 352 214, 432 206 C 462 203, 488 208, 500 212 V 330 Z'],
    parque: [[236, 112, 84, 72]],
    manzanas: [[16, 20, 62, 52], [118, 20, 74, 52], [236, 20, 84, 52], [352, 20, 120, 52], [16, 116, 62, 96], [118, 116, 74, 96], [352, 112, 120, 68], [118, 262, 140, 58]],
    menores: ['M210 -10 V 250', 'M336 -10 V 94', 'M290 238 C 312 206, 362 186, 432 184 S 490 190, 500 192', 'M210 184 H 336'],
    mayores: ['M-10 238 H 296', 'M100 -10 V 330', 'M-10 94 H 500'],
    ruta: 'M84 238 H 100 V 94 H 340',
  },
  // Katy: la autopista I-10 arriba, su vía de servicio donde está el taller y el barrio en cuadrícula.
  taller: {
    agua: [],
    parque: [[316, 262, 150, 58]],
    manzanas: [[20, 116, 110, 96], [160, 116, 130, 96], [316, 116, 150, 96], [20, 262, 110, 58], [160, 262, 130, 58]],
    menores: ['M303 94 V 330', 'M-10 300 H 500', 'M60 72 C 100 76, 128 88, 150 94'],
    mayores: ['M-10 238 H 500', 'M145 94 V 330', 'M-10 94 H 500'],
    ruta: 'M84 238 H 145 V 94 H 340',
    extra: 'autopista',
  },
  // Doral: naves alargadas, la pista del aeropuerto arriba y un canal recto a la derecha.
  carga: {
    agua: ['M470 60 H 486 V 330 H 470 Z'],
    parque: [],
    manzanas: [[16, 116, 176, 38], [16, 168, 176, 46], [248, 116, 112, 98], [382, 116, 80, 98], [16, 262, 176, 58], [248, 262, 214, 58]],
    menores: ['M371 94 V 238', 'M-10 160 H 200'],
    mayores: ['M-10 238 H 470', 'M220 64 V 330', 'M-10 94 H 470'],
    ruta: 'M84 238 H 220 V 94 H 340',
    extra: 'pista',
  },
  // Hialeah: cuadrícula apretada de manzanas pequeñas, Palm Ave en vertical y el canal en diagonal.
  cafe: {
    agua: ['M300 340 L 500 168 L 500 196 L 336 340 Z'],
    parque: [[150, 166, 60, 72]],
    manzanas: rejilla([-20, 30, 90, 150, 210, 270, 330, 390, 450, 510], [-26, 34, 94, 166, 238, 300, 360], (x, y) => (x > 150 && x < 210 && y > 166 && y < 238) || y + 0.86 * x > 560),
    menores: ['M30 -10 V 330', 'M90 -10 V 330', 'M150 -10 V 330', 'M210 -10 V 330', 'M330 -10 V 330', 'M390 -10 V 330', 'M450 -10 V 330', 'M-10 34 H 500', 'M-10 166 H 500', 'M-10 300 H 500'],
    mayores: ['M-10 238 H 500', 'M270 -10 V 330', 'M-10 94 H 500'],
    ruta: 'M84 238 H 270 V 94 H 340',
  },
};
const M = MAPAS[negocio && MAPAS[negocio] ? negocio : 'neutro'];
const F = negocio ? fichaDe(negocio, lang) : null;
const acento = F?.acc ?? '#1E1C19';
const cierra = negocio === 'cafe' ? (lang === 'en' ? 'closes 8 PM' : 'cierra 8 p. m.') : null;
const en = lang === 'en';
const T = en
  ? { sr: 'Example: someone nearby finds your business on the map and gets directions.', you: 'You', name: 'Your business', cat: 'Open', close: 'closes 6 PM', a1: 'Directions', a2: 'Call', a3: 'Website', found: 'Found on' }
  : { sr: 'Ejemplo: alguien cerca encuentra tu negocio en el mapa y pide cómo llegar.', you: 'Tú', name: 'Tu negocio', cat: 'Abierto', close: 'cierra 6 p. m.', a1: 'Cómo llegar', a2: 'Llamar', a3: 'Sitio web', found: 'Te encuentran en' };
---
<div class="oml-wrap">
  <p class="sr-only">{T.sr}</p>
  <div class="oml" aria-hidden="true" data-nosnippet data-w2-mapa>
    <div class="oml__map">
      <svg class="oml__svg" viewBox="0 0 480 320" preserveAspectRatio="xMidYMid slice">
        <rect width="480" height="320" fill="#EAE6DD" />
        {M.agua.map((d) => <path d={d} fill="#C9D9DE" />)}
        {M.extra === 'autopista' && (<Fragment><path d="M-10 46 H 500" stroke="#D2CBBE" stroke-width="36" /><path d="M-10 46 H 500" stroke="#FBF7EE" stroke-width="30" /><path d="M-10 46 H 500" stroke="#D9D3C7" stroke-width="1.6" stroke-dasharray="10 9" /></Fragment>)}
        {M.extra === 'pista' && (<Fragment><path d="M200 44 H 500" stroke="#D8D3C8" stroke-width="26" /><path d="M214 44 H 500" stroke="#FFFFFF" stroke-width="1.8" stroke-dasharray="16 10" /></Fragment>)}
        <g fill="#E1DCD0">{M.manzanas.map(([x, y, w, h]) => <rect x={x} y={y} width={w} height={h} rx="4" />)}</g>
        {M.parque.map(([x, y, w, h]) => <rect x={x} y={y} width={w} height={h} rx="10" fill="#D3DEC6" />)}
        <g fill="none" stroke="#D9D3C7" stroke-width="7" stroke-linecap="round">{M.menores.map((d) => <path d={d} />)}</g>
        <g fill="none" stroke="#D9D3C7" stroke-width="15" stroke-linecap="round" stroke-linejoin="round">{M.mayores.map((d) => <path d={d} />)}</g>
        <g fill="none" stroke="#FFFFFF" stroke-width="12" stroke-linecap="round" stroke-linejoin="round">{M.mayores.map((d) => <path d={d} />)}</g>
        <path class="oml__route" pathLength="1" d={M.ruta} stroke-linejoin="round" fill="none" stroke={acento} stroke-width="4" stroke-linecap="round" />
        <path class="oml__go oml__go--o" pathLength="1" d={M.ruta} stroke-linejoin="round" fill="none" stroke={acento} stroke-width="12" stroke-linecap="round" stroke-dasharray="0.0001 2" />
        <path class="oml__go oml__go--i" pathLength="1" d={M.ruta} stroke-linejoin="round" fill="none" stroke="#FFFFFF" stroke-width="6" stroke-linecap="round" stroke-dasharray="0.0001 2" />
        <circle cx="84" cy="238" r="7" fill="#FFFFFF" stroke="#1E1C19" stroke-width="2.4" />
        <circle cx="84" cy="238" r="2.6" fill="#1E1C19" />
        <g transform="translate(98 238)">
          <rect x="0" y="-13" width="36" height="26" rx="13" fill="#FFFFFF" />
          <text x="18" y="4.6" text-anchor="middle" class="oml__you">{T.you}</text>
        </g>
        <circle class="oml__ring" cx="340" cy="94" r="12" fill="none" stroke={acento} stroke-width="2" />
        <g transform="translate(326 59)">
          <g class="oml__hop">
            <g class="oml__pin">
              <path d="M14 35c-1-2.6-11.5-12.3-11.5-20.6A11.5 11.5 0 0 1 25.5 14.4C25.5 22.7 15 32.4 14 35Z" fill={acento} />
              <circle cx="14" cy="14" r="4.4" fill="#F4F1EA" />
            </g>
          </g>
        </g>
      </svg>
    </div>
    <div class="oml__card">
      <div class="oml__head">
        <span class="oml__name">{F?.nombre ?? nombre ?? T.name}</span>
        <span class="oml__open"><span class="oml__dot"></span><b>{T.cat}</b> · {cierra ?? T.close}</span>
      </div>
      <div class="oml__acts">
        <span class="oml__act oml__act--fill">
          <svg viewBox="0 0 16 16" width="14" height="14"><path d="M2.5 7.6 13.4 2.6 8.4 13.5 7.3 8.7Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /></svg>{T.a1}
        </span>
        <span class="oml__act">
          <svg viewBox="0 0 16 16" width="14" height="14"><path d="M5.6 2.5 3.4 2.9c-.6.1-1 .7-.9 1.3.8 4.5 4.3 8 8.8 8.8.6.1 1.2-.3 1.3-.9l.4-2.2-2.7-1.3-1.3 1.3a7 7 0 0 1-3-3l1.3-1.3Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /></svg>{T.a2}
        </span>
        <span class="oml__act">
          <svg viewBox="0 0 16 16" width="14" height="14"><circle cx="8" cy="8" r="5.6" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="M2.6 8h10.8M8 2.4c1.6 1.6 2.3 3.4 2.3 5.6S9.6 12 8 13.6M8 2.4C6.4 4 5.7 5.8 5.7 8s.7 4 2.3 5.6" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>{T.a3}
        </span>
      </div>
      <div class="oml__found">
        <span class="oml__k">{T.found}</span>
        <span class="oml__logos">
          <LogoMarca id="google" size={16} tono="color" titulo="" siBloqueada="palabra" />
          <LogoMarca id="googlemaps" size={16} tono="color" titulo="" siBloqueada="palabra" />
          <LogoMarca id="applemaps-texto" size={16} tono="color" titulo="" />
          <LogoMarca id="bing-texto" size={16} tono="color" titulo="" />
        </span>
      </div>
    </div>
  </div>
</div>

<script>
  // Guion de entrada (demo con guion §1.5): una vez al entrar al 35 %, repite tras ≥ 8 s fuera.
  const mq = window.matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLElement>('[data-w2-mapa]').forEach((el) => {
    if (mq.matches) { el.classList.add('is-done'); return; }
    el.classList.add('is-armed');
    let leftAt = 0;
    let played = false;
    const io = new IntersectionObserver((ents) => {
      for (const e of ents) {
        if (e.isIntersecting && e.intersectionRatio >= 0.35) {
          el.classList.add('is-live');
          if (!played || (leftAt && performance.now() - leftAt >= 8000)) {
            played = true;
            el.classList.remove('is-play', 'is-done');
            void el.offsetWidth;
            el.classList.add('is-play');
          }
          leftAt = 0;
        } else if (!e.isIntersecting) {
          el.classList.remove('is-live');
          if (!leftAt) leftAt = performance.now();
        }
      }
    }, { threshold: [0, 0.35] });
    io.observe(el);
  });
</script>

<style>
  .oml-wrap { width: 100%; min-width: 0; height: 100%; }
  .oml {
    --ink: #1E1C19; --ink2: #5E5A53; --paper: #F7F5F0; --line: #E2DED5;
    width: 100%; height: 100%; display: flex; flex-direction: column;
    border-radius: 14px; overflow: hidden; background: var(--paper);
    color: var(--ink); font-family: var(--font-body); text-align: left;
  }
  /* El mapa llena el alto que deja la celda vecina (bandeja "fill" del bento): crece en alto y
     el SVG recorta por los lados (slice); lo importante vive en el centro del lienzo. */
  .oml__map { position: relative; flex: 1 1 auto; min-height: 0; aspect-ratio: 480 / 260; }
  .oml__svg { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .oml__route { stroke-dasharray: 1; stroke-dashoffset: 0; }
  .oml__you { font: 600 13px/1 var(--font-body); fill: #1E1C19; }
  .oml__pin { filter: drop-shadow(0 3px 3px rgba(30,28,25,.22)); }
  .oml__go, .oml__ring { opacity: 0; }
  .oml__ring { transform-box: fill-box; transform-origin: center; }
  .oml__card { padding: 16px 18px 18px; }
  .oml__head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 4px 12px; }
  .oml__name { font: 600 17px/1.2 var(--font-display); letter-spacing: -0.01em; }
  .oml__open { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; line-height: 1.3; color: var(--ink2); }
  .oml__open b { font-weight: 600; color: #2F6B45; }
  .oml__dot { position: relative; width: 7px; height: 7px; border-radius: 50%; background: #2F8A55; flex: none; }
  .oml__dot::after { content: ''; position: absolute; inset: 0; border-radius: 50%; background: #2F8A55; opacity: 0; }
  .oml__acts { display: flex; gap: 8px; margin-top: 14px; flex-wrap: wrap; }
  .oml__act {
    display: inline-flex; align-items: center; gap: 6px; height: 34px; padding: 0 13px;
    border-radius: 999px; border: 1px solid #CFCAC0; font: 500 13px/1 var(--font-body); color: var(--ink); white-space: nowrap;
  }
  .oml__act--fill { background: var(--ink); border-color: var(--ink); color: #F7F5F0; }
  .oml__found { display: flex; align-items: center; justify-content: space-between; gap: 10px 14px; flex-wrap: wrap; margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--line); }
  .oml__k { font: 500 11px/1.2 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--ink2); }
  .oml__logos { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; min-width: 0; color: var(--ink); --marca-tinta: var(--ink); }

  /* Armado por JS antes de entrar: sin JS o con reducir movimiento se ve el estado final. */
  .oml.is-armed:not(.is-play) .oml__route { stroke-dashoffset: 1; }
  .oml.is-armed:not(.is-play) .oml__pin { opacity: 0; }
  /* Guion: la ruta se dibuja y el alfiler cae con rebote corto. */
  .oml.is-play .oml__route { animation: oml-route 900ms cubic-bezier(.6,0,.2,1) both; }
  .oml.is-play .oml__pin { animation: oml-pin 520ms 760ms cubic-bezier(.3,1.5,.5,1) both; }
  @keyframes oml-route { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes oml-pin { from { transform: translateY(-6px); opacity: 0; } to { transform: none; opacity: 1; } }
  /* Vida lenta (rev1, imp. 2): cada 7 s alguien recorre la ruta hasta tu puerta; al llegar,
     el alfiler da un salto corto y suelta un anillo. Pausa 45 % del ciclo, nada continuo. */
  .oml.is-live .oml__go { animation: oml-go 7s cubic-bezier(.45,0,.35,1) 1.4s infinite; }
  .oml.is-live .oml__ring { animation: oml-ring 7s ease-out 1.4s infinite; }
  .oml.is-live .oml__hop { animation: oml-hop 7s ease-out 1.4s infinite; }
  @keyframes oml-go { 0% { stroke-dashoffset: 0; opacity: 0; } 5% { opacity: 1; } 58% { stroke-dashoffset: -1; opacity: 1; } 64%, 100% { stroke-dashoffset: -1; opacity: 0; } }
  @keyframes oml-ring { 0%, 57% { opacity: 0; transform: scale(.7); } 61% { opacity: .55; } 82%, 100% { opacity: 0; transform: scale(2.2); } }
  @keyframes oml-hop { 0%, 57% { transform: none; } 61% { transform: translateY(-5px); } 66%, 100% { transform: none; } }
  /* Micro-vida mientras está a la vista: el punto "Abierto" late (2 s). */
  .oml.is-live .oml__dot::after { animation: oml-pulse 2s ease-out infinite; }
  @keyframes oml-pulse { 0% { transform: scale(1); opacity: .55; } 100% { transform: scale(2.6); opacity: 0; } }
  :global(html[data-w-pausa]) .oml :is(.oml__dot, .oml__go, .oml__ring, .oml__hop),
  :global(html[data-w-pausa]) .oml .oml__dot::after { animation-play-state: paused; }
  @media (prefers-reduced-motion: reduce) {
    .oml .oml__route, .oml .oml__pin, .oml .oml__dot::after, .oml .oml__go, .oml .oml__ring, .oml .oml__hop { animation: none !important; }
  }
  @media (max-width: 400px) { .oml__card { padding: 14px; } .oml__act { padding: 0 10px; } }
  /* Estrecho: el mapa sube de alto y recorta por los lados para que "Tú" y el alfiler no encojan. */
  @media (max-width: 600px) { .oml__map { aspect-ratio: 10 / 9; } }
</style>
