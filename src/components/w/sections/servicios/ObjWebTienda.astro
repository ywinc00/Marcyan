---
// Servicios · objeto de la celda "Diseño web" (v2 G09; situación: "¿se entiende en el celular?").
// La web de la marca de ejemplo `tienda` (velas y café; negocios.ts: nombre, paleta y logotipo
// en trazos de P02a) en un móvil: nav con logotipo y bolsa, titular grande de una frase, acción
// principal, escaparate de 3 productos como VOLÚMENES (Producto.astro, sin precios: §1.6) y la
// barra fija inferior "Llamar · Escribir", que es lo que promete la celda ("un botón claro para
// llamarte o escribirte"). WebEjemplo (P02a) pinta para la tienda solo titular y acción hasta que
// llegue P02b; por eso esta composición propia (apuntado en el informe para sustituirla entonces).
// Vida lenta (rev1 de G09): cada 5,5 s se añade un producto (baldosa, bolsa que suma y aviso).
// Micro-vida (§1.5): la acción "Llamar" de la barra emite un anillo suave cada 4 s mientras está a
// la vista (transform/opacity), y obedece la pausa global. Reducir movimiento: quieta.
// Contrato §1.6: aria-hidden + data-nosnippet + resumen sr-only; acciones como span; sin ids.
import LogoEjemplo from '../../objetos/ejemplos/LogoEjemplo.astro';
import Producto from './Producto.astro';
import { negocios } from '../../objetos/ejemplos/negocios';

interface Props { lang?: 'es' | 'en' }
const { lang = 'es' } = Astro.props;
const en = lang === 'en';
const n = negocios.tienda;
const p = n.paleta;
const tx = n.textos[lang];
const T = en
  ? { sr: 'Example: a small shop’s website on a phone, with its products and buttons to call or message.', nav: ['Shop', 'Coffee', 'About'], prods: ['Cedar candle', 'Veracruz coffee', 'Gift box'], call: 'Call', write: 'Message', shelf: 'New this week', added: 'Added to your bag' }
  : { sr: 'Ejemplo: la web de una tienda pequeña en el celular, con sus productos y botones para llamar o escribir.', nav: ['Tienda', 'Café', 'Nosotros'], prods: ['Vela de cedro', 'Café de Veracruz', 'Caja de regalo'], call: 'Llamar', write: 'Escribir', shelf: 'Nuevo esta semana', added: 'Añadido a tu bolsa' };
const style = `--t-bg:${p.bg};--t-ink:${p.ink};--t-ink2:${p.ink2};--t-acc:${p.accent};--t-on:${p.onAccent};--ej-ink:${p.ink};--ej-accent:${p.accent}`;
const prods = ['vela', 'cafe', 'caja'] as const;
---
<div class="owt-wrap">
  <p class="sr-only">{T.sr}</p>
  <div class="owt" style={style} aria-hidden="true" data-nosnippet data-w2-webtienda>
    <div class="owt__phone">
      <span class="owt__island"></span>
      <div class="owt__screen">
        <span class="owt__toast"><svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m3.5 8.4 2.8 2.8 6.2-6.4" /></svg>{T.added}</span>
        <div class="owt__bar"><span>9:41</span><span class="owt__sig"><i></i><i></i><i></i></span></div>
        <div class="owt__nav">
          <LogoEjemplo marca="tienda" size={12} lang={lang} />
          <span class="owt__bag"><svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="M4.5 7h11l-1 10h-9Z" /><path d="M7.5 7V5.8a2.5 2.5 0 0 1 5 0V7" /></svg><b data-w2-bolsa>2</b></span>
        </div>
        <div class="owt__hero">
          <p class="owt__tit">{tx.titular}</p>
          <span class="owt__cta">{tx.accion}<svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M3.5 8h9M9 4.5 12.5 8 9 11.5" /></svg></span>
        </div>
        <p class="owt__shelf">{T.shelf}</p>
        <div class="owt__prods">
          {prods.map((pr, i) => (
            <span class="owt__prod">
              <span class="owt__tile"><Producto prod={pr} size={64} baldosa={false} /></span>
              <span class="owt__pn">{T.prods[i]}</span>
            </span>
          ))}
        </div>
        <div class="owt__dock">
          <span class="owt__act owt__act--call"><svg viewBox="0 0 16 16" width="14" height="14"><path d="M5.6 2.5 3.4 2.9c-.6.1-1 .7-.9 1.3.8 4.5 4.3 8 8.8 8.8.6.1 1.2-.3 1.3-.9l.4-2.2-2.7-1.3-1.3 1.3a7 7 0 0 1-3-3l1.3-1.3Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /></svg>{T.call}<i class="owt__ring"></i></span>
          <span class="owt__act"><svg viewBox="0 0 16 16" width="14" height="14"><path d="M2.8 3.8h10.4v6.6H7.4l-3 2.4v-2.4H2.8Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /></svg>{T.write}</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Vida lenta (rev1 de G09, imp. 2): cada 5,5 s alguien añade un producto del escaparate; la
  // baldosa se hunde, la bolsa suma y baja el aviso "Añadido a tu bolsa" (1,9 s). Solo a la vista,
  // con la pestaña visible y sin pausa global (html[data-w-pausa]); quieta con reducir movimiento.
  const mq = window.matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLElement>('[data-w2-webtienda]').forEach((el) => {
    if (mq.matches) return;
    const tiles = Array.from(el.querySelectorAll<HTMLElement>('.owt__prod'));
    const bag = el.querySelector<HTMLElement>('[data-w2-bolsa]');
    let visible = false, timer = 0, n = 0, count = 2;
    const paused = () => document.documentElement.hasAttribute('data-w-pausa');
    const live = () => visible && !document.hidden && !paused();
    const tick = () => {
      timer = window.setTimeout(tick, 5500);
      if (!live()) return;
      const t = tiles[n % tiles.length]; n++;
      t.classList.add('is-pick');
      window.setTimeout(() => {
        t.classList.remove('is-pick');
        count = count >= 4 ? 2 : count + 1;
        if (bag) bag.textContent = String(count);
        el.classList.add('is-added');
        window.setTimeout(() => el.classList.remove('is-added'), 1900);
      }, 420);
    };
    const sync = () => el.classList.toggle('is-live', live());
    const io = new IntersectionObserver((ents) => {
      for (const e of ents) visible = e.isIntersecting;
      sync();
      if (visible && !timer) timer = window.setTimeout(tick, 1600);
    }, { rootMargin: '100px' });
    io.observe(el);
    document.addEventListener('visibilitychange', sync);
    document.addEventListener('w:pausa', sync);
  });
</script>

<style>
  .owt-wrap { width: 100%; display: flex; justify-content: center; }
  .owt { width: min(100%, 300px); }
  .owt__phone { position: relative; border-radius: 34px; padding: 8px; background: #0B0B0A; box-shadow: inset 0 0 0 1px rgba(240,237,232,.12), 0 24px 48px -24px rgba(0,0,0,.8); }
  .owt__island { position: absolute; left: 50%; top: 18px; width: 64px; height: 18px; border-radius: 10px; background: #0B0B0A; transform: translateX(-50%); z-index: 2; }
  .owt__screen { position: relative; overflow: hidden; border-radius: 27px; background: var(--t-bg); color: var(--t-ink); font-family: var(--font-body); text-align: left; padding: 0 18px 84px; }
  .owt__bar { display: flex; justify-content: space-between; align-items: center; height: 44px; padding: 0 6px; font: 600 12px/1 var(--font-body); }
  .owt__sig { display: inline-flex; align-items: flex-end; gap: 2px; }
  .owt__sig i { width: 3px; background: var(--t-ink); border-radius: 1px; }
  .owt__sig i:nth-child(1) { height: 5px; } .owt__sig i:nth-child(2) { height: 7px; } .owt__sig i:nth-child(3) { height: 9px; }
  .owt__nav { display: flex; align-items: center; justify-content: space-between; height: 40px; color: var(--t-ink); }
  .owt__bag { position: relative; display: inline-flex; color: var(--t-ink); }
  .owt__bag b { position: absolute; right: -6px; top: -4px; min-width: 15px; height: 15px; border-radius: 8px; background: var(--t-acc); color: var(--t-on); font: 600 9.5px/15px var(--font-body); text-align: center; }
  .owt__hero { padding-top: 22px; }
  .owt__tit { margin: 0; font: 500 31px/1.04 var(--font-display); letter-spacing: -0.035em; color: var(--t-ink); max-width: 9ch; }
  .owt__cta { display: inline-flex; align-items: center; gap: 8px; margin-top: 18px; height: 40px; padding: 0 16px; border-radius: 10px; background: var(--t-acc); color: var(--t-on); font: 500 13px/1 var(--font-body); }
  .owt__shelf { margin: 30px 0 10px; font: 500 11px/1.2 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--t-ink2); }
  .owt__prods { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
  .owt__prod { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .owt__tile { transition: transform 260ms cubic-bezier(.3,.7,.3,1), box-shadow 260ms ease; }
  .owt__prod.is-pick .owt__tile { transform: scale(.94); box-shadow: inset 0 0 0 1.5px var(--t-ink); }
  .owt__bag b { transition: transform 240ms cubic-bezier(.3,1.6,.5,1); }
  .owt.is-added .owt__bag b { transform: scale(1.25); }
  .owt__toast {
    position: absolute; z-index: 3; right: 12px; top: 90px; display: flex; align-items: center; gap: 8px;
    height: 36px; padding: 0 12px; border-radius: 12px; background: var(--t-ink); color: #F8F5EE;
    font: 500 12.5px/1 var(--font-body); box-shadow: 0 8px 20px -10px rgba(42,33,27,.6);
    opacity: 0; transform: translateY(-10px); transition: opacity 260ms ease, transform 320ms cubic-bezier(.2,.8,.2,1); pointer-events: none;
  }
  .owt.is-added .owt__toast { opacity: 1; transform: none; }
  .owt__tile { display: grid; place-items: center; aspect-ratio: 1 / 1.12; border-radius: 10px; background: #F3ECDF; }
  .owt__pn { font-size: 11.5px; line-height: 1.25; color: var(--t-ink); }
  .owt__dock {
    position: absolute; left: 10px; right: 10px; bottom: 12px; display: grid; grid-template-columns: 1fr 1fr; gap: 8px;
    padding: 8px; border-radius: 16px; background: rgba(248,245,238,.96); box-shadow: 0 6px 18px -8px rgba(42,33,27,.35), inset 0 0 0 1px rgba(42,33,27,.08);
  }
  .owt__act { position: relative; display: inline-flex; align-items: center; justify-content: center; gap: 7px; height: 40px; border-radius: 10px; border: 1px solid rgba(42,33,27,.2); font: 500 13px/1 var(--font-body); color: var(--t-ink); }
  .owt__act--call { background: var(--t-ink); border-color: var(--t-ink); color: #F8F5EE; }
  .owt__ring { position: absolute; inset: -1px; border-radius: 10px; border: 1.5px solid var(--t-ink); opacity: 0; pointer-events: none; }
  .owt.is-live .owt__ring { animation: owt-ring 4s cubic-bezier(.2,.6,.3,1) infinite; }
  :global(html[data-w-pausa]) .owt .owt__ring { animation-play-state: paused; }
  @keyframes owt-ring { 0%, 70% { opacity: 0; transform: scale(1); } 74% { opacity: .5; } 100% { opacity: 0; transform: scale(1.18, 1.5); } }
  @media (prefers-reduced-motion: reduce) { .owt .owt__ring { animation: none !important; } .owt__toast, .owt__tile, .owt__bag b { transition: none; } }
</style>
