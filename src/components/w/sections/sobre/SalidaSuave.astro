---
// Sobre nosotros · 9 "Salida suave" (design/rediseno-workos.md §4.6-9, W-PROOF-21).
// Dos tarjetas bajas (~580×100) antes del cierre: icono-objeto + título + una línea, y la
// acción a la derecha. "Mira el portafolio" enlaza; "Habla con Marcy" dispara mrc:ask con
// un texto FIJO de la página (sin datos del visitante), igual que CierreDosTarjetas.
import Button from '../../../ui/Button.astro';
import IconoObjeto from '../../IconoObjeto.astro';
import Icon from '../../../ui/Icon.astro';

interface Props {
  portafolio: { title: string; text: string; cta: string; href: string };
  marcy: { title: string; text: string; cta: string; ask: string };
}
const { portafolio, marcy } = Astro.props;
---
<div class="wss">
  <article class="wss__card">
    <span class="wss__ico wss__ico--box" aria-hidden="true"><Icon name="lucide:folder" /></span>
    <div class="wss__body">
      <h3 class="wss__title">{portafolio.title}</h3>
      <p class="wss__text">{portafolio.text}</p>
    </div>
    <Button variant="link" href={portafolio.href} class="wss__act">{portafolio.cta}</Button>
  </article>
  <article class="wss__card">
    <span class="wss__ico wss__ico--obj" aria-hidden="true"><IconoObjeto id="ia-conversacional" size={40} tone="gold" /></span>
    <div class="wss__body">
      <h3 class="wss__title">{marcy.title}</h3>
      <p class="wss__text">{marcy.text}</p>
    </div>
    <Button variant="link" class="wss__act" data-wss-ask={marcy.ask} data-track="marcy_ask_clicked">{marcy.cta}</Button>
  </article>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-wss-ask]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const text = btn.dataset.wssAsk || '';
      if (text) window.dispatchEvent(new CustomEvent('mrc:ask', { detail: { text } }));
    });
  });
</script>

<style>
  .wss { display: grid; grid-template-columns: 1fr; gap: 18px; max-width: var(--w-rail-max); margin-inline: auto; min-width: 0; }
  .wss__card {
    display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 4px 16px; align-items: center;
    min-width: 0; padding: 20px 24px;
    background: var(--w-s2); border: 1px solid var(--w-line); border-radius: var(--w-r-obj); box-shadow: var(--w-edge);
  }
  .wss__ico { width: 40px; height: 40px; display: grid; place-items: center; color: var(--w-accent); align-self: start; }
  .wss__ico--box { border-radius: 10px; border: 1px solid var(--w-line-strong); background: rgba(var(--accent-gold-rgb), .08); box-shadow: var(--w-edge); }
  .wss__ico--box :global(svg) { width: 20px; height: 20px; }
  .wss__ico--obj :global(svg) { width: 40px; height: 40px; }
  .wss__title { margin: 0; font: 500 17px/1.3 var(--font-display); color: var(--w-ink); }
  .wss__text { margin: 4px 0 0; font: 400 15px/1.5 var(--font-body); color: var(--w-ink-70); }
  .wss__card :global(.wss__act) { grid-column: 2; justify-self: start; }
  @media (--md) {
    .wss { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (--lg) {
    .wss__card { grid-template-columns: auto minmax(0, 1fr) auto; min-height: 100px; }
    .wss__card :global(.wss__act) { grid-column: 3; grid-row: 1; justify-self: end; white-space: nowrap; }
    .wss__ico { align-self: center; }
  }
</style>
