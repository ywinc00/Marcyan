---
// Sobre nosotros · 04 "Dónde estamos" (#ciudades, design/rediseno-workos.md §4.6-5).
// Rev1: las dos sedes en dos columnas, cada una en su bandeja opaca con la silueta REAL de
// la ciudad (los mismos SVG de /assets/cities que usaba el antes, mezcla "lighten") y su
// SedesAcordeon de una fila (NAP real, call_clicked, <details> CERRADO al cargar, E-23).
// SedesAcordeon no se toca: se le pasa un solo item por bandeja.
import CabeceraNumerada from '../../CabeceraNumerada.astro';
import SedesAcordeon from '../../SedesAcordeon.astro';

interface Item { city: string; state?: string; area: string; tel: string; illo?: string; links?: { label: string; href: string; sub?: string }[] }
interface Props {
  n: number;
  label: string;
  titleHtml: string;
  lead: string;
  items: Item[];
  more: string;
  callLabel: string;
}
const { n, label, titleHtml, lead, items, more, callLabel } = Astro.props;
const size = (k?: string) => (k === 'miami' ? { w: 322, h: 235 } : { w: 276, h: 249 });
---
<CabeceraNumerada n={n} label={label} titleHtml={titleHtml} lead={lead} />
<div class="wsd">
  {items.map((it) => (
    <article class="wsd__card w-tray w-tray--opaque">
      {it.illo && (
        <div class="wsd__illo" aria-hidden="true">
          <img src={`/assets/cities/${it.illo}.svg`} alt="" width={size(it.illo).w} height={size(it.illo).h} loading="lazy" decoding="async" />
        </div>
      )}
      <SedesAcordeon items={[it]} more={more} callLabel={callLabel} class="wsd__sede" />
    </article>
  ))}
</div>

<style>
  .wsd { display: grid; grid-template-columns: minmax(0, 1fr); gap: 20px; margin-top: 40px; min-width: 0; }
  .wsd__card { position: relative; overflow: hidden; min-width: 0; padding: 24px 24px 8px; }
  .wsd__illo { display: flex; justify-content: flex-end; height: 150px; margin-bottom: 8px; }
  .wsd__illo img { height: 100%; width: auto; display: block; mix-blend-mode: lighten; }
  .wsd__card :global(.wsd__sede .sedes__row) { border-top: 0; }
  .wsd__card :global(.wsd__sede .sedes__row:last-child) { border-bottom: 0; }
  /* En bandeja de media anchura: "Ver detalles" bajo el teléfono (no a la derecha de la fila,
     que a esta anchura aplastaría la ciudad) y enlaces en una o dos columnas. */
  .wsd__card :global(.wsd__sede .sedes__main) { padding-right: 0; }
  .wsd__card :global(.wsd__sede .sedes__sum) { position: static; min-block-size: 44px; }
  .wsd__card :global(.wsd__sede .sedes__more) { margin-top: 4px; }
  .wsd__card :global(.wsd__sede .sedes__more[open] .sedes__links) { margin-top: 12px; }
  .wsd__card :global(.wsd__sede .sedes__links) { grid-template-columns: minmax(0, 1fr); }
  @media (--lg) {
    .wsd__card :global(.wsd__sede .sedes__links) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (--md) {
    .wsd { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; margin-top: var(--w-chapter-gap); }
    .wsd__card { padding: 32px 32px 12px; }
    .wsd__illo { height: 190px; }
  }
</style>
