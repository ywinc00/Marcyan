---
// Diseño web · capítulo de contraste (§4.14-6): CapituloDosFrases + Bento2x2
// (W-CORE-08 + B-03) con un objeto por celda. Página oro: Marcy en burbujas neutras (E-14).
// Celda 1: contacto entrante con "Guardado ✓" (MiniPasos kind="contacto"; sistema tras el
// piloto). Celda 2: la web en el OTRO idioma (en inglés en la página en español), con la marca
// de ejemplo SIN traducir (E-24). Celda 4: la conversación de las 23:40, la que cuenta el
// titular (control 2 ronda 2). Móvil: llevan objeto la 1 y la 4 (el chat de Marcy es la celda
// que más vende); la 2 y la 3 (ficha) quedan en texto (E-18, control 2 piloto r3).
import CapituloDosFrases from '../../CapituloDosFrases.astro';
import Bento2x2 from '../../Bento2x2.astro';
import MiniPasos from '../../objetos/MiniPasos.astro';
import WebEjemplo from '../../objetos/WebEjemplo.astro';
import FichaMapaEjemplo from '../../objetos/FichaMapaEjemplo.astro';
import ChatMarcy from '../../objetos/ChatMarcy.astro';
import type { WebCopy } from '../../../../i18n/w/web';

interface Props { copy: WebCopy['bento']; city: string; lang?: 'es' | 'en' }
const { copy, city, lang = 'es' } = Astro.props;
const sr = lang === 'en'
  ? 'Example: at 11:40 p.m. a customer asks if you are open and Marcy holds the first visit for the next morning.'
  : 'Ejemplo: a las 23:40 un cliente pregunta si siguen abiertos y Marcy le aparta la primera visita de la mañana.';
---
<CapituloDosFrases tone1={copy.tone1} tone2={copy.tone2} sub={copy.sub} />
<div class="ws-gap">
  <Bento2x2 cells={copy.cells} mobileTextOnly={[2, 3]}>
    <MiniPasos slot="ui-1" kind="contacto" fill lang={lang} />
    <WebEjemplo slot="ui-2" frame="movil" kind="salon" city={city} lang={lang} site={lang === 'en' ? 'es' : 'en'} size="mini" />
    <FichaMapaEjemplo slot="ui-3" city={city} lang={lang} size="card" />
    <ChatMarcy slot="ui-4" mode="estatico" tone="neutral" lang={lang} size="card" startAt={2} sr={sr} />
  </Bento2x2>
</div>
<style>
  .ws-gap { margin-top: var(--w-chapter-gap); }
  @media (--lt-md) { .ws-gap { margin-top: 48px; } }
</style>
