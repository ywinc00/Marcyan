---
// ─────────────────────────────────────────────────────────────
// Layout base de Marcyan — design system v2 "Space-Tech".
// Auto-hospeda las 3 fuentes (Fontsource, sin Google CDN), carga los
// tokens/reset globales y arma <head> SEO/i18n (hreflang es/en/x-default).
// Todas las páginas del sitio nuevo deben extender de aquí.
// ─────────────────────────────────────────────────────────────
// Las 3 fuentes, solo con los subconjuntos que usa el sitio (styles/fonts.css: mismos woff2 de Fontsource).
import '../styles/fonts.css';
import '../styles/global.css';
import { nap } from '../i18n/content';
import { mirrorPath } from '../i18n/routes';
import ChatWidget from '../components/ChatWidget.astro';
import LangNotice from '../components/layout/LangNotice.astro';

interface Props {
  title: string;
  description?: string;
  lang?: 'es' | 'en';
  /** Ruta SIN prefijo de idioma, p.ej. "/" o "/servicios". Construye canonical + hreflang. */
  path?: string;
  canonical?: string;
  noindex?: boolean;
  ogImage?: string;
  /** Si la página tiene espejo en el otro idioma. false → no emitir hreflang en
   *  (las landings de cluster son solo-ES hasta la Ola 3; apuntar a /en/ daría 404). */
  hasEn?: boolean;
  /** Sistema de diseño del rediseño WorkOS (design/rediseno-workos.md §2.13, Cerrojo 1).
   *  'v3' escribe <html data-ds="v3"> y el script de la coreografía. Portada y hubs NO lo pasan. */
  ds?: 'v3';
}

const SITE = 'https://marcyanstudio.com';
const {
  title,
  description = 'Marcyan Studio — diseño web, IA y SEO para PYMEs en Houston y Miami.',
  lang = 'es',
  path = '/',
  canonical,
  noindex = false,
  ogImage = '/assets/og/og-default.png',
  hasEn,
  ds,
} = Astro.props;

// hreflang/canonical derivados de la RUTA REAL (Astro.url.pathname) + el mapa
// routes.ts. Esto maneja slugs asimétricos (servicios→services, precios→pricing,
// privacidad→privacy) y páginas sin prefijo de idioma, sin reconstruir /lang+path
// (que producía enHref = /en/{slug-ES} → 404 en pares asimétricos).
const normPath = (p: string) => {
  const s = (p || '/').replace(/\/+$/, '');
  return s === '' ? '/' : s;
};
const selfPath = normPath(Astro.url.pathname);
const otherPath = mirrorPath(selfPath, lang); // ruta del espejo en el otro idioma (o null)
// SIN barra final: Vercel (`cleanUrls` + `trailingSlash:false`) sirve /es con
// 200 y redirige /es/ con 308 — el canonical debe ser la URL que responde 200.
const abs = (p: string) => (p === '/' ? `${SITE}/` : `${SITE}${p}`);
// canonical: respeta el explícito (legales); si no, absoluto de la ruta real.
const canon = canonical ?? abs(selfPath);
// URLs por idioma para los <link rel=alternate>. La versión propia = canon;
// la otra sale del mapa (null si aún no hay espejo publicado).
// EN sin espejo ES: sin alternate es y x-default = la propia página; hasEn={false}
// (kit) conserva el comportamiento anterior.
const enOnly = lang === 'en' && otherPath == null && hasEn !== false;
const esHref = lang === 'es' ? canon : otherPath ? abs(otherPath) : enOnly ? null : canon;
const enHref = lang === 'en' ? canon : otherPath ? abs(otherPath) : null;
const xDefaultHref = esHref ?? canon;
const ogLocale = lang === 'es' ? 'es_US' : 'en_US';
// hasEn: explícito, o hay espejo real (o esta misma página ya es EN).
const hasEnResolved = hasEn ?? (lang === 'en' || otherPath != null);

// JSON-LD @graph (Organization + LocalBusiness por ciudad) — server-rendered,
// restaura el structured data del Sprint 0. NAP desde i18n/content (DRY).
const tel = (p: string) => p.replace(/[^\d+]/g, '');
// Descripción de la Organización POR IDIOMA (lo que la IA cita de nosotros).
const orgDescription =
  lang === 'en'
    ? 'Web design agency, local SEO, and artificial-intelligence solutions for small and medium businesses in Houston and Miami. We put AI to work for your business, in English and Spanish.'
    : 'Agencia de diseño web, SEO local y soluciones de inteligencia artificial para pequeñas y medianas empresas en Houston y Miami. Ponemos la IA a trabajar para tu negocio, en español e inglés.';
// La raíz '/' redirige a /es: la url de la entidad es la home del idioma de la página.
// Los @id (#organization, #houston, #miami) son identificadores y no cambian.
const homeUrl = `${SITE}/${lang === 'en' ? 'en' : 'es'}`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE}/#organization`,
      name: 'Marcyan Studio',
      url: homeUrl,
      logo: `${SITE}/logos/marcyan-lateral-fondo-blanco.png`,
      email: nap.email,
      description: orgDescription,
      slogan: lang === 'en' ? 'Web design that thinks for you' : 'Diseño web que piensa por ti',
      knowsLanguage: ['es', 'en'],
      areaServed: [
        { '@type': 'City', name: 'Houston' },
        { '@type': 'City', name: 'Miami' },
      ],
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${SITE}/#houston`,
      name: 'Marcyan Studio',
      parentOrganization: { '@id': `${SITE}/#organization` },
      url: homeUrl,
      telephone: tel(nap.houston),
      email: nap.email,
      priceRange: '$$',
      knowsLanguage: ['es', 'en'],
      address: { '@type': 'PostalAddress', addressLocality: 'Houston', addressRegion: 'TX', addressCountry: 'US' },
      areaServed: { '@type': 'City', name: 'Houston' },
      // Ficha de Google de Houston (enlace dado por el dueño, 2026-11-07; cid de la ficha). Miami: pendiente.
      hasMap: 'https://maps.google.com/?cid=12570640077238981353',
      sameAs: ['https://maps.google.com/?cid=12570640077238981353'],
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${SITE}/#miami`,
      name: 'Marcyan Studio',
      parentOrganization: { '@id': `${SITE}/#organization` },
      url: homeUrl,
      telephone: tel(nap.miami),
      email: nap.email,
      priceRange: '$$',
      knowsLanguage: ['es', 'en'],
      // SAB sin presencia física en Miami: solo areaServed (sin PostalAddress),
      // coherente con el copy "sin dirección pública". Houston sí lleva address
      // por ser la base de operaciones.
      areaServed: { '@type': 'City', name: 'Miami' },
    },
  ],
};

// Google Analytics 4. El snippet init va como string (set:html en el <head>)
// para que las llaves del snippet no las procese el JSX de Astro.
const GA_ID = 'G-4GJPX4PTRV';
// Coreografía v3 (§2.9): html.w-anim si no hay reduced-motion; salvaguarda html.w-in-all a
// los 2,5 s si reveal.ts no arrancó (red, bloqueador o error previo del bundle). Va inline en el
// <head> para que el estado inicial exista antes del primer fotograma.
const wAnimInit = `(function(){var d=document.documentElement;try{if(matchMedia('(prefers-reduced-motion: no-preference)').matches)d.classList.add('w-anim')}catch(e){}setTimeout(function(){if(!d.classList.contains('w-ready'))d.classList.add('w-in-all')},2500)})();`;
// gtag.js (177 KB) se pide tras la carga, en un momento libre del navegador: el hilo principal
// queda para pintar la portada (tareas largas de 150-180 ms en móvil). La cola dataLayer guarda
// la visita y los eventos hasta que llega, así que no se pierde nada salvo rebotes de < 1 s.
const gaInit = `window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${GA_ID}');(function(){function l(){var s=document.createElement('script');s.async=true;s.src='https://www.googletagmanager.com/gtag/js?id=${GA_ID}';document.head.appendChild(s)}function i(){'requestIdleCallback' in window?requestIdleCallback(l,{timeout:2500}):setTimeout(l,1200)}document.readyState==='complete'?i():addEventListener('load',i,{once:true})})();`;
---
<!doctype html>
<html lang={lang} data-ds={ds}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {ds === 'v3' && <script is:inline set:html={wAnimInit} />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canon} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {esHref && <link rel="alternate" hreflang="es" href={esHref} />}
    {hasEnResolved && <link rel="alternate" hreflang="en" href={enHref} />}
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />

    <meta name="theme-color" content="#080808" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Marcyan Studio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canon} />
    <meta property="og:image" content={`${SITE}${ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    {hasEnResolved && !enOnly && <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_US'} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${SITE}${ogImage}`} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    {/* Favicon / iconos de marca (fuente: public/logos/marcyan-favicon.png) */}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    {/* Google Analytics 4 (gtag.js) — diferido tras la carga, is:inline para que Astro NO lo
        bundlee. Va al final del <head>: al ser async no bloquea el render y
        deja que fuentes/CSS críticos se descubran primero (cuida el PSI).
        NO se emite en páginas noindex (panel/kit/formulario): sin ruido de
        analytics en zonas privadas. El init va con set:html para que las {}
        del snippet no las interprete el JSX de Astro. */}
    {!noindex && (
      <>
        <script is:inline set:html={gaInit} />
      </>
    )}

    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
    <slot />
    {/* Aviso de idioma sin redirección (plan maestro 0.3): solo donde hay espejo
        publicado (mismo mapa routes.ts que el conmutador de la nav). Emite un
        <template> inerte; el DOM visible lo decide el cliente. Aparece también
        en la home: excepción sancionada, con QA de home y OK del dueño. */}
    {otherPath && <LangNotice lang={lang} href={otherPath} />}
    <ChatWidget lang={lang} city={/(^|\/)miami(\/|$)/.test(path) ? 'miami' : 'houston'} />

    <script>
      // Tracking first-party delegado: cualquier elemento con [data-track] dispara
      // un evento (Growth OS). Passive, sin cookies ni PII (ver src/lib/track.js).
      // Instrumenta CtaBand (whatsapp/call), el teaser y las CTAs de herramientas
      // sin que cada página tenga que importar track.
      import { track } from '../lib/track.js';
      import '../components/w/offscreen';
      import '../components/w/zoom-img';
      document.addEventListener('click', (e) => {
        const el = e.target && e.target.closest && e.target.closest('[data-track]');
        if (el && el.dataset.track) track(el.dataset.track);
      }, true);
    </script>
  </body>
</html>
