---
// ABOUT · /en/about — honest E-E-A-T (Lane 2).
// who we are · how we work (process) · approach/values · Founding Clients ·
// cities (SAB) · real work (→ portfolio). Reuses DS components.
// Schema: AboutPage (→ Organization in the @graph) + BreadcrumbList. EN.
// ⚠️ HONESTY: NO invented founder. The Person node + sameAs + foundingDate are
// added LATER, when the owner provides the real datum (see commented block below).
//
// REDESIGN 2026-06-29 (section hub, not landing): COMPACT header (LandingHero
// variant="header"), SpaceBackdrop atmosphere (gold) instead of a flat slab, and a
// BESPOKE "trust telemetry" band (3 pillars = verifiable data read like instruments)
// instead of a wall of text, to give rhythm to E-E-A-T without touching the honest
// i18n copy or the schema/form. See design/art-direction.md.
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/layout/SiteNav.astro';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import LandingHero from '../../components/sections/LandingHero.astro';
import AnswerBlock from '../../components/sections/AnswerBlock.astro';
import Prose from '../../components/sections/Prose.astro';
import FeatureGrid from '../../components/sections/FeatureGrid.astro';
import Process from '../../components/sections/Process.astro';
import Locations from '../../components/sections/Locations.astro';
import RelatedLinks from '../../components/sections/RelatedLinks.astro';
import Faq from '../../components/sections/Faq.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import Contact from '../../components/sections/Contact.astro';
import SpaceBackdrop from '../../components/SpaceBackdrop.astro';
import AboutPageLd from '../../components/seo/AboutPageLd.astro';
import { content } from '../../i18n/content';
import { clusterNavEn } from '../../i18n/clusters';
import { sobreNosotros as a } from '../../i18n/sobre-nosotros.en';

const c = content.en;

// Bespoke "trust telemetry" band: 3 verifiable facts derived from the honest i18n
// copy (hero chips + values). NOT new content: it reframes data already present as
// an instrument reading (mono label + display value + support).
const trust = [
  { label: 'Coverage', value: 'Houston and Miami', note: 'Service-area business, direct attention in your market.' },
  { label: 'Language', value: 'Bilingual EN / ES', note: 'Written for how your customer searches, not Google Translate.' },
  { label: 'Pricing', value: 'Public', note: 'Down to the monthly SEO and maintenance, no fine print.' },
  { label: 'AI visibility', value: 'Clients AI already recommends', note: 'Google\'s AI already includes our clients in some recommendations.' },
];
---
<Layout
  title={a.meta.title}
  description={a.meta.description}
  lang="en"
  path="about"
>
  <AboutPageLd slot="head" name={a.meta.title} description={a.meta.description} path={a.path} />

  {/*
    TODO E-E-A-T (when the owner delivers the real data): add the founder's Person
    node + photo, and enrich the Organization with foundingDate and sameAs.
    FORBIDDEN to invent them. Template ready to uncomment and complete:

    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'Person',
      name: 'REAL_FOUNDER_NAME',
      jobTitle: 'Founder',
      worksFor: { '@id': 'https://marcyanstudio.com/#organization' },
      image: 'https://marcyanstudio.com/assets/team/founder.jpg',
      sameAs: ['https://www.linkedin.com/in/...', 'https://instagram.com/...'],
    })} />

    Also: AggregateRating (an unoccupied wedge vs the competition) is ready in
    lib/schema.ts (aggregateRating) but is NOT emitted until we have real reviews
    with consent. Do not invent reviews.
  */}

  <SiteNav nav={clusterNavEn} lang="en" homeHref="/en/" currentPath={Astro.url.pathname} />

  <main id="main">
    {/* Section hub → COMPACT header (DESIGN.md §2), not a cover hero. */}
    <LandingHero
      kicker={a.hero.kicker}
      h1={a.hero.h1}
      sub={a.hero.sub}
      primary={a.hero.primary}
      secondary={a.hero.secondary}
      chips={a.hero.chips}
      tone={a.hero.tone}
      variant="header"
    >
      <Breadcrumb slot="breadcrumb" items={a.breadcrumb} lang="en" />
    </LandingHero>

    {/* Citable definition (AEO lever). */}
    <AnswerBlock lang="en" q={a.answer.q} a={a.answer.a} />

    {/* Who we are — editorial Prose (rail + reading column). */}
    <Prose tag={a.story.tag} title={a.story.title} paragraphs={a.story.paragraphs} tone={a.story.tone} />

    {/* ── BESPOKE BAND: trust telemetry ───────────────────────────────────────
        3 verifiable facts read like instruments (E-E-A-T / Trust).
        Translucent panel over the atmosphere (echo of RelatedLinks), not a flat slab.
        Decorative line-art aria-hidden; copy reframed from i18n, nothing invented. */}
    <section class="section trust" aria-labelledby="trust-h">
      <div class="container">
        <div class="trust__panel">
          <header class="trust__head">
            <span class="trust__tag">
              <span class="trust__dot" aria-hidden="true"></span>Verifiable
            </span>
            <h2 class="h3 trust__title" id="trust-h">We say it with <em>data</em>, not adjectives</h2>
          </header>

          <dl class="trust__grid">
            {trust.map((t) => (
              <div class="trust__cell">
                <dt class="trust__label">{t.label}</dt>
                <dd class="trust__value">{t.value}</dd>
                <p class="trust__note">{t.note}</p>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    {/* Approach / values — "manifesto" FeatureGrid (not 3-card). */}
    <FeatureGrid tag={a.values.tag} title={a.values.title} intro={a.values.intro} items={a.values.items} tone={a.values.tone} />

    {/* How we work — the home timeline (reused, untouched). */}
    <Process process={c.process} />

    {/* Founding Clients — editorial Prose. */}
    <Prose tag={a.founders.tag} title={a.founders.title} paragraphs={a.founders.paragraphs} tone={a.founders.tone} />

    {/* Cities (SAB). */}
    <Locations locations={c.locations} />

    {/* Real work → portfolio (constellation of routes). */}
    <RelatedLinks tag={a.proof.tag} title={a.proof.title} links={a.proof.links} />

    {/* FAQ (co-located FAQPage, none open by default). */}
    <Faq tag={a.faq.tag} title={a.faq.title} items={a.faq.items} />

    {/* Close with 1 dominant action. */}
    <CtaBand lang="en"
      title={a.cta.title}
      sub={a.cta.sub}
      primary={a.cta.primary}
      secondary={a.cta.secondary}
      tone={a.cta.tone}
    />

    {/* Contact form (contract intact → /api/contact, /api/brief). */}
    <Contact contact={c.contact} />
  </main>

  {/* Page atmosphere (once) — gives this hub the home background. */}
  <SpaceBackdrop tone="gold" />

  <SiteFooter lang="en" footer={c.footer} />
</Layout>

<style>
  /* ── Bespoke band: trust telemetry ───────────────────────────────────────
     Translucent panel floating over the SpaceBackdrop atmosphere (not a solid
     slab). The 3 pillars read like instruments: mono label + display value +
     legible support, separated by a thin rule. Gold accents (echo of the hero
     chips and the Kicker). Tokens only. */
  .trust__panel {
    position: relative;
    overflow: hidden;
    min-width: 0;
    background:
      radial-gradient(120% 90% at 100% 0%, var(--accent-gold-dim), transparent 60%),
      color-mix(in srgb, var(--bg-card) 72%, transparent);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
  }

  .trust__head {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }
  /* live mono kicker (echo of answer__tag, but in gold = trust) */
  .trust__tag {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--accent-gold);
  }
  .trust__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex: 0 0 auto;
    background: var(--accent-gold);
    box-shadow: 0 0 8px var(--accent-gold);
  }
  .trust__title {
    font-family: var(--font-display);
    line-height: var(--leading-snug);
    max-width: 24ch;
  }
  .trust__title :global(em) { color: var(--accent-gold); font-style: normal; }

  /* Grid of pillars = instruments. 1 col mobile → 3 col desktop, with a divider
     rule between instruments (top rule per cell). */
  .trust__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    margin: 0;
  }
  .trust__cell {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5) 0;
    border-top: 1px solid var(--border-subtle);
  }
  .trust__cell:first-child { border-top: 0; }

  .trust__label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--fg-subtle);
  }
  .trust__value {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: var(--leading-snug);
    color: var(--fg-primary);
  }
  .trust__note {
    margin: 0;
    color: var(--fg-secondary);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    max-width: 38ch;
  }

  @media (--md) {
    .trust__panel { padding: var(--space-7); }
  }

  @media (--sm) {
    .trust__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-6); }
  }

  @media (--lg) {
    /* 3 instruments in a row, separated by a vertical rule (not horizontal) */
    .trust__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: var(--space-7);
    }
    .trust__cell {
      padding: 0 var(--space-6) 0 0;
      border-top: 0;
      border-left: 1px solid var(--border-subtle);
      padding-left: var(--space-6);
    }
    .trust__cell:first-child { border-left: 0; padding-left: 0; }
    .trust__cell:last-child { padding-right: 0; }
  }
</style>
