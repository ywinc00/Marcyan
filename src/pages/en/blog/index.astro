---
// BLOG INDEX · /en/blog — "ship's log": compact editorial header
// (LandingHero variant="header"), CATEGORY rail derived from post.data.tags
// (progressive-enhancement filter: without JS all show), FEATURED piece
// with line-art micro-illustration + entries grid with log hierarchy.
// Schema: Blog (listing) + BreadcrumbList (from Breadcrumb). EN mirror of
// /es/blog; posts are filtered to lang === 'en' (none yet -> empty state,
// while still rendering hero + CTA + Contact). Inline EN index copy below
// (blog.ts is ES-only; not modified).
import Layout from '../../../layouts/Layout.astro';
import SiteNav from '../../../components/layout/SiteNav.astro';
import SiteFooter from '../../../components/layout/SiteFooter.astro';
import Breadcrumb from '../../../components/ui/Breadcrumb.astro';
import LandingHero from '../../../components/sections/LandingHero.astro';
import CtaBand from '../../../components/sections/CtaBand.astro';
import Contact from '../../../components/sections/Contact.astro';
import Card from '../../../components/ui/Card.astro';
import Kicker from '../../../components/ui/Kicker.astro';
import Icon from '../../../components/ui/Icon.astro';
import SpaceBackdrop from '../../../components/SpaceBackdrop.astro';
import BlogIllustration from '../../../components/BlogIllustration.astro';
import BlogListingLd from '../../../components/seo/BlogListingLd.astro';
import { content } from '../../../i18n/content';
import { clusterNavEn } from '../../../i18n/clusters';
import type { CrumbItem } from '../../../lib/schema';
import { getCollection } from 'astro:content';

const c = content.en;

// EN blog index copy (inline; blog.ts stays ES-only and untouched).
const b = {
  meta: {
    title: 'Blog - Web design, AI & SEO guides for small businesses | Marcyan Studio',
    description:
      'Clear, honest guides on web design, artificial intelligence, and SEO for small businesses in Houston and Miami. Real prices, sourced data, and zero empty promises.',
  },
  hero: {
    badge: 'Resources',
    badgeIcon: 'lucide:book-open',
    kicker: 'Marcyan Blog',
    h1: 'Honest guides to <em>grow</em> your business online',
    sub: 'Web design, artificial intelligence, and SEO explained without jargon and without fine print, for small business owners in Houston and Miami.',
    primary: { label: 'Explore guides', href: '#articulos' },
    secondary: { label: 'See pricing', href: '/en/pricing' },
    tone: 'gold' as const,
  },
  breadcrumb: [
    { name: 'Home', path: '/en/' },
    { name: 'Blog', path: '/en/blog' },
  ] as CrumbItem[],
  list: { tag: 'Latest posts', title: 'Recent <em>articles</em>' },
  cardCta: 'Read guide',
  empty: 'Our English guides are coming soon.',
  cta: {
    title: 'Ready for your business to <em>take off</em>?',
    sub: 'Tell us your idea and get a personalized proposal in under 24 hours, at no cost and no commitment.',
    primary: { label: 'Get a free proposal', href: '#contacto' },
    secondary: { label: 'See pricing', href: '/en/pricing' },
    tone: 'gold' as const,
  },
};

const posts = (
  await getCollection('blog', ({ data }) => !data.draft && data.lang === 'en')
).sort((a, z) => z.data.datePublished.getTime() - a.data.datePublished.getTime());

const fmt = (d: Date) => new Intl.DateTimeFormat('en', { dateStyle: 'long', timeZone: 'UTC' }).format(d);
const iso = (d: Date) => d.toISOString().slice(0, 10);

// stable id per tag (for data-cat / data-filter without accents or spaces)
const STRIP_DIACRITICS = /[̀-ͯ]/g;
const slugify = (s: string) =>
  s
    .toLowerCase()
    .normalize('NFD')
    .replace(STRIP_DIACRITICS, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');

// CATEGORIES derived from real tags, with count, ordered by frequency.
const catCount = new Map<string, number>();
for (const p of posts) for (const t of p.data.tags) catCount.set(t, (catCount.get(t) ?? 0) + 1);
const categories = [...catCount.entries()]
  .sort((a, z) => z[1] - a[1] || a[0].localeCompare(z[0]))
  .map(([label, count]) => ({ label, count, id: slugify(label) }));

// each post carries its list of category ids (for the enhancement filter)
const withCats = posts.map((p) => ({ post: p, cats: p.data.tags.map(slugify) }));

const postRefs = posts.map((p) => ({
  headline: p.data.title,
  path: `/en/blog/${p.id}`,
  description: p.data.description,
  datePublished: iso(p.data.datePublished),
}));
---
<Layout title={b.meta.title} description={b.meta.description} lang="en" path="blog">
  <BlogListingLd slot="head" posts={postRefs} name="Marcyan Studio Blog" description={b.meta.description} path="/en/blog" />

  <SiteNav nav={clusterNavEn} lang="en" homeHref="/en/" currentPath="/en/blog" />

  <main id="main">
    <LandingHero
      badge={b.hero.badge}
      badgeIcon={b.hero.badgeIcon}
      kicker={b.hero.kicker}
      h1={b.hero.h1}
      sub={b.hero.sub}
      primary={b.hero.primary}
      secondary={b.hero.secondary}
      tone={b.hero.tone}
      variant="header"
    >
      <Breadcrumb slot="breadcrumb" items={b.breadcrumb} lang="en" />
    </LandingHero>

    <section class="section bloglist">
      <div class="container">
        <header class="bloglist__head">
          <Kicker>{b.list.tag}</Kicker>
          <h2 class="h2" set:html={b.list.title} />
        </header>

        {posts.length === 0 ? (
          <p class="bloglist__empty">{b.empty}</p>
        ) : (
          <div class="bloglist__body" data-blog>
            {/* -- Category rail (progressive-enhancement filter) -- */}
            {categories.length > 1 && (
              <nav class="catrail" aria-label="Filter by topic">
                <span class="catrail__label" aria-hidden="true">Topics</span>
                <ul class="catrail__list" role="list">
                  <li>
                    <button type="button" class="catchip is-active" data-filter="all" aria-pressed="true">
                      <span class="catchip__dot" aria-hidden="true"></span>
                      All
                      <span class="catchip__count">{posts.length}</span>
                    </button>
                  </li>
                  {categories.map((cat) => (
                    <li>
                      <button type="button" class="catchip" data-filter={cat.id} aria-pressed="false">
                        <span class="catchip__dot" aria-hidden="true"></span>
                        {cat.label}
                        <span class="catchip__count">{cat.count}</span>
                      </button>
                    </li>
                  ))}
                </ul>
              </nav>
            )}

            {/* message when a filter yields no results (hidden by default) */}
            <p class="bloglist__none" data-blog-none hidden>No guides on this topic yet.</p>

            <ul id="articulos" class="bloglist__grid">
              {withCats.map(({ post: p, cats }, i) => (
                <li
                  class:list={['bloglist__cell', i === 0 && 'bloglist__cell--feature']}
                  data-post
                  data-cats={cats.join(' ')}
                >
                  <Card href={`/en/blog/${p.id}`} class="postcard">
                    {/* -- Custom illustration per topic (image-forward, on top) -- */}
                    <div class="postcard__media">
                      <BlogIllustration tags={p.data.tags} class="postcard__illo" />
                    </div>
                    <div class="postcard__body">
                      <div class="postcard__meta">
                        <span class="postcard__num" aria-hidden="true">{String(posts.length - i).padStart(2, '0')}</span>
                        <time datetime={iso(p.data.datePublished)}>{fmt(p.data.datePublished)}</time>
                        {p.data.tags[0] && <span class="postcard__tag">{p.data.tags[0]}</span>}
                      </div>
                      <h3 class="postcard__title">{p.data.title}</h3>
                      <p class="postcard__excerpt">{p.data.description}</p>
                      <span class="postcard__cta">{b.cardCta} <Icon name="lucide:arrow-right" /></span>
                    </div>
                  </Card>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>

    <CtaBand lang="en"
      title={b.cta.title}
      sub={b.cta.sub}
      primary={b.cta.primary}
      tone={b.cta.tone}
    />

    <Contact contact={c.contact} />
  </main>

  <SiteFooter footer={c.footer} lang="en" />
  <SpaceBackdrop tone="gold" />
</Layout>

<style>
  .bloglist__head { display: flex; flex-direction: column; gap: var(--space-3); margin-bottom: var(--space-6); }
  .bloglist :global(.h2 em) { color: var(--accent-gold); font-style: normal; }
  .bloglist__empty { color: var(--fg-secondary); font-size: var(--text-md); }
  .bloglist__none { color: var(--fg-secondary); font-size: var(--text-md); margin-bottom: var(--space-6); }

  /* -- category rail = mono "channel selector", scannable -- */
  .catrail {
    display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3);
    margin-bottom: var(--space-7); padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--border-subtle);
  }
  .catrail__label {
    font-family: var(--font-mono); font-size: var(--text-xs);
    letter-spacing: var(--tracking-widest); text-transform: uppercase; color: var(--fg-subtle);
  }
  .catrail__list { list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-3); min-width: 0; }

  .catchip {
    display: inline-flex; align-items: center; gap: var(--space-2);
    min-height: var(--tap-min); padding: var(--space-2) var(--space-4);
    border: 1px solid var(--border); border-radius: var(--radius-pill);
    background: var(--bg-card); color: var(--fg-secondary);
    font-family: var(--font-mono); font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide); cursor: pointer;
    transition: color var(--duration-fast) var(--ease-out-expo),
                border-color var(--duration-fast) var(--ease-out-expo),
                background var(--duration-fast) var(--ease-out-expo);
  }
  .catchip__dot {
    width: 6px; height: 6px; border-radius: 50%; flex: 0 0 auto;
    background: var(--fg-subtle); transition: background var(--duration-fast), box-shadow var(--duration-fast);
  }
  .catchip__count {
    font-size: var(--text-xs); color: var(--fg-subtle); padding-left: var(--space-1);
    border-left: 1px solid var(--border); margin-left: var(--space-1);
  }
  @media (--hover-fine) {
    .catchip:hover { color: var(--fg-primary); border-color: var(--border-accent); }
  }
  .catchip:focus-visible { outline: 2px solid var(--accent-gold); outline-offset: 2px; }
  .catchip.is-active {
    color: var(--fg-inverse); background: var(--accent-gold); border-color: var(--accent-gold);
  }
  .catchip.is-active .catchip__dot { background: var(--fg-inverse); box-shadow: none; }
  .catchip.is-active .catchip__count { color: var(--fg-inverse); border-left-color: color-mix(in srgb, var(--fg-inverse), transparent 75%); opacity: 0.75; }

  /* -- entries grid -- */
  .bloglist__grid { list-style: none; display: grid; grid-template-columns: 1fr; gap: var(--space-5); }
  .bloglist__cell { min-width: 0; display: flex; }
  /* post hidden by the filter */
  .bloglist__cell[hidden] { display: none; }

  /* image-forward: the illustration bleeds to the top edge; the Card padding
     moves to the body so the thumbnail fills the full width. The selector
     .postcard.card raises specificity above the .card from Card.astro to
     neutralize its padding DETERMINISTICALLY (not depending on bundle order
     between page and component styles). Both classes are on the same <a>
     (Card passes `postcard` into class:list), so the matcher is valid. */
  .postcard { position: relative; isolation: isolate; display: flex; flex-direction: column; height: 100%; overflow: clip; }
  .postcard.card { padding: 0; }

  /* -- thumbnail (custom illustration per topic) -- */
  .postcard__media {
    position: relative;
    border-bottom: 1px solid var(--border-subtle);
    background:
      radial-gradient(120% 120% at 82% 8%, var(--accent-gold-dim), transparent 60%),
      var(--bg-2);
    overflow: clip;
  }
  .postcard__media :global(.postcard__illo) {
    /* the illustration already ships aspect-ratio 3:2 + aria-hidden; give it inner air */
    padding: var(--space-5) var(--space-6);
    opacity: 0.9;
  }

  .postcard__body {
    display: flex; flex-direction: column; gap: var(--space-3);
    padding: var(--space-6); flex: 1 1 auto; min-width: 0;
  }

  /* log numeral */
  .postcard__num {
    font-family: var(--font-mono); font-size: var(--text-xs); color: var(--accent-gold);
    letter-spacing: var(--tracking-wide); padding-right: var(--space-3);
    border-right: 1px solid var(--border); margin-right: var(--space-1);
  }
  .postcard__meta {
    display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-3);
    font-family: var(--font-mono); font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide); color: var(--fg-secondary);
  }
  .postcard__tag {
    color: var(--accent-teal); border: 1px solid var(--accent-teal-line);
    border-radius: var(--radius-pill); padding: 2px var(--space-3);
  }
  .postcard__title {
    font-family: var(--font-display); font-size: var(--text-xl); font-weight: 600;
    line-height: var(--leading-snug); color: var(--fg-primary); text-wrap: balance;
  }
  .postcard__excerpt { color: var(--fg-secondary); font-size: var(--text-base); line-height: var(--leading-normal); }
  .postcard__cta {
    margin-top: auto; display: inline-flex; align-items: center; gap: var(--space-2);
    font-family: var(--font-body); font-weight: 600; font-size: var(--text-sm); color: var(--accent-gold);
  }
  .postcard__cta :global(svg) { width: 16px; height: 16px; transition: transform var(--duration-base) var(--ease-out-expo); }
  .postcard:hover .postcard__cta :global(svg) { transform: translateX(3px); }

  @media (--md) {
    .bloglist__grid { grid-template-columns: repeat(2, 1fr); gap: var(--space-6); }
    /* the featured piece spans the full width of the top row */
    .bloglist__cell--feature { grid-column: 1 / -1; }
    .bloglist__cell--feature .postcard__title { font-size: var(--text-2xl); max-width: 28ch; }
    .bloglist__cell--feature .postcard__excerpt { max-width: 64ch; font-size: var(--text-md); }
  }
  @media (--lg) {
    .bloglist__grid { grid-template-columns: repeat(3, 1fr); }
    /* featured = illustration on one side, content on the other (horizontal hierarchy) */
    .bloglist__cell--feature .postcard {
      display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); align-items: stretch;
    }
    .bloglist__cell--feature .postcard__media {
      border-bottom: none; border-inline-end: 1px solid var(--border-subtle);
      display: flex; align-items: center; justify-content: center;
    }
    .bloglist__cell--feature .postcard__media :global(.postcard__illo) {
      padding: var(--space-7); max-width: 480px; margin-inline: auto;
    }
    .bloglist__cell--feature .postcard__body { justify-content: center; padding: var(--space-8) var(--space-7); gap: var(--space-4); }
  }

  @media (--motion-reduce) {
    .postcard:hover .postcard__cta :global(svg) { transform: none; }
  }
</style>

<script>
  // TOPIC filter -- progressive enhancement. Without JS: static rail + all
  // entries visible (the <button>s simply do nothing). With JS: toggles the
  // [hidden] attribute of each post based on its data-cats; "All" resets.
  const root = document.querySelector<HTMLElement>('[data-blog]');
  if (root) {
    const chips = Array.from(root.querySelectorAll<HTMLButtonElement>('.catchip'));
    const cells = Array.from(root.querySelectorAll<HTMLElement>('[data-post]'));
    const none = root.querySelector<HTMLElement>('[data-blog-none]');

    function apply(filter: string) {
      let shown = 0;
      for (const cell of cells) {
        const cats = (cell.dataset.cats || '').split(' ');
        const match = filter === 'all' || cats.includes(filter);
        cell.hidden = !match;
        if (match) shown++;
      }
      if (none) none.hidden = shown !== 0;
    }

    for (const chip of chips) {
      chip.addEventListener('click', () => {
        for (const c of chips) {
          const on = c === chip;
          c.classList.toggle('is-active', on);
          c.setAttribute('aria-pressed', on ? 'true' : 'false');
        }
        apply(chip.dataset.filter || 'all');
      });
    }
  }
</script>
