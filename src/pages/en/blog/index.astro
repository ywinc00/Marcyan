---
// BLOG INDEX · /en/blog. v3 template (WorkOS redesign, design/rediseno-workos.md §4.7),
// rendered by w/sections/blog/IndiceBlog.astro. Only the FROZEN copy lives here (meta,
// verbatim H1, breadcrumb, Blog name in the JSON-LD; blog.ts stays ES-only) plus the EN
// posts by date. No EN guides yet: the template shows the empty state and never lists ES
// posts. Schema: Blog (listing) + BreadcrumbList (from Breadcrumb), unchanged.
import IndiceBlog from '../../../components/w/sections/blog/IndiceBlog.astro';
import type { CrumbItem } from '../../../lib/schema';
import { getCollection } from 'astro:content';

const meta = {
  title: 'Blog - Web design, AI & SEO guides for small businesses | Marcyan Studio',
  description:
    'Clear, honest guides on web design, artificial intelligence, and SEO for small businesses in Houston and Miami. Real prices, sourced data, and zero empty promises.',
};
const h1 = 'Honest guides to <em>grow</em> your business online';
const breadcrumb: CrumbItem[] = [
  { name: 'Home', path: '/en/' },
  { name: 'Blog', path: '/en/blog' },
];

const posts = (
  await getCollection('blog', ({ data }) => !data.draft && data.lang === 'en')
).sort((a, z) => z.data.datePublished.getTime() - a.data.datePublished.getTime());
---
<IndiceBlog
  lang="en"
  meta={meta}
  h1Html={h1}
  breadcrumb={breadcrumb}
  ldName="Marcyan Studio Blog"
  posts={posts}
  emptyTitle="Our English guides are coming soon."
/>
