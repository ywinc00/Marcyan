---
// CITY HUB · /en/miami — "The journey" redesign (2026-11-01): the Houston hub base with Miami's own elements (the
// planet zooms into Miami-Dade, its areas and searches, its real map and its skyline at dusk in the footer).
// All content lives in CityHub (one piece for Houston and Miami, ES and EN); copy in i18n/miami.en.ts (`journey`
// block + the usual keys). Since the Nov 2026 consolidation the service and neighborhood landings live on this hub,
// so the service rows and the areas are not links. Schema: Breadcrumb + FAQPage. Projects: MJA, labeled with its
// real city (Orlando, Florida), as the closest one; GNS will join when it is finished.
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/layout/SiteNav.astro';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import CityHub from '../../components/city/CityHub.astro';
import CityScape from '../../components/city/CityScape.astro';
import { content } from '../../i18n/content';
import { clusterNavEn } from '../../i18n/clusters';
import { miamiHub as h } from '../../i18n/miami.en';
import { portfolioProjects } from '../../i18n/portfolio.en';

const c = content.en;
---
<Layout
  title={h.meta.title}
  description={h.meta.description}
  lang="en"
  path="miami"
>
  <link rel="preload" href="/geo/miami-globo-110.json" as="fetch" crossorigin="anonymous" slot="head" />

  <SiteNav nav={clusterNavEn} lang="en" homeHref="/en" currentPath={Astro.url.pathname} />

  <main id="main">
    <CityHub lang="en" city="miami" h={h} c={c} projects={portfolioProjects} />
  </main>

  <SiteFooter lang="en" footer={c.footer} starDensity={1.35}>
    <CityScape slot="scape" src="/assets/miami/skyline.svg" ratio="2400 / 428" x="50%" glow={["72%", "50%"]} />
  </SiteFooter>
</Layout>
