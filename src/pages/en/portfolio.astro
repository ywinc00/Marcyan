---
// PORTFOLIO · /en/portfolio — real proof (4 clients) + E-E-A-T (Lane 2).
// Reuses the DS components (LandingHero, AnswerBlock, RelatedLinks, Faq,
// CtaBand, Contact) + PortfolioGrid (device mockups with real screenshots).
// Schema: CollectionPage + ItemList (CreativeWork) + BreadcrumbList. EN.
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/layout/SiteNav.astro';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import LandingHero from '../../components/sections/LandingHero.astro';
import AnswerBlock from '../../components/sections/AnswerBlock.astro';
import PortfolioGrid from '../../components/sections/PortfolioGrid.astro';
import RelatedLinks from '../../components/sections/RelatedLinks.astro';
import Faq from '../../components/sections/Faq.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import Contact from '../../components/sections/Contact.astro';
import SpaceBackdrop from '../../components/SpaceBackdrop.astro';
import CollectionPageLd from '../../components/seo/CollectionPageLd.astro';
import { content } from '../../i18n/content';
import { clusterNavEn } from '../../i18n/clusters';
import { portfolioPage as p, portfolioProjects } from '../../i18n/portfolio.en';

const c = content.en;
// CollectionPage items from the projects (CreativeWork with real screenshot; no external URL for privacy).
const works = portfolioProjects.map((w) => ({
  name: w.name,
  description: w.did,
  about: w.cat,
  image: `/Galeria/${w.slug}-pc.webp`,
}));
---
<Layout
  title={p.meta.title}
  description={p.meta.description}
  lang="en"
  path="portfolio"
>
  <CollectionPageLd slot="head" name={p.meta.title} description={p.meta.description} path={p.path} items={works} />

  <SiteNav nav={clusterNavEn} lang="en" homeHref="/en/" currentPath={Astro.url.pathname} />

  <main id="main">
    <LandingHero
      variant="header"
      kicker={p.hero.kicker}
      h1={p.hero.h1}
      sub={p.hero.sub}
      primary={p.hero.primary}
      secondary={p.hero.secondary}
      chips={p.hero.chips}
      tone={p.hero.tone}
    >
      <Breadcrumb slot="breadcrumb" items={p.breadcrumb} lang="en" />
    </LandingHero>

    <AnswerBlock lang="en" q={p.answer.q} a={p.answer.a} />

    <PortfolioGrid lang="en" tag={p.worksHead.tag} title={p.worksHead.title} intro={p.worksHead.intro} projects={portfolioProjects} />

    <RelatedLinks tag={p.related.tag} title={p.related.title} links={p.related.links} />

    <Faq tag={p.faq.tag} title={p.faq.title} items={p.faq.items} />

    <CtaBand lang="en"
      title={p.cta.title}
      sub={p.cta.sub}
      primary={p.cta.primary}
      secondary={p.cta.secondary}
      tone={p.cta.tone}
    />

    <Contact contact={c.contact} />
  </main>

  <SpaceBackdrop tone="gold" />

  <SiteFooter lang="en" footer={c.footer} />
</Layout>
