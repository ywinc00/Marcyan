---
// PRICING HUB · /en/pricing — SEO Phase 0.
// "Public pricing, no fine print": the 6 services with "from $X" + what
// each includes, answer-first AEO, transparency framing (we publish the
// recurring pricing the competition hides) and an FAQ with FAQPage. Schema:
// OfferCatalog with Offer/priceSpecification for all 6 (AEO ammunition).
// EN mirror of the Spanish pricing hub.
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/layout/SiteNav.astro';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import LandingHero from '../../components/sections/LandingHero.astro';
import AnswerBlock from '../../components/sections/AnswerBlock.astro';
import Prose from '../../components/sections/Prose.astro';
import PriceGrid from '../../components/sections/PriceGrid.astro';
import RelatedLinks from '../../components/sections/RelatedLinks.astro';
import Faq from '../../components/sections/Faq.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import Contact from '../../components/sections/Contact.astro';
import SpaceBackdrop from '../../components/SpaceBackdrop.astro';
import OfferCatalogLd from '../../components/seo/OfferCatalogLd.astro';
import { content } from '../../i18n/content';
import { clusterNavEn } from '../../i18n/clusters';
import { priceServices, offerItems, preciosPage as p } from '../../i18n/pricing.en';

const c = content.en;
---
<Layout
  title={p.meta.title}
  description={p.meta.description}
  lang="en"
  path="pricing"
>
  <OfferCatalogLd slot="head" items={offerItems} url={p.path} name="Pricing — Marcyan Studio" />

  <SiteNav nav={clusterNavEn} lang="en" homeHref="/en/" currentPath={Astro.url.pathname} />

  <main id="main">
    {/* §2: section HUB → COMPACT header (does not clone the homepage hero). The
        proof chips leave the header and get promoted to a bespoke "transparency
        ramp" (below) so they can breathe and the page has its own character. */}
    <LandingHero
      variant="header"
      kicker={p.hero.kicker}
      h1={p.hero.h1}
      sub={p.hero.sub}
      primary={p.hero.primary}
      secondary={p.hero.secondary}
      tone={p.hero.tone}
    >
      <Breadcrumb slot="breadcrumb" items={p.breadcrumb} lang="en" />
    </LandingHero>

    {/* ── Transparency ramp (bespoke) ───────────────────────────────────────
        Reuses the honest chips from i18n VERBATIM (p.hero.chips). Not the
        3-card icon+title+paragraph cliche: these are telemetry signals with a
        mono index + connector line, read as "what you will see on this page".
        Delivers the trust punch right where the eye lands, no dull box. */}
    <section class="promise" aria-label="Why these prices">
      <div class="container">
        <ul class="promise__rail" role="list">
          {p.hero.chips.map((ch, i) => (
            <li class="promise__cell">
              <span class="promise__idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="promise__dot" aria-hidden="true"></span>
              <span class="promise__txt">{ch}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <AnswerBlock lang="en" q={p.answer.q} a={p.answer.a} />

    <Prose
      tag={p.transparency.tag}
      title={p.transparency.title}
      paragraphs={p.transparency.paragraphs}
      tone={p.transparency.tone}
    />

    <PriceGrid lang="en" tag={p.grid.tag} title={p.grid.title} intro={p.grid.intro} items={priceServices} />

    <RelatedLinks tag={p.related.tag} title={p.related.title} links={p.related.links} />

    <Faq tag={p.faq.tag} title={p.faq.title} items={p.faq.items} />

    <CtaBand lang="en"
      title={p.cta.title}
      sub={p.cta.sub}
      primary={p.cta.primary}
      secondary={p.cta.secondary}
      tone={p.cta.tone}
    />

    <Contact contact={c.contact} />
  </main>

  <SpaceBackdrop tone="gold" />

  <SiteFooter lang="en" footer={c.footer} />
</Layout>

<style>
  /* ── Transparency ramp ──────────────────────────────────────────────────
     A scannable band that bridges the compact header and the answer-first
     block. Telemetry (mono + index + gold signal dot), a connector rule
     between cells. Floats over the SpaceBackdrop atmosphere (no solid box).
     Tokens only; breakpoints via @custom-media. */
  .promise {
    padding-block: var(--space-6) 0;
  }
  .promise__rail {
    list-style: none; min-width: 0;
    display: grid; grid-template-columns: 1fr; gap: var(--space-3);
  }
  .promise__cell {
    position: relative; min-width: 0;
    display: flex; align-items: center; gap: var(--space-3);
    padding: var(--space-4) var(--space-4) var(--space-4) var(--space-5);
    background: color-mix(in srgb, var(--bg-card) 70%, transparent);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }
  /* left accent rule: a "verified point" signal */
  .promise__cell::before {
    content: ""; position: absolute; left: 0; top: var(--space-3); bottom: var(--space-3);
    width: 2px; border-radius: 0 2px 2px 0;
    background: linear-gradient(180deg, var(--accent-gold), transparent);
  }
  .promise__idx {
    flex: 0 0 auto;
    font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 600;
    letter-spacing: var(--tracking-wide); color: var(--fg-subtle);
  }
  .promise__dot {
    flex: 0 0 auto; width: 6px; height: 6px; border-radius: 50%;
    background: var(--accent-gold); box-shadow: 0 0 8px var(--accent-gold-glow);
  }
  .promise__txt {
    min-width: 0;
    font-family: var(--font-mono); font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide); color: var(--fg-secondary);
    line-height: var(--leading-snug);
  }

  /* ≥ sm: the three signals in one telemetry row, with a connector rule between them */
  @media (--sm) {
    .promise { padding-block: var(--space-7) 0; }
    .promise__rail {
      grid-template-columns: repeat(3, 1fr);
      gap: 0;
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      background: color-mix(in srgb, var(--bg-card) 70%, transparent);
      overflow: hidden;
    }
    .promise__cell {
      background: transparent; border: 0; border-radius: 0;
      padding-block: var(--space-5);
    }
    .promise__cell + .promise__cell { border-left: 1px solid var(--border-subtle); }
    .promise__cell::before {
      top: auto; bottom: 0; left: var(--space-5); right: var(--space-5); width: auto; height: 2px;
      border-radius: 2px 2px 0 0;
      background: linear-gradient(90deg, var(--accent-gold), transparent);
    }
  }

  @media (--md) {
    .promise__txt { font-size: var(--text-sm); }
  }
</style>
