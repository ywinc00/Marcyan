---
// SERVICES CATALOG · /en/services — services hub (Track E).
// Gathers the 7 products (with tiers) into one navigable page, reusing the
// DS components (LandingHero, AnswerBlock, PriceGrid, RelatedLinks,
// FeatureGrid, Faq, CtaBand, Contact). Schema: OfferCatalog (all tiers)
// + ItemList (the 7 services) + BreadcrumbList.
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/layout/SiteNav.astro';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import LandingHero from '../../components/sections/LandingHero.astro';
import GrowthCta from '../../components/growthos/GrowthCta.astro';
import AnswerBlock from '../../components/sections/AnswerBlock.astro';
import PriceGrid from '../../components/sections/PriceGrid.astro';
import RelatedLinks from '../../components/sections/RelatedLinks.astro';
import FeatureGrid from '../../components/sections/FeatureGrid.astro';
import Faq from '../../components/sections/Faq.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import Contact from '../../components/sections/Contact.astro';
import OfferCatalogLd from '../../components/seo/OfferCatalogLd.astro';
import ItemListLd from '../../components/seo/ItemListLd.astro';
import SpaceBackdrop from '../../components/SpaceBackdrop.astro';
import { content } from '../../i18n/content';
import { clusterNavEn } from '../../i18n/clusters';
import { priceServices, offerItems } from '../../i18n/pricing.en';
import { serviciosPage as s } from '../../i18n/servicios.en';

const c = content.en;
---
<Layout
  title={s.meta.title}
  description={s.meta.description}
  lang="en"
  path="services"
>
  <Fragment slot="head">
    <OfferCatalogLd items={offerItems} url={s.path} name="Services and pricing — Marcyan Studio" />
    <ItemListLd items={s.itemList} name="Marcyan Studio services" />
  </Fragment>

  <SiteNav nav={clusterNavEn} lang="en" homeHref="/en/" currentPath={Astro.url.pathname} />

  <main id="main">
    <LandingHero
      variant="header"
      kicker={s.hero.kicker}
      h1={s.hero.h1}
      sub={s.hero.sub}
      primary={s.hero.primary}
      secondary={s.hero.secondary}
      chips={s.hero.chips}
      tone={s.hero.tone}
    >
      <Breadcrumb slot="breadcrumb" items={s.breadcrumb} lang="en" />
    </LandingHero>

    <AnswerBlock lang="en" q={s.answer.q} a={s.answer.a} />

    <PriceGrid lang="en" tag={s.grid.tag} title={s.grid.title} intro={s.grid.intro} items={priceServices} />

    <GrowthCta
      text="Torn between web, SEO, or AI?"
      linkLabel="The free checkup gives you your priority in 2 minutes"
      href="/en/checkup"
    />

    <RelatedLinks tag={s.related.tag} title={s.related.title} links={s.related.links} />

    <FeatureGrid tag={s.why.tag} title={s.why.title} items={s.why.items} tone={s.why.tone} />

    <Faq tag={s.faq.tag} title={s.faq.title} items={s.faq.items} />

    <CtaBand lang="en"
      title={s.cta.title}
      sub={s.cta.sub}
      primary={s.cta.primary}
      tone={s.cta.tone}
    />

    <Contact contact={c.contact} />

    {/* Home atmosphere (§1): a single fixed gold/teal + stars layer, so the
        hub does not look like a flat slab of --bg-base. tone="gold" = hub accent. */}
    <SpaceBackdrop tone="gold" />
  </main>

  <SiteFooter lang="en" footer={c.footer} />
</Layout>
