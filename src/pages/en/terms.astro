---
// /en/terms — Terms of Service (EN mirror of /terminos).
// Re-skinned to DS v2. Honest content mirrored from the ES page.
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/layout/SiteNav.astro';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import LegalDoc from '../../components/sections/LegalDoc.astro';
import { content, nap } from '../../i18n/content';
import { clusterNavEn } from '../../i18n/clusters';

// The nav CTA points to the CONTACT FORM (lead capture), not the brief.
const pageNav = { ...clusterNavEn, cta: { label: 'Get a free proposal', href: '/en/#contacto' } };
---
<Layout
  title="Terms of Service · Marcyan Studio"
  description="Terms and conditions for using Marcyan Studio's site and services: web design, AI, and SEO in Houston and Miami."
  lang="en"
  path="/en/terms"
  canonical="https://marcyanstudio.com/en/terms"
  hasEn={true}
>
  <SiteNav nav={pageNav} lang="en" homeHref="/en/" hasEn={true} currentPath={Astro.url.pathname} showCtaBar={false} />

  <main id="main">
    <LegalDoc title="Terms of Service" updated="June 6, 2026" updatedLabel="Last updated">
      <h2>1. Acceptance of the terms</h2>
      <p>By accessing and using the site <a href="https://marcyanstudio.com">marcyanstudio.com</a> you accept these Terms of Service. If you do not agree with them, we ask that you not use the site.</p>

      <h2>2. Who we are</h2>
      <p><strong>Marcyan Studio</strong> is an agency offering web design and development, applied artificial intelligence, e-commerce, SEO, local SEO, and branding services, serving Houston, TX and Miami, FL.</p>

      <h2>3. Use of the site</h2>
      <p>You agree to use the site lawfully and not to engage in activities that could damage it, disrupt it, or compromise its security, nor to extract data in an automated and abusive manner. We reserve the right to restrict access in the event of misuse.</p>

      <h2>4. Intellectual property</h2>
      <p>The site's content — text, design, graphics, logo, and the <strong>Marcyan Studio</strong> brand — is our property or used under license, and is protected by applicable laws. You may not reproduce or reuse it without our prior written authorization.</p>

      <h2>5. Forms and communications</h2>
      <p>The information you send us through the forms must be truthful and current. Submitting a form or request allows us to contact you, but <strong>does not by itself create a contractual services relationship</strong>: any project is governed by a separately accepted agreement or proposal.</p>

      <h2>6. Proposals, prices, and services</h2>
      <p>The prices and ranges we publish on the site are <strong>indicative</strong> and may vary depending on the scope of each project. Proposals and quotes are not binding until both parties formally accept them. We reserve the right to modify or discontinue services.</p>

      <h2>7. Third-party links</h2>
      <p>The site may include links to third-party sites. We do not control and are not responsible for their content or their privacy practices.</p>

      <h2>8. Warranties and limitation of liability</h2>
      <p>The site is provided "as is" and "as available," without warranties of any kind. To the extent permitted by law, Marcyan Studio will not be liable for indirect, incidental, or consequential damages arising from the use of the site.</p>

      <h2>9. Indemnification</h2>
      <p>You agree to hold Marcyan Studio harmless against claims arising from your misuse of the site or your breach of these terms.</p>

      <h2>10. Governing law</h2>
      <p>These terms are governed by the laws of the State of Texas, United States, without prejudice to consumer protection rules that are mandatory in your place of residence.</p>

      <h2>11. Changes to the terms</h2>
      <p>We may update these terms at any time. The current version, with its date, will always be posted on this page.</p>

      <h2>12. Contact</h2>
      <p>Questions about these terms? Write to us at <a href={`mailto:${nap.email}`}>{nap.email}</a>.</p>
    </LegalDoc>
  </main>

  <SiteFooter footer={content.en.footer} lang="en" />
</Layout>
