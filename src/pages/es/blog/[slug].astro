---
// RENDERER DE POST · /es/blog/[slug] — ensambla una pieza desde su Markdown.
// Estructura: Nav · Hero(kicker/título/fecha)+Breadcrumb · AnswerBlock (AEO) ·
// <Content/> (cuerpo Markdown estilizado) · FAQ (FAQPage) · Relacionados ·
// CtaBand · Contacto · Footer. Schema: BlogPosting + FAQPage + BreadcrumbList.
// El @graph base (Organization + 2 ProfessionalService) ya vive en el Layout.
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import SiteNav from '../../../components/layout/SiteNav.astro';
import SiteFooter from '../../../components/layout/SiteFooter.astro';
import Breadcrumb from '../../../components/ui/Breadcrumb.astro';
import ArticleHero from '../../../components/sections/ArticleHero.astro';
import AnswerBlock from '../../../components/sections/AnswerBlock.astro';
import Article from '../../../components/sections/Article.astro';
import ArticleToc from '../../../components/sections/ArticleToc.astro';
import Faq from '../../../components/sections/Faq.astro';
import PostNav from '../../../components/sections/PostNav.astro';
import RelatedLinks from '../../../components/sections/RelatedLinks.astro';
import CtaBand from '../../../components/sections/CtaBand.astro';
import Contact from '../../../components/sections/Contact.astro';
import ArticleLd from '../../../components/seo/ArticleLd.astro';
import SpaceBackdrop from '../../../components/SpaceBackdrop.astro';
import { content } from '../../../i18n/content';
import { clusterNav } from '../../../i18n/clusters';
import { postChrome } from '../../../i18n/blog';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft && data.lang !== 'en'))
    .sort((a, z) => z.data.datePublished.getTime() - a.data.datePublished.getTime());
  const ref = (p: (typeof posts)[number]) => ({ title: p.data.title, path: `/es/blog/${p.id}` });
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      prevPost: posts[i + 1] ? ref(posts[i + 1]) : null, // más antiguo
      nextPost: posts[i - 1] ? ref(posts[i - 1]) : null, // más reciente
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content, headings } = await render(post);

const c = content.es;
const d = post.data;
const slugPath = `/es/blog/${post.id}`;

const iso = (x: Date) => x.toISOString().slice(0, 10);
const fmt = (x: Date) => new Intl.DateTimeFormat('es', { dateStyle: 'long', timeZone: 'UTC' }).format(x);
const dateISO = iso(d.datePublished);
const updatedISO = d.updated ? iso(d.updated) : undefined;

// Tiempo de lectura honesto a partir del cuerpo Markdown (~200 palabras/min).
const words = (post.body ?? '').trim().split(/\s+/).filter(Boolean).length;
const readingMin = Math.max(1, Math.round(words / 200));
const readingLabel = `${readingMin} ${postChrome.readingSuffix}`;

const ogImage = d.ogImage ?? '/assets/og/og-default.png';
const crumbs = [...postChrome.root, { name: d.title, path: slugPath }];
const related = d.related.map((r) => ({ ...r, desc: r.desc ?? '' }));

// La ToC solo se monta con ≥3 H2 (mismo umbral que ArticleToc). Cuando existe, la
// lectura usa una grilla [ToC sticky | cuerpo]; si no, el cuerpo va a una sola columna.
const tocItems = headings.filter((h) => h.depth === 2);
const hasToc = tocItems.length >= 3;
---
<Layout
  title={`${d.title} | Marcyan Studio`}
  description={d.description}
  lang="es"
  path={`blog/${post.id}`}
  hasEn={false}
  ogImage={ogImage}
>
  <ArticleLd
    slot="head"
    headline={d.title}
    description={d.description}
    path={slugPath}
    datePublished={dateISO}
    dateModified={updatedISO}
    image={ogImage}
    section={d.tags[0]}
    keywords={d.tags}
  />

  <SiteNav nav={clusterNav} lang="es" homeHref="/es/" hasEn={false} currentPath="/es/blog" />

  <main id="main">
    <ArticleHero
      kicker={d.heroKicker ?? 'Blog de Marcyan'}
      badge={d.heroBadge}
      title={d.title}
      lead={d.description}
      dateISO={dateISO}
      dateLabel={fmt(d.datePublished)}
      readingLabel={readingLabel}
      tags={d.tags}
      topic={d.tags[0]}
    >
      <Breadcrumb slot="breadcrumb" items={crumbs} lang="es" />
    </ArticleHero>

    <AnswerBlock q={d.answer.q} a={d.answer.a} source={d.answer.source} />

    {/* Lectura: en desktop la ToC pegajosa acompaña la columna del artículo. */}
    <section class="section reader">
      <div class="container">
        <div class:list={['reader__grid', hasToc && 'reader__grid--toc']}>
          {hasToc && (
            <aside class="reader__aside">
              <ArticleToc headings={headings} label={postChrome.toc} />
            </aside>
          )}
          <Article><Content /></Article>
        </div>
      </div>
    </section>

    {d.faq.length > 0 && (
      <Faq tag={postChrome.faq.tag} title={postChrome.faq.title} items={d.faq} />
    )}

    <PostNav prev={prevPost} next={nextPost} indexHref="/es/blog" labels={postChrome.nav} />

    {related.length > 0 && (
      <RelatedLinks tag={postChrome.related.tag} title={postChrome.related.title} links={related} />
    )}

    <CtaBand
      title={postChrome.cta.title}
      sub={postChrome.cta.sub}
      primary={postChrome.cta.primary}
      secondary={postChrome.cta.secondary}
      tone={postChrome.cta.tone}
    />

    <Contact contact={c.contact} />
  </main>

  <SpaceBackdrop tone="gold" />

  <SiteFooter footer={c.footer} />
</Layout>

<style>
  /* Zona de lectura: ritmo más ceñido que una sección completa (la energía va al texto). */
  .reader { padding-block: var(--space-7); }
  .reader__grid { display: grid; grid-template-columns: 1fr; gap: var(--space-6); min-width: 0; }

  /* En móvil la ToC (details) va arriba del cuerpo, ocupando el ancho. */
  .reader__aside { min-width: 0; }

  @media (--lg) {
    /* Desktop: aside de ToC pegajosa + columna de lectura. La medida del cuerpo la
       controla Article (max 72ch); la columna 1fr le deja respirar a la derecha. */
    .reader__grid--toc {
      grid-template-columns: minmax(0, 16rem) minmax(0, 1fr);
      gap: var(--space-8);
      align-items: start;
    }
  }
</style>
