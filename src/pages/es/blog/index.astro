---
// ÍNDICE DEL BLOG · /es/blog. Plantilla v3 (rediseño WorkOS, design/rediseno-workos.md §4.7):
// la monta w/sections/blog/IndiceBlog.astro. Aquí solo el copy CONGELADO (meta, H1 verbatim,
// migas y nombre del Blog del JSON-LD, de src/i18n/blog.ts) y las guías ES por fecha.
// Schema: Blog (listado) + BreadcrumbList (del Breadcrumb), sin cambios.
import IndiceBlog from '../../../components/w/sections/blog/IndiceBlog.astro';
import { blogIndex as b } from '../../../i18n/blog';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft && data.lang !== 'en')).sort(
  (a, z) => z.data.datePublished.getTime() - a.data.datePublished.getTime(),
);
---
<IndiceBlog
  lang="es"
  meta={b.meta}
  h1Html={b.hero.h1}
  breadcrumb={b.breadcrumb}
  ldName="Blog de Marcyan Studio"
  posts={posts}
  emptyTitle={b.empty}
/>
