---
// DIAGNÓSTICO DIGITAL GRATIS · /es/diagnostico (espejo EN: /en/checkup).
// Plantilla v3 del rediseño WorkOS (design/rediseno-workos.md §4.9): el cuerpo vive en
// w/sections/diagnostico/Diagnostico.astro. Schema: Service (precio 0) + FAQPage (FAQ
// del wizard) + BreadcrumbList. hreflang/canonical los resuelve Layout vía routes.ts.
import Diagnostico from '../../components/w/sections/diagnostico/Diagnostico.astro';
import { GOS } from '../../i18n/growth-os';
import { GROWTH_OS } from '../../flags';

if (!GROWTH_OS) return Astro.redirect('/es/');

const t = GOS.es.page;
const service = {
  name: 'Diagnóstico digital gratis',
  serviceType: 'Diagnóstico de presencia digital',
  description: t.metaDesc,
  path: '/es/diagnostico',
  priceValue: '0',
};
const breadcrumb = [
  { name: 'Inicio', path: '/es' },
  { name: 'Diagnóstico digital', path: '/es/diagnostico' },
];
---
<Diagnostico lang="es" service={service} breadcrumb={breadcrumb} />
