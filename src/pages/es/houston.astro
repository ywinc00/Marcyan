---
// HUB DE CIUDAD · /es/houston — rediseño "el viaje" (2026-10-25, dirección en design/houston.md).
// Todo el contenido vive en HoustonHub (una sola pieza para ES y EN, sin duplicar 586 líneas por idioma);
// los textos, en i18n/houston.ts (bloque `journey` + las claves de siempre). Schema (ItemList + Breadcrumb +
// FAQPage), meta, los 19 enlaces del silo, las anclas y los nombres de seguimiento se mantienen.
// El pie es el del sitio; esta página cambia solo su cierre por la silueta de la ciudad (slot "scape").
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/layout/SiteNav.astro';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import ItemListLd from '../../components/seo/ItemListLd.astro';
import HoustonHub from '../../components/houston/HoustonHub.astro';
import HoustonScape from '../../components/houston/HoustonScape.astro';
import { content } from '../../i18n/content';
import { clusterNav } from '../../i18n/clusters';
import { houstonHub as h } from '../../i18n/houston';
import { portfolioProjects } from '../../i18n/portfolio';

const c = content.es;
---
<Layout
  title={h.meta.title}
  description={h.meta.description}
  lang="es"
  path="houston"
>
  <ItemListLd slot="head" items={h.itemList} name="Servicios de Marcyan en Houston" />
  <link rel="preload" href="/geo/houston-globo-110.json" as="fetch" crossorigin="anonymous" slot="head" />

  <SiteNav nav={clusterNav} lang="es" homeHref="/es/" currentPath={Astro.url.pathname} />

  <main id="main">
    <HoustonHub lang="es" h={h} c={c} projects={portfolioProjects} />
  </main>

  <SiteFooter footer={c.footer}>
    <HoustonScape slot="scape" />
  </SiteFooter>
</Layout>
