---
// HUB DE CIUDAD · /es/houston — LANDING PRINCIPAL de Houston (Ola 2).
// Página POTENTE nivel-home (DESIGN.md §2/§5): hero fuerte + showcase de ciudad
// con identidad local (skyline oficial + telemetría TX/coords, lenguaje de
// Locations.astro) + showcase de servicios con jerarquía (destacados + resto) +
// contexto local (Prose) + prueba (Projects) + FAQ + CTA. NO es una lista de
// RelatedLinks apilada. Conserva schema (ItemList + Breadcrumb), Contact con
// defaultCity Houston y hasEn=false. @graph base ya da la ProfessionalService.
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/layout/SiteNav.astro';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import Kicker from '../../components/ui/Kicker.astro';
import Icon from '../../components/ui/Icon.astro';
import LandingHero from '../../components/sections/LandingHero.astro';
import AnswerBlock from '../../components/sections/AnswerBlock.astro';
import RelatedLinks from '../../components/sections/RelatedLinks.astro';
import Prose from '../../components/sections/Prose.astro';
import Projects from '../../components/sections/Projects.astro';
import Faq from '../../components/sections/Faq.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import Contact from '../../components/sections/Contact.astro';
import SpaceBackdrop from '../../components/SpaceBackdrop.astro';
import ItemListLd from '../../components/seo/ItemListLd.astro';
import { content, nap } from '../../i18n/content';
import { clusterNav } from '../../i18n/clusters';
import { houstonHub as h } from '../../i18n/houston';

const c = content.es;
const telHref = nap.houston.replace(/[^\d+]/g, '');

// Silueta de Texas — geográficamente correcta (misma derivada de GeoJSON público
// que Locations.astro). Decorativa (aria-hidden).
const TX_SHAPE = {
  viewBox: '0 0 100 93.4',
  path: 'M100 49.6L98.7 54L96.4 60.8L91 61.3L89.7 60.9L89.4 62.4L88.1 65.8L81.3 70.4L78.1 71.9L75 73.8L69.4 82.6L69.9 84.7L69.9 86.8L68.6 93.4L62.3 91.6L56.2 86.1L55 83.1L53.7 79L47.6 70.6L44.6 64.7L36.5 59.7L32.4 60L29.2 62.2L27.9 65.2L23.8 65.7L15 58.6L9.5 50.3L0 41L27.3 31.2L27.8 0L50.6 17.3L53.9 18.6L58.4 20.3L63.1 20.9L65.2 22.3L68.2 22.5L74.7 23.7L80 23.7L89 23.5L95 25.9L96.1 31L97.7 42.1Z',
};

// Telemetría del nodo Houston — datos de localización ya presentes en el sitio
// (Locations.astro / NAP). Sin inventar cifras.
const cityMeta = [
  { ic: 'lucide:map-pin', label: 'Coordenadas', value: '29.7604° N, 95.3698° W' },
  { ic: 'lucide:radio', label: 'Cobertura', value: 'Área metropolitana' },
  { ic: 'lucide:languages', label: 'Idiomas', value: 'Español · Inglés' },
];

// Showcase de servicios: jerarquía real. Los primeros = destacados (tarjetas
// grandes); el resto = filas densas del mismo panel. Derivado del propio
// contenido honesto (h.services.links), sin inventar nada.
const svc = h.services.links;
const svcFeatured = svc.slice(0, 2);
const svcRest = svc.slice(2);
const isBrand = (icon?: string) => icon === 'marcyan-ai';
---
<Layout
  title={h.meta.title}
  description={h.meta.description}
  lang="es"
  path="houston"
  hasEn={false}
>
  <ItemListLd slot="head" items={h.itemList} name="Servicios de Marcyan en Houston" />

  <SiteNav nav={clusterNav} lang="es" homeHref="/es/" hasEn={false} currentPath={Astro.url.pathname} />

  <main id="main">
    <LandingHero
      badge={h.hero.badge}
      badgeIcon={h.hero.badgeIcon}
      kicker={h.hero.kicker}
      h1={h.hero.h1}
      sub={h.hero.sub}
      primary={h.hero.primary}
      secondary={h.hero.secondary}
      chips={h.hero.chips}
      tone={h.hero.tone}
    >
      <Breadcrumb slot="breadcrumb" items={h.breadcrumb} lang="es" />
    </LandingHero>

    {/* ── SHOWCASE DE CIUDAD ── identidad local con peso: skyline oficial + silueta
        TX + telemetría de coordenadas (lenguaje de Locations.astro). Panel translúcido
        que flota sobre la atmósfera, no losa plana. */}
    <section class="section citynode" aria-labelledby="citynode-title">
      <div class="container">
        <article class="citynode__panel">
          <div class="citynode__media" aria-hidden="true">
            <span class="citynode__tx">
              <svg viewBox={TX_SHAPE.viewBox} role="presentation" focusable="false"><path d={TX_SHAPE.path} fill="currentColor" /></svg>
            </span>
            <img class="citynode__sky" src="/assets/cities/houston.svg" alt="" loading="lazy" decoding="async" />
          </div>

          <div class="citynode__body">
            <div class="citynode__top">
              <span class="citynode__pin"><Icon name="lucide:map-pin" /></span>
              <span class="citynode__live"><span class="citynode__live-dot"></span>Nodo activo</span>
            </div>

            <Kicker>Houston · Space City</Kicker>
            <h2 class="citynode__title" id="citynode-title">Tu base de operaciones en <em>Houston</em></h2>
            <p class="citynode__lede">
              Operamos toda el área metropolitana como negocio de área de servicio,
              en español e inglés. Sin oficina pública: el proceso, de la propuesta
              a la entrega, ocurre en línea y en tu idioma.
            </p>

            <dl class="citynode__meta">
              {cityMeta.map((m) => (
                <div class="citynode__metarow">
                  <dt><Icon name={m.ic} /> {m.label}</dt>
                  <dd>{m.value}</dd>
                </div>
              ))}
            </dl>

            <div class="citynode__foot">
              <a class="citynode__tel" href={`tel:${telHref}`}>
                <Icon name="lucide:phone" /> {nap.houston}
              </a>
              <span class="citynode__pill">
                <svg class="citynode__pill-ic" viewBox={TX_SHAPE.viewBox} aria-hidden="true"><path d={TX_SHAPE.path} fill="currentColor" /></svg>
                Texas, USA
              </span>
            </div>
          </div>
        </article>
      </div>
    </section>

    <AnswerBlock q={h.answer.q} a={h.answer.a} source={h.answer.source} />

    {/* ── SHOWCASE DE SERVICIOS ── jerarquía real: 2 destacados (tarjetas grandes)
        + el resto en filas densas. NO 7 enlaces planos. Contenido = h.services.links. */}
    <section class="section svcshow" aria-labelledby="svcshow-title">
      <div class="container">
        <header class="svcshow__head">
          <Kicker>{h.services.tag}</Kicker>
          <h2 class="h2 svcshow__title" id="svcshow-title" set:html={h.services.title} />
        </header>

        <div class="svcshow__feat">
          {svcFeatured.map((l, i) => (
            <a class="svccard" href={l.href}>
              <span class="svccard__idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class:list={['svccard__icon', isBrand(l.icon) && 'svccard__icon--brand']}>
                <Icon name={l.icon ?? 'lucide:arrow-up-right'} />
              </span>
              <h3 class="svccard__label">{l.label}</h3>
              <p class="svccard__desc">{l.desc}</p>
              <span class="svccard__go">Ver servicio <Icon name="lucide:arrow-right" /></span>
            </a>
          ))}
        </div>

        <ul class="svcshow__rest" role="list">
          {svcRest.map((l, i) => (
            <li class="svcrow">
              <a class="svcrow__link" href={l.href}>
                <span class="svcrow__idx" aria-hidden="true">{String(i + 3).padStart(2, '0')}</span>
                <span class:list={['svcrow__icon', isBrand(l.icon) && 'svcrow__icon--brand']}>
                  <Icon name={l.icon ?? 'lucide:arrow-up-right'} />
                </span>
                <span class="svcrow__txt">
                  <span class="svcrow__label">{l.label}</span>
                  <span class="svcrow__desc">{l.desc}</span>
                </span>
                <Icon name="lucide:arrow-right" class="svcrow__go" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <RelatedLinks tag={h.industries.tag} title={h.industries.title} links={h.industries.links} />

    <RelatedLinks tag={h.zonas.tag} title={h.zonas.title} links={h.zonas.links} tone="teal" />

    <Prose
      tag={h.local.tag}
      title={h.local.title}
      paragraphs={h.local.paragraphs}
      tone={h.local.tone}
    />

    <Projects projects={c.projects} />

    <RelatedLinks tag={h.related.tag} title={h.related.title} links={h.related.links} />

    <Faq tag={h.faq.tag} title={h.faq.title} items={h.faq.items} />

    <CtaBand
      title={h.cta.title}
      sub={h.cta.sub}
      primary={h.cta.primary}
      secondary={h.cta.secondary}
      tone={h.cta.tone}
    />

    <Contact contact={c.contact} defaultCity="Houston, TX" />

    <SpaceBackdrop tone="gold" />
  </main>

  <SiteFooter footer={c.footer} />
</Layout>

<style>
  /* ════════ SHOWCASE DE CIUDAD (bespoke) ════════ */
  .citynode :global(em) { color: var(--accent-gold); font-style: normal; }

  .citynode__panel {
    position: relative; overflow: hidden; min-width: 0; isolation: isolate;
    display: grid; grid-template-columns: 1fr; gap: var(--space-6);
    border: 1px solid var(--border); border-radius: var(--radius-xl);
    padding: var(--space-6);
    background:
      radial-gradient(120% 90% at 100% 0%, var(--accent-gold-dim), transparent 58%),
      color-mix(in srgb, var(--bg-card) 78%, transparent);
  }

  /* media: skyline oficial (mismo tratamiento de máscara/blend que Locations) +
     silueta TX en marca de agua detrás */
  .citynode__media {
    position: relative; min-width: 0; min-height: 160px;
    display: flex; align-items: flex-end; justify-content: center;
    padding-block: var(--space-4);
  }
  .citynode__tx {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    color: var(--accent-gold); opacity: 0.06; pointer-events: none;
  }
  .citynode__tx svg { width: 70%; height: auto; max-height: 100%; }
  .citynode__sky {
    position: relative; z-index: 1; width: 100%; max-width: 460px; height: auto; display: block;
    mix-blend-mode: lighten;
    -webkit-mask-image: linear-gradient(180deg, #000 70%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 70%, transparent 100%);
  }

  .citynode__body { position: relative; z-index: 1; min-width: 0; display: flex; flex-direction: column; gap: var(--space-4); }
  .citynode__top { display: flex; align-items: center; gap: var(--space-3); }
  .citynode__pin {
    display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; border-radius: var(--radius-md);
    background: var(--accent-gold-dim); border: 1px solid var(--accent-gold-line); color: var(--accent-gold);
  }
  .citynode__pin :global(svg) { width: 20px; height: 20px; stroke-width: 1.5; }
  .citynode__live {
    display: inline-flex; align-items: center; gap: var(--space-2);
    font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: var(--tracking-wide);
    text-transform: uppercase; color: var(--accent-teal);
  }
  .citynode__live-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--accent-teal); box-shadow: 0 0 8px var(--accent-teal); }

  .citynode__title {
    font-family: var(--font-display); font-weight: 600; font-size: var(--fluid-h3);
    line-height: var(--leading-snug); letter-spacing: var(--tracking-tight); max-width: 18ch;
  }
  .citynode__lede { color: var(--fg-secondary); font-size: var(--text-md); line-height: var(--leading-loose); max-width: 56ch; }

  /* telemetría de datos en filas (dt/dd) con hairline */
  .citynode__meta { display: flex; flex-direction: column; gap: 0; margin: 0; }
  .citynode__metarow {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-4);
    padding: var(--space-3) 0; border-top: 1px solid var(--border-subtle); min-width: 0;
  }
  .citynode__metarow:last-child { border-bottom: 1px solid var(--border-subtle); }
  .citynode__metarow dt {
    display: inline-flex; align-items: center; gap: var(--space-2); min-width: 0;
    font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: var(--tracking-wide);
    text-transform: uppercase; color: var(--fg-secondary);
  }
  .citynode__metarow dt :global(svg) { width: 15px; height: 15px; color: var(--accent-gold); flex: 0 0 auto; stroke-width: 1.5; }
  .citynode__metarow dd {
    margin: 0; font-family: var(--font-mono); font-size: var(--text-sm); color: var(--fg-primary);
    text-align: right; min-width: 0; overflow-wrap: anywhere;
  }

  .citynode__foot { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); margin-top: var(--space-1); }
  .citynode__tel {
    display: inline-flex; align-items: center; gap: var(--space-2); min-height: var(--tap-min);
    padding: var(--space-2) var(--space-4); border-radius: var(--radius-md);
    background: var(--accent-gold-dim); border: 1px solid var(--accent-gold-line);
    font-family: var(--font-mono); font-size: var(--text-sm); color: var(--accent-gold);
    transition: border-color var(--duration-fast), color var(--duration-fast);
  }
  .citynode__tel :global(svg) { width: 16px; height: 16px; flex: 0 0 auto; stroke-width: 1.5; }
  .citynode__tel:hover { border-color: var(--accent-gold); color: color-mix(in srgb, var(--accent-gold), white 12%); }
  .citynode__pill {
    display: inline-flex; align-items: center; gap: var(--space-2);
    padding: var(--space-2) var(--space-3); border-radius: var(--radius-pill);
    background: var(--bg-elevated); border: 1px solid var(--border);
    font-family: var(--font-mono); font-size: var(--text-xs); color: var(--fg-secondary); white-space: nowrap;
  }
  .citynode__pill-ic { width: 14px; height: 14px; color: var(--accent-gold); flex: 0 0 auto; }

  @media (--md) {
    .citynode__panel { padding: var(--space-8); gap: var(--space-8); align-items: center; }
  }
  @media (--lg) {
    .citynode__panel { grid-template-columns: 0.9fr 1.1fr; }
    .citynode__media { order: 2; min-height: 220px; }
    .citynode__body { order: 1; }
  }

  /* ════════ SHOWCASE DE SERVICIOS (bespoke, con jerarquía) ════════ */
  .svcshow :global(em) { color: var(--accent-gold); font-style: normal; }
  .svcshow__head { display: flex; flex-direction: column; gap: var(--space-3); margin-bottom: var(--space-6); }
  .svcshow__title { max-width: 20ch; }

  /* destacados: tarjetas grandes con jerarquía */
  .svcshow__feat { display: grid; grid-template-columns: 1fr; gap: var(--space-4); margin-bottom: var(--space-4); }

  .svccard {
    position: relative; overflow: hidden; min-width: 0;
    display: flex; flex-direction: column; gap: var(--space-3);
    padding: var(--space-6); border: 1px solid var(--border); border-radius: var(--radius-lg);
    background:
      radial-gradient(120% 100% at 0% 0%, var(--accent-gold-dim), transparent 52%),
      var(--bg-card);
    text-decoration: none; color: inherit;
    transition: border-color var(--duration-base) var(--ease-out-expo), transform var(--duration-base) var(--ease-out-expo);
  }
  .svccard:hover { border-color: var(--border-accent); transform: translateY(-3px); }
  .svccard:focus-visible { outline: 2px solid var(--accent-gold); outline-offset: 2px; }
  .svccard__idx {
    position: absolute; top: var(--space-5); right: var(--space-5);
    font-family: var(--font-mono); font-size: var(--text-sm); color: var(--fg-subtle);
    letter-spacing: var(--tracking-wide);
  }
  .svccard__icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 48px; height: 48px; border-radius: var(--radius-md);
    background: var(--accent-gold-dim); border: 1px solid var(--accent-gold-line); color: var(--accent-gold);
  }
  .svccard__icon :global(svg) { width: 24px; height: 24px; stroke-width: 1.5; }
  .svccard__label {
    font-family: var(--font-display); font-size: var(--text-lg); font-weight: 600;
    color: var(--fg-primary); line-height: var(--leading-snug); max-width: 22ch;
  }
  .svccard__desc { color: var(--fg-secondary); font-size: var(--text-base); line-height: var(--leading-normal); max-width: 46ch; }
  .svccard__go {
    margin-top: auto; padding-top: var(--space-2);
    display: inline-flex; align-items: center; gap: var(--space-2);
    font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: var(--tracking-wide);
    text-transform: uppercase; color: var(--accent-gold);
  }
  .svccard__go :global(svg) { width: 15px; height: 15px; flex: 0 0 auto; transition: transform var(--duration-base) var(--ease-out-expo); }
  .svccard:hover .svccard__go :global(svg) { transform: translateX(4px); }

  /* resto: filas densas, mismo lenguaje que RelatedLinks */
  .svcshow__rest {
    list-style: none; display: grid; grid-template-columns: 1fr; gap: 2px;
    border-top: 1px solid var(--border-subtle);
  }
  .svcrow { min-width: 0; border-bottom: 1px solid var(--border-subtle); }
  .svcrow__link {
    display: flex; align-items: center; gap: var(--space-4); min-height: 56px;
    padding: var(--space-3) var(--space-2); border-radius: var(--radius-md);
    text-decoration: none; color: inherit;
    transition: background var(--duration-fast) var(--ease-out-expo);
  }
  .svcrow__link:hover { background: var(--bg-elevated); }
  .svcrow__link:focus-visible { outline: 2px solid var(--accent-gold); outline-offset: -2px; background: var(--bg-elevated); }
  .svcrow__idx {
    flex: 0 0 auto; font-family: var(--font-mono); font-size: var(--text-xs);
    color: var(--fg-subtle); letter-spacing: var(--tracking-wide); transition: color var(--duration-fast);
  }
  .svcrow__link:hover .svcrow__idx, .svcrow__link:focus-visible .svcrow__idx { color: var(--accent-gold); }
  .svcrow__icon {
    flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center;
    width: 40px; height: 40px; border-radius: var(--radius-md);
    background: var(--accent-gold-dim); border: 1px solid var(--accent-gold-line); color: var(--accent-gold);
  }
  .svcrow__icon :global(svg) { width: 20px; height: 20px; stroke-width: 1.5; }
  .svcrow__txt { display: flex; flex-direction: column; gap: 1px; min-width: 0; flex: 1; }
  .svcrow__label { font-family: var(--font-display); font-size: var(--text-md); font-weight: 600; color: var(--fg-primary); line-height: var(--leading-snug); }
  .svcrow__desc { color: var(--fg-secondary); font-size: var(--text-sm); line-height: var(--leading-normal); }
  .svcshow__rest :global(.svcrow__go) {
    flex: 0 0 auto; width: 18px; height: 18px; color: var(--fg-subtle);
    transition: transform var(--duration-base) var(--ease-out-expo), color var(--duration-base);
  }
  .svcrow__link:hover :global(.svcrow__go), .svcrow__link:focus-visible :global(.svcrow__go) { color: var(--accent-gold); transform: translateX(4px); }

  @media (--md) {
    .svcshow__feat { grid-template-columns: 1fr 1fr; gap: var(--space-5); margin-bottom: var(--space-5); }
  }

  @media (--motion-reduce) {
    .svccard:hover { transform: none; }
    .svccard:hover .svccard__go :global(svg),
    .svcrow__link:hover :global(.svcrow__go) { transform: none; }
  }
</style>
