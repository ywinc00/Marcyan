---
// LANDING · /es/houston/seo-para-ia · "SEO para IA / Visibilidad en IA" (AEO).
// Página a medida v3 del rediseño WorkOS (design/rediseno-workos.md §4.17, tarea 2-seo-ia).
// Fuera del verificador de landings: la vigila scripts/w/verify-extra.mjs (un H1 verbatim,
// ServiceLd con tiers = Offer×3, FAQPage = texto visible, BreadcrumbList, trío, anclas).
//
// Contraste: el túnel del hero (W-ADV-28) es la superficie distinta de la página (no hay
// .w-contrast ni .w-dawn). Firma: ninguna en bucle (la respuesta del asistente del hero se
// escribe UNA vez). Degradado: el titular del cierre (sin cola en el H1, R2).
// Orden: hero → prosa "no te confundas" → 01 cada asistente → 02 lo que dices y lo que
// entiende → 03 qué cambiamos (#que-cambiamos) → 04 la ficha que leen → 05 cómo empezamos
// (#precios) → prosa de casos → franja "En pocas palabras" → FAQ (#faq) → hermanas →
// cierre → Contact (#contacto).
// Lo congelado (H1, meta, path, breadcrumb, answer, faq, distinction, mechanics, caso0,
// grid, cta.title, service, precios) se pinta TAL CUAL desde i18n/seo-ia.ts, que no se toca.
// El copy nuevo (libre) vive aquí abajo, en `t`.
import Layout from '../../../layouts/Layout.astro';
import SiteNav from '../../../components/layout/SiteNav.astro';
import SiteFooter from '../../../components/layout/SiteFooter.astro';
import Breadcrumb from '../../../components/ui/Breadcrumb.astro';
import Contact from '../../../components/sections/Contact.astro';
import ServiceLd from '../../../components/seo/ServiceLd.astro';
import SpaceBackdrop from '../../../components/SpaceBackdrop.astro';
import WStyles from '../../../components/w/WStyles.astro';
import HeroTexto from '../../../components/w/HeroTexto.astro';
import TunelRejilla from '../../../components/w/objetos/TunelRejilla.astro';
import RespuestaAsistente from '../../../components/w/objetos/RespuestaAsistente.astro';
import ProsaLocal from '../../../components/w/ProsaLocal.astro';
import CabeceraNumerada from '../../../components/w/CabeceraNumerada.astro';
import GratisDeVerdad from '../../../components/w/GratisDeVerdad.astro';
import TarjetaPrecio from '../../../components/w/TarjetaPrecio.astro';
import FranjaEnPocasPalabras from '../../../components/w/FranjaEnPocasPalabras.astro';
import PreguntasFrecuentes from '../../../components/w/PreguntasFrecuentes.astro';
import TarjetasHermanas from '../../../components/w/TarjetasHermanas.astro';
import CierreDosTarjetas from '../../../components/w/CierreDosTarjetas.astro';
import CadaAsistente from '../../../components/w/sections/seo-ia/CadaAsistente.astro';
import DiceEntiende from '../../../components/w/sections/seo-ia/DiceEntiende.astro';
import QueCambiamos from '../../../components/w/sections/seo-ia/QueCambiamos.astro';
import FichaAgentes from '../../../components/w/sections/seo-ia/FichaAgentes.astro';
import { content, nap } from '../../../i18n/content';
import { clusterNav } from '../../../i18n/clusters';
import { catalog } from '../../../i18n/pricing';
import { serviciosPara } from '../../../i18n/w/nav';
import { seoIaPage as p, aeoTiers } from '../../../i18n/seo-ia';

const c = content.es;
const usd = (n: number) => '$' + n.toLocaleString('en-US');

/** "Desde $X" (o "al mes") del ancla baja de cada producto, desde pricing.ts (como el piloto). */
const anchorOf = (id: string) => {
  const s = catalog.find((x) => x.id === id);
  if (!s) return undefined;
  const tier = s.tiers.find((x) => x.anchor) ?? s.tiers[0];
  if (tier.value === null) return undefined;
  return tier.monthly ? `Desde ${usd(tier.value)} al mes` : `Desde ${usd(tier.value)}`;
};

// Títulos a dos tonos para ProsaLocal: mismo texto del dato, partido en dos frases.
const splitTitle = (html: string, at: string): [string, string] => {
  const i = html.indexOf(at);
  return i < 0 ? [html, ''] : [html.slice(0, i).trim(), html.slice(i).trim()];
};
// Nombres de clientes sin traducir (E-24): solo se envuelven, el texto no cambia.
const noTranslate = (html: string) =>
  html.replace(/(Texas Rush Remove|Move Junk Away)/g, '<span translate="no">$1</span>');

const [diag, cimientos, monitoreo] = aeoTiers;
const telH = 'tel:' + nap.houston.replace(/[^\d+]/g, '');
const waH = 'https://wa.me/' + nap.houston.replace(/\D/g, '');

// ── Copy NUEVO (libre) · sin guiones conectores, "dominamos" la IA, ejemplos rotulados ──
const t = {
  eyebrow: 'Que la IA te nombre',
  lead: 'Cuando le pregunten a la IA, que diga tu nombre. Preparamos tu negocio de Houston para que ChatGPT, Gemini y Google te encuentren y te recomienden, en español.',
  primary: 'Diagnóstico de IA gratis',
  question: '¿Qué plomero de Houston atiende en español?',
  business: 'Tu Plomería',
  asistentes: {
    label: 'Cada asistente, su respuesta',
    title: 'La misma pregunta, cuatro asistentes',
    lead: 'Cada uno arma su respuesta con fuentes distintas. Preparamos tu información para todos, no solo para Google.',
    intro: 'Tu cliente no pregunta en un solo sitio. Por eso cuidamos lo que lee cada asistente.',
    traits: [
      { icon: 'lucide:message-square', text: 'ChatGPT busca sobre todo en Bing.' },
      { icon: 'lucide:globe', text: 'Perplexity cita las páginas que lee, con su enlace.' },
      { icon: 'lucide:sparkles', text: 'Gemini se apoya en la búsqueda de Google.' },
      { icon: 'lucide:search', text: 'Google resume la respuesta en la misma página de resultados.' },
    ],
    sourcesLabel: 'Leyó',
    tabs: [
      { id: 'chatgpt', label: 'ChatGPT', kind: 'Responde ChatGPT', answer: { pre: 'Te sugiero ', biz: 'Tu Plomería', post: ': atiende en español e inglés, trabaja en Katy y Sugar Land y hoy abre hasta las 6 p. m.' }, sources: ['Bing Places', 'tunegocio.example'] },
      { id: 'perplexity', label: 'Perplexity', kind: 'Responde Perplexity', answer: { pre: '', biz: 'Tu Plomería', post: ' es un servicio de plomería en Houston con atención en español. En su web indica sus zonas y su horario.', refs: true }, sources: ['tunegocio.example/servicios', 'tunegocio.example/preguntas'] },
      { id: 'gemini', label: 'Gemini', kind: 'Responde Gemini', answer: { pre: 'Una opción es ', biz: 'Tu Plomería', post: ', en Houston: atiende en los dos idiomas y cubre Katy y Sugar Land.' }, sources: ['Ficha de empresa', 'tunegocio.example'] },
      { id: 'google', label: 'Google', kind: 'Resumen en la búsqueda de Google', answer: { pre: '', biz: 'Tu Plomería', post: ' es un plomero de Houston con atención en español. Abre de lunes a sábado, de 8 a 6.' }, sources: ['Ficha de mapa', 'tunegocio.example'] },
    ],
  },
  dice: {
    label: 'Lo que dices y lo que entiende la IA',
    cardTitle: 'De tu web a datos que la IA lee',
    colSay: 'En tu web',
    colData: 'Para la IA',
    rows: [
      { say: 'Abrimos de lunes a sábado, de 8 a 6', key: 'openingHours', value: '"Mo-Sa 08:00-18:00"' },
      { say: 'Hablamos español e inglés', key: 'availableLanguage', value: '["es", "en"]' },
      { say: 'Trabajamos en Katy y Sugar Land', key: 'areaServed', value: '["Katy", "Sugar Land"]' },
      { say: 'Somos plomeros', key: '@type', value: '"Plumber"' },
    ],
    title: 'Lo que ya dices, en el formato que la IA entiende',
    lead: 'Un párrafo se puede malinterpretar; un dato estructurado no. Pasamos tu horario, tus zonas y tus idiomas a schema, el formato que leen Google, Bing y los asistentes.',
    link: 'Ver qué cambiamos',
  },
  cambiamos: {
    label: 'Qué cambiamos',
    card: {
      name: 'Tu Plomería',
      kind: 'Plomero · Houston, TX',
      rows: [
        { k: 'Bing Places', v: 'Al día' },
        { k: 'Schema', v: 'En cada página' },
        { k: 'Preguntas', v: 'ES y EN' },
        { k: 'Nombre y teléfono', v: 'Iguales' },
      ],
      result: 'Lista para que la IA la cite',
    },
  },
  ficha: {
    label: 'La ficha que leen los asistentes',
    title: 'Un archivo que le explica tu negocio a la IA',
    lead: 'Además del schema, dejamos en tu web un llms.txt: un resumen en texto plano de quién eres, qué haces y dónde trabajas, pensado para los asistentes.',
    file: {
      name: 'tunegocio.example/llms.txt',
      kind: 'Texto',
      foot: 'Cada negocio lleva el suyo, escrito con sus datos reales.',
      lines: [
        { t: 'h1', text: '# Tu Plomería' },
        { t: 'q', text: '> Plomeros en Houston. Atendemos en español e inglés.' },
        { t: 'sp' },
        { t: 'h2', text: '## Servicios' },
        { t: 'li', text: '- Reparación de fugas' },
        { t: 'li', text: '- Destapado de drenajes' },
        { t: 'li', text: '- Calentadores de agua' },
        { t: 'sp' },
        { t: 'h2', text: '## Zonas' },
        { t: 'li', text: '- Houston, Katy y Sugar Land' },
        { t: 'sp' },
        { t: 'h2', text: '## Horario' },
        { t: 'li', text: '- Lunes a sábado, de 8:00 a 18:00' },
        { t: 'sp' },
        { t: 'h2', text: '## Contacto' },
        { t: 'li', text: '- Teléfono y WhatsApp en tunegocio.example/contacto' },
      ] as { t: 'h1' | 'q' | 'h2' | 'li' | 'sp'; text?: string }[],
    },
    prompt: { title: 'Lo que pregunta tu cliente', kind: 'Ejemplo', text: '¿Qué plomero de Houston atiende en español y abre el sábado?', biz: 'Tu Plomería', reply: ' atiende en español e inglés y abre los sábados, de 8:00 a 18:00.', source: 'Fuente: tunegocio.example/llms.txt' },
    notes: [
      { k: 'Índice', text: 'llms.txt resume tu negocio en una sola página que la IA lee rápido.' },
      { k: 'Datos estructurados', text: 'El schema de cada página dice tu horario, tus zonas y tus servicios.' },
    ],
  },
  gratis: {
    items: [
      { icon: 'lucide:radar', text: diag.includes![0] },
      { icon: 'lucide:map-pin', text: diag.includes![1] },
      { icon: 'lucide:list-checks', text: diag.includes![2] },
      { icon: 'lucide:languages', text: 'En español, para tu mercado local' },
    ] as [{ icon: string; text: string }, { icon: string; text: string }, { icon: string; text: string }, { icon: string; text: string }],
    checks: [diag.includes![3], 'Te decimos con honestidad cómo estás'],
  },
  desde: 'Desde',
  precioNote: { title: '¿Empiezas por el diagnóstico?', text: 'Es gratis y te dice qué te falta antes de pagar nada.' },
  franja: {
    queEs: 'Qué es',
    desdeT: 'Desde cuánto',
    tiempoT: 'En cuánto tiempo',
    desde: `Diagnóstico gratis. Cimientos desde ${cimientos.displayPrice} y monitoreo desde ${monitoreo.displayPrice} al mes.`,
    tiempo: 'Propuesta en 24 horas. Las primeras señales suelen tomar semanas.',
    verQue: 'Ver qué cambiamos',
    verPrecios: 'Ver precios',
    pedir: 'Pedir diagnóstico',
  },
  hermanas: {
    title: "<span class='w-tone'>Que la IA te nombre es el principio.</span> Lo demás te trae el cliente.",
    lead: 'Servicios de Marcyan en Houston que trabajan junto al SEO para IA.',
    guia: { title: 'Guía: aparecer en ChatGPT', text: 'El paso a paso, si quieres entenderlo a fondo.' },
    diag: { title: 'Diagnóstico gratis', text: 'Mira cómo te ven hoy tu web y tu ficha.' },
    precios: { title: 'Precios', text: 'Todos los precios de entrada, a la vista.' },
  },
  cierre: {
    proof: 'Lo aplicamos en nuestro sitio y en el de nuestros clientes en Houston y Orlando.',
    warmTitle: '¿Quieres verlo tú primero?',
    warmText: 'Haz el diagnóstico gratis y mira qué encuentra la IA sobre tu negocio.',
    warmCta: 'Hacer el diagnóstico',
  },
};

const [dTone1, dTone2] = splitTitle(p.distinction.title, '≠');
const [cTone1, cTone2] = splitTitle(p.caso0.title, 'y en el de');
---
<Layout
  title={p.meta.title}
  description={p.meta.description}
  lang="es"
  path="houston/seo-para-ia"
  ds="v3"
>
  <ServiceLd slot="head" {...p.service} />
  <WStyles />

  <SiteNav nav={clusterNav} lang="es" homeHref="/es" currentPath={Astro.url.pathname} />

  <main id="main" class="w-rails" data-w data-w-tone="teal" data-w-kind="seo-ia">
    <!-- 1 · Hero: túnel de rejilla a ventana completa; texto en el rectángulo limpio; la
         respuesta del asistente debajo del rectángulo, fuera del túnel. -->
    <section class="w-hero--bleed sh">
      <div class="w-container sh__crumbs">
        <Breadcrumb items={p.breadcrumb} lang="es" />
      </div>
      <div class="sh__room">
        <TunelRejilla class="sh__tunnel" />
        <div class="w-container sh__text">
          <HeroTexto
            eyebrow={t.eyebrow}
            tone="teal"
            h1Html={p.hero.h1}
            lead={t.lead}
            primary={{ label: t.primary, href: '/es/diagnostico', track: 'tool_cta_clicked' }}
            size="night"
          />
        </div>
      </div>
      <div class="w-container sh__obj" data-w-in="obj">
        <RespuestaAsistente variant="tarjeta" size="hero" question={t.question} business={t.business} class="sh__ans" />
      </div>
    </section>

    <!-- 2 · No te confundas (distinction, VERBATIM). -->
    <section class="w-cell">
      <div class="w-container" data-w-reveal>
        <ProsaLocal titleTone1={dTone1} titleTone2={dTone2} paragraphs={p.distinction.paragraphs} />
      </div>
    </section>

    <!-- 3 · 01 Cada asistente, su respuesta (W-HOME-11). -->
    <section class="w-cell">
      <div class="w-container" data-w-reveal>
        <CadaAsistente n={1} {...t.asistentes} titleHtml={t.asistentes.title} question={t.question} />
      </div>
    </section>

    <!-- 4 · 02 Lo que dices y lo que entiende la IA (W-CORE-28). -->
    <section class="w-cell">
      <div class="w-container" data-w-reveal>
        <DiceEntiende
          n={2}
          label={t.dice.label}
          cardTitle={t.dice.cardTitle}
          colSay={t.dice.colSay}
          colData={t.dice.colData}
          rows={t.dice.rows}
          titleHtml={t.dice.title}
          lead={t.dice.lead}
          link={{ label: t.dice.link, href: '#que-cambiamos' }}
        />
      </div>
    </section>

    <!-- 5 · 03 Qué cambiamos (W-CORE-34 estático, mechanics VERBATIM). -->
    <section class="w-cell" id="que-cambiamos">
      <div class="w-container" data-w-reveal>
        <QueCambiamos n={3} label={t.cambiamos.label} titleHtml={p.mechanics.title} items={p.mechanics.items} card={t.cambiamos.card} />
      </div>
    </section>

    <!-- 6 · 04 La ficha que leen los asistentes (W-NEW-38). -->
    <section class="w-cell">
      <div class="w-container" data-w-reveal>
        <FichaAgentes n={4} label={t.ficha.label} titleHtml={t.ficha.title} lead={t.ficha.lead} file={t.ficha.file} prompt={t.ficha.prompt} notes={t.ficha.notes} />
      </div>
    </section>

    <!-- 7 · 05 Cómo empezamos (#precios): el diagnóstico gratis + las dos tarjetas de precio. -->
    <section class="w-cell" id="precios">
      <div class="w-container" data-w-reveal>
        <CabeceraNumerada n={5} label={p.grid.tag} titleHtml={p.grid.title} lead={p.grid.intro} />
        <div class="sp">
          <GratisDeVerdad
            items={t.gratis.items}
            title={diag.displayPrice}
            sub={diag.name}
            checks={t.gratis.checks}
            cta={{ label: diag.ctaLabel, href: diag.href, track: 'pricing_card_clicked' }}
            tone="teal"
            class="sp__free"
          />
          {[cimientos, monitoreo].map((tier, i) => (
            <TarjetaPrecio
              serviceId="seo-ia"
              name={tier.name}
              desc={tier.description}
              tiers={[{ label: t.desde, price: tier.displayPrice!, unit: tier.monthly ? 'al mes' : tier.displayUnit }]}
              includes={tier.includes}
              cta={{ label: tier.ctaLabel!, href: tier.href! }}
              note={i === 0 ? t.precioNote : undefined}
              tone="teal"
            />
          ))}
        </div>
      </div>
    </section>

    <!-- 8 · Casos reales (caso0, VERBATIM). -->
    <section class="w-cell">
      <div class="w-container" data-w-reveal>
        <ProsaLocal titleTone1={cTone1} titleTone2={cTone2} paragraphs={p.caso0.paragraphs.map(noTranslate)} />
      </div>
    </section>

    <!-- 9 · En pocas palabras (answer VERBATIM), justo antes de la FAQ (R1). -->
    <section class="w-cell">
      <div class="w-container" data-w-reveal>
        <FranjaEnPocasPalabras
          q={p.answer.q}
          a={p.answer.a}
          source={p.answer.source}
          lang="es"
          cols={[
            { title: t.franja.queEs, text: catalog.find((s) => s.id === 'seo-ia')!.tagline, link: { label: t.franja.verQue, href: '#que-cambiamos' } },
            { title: t.franja.desdeT, text: t.franja.desde, link: { label: t.franja.verPrecios, href: '#precios' } },
            { title: t.franja.tiempoT, text: t.franja.tiempo, link: { label: t.franja.pedir, href: '#contacto' } },
          ]}
        />
      </div>
    </section>

    <!-- 9 · Preguntas frecuentes (#faq), VERBATIM, todas cerradas; emite FAQPage. -->
    <section class="w-cell">
      <div class="w-container" data-w-reveal>
        <PreguntasFrecuentes id="faq" tag={p.faq.tag} titleHtml={p.faq.title} items={p.faq.items} lang="es" />
      </div>
    </section>

    <!-- 10 · Hermanas de Houston (hrefs = los del megamenú de esta página, R5). -->
    <section class="w-cell">
      <div class="w-container" data-w-reveal>
        <TarjetasHermanas
          titleHtml={t.hermanas.title}
          lead={t.hermanas.lead}
          currentId="seo-ia"
          lang="es"
          items={serviciosPara('es', p.path).map((s) => ({ id: s.id, label: s.name, desc: s.promise, href: s.href, price: anchorOf(s.id) }))}
          recursos={[
            { icon: 'lucide:book-open', title: t.hermanas.guia.title, text: t.hermanas.guia.text, href: '/es/blog/como-aparecer-en-chatgpt-perplexity' },
            { icon: 'lucide:scan-search', title: t.hermanas.diag.title, text: t.hermanas.diag.text, href: '/es/diagnostico', track: 'tool_cta_clicked' },
            { icon: 'lucide:tag', title: t.hermanas.precios.title, text: t.hermanas.precios.text, href: '/es/precios' },
          ]}
        />
      </div>
    </section>

    <!-- 11 · Cierre en dos tarjetas (trío contractual, teléfono de Houston); degradado único. -->
    <section class="w-cell">
      <div class="w-container" data-w-reveal>
        <CierreDosTarjetas
          titleHtml={p.cta.title}
          proof={t.cierre.proof}
          city="houston"
          tel={telH}
          wa={waH}
          lang="es"
          grad
          warm={{ kind: 'diagnostico', title: t.cierre.warmTitle, text: t.cierre.warmText, cta: t.cierre.warmCta, href: '/es/diagnostico' }}
        />
      </div>
    </section>

    <!-- 12 · Contacto (#contacto): sin data-w-in ni data-w-reveal (§2.9). -->
    <Contact contact={c.contact} defaultCity="Houston, TX" defaultService="SEO para IA (visibilidad en IA)" />
  </main>

  <SpaceBackdrop tone="teal" />

  <SiteFooter footer={c.footer} />
</Layout>

<style>
  /* ── Hero (W-ADV-28) ──
     El "cuarto" del túnel es el bloque de texto; el túnel se coloca alrededor con top/bottom
     en % de ESE bloque, de modo que su rectángulo central (600/1080 del alto del túnel cuando
     manda el alto) mide exactamente el texto + 96 px: alto del túnel = 1,8·T + 172,8 px, y
     sobra (0,4·T + 86,4 px) arriba y abajo. A lo ancho cubre la ventana entera (E-36); en
     pantallas anchas manda el ancho y el rectángulo crece (nunca queda texto sobre la rejilla).
     En móvil las paredes laterales caen fuera de la pantalla: solo techo y suelo (§4.17). */
  .sh { position: relative; overflow: clip; padding-top: calc(var(--nav-h) + 20px); }
  .sh__crumbs { position: relative; z-index: 2; }
  /* Las migas caen sobre el techo del túnel: van sobre una capa opaca de noche para que la
     rejilla nunca corra detrás de su texto (E-37). El texto sigue en la línea del logo. */
  .sh__crumbs :global(nav) {
    display: inline-block; margin-left: -10px; padding: 4px 10px; border-radius: var(--w-r-cell);
    background: var(--w-s0);
    /* Velo de noche que se funde alrededor de la placa: ninguna línea del túnel llega a rozar
       el texto de las migas (control rev1 m-5). */
    box-shadow: 0 0 24px 18px var(--w-s0);
  }
  .sh__crumbs :global(ol) { padding-inline-start: 0; margin: 0; }
  /* Margen superior algo más corto que en la ronda 1: a 1440×900 la tarjeta del hero entra
     entera en la primera pantalla (control rev1 m-1). */
  .sh__room { position: relative; margin-top: clamp(96px, 6vw + 20px, 140px); }
  .sh__room :global(.sh__tunnel) {
    inset: auto; left: calc(50% - 50vw); right: calc(50% - 50vw);
    top: calc(-40% - 86.4px); bottom: calc(-40% - 86.4px);
  }
  .sh__text { position: relative; z-index: 1; }
  .sh__text :global(.w-herotext) { max-width: 680px; }
  .sh__text :global(.w-eyebrow) { font-size: clamp(1.125rem, 0.95rem + 0.45vw, 1.5rem); }
  .sh__text :global(.w-lead) { max-width: 36rem; }
  .sh__obj { position: relative; z-index: 1; display: flex; justify-content: center; margin-top: 64px; padding-bottom: 96px; }
  .sh__obj :global(.sh__ans) { width: min(100%, 460px); }
  /* La respuesta se escribe cuando la tarjeta ya terminó de entrar (coreografía §2.9:
     el objeto entra a .5 s en 950 ms; sin este retraso se escribía a opacidad 0). */
  .sh__obj :global(.wo-ans.is-run .wo-ans__step),
