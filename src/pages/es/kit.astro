---
// /es/kit/<token> — Kit de arranque privado del cliente (segundo momento del
// brief, Orbit v2 · B1). vercel.json reescribe /es/kit/:token a esta página;
// la isla KitApp lee el token de la ruta (en local también ?t=<token>) y
// habla con /api/kit/:token. noindex y fuera del sitemap.
// (La galería del design system que vivía aquí pasó a /es/kit-diseno.)
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/layout/SiteNav.astro';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import SpaceBackdrop from '../../components/SpaceBackdrop.astro';
import BtnStates from '../../components/ui/BtnStates.astro';
import KitApp from '../../components/brief/KitApp.svelte';
import { content, nap } from '../../i18n/content';
import { clusterNav } from '../../i18n/clusters';

const wa = `https://wa.me/${nap.houston.replace(/\D/g, '')}`;
const pageNav = { ...clusterNav, cta: { label: 'WhatsApp', href: wa, track: 'whatsapp_clicked' } };
---
<Layout
  title="Kit de arranque · Marcyan Studio"
  description="Tu enlace privado para mandarnos lo que necesitamos para arrancar tu proyecto."
  lang="es"
  path="/es/kit"
  hasEn={false}
  noindex={true}
>
  <!-- El enlace lleva un token: que no viaje como Referer a otros sitios. -->
  <meta slot="head" name="referrer" content="same-origin" />
  <SiteNav nav={pageNav} lang="es" homeHref="/es/" hasEn={true} currentPath={Astro.url.pathname} showCtaBar={false} />

  <main id="main" class="kitp">
    <div class="container kitp__inner">
      <KitApp client:load lang="es" phone={nap.houston} />
      <noscript>
        <p class="kitp__nojs">Para completar tu kit necesitas activar JavaScript. También puedes llamarnos al <a href={`tel:${nap.houston.replace(/[^\d+]/g, '')}`}>{nap.houston}</a> o escribirnos por <a href={wa}>WhatsApp</a>.</p>
      </noscript>
    </div>
  </main>

  <SpaceBackdrop tone="teal" density={0.8} />
  <SiteFooter footer={content.es.footer} />

  <!-- Carga una vez los estilos globales de BtnStates (contrato .bstate/.bst de los botones de la isla). No se pinta. -->
  <template><button class="bstate" type="button"><BtnStates sending="" done="">.</BtnStates></button></template>
  <script is:inline>
    // El cambio de idioma conserva el token del enlace (si no, iría a /en/ sin kit).
    (function () {
      var m = /\/(?:es|en)\/kit\/([^/?#]+)/.exec(location.pathname);
      var tok = m ? m[1] : new URLSearchParams(location.search).get('t');
      if (!tok) return;
      document.querySelectorAll('a.nav__lang-opt[hreflang]').forEach(function (a) {
        var l = a.getAttribute('hreflang');
        a.setAttribute('href', m ? '/' + l + '/kit/' + tok : '/' + l + '/kit?t=' + encodeURIComponent(tok));
      });
    })();
  </script>
  {import.meta.env.DEV && <script is:inline src="/dev/brief-mock.js"></script>}
</Layout>

<style>
  .kitp { padding-top: calc(var(--nav-h) + var(--space-7)); padding-bottom: var(--space-9); }
  .kitp__inner { max-width: 1160px; }
  .kitp__nojs { color: var(--fg-secondary); }
  .kitp__nojs a { color: var(--accent-gold); }
</style>
