---
// HUB DE CIUDAD · /es/miami — rediseño "el viaje" (2026-11-01): la base del hub de Houston con los elementos de
// Miami (el planeta se acerca a Miami-Dade, sus zonas y búsquedas, su mapa real y su skyline al anochecer en el pie).
// Todo el contenido vive en CityHub (una sola pieza para Houston y Miami en ES y EN); los textos, en i18n/miami.ts
// (bloque `journey` + las claves de siempre). Schema (ItemList + Breadcrumb + FAQPage), meta, enlaces a los servicios
// y barrios de Miami, anclas y nombres de seguimiento se mantienen. Proyectos: MJA, rotulado con su ciudad real
// (Orlando, Florida), por ser el más cercano; GNS se sumará cuando esté terminado.
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/layout/SiteNav.astro';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import ItemListLd from '../../components/seo/ItemListLd.astro';
import CityHub from '../../components/city/CityHub.astro';
import CityScape from '../../components/city/CityScape.astro';
import { content } from '../../i18n/content';
import { clusterNav } from '../../i18n/clusters';
import { miamiHub as h } from '../../i18n/miami';
import { portfolioProjects } from '../../i18n/portfolio';

const c = content.es;
---
<Layout
  title={h.meta.title}
  description={h.meta.description}
  lang="es"
  path="miami"
>
  <ItemListLd slot="head" items={h.itemList} name="Servicios de Marcyan en Miami" />
  <link rel="preload" href="/geo/miami-globo-110.json" as="fetch" crossorigin="anonymous" slot="head" />

  <SiteNav nav={clusterNav} lang="es" homeHref="/es" currentPath={Astro.url.pathname} />

  <main id="main">
    <CityHub lang="es" city="miami" h={h} c={c} projects={portfolioProjects} />
  </main>

  <SiteFooter footer={c.footer} starDensity={1.35}>
    <CityScape slot="scape" src="/assets/miami/skyline.svg" ratio="2400 / 640" x="52%" />
  </SiteFooter>
</Layout>
