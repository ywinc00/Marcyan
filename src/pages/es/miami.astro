---
// HUB DE CIUDAD · /es/miami — LANDING PRINCIPAL de Miami (rediseño "Aproximación").
// Espejo en FUERZA del patrón premium de Houston (DESIGN.md §2/§5), con hero
// bespoke propio:
//   1. MiamiApproachHero (torre de control MIA: mesa en perspectiva + radar +
//      señales + H1 por líneas + compás de scroll + riel de telemetría),
//   2. Servicios CON PRECIO (id="servicios": 2 destacadas asimétricas + 2 filas),
//   3. GrowthCta (calculadoras) — Growth OS integrado,
//   4. Ficha Miami (contexto local honesto + riel NAP + barrios como pills-ruta
//      + palmera oficial en la esquina),
//   5. GrowthTeaser (diagnóstico gratis),
//   6. AnswerBlock + FAQ (AEO, texto verbatim),
//   7. Franja "Sigue explorando" slim → CtaBand → micro-reaseguro → Contact.
// Silo intacto: 4 servicios + 2 barrios (ahora en la Ficha) + 3 related.
// Schema (ItemList + Breadcrumb) y meta INTACTOS. Honestidad DURA: SIN clientes
// locales en Miami → sin Projects y sin proof local inventado.
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/layout/SiteNav.astro';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import Kicker from '../../components/ui/Kicker.astro';
import Icon from '../../components/ui/Icon.astro';
import MiamiApproachHero from '../../components/sections/city/MiamiApproachHero.astro';
import AnswerBlock from '../../components/sections/AnswerBlock.astro';
import Faq from '../../components/sections/Faq.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import Contact from '../../components/sections/Contact.astro';
import SpaceBackdrop from '../../components/SpaceBackdrop.astro';
import ItemListLd from '../../components/seo/ItemListLd.astro';
import GrowthTeaser from '../../components/sections/GrowthTeaser.astro';
import GrowthCta from '../../components/growthos/GrowthCta.astro';
import { content } from '../../i18n/content';
import { clusterNav } from '../../i18n/clusters';
import { miamiHub as h } from '../../i18n/miami';

const c = content.es;

// Silueta de Florida — geográficamente correcta (misma fuente que Locations).
// En la Ficha va a COLOR PLENO en un pill de dato (14px). Decorativa.
const FL_SHAPE = {
  viewBox: '0 0 100 86.4',
  path: 'M100 62.6L97.3 78.6L93.9 86.4L85 86L80.3 75.9L76.7 73.1L72.9 64.6L71.8 60.8L66.6 55.1L68.9 47.1L65.2 38.2L64 29.8L61 27.1L55.5 19.8L47.5 13.3L41.9 15.9L30.7 17.7L13.2 9L3.5 8.5L0 1.9L28.1 0L36.4 4.2L73.5 9.5L77.8 3.7L82.2 10.8L92.7 38.5L95.4 48.6Z',
};

// Showcase de servicios con precio: los 2 primeros = tarjetas destacadas
// (web + IA, los pilares); los 2 restantes = filas densas con columna de precio.
const svc = h.services.links;
const svcFeatured = svc.slice(0, 2);
const svcRest = svc.slice(2);
const isBrand = (icon?: string) => icon === 'marcyan-ai';
// Separa "desde" (label xs) de la cifra (numeral mono) del display de precio.
const splitPrice = (p?: string) =>
  p && p.startsWith('desde ') ? { pre: 'desde', amt: p.slice(6) } : { pre: '', amt: p ?? '' };
---
<Layout
  title={h.meta.title}
  description={h.meta.description}
  lang="es"
  path="miami"

>
  <ItemListLd slot="head" items={h.itemList} name="Servicios de Marcyan en Miami" />

  <SiteNav nav={clusterNav} lang="es" homeHref="/es/" currentPath={Astro.url.pathname} />

  <main id="main">
    <MiamiApproachHero
      kicker={h.hero.kicker}
      h1Lines={h.hero.h1Lines}
      sub={h.hero.sub}
      primary={h.hero.primary}
      microcopy={h.hero.microcopy}
      explore={h.hero.explore}
      telemetry={h.hero.telemetry}
      senales={h.hero.senales}
    >
      <Breadcrumb slot="breadcrumb" items={h.breadcrumb} lang="es" />
    </MiamiApproachHero>

    {/* ── SERVICIOS CON PRECIO ── el riel promete "precios públicos"; aquí se
        cumple: 2 destacadas asimétricas con numeral + 2 filas con columna de
        precio. Los 4 <a> del silo de servicios, intactos. */}
    <section class="section svcprice" id="servicios" aria-labelledby="svcprice-title">
      <div class="container">
        <header class="svcprice__head">
          <Kicker>{h.services.tag}</Kicker>
          <h2 class="h2 svcprice__title" id="svcprice-title" set:html={h.services.title} />
        </header>

        <div class="svcprice__feat">
          {svcFeatured.map((l, i) => {
            const p = splitPrice(l.price);
            return (
              <a class="pcard" href={l.href}>
                <span class="pcard__idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class:list={['pcard__icon', isBrand(l.icon) && 'pcard__icon--brand']}>
                  <Icon name={l.icon ?? 'lucide:arrow-up-right'} />
                </span>
                <h3 class="pcard__label">{l.label}</h3>
                <p class="pcard__desc">{l.desc}</p>
                <span class="pcard__price">
                  {p.pre && <span class="pcard__from">{p.pre}</span>}
                  <span class="pcard__amt">{p.amt}</span>
                </span>
                <span class="pcard__go">Ver servicio <Icon name="lucide:arrow-right" /></span>
              </a>
            );
          })}
        </div>

        <ul class="svcprice__rest" role="list">
          {svcRest.map((l, i) => {
            const p = splitPrice(l.price);
            return (
              <li class="svcrow">
                <a class="svcrow__link" href={l.href}>
                  <span class="svcrow__idx" aria-hidden="true">{String(i + 3).padStart(2, '0')}</span>
                  <span class:list={['svcrow__icon', isBrand(l.icon) && 'svcrow__icon--brand']}>
                    <Icon name={l.icon ?? 'lucide:arrow-up-right'} />
                  </span>
                  <span class="svcrow__txt">
                    <span class="svcrow__label">{l.label}</span>
                    <span class="svcrow__desc">{l.desc}</span>
                  </span>
                  <span class="svcrow__price">
                    {p.pre && <span class="svcrow__from">{p.pre} </span>}{p.amt}
                  </span>
                  <Icon name="lucide:arrow-right" class="svcrow__go" />
                </a>
              </li>
            );
          })}
        </ul>

        {/* única fuga legítima de la sección: el hub de precios completo */}
        <div class="svcprice__foot">
          <a class="svcprice__all" href="/es/precios">
            Ver todos los precios <Icon name="lucide:arrow-right" />
          </a>
        </div>
      </div>
    </section>

    <GrowthCta
      text="¿Te suena? Llamadas que no alcanzas a contestar, citas que no llegan. Ponle número en 30 segundos."
      linkLabel="Calculadoras gratis"
      href="/es/herramientas"
    />

    {/* ── FICHA MIAMI ── contexto local honesto (Cliente Fundador) + riel NAP
        (dt/dd con hairlines) + barrios como pills-ruta + palmera oficial. */}
    <section class="section ficha" aria-labelledby="ficha-title">
      <div class="container">
        <article class="ficha__panel">
          {/* palmera/skyline oficial — decorativa, esquina inferior derecha */}
          <div class="ficha__illo" aria-hidden="true">
            <img src="/assets/cities/miami.svg" alt="" loading="lazy" decoding="async" width="322" height="235" />
          </div>

          <div class="ficha__body">
            <Kicker>{h.local.tag}</Kicker>
            <h2 class="ficha__title" id="ficha-title" set:html={h.local.title} />
            {h.local.paragraphs.map((p) => (
              <p class="ficha__p" set:html={p} />
            ))}
          </div>

          <aside class="ficha__rail" aria-label="Datos de contacto y cobertura en Miami">
            <dl class="ficha__meta">
              {h.ficha.meta.map((m) => (
                <div class="ficha__row">
                  <dt><Icon name={m.ic} /> {m.label}</dt>
                  <dd>
                    {m.href ? <a href={m.href} data-track="call_clicked">{m.value}</a> : m.value}
                  </dd>
                </div>
              ))}
            </dl>

            <div class="ficha__pills">
              <span class="ficha__state">
                <svg class="ficha__state-ic" viewBox={FL_SHAPE.viewBox} aria-hidden="true"><path d={FL_SHAPE.path} fill="currentColor" /></svg>
                {h.ficha.statePill}
              </span>
            </div>

            <h3 class="ficha__zonestitle" set:html={h.ficha.zonesTitle} />
            <div class="ficha__zones">
              {h.ficha.zones.map((z) => (
                <a class="ficha__zone" href={z.href}>
                  <Icon name={z.icon ?? 'lucide:map-pin'} class="ficha__zone-pin" />
                  <span>{z.label}</span>
                  <Icon name="lucide:arrow-right" class="ficha__zone-arr" />
                </a>
              ))}
            </div>
          </aside>
        </article>
      </div>
    </section>

    <GrowthTeaser lang="es" city="miami" />

    {/* respuesta AEO citable (texto/fuente VERBATIM), adyacente al FAQ */}
    <AnswerBlock q={h.answer.q} a={h.answer.a} source={h.answer.source} />

    <Faq tag={h.faq.tag} title={h.faq.title} items={h.faq.items} />

    {/* ── SIGUE EXPLORANDO ── franja slim: los 3 related como lista inline. */}
    <section class="explore" aria-label={h.related.tag}>
      <div class="container explore__row">
        <Kicker>{h.related.tag}</Kicker>
        <ul class="explore__list" role="list">
          {h.related.links.map((l) => (
            <li>
              <a class="explore__link" href={l.href}>
                <span>{l.label}</span>
                <Icon name="lucide:arrow-right" class="explore__arr" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* remate: CTA → micro-reaseguro → formulario (ciudad preseleccionada). */}
    <div class="finale">
      <CtaBand
        title={h.cta.title}
        sub={h.cta.sub}
        primary={h.cta.primary}
        tone={h.cta.tone}
        city="miami"
      />

      <section class="reassure" aria-label="Compromisos de servicio">
        <div class="container">
          <p class="reassure__txt">{h.reassure}</p>
        </div>
      </section>

      <Contact contact={c.contact} defaultCity="Miami, FL" />
    </div>

    <SpaceBackdrop tone="gold" />
  </main>

  <SiteFooter footer={c.footer} />
</Layout>

<style>
  /* ════════ SERVICIOS CON PRECIO (bespoke, patrón Houston) ════════
     El precio vive en su propio slot: numeral mono en --fg-primary que solo se
     dora en hover (disciplina de acento). Chips de icono NEUTROS. */
  .svcprice :global(em) { color: var(--accent-gold); font-style: normal; }
  .svcprice__head { display: flex; flex-direction: column; gap: var(--space-3); margin-bottom: var(--space-6); }
  .svcprice__title { max-width: 20ch; }

  /* destacadas: asimetría 1.4fr/1fr en desktop (jerarquía real, no gemelas) */
  .svcprice__feat { display: grid; grid-template-columns: 1fr; gap: var(--space-4); margin-bottom: var(--space-5); }

  .pcard {
    position: relative; overflow: hidden; min-width: 0;
    display: flex; flex-direction: column; gap: var(--space-3);
    padding: var(--space-6); border: 1px solid var(--border); border-radius: var(--radius-lg);
    background:
      radial-gradient(120% 100% at 0% 0%, var(--accent-gold-dim), transparent 52%),
      var(--bg-card);
    text-decoration: none; color: inherit;
    transition: border-color var(--duration-base) var(--ease-out-expo), transform var(--duration-base) var(--ease-out-expo);
  }
  .pcard:hover { border-color: var(--border-accent); transform: translateY(-3px); }
  .pcard:focus-visible { outline: 2px solid var(--accent-gold); outline-offset: 2px; }
  .pcard__idx {
    position: absolute; top: var(--space-5); right: var(--space-5);
    font-family: var(--font-mono); font-size: var(--text-sm); color: var(--fg-subtle);
    letter-spacing: var(--tracking-wide); font-variant-numeric: tabular-nums;
  }
  .pcard__icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 48px; height: 48px; border-radius: var(--radius-md);
    background: var(--bg-elevated); border: 1px solid var(--border); color: var(--fg-secondary);
    transition: color var(--duration-fast), border-color var(--duration-fast);
  }
  .pcard__icon :global(svg) { width: 24px; height: 24px; stroke-width: 1.5; }
  .pcard:hover .pcard__icon, .pcard:focus-visible .pcard__icon { color: var(--accent-gold); border-color: var(--accent-gold-line); }
  .pcard__icon--brand, .pcard:hover .pcard__icon--brand { color: var(--accent-gold); }
  .pcard__label {
    font-family: var(--font-display); font-size: var(--text-lg); font-weight: 600;
    color: var(--fg-primary); line-height: var(--leading-snug); max-width: 22ch;
  }
  .pcard__desc { color: var(--fg-secondary); font-size: var(--text-base); line-height: var(--leading-normal); max-width: 46ch; }

  .pcard__price {
    margin-top: auto; padding-top: var(--space-4);
    border-top: 1px solid var(--border-subtle);
    display: flex; flex-direction: column; gap: 2px; min-width: 0;
  }
  .pcard__from {
    font-family: var(--font-mono); font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide); text-transform: uppercase; color: var(--fg-secondary);
  }
  .pcard__amt {
    font-family: var(--font-mono); font-size: var(--text-xl); font-weight: 500;
    color: var(--fg-primary); font-variant-numeric: tabular-nums;
    transition: color var(--duration-base) var(--ease-out-expo);
  }
  .pcard:hover .pcard__amt, .pcard:focus-visible .pcard__amt { color: var(--accent-gold); }
  .pcard__go {
    display: inline-flex; align-items: center; gap: var(--space-2); padding-top: var(--space-2);
    font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: var(--tracking-wide);
    text-transform: uppercase; color: var(--accent-gold);
  }
  .pcard__go :global(svg) { width: 15px; height: 15px; flex: 0 0 auto; transition: transform var(--duration-base) var(--ease-out-expo); }
  .pcard:hover .pcard__go :global(svg) { transform: translateX(4px); }

  /* filas densas 03–04 con COLUMNA DE PRECIO mono a la derecha */
  .svcprice__rest {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: 1fr; gap: 0;
    border-top: 1px solid var(--border-subtle);
  }
  .svcrow { min-width: 0; border-bottom: 1px solid var(--border-subtle); }
  .svcrow__link {
    display: grid; column-gap: var(--space-3); row-gap: 2px; align-items: center;
    grid-template-columns: auto auto minmax(0, 1fr);
    grid-template-areas:
      'idx icon txt'
      'idx icon price';
    min-height: 56px; padding: var(--space-3) var(--space-2);
    border-radius: var(--radius-md); text-decoration: none; color: inherit;
    transition: background var(--duration-fast) var(--ease-out-expo);
  }
  .svcrow__link:hover { background: var(--bg-elevated); }
  .svcrow__link:focus-visible { outline: 2px solid var(--accent-gold); outline-offset: -2px; background: var(--bg-elevated); }
  .svcrow__idx {
    grid-area: idx; font-family: var(--font-mono); font-size: var(--text-xs);
    color: var(--fg-subtle); letter-spacing: var(--tracking-wide);
    font-variant-numeric: tabular-nums; transition: color var(--duration-fast);
  }
  .svcrow__link:hover .svcrow__idx, .svcrow__link:focus-visible .svcrow__idx { color: var(--accent-gold); }
  .svcrow__icon {
    grid-area: icon; display: inline-flex; align-items: center; justify-content: center;
    width: 40px; height: 40px; border-radius: var(--radius-md);
    background: var(--bg-elevated); border: 1px solid var(--border); color: var(--fg-secondary);
    transition: color var(--duration-fast), border-color var(--duration-fast);
  }
  .svcrow__icon :global(svg) { width: 20px; height: 20px; stroke-width: 1.5; }
  .svcrow__icon--brand, .svcrow__link:hover .svcrow__icon--brand { color: var(--accent-gold); }
  .svcrow__link:hover .svcrow__icon, .svcrow__link:focus-visible .svcrow__icon { color: var(--accent-gold); border-color: var(--accent-gold-line); }
  .svcrow__txt { grid-area: txt; display: flex; flex-direction: column; gap: 1px; min-width: 0; }
  .svcrow__label { font-family: var(--font-display); font-size: var(--text-md); font-weight: 600; color: var(--fg-primary); line-height: var(--leading-snug); }
  .svcrow__desc { color: var(--fg-secondary); font-size: var(--text-sm); line-height: var(--leading-normal); }
  .svcrow__price {
    grid-area: price; justify-self: start; min-width: 0;
    font-family: var(--font-mono); font-size: var(--text-sm); color: var(--fg-primary);
    font-variant-numeric: tabular-nums; white-space: nowrap;
    transition: color var(--duration-fast);
  }
  .svcrow__from { font-size: var(--text-xs); color: var(--fg-secondary); text-transform: uppercase; letter-spacing: var(--tracking-wide); }
  .svcrow__link:hover .svcrow__price, .svcrow__link:focus-visible .svcrow__price { color: var(--accent-gold); }
  .svcprice__rest :global(.svcrow__go) { display: none; }

  .svcprice__foot { display: flex; justify-content: flex-end; padding-top: var(--space-4); }
  .svcprice__all {
    display: inline-flex; align-items: center; gap: var(--space-2); min-height: var(--tap-min);
    padding-inline: var(--space-2);
    font-family: var(--font-mono); font-size: var(--text-sm); letter-spacing: var(--tracking-wide);
    color: var(--fg-secondary); text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out-expo);
  }
  .svcprice__all :global(svg) { width: 15px; height: 15px; flex: 0 0 auto; transition: transform var(--duration-base) var(--ease-out-expo); }
  .svcprice__all:hover, .svcprice__all:focus-visible { color: var(--accent-gold); }
  .svcprice__all:hover :global(svg), .svcprice__all:focus-visible :global(svg) { transform: translateX(4px); }

  @media (--md) {
    .svcprice__feat { grid-template-columns: 1.4fr 1fr; gap: var(--space-5); }
    .svcrow__link {
      grid-template-columns: auto auto minmax(0, 1fr) auto auto;
      grid-template-areas: 'idx icon txt price arrow';
      column-gap: var(--space-4);
    }
    .svcrow__price { justify-self: end; text-align: right; }
    .svcprice__rest :global(.svcrow__go) {
      display: block; grid-area: arrow; width: 18px; height: 18px; color: var(--fg-subtle);
      transition: transform var(--duration-base) var(--ease-out-expo), color var(--duration-base);
    }
    .svcrow__link:hover :global(.svcrow__go), .svcrow__link:focus-visible :global(.svcrow__go) { color: var(--accent-gold); transform: translateX(4px); }
  }

  /* ════════ FICHA MIAMI (bespoke: contexto + riel NAP + palmera) ════════ */
  .ficha :global(em) { color: var(--accent-gold); font-style: normal; }
  .ficha__panel {
    position: relative; overflow: hidden; min-width: 0; isolation: isolate;
    display: grid; grid-template-columns: 1fr; gap: var(--space-6);
    border: 1px solid var(--border); border-radius: var(--radius-xl);
    padding: var(--space-6);
    background:
      radial-gradient(120% 90% at 100% 0%, var(--accent-gold-dim), transparent 58%),
      color-mix(in srgb, var(--bg-card) 78%, transparent);
  }
  /* palmera oficial: esquina inferior derecha, difuminada hacia la izquierda.
     mix-blend lighten colapsa su lavado oscuro (truco documentado en Locations). */
  .ficha__illo {
    position: absolute; right: 0; bottom: 0; z-index: -1;
    width: clamp(160px, 34%, 280px); pointer-events: none;
    -webkit-mask-image: linear-gradient(300deg, #000 42%, transparent 100%);
    mask-image: linear-gradient(300deg, #000 42%, transparent 100%);
  }
  .ficha__illo img { width: 100%; height: auto; display: block; mix-blend-mode: lighten; }

  .ficha__body { min-width: 0; display: flex; flex-direction: column; gap: var(--space-4); }
  .ficha__title {
    font-family: var(--font-display); font-weight: 600; font-size: var(--fluid-h3);
    line-height: var(--leading-snug); letter-spacing: var(--tracking-tight); max-width: 18ch;
  }
  .ficha__p { color: var(--fg-secondary); font-size: var(--text-md); line-height: var(--leading-loose); max-width: 58ch; }
  .ficha__p :global(strong) { color: var(--fg-primary); font-weight: 600; }

  .ficha__rail { min-width: 0; display: flex; flex-direction: column; }
  .ficha__meta { display: flex; flex-direction: column; margin: 0; }
  .ficha__row {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-4);
    padding: var(--space-3) 0; border-top: 1px solid var(--border-subtle); min-width: 0;
  }
  .ficha__row:last-child { border-bottom: 1px solid var(--border-subtle); }
  .ficha__row dt {
    display: inline-flex; align-items: center; gap: var(--space-2); min-width: 0; flex: 0 0 auto;
    font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: var(--tracking-wide);
    text-transform: uppercase; color: var(--fg-secondary);
  }
  .ficha__row dt :global(svg) { width: 15px; height: 15px; color: var(--accent-gold); flex: 0 0 auto; stroke-width: 1.5; }
  .ficha__row dd {
    margin: 0; font-family: var(--font-mono); font-size: var(--text-sm); color: var(--fg-primary);
    font-variant-numeric: tabular-nums; text-align: right; min-width: 0; overflow-wrap: anywhere;
  }
  .ficha__row dd a { position: relative; color: inherit; transition: color var(--duration-fast); }
  .ficha__row dd a::after {
    content: ""; position: absolute; left: 0; right: 0;
    top: 50%; height: var(--tap-min); transform: translateY(-50%);
  }
  .ficha__row dd a:hover, .ficha__row dd a:focus-visible { color: var(--accent-gold); }

  .ficha__pills { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-4); }
  .ficha__state {
    display: inline-flex; align-items: center; gap: var(--space-2);
    padding: var(--space-2) var(--space-3); border-radius: var(--radius-pill);
    background: var(--bg-elevated); border: 1px solid var(--border);
    font-family: var(--font-mono); font-size: var(--text-xs); color: var(--fg-secondary); white-space: nowrap;
