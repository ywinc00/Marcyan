---
// SOBRE NOSOTROS · /es/sobre-nosotros · v3 (rediseño WorkOS, design/rediseno-workos.md §4.6).
// Contraste: .w-dawn de la 1.ª sección (la placa encendida). Firma: encendido ÚNICO de la
// PlacaLogo (no bucle). Degradado: titular del cierre (sin cola, R2).
// Orden: hero compacto centrado → 1 placa + capítulo + historia → 01 datos → 02 proceso
// (#proceso) → 03 por qué → 04 sedes (#ciudades) → fundadores → En pocas palabras → FAQ a la
// vista (#faq) → salida suave → cierre en dos tarjetas → Contact (#contacto).
// Schema: AboutPage (→ Organization del @graph) + BreadcrumbList + FAQPage, idénticos a la
// base. ⚠️ HONESTIDAD: sin nodo Person ni AggregateRating hasta tener el dato real (el
// bloque de plantilla sigue abajo, comentado).
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/layout/SiteNav.astro';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import Contact from '../../components/sections/Contact.astro';
import SpaceBackdrop from '../../components/SpaceBackdrop.astro';
import AboutPageLd from '../../components/seo/AboutPageLd.astro';
import WStyles from '../../components/w/WStyles.astro';
import HeroTexto from '../../components/w/HeroTexto.astro';
import PlacaLogo from '../../components/w/objetos/PlacaLogo.astro';
import CapituloDosFrases from '../../components/w/CapituloDosFrases.astro';
import CabeceraNumerada from '../../components/w/CabeceraNumerada.astro';
import Especificaciones from '../../components/w/Especificaciones.astro';
import CuatroRazones from '../../components/w/CuatroRazones.astro';
import FranjaEnPocasPalabras from '../../components/w/FranjaEnPocasPalabras.astro';
import PreguntasAbiertas from '../../components/w/PreguntasAbiertas.astro';
import CierreDosTarjetas from '../../components/w/CierreDosTarjetas.astro';
import Fundadores from '../../components/w/sections/sobre/Fundadores.astro';
import SalidaSuave from '../../components/w/sections/sobre/SalidaSuave.astro';
import Proceso from '../../components/w/sections/sobre/Proceso.astro';
import Sedes from '../../components/w/sections/sobre/Sedes.astro';
import { content, nap } from '../../i18n/content';
import { clusterNav } from '../../i18n/clusters';
import { sobreNosotros as a } from '../../i18n/sobre-nosotros';
import { sobreCopy } from '../../i18n/w/sobre';

const lang = 'es' as const;
const c = content[lang];
const t = sobreCopy[lang];
const plain = (s: string) => s.replace(/<br\s*\/?>/gi, ' ').replace(/<\/?em>/gi, '').replace(/\s+/g, ' ').trim();
const fases = c.process.steps.map((s: { n: string; title: string; desc: string }) => ({ phase: `${t.proceso.step} ${s.n}`, block: s.title, gets: s.desc }));
const razones = a.values.items.map((v) => ({ icon: v.icon, title: v.title, text: v.desc })) as [any, any, any, any];
const tel = 'tel:' + nap.houston.replace(/[^\d+]/g, '');
const wa = 'https://wa.me/' + nap.houston.replace(/\D/g, '');
---
<Layout
  title={a.meta.title}
  description={a.meta.description}
  lang="es"
  path="sobre-nosotros"
  ds="v3"
>
  <AboutPageLd slot="head" name={a.meta.title} description={a.meta.description} path={a.path} />
  <WStyles />

  {/*
    TODO E-E-A-T (cuando el dueño entregue los datos reales): añadir el nodo Person
    del fundador + foto, y enriquecer la Organization con foundingDate y sameAs.
    PROHIBIDO inventarlos. Plantilla lista para descomentar y completar:

    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'Person',
      name: 'NOMBRE_REAL_DEL_FUNDADOR',
      jobTitle: 'Fundador',
      worksFor: { '@id': 'https://marcyanstudio.com/#organization' },
      image: 'https://marcyanstudio.com/assets/team/fundador.jpg',
      sameAs: ['https://www.linkedin.com/in/...', 'https://instagram.com/...'],
    })} />

    También: AggregateRating está listo en lib/schema.ts (aggregateRating) pero NO se
    emite hasta tener reseñas reales con consentimiento. No inventar reseñas.
  */}

  <SiteNav nav={clusterNav} lang="es" homeHref="/es" currentPath={Astro.url.pathname} />

  <main id="main" class="w-rails" data-w data-w-tone="gold">
    {/* Hero: cabecera compacta centrada (A-04, E-05). H1 verbatim, sin cola (R2). */}
    <section class="w-hero wsb-hero">
      <div class="w-container">
        <HeroTexto
          eyebrow={a.hero.kicker}
          tone="gold"
          chip={t.hero.chip}
          h1Html={a.hero.h1}
          lead={t.hero.lead}
          primary={{ label: t.hero.primary, href: '#contacto', track: 'proposal_requested' }}
          link={{ label: t.hero.link, href: t.hero.linkHref }}
          size="hub"
        >
          <Breadcrumb slot="crumbs" items={a.breadcrumb} lang="es" />
        </HeroTexto>
      </div>
    </section>

    {/* 1 · Contraste .w-dawn: la placa con el logo de empresa se enciende una vez. */}
    <section class="w-cell w-dawn wsb-story">
      <div class="w-container">
        <PlacaLogo lang="es" size="hero" class="wsb-plate" />
        <div data-w-reveal>
          <CapituloDosFrases tone1={t.capitulo.tone1} tone2={t.capitulo.tone2} />
          <div class="wsb-prose">
            {a.story.paragraphs.map((p) => <p set:html={p} />)}
          </div>
        </div>
      </div>
    </section>

    {/* 2 · 01 Datos, no adjetivos. */}
    <section class="w-cell">
      <div class="w-container" data-w-reveal>
        <CabeceraNumerada n={1} label={t.datos.label} titleHtml={t.datos.title} lead={t.datos.lead} />
        <div class="wsb-gap"><Especificaciones cells={t.datos.cells} /></div>
      </div>
    </section>

    {/* 3 · 02 Cómo es un proyecto (#proceso, de content.process; Process.astro no se toca):
        lista + bandeja con dos objetos de producto (patrón del piloto, rev1 E-54/E-01). */}
    <section class="w-cell" id="proceso">
      <div class="w-container" data-w-reveal>
        <Proceso n={2} label={t.proceso.label} titleHtml={t.proceso.title} lead={t.proceso.lead} rows={fases} headers={t.proceso.headers} lang="es" />
      </div>
    </section>

    {/* 4 · 03 Por qué Marcyan (a.values). */}
    <section class="w-cell">
      <div class="w-container" data-w-reveal>
        <CabeceraNumerada n={3} label={t.razones.label} titleHtml={plain(a.values.title)} lead={a.values.intro} />
        <div class="wsb-gap"><CuatroRazones items={razones} /></div>
      </div>
    </section>

    {/* 5 · 04 Dónde estamos (#ciudades): dos bandejas con silueta real y NAP real,
        acordeón cerrado al cargar (rev1). */}
    <section class="w-cell" id="ciudades">
      <div class="w-container" data-w-reveal>
        <Sedes n={4} label={t.sedes.label} titleHtml={t.sedes.title} lead={t.sedes.lead} items={c.locations.items} more={t.sedes.more} callLabel={t.sedes.call} />
      </div>
    </section>

    {/* 6 · Clientes Fundadores (W-CONV-17), texto verbatim. */}
    <section class="w-cell">
      <div class="w-container" data-w-reveal>
        <Fundadores
          tag={a.founders.tag}
          titleHtml={a.founders.title}
          paragraphs={a.founders.paragraphs}
          checks={t.fundadores.checks}
          cta={t.fundadores.cta}
          aria={t.fundadores.aria}
        />
      </div>
    </section>

    {/* 7 · En pocas palabras (answer VERBATIM), justo antes de la FAQ (R1). */}
    <section class="w-cell">
      <div class="w-container" data-w-reveal>
        <FranjaEnPocasPalabras q={a.answer.q} a={a.answer.a} lang="es" />
      </div>
    </section>

    {/* 8 · Preguntas a la vista en 2 columnas (#faq), FAQPage idéntico. */}
    <div class="w-cell">
      <div class="w-container" data-w-reveal>
        <PreguntasAbiertas id="faq" tag={a.faq.tag} titleHtml={a.faq.title} items={a.faq.items} />
      </div>
    </div>

    {/* 9 · Salida suave (W-PROOF-21). */}
    <section class="w-cell wsb-soft" aria-label="Más formas de conocernos">
      <div class="w-container" data-w-reveal>
        <SalidaSuave portafolio={t.salida.portafolio} marcy={t.salida.marcy} />
      </div>
    </section>

    {/* 10 · Cierre en dos tarjetas con el trío contractual; titular en degradado. */}
    <div class="w-cell">
      <div class="w-container" data-w-reveal>
        <CierreDosTarjetas
          titleHtml={a.cta.title}
          proof={a.cta.sub}
          city="houston"
          tel={tel}
          wa={wa}
          lang="es"
          grad
          warm={{ kind: 'diagnostico', title: t.cierre.warmTitle, text: t.cierre.warmText, cta: t.cierre.warmCta, href: t.cierre.warmHref }}
        />
      </div>
    </div>

    {/* 11 · Formulario de contacto (contrato intacto → /api/contact, /api/brief). */}
    <Contact contact={c.contact} />
  </main>

  <SpaceBackdrop tone="gold" />

  <SiteFooter footer={c.footer} />
</Layout>

<style>
  .wsb-hero { padding-bottom: 72px; }
  .wsb-hero :global(.w-lead) { text-wrap: balance; }
  .wsb-story { padding-top: 56px; }
  .wsb-story :global(.wsb-plate) { margin-bottom: 64px; }
  .wsb-prose { max-width: 680px; margin: 56px auto 0; }
  .wsb-prose p { margin: 0 0 20px; font: 400 18px/1.65 var(--font-body); color: var(--w-ink-80); }
  .wsb-prose p:last-child { margin-bottom: 0; }
  .wsb-prose :global(strong) { color: var(--w-ink); font-weight: 500; }
  .wsb-gap { margin-top: var(--w-chapter-gap); }
  @media (--lt-md) {
    .wsb-hero { padding-bottom: 64px; }
    .wsb-story { padding-top: 48px; }
    .wsb-story :global(.wsb-plate) { margin-bottom: 48px; }
    .wsb-prose { margin-top: 40px; }
    .wsb-prose p { font-size: 16px; }
    .wsb-gap { margin-top: 40px; }
  }
</style>
