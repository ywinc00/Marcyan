---
// Muestrario de P05 (design/rediseno-workos-v2.md §2 P05): VentanaAgente (marcy noche y buscar
// hueso), MazoHilos y RespuestaAsistente (tarjeta, mini y tres columnas). Dos instancias de cada
// pieza (§1.6, ids únicos). noindex, fuera del sitemap (/w-muestrario). Se borra antes del merge a main.
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/layout/SiteNav.astro';
import WStyles from '../../components/w/WStyles.astro';
import VentanaAgente from '../../components/w/agente/VentanaAgente.astro';
import MazoHilos from '../../components/w/agente/MazoHilos.astro';
import RespuestaAsistente from '../../components/w/objetos/RespuestaAsistente.astro';
import { clusterNav } from '../../i18n/clusters';
---
<Layout title="Muestrario · ventana de agente" description="Muestrario interno de la ventana de agente." lang="es" path="/w-muestrario-agente" hasEn={false} noindex={true} ds="v3">
  <WStyles />
  <SiteNav nav={clusterNav} lang="es" homeHref="/es/" currentPath={Astro.url.pathname} />
  <main id="main" class="mu" data-w>
    <section class="mu__s" id="marcy">
      <p class="mu__k">VentanaAgente · guion marcy · piel noche</p>
      <div class="mu__row">
        <VentanaAgente guion="marcy" lang="es" />
        <VentanaAgente guion="marcy" lang="en" />
      </div>
    </section>
    <section class="mu__s" id="buscar">
      <p class="mu__k">VentanaAgente · guion buscar · piel hueso</p>
      <div class="mu__row mu__row--1">
        <VentanaAgente guion="buscar" lang="es" />
        <VentanaAgente guion="buscar" lang="en" />
      </div>
    </section>
    <section class="mu__s" id="mazo">
      <p class="mu__k">MazoHilos</p>
      <div class="mu__row">
        <MazoHilos lang="es" />
        <MazoHilos lang="en" />
      </div>
    </section>
    <section class="mu__s" id="respuesta">
      <p class="mu__k">RespuestaAsistente · tarjeta · mini</p>
      <div class="mu__row mu__row--c">
        <RespuestaAsistente variant="tarjeta" lang="es" />
        <RespuestaAsistente variant="mini" lang="es" plataforma="gemini" />
        <RespuestaAsistente variant="mini" lang="en" plataforma="meta" />
      </div>
      <p class="mu__k">RespuestaAsistente · tres columnas</p>
      <RespuestaAsistente variant="tres-columnas" lang="es" />
    </section>
  </main>
</Layout>

<style>
  .mu { padding: calc(var(--nav-h, 72px) + 40px) 16px 120px; max-width: 1240px; margin: 0 auto; }
  .mu__s { padding-block: 48px; border-top: 1px solid rgba(240, 237, 232, .08); }
  .mu__k { margin: 0 0 24px; font: 500 12px/1 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; color: rgba(240, 237, 232, .6); }
  .mu__row { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); gap: 40px; align-items: start; justify-items: center; }
  .mu__row--1 { grid-template-columns: 1fr; }
  .mu__row--c { align-items: start; margin-bottom: 48px; }
</style>
