---
// MUESTRARIO P09 · Asistente de alta de Marcy (design/rediseno-workos-v2.md §2 P09).
// Página INTERNA: noindex. SE BORRA antes de cualquier merge a main (§1.2).
// Dos instancias (ES y EN) para que verify-extra detecte ids duplicados (§1.6).
// La tarjeta de dos columnas reproduce la composición del original W2N-05
// (tarjeta 1200×584 radio 30, texto a la izquierda, lienzo a la derecha).
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/layout/SiteNav.astro';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import WStyles from '../../components/w/WStyles.astro';
import AltaMarcy from '../../components/w/alta/AltaMarcy.astro';
import { content } from '../../i18n/content';
import { clusterNav } from '../../i18n/clusters';

const c = content.es;
---
<Layout title="Muestrario · Asistente de alta" description="Muestrario interno de la pieza P09." lang="es" path="/w-muestrario-alta" noindex ds="v3">
  <WStyles />
  <SiteNav nav={clusterNav} lang="es" homeHref="/es" currentPath="/es/w-muestrario-alta" />
  <main id="main" class="mz-alta" data-w data-w-tone="teal">
    <h1 class="mz-h1">Muestrario · Asistente de alta de Marcy</h1>

    <section class="mz-card" aria-labelledby="mz-alta-es">
      <div class="mz-txt">
        <p class="mz-eyebrow">Así empiezas con Marcy</p>
        <h2 id="mz-alta-es" class="mz-h2">Te la dejamos configurada. <span>Tú solo revisas.</span></h2>
        <p class="mz-lead">Configuramos a Marcy con tu horario, tus idiomas y los canales donde ya te escriben. Tú decides qué te avisa.</p>
      </div>
      <AltaMarcy lang="es" uid="es1" />
    </section>

    <section class="mz-card" lang="en" aria-labelledby="mz-alta-en">
      <div class="mz-txt">
        <p class="mz-eyebrow">How you start with Marcy</p>
        <h2 id="mz-alta-en" class="mz-h2">We set her up for you. <span>You just look it over.</span></h2>
        <p class="mz-lead">We set Marcy up with your hours, your languages and the channels where people already message you. You decide what she flags.</p>
      </div>
      <AltaMarcy lang="en" uid="en1" />
    </section>
  </main>
  <SiteFooter footer={c.footer} lang="es" />
</Layout>

<style>
  .mz-alta { padding: calc(var(--nav-h, 72px) + 48px) 16px 120px; display: grid; gap: 64px; justify-items: center; }
  .mz-h1 { font-family: var(--font-mono); font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--w-ink-60); margin: 0; }
  .mz-card {
    width: 100%; max-width: 1200px; box-sizing: border-box;
    display: grid; grid-template-columns: 1fr; gap: 32px; align-items: center;
    padding: 24px; border-radius: 30px;
    background: var(--w-s1); box-shadow: inset 0 0 0 1px var(--w-line);
  }
  /* A 390, como el original: el lienzo ocupa el ancho de la página (la ventana no baja de ×0,92). */
  @media (max-width: 599px) {
    .mz-card { padding: 0; background: none; box-shadow: none; gap: 24px; }
  }
  @media (min-width: 960px) {
    .mz-card { grid-template-columns: 1fr 1fr; gap: 48px; padding: 48px; min-height: 584px; }
  }
  .mz-txt { display: grid; gap: 16px; align-content: center; max-width: 528px; }
  .mz-eyebrow { margin: 0; font-family: var(--font-mono); font-size: var(--w-micro); letter-spacing: var(--w-tr-micro); text-transform: uppercase; color: var(--accent-teal); }
  .mz-h2 { margin: 0; font-family: var(--font-display); font-weight: 500; font-size: var(--w-h2); line-height: 1.15; letter-spacing: var(--w-tr-h2); color: var(--w-ink); }
  .mz-h2 span { display: block; }
  .mz-lead { margin: 0; font-size: clamp(17px, 1rem + .4vw, 22px); line-height: 1.36; color: var(--w-ink-70); }
</style>
