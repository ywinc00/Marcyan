---
// Muestrario P07 · ChipIA (design/rediseno-workos-v2.md §2 P07). Página interna, noindex; se borra
// antes de cualquier merge a main (§1.2). Monta 2+ instancias para que verify-extra detecte ids duplicados.
//
// PÍLDORAS PROVISIONALES: PildorasMarcas (P06) aún no está integrada en feat/rediseno-workos cuando se
// hace esta pieza. Hasta entonces el muestrario pinta las filas con un sustituto LOCAL de este archivo
// que sigue la especificación de P06 (alto 56, radio 100, --bg-card, filo 6 %, logo mono crema SÓLIDO
// #F0EDE8, etiqueta mono 11 al 60 %, fundido escalonado 60 ms al recibir `w2:encender`).
// Trazados: simple-icons 16.36.0 (CC0 del trazado; las marcas pertenecen a sus dueños, uso nominativo),
// descargado con `npm pack` en W2/vendor/si-chip. Al integrar P06 se sustituye por
// <PildorasMarcas slot="pildoras" filas={…} /> y se borran estos trazados (§4.5: logos solo vía LogoMarca).
import Layout from '../../layouts/Layout.astro';
import WStyles from '../../components/w/WStyles.astro';
import ChipIA from '../../components/w/chip/ChipIA.astro';

const P: Record<string, string> = {
