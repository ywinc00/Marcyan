  vercel: 'm12 1.608 12 20.784H0Z',
  neon: 'M24 0V24l-9.365-8.045V24H0V0ZM2.942 21.087h8.751V9.563l9.365 8.204V2.919L2.942 2.914Z',
};
type Pild = { id?: keyof typeof P; nombre: string; alto?: number; soloTexto?: boolean };
type Fila = { etiqueta: string; items: Pild[]; nota?: string };

const filasEs: Fila[] = [
  { etiqueta: 'PIENSA CON', items: [{ id: 'claude', nombre: 'Claude', alto: 24 }] },
  { etiqueta: 'MONTADA SOBRE', nota: 'Ejemplo · solo si el dueño lo confirma (§5-1)', items: [{ id: 'vercel', nombre: 'Vercel', alto: 20 }, { id: 'neon', nombre: 'Neon', alto: 22 }] },
  { etiqueta: 'TE ENCUENTRAN EN', items: [{ nombre: 'ChatGPT', soloTexto: true }, { id: 'googlegemini', nombre: 'Gemini', alto: 24 }, { id: 'meta', nombre: 'Meta AI', alto: 22 }] },
];
const filasEn: Fila[] = [
  { etiqueta: 'THINKS WITH', items: [{ id: 'claude', nombre: 'Claude', alto: 24 }] },
  { etiqueta: 'FOUND ON', items: [{ nombre: 'ChatGPT', soloTexto: true }, { id: 'googlegemini', nombre: 'Gemini', alto: 24 }, { id: 'meta', nombre: 'Meta AI', alto: 22 }] },
];
---
<Layout title="Muestrario · Chip de la IA" lang="es" path="/w-muestrario-chip" noindex hasEn={false} ds="v3">
  <WStyles />
  <main class="mu">
    <header class="mu__cab">
      <p class="mu__meta">P07 · ChipIA · muestrario interno</p>
      <h1 class="mu__h1">Chip de la IA</h1>
    </header>

    <!-- 1 · Variante portada (ES) -->
    <section class="mu__sec" aria-labelledby="mu-portada">
      <div class="mu__texto">
        <p class="mu__kicker">Así está montada</p>
        <h2 class="mu__h2" id="mu-portada">Un cerebro, todos tus canales</h2>
        <p class="mu__bajada">Marcy piensa con Claude y responde donde te escriben tus clientes.</p>
      </div>
      <ChipIA variante="portada" lang="es">
        <div slot="pildoras" class="pi" data-pi>
          {filasEs.map((f, fi) => (
            <div class:list={['pi__fila', fi % 2 === 1 && 'pi__fila--medio']}>
              <span class="pi__et">{f.etiqueta}</span>
              <ul class="pi__lista">
                {f.items.map((it) => (
                  <li class="pi__p">
                    {it.soloTexto
                      ? <span class="pi__palabra">{it.nombre}</span>
                      : <><svg class="pi__logo" viewBox="0 0 24 24" style={`height:${it.alto}px;width:${it.alto}px`} aria-hidden="true" focusable="false"><path d={P[it.id!]} /></svg><span class="pi__n">{it.nombre}</span></>}
                  </li>
                ))}
              </ul>
              {f.nota && <span class="pi__nota">{f.nota}</span>}
            </div>
          ))}
        </div>
      </ChipIA>
    </section>

    <!-- 2 · Variante landing (EN, segunda instancia) -->
    <section class="mu__sec mu__sec--landing" aria-labelledby="mu-landing" lang="en">
      <div class="mu__texto">
        <p class="mu__kicker">How it's built</p>
        <h2 class="mu__h2" id="mu-landing">One brain, every channel</h2>
        <p class="mu__bajada">Marcy thinks with Claude and answers wherever your customers reach you.</p>
      </div>
      <ChipIA variante="landing" lang="en">
        <div slot="pildoras" class="pi" data-pi>
          {filasEn.map((f, fi) => (
            <div class:list={['pi__fila', fi % 2 === 1 && 'pi__fila--medio']}>
              <span class="pi__et">{f.etiqueta}</span>
              <ul class="pi__lista">
                {f.items.map((it) => (
                  <li class="pi__p">
                    {it.soloTexto
                      ? <span class="pi__palabra">{it.nombre}</span>
                      : <><svg class="pi__logo" viewBox="0 0 24 24" style={`height:${it.alto}px;width:${it.alto}px`} aria-hidden="true" focusable="false"><path d={P[it.id!]} /></svg><span class="pi__n">{it.nombre}</span></>}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </ChipIA>
    </section>

    <!-- 3 · Variante sello (Sobre nosotros) -->
    <section class="mu__sec mu__sec--sello" aria-labelledby="mu-sello">
      <h2 class="mu__h2 mu__h2--peq" id="mu-sello">Sello</h2>
      <div class="mu__sello">
        <ChipIA variante="sello" lang="es" />
      </div>
    </section>
  </main>
</Layout>

<style>
  .mu { background: var(--bg-base); color: var(--fg-primary); padding-top: 56px; }
  .mu__cab { max-width: 1200px; margin: 0 auto; padding: 0 16px 48px; min-height: 100svh; } /* el chip entra en vista al bajar, no al cargar: así se ve el encendido */
  .mu__meta { font-family: var(--font-mono); font-size: 12px; color: rgba(240, 237, 232, .6); letter-spacing: .04em; }
  .mu__h1 { font-family: var(--font-display); font-weight: 500; font-size: 32px; letter-spacing: -.02em; margin-top: 8px; }
  .mu__sec { padding-top: 120px; }
  .mu__texto { max-width: 760px; margin: 0 auto 40px; padding-inline: 16px; text-align: center; }
  .mu__kicker { font-family: var(--font-display); font-weight: 500; font-size: 20px; color: var(--accent-gold); letter-spacing: -.01em; }
  .mu__h2 { font-family: var(--font-display); font-weight: 500; font-size: clamp(34px, 4.2vw, 52px); line-height: 1.07; letter-spacing: -.045em; margin-top: 12px; }
  .mu__h2--peq { font-size: 24px; text-align: center; }
  .mu__bajada { font-size: 19px; line-height: 1.6; color: rgba(240, 237, 232, .8); margin-top: 16px; }
  .mu__sello { max-width: 560px; margin: 24px auto 120px; }

  /* ── Sustituto provisional de PildorasMarcas (P06) ── */
  .pi { display: flex; flex-direction: column; align-items: center; gap: 14px; }
  .pi__fila { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 10px 14px; }
  .pi__fila--medio { transform: translateX(40px); }
  .pi__et { font-family: var(--font-mono); font-size: 11px; letter-spacing: .08em; color: rgba(240, 237, 232, .6); min-width: 128px; text-align: right; }
  .pi__lista { list-style: none; padding: 0; margin: 0; display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
  .pi__p {
    height: 56px; border-radius: 100px; padding: 0 28px;
    display: inline-flex; align-items: center; gap: 10px;
    background: var(--bg-card); box-shadow: inset 0 0 0 1px rgba(240, 237, 232, .06);
    color: #f0ede8;
  }
  .pi__logo { fill: #f0ede8; display: block; flex: none; }
  .pi__n { font-family: var(--font-display); font-size: 15px; font-weight: 500; color: rgba(240, 237, 232, .62); }
  .pi__palabra { font-family: var(--font-display); font-size: 17px; font-weight: 600; letter-spacing: -.02em; color: #f0ede8; }
  .pi__nota { font-family: var(--font-mono); font-size: 11px; color: rgba(240, 237, 232, .6); flex-basis: 100%; text-align: center; }
  /* fundido escalonado al recibir w2:encender (solo con JS: data-pi-armed) */
  .pi[data-pi-armed] .pi__p { opacity: 0; transform: translateY(6px); transition: opacity .5s ease, transform .5s cubic-bezier(.22, 1, .36, 1); }
  .pi[data-pi-armed].is-on .pi__p { opacity: 1; transform: none; }
  @media (max-width: 639.98px) {
    .pi__fila { flex-direction: column; gap: 8px; }
    .pi__fila--medio { transform: none; }
    .pi__et { min-width: 0; text-align: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pi[data-pi-armed] .pi__p { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  // Sustituto provisional del comportamiento de PildorasMarcas: escucha `w2:encender` en su raíz.
  document.querySelectorAll<HTMLElement>('[data-pi]').forEach((pi) => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    pi.setAttribute('data-pi-armed', '');
    pi.querySelectorAll<HTMLElement>('.pi__p').forEach((p, i) => { p.style.transitionDelay = `${i * 60}ms`; });
    pi.addEventListener('w2:encender', () => pi.classList.add('is-on'));
  });
</script>
