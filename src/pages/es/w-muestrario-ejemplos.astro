---
// MUESTRARIO INTERNO · WebEjemplo (P02a, design/rediseno-workos-v2.md §2). noindex.
// Plomería en todos los marcos, lienzos, vistas, páginas y estados, con 2 instancias de cada
// combinación crítica (para que verify-extra pille ids repetidos). El resto de marcas: logotipo y
// paleta finales con contenido mínimo (P02b las termina). SE BORRA ANTES DE CUALQUIER MERGE A MAIN.
import Layout from '../../layouts/Layout.astro';
import WStyles from '../../components/w/WStyles.astro';
import WebEjemplo from '../../components/w/objetos/WebEjemplo.astro';
import LogoEjemplo from '../../components/w/objetos/ejemplos/LogoEjemplo.astro';
import { negocios, type NegocioId } from '../../components/w/objetos/ejemplos/negocios';

const estados = ['lista', 'esqueleto', 'alambre', 'antes'] as const;
const otras: NegocioId[] = ['salon', 'restaurante', 'tienda', 'inmobiliaria', 'marca'];
---
<Layout title="Muestrario · webs de ejemplo" lang="es" path="/w-muestrario-ejemplos" noindex hasEn={false} ds="v3">
  <WStyles />
  <main class="mx" data-w>
    <p class="mx__h">Muestrario interno · WebEjemplo (P02a)</p>
    <p class="mx__aviso">El marco navegador (lienzo de escritorio) solo se usa en huecos de 782 px o más: en esta pantalla se omite.</p>

    <section class="mx__s mx__ancho" id="mx-navegador">
      <p class="mx__t">navegador · escritorio 1280×800 · vista hero y completa</p>
      <div class="mx__nav"><WebEjemplo marca="plomeria" frame="navegador" vista="hero" lang="es" /></div>
      <div class="mx__nav"><WebEjemplo marca="plomeria" frame="navegador" vista="completa" lang="es" /></div>
      <div class="mx__nav"><WebEjemplo marca="plomeria" frame="navegador" vista="completa" lang="en" /></div>
    </section>

    <section class="mx__s mx__ancho" id="mx-nav-paginas">
      <p class="mx__t">navegador · páginas servicios y contacto</p>
      <div class="mx__nav"><WebEjemplo marca="plomeria" frame="navegador" pagina="servicios" lang="es" /></div>
      <div class="mx__nav"><WebEjemplo marca="plomeria" frame="navegador" pagina="contacto" lang="es" /></div>
    </section>

    <section class="mx__s mx__ancho" id="mx-nav-estados">
      <p class="mx__t">navegador · estados antes, esqueleto y alambre</p>
      <div class="mx__g2">
        <div>
          <WebEjemplo marca="plomeria" frame="navegador" estado="antes" lang="es" />
          <p class="mx__k mx__critica">Antes (crítica): la llamada va enterrada en la cabecera, en texto y sin botón; la «foto» es un banner de banco que no enseña el oficio; «Bienvenidos a…» ocupa el sitio del titular y no dice qué hacen ni dónde; párrafo de relleno justificado; cinco pestañas subrayadas, un solo idioma y nada pensado para el móvil.</p>
        </div>
        <WebEjemplo marca="plomeria" frame="navegador" estado="esqueleto" lang="es" />
        <WebEjemplo marca="plomeria" frame="navegador" estado="alambre" lang="es" />
        <WebEjemplo marca="plomeria" frame="navegador" estado="lista" modo="oscuro" lang="es" />
        <WebEjemplo marca="plomeria" frame="navegador" estado="alambre" vista="completa" lang="es" />
      </div>
    </section>

    <section class="mx__s" id="mx-tarjeta">
      <p class="mx__t">tarjeta 360 · vertical 400×520 · los 4 estados (completa) + hero</p>
      <div class="mx__row">
        {estados.map((e) => <div class="mx__c360"><WebEjemplo marca="plomeria" frame="tarjeta" vista="completa" estado={e} lang="es" /><p class="mx__k">{e}</p></div>)}
        <div class="mx__c360"><WebEjemplo marca="plomeria" frame="tarjeta" vista="hero" lang="es" /><p class="mx__k">hero</p></div>
        <div class="mx__c360"><WebEjemplo marca="plomeria" frame="tarjeta" pagina="servicios" lang="es" /><p class="mx__k">servicios</p></div>
        <div class="mx__c360"><WebEjemplo marca="plomeria" frame="tarjeta" pagina="contacto" lang="en" /><p class="mx__k">contact (en)</p></div>
      </div>
    </section>

    <section class="mx__s" id="mx-movil">
      <p class="mx__t">móvil 300 · lienzo 390×844 · estados, páginas y mini</p>
      <div class="mx__row">
        {estados.map((e) => <div><WebEjemplo marca="plomeria" frame="movil" vista="completa" estado={e} lang="es" /><p class="mx__k">{e}</p></div>)}
        <div><WebEjemplo marca="plomeria" frame="movil" vista="hero" lang="es" /><p class="mx__k">hero</p></div>
        <div><WebEjemplo marca="plomeria" frame="movil" pagina="servicios" lang="es" /><p class="mx__k">servicios</p></div>
        <div><WebEjemplo marca="plomeria" frame="movil" pagina="contacto" lang="es" /><p class="mx__k">contacto</p></div>
        <div><WebEjemplo marca="plomeria" frame="movil" vista="mini" lang="es" /><p class="mx__k">mini</p></div>
        <div class="mx__c240"><WebEjemplo marca="plomeria" frame="tarjeta" vista="mini" lang="es" /><p class="mx__k">mini tarjeta</p></div>
      </div>
    </section>

    <section class="mx__s" id="mx-scope">
      <p class="mx__t">prioridad del scope · [data-ej-scope] con --ej-s-* y data-ej-btn / data-ej-mode / data-ej-lang</p>
      <div class="mx__row">
        <div class="mx__c360" data-ej-scope data-test="scope" data-ej-lang="es">
          <WebEjemplo marca="plomeria" frame="tarjeta" vista="completa" lang="es" />
          <p class="mx__k">scope de prueba</p>
        </div>
        <div class="mx__c360" data-ej-scope data-ej-btn="outline" style="--ej-s-bg:#F2EFE7;--ej-s-ink:#1F3A2E;--ej-s-ink-2:#4F5F55;--ej-s-accent:#2F6B4F;--ej-s-on-accent:#F4F1EA;--ej-s-radius:2px">
          <WebEjemplo marca="plomeria" frame="tarjeta" vista="completa" lang="es" boton="pill" />
          <p class="mx__k">Pino · rectas · contorno (scope gana a boton="pill")</p>
        </div>
        <div class="mx__c360" data-ej-scope data-ej-mode="oscuro" data-ej-btn="fill" style="--ej-s-radius:24px">
          <WebEjemplo marca="plomeria" frame="tarjeta" vista="completa" lang="es" />
          <p class="mx__k">noche · redondas · relleno</p>
        </div>
      </div>
    </section>

    <section class="mx__s" id="mx-marcas">
      <p class="mx__t">las otras 5 marcas · logotipo y paleta finales, contenido mínimo (P02b)</p>
      <div class="mx__logos">
        {(Object.keys(negocios) as NegocioId[]).map((m) => (
          <div class="mx__logo" style={`background:${negocios[m].paleta.bg};color:${negocios[m].paleta.ink};--ej-accent:${negocios[m].paleta.accent}`}>
            <LogoEjemplo marca={m} size={22} lang="es" /><LogoEjemplo marca={m} size={22} lang="en" />
          </div>
        ))}
      </div>
      <div class="mx__row">
        {otras.map((m) => <div class="mx__c360"><WebEjemplo marca={m} frame="tarjeta" vista="hero" lang="es" /><p class="mx__k">{m}</p></div>)}
      </div>
    </section>
  </main>
</Layout>

<style>
  .mx { padding: 48px 24px 96px; max-width: 1440px; margin: 0 auto; color: var(--fg-primary, #f0ede8); }
  .mx__h { font: 500 13px/1.3 var(--font-mono); text-transform: uppercase; letter-spacing: .1em; color: rgba(240,237,232,.6); margin: 0 0 32px; }
  .mx__s { margin-top: 56px; }
  .mx__t { font: 500 15px/1.4 var(--font-body); margin: 0 0 18px; color: rgba(240,237,232,.85); }
  .mx__k { font: 500 12px/1.3 var(--font-mono); color: rgba(240,237,232,.6); margin: 6px 0 0; }
  .mx__nav { max-width: 1100px; margin-bottom: 28px; }
  .mx__g2 { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 782px), 1fr)); gap: 28px; max-width: 1100px; }
  .mx__critica { max-width: 70ch; line-height: 1.5; text-transform: none; }
  .mx__row { display: flex; flex-wrap: wrap; gap: 28px; align-items: flex-start; }
  .mx__c360 { width: 360px; max-width: 100%; }
  .mx__c240 { width: 240px; max-width: 100%; }
  .mx__logos { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr)); gap: 12px; margin-bottom: 28px; }
  .mx__logo { display: flex; flex-direction: column; align-items: flex-start; gap: 18px; padding: 24px; border-radius: 12px; overflow: hidden; }
  .mx__aviso { display: none; font: 500 13px/1.4 var(--font-body); color: rgba(240,237,232,.7); }
  @media (max-width: 829.98px) { .mx__ancho { display: none; } .mx__aviso { display: block; } }
</style>
