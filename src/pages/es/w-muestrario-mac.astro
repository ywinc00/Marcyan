---
// ─────────────────────────────────────────────────────────────
// MUESTRARIO P08 · Portátil y sus escenas (design/rediseno-workos-v2.md §2 P08).
// Página INTERNA: noindex. SE BORRA antes de cualquier merge a main (§1.2).
// Monta 2 instancias de cada escena (§1.6, ids únicos) y un solo <h1>: el H1
// verbatim de /es/houston/ia-conversacional dentro de EscenaDosActos.
// ─────────────────────────────────────────────────────────────
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/layout/SiteNav.astro';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import WStyles from '../../components/w/WStyles.astro';
import Button from '../../components/ui/Button.astro';
import EscenaDosActos from '../../components/w/mac/EscenaDosActos.astro';
import EscenaAbreApps from '../../components/w/mac/EscenaAbreApps.astro';
import EscenaCierre from '../../components/w/mac/EscenaCierre.astro';
import { content, nap } from '../../i18n/content';
import { clusters, clusterNav } from '../../i18n/clusters';

const c = content.es;
const ia = clusters['houston/ia-conversacional'];
const wa = 'https://wa.me/' + nap.houston.replace(/\D/g, '');
---
<Layout title="Muestrario · portátil y escenas" description="Muestrario interno P08." lang="es" path="w-muestrario-mac" noindex ds="v3" hasEn={false}>
  <WStyles />
  <SiteNav nav={{ ...clusterNav, cta: { ...clusterNav.cta, href: '#contacto' } }} lang="es" homeHref="/es" currentPath={Astro.url.pathname} />

  <main id="main" data-w>
    <EscenaDosActos lang="es" id="dos-actos">
      <h1 slot="titulo" set:html={ia.hero.h1} />
      <p slot="bajada">{ia.hero.sub}</p>
      <Fragment slot="acciones">
        <Button href={ia.hero.primary.href} variant="primary" size="lg">{ia.hero.primary.label}</Button>
        <Button href={ia.hero.secondary.href} variant="secondary" size="lg">{ia.hero.secondary.label}</Button>
      </Fragment>
    </EscenaDosActos>

    <section class="mu" id="abre-apps">
      <EscenaAbreApps lang="es">
        <div slot="cabecera"><p class="mu-et">P08 · EscenaAbreApps · ES · tapa por scroll</p>
        <h2 class="mu-h2">Tu web, tu ficha y Marcy, ya funcionando.</h2></div>
      </EscenaAbreApps>
    </section>

    <section class="mu" id="abre-apps-en" lang="en">
      <EscenaAbreApps lang="en" tapa="abierta">
        <div slot="cabecera"><p class="mu-et">P08 · EscenaAbreApps · EN · tapa abierta</p>
        <h2 class="mu-h2">Your site, your listing and Marcy, already working.</h2></div>
      </EscenaAbreApps>
    </section>

    <EscenaCierre lang="es" id="cierre">
      <h2 slot="titulo">Tu web, lista para trabajar.</h2>
      <p slot="bajada">Rápida, en español y en inglés, y lista para que te encuentren.</p>
      <Fragment slot="acciones">
        <Button href="#contacto" variant="primary" size="lg">Propuesta gratis</Button>
        <Button href={wa} variant="secondary" size="lg">WhatsApp</Button>
      </Fragment>
    </EscenaCierre>

    <EscenaDosActos lang="en" id="dos-actos-en">
      <h2 slot="titulo">AI assistant for your <em>business</em> in Houston</h2>
      <p slot="bajada">Second instance (EN), to check unique ids and the English copy.</p>
    </EscenaDosActos>

    <EscenaCierre lang="en" id="cierre-en">
      <h2 slot="titulo">Your website, ready to work.</h2>
      <p slot="bajada">Fast, in English and Spanish, and ready to be found.</p>
      <Fragment slot="acciones">
        <Button href="#contacto" variant="primary" size="lg">Free proposal</Button>
      </Fragment>
    </EscenaCierre>

    <div id="contacto" class="mu mu-fin"><p class="mu-et">#contacto (ancla del muestrario)</p></div>
  </main>

  <SiteFooter footer={c.footer} />
</Layout>

<style>
  .mu { padding: 120px 16px 80px; text-align: center; }
  .mu :global(.mu-et), .mu-et { margin: 0 0 12px; font-family: var(--font-mono); font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--w-ink-60); }
  .mu :global(.mu-h2) { margin: 0 auto 40px; max-width: 18ch; font-family: var(--font-display); font-weight: 500; font-size: clamp(30px, 3.6vw, 53px); line-height: 1.12; letter-spacing: -.04em; }
  .mu-fin { padding: 80px 16px; }
  /* solo muestrario: sin corte duro entre el amanecer de dos actos y el negro de AbreApps */
  #abre-apps { background: linear-gradient(180deg, #12302d 0, rgba(18,48,45,.35) 160px, transparent 360px); }
  /* solo muestrario: con la tapa cerrada el titular ya baja hasta la base; el relleno
     superior de .mu sumaba 120 px de vacío tras el portátil de dos actos */
  #abre-apps { padding-top: 0; }
  /* el H2 del segundo DosActos hereda la escala del H1 de la escena */
  #dos-actos-en :global(h2) { margin: 0; font-family: var(--font-display); font-weight: 500; font-size: 54px; line-height: 1; letter-spacing: -.035em; }
</style>
