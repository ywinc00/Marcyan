---
// ─────────────────────────────────────────────────────────────
// MUESTRARIO P10 · Pase del negocio (design/rediseno-workos-v2.md §2 P10).
// Página INTERNA de QA: noindex. SE BORRA ANTES DE CUALQUIER MERGE A main (§1.2).
// Monta 2+ instancias de la pieza (ids con sufijo, verify-extra) a la escala del
// original (465), escalada (620) y en inglés.
// ─────────────────────────────────────────────────────────────
import Layout from '../../layouts/Layout.astro';
import WStyles from '../../components/w/WStyles.astro';
import PaseNegocio from '../../components/w/pase/PaseNegocio.astro';
---
<Layout title="Muestrario · Pase del negocio" noindex={true} path="/w-muestrario-pase" hasEn={false} ds="v3">
  <WStyles />
  <main id="main" class="mp" data-w>
    <header class="mp__head">
      <p class="mp__k">Muestrario interno · P10</p>
      <h1 class="mp__h1">Pase del negocio</h1>
      <p class="mp__lead">La ficha de identidad de tu negocio que leen los asistentes de IA. Pasa el puntero por encima.</p>
    </header>

    <section class="mp__sec" aria-label="Escala del original (465)">
      <p class="mp__k">465 × 109 · escala del original a 1440</p>
      <div class="mp__stage" data-mp="465">
        <PaseNegocio />
      </div>
    </section>

    <section class="mp__sec" aria-label="Escalado (620)">
      <p class="mp__k">620 × 146 · mismo lienzo fuente · Miami</p>
      <div class="mp__stage" data-mp="620">
        <PaseNegocio ancho={620} ciudad="miami" />
      </div>
    </section>

    <section class="mp__sec" aria-label="English" lang="en">
      <p class="mp__k">EN · 465</p>
      <div class="mp__stage" data-mp="en">
        <PaseNegocio lang="en" />
      </div>
    </section>
  </main>
</Layout>

<style>
  .mp {
    min-height: 100vh;
    padding: 96px max(16px, calc((100vw - 1200px) / 2)) 160px;
    background: var(--w-s0, #080808);
    color: var(--w-ink, #f0ede8);
  }
  .mp__head { max-width: 640px; margin-bottom: 72px; }
  .mp__k {
    margin: 0 0 16px;
    font-family: var(--font-mono); font-size: 12px; letter-spacing: .1em; text-transform: uppercase;
    color: var(--w-ink-60);
  }
  .mp__h1 { margin: 0 0 16px; font-size: var(--w-h2); font-weight: 500; letter-spacing: -.04em; line-height: 1.1; }
  .mp__lead { margin: 0; font-size: var(--w-lead); color: var(--w-ink-80); line-height: 1.5; }
  .mp__sec { margin-bottom: 96px; }
  .mp__stage {
    display: grid; place-items: center;
    padding: 72px 16px 48px;
    border-radius: 22px;
    background: var(--w-s1, #121211);
    border: 1px solid var(--w-line);
  }
</style>
