---
// Muestrario P11 · LineaFases (design/rediseno-workos-v2.md §1.2: se borra antes de cualquier merge a main).
// Monta 2 instancias de cada variante (portada ES/EN y compacta ES/EN) para que verify-extra
// detecte ids o estados que choquen. Sin ds="v3": la portada no es v3 y el componente no depende de w.css.
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/layout/SiteNav.astro';
import Kicker from '../../components/ui/Kicker.astro';
import Button from '../../components/ui/Button.astro';
import LineaFases from '../../components/w/proceso/LineaFases.astro';
import { fasesDe } from '../../components/w/proceso/proceso';
import { content } from '../../i18n/content';

const es = content.es.process, en = content.en.process;
---
<Layout title="Muestrario · Del concepto al lanzamiento" description="Muestrario interno de la pieza P11." lang="es" path="/w-muestrario-proceso" noindex hasEn={false}>
  <SiteNav nav={content.es.nav} lang="es" homeHref="/es" currentPath={Astro.url.pathname} />
  <main id="main">
    <section class="section mu" id="proceso" data-mu="portada-es">
      <div class="container">
        <header class="mu__head"><Kicker>{es.tag}</Kicker><h2 class="h2" set:html={es.title} /></header>
        <LineaFases fases={fasesDe(es.steps)} lang="es" variante="portada" />
        <div class="mu__cta"><span class="mu__k">{es.launch.kicker}</span><Button href={es.launch.href} variant="primary" size="lg">{es.launch.label}</Button></div>
      </div>
    </section>
    <section class="section mu" id="proceso-en" data-mu="portada-en" lang="en">
      <div class="container">
        <header class="mu__head"><Kicker>{en.tag}</Kicker><h2 class="h2" set:html={en.title} /></header>
        <LineaFases fases={fasesDe(en.steps)} lang="en" variante="portada" />
        <div class="mu__cta"><span class="mu__k">{en.launch.kicker}</span><Button href={en.launch.href} variant="primary" size="lg">{en.launch.label}</Button></div>
      </div>
    </section>
    <section class="section mu" id="compacta-es" data-mu="compacta-es">
      <div class="container">
        <header class="mu__head"><Kicker>Compacta · sobre nosotros</Kicker><h2 class="h2">Del concepto al lanzamiento</h2></header>
        <LineaFases fases={fasesDe(es.steps)} lang="es" variante="compacta" />
      </div>
    </section>
    <section class="section mu" id="compacta-en" data-mu="compacta-en" lang="en">
      <div class="container">
        <header class="mu__head"><Kicker>Compact · about</Kicker><h2 class="h2">From concept to launch</h2></header>
        <LineaFases fases={fasesDe(en.steps)} lang="en" variante="compacta" />
      </div>
    </section>
  </main>
</Layout>

<style>
  .mu :global(em) { color: var(--accent-gold); font-style: normal; }
  .mu__head { display: flex; flex-direction: column; gap: var(--space-4); margin-bottom: var(--space-7); }
  .mu__cta { display: flex; flex-direction: column; align-items: center; gap: 14px; margin-top: 56px; }
  .mu__k { font: 500 12px/1 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--accent-gold); }
</style>
