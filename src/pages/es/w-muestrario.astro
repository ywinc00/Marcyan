---
// ─────────────────────────────────────────────────────────────
// MUESTRARIO v3 del rediseño WorkOS (design/rediseno-workos.md §3.7, ola 0C).
// Página INTERNA: noindex + fuera del sitemap (filter de astro.config.mjs).
// SE BORRA (con su condición del sitemap) ANTES DE CUALQUIER MERGE (ola 5).
//
// Enseña TODOS los componentes de src/components/w/ con contenido realista, en
// el orden de una página tipo (la landing de diseño web en Houston, §4.14) y
// después, en anexos, las piezas que viven en otros tipos de página, cada una en
// el orden en que aparece en la suya. Todo el texto sale de los datos del sitio
// (clusters, pricing, portfolio, content, servicios) o del copy del plan (§4);
// lo inventado va en objetos rotulados "Ejemplo". Ningún precio escrito a mano.
// Su pareja sin `ds` (prueba del Cerrojo 5) es w-muestrario-base.astro.
// ─────────────────────────────────────────────────────────────
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/layout/SiteNav.astro';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import SpaceBackdrop from '../../components/SpaceBackdrop.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import Button from '../../components/ui/Button.astro';
import Contact from '../../components/sections/Contact.astro';
import WStyles from '../../components/w/WStyles.astro';
// Sistema base (0A)
import Eyebrow from '../../components/w/Eyebrow.astro';
import ChipCiudad from '../../components/w/ChipCiudad.astro';
import HeroTexto from '../../components/w/HeroTexto.astro';
import CabeceraNumerada from '../../components/w/CabeceraNumerada.astro';
import CapituloDosFrases from '../../components/w/CapituloDosFrases.astro';
import Bandeja from '../../components/w/Bandeja.astro';
import Celdas from '../../components/w/Celdas.astro';
import IconoObjeto from '../../components/w/IconoObjeto.astro';
import Ejemplo from '../../components/w/Ejemplo.astro';
// Conversión (0B-1)
import FranjaEnPocasPalabras from '../../components/w/FranjaEnPocasPalabras.astro';
import PreguntasFrecuentes from '../../components/w/PreguntasFrecuentes.astro';
import PreguntasAbiertas from '../../components/w/PreguntasAbiertas.astro';
import CierreDosTarjetas from '../../components/w/CierreDosTarjetas.astro';
import TarjetasHermanas from '../../components/w/TarjetasHermanas.astro';
import TarjetasPerfil from '../../components/w/TarjetasPerfil.astro';
import DondeEstaTuNegocio from '../../components/w/DondeEstaTuNegocio.astro';
// Prueba (0B-2)
import TiraLogos from '../../components/w/TiraLogos.astro';
import FichaProyecto from '../../components/w/FichaProyecto.astro';
import FiguraProyecto from '../../components/w/FiguraProyecto.astro';
import TarjetasCaso from '../../components/w/TarjetasCaso.astro';
import ProsaLocal from '../../components/w/ProsaLocal.astro';
import RelatoEnActos from '../../components/w/RelatoEnActos.astro';
import FichaLateral from '../../components/w/FichaLateral.astro';
import CeldaTuNegocio from '../../components/w/CeldaTuNegocio.astro';
// Precio y estructura (0B-3)
import PrecioPuntos from '../../components/w/PrecioPuntos.astro';
import TarjetaPrecio from '../../components/w/TarjetaPrecio.astro';
import TarjetasModelo from '../../components/w/TarjetasModelo.astro';
import Especificaciones from '../../components/w/Especificaciones.astro';
import TriadaManifiesto from '../../components/w/TriadaManifiesto.astro';
import TresPasosNumerados from '../../components/w/TresPasosNumerados.astro';
import CuatroRazones from '../../components/w/CuatroRazones.astro';
import GratisDeVerdad from '../../components/w/GratisDeVerdad.astro';
import Inventario3Etapas from '../../components/w/Inventario3Etapas.astro';
import TresGarantias from '../../components/w/TresGarantias.astro';
import TablaFases from '../../components/w/TablaFases.astro';
import SedesAcordeon from '../../components/w/SedesAcordeon.astro';
// Demos y bucles (0B-4)
import DemoPorPasos from '../../components/w/DemoPorPasos.astro';
import Escalera from '../../components/w/Escalera.astro';
import Bento2x2 from '../../components/w/Bento2x2.astro';
import BandejaPasos from '../../components/w/BandejaPasos.astro';
import RegistroVivo from '../../components/w/RegistroVivo.astro';
import MatrizFilas from '../../components/w/MatrizFilas.astro';
import DilemaDosCaminos from '../../components/w/DilemaDosCaminos.astro';
import SinCon from '../../components/w/SinCon.astro';
import CicloEnU from '../../components/w/CicloEnU.astro';
import ChipsVeredicto from '../../components/w/ChipsVeredicto.astro';
// Objetos de servicio (0B-5)
import WebEjemplo from '../../components/w/objetos/WebEjemplo.astro';
import AbanicoWebs from '../../components/w/objetos/AbanicoWebs.astro';
import FichaMapaEjemplo from '../../components/w/objetos/FichaMapaEjemplo.astro';
import TarjetaObjeto from '../../components/w/objetos/TarjetaObjeto.astro';
import Radar from '../../components/w/objetos/Radar.astro';
import ListaPedidos from '../../components/w/objetos/ListaPedidos.astro';
import ChatMarcy from '../../components/w/objetos/ChatMarcy.astro';
import MarcoPestanas from '../../components/w/objetos/MarcoPestanas.astro';
import EsclusaMarcy from '../../components/w/objetos/EsclusaMarcy.astro';
import RespuestaAsistente from '../../components/w/objetos/RespuestaAsistente.astro';
import TunelRejilla from '../../components/w/objetos/TunelRejilla.astro';
import Escaner from '../../components/w/objetos/Escaner.astro';
import Interruptores from '../../components/w/objetos/Interruptores.astro';
import PlanoMarca from '../../components/w/objetos/PlanoMarca.astro';
import ChipBarrio from '../../components/w/objetos/ChipBarrio.astro';
import PlacaLogo from '../../components/w/objetos/PlacaLogo.astro';
import SolicitudOficio from '../../components/w/objetos/SolicitudOficio.astro';
import MiniPasos from '../../components/w/objetos/MiniPasos.astro';
// Datos reales del sitio
import { content, nap } from '../../i18n/content';
import { clusters, clusterNav } from '../../i18n/clusters';
import { catalog, PRICE_ANCHORS } from '../../i18n/pricing';
import { portfolioProjects } from '../../i18n/portfolio';
import { serviciosPage } from '../../i18n/servicios';
import { megaServicios } from '../../i18n/w/nav';
import type { IconoId } from '../../components/w/objects/registry';

const c = content.es;
const web = clusters['houston/diseno-web'];
const usd = (n: number) => '$' + n.toLocaleString('en-US');
const desde = (n: number) => `Desde ${usd(n)}`;
const tel = 'tel:' + nap.houston.replace(/[^\d+]/g, '');
const wa = 'https://wa.me/' + nap.houston.replace(/\D/g, '');
const [trr, mja, jls, rn] = portfolioProjects;
const webCat = catalog.find((p) => p.id === 'diseno-web')!;
const anchorOf = (id: string) => {
  const p = catalog.find((x) => x.id === id)!;
  const t = p.tiers.find((x) => x.anchor) ?? p.tiers[0];
  return t.value === null ? 'Gratis' : t.monthly ? `Desde ${usd(t.value)} al mes` : desde(t.value);
};

// Hermanas de Houston (hrefs del megamenú = los de pricing.ts; R5, sin URL nuevas).
const hermanas = megaServicios.es.map((s) => ({
  id: s.id, label: s.name, desc: s.promise, href: s.href, price: anchorOf(s.id),
}));
const interruptores = [
  { label: 'Web rápida', href: '/es/houston/diseno-web' },
  { label: 'Marcy 24/7', href: '/es/houston/ia-conversacional' },
  { label: 'Que la IA te nombre', href: '/es/houston/seo-para-ia' },
  { label: 'Tienda', href: '/es/houston/ecommerce' },
  { label: 'SEO local', href: '/es/houston/seo-local' },
  { label: 'Marca', href: '/es/houston/branding' },
  { label: 'Mantenimiento', href: '/es/servicios' },
];
const ids: IconoId[] = ['diseno-web', 'seo-local', 'ia-conversacional', 'ecommerce', 'branding', 'seo-ia', 'mantenimiento'];
const sizes = [40, 48, 56, 80] as const;
---
<Layout title="Muestrario v3" description="Muestrario interno del sistema v3." lang="es" path="/w-muestrario" noindex ds="v3">
  <WStyles />
  <SiteNav nav={clusterNav} lang="es" homeHref="/es" currentPath="/es/w-muestrario" />

  <main id="main" class="w-rails mz" data-w data-w-tone="gold">
    <!-- ═════════ PÁGINA TIPO · Diseño web en Houston (§4.14) ═════════ -->
    <section class="w-hero w-hero--bleed mz-hero" id="m-hero">
      <div class="w-container">
        <p class="mz-tag">HeroTexto · Eyebrow · ChipCiudad · Breadcrumb · W-CORE-01/02</p>
        <HeroTexto
          eyebrow="Web rápida"
          tone="gold"
          chip="Houston, TX"
          h1Html={web.hero.h1}
          tail="que te trae clientes."
          lead="Webs a medida, rápidas y en español e inglés, para que tus clientes de Houston te encuentren y te escriban."
          primary={{ label: 'Quiero mi web', href: '#contacto', track: 'proposal_requested' }}
          link={{ label: 'Ver proyectos', href: '#proyectos' }}
        >
          <Breadcrumb slot="crumbs" items={web.breadcrumb} lang="es" />
        </HeroTexto>
      </div>
      <div class="mz-fan" data-w-in="obj">
        <p class="mz-tag mz-tag--c">AbanicoWebs · WebEjemplo ×3 · W-CORE-01</p>
        <AbanicoWebs city="Houston" />
      </div>
      <div class="w-container mz-logos">
        <p class="mz-tag mz-tag--c">TiraLogos · W-CORE-03</p>
        <TiraLogos city="houston" />
      </div>
    </section>

    <section class="w-cell" id="m-triada">
      <div class="w-container" data-w-reveal>
        <p class="mz-tag">TriadaManifiesto · W-ADV-08</p>
        <TriadaManifiesto
          items={[
            { tone1: 'Rápida.', tone2: 'Carga al instante.', text: 'HTML ligero que abre rápido en el celular, donde te buscan primero.' },
            { tone1: 'Bilingüe.', tone2: 'De verdad.', text: 'Español e inglés escritos desde el diseño, no un botón de traducir.' },
            { tone1: 'Encontrable.', tone2: 'En Google y en la IA.', text: 'Estructura y datos que Google y los asistentes de IA pueden leer.' },
          ]}
        />
      </div>
    </section>

    <section class="w-cell" id="proceso">
      <div class="w-container" data-w-reveal>
        <p class="mz-tag">CabeceraNumerada · W-NEW-32</p>
        <CabeceraNumerada n={1} label="Cómo se construye tu web" titleHtml="De tu negocio a tu web publicada" lead="Cinco pasos, con la propuesta en 24 horas y tu web revisada en vivo hasta que suene como tú." />
        <p class="mz-tag mz-gap">DemoPorPasos · WebEjemplo · W-CORE-05</p>
        <DemoPorPasos
          titleHtml="Así la construimos"
          text="Cada paso deja algo que puedes ver. Cuando termina, tu web está publicada y conectada."
          steps={[
            'Revisamos tu negocio y tu competencia',
            'Escribimos los textos en español e inglés',
            'Diseñamos y montamos tu web',
            'La conectamos a tu ficha de mapa y a Marcy',
            'Publicada',
          ]}
          log={['informe-competencia.pdf', 'textos-es.md · textos-en.md', 'inicio · servicios · contacto', 'ficha + Marcy: conectadas', 'tunegocio.example: en línea']}
          done="Web publicada"
        >
          <WebEjemplo slot="screen" frame="tarjeta" city="Houston" example={false} />
        </DemoPorPasos>
      </div>
    </section>

    <section class="w-cell" id="m-escalera">
      <div class="w-container" data-w-reveal>
        <CabeceraNumerada n={2} label="Hazla tuya" titleHtml="Elige por dónde empezar" lead="Tres formas de tener tu web, con el precio de entrada a la vista." />
        <p class="mz-tag mz-gap">Escalera · W-CORE-06 · B-08</p>
        <Escalera
          titleHtml="Tu web, a tu medida"
          lead="Empieza con una página y crece cuando lo necesites."
          chip="Tus colores, tu letra, en español e inglés"
          options={[
            { id: 'landing', title: webCat.tiers[0].name, text: webCat.tiers[0].blurb, price: desde(PRICE_ANCHORS.webLanding) },
            { id: 'rediseno', title: webCat.tiers[1].name, text: webCat.tiers[1].blurb, price: desde(PRICE_ANCHORS.webRedesign) },
            { id: 'medida', title: webCat.tiers[2].name, text: webCat.tiers[2].blurb, price: desde(PRICE_ANCHORS.web) },
          ]}
        >
          <WebEjemplo slot="screen-landing" frame="movil" kind="plomeria" example={false} />
          <WebEjemplo slot="screen-rediseno" frame="movil" kind="salon" example={false} />
          <WebEjemplo slot="screen-medida" frame="movil" kind="restaurante" example={false} />
        </Escalera>
      </div>
    </section>

    <section class="w-cell w-contrast" id="m-bento">
      <div class="w-container" data-w-reveal>
        <p class="mz-tag">.w-contrast · CapituloDosFrases · W-CORE-07</p>
        <CapituloDosFrases tone1="Una web bonita no basta." tone2="Tiene que traerte clientes." sub="Cada parte de tu web trabaja para que te encuentren, te entiendan y te escriban." />
        <p class="mz-tag mz-gap">Bento2x2 · FichaMapaEjemplo · ChatMarcy · W-CORE-08</p>
        <Bento2x2
          cells={[
            { icon: 'lucide:inbox', label: 'Formulario', titleHtml: 'Ningún contacto se pierde', text: 'Cada mensaje se guarda antes de avisarte, aunque falle el correo.' },
            { icon: 'lucide:languages', label: 'Idiomas', titleHtml: 'Tu web en inglés también', text: 'El visitante elige idioma y todo cambia, textos y botones.' },
            { icon: 'lucide:map-pin', label: 'Ficha de mapa', titleHtml: 'Conectada a tu ficha', text: 'Mismo nombre, teléfono y horario en tu web y en el mapa.' },
            { icon: 'lucide:message-circle', label: 'Marcy', titleHtml: 'Contesta a las 23:40', text: 'Tu asistente responde cuando tú ya cerraste.', tray: false },
          ]}
        >
          <MiniPasos slot="ui-1" kind="correo" fill />
          <WebEjemplo slot="ui-2" frame="movil" kind="salon" size="mini" />
          <FichaMapaEjemplo slot="ui-3" size="card" />
          <ChatMarcy slot="ui-4" mode="estatico" tone="neutral" size="card" />
        </Bento2x2>
      </div>
    </section>

    <section class="w-cell" id="m-prosa">
      <div class="w-container" data-w-reveal>
        <p class="mz-tag">ProsaLocal · W-CONV-30 / W-CONV-41</p>
        <ProsaLocal
          titleTone1="Por qué en Houston."
          titleTone2="Un sitio pensado para tu mercado."
          paragraphs={web.local.paragraphs}
          items={[
            { icon: 'lucide:smartphone', title: 'Primero el celular', text: 'Pensada para la pantalla donde te buscan.' },
            { icon: 'lucide:languages', title: 'Dos idiomas', text: 'Español e inglés con el contexto correcto.' },
            { icon: 'lucide:gauge', title: 'Rápida', text: 'HTML ligero que carga al instante.' },
            { icon: 'lucide:search', title: 'Lista para buscar', text: 'SEO base y datos que la IA entiende.' },
          ]}
        />
      </div>
    </section>

    <section class="w-cell" id="proyectos">
      <div class="w-container" data-w-reveal>
        <CabeceraNumerada n={3} label="Proyectos" titleHtml="Webs nuestras, en uso" lead="Negocios reales de Houston y Florida con su sitio nuevo." />
        <p class="mz-tag mz-gap">FichaProyecto (grande) · W-EVT-15</p>
        <FichaProyecto project={trr} variant="grande" id="m-trr" />
        <p class="mz-tag mz-gap">TarjetasCaso · W-PROOF-13</p>
        <TarjetasCaso items={[jls, rn]} label="Más proyectos" />
        <p class="mz-tag mz-gap">FiguraProyecto · W-PROOF-12</p>
        <div class="mz-figs">
          <FiguraProyecto project={rn} side="right" />
          <FiguraProyecto project={mja} side="left" />
        </div>
        <p class="mz-tag mz-gap">CeldaTuNegocio · W-NEW-08</p>
        <CeldaTuNegocio href={wa} />
      </div>
    </section>

    <section class="w-cell" id="precios">
      <div class="w-container" data-w-reveal>
        <p class="mz-tag">PrecioPuntos · W-CORE-14 (degradado único de la página)</p>
        <PrecioPuntos
          eyebrow="Inversión"
          titleHtml="Tu web, con el precio a la vista"
          anchor="webLanding"
          from="Desde"
          bottomLeft={{ big: webCat.tiers[0].name, text: webCat.tiers[0].blurb }}
          bottomRight={{ label: webCat.tiers[2].name, value: desde(PRICE_ANCHORS.web) }}
        />
        <p class="mz-tag mz-gap">Especificaciones · W-NEW-31</p>
        <Especificaciones
          label="Qué incluye"
          cells={[
            { k: 'Diseño', v: 'A medida', note: 'Sin plantillas recicladas.' },
            { k: 'Páginas', v: 'Según el plan', note: 'Las que necesita tu negocio.' },
            { k: 'Idiomas', v: 'Español e inglés', note: 'Cada versión escrita para su público.' },
            { k: 'SEO', v: 'Base incluida', note: 'Títulos, datos y velocidad desde el inicio.' },
            { k: 'Contacto', v: 'Formulario integrado', note: 'Llamada y WhatsApp siempre a la vista.' },
            { k: 'Listo para', v: 'Móvil y la IA', note: 'Se lee bien en el teléfono y en los asistentes.' },
            { k: 'Propuesta', v: 'En 24 horas', note: 'Clara, por escrito y sin compromiso.' },
            { k: 'Propiedad', v: 'La web es tuya', note: 'Nunca te dejamos amarrado.' },
          ]}
        />
      </div>
    </section>

    <section class="w-cell" id="m-franja">
      <div class="w-container" data-w-reveal>
        <p class="mz-tag mz-tag--c">FranjaEnPocasPalabras · W-CORE-23</p>
        <FranjaEnPocasPalabras
          q={web.answer.q}
          a={web.answer.a}
          source={web.answer.source}
          cols={[
            { title: 'Qué es', text: web.service.description, link: { label: 'Ver diseño web', href: '/es/houston/diseno-web' } },
            { title: 'Desde cuánto', text: `${desde(PRICE_ANCHORS.webLanding)} una landing; ${desde(PRICE_ANCHORS.web)} un sitio a medida.`, link: { label: 'Ver precios', href: '/es/precios' } },
            { title: 'En cuánto tiempo', text: 'Propuesta en 24 horas. Te damos un calendario realista desde el inicio.', link: { label: 'Pedir propuesta', href: '#contacto' } },
          ]}
        />
      </div>
    </section>

    <section class="w-cell" id="m-faq">
      <div class="w-container" data-w-reveal>
        <p class="mz-tag mz-tag--c">PreguntasFrecuentes · W-CONV-11 (todas cerradas)</p>
        <PreguntasFrecuentes id="faq" tag={web.faq.tag} titleHtml={web.faq.title} items={web.faq.items} />
      </div>
    </section>

    <section class="w-cell" id="m-hermanas">
      <div class="w-container" data-w-reveal>
        <p class="mz-tag">TarjetasHermanas · IconoObjeto · W-ADV-40 / W-ADV-50</p>
        <TarjetasHermanas
          titleHtml="<span class='w-tone'>Tu web es el centro.</span> Lo demás la hace crecer."
          lead="Servicios de Marcyan en Houston que se conectan con tu web."
          items={hermanas}
          currentId="diseno-web"
          recursos={[
            { icon: 'lucide:book-open', title: 'Guía de precios de una web', text: 'Cuánto cuesta una página web en Houston.', href: '/es/blog/precio-pagina-web-houston-guia' },
            { icon: 'lucide:scan-search', title: 'Diagnóstico gratis', text: 'Revisa si tu negocio pierde clientes online.', href: '/es/diagnostico', track: 'tool_cta_clicked' },
            { icon: 'lucide:tag', title: 'Precios', text: 'Todos los precios de entrada, a la vista.', href: '/es/precios' },
          ]}
        />
      </div>
    </section>

    <section class="w-cell" id="m-cierre">
      <div class="w-container" data-w-reveal>
        <p class="mz-tag">CierreDosTarjetas · W-CORE-15 (trío contractual)</p>
        <CierreDosTarjetas
          titleHtml={web.cta.title}
          proof="Texas Rush Remove ya posiciona en su zona de Houston con su sitio nuevo."
          city="houston"
          tel={tel}
          wa={wa}
          lang="es"
          warm={{ kind: 'diagnostico', title: '¿Aún no sabes qué necesitas?', text: 'Revisa gratis si tu negocio está perdiendo clientes online.', cta: 'Hacer el diagnóstico', href: '/es/diagnostico' }}
        />
      </div>
    </section>

    <!-- ═════════ ANEXO A · Heros y objetos de otros tipos de página ═════════ -->
    <section class="w-cell mz-annex" id="m-anexo-a">
      <div class="w-container">
        <p class="mz-annex__t">Anexo A · Heros y objetos de los otros tipos de página</p>
      </div>
    </section>

    <section class="w-cell" id="m-seo-local">
      <div class="w-container mz-split" data-w-reveal>
        <div>
          <p class="mz-tag">SEO local (§4.16) · TarjetaObjeto · FichaMapaEjemplo · W-CORE-16</p>
          <ChipCiudad label="Houston, TX" />
          <p class="w-h2 mz-mt">SEO local en Houston, para que te llamen a ti.</p>
        </div>
        <TarjetaObjeto example={false}>
          <IconoObjeto id="seo-local" size={56} slot="icon" />
          <FichaMapaEjemplo />
        </TarjetaObjeto>
      </div>
      <div class="w-container mz-gap2" data-w-reveal>
        <p class="mz-tag">Radar · W-CORE-09 (celda dominante de bento, bucle)</p>
        <div class="mz-radar"><Radar /></div>
      </div>
    </section>

    <section class="w-cell" id="m-tienda">
      <div class="w-container mz-split" data-w-reveal>
        <div>
          <p class="mz-tag">Tienda (§4.15) · ListaPedidos · W-ADV-36 (bucle)</p>
          <Eyebrow tone="gold">Tienda</Eyebrow>
          <p class="w-h2 mz-mt">Tu tienda en línea, que vende mientras duermes.</p>
        </div>
        <ListaPedidos />
      </div>
    </section>

    <section class="w-cell w-dawn" id="m-ia-pymes" data-w-tone="teal">
      <div class="w-container mz-split" data-w-reveal>
        <div>
          <p class="mz-tag">IA para pymes (§4.11) · .w-dawn teal · EsclusaMarcy · W-ADV-01/02</p>
          <Eyebrow tone="teal">Marcy contesta por ti</Eyebrow>
          <p class="w-h2 mz-mt">Tu negocio contesta aunque estés cerrado.</p>
        </div>
        <EsclusaMarcy />
      </div>
    </section>

