---
// /formulario — Brief de proyecto (ES). Misma URL de siempre; la versión en
// inglés vive en /en/project-brief con el MISMO modelo de datos.
//
// Orbit v2 · B1 (camino 2 "expediente por pasos", design/brief.md): el
// formulario es la isla BriefForm (Svelte), que pinta los seis pasos desde
// lib/brief-schema.mjs (momento 'inicial') y envía el brief v2 a POST /api/brief
// (schema_version 2, lang, servicios del catálogo y archivos subidos).
// El contrato de los name/value históricos sigue vivo en el esquema: las 39
// claves de `briefs` no cambian y el chat sigue mandando su forma v1.
// noindex y fuera del sitemap (astro.config.mjs filtra /formulario).
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/layout/SiteNav.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import SpaceBackdrop from '../components/SpaceBackdrop.astro';
import Kicker from '../components/ui/Kicker.astro';
import BtnStates from '../components/ui/BtnStates.astro';
import BriefForm from '../components/brief/BriefForm.svelte';
import { content, nap } from '../i18n/content';
import { clusterNav } from '../i18n/clusters';

// En esta página el CTA de la nav no puede volver a apuntar aquí (B-25):
// ofrece la salida humana por WhatsApp.
const wa = `https://wa.me/${nap.houston.replace(/\D/g, '')}`;
const pageNav = { ...clusterNav, cta: { label: 'WhatsApp', href: wa, track: 'whatsapp_clicked' } };
---
<Layout
  title="Brief de proyecto · Marcyan Studio"
  description="Cuéntanos sobre tu negocio en seis pasos y te preparamos una propuesta en 24 horas. Diseño web, IA y SEO en Houston y Miami."
  lang="es"
  path="/formulario"
  canonical="https://marcyanstudio.com/formulario"
  hasEn={true}
  noindex={true}
>
  <SiteNav nav={pageNav} lang="es" homeHref="/es/" hasEn={true} currentPath={Astro.url.pathname} showCtaBar={false} />

  <main id="main" class="brief">
    <div class="container brief__inner">
      <header class="brief__head">
        <Kicker>Brief de proyecto</Kicker>
        <h1 class="brief__h1">Cuéntanos sobre tu <em>proyecto</em></h1>
        <p class="brief__lead">Seis pasos, unos 10 minutos. Con tus respuestas te preparamos una propuesta en 24 horas.</p>
      </header>

      <BriefForm client:load lang="es" phone={nap.houston} />

      <noscript>
        <p class="brief__nojs">Para llenar el brief necesitas activar JavaScript. También puedes llamarnos al <a href={`tel:${nap.houston.replace(/[^\d+]/g, '')}`}>{nap.houston}</a> o escribirnos por <a href={wa}>WhatsApp</a>.</p>
      </noscript>
    </div>
  </main>

  <SpaceBackdrop tone="gold" density={0.8} />
  <SiteFooter footer={content.es.footer} />

  <!-- Carga una vez los estilos globales de BtnStates (contrato .bstate/.bst que usa el botón de envío de la isla). No se pinta. -->
  <template><button class="bstate" type="button"><BtnStates sending="" done="">.</BtnStates></button></template>
  {import.meta.env.DEV && <script is:inline src="/dev/brief-mock.js"></script>}
</Layout>

<style>
  /* Sin hero: reserva la nav fija para que el título no quede debajo. */
  .brief { padding-top: calc(var(--nav-h) + var(--space-7)); padding-bottom: var(--space-9); }
  .brief__inner { max-width: 1080px; }
  .brief__head { display: grid; gap: var(--space-3); margin-bottom: var(--space-6); max-width: 680px; }
  .brief__h1 { margin: 0; font-family: var(--font-display); font-size: var(--fluid-h3); font-weight: 700; line-height: var(--leading-tight); letter-spacing: var(--tracking-tight); color: var(--fg-primary); }
  .brief__h1 em { color: var(--accent-gold); font-style: normal; }
  .brief__lead { margin: 0; color: var(--fg-secondary); font-size: var(--fluid-lead); line-height: var(--leading-normal); }
  .brief__nojs { margin-top: var(--space-5); color: var(--fg-secondary); }
  .brief__nojs a { color: var(--accent-gold); }
  @media (--lg) {
    .brief__head { margin-left: calc(216px + var(--space-7)); }
  }
</style>
