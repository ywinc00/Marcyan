{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/", "destination": "/es", "permanent": true },
    {
      "source": "/admin/briefs/detail",
      "has": [{ "type": "query", "key": "id", "value": "(?<id>.+)" }],
      "destination": "/dashboard#/briefs/:id",
      "permanent": true
    },
    { "source": "/admin", "destination": "/dashboard", "permanent": true },
    { "source": "/admin/:path*", "destination": "/dashboard", "permanent": true },
    { "source": "/en/houston/ai-seo", "destination": "/en/houston", "permanent": true },
    { "source": "/en/houston/auto-repair", "destination": "/en/houston", "permanent": true },
    { "source": "/en/houston/beauty-salons", "destination": "/en/houston", "permanent": true },
    { "source": "/en/houston/bilingual-web-design", "destination": "/en/houston", "permanent": true },
    { "source": "/en/houston/branding", "destination": "/en/houston", "permanent": true },
    { "source": "/en/houston/conversational-ai", "destination": "/en/houston", "permanent": true },
    { "source": "/en/houston/dental-clinics", "destination": "/en/houston", "permanent": true },
    { "source": "/en/houston/ecommerce", "destination": "/en/houston", "permanent": true },
    { "source": "/en/houston/immigration-lawyers", "destination": "/en/houston", "permanent": true },
    { "source": "/en/houston/local-seo", "destination": "/en/houston", "permanent": true },
    { "source": "/en/houston/real-estate", "destination": "/en/houston", "permanent": true },
    { "source": "/en/houston/web-design", "destination": "/en/houston", "permanent": true },
    { "source": "/en/houston/katy", "destination": "/en/houston", "permanent": true },
    { "source": "/en/houston/sugar-land", "destination": "/en/houston", "permanent": true },
    { "source": "/en/miami/conversational-ai", "destination": "/en/miami", "permanent": true },
    { "source": "/en/miami/ecommerce", "destination": "/en/miami", "permanent": true },
    { "source": "/en/miami/local-seo", "destination": "/en/miami", "permanent": true },
    { "source": "/en/miami/web-design", "destination": "/en/miami", "permanent": true },
    { "source": "/en/miami/doral", "destination": "/en/miami", "permanent": true },
    { "source": "/en/miami/hialeah", "destination": "/en/miami", "permanent": true },
    { "source": "/en/pricing/chatbot-cost", "destination": "/en/pricing", "permanent": true },
    { "source": "/en/pricing/local-seo-cost-houston", "destination": "/en/pricing", "permanent": true },
    { "source": "/en/pricing/website-cost-houston", "destination": "/en/pricing", "permanent": true },
    { "source": "/es/houston/abogados-inmigracion", "destination": "/es/houston/diseno-web", "permanent": true },
    { "source": "/es/houston/clinicas-dentales", "destination": "/es/houston/diseno-web", "permanent": true },
    { "source": "/es/houston/restaurantes", "destination": "/es/houston/diseno-web", "permanent": true },
    { "source": "/es/houston/salon-belleza", "destination": "/es/houston/diseno-web", "permanent": true },
    { "source": "/es/houston/talleres-mecanicos", "destination": "/es/houston/diseno-web", "permanent": true },
    { "source": "/es/houston/diseno-web-bilingue", "destination": "/es/houston/diseno-web", "permanent": true },
    { "source": "/es/precios/cuanto-cuesta-seo-local-houston", "destination": "/es/precios", "permanent": true },
    { "source": "/es/precios/cuanto-cuesta-un-chatbot", "destination": "/es/precios", "permanent": true },
    { "source": "/es/precios/cuanto-cuesta-una-pagina-web-houston", "destination": "/es/precios", "permanent": true }
  ],
  "rewrites": [
    { "source": "/es/kit/:token", "destination": "/es/kit" },
    { "source": "/en/kit/:token", "destination": "/en/kit" }
  ],
  "headers": [
    {
      "source": "/es/kit/:token",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/en/kit/:token",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/dashboard/sw.js",
      "headers": [{ "key": "Service-Worker-Allowed", "value": "/dashboard" }]
    },
    {
      "source": "/dashboard",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()" }
      ]
    },
    {
      "source": "/dashboard/:path*",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()" }
      ]
    },
    {
      "source": "/api/admin/:path*",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "functions": {
    "api/brief.mjs": { "maxDuration": 60 },
    "api/brief/upload.mjs": { "maxDuration": 30 },
    "api/kit/*.mjs": { "maxDuration": 60 },
    "api/cron/*.mjs": { "maxDuration": 300 },
    "api/admin/briefs/*/kit.mjs": { "maxDuration": 300, "includeFiles": "lib/kit/templates/**" }
  },
  "crons": [
    { "path": "/api/cron/brief-cleanup", "schedule": "40 9 * * *" },
    { "path": "/api/cron/seo-sync", "schedule": "0 9 * * *" }
  ]
}
